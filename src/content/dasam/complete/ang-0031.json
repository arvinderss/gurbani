  "lines": [
    {
      "t": "ਅਨਖੰਡ ਅਭੂਤ ਅਛੇਦ ਅਛਿਅੰ ॥",
      "s": 1
    },
    {
      "t": "ਅਨਕਾਲ ਅਪਾਲ ਦਇਆਲ ਸੁਅੰ ॥",
      "s": 1
    },
    {
      "t": "ਜਿਹ ਠਟੀਅੰ ਮੇਰ ਆਕਾਸ ਭੁਅੰ ॥੨॥੧੪੨॥",
      "s": 1
    },
    {
      "t": "ਅਨਖੰਡ ਅਮੰਡ ਪ੍ਰਚੰਡ ਨਰੰ ॥",
      "s": 1
    },
    {
      "t": "ਜਿਹ ਰਚੀਅੰ ਦੇਵ ਅਦੇਵ ਬਰੰ ॥",
      "s": 1
    },
    {
      "t": "ਸਭ ਕੀਨੀ ਦੀਨ ਜਮੀਨ ਜਮਾਂ ॥",
      "s": 1
    },
    {
      "t": "ਜਿਹ ਰਚੀਅੰ ਸਰਬ ਮਕੀਨ ਮਕਾਂ ॥੩॥੧੪੩॥",
      "s": 1
    },
    {
      "t": "ਜਿਹ ਰਾਗ ਨ ਰੂਪ ਨ ਰੇਖ ਰੁਖੰ ॥",
      "s": 1
    },
    {
      "t": "ਜਿਹ ਤਾਪ ਨ ਸ੍ਰਾਪ ਨ ਸੋਕ ਸੁਖੰ ॥",
      "s": 1
    },
    {
      "t": "ਜਿਹ ਰੋਗ ਨ ਸੋਗ ਨ ਭੋਗ ਭੁਯੰ ॥",
      "s": 1
    },
    {
      "t": "ਜਿਹ ਖੇਦ ਨ ਭੇਦ ਨ ਛੇਦ ਛਯੰ ॥੪॥੧੪੪॥",
      "s": 1
    },
    {
      "t": "ਜਿਹ ਜਾਤਿ ਨ ਪਾਤਿ ਨ ਮਾਤ ਪਿਤੰ ॥",
      "s": 1
    },
    {
      "t": "ਜਿਹ ਰਚੀਅੰ ਛਤ੍ਰੀ ਛਤ੍ਰ ਛਿਤੰ ॥",
      "s": 1
    },
    {
      "t": "ਜਿਹ ਰਾਗ ਨ ਰੇਖ ਨ ਰੋਗ ਭਣੰ ॥",
      "s": 1
    },
    {
      "t": "ਜਿਹ ਦ੍ਵੈਖ ਨ ਦਾਗ ਨ ਦੋਖ ਗਣੰ ॥੫॥੧੪੫॥",
      "s": 1
    },
    {
      "t": "ਜਿਹ ਅੰਡਹਿ ਤੇ ਬ੍ਰਹਿਮੰਡ ਰਚਿਓ ॥",
      "s": 1
    },
    {
      "t": "ਦਿਸ ਚਾਰ ਕਰੀ ਨਵ ਖੰਡ ਸਚਿਓ ॥",
      "s": 1
    },
    {
      "t": "ਰਜ ਤਾਮਸ ਤੇਜ ਅਤੇਜ ਕੀਓ ॥",
      "s": 1
    },
    {
      "t": "ਅਨਭਉ ਪਦ ਆਪ ਪ੍ਰਚੰਡ ਲੀਓ ॥੬॥੧੪੬॥",
      "s": 1
    },
    {
      "t": "ਸ੍ਰਿਅ ਸਿੰਧੁਰ ਬਿੰਧ ਨਗਿੰਧ ਨਗੰ ॥",
      "s": 1
    },
    {
      "t": "ਸ੍ਰਿਅ ਜਛ ਗੰਧਰਬ ਫਣਿੰਦ ਭੁਜੰ ॥",
      "s": 1
    },
    {
      "t": "ਰਚ ਦੇਵ ਅਦੇਵ ਅਭੇਵ ਨਰੰ ॥",
      "s": 1
    },
    {
      "t": "ਨਰਪਾਲ ਨ੍ਰਿਪਾਲ ਕਰਾਲ ਤ੍ਰਿਗੰ ॥੭॥੧੪੭॥",
      "s": 1
    },
    {
      "t": "ਕਈ ਕੀਟ ਪਤੰਗ ਭੁਜੰਗ ਨਰੰ ॥",
      "s": 1
    },
    {
      "t": "ਰਚਿ ਅੰਡਜ ਸੇਤਜ ਉਤਭੁਜੰ ॥",
      "s": 1
    },
    {
      "t": "ਕੀਏ ਦੇਵ ਅਦੇਵ ਸਰਾਧ ਪਿਤੰ ॥",
      "s": 1
    },
    {
      "t": "ਅਨਖੰਡ ਪ੍ਰਤਾਪ ਪ੍ਰਚੰਡ ਗਤੰ ॥੮॥੧੪੮॥",
      "s": 1
    },
    {
      "t": "ਪ੍ਰਭ ਜਾਤਿ ਨ ਪਾਤਿ ਨ ਜੋਤਿ ਜੁਤੰ ॥",
      "s": 1
    },
    {
      "t": "ਜਿਹ ਤਾਤ ਨ ਮਾਤ ਨ ਭ੍ਰਾਤ ਸੁਤੰ ॥",
      "s": 1
    },
    {
      "t": "ਜਿਹ ਰੋਗ ਨ ਸੋਗ ਨ ਭੋਗ ਭੁਅੰ ॥",
      "s": 1
    },
    {
      "t": "ਜਿਹ ਜੰਪਹਿ ਕਿੰਨਰ ਜਛ ਜੁਅੰ ॥੯॥੧੪੯॥",
      "s": 1
    },
    {
      "t": "ਨਰ ਨਾਰਿ ਨਿਪੁੰਸਕ ਜਾਹਿ ਕੀਏ ॥",
      "v": [
        [
          0,
          1
        ],
        [
          1,
          1
        ]
      ],
      "s": 1
    },
    {
      "t": "ਗਣ ਕਿੰਨਰ ਜਛ ਭੁਜੰਗ ਦੀਏ ॥",
      "s": 1
    },
    {
      "t": "ਗਜਿ ਬਾਜਿ ਰਥਾਦਿਕ ਪਾਂਤਿ ਗਣੰ ॥",
      "s": 1
    },
    {
      "t": "ਭਵ ਭੂਤ ਭਵਿਖ ਭਵਾਨ ਤੁਅੰ ॥੧੦॥੧੫੦॥",
      "s": 1
    },
    {
      "t": "ਜਿਹ ਅੰਡਜ ਸੇਤਜ ਜੇਰਰਜੰ ॥",
      "s": 1
    },
    {
      "t": "ਰਚਿ ਭੂਮ ਅਕਾਸ ਪਤਾਲ ਜਲੰ ॥",
      "s": 1
    },
    {
      "t": "ਰਚਿ ਪਾਵਕ ਪਉਣ ਪ੍ਰਚੰਡ ਬਲੀ ॥",
      "s": 1
    },
    {
      "t": "ਬਨ ਜਾਸੁ ਕੀਓ ਫਲ ਫੂਲ ਕਲੀ ॥੧੧॥੧੫੧॥",
      "s": 1
    },
    {
      "t": "ਭੂਅ ਮੇਰ ਅਕਾਸ ਨਿਵਾਸ ਛਿਤੰ ॥",
      "s": 1
    },
    {
      "t": "ਰਚਿ ਰੋਜ ਇਕਾਦਸ ਚੰਦ੍ਰ ਬ੍ਰਿਤੰ ॥",
      "s": 1
    },
    {
      "t": "ਦੁਤਿ ਚੰਦ ਦਿਨੀ ਸਹਿ ਦੀਪ ਦਈ ॥",
      "s": 1
    },
    {
      "t": "ਜਿਹ ਪਾਵਕ ਪੌਨ ਪ੍ਰਚੰਡ ਮਈ ॥੧੨॥੧੫੨॥",
      "s": 1
    },
    {
      "t": "ਜਿਹ ਖੰਡ ਅਖੰਡ ਪ੍ਰਚੰਡ ਕੀਏ ॥",
      "s": 1
    },
    {
      "t": "ਜਿਹ ਛਤ੍ਰ ਉਪਾਇ ਛਿਪਾਇ ਦੀਏ ॥",
      "s": 1
    },
    {
      "t": "ਜਿਹ ਲੋਕ ਚਤੁਰ ਦਸ ਚਾਰ ਰਚੇ ॥",
      "s": 1
    },
    {
      "t": "ਗਣ ਗੰਧ੍ਰਬ ਦੇਵ ਅਦੇਵ ਸਚੇ ॥੧੩॥੧੫੩॥",
      "s": 1
    },
    {
      "t": "ਅਨਧੂਤ ਅਭੂਤ ਅਛੂਤ ਮਤੰ ॥",
      "s": 1
    },
    {
      "t": "ਅਨਗਾਧ ਅਬ੍ਯਾਧ ਅਨਾਦਿ ਗਤੰ ॥",
      "s": 1
    },
    {
      "t": "ਅਨਖੇਦ ਅਭੇਦ ਅਛੇਦ ਨਰੰ ॥",
      "s": 1
    },
    {
      "t": "ਜਿਹ ਚਾਰ ਚਤ੍ਰ ਦਿਸ ਚਕ੍ਰ ਫਿਰੰ ॥੧੪॥੧੫੪॥",
      "s": 1
    },
    {
      "t": "ਜਿਹ ਰਾਗ ਨ ਰੰਗ ਨ ਰੇਖ ਰੁਗੰ ॥",
      "s": 1
    },
    {
      "t": "ਜਿਹ ਸੋਗ ਨ ਭੋਗ ਨ ਜੋਗ ਜੁਗੰ ॥",
      "s": 1
    },
    {
      "t": "ਭੂਅ ਭੰਜਨ ਗੰਜਨ ਆਦਿ ਸਿਰੰ ॥",
      "s": 1
    },
    {
      "t": "ਜਿਹ ਬੰਦਤ ਦੇਵ ਅਦੇਵ ਨਰੰ ॥੧੫॥੧੫੫॥",
      "s": 1
    },
    {
      "t": "ਗਣ ਕਿੰਨਰ ਜਛ ਭੁਜੰਗ ਰਚੇ ॥",
      "s": 1
    },
    {
      "t": "ਮਣਿ ਮਾਣਿਕ ਮੋਤੀ ਲਾਲ ਸੁਚੇ ॥",
      "s": 1
    },
    {
      "t": "ਅਨਭੰਜ ਪ੍ਰਭਾ ਅਨਗੰਜ ਬ੍ਰਿਤੰ ॥",
      "s": 1
    },
    {
      "t": "ਜਿਹ ਪਾਰ ਨ ਪਾਵਤ ਪੂਰ ਮਤੰ ॥੧੬॥੧੫੬॥",
      "s": 1
    },
    {
      "t": "ਅਨਖੰਡ ਸਰੂਪ ਅਡੰਡ ਪ੍ਰਭਾ ॥",
      "s": 1
    },
    {
      "t": "ਜੈ ਜੰਪਤ ਬੇਦ ਪੁਰਾਨ ਸਭਾ ॥",
      "s": 1
    },
    {
      "t": "ਜਿਹ ਬੇਦ ਕਤੇਬ ਅਨੰਤ ਕਹੈ ॥",
      "s": 1
    },
    {
      "t": "ਜਿਹ ਭੂਤ ਅਭੂਤ ਨ ਭੇਦ ਲਹੈ ॥੧੭॥੧੫੭॥",
      "s": 1
    },
    {
      "t": "ਜਿਹ ਬੇਦ ਪੁਰਾਨ ਕਤੇਬ ਜਪੈ ॥",
      "s": 1
    },
    {
      "t": "ਸੁਤਸਿੰਧ ਅਧੋ ਮੁਖ ਤਾਪ ਤਪੈ ॥",
      "s": 1
    },
    {
      "t": "ਕਈ ਕਲਪਨ ਲੌ ਤਪ ਤਾਪ ਕਰੈ ॥",
      "s": 1
    },
    {
      "t": "ਨਹੀ ਨੈਕ ਕ੍ਰਿਪਾ ਨਿਧਿ ਪਾਨ ਪਰੈ ॥੧੮॥੧੫੮॥",
      "s": 1
    },
    {
      "t": "ਜਿਹ ਫੋਕਟ ਧਰਮ ਸਭੈ ਤਜਿ ਹੈਂ ॥",
      "s": 1
    },
    {
      "t": "ਇਕ ਚਿਤ ਕ੍ਰਿਪਾ ਨਿਧਿ ਕੋ ਜਪਿ ਹੈਂ ॥",
      "s": 1
    },
    {
      "t": "ਤੇਊ ਯਾ ਭਵ ਸਾਗਰ ਕੋ ਤਰ ਹੈਂ ॥",
      "s": 1
    },
    {
      "t": "ਭਵ ਭੂਲ ਨ ਦੇਹਿ ਪੁਨਰ ਧਰ ਹੈਂ ॥੧੯॥੧੫੯॥",
      "s": 1
    },
    {
      "t": "ਇਕ ਨਾਮ ਬਿਨਾ ਨਹੀ ਕੋਟ ਬ੍ਰਤੀ ॥",
