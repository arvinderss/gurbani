{
  "page": 42,
  "lines": [
    {
      "t": "ਜਿਤੇ ਔਲੀਆ ਅੰਬੀਆ ਗੌਸ ਹ੍ਵੈਹੈਂ ॥",
      "s": 2
    },
    {
      "t": "ਸਭੈ ਕਾਲ ਕੇ ਅੰਤ ਦਾੜਾ ਤਲੈ ਹੈਂ ॥੨੯॥",
      "s": 2
    },
    {
      "t": "ਜਿਤੇ ਮਾਨਧਾਤਾਦਿ ਰਾਜਾ ਸੁਹਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਸਭੈ ਬਾਂਧ ਕੈ ਕਾਲ ਜੇਲੈ ਚਲਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਨੈ ਨਾਮ ਤਾ ਕੋ ਉਚਾਰੋ ਉਬਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਬਿਨਾ ਸਾਮ ਤਾ ਕੀ ਲਖੇ ਕੋਟ ਮਾਰੇ ॥੩੦॥",
      "s": 2
    },
    {
      "t": "ਰਸਾਵਲ ਛੰਦ ॥ ਤ੍ਵ ਪ੍ਰਸਾਦਿ ॥",
      "s": 2
    },
    {
      "t": "ਚਮੱਕਹਿ ਕ੍ਰਿਪਾਣੰ ॥",
      "s": 2
    },
    {
      "t": "ਅਭੂਤੰ ਭਯਾਣੰ ॥",
      "s": 2
    },
    {
      "t": "ਧੁਨੰ ਨੇਵਰਾਣੰ ॥",
      "s": 2
    },
    {
      "t": "ਘੁਰੰ ਘੁੰਘਰਾਣੰ ॥੩੧॥",
      "s": 2
    },
    {
      "t": "ਚਤੁਰ ਬਾਂਹ ਚਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਨਿਜੂਟੰ ਸੁਧਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਗਦਾ ਪਾਸ ਸੋਹੰ ॥",
      "s": 2
    },
    {
      "t": "ਜਮੰ ਮਾਨ ਮੋਹੰ ॥੩੨॥",
      "s": 2
    },
    {
      "t": "ਸੁਭੰ ਜੀਭ ਜੁਆਲੰ ॥",
      "s": 2
    },
    {
      "t": "ਸੁ ਦਾੜ੍ਹਾ ਕਰਾਲੰ ॥",
      "s": 2
    },
    {
      "t": "ਬਜੀ ਬੰਬ ਸੰਖੰ ॥",
      "s": 2
    },
    {
      "t": "ਉਠੇ ਨਾਦ ਬੰਖੰ ॥੩੩॥",
      "s": 2
    },
    {
      "t": "ਸੁਭੰ ਰੂਪ ਸਿਆਮੰ ॥",
      "s": 2
    },
    {
      "t": "ਮਹਾ ਸੋਭ ਧਾਮੰ ॥",
      "s": 2
    },
    {
      "t": "ਛਬੇ ਚਾਰੁ ਚਿਤ੍ਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਪਰੇਅੰ ਪਵਿਤ੍ਰੰ ॥੩੪॥",
      "s": 2
    },
    {
      "t": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਸਿਰੰ ਸੇਤ ਛਤ੍ਰੰ ਸੁ ਸੁਭ੍ਰੰ ਬਿਰਾਜੰ ॥",
      "s": 2
    },
    {
      "t": "ਲਖੇ ਛੈਲ ਛਾਯਾ ਕਰੇ ਤੇਜ ਲਾਜੰ ॥",
      "s": 2
    },
    {
      "t": "ਬਿਸਾਲਾਲ ਨੈਨੰ ਮਹਾਰਾਜ ਸੋਹੰ ॥",
      "s": 2
    },
    {
      "t": "ਢਿਗੰ ਅੰਸੁਮਾਲੰ ਹਸੰ ਕੋਟ ਕ੍ਰੋਹੰ ॥੩੫॥",
      "s": 2
    },
    {
      "t": "ਕਹੂੰ ਰੂਪ ਧਾਰੇ ਮਹਾਰਾਜ ਸੋਹੰ ॥",
      "s": 2
    },
    {
      "t": "ਕਹੂੰ ਦੇਵ ਕੰਨਿਆਨ ਕੇ ਮਾਨ ਮੋਹੰ ॥",
      "s": 2
    },
    {
      "t": "ਕਹੂੰ ਬੀਰ ਹ੍ਵੈ ਕੈ ਧਰੇ ਬਾਨ ਪਾਨੰ ॥",
      "s": 2
    },
    {
      "t": "ਕਹੂੰ ਭੂਪ ਹ੍ਵੈ ਕੈ ਬਜਾਏ ਨਿਸਾਨੰ ॥੩੬॥",
      "s": 2
    },
    {
      "t": "ਰਸਾਵਲ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਧਨੁਰ ਬਾਨ ਧਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਛਕੇ ਛੈਲ ਭਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਲਏ ਖੱਗ ਐਸੇ ॥",
      "s": 2
    },
    {
      "t": "ਮਹਾਂ ਬੀਰ ਜੈਸੇ ॥੩੭॥",
      "s": 2
    },
    {
      "t": "ਜੁਰੇ ਜੰਗ ਜੋਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਕਰੇ ਜੁੱਧ ਘੋਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਕ੍ਰਿਪਾ ਨਿਧਿ ਦਿਆਲੰ ॥",
      "s": 2
    },
    {
      "t": "ਸਦਾਯੰ ਕ੍ਰਿਪਾਲੰ ॥੩੮॥",
      "s": 2
    },
    {
      "t": "ਸਦਾ ਏਕ ਰੂਪੰ ॥",
      "s": 2
    },
    {
      "t": "ਸਭੈ ਲੋਕ ਭੂਪੰ ॥",
      "s": 2
    },
    {
      "t": "ਅਜੇਯੰ ਅਜਾਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਸਰਣਿਅੰ ਸਹਾਯੰ ॥੩੯॥",
      "s": 2
    },
    {
      "t": "ਤਪੈ ਖੱਗ ਪਾਨੰ ॥",
      "s": 2
    },
    {
      "t": "ਮਹਾਂ ਲੋਕ ਦਾਨੰ ॥",
      "s": 2
    },
    {
      "t": "ਭਵਿਖਿਅੰ ਭਵੇਅੰ ॥",
      "s": 2
    },
    {
      "t": "ਨਮੋ ਨਿਰਜੁਰੇਅੰ ॥੪੦॥",
      "s": 2
    },
    {
      "t": "ਮਧੋ ਮਾਨ ਮੁੰਡੰ ॥",
      "s": 2
    },
    {
      "t": "ਸੁਭੰ ਰੁੰਡ ਝੁੰਡੰ ॥",
      "s": 2
    },
    {
      "t": "ਸਿਰੰ ਸੇਤ ਛੱਤ੍ਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਲਸੰ ਹਾਥ ਅੱਤ੍ਰੰ ॥੪੧॥",
      "s": 2
    },
    {
      "t": "ਸੁਣੇ ਨਾਦ ਭਾਰੀ ॥",
      "s": 2
    },
    {
      "t": "ਤ੍ਰਸੇ ਛਤ੍ਰਧਾਰੀ ॥",
      "s": 2
    },
    {
      "t": "ਦਿਸਾ ਬਸਤ੍ਰ ਰਾਜੰ ॥",
      "s": 2
    },
    {
      "t": "ਸੁਣੇ ਦੋਖ ਭਾਜੰ ॥੪੨॥",
      "s": 2
    },
    {
      "t": "ਸੁਣੇ ਗੱਦ ਸੱਦੰ ॥",
      "s": 2
    },
    {
      "t": "ਅਨੰਤੰ ਬਿਹੱਦੰ ॥",
      "s": 2
    },
    {
      "t": "ਘਟਾ ਜਾਣੁ ਸਿਆਮੰ ॥",
      "s": 2
    },
    {
      "t": "ਦੁਤੰ ਅਭਿਰਾਮੰ ॥੪੩॥",
      "s": 2
    },
    {
      "t": "ਚਤੁਰ ਬਾਹੁ ਚਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਕਰੀਟੰ ਸੁ ਧਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਗਦਾ ਸੰਖ ਚੱਕ੍ਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਦਿਪੈ ਕ੍ਰੂਰ ਬਕ੍ਰੰ ॥੪੪॥",
      "s": 2
    },
    {
      "t": "ਨਰਾਜ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਅਨੂਪ ਰੂਪ ਰਾਜਿਅੰ ॥",
      "s": 2
    },
    {
      "t": "ਨਿਹਾਰ ਕਾਮੁ ਲਾਜਿਅੰ ॥",
      "s": 2
    },
    {
      "t": "ਅਲੋਕ ਲੋਕ ਸੋਭਿਅੰ ॥",
      "s": 2
    },
    {
      "t": "ਬਿਲੋਕ ਲੋਕ ਲੋਭਿਅੰ ॥੪੫॥",
      "s": 2
    },
    {
      "t": "ਚਮੱਕ ਚੰਦ੍ਰ ਸੀਸਿਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਰਹਿਓ ਲਜਾਇ ਈਸਯੰ ॥",
      "s": 2
    }
  ]
}
