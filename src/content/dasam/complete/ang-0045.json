{
  "page": 45,
  "lines": [
    {
      "t": "ਰਸਾਵਲ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਤੇ ਰਾਮ ਹੂਏ ॥",
      "s": 2
    },
    {
      "t": "ਸਭੈ ਅੰਤ ਮੂਏ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਤੇ ਕ੍ਰਿਸਨ ਹ੍ਵੈਹੈਂ ॥",
      "s": 2
    },
    {
      "t": "ਸਭੈ ਅੰਤ ਜੈਹੈਂ ॥੭੦॥",
      "s": 2
    },
    {
      "t": "ਜਿਤੇ ਦੇਵ ਹੋਸੀ ॥",
      "s": 2
    },
    {
      "t": "ਸਭੇ ਅੰਤ ਜਾਸੀ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਤੇ ਬੋਧ ਹ੍ਵੈਹੈਂ ॥",
      "s": 2
    },
    {
      "t": "ਸਭੈ ਅੰਤ ਛੈਹੈਂ ॥੭੧॥",
      "s": 2
    },
    {
      "t": "ਜਿਤੇ ਦੇਵ ਰਾਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਸਭੈ ਅੰਤ ਜਾਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਤੇ ਦਈਤ ਏਸੰ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਤਿਓ ਕਾਲ ਲੇਸੰ ॥੭੨॥",
      "s": 2
    },
    {
      "t": "ਨਰਸਿੰਘਾਵਤਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਵਹੈ ਕਾਲ ਮਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਬਡੋ ਡੰਡ ਧਾਰੀ ॥",
      "s": 2
    },
    {
      "t": "ਹਣਿਓ ਕਾਲ ਭਾਰੀ ॥੭੩॥",
      "s": 2
    },
    {
      "t": "ਦਿਜੈ ਬਾਵਨੇਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਹਣਿਓ ਕਾਲ ਤੇਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਮਹਾ ਮੱਛ ਮੁੰਡੰ ॥",
      "s": 2
    },
    {
      "t": "ਫਧਿਓ ਕਾਲ ਝੁੰਡੰ ॥੭੪॥",
      "s": 2
    },
    {
      "t": "ਜਿਤੇ ਹੋਇ ਬੀਤੇ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਤੇ ਕਾਲ ਜੀਤੇ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਤੇ ਸਰਨਿ ਜੈਹੈਂ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਤਿਓ ਰਾਖ ਲੈਹੈਂ ॥੭੫॥",
      "s": 2
    },
    {
      "t": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਬਿਨਾ ਸਰਨ ਤਾ ਕੀ ਨ ਅਉਰੈ ਉਪਾਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਕਹਾ ਦੇਵ ਦਈਤੰ ਕਹਾ ਰੰਕ ਰਾਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਕਹਾ ਪਾਤਸਾਹੰ ਕਹਾ ਉਮਰਾਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਬਿਨਾ ਸਰਨ ਤਾ ਕੀ ਨ ਕੋਟੈ ਉਪਾਯੰ ॥੭੬॥",
      "s": 2
    },
    {
      "t": "ਜਿਤੇ ਜੀਵ ਜੰਤੰ ਸੁ ਦੁਨੀਅੰ ਉਪਾਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਸਭੈ ਅੰਤ ਕਾਲੰ ਬਲੀ ਕਾਲ ਘਾਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਬਿਨਾ ਸਰਨ ਤਾ ਕੀ ਨਹੀ ਔਰ ਓਟੰ ॥",
      "s": 2
    },
    {
      "t": "ਲਿਖੇ ਜੰਤ੍ਰ ਕੇਤੇ ਪੜ੍ਹੇ ਮੰਤ੍ਰ ਕੋਟੰ ॥੭੭॥",
      "s": 2
    },
    {
      "t": "ਨਰਾਜ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਤੇਕ ਰਾਜ ਰੰਕਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਹਨੇ ਸੁ ਕਾਲ ਬੰਕਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਤੇਕ ਲੋਕ ਪਾਲਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਨਿਦਾਨ ਕਾਲ ਦਾਲਯੰ ॥੭੮॥",
      "s": 2
    },
    {
      "t": "ਕ੍ਰਿਪਾਣ ਪਾਣ ਜੇ ਜਪੈ ॥",
      "s": 2
    },
    {
      "t": "ਅਨੰਤ ਥਾਟ ਤੇ ਥਪੈ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਤੇਕ ਕਾਲ ਧ੍ਯਾਇ ਹੈ ॥",
      "s": 2
    },
    {
      "t": "ਜਗਤ ਜੀਤ ਜਾਇ ਹੈ ॥੭੯॥",
      "s": 2
    },
    {
      "t": "ਬਚਿਤ੍ਰ ਚਾਰੁ ਚਿਤ੍ਰਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਪਰਮਯੰ ਪਵਿਤ੍ਰਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਅਲੋਕ ਰੂਪ ਰਾਜਿਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਸੁਣੇ ਸੁ ਪਾਪ ਭਾਜਿਯੰ ॥੮੦॥",
      "s": 2
    },
    {
      "t": "ਬਿਸਾਲ ਲਾਲ ਲੋਚਨੰ ॥",
      "s": 2
    },
    {
      "t": "ਬਿਅੰਤ ਪਾਪ ਮੋਚਨੰ ॥",
      "s": 2
    },
    {
      "t": "ਚਮੱਕ ਚੰਦ੍ਰ ਚਾਰੀਅੰ ॥",
      "s": 2
    },
    {
      "t": "ਅਘੀ ਅਨੇਕ ਤਾਰੀਅੰ ॥੮੧॥",
      "s": 2
    },
    {
      "t": "ਰਸਾਵਲ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਤੇ ਲੋਕ ਪਾਲੰ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਤੇ ਜੇਰ ਕਾਲੰ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਤੇ ਸੂਰ ਚੰਦ੍ਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਕਹਾ ਇੰਦ੍ਰ ਬਿੰਦ੍ਰੰ ॥੮੨॥",
      "s": 2
    },
    {
      "t": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਫਿਰੇ ਚੌਦਹੂੰ ਲੋਕਯੰ ਕਾਲ ਚਕ੍ਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਸਭੈ ਨਾਥ ਨਾਥੇ ਭ੍ਰਮੰ ਭਉਂਹ ਬਕ੍ਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਕਹਾ ਰਾਮ ਕ੍ਰਿਸਨੰ ਕਹਾ ਚੰਦ ਸੂਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਸਭੈ ਹਾਥ ਬਾਧੇ ਖਰੇ ਕਾਲ ਹਜੂਰੰ ॥੮੩॥",
      "s": 2
    },
    {
      "t": "ਸਵੈਯਾ ॥",
      "s": 2
    },
    {
      "t": "ਕਾਲ ਹੀ ਪਾਇ ਭਯੋ ਭਗਵਾਨ ਸੁ ਜਾਗਤ ਯਾ ਜਗ ਜਾ ਕੀ ਕਲਾ ਹੈ ॥",
      "s": 2
    },
    {
      "t": "ਕਾਲ ਹੀ ਪਾਇ ਭਯੋ ਬ੍ਰਹਮਾ ਸਿਵ ਕਾਲ ਹੀ ਪਾਇ ਭਯੋ ਜੁਗੀਆ ਹੈ ॥",
      "s": 2
    },
    {
      "t": "ਕਾਲ ਹੀ ਪਾਇ ਸੁਰਾਸੁਰ ਗੰਧ੍ਰਬ ਜੱਛ ਭੁਜੰਗ ਦਿਸਾ ਬਿਦਿਸਾ ਹੈ ॥",
      "s": 2
    },
    {
      "t": "ਔਰ ਸੁਕਾਲ ਸਭੈ ਬਸ ਕਾਲ ਕੇ ਏਕ ਹੀ ਕਾਲ ਅਕਾਲ ਸਦਾ ਹੈ ॥੮੪॥",
      "s": 2
    },
    {
      "t": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਨਮੋ ਦੇਵ ਦੇਵੰ ਨਮੋ ਖੜਗਧਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਸਦਾ ਏਕ ਰੂਪੰ ਸਦਾ ਨਿਰਬਿਕਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਨਮੋ ਰਾਜਸੰ ਸਾਤਕੰ ਤਾਮਸੇਅੰ ॥",
      "s": 2
    },
    {
      "t": "ਨਮੋ ਨਿਰਬਿਕਾਰੰ ਨਮੋ ਨਿਰਜੁਰੇਅੰ ॥੮੫॥",
      "s": 2
    },
    {
      "t": "ਰਸਾਵਲ ਛੰਦ ॥",
      "s": 2
    }
  ]
}
