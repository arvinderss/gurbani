{
  "page": 50,
  "lines": [
    {
      "t": "ਰਚਾ ਬੈਰ ਬਾਦੰ ਬਿਧਾਤੇ ਅਪਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਸੈ ਸਾਧ ਸਾਕਿਓ ਨ ਕੋਊ ਸੁਧਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਬਲੀ ਕਾਮਰਾਯੰ ਮਹਾ ਲੋਭ ਮੋਹੰ ॥",
      "s": 2
    },
    {
      "t": "ਗਯੋ ਕਉਨ ਬੀਰੰ ਸੁ ਯਾ ਤੇ ਅਲੋਹੰ ॥੧॥",
      "s": 2
    },
    {
      "t": "ਤਹਾਂ ਬੀਰ ਬੰਕੇ ਬਕੈ ਆਪ ਮੱਧੰ ॥",
      "s": 2
    },
    {
      "t": "ਉਠੇ ਸਸਤ੍ਰ ਲੈ ਲੈ ਮਚਾ ਜੁੱਧ ਸੁੱਧੰ ॥",
      "s": 2
    },
    {
      "t": "ਕਹੂੰ ਖੱਪਰੀ ਖੋਲ ਖੰਡੇ ਅਪਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਨਚੇ ਬੀਰ ਬੈਤਾਲ ਡਉਰੂ ਡਕਾਰੰ ॥੨॥",
      "s": 2
    },
    {
      "t": "ਕਹੂੰ ਈਸ ਸੀਸੰ ਪੁਐ ਰੁੰਡ ਮਾਲੰ ॥",
      "s": 2
    },
    {
      "t": "ਕਹੂੰ ਡਾਕ ਡਉਰੂ ਕਹੂੰ ਕੰਬਿਤਾਲੰ ॥",
      "s": 2
    },
    {
      "t": "ਚਵੀ ਚਾਵਡੀਅੰ ਕਿਲੰਕਾਰ ਕੰਕੰ ॥",
      "s": 2
    },
    {
      "t": "ਗੁਥੀ ਲੁੱਥ ਜੁੱਥੰ ਬਹੇ ਬੀਰ ਬੰਕੰ ॥੩॥",
      "s": 2
    },
    {
      "t": "ਪਰੀ ਕੁੱਟ ਕੁੱਟੰ ਰੁਲੇ ਤੱਛ ਮੁੱਛੰ ॥",
      "s": 2
    },
    {
      "t": "ਰਹੇ ਹਾਥ ਡਾਰੇ ਉਭੈ ਉਰਧ ਮੁੱਛੰ ॥",
      "s": 2
    },
    {
      "t": "ਕਹੂੰ ਖੋਪਰੀ ਖੋਲ ਖਿੰਗੰ ਖਤੰਗੰ ॥",
      "s": 2
    },
    {
      "t": "ਕਹੂੰ ਖਤ੍ਰੀਯੰ ਖੱਗ ਖੇਤੰ ਨਿਖੰਗੰ ॥੪॥",
      "s": 2
    },
    {
      "t": "ਚਵੀ ਚਾਂਵਡੀ ਡਾਕਨੀ ਡਾਕ ਮਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਕਹੂੰ ਭੈਰਵੀ ਭੂਤ ਭੈਰੋਂ ਬਕਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਕਹੂੰ ਬੀਰ ਬੈਤਾਲ ਬੰਕੇ ਬਿਹਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਕਹੂੰ ਭੂਤ ਪ੍ਰੇਤੰ ਹਸੇ ਮਾਸਹਾਰੰ ॥੫॥",
      "s": 2
    },
    {
      "t": "ਰਸਾਵਲ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਮਹਾਂ ਬੀਰ ਗੱਜੇ ॥",
      "s": 2
    },
    {
      "t": "ਸੁਣੈ ਮੇਘ ਲੱਜੇ ॥",
      "s": 2
    },
    {
      "t": "ਝੰਡਾ ਗੱਡ ਗਾਢੇ ॥",
      "s": 2
    },
    {
      "t": "ਮੰਡੇ ਰੋਸ ਬਾਢੇ ॥੬॥",
      "s": 2
    },
    {
      "t": "ਕ੍ਰਿਪਾਣੰ ਕਟਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਭਿਰੇ ਰੋਸ ਧਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਮਹਾਂ ਬੀਰ ਬੰਕੰ ॥",
      "s": 2
    },
    {
      "t": "ਭਿਰੇ ਭੂਮ ਹੰਕੰ ॥੭॥",
      "s": 2
    },
    {
      "t": "ਮਚੇ ਸੂਰ ਸਸਤ੍ਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਉਠੀ ਝਾਰ ਅਸਤ੍ਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਕ੍ਰਿਪਾਣੰ ਕਟਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਪਰੀ ਲੋਹ ਮਾਰੰ ॥੮॥",
      "s": 2
    },
    {
      "t": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਹੱਲਬੀ ਜੁਨੱਬੀ ਸਰੋਹੀ ਦੁਧਾਰੀ ॥",
      "s": 2
    },
    {
      "t": "ਬਹੀ ਕੋਪ ਕਾਤੀ ਕ੍ਰਿਪਾਣੰ ਕਟਾਰੀ ॥",
      "s": 2
    },
    {
      "t": "ਕਹੂੰ ਸੈਹਥੀਅੰ ਕਹੂੰ ਸੁੱਧ ਸੇਲੰ ॥",
      "s": 2
    },
    {
      "t": "ਕਹੂੰ ਸੇਲ ਸਾਂਗੰ ਭਈ ਰੇਲ ਪੇਲੰ ॥੯॥",
      "s": 2
    },
    {
      "t": "ਨਰਾਜ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਸਰੋਖ ਸੂਰ ਸਾਜਿਅੰ ॥",
      "s": 2
    },
    {
      "t": "ਬਿਸਾਰ ਸੰਕ ਬਾਜਿਅੰ ॥",
      "s": 2
    },
    {
      "t": "ਨਿਸੰਕ ਸਸਤ੍ਰ ਮਾਰਹੀ ॥",
      "s": 2
    },
    {
      "t": "ਉਤਾਰ ਅੰਗ ਡਾਰਹੀ ॥੧੦॥",
      "s": 2
    },
    {
      "t": "ਕਛੂ ਨ ਕਾਨ ਰਾਖਹੀਂ ॥",
      "s": 2
    },
    {
      "t": "ਸੁ ਮਾਰ ਮਾਰ ਭਾਖਹੀਂ ॥",
      "s": 2
    },
    {
      "t": "ਸੁ ਹਾਂਕ ਹਾਠ ਰੇਲਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਅਨੰਤ ਸਸਤ੍ਰ ਝੇਲਯੰ ॥੧੧॥",
      "s": 2
    },
    {
      "t": "ਹਜਾਰ ਹੂਰ ਅੰਬਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਬਿਰੁਧ ਕੈ ਸ੍ਵਯੰਬਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਕਰੂਰ ਭਾਂਤ ਡੋਲਹੀ ॥",
      "s": 2
    },
    {
      "t": "ਸੁ ਮਾਰ ਮਾਰ ਬੋਲਹੀ ॥੧੨॥",
      "s": 2
    },
    {
      "t": "ਕਹੂੰ ਕਿ ਅੰਗ ਕੱਟੀਅੰ ॥",
      "s": 2
    },
    {
      "t": "ਕਹੂੰ ਸੁਰੋਹ ਪੱਟੀਅੰ ॥",
      "s": 2
    },
    {
      "t": "ਕਹੂੰ ਸੁ ਮਾਸ ਮੁੱਛੀਅੰ ॥",
      "s": 2
    },
    {
      "t": "ਗਿਰੇ ਸੁ ਤੱਛ ਮੁੱਛੀਅੰ ॥੧੩॥",
      "s": 2
    },
    {
      "t": "ਢਮੱਕ ਢੋਲ ਢਾਲਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਹਰੋਲ ਹਾਲ ਚਾਲਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਝਟਾਕ ਝਟ ਬਾਹੀਅੰ ॥",
      "s": 2
    },
    {
      "t": "ਸੁ ਬੀਰ ਸੈਨ ਗਾਹੀਅੰ ॥੧੪॥",
      "s": 2
    },
    {
      "t": "ਨਵੰ ਨਿਸਾਣ ਬਾਜਿਅੰ ॥",
      "s": 2
    },
    {
      "t": "ਸੁ ਬੀਰ ਧੀਰ ਗਾਜਿਅੰ ॥",
      "s": 2
    },
    {
      "t": "ਕ੍ਰਿਪਾਣ ਬਾਣ ਬਾਹਹੀ ॥",
      "s": 2
    },
    {
      "t": "ਅਜਾਤ ਅੰਗ ਲਾਹਹੀ ॥੧੫॥",
      "s": 2
    },
    {
      "t": "ਬਿਰੁੱਧ ਕ੍ਰੁੱਧ ਰਾਜਿਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਨ ਚਾਰ ਪੈਰ ਭਾਜਿਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਸੰਭਾਰ ਸਸਤ੍ਰ ਗਾਜਹੀ ॥",
      "s": 2
    },
    {
      "t": "ਸੁ ਨਾਦ ਮੇਘ ਲਾਜਹੀ ॥੧੬॥",
      "s": 2
    },
    {
      "t": "ਹਲੰਕ ਹਾਕ ਮਾਰਹੀ ॥",
      "s": 2
    },
    {
      "t": "ਸਰੱਕ ਸਸਤ੍ਰ ਝਾਰਹੀ ॥",
      "s": 2
    },
    {
      "t": "ਭਿਰੇ ਬਿਸਾਰਿ ਸੋਕਿਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਸਿਧਾਰ ਦੇਵ ਲੋਕਿਯੰ ॥੧੭॥",
      "s": 2
    },
    {
      "t": "ਰਿਸੇ ਬਿਰੁੱਧ ਬੀਰਯੰ ॥",
      "s": 2
    }
  ]
}
