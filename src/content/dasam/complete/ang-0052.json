{
  "page": 52,
  "lines": [
    {
      "t": "ਹਸੇ ਮਾਸਹਾਰੀ ॥",
      "s": 2
    },
    {
      "t": "ਨਚੇ ਭੂਤ ਭਾਰੀ ॥",
      "s": 2
    },
    {
      "t": "ਮਹਾ ਢੀਠ ਢੂਕੇ ॥",
      "s": 2
    },
    {
      "t": "ਮੁਖੰ ਮਾਰ ਕੂਕੇ ॥੩੦॥",
      "s": 2
    },
    {
      "t": "ਗਜੈ ਗੈਣ ਦੇਵੀ ॥",
      "s": 2
    },
    {
      "t": "ਮਹਾ ਅੰਸ ਭੇਵੀ ॥",
      "s": 2
    },
    {
      "t": "ਭਲੇ ਭੂਤ ਨਾਚੰ ॥",
      "s": 2
    },
    {
      "t": "ਰਸੰ ਰੁਦ੍ਰ ਰਾਚੰ ॥੩੧॥",
      "s": 2
    },
    {
      "t": "ਭਿਰੈ ਬੈਰ ਰੁੱਝੈ ॥",
      "s": 2
    },
    {
      "t": "ਮਹਾ ਜੋਧ ਜੁੱਝੈ ॥",
      "s": 2
    },
    {
      "t": "ਝੰਡਾ ਗੱਡ ਗਾਢੇ ॥",
      "s": 2
    },
    {
      "t": "ਬਜੇ ਬੈਰ ਬਾਢੇ ॥੩੨॥",
      "s": 2
    },
    {
      "t": "ਗਜੰ ਗਾਹ ਬਾਧੇ ॥",
      "s": 2
    },
    {
      "t": "ਧਨੁਰ ਬਾਣ ਸਾਧੇ ॥",
      "s": 2
    },
    {
      "t": "ਬਹੇ ਆਪ ਮੱਧੰ ॥",
      "s": 2
    },
    {
      "t": "ਗਿਰੇ ਅੱਧ ਅੱਧੰ ॥੩੩॥",
      "s": 2
    },
    {
      "t": "ਗਜੰ ਬਾਜ ਜੁੱਝੇ ॥",
      "s": 2
    },
    {
      "t": "ਬਲੀ ਬੈਰ ਰੁੱਝੇ ॥",
      "s": 2
    },
    {
      "t": "ਨ੍ਰਿਭੈ ਸਸਤ੍ਰ ਬਾਹੈਂ ॥",
      "s": 2
    },
    {
      "t": "ਉਭੈ ਜੀਤ ਚਾਹੈਂ ॥੩੪॥",
      "s": 2
    },
    {
      "t": "ਗਜੇ ਆਨ ਗਾਜੀ ॥",
      "s": 2
    },
    {
      "t": "ਨਚੇ ਤੁੰਦ ਤਾਜੀ ॥",
      "s": 2
    },
    {
      "t": "ਹਕੰ ਹਾਕ ਬੱਜੀ ॥",
      "s": 2
    },
    {
      "t": "ਫਿਰੈ ਸੈਨ ਭੱਜੀ ॥੩੫॥",
      "s": 2
    },
    {
      "t": "ਮਦੰ ਮੱਤ ਮਾਤੇ ॥",
      "s": 2
    },
    {
      "t": "ਰਸੰ ਰੁਦ੍ਰ ਰਾਤੇ ॥",
      "s": 2
    },
    {
      "t": "ਗਜੰ ਜੂਹ ਸਾਜੇ ॥",
      "s": 2
    },
    {
      "t": "ਭਿਰੇ ਰੋਸ ਬਾਜੇ ॥੩੬॥",
      "s": 2
    },
    {
      "t": "ਝਮੀ ਤੇਜ ਤੇਗੰ ॥",
      "s": 2
    },
    {
      "t": "ਘਣੰ ਬਿਜ ਬੇਗੰ ॥",
      "s": 2
    },
    {
      "t": "ਬਹੇ ਬਾਰ ਬੈਰੀ ॥",
      "s": 2
    },
    {
      "t": "ਜਲੰ ਜਯੋ ਗੰਗੈਰੀ ॥੩੭॥",
      "s": 2
    },
    {
      "t": "ਅਪੋ ਆਪ ਬਾਹੰ ॥",
      "s": 2
    },
    {
      "t": "ਉਭੈ ਜੀਤ ਚਾਹੰ ॥",
      "s": 2
    },
    {
      "t": "ਰਸੰ ਰੁਦ੍ਰ ਰਾਤੇ ॥",
      "s": 2
    },
    {
      "t": "ਮਹਾਂ ਮੱਤ ਮਾਤੇ ॥੩੮॥",
      "s": 2
    },
    {
      "t": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਮਚੇ ਬੀਰ ਬੀਰੰ ਅਭੂਤੰ ਭਯਾਣੰ ॥",
      "s": 2
    },
    {
      "t": "ਬਜੀ ਭੇਰ ਭੁੰਕਾਰ ਧੁੱਕੇ ਨਿਸਾਣੰ ॥",
      "s": 2
    },
    {
      "t": "ਨਵੰ ਨੱਦ ਨੀਸਾਣ ਗੱਜੇ ਗਹੀਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਫਿਰੈ ਰੁੰਡ ਮੁੰਡੰ ਤਨੰ ਤੱਛ ਤੀਰੰ ॥੩੯॥",
      "s": 2
    },
    {
      "t": "ਬਹੇ ਖੱਗ ਖੇਤੰ ਖਿਆਲੰ ਖਤੰਗੰ ॥",
      "s": 2
    },
    {
      "t": "ਰੁਲੇ ਤੱਛ ਮੁੱਛੰ ਮਹਾ ਜੋਧ ਜੰਗੰ ॥",
      "s": 2
    },
    {
      "t": "ਬੰਧੇ ਬੀਰ ਬਾਨਾ ਬਡੇ ਐਠਿ ਵਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਘੁਮੈ ਲੋਹ ਘੁੱਟੰ ਮਨੋ ਮਤਵਾਰੇ ॥੪੦॥",
      "s": 2
    },
    {
      "t": "ਉਠੀ ਕੂਹ ਜੂਹੰ ਸਮਰ ਸਾਰ ਬੱਜਿਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਕਿਧੋ ਅੰਤ ਕੇ ਕਾਲ ਕੋ ਮੇਘ ਗੱਜਿਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਭਈ ਤੀਰ ਭੀਰੰ ਕਮਾਣੰ ਕੱੜਕਿਯੰ ॥",
      "s": 2
    }
  ]
}
