{
  "page": 53,
  "lines": [
    {
      "t": "ਬਜੇ ਲੋਹ ਕ੍ਰੋਹੰ ਮਹਾਂ ਜੰਗ ਮੱਚਿਯੰ ॥੪੧॥",
      "s": 2
    },
    {
      "t": "ਬਿਰੱਚੇ ਮਹਾਂ ਜੰਗ ਜੋਧਾ ਜੁਆਣੰ ॥",
      "s": 2
    },
    {
      "t": "ਖੁਲੇ ਖੱਗ ਖਤ੍ਰੀ ਅਭੂਤੰ ਭਯਾਣੰ ॥",
      "s": 2
    },
    {
      "t": "ਬਲੀ ਜੁੱਝ ਰੁੱਝੈ ਰਸੰ ਰੁਦ੍ਰ ਰੱਤੇ ॥",
      "s": 2
    },
    {
      "t": "ਮਿਲੇ ਹੱਥ ਬੱਖੰ ਮਹਾ ਤੇਜ ਤੱਤੇ ॥੪੨॥",
      "s": 2
    },
    {
      "t": "ਝਮੀ ਤੇਜ ਤੇਗੰ ਸੁ ਰੋਸੰ ਪ੍ਰਹਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਰੁਲੇ ਰੁੰਡ ਮੁੰਡੰ ਉਠੀ ਸਸਤ੍ਰ ਝਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਬਬਕੰਤ ਬੀਰੰ ਭਭਕੰਤ ਘਾਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਮਨੋ ਜੁੱਧ ਇੰਦ੍ਰੰ ਜੁਟਿਓ ਬ੍ਰਿਤਰਾਯੰ ॥੪੩॥",
      "s": 2
    },
    {
      "t": "ਮਹਾਂ ਜੁੱਧ ਮੱਚਿਯੰ ਮਹਾਂ ਸੂਰ ਗਾਜੇ ॥",
      "s": 2
    },
    {
      "t": "ਅਪੋ ਆਪ ਮੈਂ ਸਸਤ੍ਰ ਸੋਂ ਸਸਤ੍ਰ ਬਾਜੇ ॥",
      "s": 2
    },
    {
      "t": "ਉਠੇ ਝਾਰ ਸਾਂਗੰ ਮਚੇ ਲੋਹ ਕ੍ਰੋਹੰ ॥",
      "s": 2
    },
    {
      "t": "ਮਨੋ ਖੇਲ ਬਾਸੰਤ ਮਾਹੰਤ ਸੋਹੰ ॥੪੪॥",
      "s": 2
    },
    {
      "t": "ਰਸਾਵਲ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਤੇ ਬੈਰ ਰੁੱਝੰ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਤੇ ਅੰਤ ਜੁੱਝੰ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਤੇ ਖੇਤ ਭਾਜੇ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਤੇ ਅੰਤ ਲਾਜੇ ॥੪੫॥",
      "s": 2
    },
    {
      "t": "ਤੁਟੇ ਦੇਹ ਬਰਮੰ ॥",
      "s": 2
    },
    {
      "t": "ਛੁਟੀ ਹਾਥ ਚਰਮੰ ॥",
      "s": 2
    },
    {
      "t": "ਕਹੂੰ ਖੇਤ ਖੋਲੰ ॥",
      "s": 2
    },
    {
      "t": "ਗਿਰੇ ਸੂਰ ਟੋਲੰ ॥੪੬॥",
      "s": 2
    },
    {
      "t": "ਕਹੂੰ ਮੁੱਛ ਮੁੱਖੰ ॥",
      "s": 2
    },
    {
      "t": "ਕਹੂੰ ਸਸਤ੍ਰ ਸੱਖੰ ॥",
      "s": 2
    },
    {
      "t": "ਕਹੂੰ ਖੋਲ ਖੱਗੰ ॥",
      "s": 2
    },
    {
      "t": "ਕਹੂੰ ਪਰਮ ਪੱਗੰ ॥੪੭॥",
      "s": 2
    },
    {
      "t": "ਗਹੇ ਮੁੱਛ ਬੰਕੀ ॥",
      "s": 2
    },
    {
      "t": "ਮੰਡੇ ਆਨ ਹੰਕੀ ॥",
      "s": 2
    },
    {
      "t": "ਢਕਾ ਢੁੱਕ ਢਾਲੰ ॥",
      "s": 2
    },
    {
      "t": "ਉਠੇ ਹਾਲ ਚਾਲੰ ॥੪੮॥",
      "s": 2
    },
    {
      "t": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਖੁਲੇ ਖੱਗ ਖੂਨੀ ਮਹਾਂ ਬੀਰ ਖੇਤੰ ॥",
      "s": 2
    },
    {
      "t": "ਨਚੇ ਬੀਰ ਬੈਤਾਲਯੰ ਭੂਤ ਪ੍ਰੇਤੰ ॥",
      "s": 2
    },
    {
      "t": "ਬਜੇ ਡੰਕ ਡਉਰੂ ਉਠੇ ਨਾਦ ਸੰਖੰ ॥",
      "s": 2
    },
    {
      "t": "ਮਨੋ ਮੱਲ ਜੁੱਟੇ ਮਹਾਂ ਹੱਥ ਬੰਖੰ ॥੪੯॥",
      "s": 2
    },
    {
      "t": "ਛਪੈ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਨ ਸੂਰਨ ਸੰਗ੍ਰਾਮ ਸਬਲ ਸਾਮੁਹਿ ਹ੍ਵੈ ਮੰਡਿਓ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਨ ਸੁਭਟਨ ਤੇ ਏਕ ਕਾਲ ਕੋਊ ਜੀਅਤ ਨ ਛੱਡਿਓ ॥",
      "s": 2
    },
    {
      "t": "ਸਭ ਖੱਤ੍ਰੀ ਖੱਗ ਖੰਡ ਖੇਤ ਭੂ ਮੰਡਪ ਆਹੁੱਟੇ ॥",
      "s": 2
    },
    {
      "t": "ਸਾਰ ਧਾਰ ਧਰ ਧੂਮ ਮੁਕਤ ਬੰਧਨ ਤੇ ਛੁੱਟੇ ॥",
      "s": 2
    },
    {
      "t": "ਹ੍ਵੈ ਟੂਕ ਟੂਕ ਜੁੱਝੈ ਸਬੈ ਪਾਵ ਨ ਪਾਛੈ ਡਾਰੀਅੰ ॥",
      "s": 2
    },
    {
      "t": "ਜੈਕਾਰ ਅਪਾਰ ਸੁਧਾਰ ਹੁਅੰ ਬਾਸਿਵ ਲੋਕ ਸਿਧਾਰੀਅੰ ॥੫੦॥",
      "s": 2
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 2
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਮਚਾ ਘੋਰ ਸੰਗ੍ਰਾਮਾ ॥",
      "s": 2
    },
    {
      "t": "ਸਿਧਏ ਸੂਰ ਸੂਰਿ ਕੇ ਧਾਮਾ ॥",
      "s": 2
    },
    {
      "t": "ਕਹਾ ਲਗੈ ਵਹ ਕਥੋਂ ਲਰਾਈ ॥",
      "s": 2
    },
    {
      "t": "ਆਪਨ ਪ੍ਰਭਾ ਨ ਬਰਨੀ ਜਾਈ ॥੫੧॥",
      "s": 2
    },
    {
      "t": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਲਵੀ ਸਰਬ ਜੀਤੇ ਕੁਸੀ ਸਰਬ ਹਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਬਚੇ ਜੇ ਬਲੀ ਪ੍ਰਾਨ ਲੈ ਕੇ ਸਿਧਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਚਤੁਰ ਬੇਦ ਪਠਿਯੰ ਕੀ੍ਯੋ ਕਾਸਿ ਬਾਸੰ ॥",
      "s": 2
    },
    {
      "t": "ਘਨੇ ਬਰਖ ਕੀਨੇ ਤਹਾਂ ਹੀ ਨਿਵਾਸੰ ॥੫੨॥",
      "s": 2
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਲਵੀ ਕੁਸ਼ੀ ਜੁੱਧ ਬਰਨਨੰ ਨਾਮ ਤ੍ਰਿਤੀਆ ਧਿਆਇ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩॥ ਅਫਜੂ ॥੧੮੯॥",
      "s": 2
    },
    {
      "t": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਨੈ ਬੇਦ ਪਠਿਓ ਸੁ ਬੇਦੀ ਕਹਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਨੈ ਧਰਮ ਕੇ ਕਰਮ ਨੀਕੇ ਚਲਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਪਠੇ ਕਾਗਦੰ ਮੱਦ੍ਰ ਰਾਜਾ ਸੁਧਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਅਪੋ ਆਪ ਮੋ ਬੈਰ ਭਾਵੰ ਬਿਸਾਰੰ ॥੧॥",
      "s": 2
    },
    {
      "t": "ਨ੍ਰਿਪੰ ਮੁਕਲਿਅੰ ਦੂਤ ਸੋ ਕਾਸਿ ਆਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਸਬੈ ਬੇਦਿਯੰ ਭੇਦ ਭਾਖੇ ਸੁਨਾਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਸਬੈ ਬੇਦ ਪਾਠੀ ਚਲੇ ਮੱਦ੍ਰ ਦੇਸੰ ॥",
      "s": 2
    },
    {
      "t": "ਪ੍ਰਣਾਮੰ ਕੀਯੋ ਆਨ ਕੈ ਕੈ ਨਰੇਸੰ ॥੨॥",
      "s": 2
    },
    {
      "t": "ਧੁਨੰ ਬੇਦ ਕੀ ਭੂਪ ਤਾਂ ਤੇ ਕਰਾਈ ॥",
      "s": 2
    },
    {
      "t": "ਸਬੈ ਪਾਸ ਬੈਠੇ ਸਭਾ ਬੀਚ ਭਾਈ ॥",
      "s": 2
    },
    {
      "t": "ਪੜ੍ਹੇ ਸਾਮ ਬੇਦੰ ਜੁਜਰ ਬੇਦ ਕੱਥੰ ॥",
      "s": 2
    },
    {
      "t": "ਰਿਗੰ ਬੇਦ ਪਠਿਯੰ ਕਰੇ ਭਾਵ ਹੱਥੰ ॥੩॥",
      "s": 2
    },
    {
      "t": "ਰਸਾਵਲ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਅਥਰ ਬੇਦ ਪੱਠਿਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਸੁਣੇ ਪਾਪ ਨੱਠਿਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਰਹਾ ਰੀਝ ਰਾਜਾ ॥",
      "s": 2
    },
    {
      "t": "ਦੀਯਾ ਸਰਬ ਸਾਜਾ ॥੪॥",
      "s": 2
    },
    {
      "t": "ਲਯੋ ਬਨਬਾਸੰ ॥",
      "s": 2
    }
  ]
}
