{
  "page": 57,
  "lines": [
    {
      "t": "ਪਾਰਬ੍ਰਹਮ ਕੇ ਭਏ ਅਨੁਰਾਗੀ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਨ ਕੇ ਗੂੜ ਮੱਤ ਜੇ ਚਲਹੀ ॥",
      "s": 2
    },
    {
      "t": "ਭਾਂਤਿ ਅਨੇਕ ਦੁਖਨ ਸੋ ਦਲਹੀ ॥੨੦॥",
      "s": 2
    },
    {
      "t": "ਜੇ ਜੇ ਸਹਿਤ ਜਾਤਨ ਸੰਦੇਹਿ ॥",
      "s": 2
    },
    {
      "t": "ਪ੍ਰਭ ਕੋ ਸੰਗਿ ਨ ਛੋਡਤ ਨੇਹ ॥",
      "s": 2
    },
    {
      "t": "ਤੇ ਤੇ ਪਰਮ ਪੁਰੀ ਕਹ ਜਾਹੀ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਨ ਹਰਿ ਸਿਉ ਅੰਤਰੁ ਕਛੁ ਨਾਹੀਂ ॥੨੧॥",
      "s": 2
    },
    {
      "t": "ਜੇ ਜੇ ਜੀਯ ਜਾਤਨ ਤੇ ਡਰੈ ॥",
      "s": 2
    },
    {
      "t": "ਪਰਮ ਪੁਰਖ ਤਜਿ ਤਿਨ ਮਗ ਪਰੈ ॥",
      "s": 2
    },
    {
      "t": "ਤੇ ਤੇ ਨਰਕ ਕੁੰਡ ਮੋ ਪਰਹੀ ॥",
      "s": 2
    },
    {
      "t": "ਬਾਰ ਬਾਰ ਜਗ ਮੋ ਬਪੁ ਧਰਹੀ ॥੨੨॥",
      "s": 2
    },
    {
      "t": "ਤਬ ਹਰਿ ਬਹੁਰ ਦੱਤ ਉਪਜਾਇਓ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਨ ਭੀ ਅਪਨਾ ਪੰਥੁ ਚਲਾਇਓ ॥",
      "s": 2
    },
    {
      "t": "ਕਰ ਮੋ ਨਖ ਸਿਰ ਜਟਾਂ ਸਵਾਰੀ ॥",
      "s": 2
    },
    {
      "t": "ਪ੍ਰਭ ਕੀ ਕ੍ਰਿਆ ਨ ਕਛੂ ਬਿਚਾਰੀ ॥੨੩॥",
      "s": 2
    },
    {
      "t": "ਪੁਨਿ ਹਰਿ ਗੋਰਖ ਕੌ ਉਪਰਾਜਾ ॥",
      "s": 2
    },
    {
      "t": "ਸਿੱਖ ਕਰੇ ਤਿਨਹੂੰ ਬਡ ਰਾਜਾ ॥",
      "s": 2
    },
    {
      "t": "ਸ੍ਰਵਨ ਫਾਰਿ ਮੁਦ੍ਰਾ ਦੁਐ ਡਾਰੀ ॥",
      "s": 2
    },
    {
      "t": "ਹਰਿ ਕੀ ਪ੍ਰੀਤ ਰੀਤਿ ਨ ਬਿਚਾਰੀ ॥੨੪॥",
      "s": 2
    },
    {
      "t": "ਪੁਨਿ ਹਰਿ ਰਾਮਾਨੰਦ ਕੋ ਕਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਭੇਸ ਬੈਰਾਗੀ ਕੋ ਜਿਨ ਧਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਕੰਠੀ ਕੰਠਿ ਕਾਠ ਕੀ ਡਾਰੀ ॥",
      "s": 2
    },
    {
      "t": "ਪ੍ਰਭ ਕੀ ਕ੍ਰਿਆ ਨ ਕਛੂ ਬਿਚਾਰੀ ॥੨੫॥",
      "s": 2
    },
    {
      "t": "ਜੇ ਪ੍ਰਭੁ ਪਰਮ ਪੁਰਖ ਉਪਜਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਨ ਤਿਨ ਅਪਨੇ ਰਾਹ ਚਲਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਮਹਾਦੀਨ ਤਬ ਪ੍ਰਭ ਉਪਰਾਜਾ ॥",
      "s": 2
    },
    {
      "t": "ਅਰਬ ਦੇਸ ਕੋ ਕੀਨੋ ਰਾਜਾ ॥੨੬॥",
      "s": 2
    },
    {
      "t": "ਤਿਨ ਭੀ ਏਕ ਪੰਥ ਉਪਰਾਜਾ ॥",
      "s": 2
    },
    {
      "t": "ਲਿੰਗ ਬਿਨਾ ਕੀਨੇ ਸਭ ਰਾਜਾ ॥",
      "s": 2
    },
    {
      "t": "ਸਭ ਤੇ ਅਪਨਾ ਨਾਮੁ ਜਪਾਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਸਤਿ ਨਾਮੁ ਕਾਹੂੰ ਨ ਦ੍ਰਿੜਾਯੋ ॥੨੭॥",
      "s": 2
    },
    {
      "t": "ਸਭ ਅਪਨੀ ਅਪਨੀ ਉਰਝਾਨਾ ॥",
      "s": 2
    },
    {
      "t": "ਪਾਰਬ੍ਰਹਮ ਕਾਹੂ ਨ ਪਛਾਨਾ ॥",
      "s": 2
    },
    {
      "t": "ਤਪ ਸਾਧਤ ਹਰਿ ਮੋਹਿ ਬੁਲਾਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਇਮ ਕਹਿ ਕੈ ਇਹ ਲੋਕ ਪਠਾਯੋ ॥੨੮॥",
      "s": 2
    },
    {
      "t": "ਅਕਾਲ ਪੁਰਖ ਬਾਚ ॥",
      "s": 2
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 2
    },
    {
      "t": "ਮੈ ਅਪਨਾ ਸੁਤ ਤੋਹਿ ਨਿਵਾਜਾ ॥",
      "s": 2
    },
    {
      "t": "ਪੰਥ ਪ੍ਰਚੁਰ ਕਰਬੇ ਕਹੁ ਸਾਜਾ ॥",
      "s": 2
    },
    {
      "t": "ਜਾਹਿ ਤਹਾਂ ਤੈ ਧਰਮੁ ਚਲਾਇ ॥",
      "s": 2
    },
    {
      "t": "ਕਬੁਧਿ ਕਰਨ ਤੇ ਲੋਕ ਹਟਾਇ ॥੨੯॥",
      "s": 2
    },
    {
      "t": "ਕਬਿਬਾਚ ॥ ਦੋਹਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਠਾਢ ਭਯੋ ਮੈ ਜੋਰਿ ਕਰ ਬਚਨ ਕਹਾ ਸਿਰ ਨਿਆਇ ॥",
      "s": 2
    },
    {
      "t": "ਪੰਥ ਚਲੈ ਤਬ ਜਗਤ ਮੈ ਜਬ ਤੁਮ ਕਰਹੁ ਸਹਾਇ ॥੩੦॥",
      "s": 2
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 2
    },
    {
      "t": "ਇਹ ਕਾਰਨਿ ਪ੍ਰਭ ਮੋਹਿ ਪਠਾਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਤਬ ਮੈ ਜਗਤ ਜਨਮ ਧਰਿ ਆਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਮ ਤਿਨ ਕਹੀ ਤਿਨੈ ਤਿਮ ਕਹਿਹੋਂ ॥",
      "s": 2
    }
  ]
}
