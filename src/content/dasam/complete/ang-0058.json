{
  "page": 58,
  "lines": [
    {
      "t": "ਅਉਰ ਕਿਸੂ ਤੇ ਬੈਰ ਨ ਗਹਿਹੋਂ ॥੩੧॥",
      "s": 2
    },
    {
      "t": "ਜੋ ਹਮ ਕੋ ਪਰਮੇਸਰ ਉਚਰਿਹੈਂ ॥",
      "s": 2
    },
    {
      "t": "ਤੇ ਸਭ ਨਰਕ ਕੁੰਡ ਮਹਿ ਪਰਿਹੈਂ ॥",
      "s": 2
    },
    {
      "t": "ਮੋ ਕੌ ਦਾਸ ਤਵਨ ਕਾ ਜਾਨੋ ॥",
      "s": 2
    },
    {
      "t": "ਯਾ ਮੈ ਭੇਦ ਨ ਰੰਚ ਪਛਾਨੋ ॥੩੨॥",
      "s": 2
    },
    {
      "t": "ਮੈ ਹੋ ਪਰਮ ਪੁਰਖ ਕੋ ਦਾਸਾ ॥",
      "s": 2
    },
    {
      "t": "ਦੇਖਨ ਆਯੋ ਜਗਤ ਤਮਾਸਾ ॥",
      "s": 2
    },
    {
      "t": "ਜੋ ਪ੍ਰਭ ਜਗਤਿ ਕਹਾ ਸੋ ਕਹਿਹੋਂ ॥",
      "s": 2
    },
    {
      "t": "ਮ੍ਰਿਤ ਲੋਕ ਤੇ ਮੋਨ ਨ ਰਹਿਹੋਂ ॥੩੩॥",
      "s": 2
    },
    {
      "t": "ਨਰਾਜ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਕਹਿਓ ਪ੍ਰਭੂ ਸੁ ਭਾਖਿ ਹੋਂ ॥",
      "s": 2
    },
    {
      "t": "ਕਿਸੂ ਨ ਕਾਨ ਰਾਖਿ ਹੋਂ ॥",
      "s": 2
    },
    {
      "t": "ਕਿਸੂ ਨ ਭੇਖ ਭੀਜ ਹੋਂ ॥",
      "s": 2
    },
    {
      "t": "ਅਲੇਖ ਬੀਜ ਬੀਜ ਹੋਂ ॥੩੪॥",
      "s": 2
    },
    {
      "t": "ਪਖਾਣ ਪੂਜ ਹੋਂ ਨਹੀਂ ॥",
      "s": 2
    },
    {
      "t": "ਨ ਭੇਖ ਭੀਜ ਹੋ ਕਹੀਂ ॥",
      "s": 2
    },
    {
      "t": "ਅਨੰਤ ਨਾਮੁ ਗਾਇ ਹੋਂ ॥",
      "s": 2
    },
    {
      "t": "ਪਰੱਮ ਪੁਰਖ ਪਾਇ ਹੋਂ ॥੩੫॥",
      "s": 2
    },
    {
      "t": "ਜਟਾ ਨ ਸੀਸ ਧਾਰਿਹੋਂ ॥",
      "s": 2
    },
    {
      "t": "ਨ ਮੁੰਦ੍ਰਕਾ ਸੁਧਾਰਿਹੋਂ ॥",
      "s": 2
    },
    {
      "t": "ਨ ਕਾਨ ਕਾਹੂ ਕੀ ਧਰੋਂ ॥",
      "s": 2
    },
    {
      "t": "ਕਹਿਓ ਪ੍ਰਭੂ ਸੁ ਮੈ ਕਰੋਂ ॥੩੬॥",
      "s": 2
    },
    {
      "t": "ਭਜੋਂ ਸੁ ਏਕ ਨਾਮਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਜੁ ਕਾਮ ਸਰਬ ਠਾਮਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਨ ਜਾਪ ਆਨ ਕੋ ਜਪੋ ॥",
      "s": 2
    },
    {
      "t": "ਨ ਅਉਰ ਥਾਪਨਾ ਥਪੋ ॥੩੭॥",
      "s": 2
    },
    {
      "t": "ਬਿਅੰਤ ਨਾਮ ਧਿਆਇ ਹੋਂ ॥",
      "s": 2
    },
    {
      "t": "ਪਰਮ ਜੋਤਿ ਪਾਇ ਹੋਂ ॥",
      "s": 2
    },
    {
      "t": "ਨ ਧਿਆਨ ਆਨ ਕੋ ਧਰੋਂ ॥",
      "s": 2
    },
    {
      "t": "ਨ ਨਾਮ ਆਨ ਉਚਰੋਂ ॥੩੮॥",
      "s": 2
    },
    {
      "t": "ਤਵੱਕ ਨਾਮ ਰੱਤਿਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਨ ਆਨ ਮਾਨ ਮੱਤਿਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਪਰੱਮ ਧਿਆਨ ਧਾਰੀਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਅਨੰਤ ਪਾਪ ਟਾਰੀਯੰ ॥੩੯॥",
      "s": 2
    },
    {
      "t": "ਤੁਮੇਵ ਰੂਪ ਰਾਚਿਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਨ ਆਨ ਦਾਨ ਮਾਚਿਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਤਵੱਕ ਨਾਮ ਉਚਾਰਿਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਅਨੰਤ ਦੂਖ ਟਾਰਿਯੰ ॥੪੦॥",
      "s": 2
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਨ ਜਿਨ ਨਾਮ ਤਿਹਾਰੋ ਧਿਆਇਆ ॥",
      "s": 2
    },
    {
      "t": "ਦੂਖ ਪਾਪ ਤਿਹ ਨਿਕਟ ਨ ਆਇਆ ॥",
      "s": 2
    },
    {
      "t": "ਜੇ ਜੇ ਅਉਰ ਧਿਆਨ ਕੋ ਧਰਹੀਂ ॥",
      "s": 2
    },
    {
      "t": "ਬਹਿਸ ਬਹਿਸ ਬਾਦਨ ਤੇ ਮਰਹੀਂ ॥੪੧॥",
      "s": 2
    },
    {
      "t": "ਹਮ ਇਹ ਕਾਜ ਜਗਤ ਮੋ ਆਏ ॥",
      "s": 2
    },
    {
      "t": "ਧਰਮ ਹੇਤ ਗੁਰਦੇਵ ਪਠਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਜਹਾਂ ਤਹਾਂ ਤੁਮ ਧਰਮ ਬਿਥਾਰੋ ॥",
      "s": 2
    },
    {
      "t": "ਦੁਸਟ ਦੋਖੀਅਨਿ ਪਕਰਿ ਪਛਾਰੋ ॥੪੨॥",
      "s": 2
    },
    {
      "t": "ਯਾਹੀ ਕਾਜ ਧਰਾ ਹਮ ਜਨਮੰ ॥",
      "s": 2
    },
    {
      "t": "ਸਮਝ ਲੇਹੁ ਸਾਧੂ ਸਭ ਮਨ ਮੰ ॥",
      "s": 2
    },
    {
      "t": "ਧਰਮ ਚਲਾਵਨ ਸੰਤ ਉਬਾਰਨ ॥",
      "s": 2
    },
    {
      "t": "ਦੁਸਟ ਸਭਨ ਕੋ ਮੂਲ ਉਪਾਰਨ ॥੪੩॥",
      "s": 2
    },
    {
      "t": "ਜੇ ਜੇ ਭਏ ਪਹਿਲ ਅਵਤਾਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਆਪੁ ਆਪੁ ਤਿਨ ਜਾਪੁ ਉਚਾਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਪ੍ਰਭ ਦੋਖੀ ਕੋਈ ਨ ਬਿਦਾਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਧਰਮ ਕਰਨ ਕੋ ਰਾਹੁ ਨ ਡਾਰਾ ॥੪੪॥",
      "s": 2
    },
    {
      "t": "ਜੇ ਜੇ ਗਉਸ ਅੰਬੀਆ ਭਏ ॥",
      "s": 2
    },
    {
      "t": "ਮੈ ਮੈ ਕਰਤ ਜਗਤ ਤੇ ਗਏ ॥",
      "s": 2
    },
    {
      "t": "ਮਹਾਪੁਰਖ ਕਾਹੂ ਨ ਪਛਾਨਾ ॥",
      "s": 2
    },
    {
      "t": "ਕਰਮ ਧਰਮ ਕੋ ਕਛੂ ਨ ਜਾਨਾ ॥੪੫॥",
      "s": 2
    },
    {
      "t": "ਅਵਰਨ ਕੀ ਆਸਾ ਕਿਛੁ ਨਾਹੀ ॥",
      "s": 2
    },
    {
      "t": "ਏਕੈ ਆਸ ਧਰੋ ਮਨ ਮਾਹੀ ॥",
      "s": 2
    },
    {
      "t": "ਆਨ ਆਸ ਉਪਜਤ ਕਿਛੁ ਨਾਹੀ ॥",
      "s": 2
    },
    {
      "t": "ਵਾ ਕੀ ਆਸ ਧਰੋਂ ਮਨ ਮਾਹੀ ॥੪੬॥",
      "s": 2
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਕੋਈ ਪੜ੍ਹਤ ਕੁਰਾਨ ਕੋ ਕੋਈ ਪੜ੍ਹਤ ਪੁਰਾਨ ॥",
      "s": 2
    },
    {
      "t": "ਕਾਲ ਨ ਸਕਤ ਬਚਾਇ ਕੈ ਫੋਕਟ ਧਰਮ ਨਿਦਾਨ ॥੪੭॥",
      "s": 2
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 2
    },
    {
      "t": "ਕਈ ਕੋਟਿ ਮਿਲਿ ਪੜ੍ਹਤ ਕੁਰਾਨਾ ॥",
      "s": 2
    },
    {
      "t": "ਬਾਚਤ ਕਿਤੇ ਪੁਰਾਨ ਅਜਾਨਾ ॥",
      "s": 2
    },
    {
      "t": "ਅੰਤ ਕਾਲ ਕੋਈ ਕਾਮ ਨ ਆਵਾ ॥",
      "s": 2
    },
    {
      "t": "ਦਾਵ ਕਾਲ ਕਾਹੂ ਨ ਬਚਾਵਾ ॥੪੮॥",
      "s": 2
    },
    {
      "t": "ਕਿਉ ਨ ਜਪੋ ਤਾ ਕੋ ਤੁਮ ਭਾਈ ॥",
      "s": 2
    }
  ]
}
