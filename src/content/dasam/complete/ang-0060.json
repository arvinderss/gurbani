{
  "page": 60,
  "lines": [
    {
      "t": "ਜੇ ਜੇ ਬਾਦਿ ਕਰਤ ਹੰਕਾਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਨ ਤੇ ਭਿੰਨ ਰਹਤ ਕਰਤਾਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਬੇਦ ਕਤੇਬ ਬਿਖੈ ਹਰਿ ਨਾਹੀਂ ॥",
      "s": 2
    },
    {
      "t": "ਜਾਨ ਲੇਹੁ ਹਰਿਜਨ ਮਨ ਮਾਹੀਂ ॥੬੧॥",
      "s": 2
    },
    {
      "t": "ਆਂਖ ਮੂੰਦਿ ਕੋਊ ਡਿੰਭ ਦਿਖਾਵੈ ॥",
      "s": 2
    },
    {
      "t": "ਆਂਧਰ ਕੀ ਪਦਵੀ ਕਹਿ ਪਾਵੈ ॥",
      "s": 2
    },
    {
      "t": "ਆਂਖਿ ਮੀਚ ਮਗ ਸੂਝ ਨ ਜਾਈ ॥",
      "s": 2
    },
    {
      "t": "ਤਾਹਿ ਅਨੰਤ ਮਿਲੈ ਕਿਮ ਭਾਈ ॥੬੨॥",
      "s": 2
    },
    {
      "t": "ਬਹੁ ਬਿਸਥਾਰ ਕਹ ਲਉ ਕੋਈ ਕਹੈ ॥",
      "s": 2
    },
    {
      "t": "ਸਮਝਤ ਬਾਤਿ ਥਕਤ ਹੁਐ ਰਹੈ ॥",
      "s": 2
    },
    {
      "t": "ਰਸਨਾ ਧਰੈ ਕਈ ਜੋ ਕੋਟਾ ॥",
      "s": 2
    },
    {
      "t": "ਤਦਪਿ ਗਨਤ ਤਿਹ ਪਰਤ ਸੁ ਤੋਟਾ ॥੬੩॥",
      "s": 2
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਜਬ ਆਇਸੁ ਪ੍ਰਭ ਕੋ ਭਯੋ ਜਨਮੁ ਧਰਾ ਜਗ ਆਇ ॥",
      "s": 2
    },
    {
      "t": "ਅਬ ਮੈ ਕਥਾ ਸੰਛੇਪ ਤੇ ਸਭਹੂੰ ਕਹਤ ਸੁਨਾਇ ॥੬੪॥",
      "s": 2
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਮਮ ਆਗਿਆ ਕਾਲ ਜਗ ਪ੍ਰਵੇਸ ਕਰਨ ਨਾਮ ਖਸਟਮੋ ਧਿਆਇ ਸਮਾਪਤ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੬॥ ਅਫਜੂ ॥੨੭੯॥",
      "s": 2
    },
    {
      "t": "ਅਥ ਕਬਿ ਜਨਮ ਕਥਨੰ ॥",
      "s": 2
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 2
    },
    {
      "t": "ਮੁਰ ਪਿਤ ਪੂਰਬ ਕੀਯਸਿ ਪਯਾਨਾ ॥",
      "s": 2
    },
    {
      "t": "ਭਾਂਤਿ ਭਾਂਤਿ ਕੇ ਤੀਰਥਿ ਨਾਨਾ ॥",
      "s": 2
    },
    {
      "t": "ਜਬ ਹੀ ਜਾਤ ਤ੍ਰਿਬੇਣੀ ਭਏ ॥",
      "s": 2
    },
    {
      "t": "ਪੁੰਨ ਦਾਨ ਦਿਨ ਕਰਤ ਬਿਤਏ ॥੧॥",
      "s": 2
    },
    {
      "t": "ਤਹੀ ਪ੍ਰਕਾਸ ਹਮਾਰਾ ਭਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਪਟਨਾ ਸਹਰ ਬਿਖੈ ਭਵ ਲਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਮੱਦ੍ਰ ਦੇਸ ਹਮ ਕੋ ਲੇ ਆਏ ॥",
      "s": 2
    },
    {
      "t": "ਭਾਂਤਿ ਭਾਂਤਿ ਦਾਈਅਨਿ ਦੁਲਰਾਏ ॥੨॥",
      "s": 2
    },
    {
      "t": "ਕੀਨੀ ਅਨਿਕ ਭਾਂਤਿ ਤਨ ਰੱਛਾ ॥",
      "s": 2
    },
    {
      "t": "ਦੀਨੀ ਭਾਂਤਿ ਭਾਂਤਿ ਕੀ ਸਿੱਛਾ ॥",
      "s": 2
    },
    {
      "t": "ਜਬ ਹਮ ਧਰਮ ਕਰਮ ਮੋ ਆਏ ॥",
      "s": 2
    },
    {
      "t": "ਦੇਵ ਲੋਕ ਤਬ ਪਿਤਾ ਸਿਧਾਏ ॥੩॥",
      "s": 2
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਕਬਿ ਜਨਮ ਕਥਨੰ ਨਾਮ ਸਪਤਮੋ ਧਿਆਇ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੭॥ ਅਫਜੂ ॥੨੮੨॥",
      "s": 2
    },
    {
      "t": "ਅਥ ਰਾਜ ਸਾਜ ਕਥਨੰ ॥",
      "s": 2
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 2
    },
    {
      "t": "ਰਾਜ ਸਾਜ ਹਮ ਪਰ ਜਬ ਆਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਜਥਾ ਸਕਤ ਤਬ ਧਰਮ ਚਲਾਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਭਾਂਤਿ ਭਾਂਤਿ ਬਨ ਖੇਲ ਸਿਕਾਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਮਾਰੇ ਰੀਛ ਰੋਝ ਝੰਖਾਰਾ ॥੧॥",
      "s": 2
    },
    {
      "t": "ਦੇਸ ਚਾਲ ਹਮ ਤੇ ਪੁਨਿ ਭਈ ॥",
      "s": 2
    },
    {
      "t": "ਸਹਰ ਪਾਂਵਟਾ ਕੀ ਸੁਧਿ ਲਈ ॥",
      "s": 2
    },
    {
      "t": "ਕਾਲਿੰਦ੍ਰੀ ਤਟਿ ਕਰੇ ਬਿਲਾਸਾ ॥",
      "s": 2
    },
    {
      "t": "ਅਨਿਕ ਭਾਂਤ ਕੇ ਪੇਖ ਤਮਾਸਾ ॥੨॥",
      "s": 2
    },
    {
      "t": "ਤਹ ਕੇ ਸਿੰਘ ਘਨੇ ਚੁਨਿ ਮਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਰੋਝ ਰੀਛ ਬਹੁ ਭਾਂਤਿ ਬਿਦਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਫਤੇਸਾਹ ਕੋਪਾ ਤਬਿ ਰਾਜਾ ॥",
      "s": 2
    },
    {
      "t": "ਲੋਹ ਪਰਾ ਹਮ ਸੋ ਬਿਨੁ ਕਾਜਾ ॥੩॥",
      "s": 2
    },
    {
      "t": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਤਹਾਂ ਸਾਹ ਸ੍ਰੀਸਾਹ ਸੰਗ੍ਰਾਮ ਕੋਪੇ ॥",
      "s": 2
    },
    {
      "t": "ਪੰਚੋ ਬੀਰ ਬੰਕੇ ਪ੍ਰਿਥੀ ਪਾਇ ਰੋਪੇ ॥",
      "s": 2
    },
    {
      "t": "ਹਠੀ ਜੀਤਮੱਲੰ ਸੁ ਗਾਜੀ ਗੁਲਾਬੰ ॥",
      "s": 2
    },
    {
      "t": "ਰਣੰ ਦੇਖੀਐ ਰੰਗ ਰੂਪੰ ਸਹਾਬੰ ॥੪॥",
      "s": 2
    },
    {
      "t": "ਹਠਿਯੋ ਮਾਹਰੀਚੰਦਯੰ ਗੰਗਰਾਮੰ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਨੈ ਕਿਤਯੰ ਜਿਤੀਯੰ ਫੌਜ ਤਾਮੰ ॥",
      "s": 2
    },
    {
      "t": "ਕੁਪੇ ਲਾਲਚੰਦੰ ਕੀਏ ਲਾਲ ਰੂਪੰ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਨੈ ਗੱਜੀਯੰ ਗਰਬ ਸਿੰਘੰ ਅਨੂਪੰ ॥੫॥",
      "s": 2
    },
    {
      "t": "ਕੁਪਿਯੋ ਮਾਹਰੂ ਕਾਹਰੂ ਰੂਪ ਧਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਨੈ ਖਾਨ ਖਾਵੀਨਿਯੰ ਖੇਤ ਮਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਕੁਪਿਓ ਦੇਵਤੇਸੰ ਦਯਾਰਾਮ ਜੁੱਧੰ ॥",
      "s": 2
    },
    {
      "t": "ਕੀਯੋ ਦ੍ਰੋਣ ਕੀ ਜਿਉ ਮਹਾ ਜੁੱਧ ਸੁੱਧੰ ॥੬॥",
      "s": 2
    },
    {
      "t": "ਕ੍ਰਿਪਾਲ ਕੋਪਿਯੰ ਕੁਤਕੋ ਸੰਭਾਰੀ ॥",
      "s": 2
    },
    {
      "t": "ਹਠੀ ਖਾਨਹੱਯਾਤ ਕੇ ਸੀਸ ਝਾਰੀ ॥",
      "s": 2
    },
    {
      "t": "ਉੱਠੀ ਛਿੱਛ ਇੱਛੰ ਕਢਾ ਮੇਝ ਜੋਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਮਨੋ ਮਾਖਨੰ ਮੱਟਕੀ ਕਾਨ੍ਹ ਫੋਰੰ ॥੭॥",
      "s": 2
    },
    {
      "t": "ਤਹਾ ਨੰਦਚੰਦੰ ਕੀਯੋ ਕੋਪੁ ਭਾਰੋ ॥",
      "s": 2
    },
    {
      "t": "ਲਗਾਈ ਬਰੱਛੀ ਕ੍ਰਿਪਾਣੰ ਸੰਭਾਰੋ ॥",
      "s": 2
    },
    {
      "t": "ਤੁਟੀ ਤੇਗ ਤ੍ਰਿੱਖੀ ਕਢੇ ਜਮਦੱਢੰ ॥",
      "s": 2
    },
    {
      "t": "ਹਠੀ ਰਾਖਯੰ ਲੱਜ ਬੰਸੰ ਸੱਨਢੰ ॥੮॥",
      "s": 2
    },
    {
      "t": "ਤਹਾਂ ਮਾਤਲੇਯੰ ਕ੍ਰਿਪਾਲੰ ਕ੍ਰੁੱਧੰ ॥",
      "s": 2
    },
    {
      "t": "ਛਕਿਓ ਛੋਭ ਛੱਤ੍ਰੀ ਕਰਯੋ ਜੁੱਧ ਸੁੱਧੰ ॥",
      "s": 2
    },
    {
      "t": "ਸਹੇ ਦੇਹ ਆਪੰ ਮਹਾਂ ਬੀਰ ਬਾਣੰ ॥",
      "s": 2
    },
    {
      "t": "ਕਰੋ ਖਾਨ ਬਾਨੀਨ ਖਾਲੀ ਪਲਾਣੰ ॥੯॥",
      "s": 2
    },
    {
      "t": "ਹਠਿਯੋ ਸਾਹਬੰਚੰਦ ਖੇਤੰ ਖਤ੍ਰਿਯਾਣੰ ॥",
      "s": 2
    },
    {
      "t": "ਹਨੇ ਖਾਨ ਖੂਨੀ ਖੁਰਾਸਾਨ ਭਾਨੰ ॥",
      "s": 2
    }
  ]
}
