{
  "page": 61,
  "lines": [
    {
      "t": "ਤਹਾਂ ਬੀਰ ਬੰਕੇ ਭਲੀ ਭਾਂਤਿ ਮਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਬਚੇ ਪ੍ਰਾਨ ਲੈ ਕੇ ਸਿਪਾਹੀ ਸਿਧਾਰੇ ॥੧੦॥",
      "s": 2
    },
    {
      "t": "ਤਹਾਂ ਸਾਹ ਸੰਗ੍ਰਾਮ ਕੀਨੇ ਅਖਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਘਨੇ ਖੇਤ ਮੋ ਖਾਨ ਖੂਨੀ ਲਤਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਨ੍ਰਿਪੰ ਗੋਪਲਾਯੰ ਖਰੋ ਖੇਤ ਗਾਜੈ ॥",
      "s": 2
    },
    {
      "t": "ਮ੍ਰਿਗਾ ਝੁੰਡ ਮੱਧਿਯੰ ਮਨੋ ਸਿੰਘ ਰਾਜੈ ॥੧੧॥",
      "s": 2
    },
    {
      "t": "ਤਹਾਂ ਏਕ ਬੀਰੰ ਹਰੀ ਚੰਦ ਕੋਪ੍ਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਭਲੀ ਭਾਂਤਿ ਸੋ ਖੇਤ ਮੋ ਪਾਵ ਰੋਪ੍ਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਮਹਾ ਕ੍ਰੋਧ ਕੈ ਤੀਰ ਤੀਖੇ ਪ੍ਰਹਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਲਗੈ ਜੌਨ ਕੇ ਤਾਹਿ ਪਾਰੈ ਪਧਾਰੇ ॥੧੨॥",
      "s": 2
    },
    {
      "t": "ਰਸਾਵਲ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਹਰੀਚੰਦ ਕ੍ਰੁੱਧੰ ॥",
      "s": 2
    },
    {
      "t": "ਹਨੇ ਸੂਰ ਸੁੱਧੰ ॥",
      "s": 2
    },
    {
      "t": "ਭਲੇ ਬਾਣ ਬਾਹੇ ॥",
      "s": 2
    },
    {
      "t": "ਬਡੇ ਸੈਨ ਗਾਹੇ ॥੧੩॥",
      "s": 2
    },
    {
      "t": "ਰਸੰ ਰੁੱਦ੍ਰ ਰਾਚੇ ॥",
      "s": 2
    },
    {
      "t": "ਮਹਾ ਲੋਹ ਮਾਚੇ ॥",
      "s": 2
    },
    {
      "t": "ਹਨੇ ਸਸਤ੍ਰ ਧਾਰੀ ॥",
      "s": 2
    },
    {
      "t": "ਲਿਟੇ ਭੂਪ ਭਾਰੀ ॥੧੪॥",
      "s": 2
    },
    {
      "t": "ਤਬੈ ਜੀਤਮੱਲੰ ॥",
      "s": 2
    },
    {
      "t": "ਹਰੀਚੰਦ ਭੱਲੰ ॥",
      "s": 2
    },
    {
      "t": "ਹ੍ਰਿਦੈ ਐਂਚ ਮਾਰਿਓ ॥",
      "s": 2
    },
    {
      "t": "ਸੁ ਖੇਤੰ ਉਤਾਰਿਓ ॥੧੫॥",
      "s": 2
    },
    {
      "t": "ਲਗੇ ਬੀਰ ਬਾਣੰ ॥",
      "s": 2
    },
    {
      "t": "ਰਿਸਿਯੋ ਤੇਜਿ ਮਾਣੰ ॥",
      "s": 2
    },
    {
      "t": "ਸਮੁਹ ਬਾਜ ਡਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਸੁਵਰਗੰ ਸਿਧਾਰੇ ॥੧੬॥",
      "s": 2
    },
    {
      "t": "ਭੁਯੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਖੁਲੈ ਖਾਨ ਖੂਨੀ ਖੁਰਾਸਾਨ ਖੱਗੰ ॥",
      "s": 2
    },
    {
      "t": "ਪਰੀ ਸਸਤ੍ਰ ਧਾਰੰ ਉਠੀ ਝਾਲ ਅੱਗੰ ॥",
      "s": 2
    },
    {
      "t": "ਭਈ ਤੀਰ ਭੀਰੰ ਕਮਾਣੰ ਕੱੜਕੇ ॥",
      "s": 2
    },
    {
      "t": "ਗਿਰੇ ਬਾਜ ਤਾਜੀ ਲਗੇ ਧੀਰ ਧੱਕੇ ॥੧੭॥",
      "s": 2
    },
    {
      "t": "ਬਜੀ ਭੇਰਿ ਭੁੰਕਾਰ ਧੁੱਕੇ ਨਗਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਦੁਹੂੰ ਓਰ ਤੇ ਬੀਰ ਬੰਕੇ ਬਕਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਕਰੇ ਬਾਹੁ ਆਘਾਤ ਸਸਤ੍ਰੰ ਪ੍ਰਹਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਡਕੀ ਡਾਕਣੀ ਚਾਂਵਡੀ ਚੀਤਕਾਰੰ ॥੧੮॥",
      "s": 2
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਕਹਾ ਲਗੇ ਬਰਨਨ ਕਰੋਂ ਮਚਿਯੋ ਜੁਧੁ ਅਪਾਰ ॥",
      "s": 2
    },
    {
      "t": "ਜੇ ਲੁੱਝੇ ਜੁੱਝੇ ਸਬੈ ਭੱਜੇ ਸੂਰ ਹਜਾਰ ॥੧੯॥",
      "s": 2
    },
    {
      "t": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਭਜਿਯੋ ਸਾਹ ਪਹਾੜਤਾਜੀ ਤ੍ਰਿਪਾਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਚਲਿਯੋ ਬੀਰੀਯਾ ਤੀਰੀਯਾ ਨ ਚਲਾਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਜਸੋ ਡੱਢਵਾਲੰ ਮਧੁੱਕਰ ਸੁ ਸਾਹੰ ॥",
      "s": 2
    },
    {
      "t": "ਭਜੇ ਸੰਗ ਲੈ ਕੇ ਸੁ ਸਾਰੀ ਸਿਪਾਹੰ ॥੨੦॥",
      "s": 2
    },
    {
      "t": "ਚਕ੍ਰਿਤ ਚੋਪਿਯੋ ਚੰਦ ਗਾਜੀ ਚੰਦੇਲੰ ॥",
      "s": 2
    },
    {
      "t": "ਹਠੀ ਹਰੀਚੰਦੰ ਗਹੇ ਹਾਥ ਸੇਲੰ ॥",
      "s": 2
    },
    {
      "t": "ਕਰਿਓ ਸੁਆਮਿ ਧਰਮੰ ਮਹਾ ਰੋਸ ਰੁੱਝਿਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਗਿਰਿਓ ਟੂਕ ਟੂਕ ਹ੍ਵੈ ਇਸੋ ਸੂਰ ਜੁੱਝਿਯੰ ॥੨੧॥",
      "s": 2
    }
  ]
}
