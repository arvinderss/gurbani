{
  "page": 65,
  "lines": [
    {
      "t": "ਭਾਤਿ ਅਨੇਕਨ ਕੇ ਕਰੇ ਪੁਰ ਅਨੰਦ ਸੁਖ ਆਨ ॥੨੪॥",
      "s": 2
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਨਦੌਨ ਜੁੱਧ ਬਰਨਨੰ ਨਾਮ ਨੌਮੋ ਧਿਆਇ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੯॥ ਅਫਜੂ ॥੩੪੪॥",
      "s": 2
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 2
    },
    {
      "t": "ਬਹੁਤ ਬਰਖ ਇਹ ਭਾਂਤਿ ਬਿਤਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਚੁਨਿ ਚੁਨਿ ਚੋਰ ਸਬੈ ਗਹਿ ਘਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਕੇਤਕ ਭਾਜਿ ਸਹਿਰ ਤੇ ਗਏ ॥",
      "s": 2
    },
    {
      "t": "ਭੂਖ ਮਰਤ ਫਿਰਿ ਆਵਤ ਭਏ ॥੧॥",
      "s": 2
    },
    {
      "t": "ਤਬ ਲੌ ਖਾਨ ਦਿਲਾਵਰ ਆਏ ॥",
      "s": 2
    },
    {
      "t": "ਪੂਤ ਆਪਨ ਹਮ ਓਰ ਪਠਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਦ੍ਵੈਕ ਘਰੀ ਬੀਤੀ ਨਿਸਿ ਜਬੈ ॥",
      "s": 2
    },
    {
      "t": "ਚੜਤ ਕਰੀ ਖਾਨਨ ਮਿਲਿ ਤਬੈ ॥੨॥",
      "s": 2
    },
    {
      "t": "ਜਬ ਦਲ ਪਾਰ ਨਦੀ ਕੇ ਆਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਆਨ ਆਲਮੈ ਹਮੈ ਜਗਾਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਸੋਰੁ ਪਰਾ ਸਭ ਹੀ ਨਰ ਜਾਗੇ ॥",
      "s": 2
    },
    {
      "t": "ਗਹਿ ਗਹਿ ਸਸਤ੍ਰ ਬੀਰ ਰਿਸ ਪਾਗੇ ॥੩॥",
      "s": 2
    },
    {
      "t": "ਛੂਟਨ ਲਗੀ ਤੁਫ਼ੰਗੈਂ ਤਬ ਹੀ ॥",
      "s": 2
    },
    {
      "t": "ਗਹਿ ਗਹਿ ਸਸਤ੍ਰ ਰਿਸਾਨੇ ਸਬ ਹੀ ॥",
      "s": 2
    },
    {
      "t": "ਕ੍ਰੂਰ ਭਾਂਤਿ ਤਿਨ ਕਰੀ ਪੁਕਾਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਸੋਰੁ ਸੁਨਾ ਸਰਤਾ ਕੇ ਪਾਰਾ ॥੪॥",
      "s": 2
    },
    {
      "t": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਬਜੀ ਭੇਰ ਭੁੰਕਾਰ ਧੁੰਕੇ ਨਗਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਮਹਾਂ ਬੀਰ ਬਾਨੈਤ ਬੰਕੇ ਬਕਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਭਏ ਬਾਹੁ ਆਘਾਤ ਨੱਚੇ ਮਰਾਲੰ ॥",
      "s": 2
    },
    {
      "t": "ਕ੍ਰਿਪਾ ਸਿੰਧ ਕਾਲੀ ਗਰੱਜੀ ਕਰਾਲੰ ॥੫॥",
      "s": 2
    },
    {
      "t": "ਨਦੀਯੰ ਲਖਿਯੋ ਕਾਲ ਰਾਤ੍ਰੰ ਸਮਾਨੰ ॥",
      "s": 2
    },
    {
      "t": "ਕਰੇ ਸੂਰਮਾ ਸੀਤ ਪਿੰਗੰ ਪ੍ਰਮਾਨੰ ॥",
      "s": 2
    },
    {
      "t": "ਇਤੇ ਬੀਰ ਗੱਜੇ ਭਏ ਨਾਦ ਭਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਭਜੇ ਖਾਨ ਖੂਨੀ ਬਿਨਾ ਸਸਤ੍ਰ ਝਾਰੇ ॥੬॥",
      "s": 2
    },
    {
      "t": "ਨਰਾਜ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਨਿੱਲਜ ਖਾਨ ਭੱਜਿਓ ॥",
      "s": 2
    },
    {
      "t": "ਕਿਨੀ ਨ ਸਸਤ੍ਰ ਸੱਜਿਓ ॥",
      "s": 2
    },
    {
      "t": "ਸੁ ਤਿਆਗ ਖੇਤ ਕੌ ਚਲੇ ॥",
      "s": 2
    },
    {
      "t": "ਸੁ ਬੀਰ ਬੀਰਹਾ ਭਲੇ ॥",
      "s": 2
    },
    {
      "t": "ਚਲੇ ਤੁਰੇ ਤੁਰਾਇ ਕੈ ॥",
      "s": 2
    },
    {
      "t": "ਸਕੇ ਨ ਸਸਤ੍ਰ ਉਠਾਇ ਕੈ ॥",
      "s": 2
    },
    {
      "t": "ਨ ਲੈ ਹਥਿਆਰ ਗੱਜਹੀਂ ॥",
      "s": 2
    },
    {
      "t": "ਨਿਹਾਰ ਨਾਰਿ ਲੱਜਹੀਂ ॥੮॥",
      "s": 2
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਬਰਵਾ ਗਾਉਂ ਉਜਾਰ ਕੈ ਕਰੇ ਮੁਕਾਮ ਭਲਾਨ ॥",
      "s": 2
    },
    {
      "t": "ਪ੍ਰਭ ਬਲ ਹਮੈ ਨ ਛੁਇ ਸਕੈ ਭਾਜਤ ਭਏ ਨਿਦਾਨ ॥੯॥",
      "s": 2
    },
    {
      "t": "ਤਬ ਬਲ ਈਹਾ ਨ ਪਰ ਸਕੈ ਬਰਵਾ ਹਨਾ ਰਿਸਾਇ ॥",
      "s": 2
    },
    {
      "t": "ਸਾਲਿਨ ਰਸ ਜਿਮ ਬਾਨੀਯੋ ਰੋਰਨ ਖਾਤ ਬਨਾਇ ॥੧੦॥",
      "s": 2
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਖਾਨਜਾਦੇ ਕੋ ਆਗਮਨ ਤ੍ਰਾਸਿਤ ਉਠ ਜੈਬੋ ਬਰਨਨੰ ਨਾਮ ਦਸਮੋ ਧਿਆਇ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੦॥ ਅਫਜੂ ॥੩੫੪॥",
      "s": 2
    },
    {
      "t": "ਹੁਸੈਨੀ ਜੁੱਧ ਕਥਨੰ ॥",
      "s": 2
    },
    {
      "t": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਗਯੋ ਖਾਨਜਾਦਾ ਪਿਤਾ ਪਾਸ ਭੱਜੰ ॥",
      "s": 2
    },
    {
      "t": "ਸਕੈ ਜ੍ਵਾਬੁ ਦੈ ਨਾ ਹਨੇ ਸੂਰ ਲੱਜੰ ॥",
      "s": 2
    },
    {
      "t": "ਤਹਾ ਠੋਕ ਬਾਹਾਂ ਹੁਸੈਨੀ ਗਰੱਜਿਯੰ ॥",
      "s": 2
    }
  ]
}
