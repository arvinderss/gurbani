{
  "page": 70,
  "lines": [
    {
      "t": "ਘਨਿਯੋ ਕਾਲ ਕੈ ਕੈ ॥",
      "s": 2
    },
    {
      "t": "ਚਲੈ ਜੱਸ ਲੈ ਕੈ ॥੬੧॥",
      "s": 2
    },
    {
      "t": "ਬਜੇ ਸੰਖ ਨਾਦੰ ॥",
      "s": 2
    },
    {
      "t": "ਸੁਰੰ ਨਿਰਬਿਖਾਦੰ ॥",
      "s": 2
    },
    {
      "t": "ਬਜੇ ਡੌਰ ਡੱਢੰ ॥",
      "s": 2
    },
    {
      "t": "ਹਠੇ ਸਸਤ੍ਰ ਕੱਢੰ ॥੬੨॥",
      "s": 2
    },
    {
      "t": "ਪਰੀ ਭੀਰ ਭਾਰੀ ॥",
      "s": 2
    },
    {
      "t": "ਜੁਝੈ ਛਤ੍ਰ ਧਾਰੀ ॥",
      "s": 2
    },
    {
      "t": "ਮੁਖੰ ਮੁੱਛ ਬੰਕੰ ॥",
      "s": 2
    },
    {
      "t": "ਮੰਡੇ ਬੀਰ ਹੰਕੰ ॥੬੩॥",
      "s": 2
    },
    {
      "t": "ਮੁਖੰ ਮਾਰਿ ਬੋਲੈਂ ॥",
      "s": 2
    },
    {
      "t": "ਰਣੰ ਭੂਮਿ ਡੋਲੈਂ ॥",
      "s": 2
    },
    {
      "t": "ਹਥਿਆਰੰ ਸੰਭਾਰੈਂ ॥",
      "s": 2
    },
    {
      "t": "ਉਭੈ ਬਾਜ ਡਾਰੈਂ ॥੬੪॥",
      "s": 2
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਰਣ ਜੁਝਤ ਕਿਰਪਾਲ ਕੇ ਨਾਚਤ ਭਯੋ ਗੁਪਾਲ ॥",
      "s": 2
    },
    {
      "t": "ਸੈਨ ਸਭੈ ਸਿਰਦਾਰ ਦੈ ਭਾਜਤ ਭਈ ਬਿਹਾਲ ॥੬੫॥",
      "s": 2
    },
    {
      "t": "ਖਾਨ ਹੁਸੈਨ ਕ੍ਰਿਪਾਲ ਕੇ ਹਿੰਮਤ ਰਣ ਜੂਝੰਤ ॥",
      "s": 2
    },
    {
      "t": "ਭਾਜਿ ਚਲੇ ਜੋਧਾ ਸਬੈ ਜਿਮ ਦੇ ਮੁਕਟ ਮਹੰਤ ॥੬੬॥",
      "s": 2
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 2
    },
    {
      "t": "ਇਹ ਬਿਧ ਸਤ੍ਰੁ ਸਬੈ ਚੁਨਿ ਮਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਗਿਰੇ ਆਪਨੇ ਸੂਰ ਸੰਭਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਤਹ ਘਾਇਲ ਹਿੰਮਤ ਕੱਹ ਲਹਾ ॥",
      "s": 2
    },
    {
      "t": "ਰਾਮ ਸਿੰਘ ਗੋਪਾਲ ਸਿਉਂ ਕਹਾ ॥੬੭॥",
      "s": 2
    },
    {
      "t": "ਜਿਨ ਹਿੰਮਤ ਅਸ ਕਲਹ ਬਢਾਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਘਾਇਲ ਆਜ ਹਾਥ ਵਹ ਆਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਜਬ ਗੁਪਾਲ ਐਸੇ ਸੁਨਿ ਪਾਵਾ ॥",
      "s": 2
    },
    {
      "t": "ਮਾਰਿ ਦੀਓ ਜੀਅਤ ਨ ਉਠਾਵਾ ॥੬੮॥",
      "s": 2
    },
    {
      "t": "ਜੀਤ ਭਈ ਰਨ ਭਯੋ ਉਝਾਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਸਿਮ੍ਰਿਤਿ ਕਰਿ ਸਭ ਘਰੋ ਸਿਧਾਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਰਾਖਿ ਲੀਯੋ ਹਮ ਕੋ ਜਗਰਾਈ ॥",
      "s": 2
    },
    {
      "t": "ਲੋਹ ਘਟਾ ਅਨਤੈ ਬਰਸਾਈ ॥੬੯॥",
      "s": 2
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਹੁਸੈਨੀ ਬਧ ਕ੍ਰਿਪਾਲ ਹਿੰਮਤ ਸੰਗਤੀਆ ਬਧ ਬਰਨਨੰ ਨਾਮ ਗਿਆਰਮੋ ਧਿਆਇ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੧॥ ਅਫਜੂ ॥੪੨੩॥",
      "s": 2
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 2
    },
    {
      "t": "ਜੁੱਧ ਭਯੋ ਇਹ ਭਾਂਤਿ ਅਪਾਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਤੁਰਕਨ ਕੋ ਮਾਰਿਓ ਸਿਰਦਾਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਰਿਸ ਤਨ ਖਾਨ ਦਿਲਾਵਰ ਤਏ ॥",
      "s": 2
    },
    {
      "t": "ਇਤੈ ਸਊਰ ਪਠਾਵਤ ਭਏ ॥੧॥",
      "s": 2
    },
    {
      "t": "ਉਤੈ ਪਠਿਓ ਉਨ ਸਿੰਘ ਜੁਝਾਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਹ ਭਲਾਨ ਤੇ ਖੇਦ ਨਿਕਾਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਇਤਿ ਗਜ ਸਿੰਘ ਪੰਮਾ ਦਲ ਜੋਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਧਾਇ ਪਰੇ ਤਿਨ ਊਪਰ ਭੋਰਾ ॥੨॥",
      "s": 2
    },
    {
      "t": "ਉਤੈ ਜੁਝਾਰ ਸਿੰਘ ਭਯੋ ਆਡਾ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਮ ਰਨ ਖੰਭ ਭੂਮਿ ਰਨਿ ਗਾਡਾ ॥",
      "s": 2
    },
    {
      "t": "ਗਾਡਾ ਚਲੇ ਨ ਹਾਡਾ ਚਲਿ ਹੈ ॥",
      "s": 2
    },
    {
      "t": "ਸਾਮੁਹਿ ਸੇਲ ਸਮਰ ਮੋ ਝਲਿ ਹੈ ॥੩॥",
      "s": 2
    },
    {
      "t": "ਬਾਟ ਚੜ੍ਹੈ ਦਲ ਦੋਊ ਜੁਝਾਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਉਤੈ ਚੰਦੇਲ ਇਤੈ ਜਸਵਾਰਾ ॥",
      "s": 2
    }
  ]
}
