{
  "page": 71,
  "lines": [
    {
      "t": "ਮੰਡਿਓ ਬੀਰ ਖੇਤ ਮੋ ਜੁੱਧਾ ॥",
      "s": 2
    },
    {
      "t": "ਉਪਜਿਉ ਸਮਰਸੂਰ ਮਨ ਕ੍ਰੁੱਧਾ ॥੪॥",
      "s": 2
    },
    {
      "t": "ਕੋਪ ਭਰੇ ਦੋਊ ਦਿਸ ਭਟ ਭਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਇਤੈ ਚੰਦੇਲ ਉਤੈ ਜਸਵਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਢੋਲ ਨਗਾਰੇ ਬਜੇ ਅਪਾਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਭੀਮ ਰੂਪ ਭੈਰੋ ਭਭਕਾਰਾ ॥੫॥",
      "s": 2
    },
    {
      "t": "ਰਸਾਵਲ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਧੁਣੰ ਢੋਲ ਬੱਜੇ ॥",
      "s": 2
    },
    {
      "t": "ਮਹਾਂ ਸੂਰ ਗੱਜੇ ॥",
      "s": 2
    },
    {
      "t": "ਕਰੇ ਸਸਤ੍ਰ ਘਾਵੰ ॥",
      "s": 2
    },
    {
      "t": "ਚੜ੍ਹੇ ਚਿੱਤ ਚਾਵੰ ॥੬॥",
      "s": 2
    },
    {
      "t": "ਨ੍ਰਿਭੈ ਬਾਜ ਡਾਰੈ ॥",
      "s": 2
    },
    {
      "t": "ਪਰੱਘੈ ਪ੍ਰਹਾਰੈ ॥",
      "s": 2
    },
    {
      "t": "ਕਰੇ ਤੇਗ ਘਾਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਚੜ੍ਹੇ ਚਿੱਤ ਚਾਯੰ ॥੭॥",
      "s": 2
    },
    {
      "t": "ਬਕੈ ਮਾਰ ਮਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਨ ਸੰਕਾ ਬਿਚਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਰੁਲੈ ਤੱਛ ਮੁੱਛੰ ॥",
      "s": 2
    },
    {
      "t": "ਕਰੈ ਸੁਰਗ ਇੱਛੰ ॥੮॥",
      "s": 2
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਨੈਕ ਨ ਰਨ ਤੇ ਮੁਰਿ ਚਲੈਂ ਕਰੈ ਨਿਡਰ ਹ੍ਵੈ ਘਾਇ ॥",
      "s": 2
    },
    {
      "t": "ਗਿਰ ਗਿਰ ਪਰੈ ਪਵੰਗ ਤੇ ਬਰੇਂ ਬਰੰਗਨ ਜਾਇ ॥੯॥",
      "s": 2
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 2
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਹੋਤ ਭਯੋ ਸੰਗ੍ਰਾਮਾ ॥",
      "s": 2
    },
    {
      "t": "ਜੂਝੇ ਚੰਦ ਨਰਾਇਨ ਨਾਮਾ ॥",
      "s": 2
    },
    {
      "t": "ਤਬ ਜੁਝਾਰ ਏਕਲ ਹੀ ਧਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਬੀਰਨ ਘੇਰ ਦਸੋ ਦਿਸ ਲਯੋ ॥੧੦॥",
      "s": 2
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਧਸਿਯੋ ਕਟਕ ਮੈ ਝਟਕ ਦੈ ਕਛੂ ਨ ਸੰਕ ਬਿਚਾਰ ॥",
      "s": 2
    },
    {
      "t": "ਗਾਹਤ ਭਯੋ ਸੁਭਟਨ ਬਡੇ ਬਾਹਿਤ ਭਯੋ ਹਥਿਆਰ ॥੧੧॥",
      "s": 2
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 2
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਘਣੇ ਘਰਨ ਕੋ ਗਾਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਭਾਂਤਿ ਭਾਂਤਿ ਕੇ ਕਰਿ ਹਥੀਯਾਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਚੁਨਿ ਚੁਨਿ ਬੀਰ ਪਖਰੀਆ ਮਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਅੰਤਿ ਦੇਵ ਪੁਰ ਆਪ ਪਧਾਰੇ ॥੧੨॥",
      "s": 2
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਜੁਝਾਰ ਸਿੰਘ ਜੁਧ ਬਰਨਨੰ ਨਾਮ ਦ੍ਵਾਦਸਮੋ ਧਿਆਇ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੨॥ ਅਫਜੂ ॥੪੩੫॥",
      "s": 2
    },
    {
      "t": "ਸਹਜਾਦੇ ਕੋ ਆਗਮਨ ਮਦ੍ਰ ਦੇਸ ॥",
      "s": 2
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 2
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਸੋ ਬਧ ਭਯੋ ਜੁਝਾਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਆਨ ਬਸੇ ਤਬ ਧਾਮ ਲੁਝਾਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਤਬ ਅਉਰੰਗ ਮਨ ਮਾਹਿ ਰਿਸਾਵਾ ॥",
      "s": 2
    },
    {
      "t": "ਮੱਦ੍ਰ ਦੇਸ ਕੋ ਪੂਤ ਪਠਾਵਾ ॥੧॥",
      "s": 2
    },
    {
      "t": "ਤਿੱਹ ਆਵਤ ਸਭ ਲੋਕ ਡਰਾਨੇ ॥",
      "s": 2
    },
    {
      "t": "ਬਡੇ ਬਡੇ ਗਿਰ ਹੇਰ ਲੁਕਾਨੇ ॥",
      "s": 2
    },
    {
      "t": "ਹਮਹੂੰ ਲੋਗਨ ਅਧਿਕ ਡਰਾਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਕਾਲ ਕਰਮ ਕੋ ਮਰਮ ਨ ਪਾਯੋ ॥੨॥",
      "s": 2
    },
    {
      "t": "ਕਿਤਕ ਲੋਕ ਤਜਿ ਸੰਗਿ ਸਿਧਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਜਾਇ ਬਸੇ ਗਿਰਵਰ ਜਹਿ ਭਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਚਿਤ ਮੂਜੀਯਨ ਕੋ ਅਧਿਕ ਡਰਾਨਾ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਨੈ ਉਬਾਰ ਨ ਅਪਨਾ ਜਾਨਾ ॥੩॥",
      "s": 2
    },
    {
      "t": "ਤਬ ਅਉਰੰਗ ਜੀਅ ਮਾਂਝ ਰਿਸਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਏਕ ਅਹਦੀਆ ਈਹਾਂ ਪਠਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਹਮ ਤੇ ਭਾਜਿ ਬਿਮੁਖ ਜੇ ਗਏ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਨ ਕੇ ਧਾਮ ਗਿਰਾਵਤ ਭਏ ॥੪॥",
      "s": 2
    },
    {
      "t": "ਜੇ ਅਪਨੇ ਗੁਰ ਤੇ ਮੁਖ ਫਿਰਹੈਂ ॥",
      "s": 2
    },
    {
      "t": "ਈਹਾਂ ਊਹਾਂ ਤਿਨ ਕੇ ਗ੍ਰਿਹ ਗਿਰਿਹੈਂ ॥",
      "s": 2
    },
    {
      "t": "ਇਹਾਂ ਉਪਹਾਸ ਨ ਸੁਰ ਪੁਰ ਬਾਸਾ ॥",
      "s": 2
    },
    {
      "t": "ਸਭ ਬਾਤਨ ਤੇ ਰਹੈ ਨਿਰਾਸਾ ॥੫॥",
      "s": 2
    },
    {
      "t": "ਦੂਖ ਭੂਖ ਤਿਨ ਕੋ ਰਹੈ ਲਾਗੀ ॥",
      "s": 2
    },
    {
      "t": "ਸੰਤ ਸੇਵ ਤੇ ਜੋ ਹੈ ਤਿਆਗੀ ॥",
      "s": 2
    },
    {
      "t": "ਜਗਤ ਬਿਖੈ ਕੋਈ ਕਾਮ ਨ ਸਰਹੀਂ ॥",
      "s": 2
    },
    {
      "t": "ਅੰਤਹਿ ਕੁੰਡ ਨਰਕ ਕੀ ਪਰਹੀਂ ॥੬॥",
      "s": 2
    },
    {
      "t": "ਤਿਨ ਕੋ ਸਦਾ ਜਗਤ ਉਪਹਾਸਾ ॥",
      "s": 2
    },
    {
      "t": "ਅੰਤਹਿ ਕੁੰਡ ਨਰਕ ਕੀ ਬਾਸਾ ॥",
      "s": 2
    },
    {
      "t": "ਗੁਰ ਪਗ ਤੇ ਜੇ ਬੇਮੁਖ ਸਿਧਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਈਹਾਂ ਊਹਾ ਤਿਨ ਕੇ ਮੁਖ ਕਾਰੇ ॥੭॥",
      "s": 2
    },
    {
      "t": "ਪੁਤ੍ਰ ਪਉਤ੍ਰ ਤਿਨ ਕੇ ਨਹੀਂ ਫਰੈਂ ॥",
      "s": 2
    },
    {
      "t": "ਦੁਖ ਦੈ ਮਾਤ ਪਿਤਾ ਕੋ ਮਰੈਂ ॥",
      "s": 2
    },
    {
      "t": "ਗੁਰ ਦੋਖੀ ਸਗ ਕੀ ਮ੍ਰਿਤ ਪਾਵੈ ॥",
      "s": 2
    },
    {
      "t": "ਨਰਕ ਕੁੰਡ ਡਾਰੇ ਪਛੁਤਾਵੈ ॥੮॥",
      "s": 2
    },
    {
      "t": "ਬਾਬੇ ਕੇ ਬਾਬਰ ਕੇ ਦੋਊ ॥",
      "s": 2
    },
    {
      "t": "ਆਪ ਕਰੇ ਪਰਮੇਸਰ ਸੋਊ ॥",
      "s": 2
    }
  ]
}
