  "lines": [
    {
      "t": "ਰਸਾਵਲ ਛੰਦ ॥",
      "s": 4
    },
    {
      "t": "ਤਬੈ ਦੇਵ ਧਾਏ ॥",
      "s": 4
    },
    {
      "t": "ਸਭੋ ਸੀਸ ਨਿਆਏ ॥",
      "s": 4
    },
    {
      "t": "ਸੁਮਨ ਧਾਰ ਬਰਖੇ ॥",
      "s": 4
    },
    {
      "t": "ਸਬੈ ਸਾਧ ਹਰਖੇ ॥੬॥",
      "s": 4
    },
    {
      "t": "ਕਰੀ ਦੇਬਿ ਅਰਚਾ ॥",
      "s": 4
    },
    {
      "t": "ਬ੍ਰਹਮ ਬੇਦ ਚਰਚਾ ॥",
      "s": 4
    },
    {
      "t": "ਜਬੈ ਪਾਇ ਲਾਗੇ ॥",
      "s": 4
    },
    {
      "t": "ਤਬੈ ਸੋਗ ਭਾਗੇ ॥੭॥",
      "s": 4
    },
    {
      "t": "ਬਿਨੰਤੀ ਸੁਨਾਈ ॥",
      "s": 4
    },
    {
      "t": "ਭਵਾਨੀ ਰਿਝਾਈ ॥",
      "s": 4
    },
    {
      "t": "ਸਬੈ ਸਸਤ੍ਰ ਧਾਰੀ ॥",
      "s": 4
    },
    {
      "t": "ਕਰੀ ਸਿੰਘ ਸੁਆਰੀ ॥੮॥",
      "s": 4
    },
    {
      "t": "ਕਰੇ ਘੰਟ ਨਾਦੰ ॥",
      "s": 4
    },
    {
      "t": "ਧੁਨੰ ਨਿਰਬਿਖਾਦੰ ॥",
      "s": 4
    },
    {
      "t": "ਸੁਨੋ ਦਈਤ ਰਾਜੰ ॥",
      "s": 4
    },
    {
      "t": "ਸਜਿਯੋ ਜੁਧ ਸਾਜੰ ॥੯॥",
      "s": 4
    },
    {
      "t": "ਚੜਿਯੋ ਰਾਛਸੇਸੰ ॥",
      "s": 4
    },
    {
      "t": "ਰਚੇ ਚਾਰ ਅਨੇਸੰ ॥",
      "s": 4
    },
    {
      "t": "ਬਲੀ ਚਾਮਰੇਵੰ ॥",
      "s": 4
    },
    {
      "t": "ਹਠੀ ਚਿਛੁਰੇਵੰ ॥੧੦॥",
      "s": 4
    },
    {
      "t": "ਬਿੜਾਲਛ ਬੀਰੰ ॥",
      "s": 4
    },
    {
      "t": "ਚੜੇ ਬੀਰ ਧੀਰੰ ॥",
      "s": 4
    },
    {
      "t": "ਬੜੇ ਇਖੁ ਧਾਰੀ ॥",
      "s": 4
    },
    {
      "t": "ਘਟਾ ਜਾਨ ਕਾਰੀ ॥੧੧॥",
      "s": 4
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 4
    },
    {
      "t": "ਬਾਣਿ ਜਿਤੇ ਰਾਛਸਨਿ ਮਿਲਿ ਛਾਡਤ ਭਏ ਅਪਾਰ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 4
    },
    {
      "t": "ਫੂਲਮਾਲ ਹੁਐ ਮਾਤ ਉਰਿ ਸੋਭੇ ਸਭੇ ਸੁਧਾਰ ॥੧੨॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 4
    },
    {
      "t": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 4
    },
    {
      "t": "ਜਿਤੇ ਦਾਨਵੌ ਬਾਨ ਪਾਨੀ ਚਲਾਏ ॥",
      "s": 4
    },
    {
      "t": "ਤਿਤੇ ਦੇਵਤਾ ਆਪਿ ਕਾਟੇ ਬਚਾਏ ॥",
      "s": 4
    },
    {
      "t": "ਕਿਤੇ ਢਾਲ ਢਾਹੇ ਕਿਤੇ ਪਾਸ ਪੇਲੇ ॥",
      "s": 4
    },
    {
      "t": "ਭਰੇ ਬਸਤ੍ਰ ਲੋਹੂ ਜਨੋ ਫਾਗ ਖੇਲੈ ॥੧੩॥",
      "s": 4
    },
    {
      "t": "ਦ੍ਰੁਗਾ ਹੂੰ ਕੀਯੰ ਖੇਤ ਧੁੰਕੇ ਨਗਾਰੇ ॥",
      "s": 4
    },
    {
      "t": "ਕਰੰ ਪਟਿਸੰ ਪਰਿਘ ਪਾਸੀ ਸੰਭਾਰੇ ॥",
      "s": 4
    },
    {
      "t": "ਤਹਾ ਗੋਫਨੈ ਗੁਰਜ ਗੋਲੇ ਸੰਭਾਰੈ ॥",
      "s": 4
    },
    {
      "t": "ਹਠੀ ਮਾਰ ਹੀ ਮਾਰ ਕੈ ਕੈ ਪੁਕਾਰੈ ॥੧੪॥",
      "s": 4
    },
    {
      "t": "ਤਬੇ ਅਸਟ ਹਾਥੰ ਹਥਿਯਾਰੰ ਸੰਭਾਰੇ ॥",
      "s": 4
    },
    {
      "t": "ਸਿਰੰ ਦਾਨਵੇਾਂਦ੍ਰਾਨ ਕੇ ਤਾਕਿ ਝਾਰੇ ॥",
      "s": 4
    },
    {
      "t": "ਬਬਕਿਯੋ ਬਲੀ ਸਿੰਘ ਜੁਧੰ ਮਝਾਰੰ ॥",
      "s": 4
    },
    {
      "t": "ਕਰੇ ਖੰਡ ਖੰਡੰ ਸੁ ਜੋਧਾ ਅਪਾਰੰ ॥੧੫॥",
      "s": 4
    },
    {
      "t": "ਤੋਟਕ ਛੰਦ ॥",
      "s": 4
    },
    {
      "t": "ਤਬ ਦਾਨਵ ਰੋਸ ਭਰੇ ਸਬ ਹੀ ॥",
      "s": 4
    },
    {
      "t": "ਜਗ ਮਾਤ ਕੇ ਬਾਣ ਲਗੈ ਜਬ ਹੀ ॥",
      "s": 4
    },
    {
      "t": "ਬਿਬਿਧਾਯੁਧ ਲੈ ਸੁ ਬਲੀ ਹਰਖੇ ॥",
      "s": 4
    }
  ]
}
