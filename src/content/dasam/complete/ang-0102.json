{
  "page": 102,
  "lines": [
    {
      "t": "ਘਨ ਬੂੰਦਨ ਜਿਯੋ ਬਿਸਖੰ ਬਰਖੇ ॥੧੬॥",
      "s": 4
    },
    {
      "t": "ਜਨੁ ਘੋਰ ਕੈ ਸਿਆਮ ਘਟਾ ਘੁਮਡੀ ॥",
      "s": 4
    },
    {
      "t": "ਅਸੁਰੇਸ ਅਨੀਕਨਿ ਤ੍ਰਯੋ ਉਮਿਡੀ ॥",
      "s": 4
    },
    {
      "t": "ਜਗ ਮਾਤ ਬਿਰੂਥਨਿ ਮੋ ਧਸਿ ਕੈ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 4
    },
    {
      "t": "ਧਨੁ ਸਾਇਕ ਹਾਥ ਗਹਿਯੋ ਹਸਿ ਕੈ ॥੧੭॥",
      "s": 4
    },
    {
      "t": "ਰਣ ਕੁੰਜਰ ਪੁੰਜ ਗਿਰਾਇ ਦੀਏ ॥",
      "s": 4
    },
    {
      "t": "ਇਕ ਖੰਡ ਅਖੰਡ ਦੁਖੰਡ ਕੀਏ ॥",
      "s": 4
    },
    {
      "t": "ਸਿਰ ਏਕਨਿ ਚੋਟ ਨਿਫੋਟ ਬਹੀ ॥",
      "s": 4
    },
    {
      "t": "ਤਰਵਾਰ ਹੁਐ ਤਰਵਾਰ ਰਹੀ ॥੧੮॥",
      "s": 4
    },
    {
      "t": "ਤਨ ਝਝਰ ਹੁਐ ਰਣ ਭੂਮਿ ਗਿਰੇ ॥",
      "s": 4
    },
    {
      "t": "ਇਕ ਭਾਜ ਚਲੇ ਫਿਰ ਕੈ ਨ ਫਿਰੇ ॥",
      "s": 4
    },
    {
      "t": "ਇਕਿ ਹਾਥ ਹਥਿਆਰ ਲੈ ਆਨਿ ਬਹੇ ॥",
      "s": 4
    },
    {
      "t": "ਲਰਿ ਕੈ ਮਰਿ ਕੈ ਗਿਰਿ ਖੇਤਿ ਰਹੇ ॥੧੯॥",
      "s": 4
    },
    {
      "t": "ਨਰਾਜ ਛੰਦ ॥",
      "s": 4
    },
    {
      "t": "ਤਹਾ ਸੁ ਦੈਤ ਰਾਜਯੰ ॥",
      "s": 4
    },
    {
      "t": "ਸਜੇ ਸੋ ਸਰਬ ਸਾਜਯੰ ॥",
      "s": 4
    },
    {
      "t": "ਤੁਰੰਗ ਆਪ ਬਾਹੀਯੰ ॥",
      "s": 4
    },
    {
      "t": "ਬਧੰ ਸੁ ਮਾਤ ਚਾਹੀਯੰ ॥੨੦॥",
      "s": 4
    },
    {
      "t": "ਤਬੈ ਦ੍ਰੁਗਾ ਬਕਾਰਿ ਕੈ ॥",
      "s": 4
    },
    {
      "t": "ਕਮਾਣ ਬਾਣ ਧਾਰਿ ਕੈ ॥",
      "s": 4
    },
    {
      "t": "ਸੁ ਘਾਵ ਚਾਮਰੰ ਕੀਯੋ ॥",
      "s": 4
    },
    {
      "t": "ਉਤਾਰ ਹਸਤਿ ਤੇ ਦੀਯੋ ॥੨੧॥",
      "s": 4
    },
    {
      "t": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 4
    },
    {
      "t": "ਤਬੈ ਬੀਰ ਕੋਪੰ ਬਿੜਾਲਾਛ ਨਾਮੰ ॥",
      "s": 4
    },
    {
      "t": "ਸਜੇ ਸਸਤ੍ਰ ਦੇਹੰ ਚਲੋ ਜੁਧ ਧਾਮੰ ॥",
      "s": 4
    },
    {
      "t": "ਸਿਰੰ ਸਿੰਘ ਕੇ ਆਨਿ ਘਾਯੰ ਪ੍ਰਹਾਰੰ ॥",
      "s": 4
    },
    {
      "t": "ਬਲੀ ਸਿੰਘ ਸੋ ਹਾਥ ਸੋ ਮਾਰਿ ਡਾਰੰ ॥੨੨॥",
      "s": 4
    },
    {
      "t": "ਬਿੜਾਲਾਛ ਮਾਰੇ ਸੁ ਪਿੰਗਾਛ ਧਾਏ ॥",
      "s": 4
    },
    {
      "t": "ਦ੍ਰੁਗਾ ਸਾਮੁਹੇ ਬੋਲ ਬਾਕੇ ਸੁਨਾਏ ॥",
      "s": 4
    },
    {
      "t": "ਕਰੀ ਅਭ੍ਰਿ ਜ੍ਯੋ ਗਰਜ ਕੈ ਬਾਣ ਬਰਖੰ ॥",
      "s": 4
    },
    {
      "t": "ਮਹਾ ਸੂਰ ਬੀਰੰ ਭਰੇ ਜੁਧ ਹਰਖੰ ॥੨੩॥",
      "s": 4
    },
    {
      "t": "ਤਬੈ ਦੇਵੀਅੰ ਪਾਣਿ ਬਾਣੰ ਸੰਭਾਰੰ ॥",
      "s": 4
    },
    {
      "t": "ਹਨਿਯੋ ਦੁਸਟ ਕੇ ਘਾਇ ਸੀਸੰ ਮਝਾਰੰ ॥",
      "s": 4
    },
    {
      "t": "ਗਿਰਿਯੋ ਝੂਮਿ ਭੂਮੰ ਗਏ ਪ੍ਰਾਣ ਛੁਟੰ ॥",
      "s": 4
    },
    {
      "t": "ਮਨੋ ਮੇਰ ਕੋ ਸਾਤਵੌ ਸ੍ਰਿੰਗ ਟੁਟੰ ॥੨੪॥",
      "s": 4
    },
    {
      "t": "ਗਿਰੈ ਬੀਰ ਪਿੰਗਾਛ ਦੇਬੀ ਸੰਘਾਰੇ ॥",
      "s": 4
    },
    {
      "t": "ਚਲੇ ਅਉਰੁ ਬੀਰੰ ਹਥਿਆਰੰ ਉਘਾਰੇ ॥",
      "s": 4
    },
    {
      "t": "ਤਬੈ ਰੋਸਿ ਦੇਬਿਯੰ ਸਰੋਘੰ ਚਲਾਏ ॥",
      "s": 4
    },
    {
      "t": "ਬਿਨਾ ਪ੍ਰਾਨ ਕੇ ਜੁਧ ਮਧੰ ਗਿਰਾਏ ॥੨੫॥",
      "s": 4
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 4
    },
    {
      "t": "ਜੇ ਜੇ ਸਤ੍ਰੁ ਸਾਮੁਹੇ ਆਏ ॥",
      "s": 4
    },
    {
      "t": "ਸਬੈ ਦੇਵਤਾ ਮਾਰਿ ਗਿਰਾਏ ॥",
      "s": 4
    },
    {
      "t": "ਸੈਨਾ ਸਕਲ ਜਬੈ ਹਨਿ ਡਾਰੀ ॥",
      "s": 4
    },
    {
      "t": "ਆਸੁਰੇਸ ਕੋਪਾ ਅਹੰਕਾਰੀ ॥੨੬॥",
      "s": 4
    },
    {
      "t": "ਆਪ ਜੁਧ ਤਬ ਕੀਆ ਭਵਾਨੀ ॥",
      "s": 4
    },
    {
      "t": "ਚੁਨਿ ਚੁਨਿ ਹਨੈ ਪਖਰੀਆ ਬਾਨੀ ॥",
      "s": 4
    },
    {
      "t": "ਕ੍ਰੋਧ ਜੁਆਲ ਮਸਤਕ ਤੇ ਬਿਗਸੀ ॥",
      "s": 4
    },
    {
      "t": "ਤਾ ਤੇ ਆਪ ਕਾਲਿਕਾ ਨਿਕਸੀ ॥੨੭॥",
      "s": 4
    }
  ]
}
