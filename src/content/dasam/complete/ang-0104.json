{
  "page": 104,
  "lines": [
    {
      "t": "ਛੀਨ ਲਯੋ ਅਲਕੇਸ ਭੰਡਾਰਾ ॥",
      "s": 4
    },
    {
      "t": "ਦੇਸ ਦੇਸ ਕੇ ਜੀਤਿ ਨ੍ਰਿਪਾਰਾ ॥",
      "s": 4
    },
    {
      "t": "ਜਹਾ ਤਹਾ ਕਰ ਦੈਤ ਪਠਾਏ ॥",
      "s": 4
    },
    {
      "t": "ਦੇਸ ਬਿਦੇਸ ਜੀਤੇ ਫਿਰ ਆਏ ॥੭॥੪੫॥",
      "s": 4
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 4
    },
    {
      "t": "ਦੇਵ ਸਬੈ ਤ੍ਰਾਸਤਿ ਭਏ ਮਨ ਮੋ ਕੀਯੋ ਬਿਚਾਰ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 4
    },
    {
      "t": "ਸਰਨ ਭਵਾਨੀ ਕੀ ਸਬੈ ਭਾਜਿ ਪਰੇ ਨਿਰਧਾਰ ॥੮॥੪੬॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 4
    },
    {
      "t": "ਨਰਾਜ ਛੰਦ ॥",
      "s": 4
    },
    {
      "t": "ਸੁ ਤ੍ਰਾਸ ਦੇਵ ਭਾਜੀਅੰ ॥",
      "s": 4
    },
    {
      "t": "ਬਸੇਖ ਲਾਜ ਲਾਜੀਅੰ ॥",
      "s": 4
    },
    {
      "t": "ਬਿਸਿਖ ਕਾਰਮੰ ਕਸੇ ॥",
      "s": 4
    },
    {
      "t": "ਸੁ ਦੇਵਿ ਲੋਕ ਮੋ ਬਸੇ ॥੯॥੪੭॥",
      "s": 4
    },
    {
      "t": "ਤਬੈ ਪ੍ਰਕੋਪ ਦੇਬਿ ਹੁਐ ॥",
      "s": 4
    },
    {
      "t": "ਚਲੀ ਸੁ ਸਸਤ੍ਰ ਅਸਤ੍ਰ ਲੈ ॥",
      "s": 4
    },
    {
      "t": "ਸੁ ਮੁਦ ਪਾਨਿ ਪਾਨ ਕੈ ॥",
      "s": 4
    },
    {
      "t": "ਗਜੀ ਕ੍ਰਿਪਾਨ ਪਾਨਿ ਲੈ ॥੧੦॥੪੮॥",
      "s": 4
    },
    {
      "t": "ਰਸਾਵਲ ਛੰਦ ॥",
      "s": 4
    },
    {
      "t": "ਸੁਨੀ ਦੇਵ ਬਾਨੀ ॥",
      "s": 4
    },
    {
      "t": "ਚੜੀ ਸਿੰਘ ਰਾਨੀ ॥",
      "s": 4
    },
    {
      "t": "ਸੁਭੰ ਸਸਤ੍ਰ ਧਾਰੇ ॥",
      "s": 4
    },
    {
      "t": "ਸਭੇ ਪਾਪ ਟਾਰੇ ॥੧੧॥੪੯॥",
      "s": 4
    },
    {
      "t": "ਕਰੋ ਨਦ ਨਾਦੰ ॥",
      "s": 4
    },
    {
      "t": "ਮਹਾ ਮਦ ਮਾਦੰ ॥",
      "s": 4
    },
    {
      "t": "ਭਯੋ ਸੰਖ ਸੋਰੰ ॥",
      "s": 4
    },
    {
      "t": "ਸੁਣਿਯੋ ਚਾਰ ਓਰੰ ॥੧੨॥੫੦॥",
      "s": 4
    },
    {
      "t": "ਉਤੇ ਦੈਤ ਧਾਏ ॥",
      "s": 4
    },
    {
      "t": "ਬਡੀ ਸੈਨ ਲਿਆਏ ॥",
      "s": 4
    },
    {
      "t": "ਮੁਖੰ ਰਕਤ ਨੈਣੰ ॥",
      "s": 4
    },
    {
      "t": "ਬਕੇ ਬੰਕ ਬੈਣੰ ॥੧੩॥੫੧॥",
      "s": 4
    },
    {
      "t": "ਚਵੰ ਚਾਰ ਢੂਕੇ ॥",
      "s": 4
    },
    {
      "t": "ਮੁਖੰ ਮਾਰੁ ਕੂਕੇ ॥",
      "s": 4
    },
    {
      "t": "ਲਏ ਬਾਣ ਪਾਣੰ ॥",
      "s": 4
    },
    {
      "t": "ਸੁ ਕਾਤੀ ਕ੍ਰਿਪਾਣੰ ॥੧੪॥੫੨॥",
      "s": 4
    },
    {
      "t": "ਮੰਡੇ ਮਧ ਜੰਗੰ ॥",
      "s": 4
    },
    {
      "t": "ਪ੍ਰਹਾਰੰ ਖਤੰਗੰ ॥",
      "s": 4
    },
    {
      "t": "ਕਰਉਤੀ ਕਟਾਰੰ ॥",
      "s": 4
    },
    {
      "t": "ਉਠੀ ਸਸਤ੍ਰ ਝਾਰੰ ॥੧੫॥੫੩॥",
      "s": 4
    },
    {
      "t": "ਮਹਾ ਬੀਰ ਢਾਏ ॥",
      "s": 4
    },
    {
      "t": "ਸਰੋਘੰ ਚਲਾਏ ॥",
      "s": 4
    },
    {
      "t": "ਕਰੈ ਬਾਰਿ ਬੈਰੀ ॥",
      "s": 4
    },
    {
      "t": "ਫਿਰੇ ਜ੍ਯੋ ਗੰਗੈਰੀ ॥੧੬॥੫੪॥",
      "s": 4
    },
    {
      "t": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 4
    },
    {
      "t": "ਉਧਿਤ ਸਟਾਯੰ ਉਤੈ ਸਿੰਘ ਧਾਯੋ ॥",
      "s": 4
    },
    {
      "t": "ਇਤੇ ਸੰਖ ਲੈ ਹਾਥਿ ਦੇਵੀ ਬਜਾਯੋ ॥",
      "s": 4
    },
    {
      "t": "ਪੁਰੀ ਚਉਦਹੂੰਯੰ ਰਹਿਯੋ ਨਾਦ ਪੂਰੰ ॥",
      "s": 4
    },
    {
      "t": "ਚਮਕਿਯੋ ਮੁਖੰ ਜੁਧ ਕੇ ਮਧਿ ਨੂਰੰ ॥੧੭॥੫੫॥",
      "s": 4
    },
    {
      "t": "ਤਬੈ ਧੂਮ੍ਰ ਨੈਣੰ ਮਚਿਯੋ ਸਸਤ੍ਰ ਧਾਰੀ ॥",
      "s": 4
    },
    {
      "t": "ਲਏ ਸੰਗ ਜੋਧਾ ਬਡੇ ਬੀਰ ਭਾਰੀ ॥",
      "s": 4
    }
  ]
}
