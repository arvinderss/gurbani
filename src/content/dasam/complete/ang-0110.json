{
  "page": 110,
  "lines": [
    {
      "t": "ਫਟੀ ਨਖ ਸਿੰਘੰ ਮੁਖੰ ਡਢ ਕੋਲੰ ॥",
      "s": 4
    },
    {
      "t": "ਡਮਾ ਡੰਮਿ ਡਉਰੂ ਡਕਾ ਡੁੰਕ ਡੰਕੰ ॥",
      "s": 4
    },
    {
      "t": "ਰੜੇ ਗ੍ਰਿਧ ਬ੍ਰਿਧੰ ਕਿਲਕਾਰ ਕੰਕੰ ॥੩॥੧੨੫॥",
      "s": 4
    },
    {
      "t": "ਖੁਰੰ ਖੇਹ ਉਠੀ ਰਹਿਯੋ ਗੈਨ ਪੂਰੰ ॥",
      "s": 4
    },
    {
      "t": "ਦਲੇ ਸਿੰਧੁ ਬਿਧੰ ਭਏ ਪਬ ਚੂਰੰ ॥",
      "s": 4
    },
    {
      "t": "ਸੁਣੋ ਸੋਰ ਕਾਲੀ ਗਹੈ ਸਸਤ੍ਰ ਪਾਣੰ ॥",
      "s": 4
    },
    {
      "t": "ਕਿਲਕਾਰ ਜੇਮੀ ਹਨੇ ਜੰਗ ਜੁਆਣੰ ॥੪॥੧੨੬॥",
      "s": 4
    },
    {
      "t": "ਰਸਾਵਲ ਛੰਦ ॥",
      "s": 4
    },
    {
      "t": "ਗਜੇ ਬੀਰ ਗਾਜੀ ॥",
      "s": 4
    },
    {
      "t": "ਤੁਰੇ ਤੁੰਦ ਤਾਜੀ ॥",
      "s": 4
    },
    {
      "t": "ਮਹਿਖੁਆਸ ਕਰਖੇ ॥",
      "s": 4
    },
    {
      "t": "ਸਰੰ ਧਾਰ ਬਰਖੇ ॥੫॥੧੨੭॥",
      "s": 4
    },
    {
      "t": "ਇਤੇ ਸਿੰਘ ਗਜਿਯੋ ॥",
      "s": 4
    },
    {
      "t": "ਮਹਾ ਸੰਖ ਬਜਿਯੋ ॥",
      "s": 4
    },
    {
      "t": "ਰਹਿਯੋ ਨਾਦ ਪੂਰੰ ॥",
      "s": 4
    },
    {
      "t": "ਛੁਹੀ ਗੈਣਿ ਧੂਰੰ ॥੬॥੧੨੮॥",
      "s": 4
    },
    {
      "t": "ਸਬੈ ਸਸਤ੍ਰ ਸਾਜੇ ॥",
      "s": 4
    },
    {
      "t": "ਘਣੰ ਜੇਮ ਗਾਜੇ ॥",
      "s": 4
    },
    {
      "t": "ਚਲੇ ਤੇਜ ਤੈ ਕੈ ॥",
      "s": 4
    },
    {
      "t": "ਅਨੰਤ ਸਸਤ੍ਰ ਲੈ ਕੈ ॥੭॥੧੨੯॥",
      "s": 4
    },
    {
      "t": "ਚਹੂੰ ਓਰ ਢੂਕੇ ॥",
      "s": 4
    },
    {
      "t": "ਮੁਖੰ ਮਾਰ ਕੂਕੇ ॥",
      "s": 4
    },
    {
      "t": "ਅਨੰਤ ਸਸਤ੍ਰ ਬਜੇ ॥",
      "s": 4
    },
    {
      "t": "ਮਹਾ ਬੀਰ ਗਜੇ ॥੮॥੧੩੦॥",
      "s": 4
    },
    {
      "t": "ਮੁਖੰ ਨੈਣ ਰਕਤੰ ॥",
      "s": 4
    },
    {
      "t": "ਧਰੇ ਪਾਣਿ ਸਕਤੰ ॥",
      "s": 4
    },
    {
      "t": "ਕੀਏ ਕ੍ਰੋਧ ਉਠੇ ॥",
      "s": 4
    },
    {
      "t": "ਸਰੰ ਬ੍ਰਿਸਟਿ ਬੁਠੇ ॥੯॥੧੩੧॥",
      "s": 4
    },
    {
      "t": "ਕਿਤੇ ਦੁਸਟ ਕੂਟੇ ॥",
      "s": 4
    },
    {
      "t": "ਅਨੰਤਾਸਤ੍ਰ ਛੂਟੇ ॥",
      "s": 4
    },
    {
      "t": "ਕਰੀ ਬਾਣ ਬਰਖੰ ॥",
      "s": 4
    },
    {
      "t": "ਭਰੀ ਦੇਬਿ ਹਰਖੰ ॥੧੦॥੧੩੨॥",
      "s": 4
    },
    {
      "t": "ਬੇਲੀ ਬਿੰਦ੍ਰਮ ਛੰਦ ॥",
      "s": 4
    },
    {
      "t": "ਕਹ ਕਹ ਸੁ ਕੂਕਤ ਕੰਕੀਯੰ ॥",
      "s": 4
    },
    {
      "t": "ਬਹਿ ਬਹਤ ਬੀਰ ਸੁ ਬੰਕੀਯੰ ॥",
      "s": 4
    },
    {
      "t": "ਲਹ ਲਹਤ ਬਾਣਿ ਕ੍ਰਿਪਾਣਯੰ ॥",
      "s": 4
    },
    {
      "t": "ਗਹ ਗਹਤ ਪ੍ਰੇਤ ਮਸਾਣਯੰ ॥੧੧॥੧੩੩॥",
      "s": 4
    },
    {
      "t": "ਡਹ ਡਹਤ ਡਵਰ ਡਮੰਕਯੰ ॥",
      "s": 4
    },
    {
      "t": "ਲਹ ਲਹਤ ਤੇਗ ਤ੍ਰਮੰਕਯੰ ॥",
      "s": 4
    },
    {
      "t": "ਧ੍ਰਮ ਧ੍ਰਮਤ ਸਾਗ ਧਮੰਕਯੰ ॥",
      "s": 4
    },
    {
      "t": "ਬਬਕੰਤ ਬੀਰ ਸੁ ਬੰਕਯੰ ॥੧੨॥੧੩੪॥",
      "s": 4
    },
    {
      "t": "ਛੁਟਕੰਤ ਬਾਣ ਕਮਾਣਯੰ ॥",
      "s": 4
    },
    {
      "t": "ਹਰਰੰਤ ਖੇਤ ਖਤ੍ਰਾਣਯੰ ॥",
      "s": 4
    },
    {
      "t": "ਡਹਕੰਤ ਡਾਮਰ ਡੰਕਣੀ ॥",
      "s": 4
    },
    {
      "t": "ਕਹ ਕਹਕ ਕੂਕਤ ਜੁਗਣੀ ॥੧੩॥੧੩੫॥",
      "s": 4
    },
    {
      "t": "ਉਫਟੰਤ ਸ੍ਰੋਣਤ ਛਿਛਯੰ ॥",
      "s": 4
    },
    {
      "t": "ਬਰਖੰਤ ਸਾਇਕ ਤਿਛਯੰ ॥",
      "s": 4
    },
    {
      "t": "ਬਬਕੰਤ ਬੀਰ ਅਨੇਕਯੰ ॥",
      "s": 4
    }
  ]
}
