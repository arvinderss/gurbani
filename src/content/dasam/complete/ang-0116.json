{
  "page": 116,
  "lines": [
    {
      "t": "ਬਜੇ ਸੰਖ ਭੇਰੀ ਉਠੈ ਸੰਖ ਨਾਦੰ ॥",
      "s": 4
    },
    {
      "t": "ਰਣੰਕੈ ਨਫੀਰੀ ਧੁਣ ਨਿਰਬਿਖਾਦੰ ॥੪੯॥੨੦੫॥",
      "s": 4
    },
    {
      "t": "ਕੜਕੇ ਕ੍ਰਿਪਾਣੰ ਸੜਕਾਰ ਸੇਲੰ ॥",
      "s": 4
    },
    {
      "t": "ਉਠੀ ਕੂਹ ਜੂਹੰ ਭਈ ਰੇਲ ਪੇਲੰ ॥",
      "s": 4
    },
    {
      "t": "ਰੁਲੇ ਤਛ ਮੁਛੰ ਗਿਰੇ ਚਉਰ ਚੀਰੰ ॥",
      "s": 4
    },
    {
      "t": "ਕਹੂੰ ਹਥ ਮਥੰ ਕਹੂੰ ਬਰਮ ਬੀਰੰ ॥੫੦॥੨੦੬॥",
      "s": 4
    },
    {
      "t": "ਰਸਾਵਲ ਛੰਦ ॥",
      "s": 4
    },
    {
      "t": "ਬਲੀ ਬੈਰ ਰੁਝੇ ॥",
      "s": 4
    },
    {
      "t": "ਸਮੂਹ ਸਾਰ ਜੁਝੇ ॥",
      "s": 4
    },
    {
      "t": "ਸੰਭਾਰੇ ਹਥੀਯਾਰੰ ॥",
      "s": 4
    },
    {
      "t": "ਬਕੈ ਮਾਰੁ ਮਾਰੰ ॥੫੧॥੨੦੭॥",
      "s": 4
    },
    {
      "t": "ਸਬੈ ਸਸਤ੍ਰ ਸਜੇ ॥",
      "s": 4
    },
    {
      "t": "ਮਹਾਬੀਰ ਗਜੇ ॥",
      "s": 4
    },
    {
      "t": "ਸਰੰ ਓਘ ਛੁਟੇ ॥",
      "s": 4
    },
    {
      "t": "ਕੜਕਾਰੁ ਉਠੇ ॥੫੨॥੨੦੮॥",
      "s": 4
    },
    {
      "t": "ਬਜੈ ਬਾਦ੍ਰਿਤੇਅੰ ॥",
      "s": 4
    },
    {
      "t": "ਹਸੈ ਗਾਧ੍ਰਬੇਅੰ ॥",
      "s": 4
    },
    {
      "t": "ਝੰਡਾ ਗਡ ਜੁਟੇ ॥",
      "s": 4
    },
    {
      "t": "ਸਰੰ ਸੰਜ ਫੁਟੇ ॥੫੩॥੨੦੯॥",
      "s": 4
    },
    {
      "t": "ਚਹੂੰ ਓਰ ਉਠੇ ॥",
      "s": 4
    },
    {
      "t": "ਸਰੰ ਬ੍ਰਿਸਟ ਬੁਠੇ ॥",
      "s": 4
    },
    {
      "t": "ਕਰੋਧੀ ਕਰਾਲੰ ॥",
      "s": 4
    },
    {
      "t": "ਬਕੈ ਬਿਕਰਾਲੰ ॥੫੪॥੨੧੦॥",
      "s": 4
    },
    {
      "t": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 4
    },
    {
      "t": "ਕਿਤੇ ਕੁਠੀਅੰ ਬੁਠੀਅੰ ਬ੍ਰਿਸਟ ਬਾਣੰ ॥",
      "s": 4
    },
    {
      "t": "ਰਣੰ ਡੁਲੀਯੰ ਬਾਜ ਖਾਲੀ ਪਲਾਣੰ ॥",
      "s": 4
    },
    {
      "t": "ਜੁਝੇ ਜੋਧਿਯੰ ਬੀਰ ਦੇਵੰ ਅਦੇਵੰ ॥",
      "s": 4
    },
    {
      "t": "ਸਭੇ ਸਸਤ੍ਰ ਸਾਜਾ ਮਨੋ ਸਾਤਨੇਵੰ ॥੫੫॥੨੧੧॥",
      "s": 4
    },
    {
      "t": "ਗਜੇ ਗਜੀਯੰ ਸਰਬ ਸਜੇ ਪਵੰਗੰ ॥",
      "s": 4
    },
    {
      "t": "ਜੁਧੰ ਜੁਟੀਯੰ ਜੋਧ ਛੁਟੇ ਖਤੰਗੰ ॥",
      "s": 4
    },
    {
      "t": "ਤੜਕੇ ਤਬਲੰ ਝੜੰਕੇ ਕ੍ਰਿਪਾਣੰ ॥",
      "s": 4
    },
    {
      "t": "ਸੜਕਾਰ ਸੇਲੰ ਰਣੰਕੇ ਨਿਸਾਣੰ ॥੫੬॥੨੧੨॥",
      "s": 4
    },
    {
      "t": "ਢਮਾ ਢਮ ਢੋਲੰ ਢਲਾ ਢੁਕ ਢਾਲੰ ॥",
      "s": 4
    },
    {
      "t": "ਗਹਾ ਜੂਹ ਗਜੇ ਹਯੰ ਹਲਚਾਲੰ ॥",
      "s": 4
    },
    {
      "t": "ਸਟਾ ਸਟ ਸੈਲੰ ਖਹਾ ਖੂਨਿ ਖਗੰ ॥",
      "s": 4
    },
    {
      "t": "ਤੁਟੇ ਚਰਮ ਬਰਮੰ ਉਠੇ ਨਾਲ ਅਗੰ ॥੫੭॥੨੧੩॥",
      "s": 4
    },
    {
      "t": "ਉਠੇ ਅਗਿ ਨਾਲੰ ਖਹੇ ਖੋਲ ਖਗੰ ॥",
      "s": 4
    },
    {
      "t": "ਨਿਸਾ ਮਾਵਸੀ ਜਾਣੁ ਮਾਸਾਣ ਜਗੰ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 4
    },
    {
      "t": "ਡਕੀ ਡਾਕਣੀ ਡਾਮਰੂ ਡਉਰ ਡਕੰ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 4
    },
    {
      "t": "ਨਚੇ ਬੀਰ ਬੈਤਾਲ ਭੂਤੰ ਭਭਕੰ ॥੫੮॥੨੧੪॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 4
    },
    {
      "t": "ਬੇਲੀ ਬਿਦ੍ਰਮ ਛੰਦ ॥",
      "s": 4
    },
    {
      "t": "ਸਰਬ ਸਸਤ੍ਰੁ ਆਵਤ ਭੇ ਜਿਤੇ ॥",
      "s": 4
    },
    {
      "t": "ਸਭ ਕਾਟਿ ਦੀਨ ਦ੍ਰੁਗਾ ਤਿਤੇ ॥",
      "s": 4
    },
    {
      "t": "ਅਰਿ ਅਉਰ ਜੇਤਿਕੁ ਡਾਰੀਅੰ ॥",
      "s": 4
    },
    {
      "t": "ਤੇਉ ਕਾਟਿ ਭੂਮਿ ਉਤਾਰੀਅੰ ॥੫੯॥੨੧੫॥",
      "s": 4
    },
    {
      "t": "ਸਰ ਆਪ ਕਾਲੀ ਛੰਡੀਅੰ ॥",
      "s": 4
    },
    {
      "t": "ਸਰਬਾਸਤ੍ਰ ਸਤ੍ਰ ਬਿਹੰਡੀਅੰ ॥",
      "s": 4
    },
    {
      "t": "ਸਸਤ੍ਰ ਹੀਨ ਜਬੈ ਨਿਹਾਰਿਯੋ ॥",
      "s": 4
    }
  ]
}
