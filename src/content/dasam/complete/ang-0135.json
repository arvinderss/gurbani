  "page": 135,
  "lines": [
    {
      "t": "ਅਖੰਡ ਖੰਡ ਦੁਪਲਾ ॥",
      "s": 6
    },
    {
      "t": "ਖਿਵੰਤ ਬਿਜੁ ਜ੍ਵਾਲਕਾ ॥",
      "s": 6
    },
    {
      "t": "ਅਨੰਤ ਗਦਿ ਬਿਦਸਾ ॥੨॥੮੦॥",
      "s": 6
    },
    {
      "t": "ਲਸੰਤ ਭਾਵ ਉਜਲੰ ॥",
      "s": 6
    },
    {
      "t": "ਦਲੰਤ ਦੁਖ ਦੁ ਦਲੰ ॥",
      "s": 6
    },
    {
      "t": "ਪਵੰਗ ਪਾਤ ਸੋਹੀਯੰ ॥",
      "s": 6
    },
    {
      "t": "ਸਮੁੰਦ੍ਰ ਬਾਜ ਲੋਹੀਯੰ ॥੩॥੮੧॥",
      "s": 6
    },
    {
      "t": "ਨਿਨੰਦ ਗੇਦ ਬ੍ਰਿਦਯੰ ॥",
      "s": 6
    },
    {
      "t": "ਅਖੇਦ ਨਾਦ ਦੁਧਰੰ ॥",
      "s": 6
    },
    {
      "t": "ਅਠਟ ਬਟ ਬਟਕੰ ॥",
      "s": 6
    },
    {
      "t": "ਅਘਟ ਅਨਟ ਸੁਖਲੰ ॥੪॥੮੨॥",
      "s": 6
    },
    {
      "t": "ਅਖੁਟ ਤੁਟ ਦ੍ਰਿਬਕੰ ॥",
      "s": 6
    },
    {
      "t": "ਅਜੁਟ ਛੁਟ ਸੁਛਕੰ ॥",
      "s": 6
    },
    {
      "t": "ਅਘੁਟ ਤੁਟ ਆਸਨੰ ॥",
      "s": 6
    },
    {
      "t": "ਅਲੇਖ ਅਭੇਖ ਅਨਾਸਨੰ ॥੫॥੮੩॥",
      "s": 6
    },
    {
      "t": "ਸੁਭੰਤ ਦੰਤ ਪਦੁਕੰ ॥",
      "s": 6
    },
    {
      "t": "ਜਲੰਤ ਸਾਮ ਸੁ ਘਟੰ ॥",
      "s": 6
    },
    {
      "t": "ਸੁਭੰਤ ਛੁਦ੍ਰ ਘੰਟਕਾ ॥",
      "s": 6
    },
    {
      "t": "ਜਲੰਤ ਭਾਰ ਕਛਟਾ ॥੬॥੮੪॥",
      "s": 6
    },
    {
      "t": "ਸਿਰੀਸੁ ਸੀਸ ਸੁਭੀਯੰ ॥",
      "s": 6
    },
    {
      "t": "ਘਟਾਕ ਬਾਨ ਉਭੀਯੰ ॥",
      "s": 6
    },
    {
      "t": "ਸੁਭੰਤ ਸੀਸ ਸਿਧਰੰ ॥",
      "s": 6
    },
    {
      "t": "ਜਲੰਤ ਸਿਧਰੀ ਨਰੰ ॥੭॥੮੫॥",
      "s": 6
    },
    {
      "t": "ਚਲੰਤ ਦੰਤ ਪਤਕੰ ॥",
      "s": 6
    },
    {
      "t": "ਭਜੰਤ ਦੇਖਿ ਦੁਦਲੰ ॥",
      "s": 6
    },
    {
      "t": "ਤਜੰਤ ਸਸਤ੍ਰ ਅਸਤ੍ਰਕੰ ॥",
      "s": 6
    },
    {
      "t": "ਚਲੰਤ ਚਕ੍ਰ ਚਉਦਿਸੰ ॥੮॥੮੬॥",
      "s": 6
    },
    {
      "t": "ਅਗੰਮ ਤੇਜ ਸੋਭੀਯੰ ॥",
      "s": 6
    },
    {
      "t": "ਰਿਖੀਸ ਈਸ ਲੋਭੀਯੰ ॥",
      "s": 6
    },
    {
      "t": "ਅਨੇਕ ਬਾਰ ਧਿਆਵਹੀ ॥",
      "s": 6
    },
    {
      "t": "ਨ ਤਤ੍ਰ ਪਾਰ ਪਾਵਹੀ ॥੯॥੮੭॥",
      "s": 6
    },
    {
      "t": "ਅਧੋ ਸੁ ਧੂਮ ਧੂਮਹੀ ॥",
      "s": 6
    },
    {
      "t": "ਅਘੂਰ ਨੇਤ੍ਰ ਘੂਮਹੀ ॥",
      "s": 6
    },
    {
      "t": "ਸੁ ਪੰਚ ਅਗਨ ਸਾਧੀਯੰ ॥",
      "s": 6
    },
    {
      "t": "ਨ ਤਾਮ ਪਾਰ ਲਾਧੀਯੰ ॥੧੦॥੮੮॥",
      "s": 6
    },
    {
      "t": "ਨਿਵਲ ਆਦਿ ਕਰਮਣੰ ॥",
      "s": 6
    },
    {
      "t": "ਅਨੰਤ ਦਾਨ ਧਰਮਣੰ ॥",
      "s": 6
    },
    {
      "t": "ਅਨੰਤ ਤੀਰਥ ਬਾਸਨੰ ॥",
      "s": 6
    },
    {
      "t": "ਨ ਏਕ ਨਾਮ ਕੇ ਸਮੰ ॥੧੧॥੮੯॥",
      "s": 6
    },
    {
      "t": "ਅਨੰਤ ਜਗ੍ਯ ਕਰਮਣੰ ॥",
      "s": 6
    },
    {
      "t": "ਗਜਾਦਿ ਆਦਿ ਧਰਮਣੰ ॥",
      "s": 6
    },
    {
      "t": "ਅਨੇਕ ਦੇਸ ਭਰਮਣੰ ॥",
      "s": 6
    },
    {
      "t": "ਨ ਏਕ ਨਾਮ ਕੇ ਸਮੰ ॥੧੨॥੯੦॥",
      "s": 6
    },
    {
      "t": "ਇਕੰਤ ਕੁੰਟ ਬਾਸਨੰ ॥",
      "s": 6
    },
    {
      "t": "ਭ੍ਰਮੰਤ ਕੋਟਕੰ ਬਨੰ ॥",
      "s": 6
    },
    {
      "t": "ਉਚਾਟਨਾਦ ਕਰਮਣੰ ॥",
      "s": 6
    },
    {
      "t": "ਅਨੇਕ ਉਦਾਸ ਭਰਮਣੰ ॥੧੩॥੯੧॥",
      "s": 6
    },
    {
      "t": "ਅਨੇਕ ਭੇਖ ਆਸਨੰ ॥",
      "s": 6
    }
  ]
