{
  "page": 139,
  "lines": [
    {
      "t": "ਇਹ ਕਉਨ ਆਹਿ ਆਤਮਾ ਸਰੂਪ ॥",
      "s": 6
    },
    {
      "t": "ਜਿਹ ਅਮਿਤ ਤੇਜਿ ਅਤਿਭੁਤਿ ਬਿਭੂਤਿ ॥੨॥੧੨੭॥",
      "s": 6
    },
    {
      "t": "ਪਰਾਤਮਾ ਬਾਚ ॥",
      "s": 6
    },
    {
      "t": "ਯਹਿ ਬ੍ਰਹਮ ਆਹਿ ਆਤਮਾ ਰਾਮ ॥",
      "s": 6
    },
    {
      "t": "ਜਿਹ ਅਮਿਤ ਤੇਜਿ ਅਬਿਗਤ ਅਕਾਮ ॥",
      "s": 6
    },
    {
      "t": "ਜਿਹ ਭੇਦ ਭਰਮ ਨਹੀ ਕਰਮ ਕਾਲ ॥",
      "s": 6
    },
    {
      "t": "ਜਿਹ ਸਤ੍ਰ ਮਿਤ੍ਰ ਸਰਬਾ ਦਿਆਲ ॥੩॥੧੨੮॥",
      "s": 6
    },
    {
      "t": "ਡੋਬਿਯੋ ਨ ਡੁਬੈ ਸੋਖਿਯੋ ਨ ਜਾਇ ॥",
      "s": 6
    },
    {
      "t": "ਕਟਿਯੋ ਨ ਕਟੈ ਨ ਬਾਰਿਯੋ ਬਰਾਇ ॥",
      "s": 6
    },
    {
      "t": "ਛਿਜੈ ਨ ਨੈਕ ਸਤ ਸਸਤ੍ਰ ਪਾਤ ॥",
      "s": 6
    },
    {
      "t": "ਜਿਹ ਸਤ੍ਰ ਮਿਤ੍ਰ ਨਹੀ ਜਾਤ ਪਾਤ ॥੪॥੧੨੯॥",
      "s": 6
    },
    {
      "t": "ਸਤ੍ਰ ਸਹੰਸ ਸਤਿ ਸਤਿ ਪ੍ਰਘਾਇ ॥",
      "s": 6
    },
    {
      "t": "ਛਿਜੈ ਨ ਨੈਕ ਖੰਡਿਓ ਨ ਜਾਇ ॥",
      "s": 6
    },
    {
      "t": "ਨਹੀ ਜਰੈ ਨੈਕ ਪਾਵਕ ਮੰਝਾਰ ॥",
      "s": 6
    },
    {
      "t": "ਬੋਰੈ ਨ ਸਿੰਧ ਸੋਖੈ ਨ ਬ੍ਰਯਾਰ ॥੫॥੧੩੦॥",
      "s": 6
    },
    {
      "t": "ਇਕ ਕਰ੍ਯੋ ਪ੍ਰਸਨ ਆਤਮਾ ਦੇਵ ॥",
      "s": 6
    },
    {
      "t": "ਅਨਭੰਗ ਰੂਪ ਅਨਿਭਉ ਅਭੇਵ ॥",
      "s": 6
    },
    {
      "t": "ਯਹਿ ਚਤੁਰ ਵਰਗ ਸੰਸਾਰ ਦਾਨ ॥",
      "s": 6
    },
    {
      "t": "ਕਿਹੁ ਚਤੁਰ ਵਰਗ ਕਿਜੈ ਵਖਿਆਨ ॥੬॥੧੩੧॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 6
    },
    {
      "t": "ਇਕ ਰਾਜੁ ਧਰਮ ਇਕ ਦਾਨ ਧਰਮ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 6
    },
    {
      "t": "ਇਕ ਭੋਗ ਧਰਮ ਇਕ ਮੋਛ ਕਰਮ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 6
    },
    {
      "t": "ਇਕ ਚਤੁਰ ਵਰਗ ਸਭ ਜਗ ਭਣੰਤ ॥",
      "s": 6
    },
    {
      "t": "ਸੇ ਆਤਮਾਹ ਪਰਾਤਮਾ ਪੁਛੰਤ ॥੭॥੧੩੨॥",
      "s": 6
    },
    {
      "t": "ਇਕ ਰਾਜ ਧਰਮ ਇਕ ਧਰਮ ਦਾਨ ॥",
      "s": 6
    },
    {
      "t": "ਇਕ ਭੋਗ ਧਰਮ ਇਕ ਮੋਛਵਾਨ ॥",
      "s": 6
    },
    {
      "t": "ਤੁਮ ਕਹੋ ਚਤ੍ਰ ਚਤ੍ਰੈ ਬਿਚਾਰ ॥",
      "s": 6
    },
    {
      "t": "ਜੇ ਤ੍ਰਿਕਾਲ ਭਏ ਜੁਗ ਅਪਾਰ ॥੮॥੧੩੩॥",
      "s": 6
    },
    {
      "t": "ਬਰਨੰਨ ਕਰੋ ਤੁਮ ਪ੍ਰਿਥਮ ਦਾਨ ॥",
      "s": 6
    },
    {
      "t": "ਜਿਮ ਦਾਨ ਧਰਮ ਕਿੰਨੇ ਨ੍ਰਿਪਾਨ ॥",
      "s": 6
    },
    {
      "t": "ਸਤਿਜੁਗ ਕਰਮ ਸੁਰ ਦਾਨ ਦੰਤ ॥",
      "s": 6
    },
    {
      "t": "ਭੂਮਾਦਿ ਦਾਨ ਕੀਨੇ ਅਕੰਥ ॥੯॥੧੩੪॥",
      "s": 6
    },
    {
      "t": "ਤ੍ਰੈ ਜੁਗ ਮਹੀਪ ਬਰਨੇ ਨ ਜਾਤ ॥",
      "s": 6
    },
    {
      "t": "ਗਾਥਾ ਅਨੰਤ ਉਪਮਾ ਅਗਾਤ ॥",
      "s": 6
    },
    {
      "t": "ਜੋ ਕੀਏ ਜਗਤ ਮੈ ਜਗ ਧਰਮ ॥",
      "s": 6
    },
    {
      "t": "ਬਰਨੇ ਨ ਜਾਹਿ ਤੇ ਅਮਿਤ ਕਰਮ ॥੧੦॥੧੩੫॥",
      "s": 6
    },
    {
      "t": "ਕਲਜੁਗ ਤੇ ਆਦਿ ਜੋ ਭਏ ਮਹੀਪ ॥",
      "s": 6
    },
    {
      "t": "ਇਹਿ ਭਰਥ ਖੰਡਿ ਮਹਿ ਜੰਬੂ ਦੀਪ ॥",
      "s": 6
    },
    {
      "t": "ਤ੍ਵ ਬਲ ਪ੍ਰਤਾਪ ਬਰਣੌ ਸੁ ਤ੍ਰੈਣ ॥",
      "s": 6
    },
    {
      "t": "ਰਾਜਾ ਯੁਧਿਸਟ੍ਰ ਭੂ ਭਰਥ ਏਣ ॥੧੧॥੧੩੬॥",
      "s": 6
    },
    {
      "t": "ਖੰਡੇ ਅਖੰਡ ਜਿਹ ਚਤੁਰ ਖੰਡ ॥",
      "s": 6
    },
    {
      "t": "ਕੈਰੌ ਕੁਰਖੇਤ੍ਰ ਮਾਰੇ ਪ੍ਰਚੰਡ ॥",
      "s": 6
    },
    {
      "t": "ਜਿਹ ਚਤੁਰ ਕੁੰਡ ਜਿਤਿਯੋ ਦੁਬਾਰ ॥",
      "s": 6
    },
    {
      "t": "ਅਰਜਨ ਭੀਮਾਦਿ ਭ੍ਰਾਤਾ ਜੁਝਾਰ ॥੧੨॥੧੩੭॥",
      "s": 6
    },
    {
      "t": "ਅਰਜਨ ਪਠਿਯੋ ਉਤਰ ਦਿਸਾਨ ॥",
      "s": 6
    },
    {
      "t": "ਭੀਮਹਿ ਕਰਾਇ ਪੂਰਬ ਪਯਾਨ ॥",
      "s": 6
    },
    {
      "t": "ਸਹਿਦੇਵ ਪਠਿਯੋ ਦਛਣ ਸੁਦੇਸ ॥",
      "s": 6
    },
    {
      "t": "ਨੁਕਲਹਿ ਪਠਾਇ ਪਛਮ ਪ੍ਰਵੇਸ ॥੧੩॥੧੩੮॥",
      "s": 6
    },
    {
      "t": "ਮੰਡੇ ਮਹੀਪ ਖੰਡਿਯੋ ਖਤ੍ਰਾਣ ॥",
      "s": 6
    }
  ]
}
