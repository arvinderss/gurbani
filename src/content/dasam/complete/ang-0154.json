{
  "page": 154,
  "lines": [
    {
      "t": "ਨ੍ਰਿਪ ਕੇ ਸੰਗਿ ਜੋ ਮਿਲਿ ਜਾਤੁ ਭਏ ॥",
      "s": 6
    },
    {
      "t": "ਨਰ ਸੋ ਰਜਪੂਤ ਕਹਾਤ ਭਏ ॥੧੮॥੩੦੮॥",
      "s": 6
    },
    {
      "t": "ਤਿਨ ਜੀਤ ਬਿਜੈ ਕਹੁ ਰਾਉ ਚੜ੍ਯੋ ॥",
      "s": 6
    },
    {
      "t": "ਅਤਿ ਤੇਜੁ ਪ੍ਰਚੰਡ ਪ੍ਰਤਾਪੁ ਬਢ੍ਯੋ ॥",
      "s": 6
    },
    {
      "t": "ਜੋਊ ਆਨਿ ਮਿਲੇ ਅਰੁ ਸਾਕ ਦਏ ॥",
      "s": 6
    },
    {
      "t": "ਨਰ ਤੇ ਰਜਪੂਤ ਕਹਾਤ ਭਏ ॥੧੯॥੩੦੯॥",
      "s": 6
    },
    {
      "t": "ਜਿਨ ਸਾਕ ਦਏ ਨਹਿ ਰਾਰਿ ਬਢੀ ॥",
      "s": 6
    },
    {
      "t": "ਤਿਨ ਕੀ ਇਨ ਲੈ ਜੜ ਮੂਲ ਕਢੀ ॥",
      "s": 6
    },
    {
      "t": "ਦਲ ਤੇ ਬਲ ਤੇ ਧਨ ਟੂਟਿ ਗਏ ॥",
      "s": 6
    },
    {
      "t": "ਵਹਿ ਲਾਗਤ ਬਾਨਜ ਕਰਮ ਭਏ ॥੨੦॥੩੧੦॥",
      "s": 6
    },
    {
      "t": "ਜੋਊ ਆਨਿ ਮਿਲੇ ਨਹਿ ਜੋਰਿ ਲਰੇ ॥",
      "s": 6
    },
    {
      "t": "ਵਹਿ ਬਾਧ ਮਹਾਗਨਿ ਹੋਮ ਕਰੇ ॥",
      "s": 6
    },
    {
      "t": "ਅਨਗੰਧ ਜਰੇ ਮਹਾ ਕੁੰਡ ਅਨਲੰ ॥",
      "s": 6
    },
    {
      "t": "ਭਇਓ ਛਤ੍ਰੀਅ ਮੇਧੁ ਮਹਾ ਪ੍ਰਬਲੰ ॥੨੧॥੩੧੧॥",
      "s": 6
    },
    {
      "t": "ਇਤਿ ਅਜੈ ਸਿੰਘ ਕਾ ਰਾਜ ਸੰਪੂਰਨ ਭਇਆ ॥",
      "s": 6
    },
    {
      "t": "ਜਗਰਾਜ ॥ ਤੋਮਰ ਛੰਦ ॥ ਤ੍ਵਪ੍ਰਸਾਦਿ ॥",
      "s": 6
    },
    {
      "t": "ਬਿਆਸੀ ਬਰਖ ਪਰਮਾਨ ॥",
      "s": 6
    },
    {
      "t": "ਦਿਨ ਦੋਇ ਮਾਸ ਅਸਟਾਨ ॥",
      "s": 6
    },
    {
      "t": "ਬਹੁ ਰਾਜੁ ਭਾਗ ਕਮਾਇ ॥",
      "s": 6
    },
    {
      "t": "ਪੁਨਿ ਨ੍ਰਿਪ ਕੋ ਨ੍ਰਿਪਰਾਇ ॥੧॥੩੧੨॥",
      "s": 6
    },
    {
      "t": "ਸੁਨ ਰਾਜ ਰਾਜ ਮਹਾਨ ॥",
      "s": 6
    },
    {
      "t": "ਦਸ ਚਾਰਿ ਚਾਰਿ ਨਿਧਾਨ ॥",
      "s": 6
    },
    {
      "t": "ਦਸ ਦੋਇ ਦੁਆਦਸ ਮੰਤ ॥",
      "s": 6
    },
    {
      "t": "ਧਰਨੀ ਧਰਾਨ ਮਹੰਤਿ ॥੨॥੩੧੩॥",
      "s": 6
    },
    {
      "t": "ਪੁਨਿ ਭਯੋ ਉਦੋਤ ਨ੍ਰਿਪਾਲ ॥",
      "s": 6
    },
    {
      "t": "ਰਸ ਰਤਿ ਰੂਪ ਰਸਾਲ ॥",
      "s": 6
    },
    {
      "t": "ਅਤਿ ਭਾਨ ਤੇਜ ਪ੍ਰਚੰਡ ॥",
      "s": 6
    },
    {
      "t": "ਅਨਖੰਡ ਤੇਜ ਪ੍ਰਚੰਡ ॥੩॥੩੧੪॥",
      "s": 6
    },
    {
      "t": "ਤਿਨਿ ਬੋਲਿ ਬਿਪ੍ਰ ਮਹਾਨ ॥",
      "s": 6
    },
    {
      "t": "ਪਸੁ ਮੇਧ ਜਗ ਰਚਾਨ ॥",
      "s": 6
    },
    {
      "t": "ਦਿਜ ਪ੍ਰਾਗ ਜੋਤ ਬੁਲਾਇ ॥",
      "s": 6
    },
    {
      "t": "ਅਪਿ ਕਾਮਰੂਪ ਕਹਾਇ ॥੪॥੩੧੫॥",
      "s": 6
    },
    {
      "t": "ਦਿਜ ਕਾਮਰੂਪ ਅਨੇਕ ॥",
      "s": 6
    },
    {
      "t": "ਨ੍ਰਿਪ ਬੋਲਿ ਲੀਨ ਬਿਸੇਖ ॥",
      "s": 6
    },
    {
      "t": "ਸਭ ਜੀਅ ਜਗ ਅਪਾਰ ॥",
      "s": 6
    },
    {
      "t": "ਮਖ ਹੋਮ ਕੀਨ ਅਬਿਚਾਰ ॥੫॥੩੧੬॥",
      "s": 6
    },
    {
      "t": "ਪਸੁ ਏਕ ਪੈ ਦਸ ਬਾਰ ॥",
      "s": 6
    },
    {
      "t": "ਪੜਿ ਬੇਦ ਮੰਤ੍ਰ ਅਬਿਚਾਰ ॥",
      "s": 6
    },
    {
      "t": "ਅਬਿ ਮਧਿ ਹੋਮ ਕਰਾਇ ॥",
      "s": 6
    },
    {
      "t": "ਧਨੁ ਭੂਪ ਤੇ ਬਹੁ ਪਾਇ ॥੬॥੩੧੭॥",
      "s": 6
    },
    {
      "t": "ਪਸੁ ਮੇਘ ਜਗ ਕਰਾਇ ॥",
      "s": 6
    },
    {
      "t": "ਬਹੁ ਭਾਤ ਰਾਜੁ ਸੁਹਾਇ ॥",
      "s": 6
    },
    {
      "t": "ਬਰਖ ਅਸੀਹ ਅਸਟ ਪ੍ਰਮਾਨ ॥",
      "s": 6
    },
    {
      "t": "ਦੁਇ ਮਾਸ ਰਾਜੁ ਕਮਾਨ ॥੭॥੩੧੮॥",
      "s": 6
    },
    {
      "t": "ਪੁਨ ਕਠਨ ਕਾਲ ਕਰਵਾਲ ॥",
      "s": 6
    },
    {
      "t": "ਜਗ ਜਾਰੀਆ ਜਿਹ ਜੁਵਾਲ ॥",
      "s": 6
    },
    {
      "t": "ਵਹਿ ਖੰਡੀਆ ਅਨਖੰਡ ॥",
      "s": 6
    },
    {
      "t": "ਅਨਖੰਡ ਰਾਜ ਪ੍ਰਚੰਡ ॥੮॥੩੧੯॥",
      "s": 6
    }
  ]
}
