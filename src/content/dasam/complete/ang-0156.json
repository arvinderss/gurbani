  "page": 156,
  "lines": [
    {
      "t": "ਆਪਨ ਰਹਤ ਨਿਰਾਲਮ ਜਗ ਤੇ ॥",
      "s": 7
    },
    {
      "t": "ਜਾਨ ਲਏ ਜਾਨਾ ਮੈ ਤਬਤੇ ॥੫॥",
      "s": 7
    },
    {
      "t": "ਚਉਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਆਪ ਰਚੇ ਆਪੇ ਕਲ ਘਾਏ ॥",
      "s": 7
    },
    {
      "t": "ਅਵਰਨ ਕੈ ਦੈ ਮੂੰਡ ਹਤਾਏ ॥",
      "s": 7
    },
    {
      "t": "ਆਪ ਨਿਰਾਲਮੁ ਰਹਾ ਨ ਪਾਯਾ ॥",
      "s": 7
    },
    {
      "t": "ਤਾਂ ਤੇ ਨਾਮੁ ਬਿਅੰਤ ਕਹਾਯਾ ॥੬॥",
      "s": 7
    },
    {
      "t": "ਚਉਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਜੋ ਚਉਬੀਸ ਅਵਤਾਰ ਕਹਾਏ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਨ ਭੀ ਤੁਮ ਪ੍ਰਭ ਤਨਕ ਨ ਪਾਏ ॥",
      "v": [
        [
          3,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਸਭ ਹੀ ਜਗ ਭਰਮੇ ਭਵਰਾਯੰ ॥",
      "s": 7
    },
    {
      "t": "ਤਾ ਤੇ ਨਾਮੁ ਬਿਅੰਤ ਕਹਾਯੰ ॥੭॥",
      "s": 7
    },
    {
      "t": "ਚਉਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਸਭ ਹੀ ਛਲਤ ਨ ਆਪ ਛਲਾਯਾ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਤਾ ਤੇ ਛਲੀਆ ਆਪ ਕਹਾਯਾ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਸੰਤਨ ਦੁਖੀ ਨਿਰਖ ਅਕੁਲਾਵੈ ॥",
      "s": 7
    },
    {
      "t": "ਦੀਨ ਬੰਧੁ ਤਾ ਤੇ ਕਹਲਾਵੈ ॥੮॥",
      "s": 7
    },
    {
      "t": "ਚਉਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਅੰਤ ਕਰਤ ਸਭ ਜਗ ਕੌ ਕਾਲਾ ॥",
      "s": 7
    },
    {
      "t": "ਨਾਮੁ ਕਾਲ ਤਾ ਤੇ ਜਗ ਡਾਲਾ ॥",
      "s": 7
    },
    {
      "t": "ਸਮੈ ਸੰਤ ਪਰ ਹੋਤ ਸਹਾਈ ॥",
      "s": 7
    },
    {
      "t": "ਤਾ ਤੇ ਸੰਖਯਾ ਸੰਤ ਸੁਨਾਈ ॥੯॥",
      "s": 7
    },
    {
      "t": "ਚਉਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਨਿਰਖ ਦੀਨ ਪਰ ਹੋਤ ਦਿਆਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਦੀਨ ਬੰਧ ਹਮ ਤਬੈ ਬਿਚਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਸੰਤਨ ਪਰ ਕਰੁਣਾ ਰਸੁ ਢਰਈ ॥",
      "s": 7
    },
    {
      "t": "ਕਰੁਣਾ ਨਿਧਿ ਜਗ ਤਬੈ ਉਚਰਈ ॥੧੦॥",
      "s": 7
    },
    {
      "t": "ਚਉਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਸੰਕਟ ਹਰਤ ਸਾਧਵਨ ਸਦਾ ॥",
      "s": 7
    },
    {
      "t": "ਸੰਕਟ ਹਰਨ ਨਾਮੁ ਭਯੋ ਤਦਾ ॥",
      "s": 7
    }
  ]
