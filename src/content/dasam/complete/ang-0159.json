{
  "page": 159,
  "lines": [
    {
      "t": "ਏਕਹਿ ਆਪ ਸਭਨ ਮੋ ਬਿਆਪਾ ॥",
      "s": 7
    },
    {
      "t": "ਸਭ ਕੋਈ ਭਿੰਨ ਭਿੰਨ ਕਰ ਥਾਪਾ ॥੩੫॥",
      "s": 7
    },
    {
      "t": "ਸਭ ਹੀ ਮਹਿ ਰਮ ਰਹਿਯੋ ਅਲੇਖਾ ॥",
      "s": 7
    },
    {
      "t": "ਮਾਗਤ ਭਿੰਨ ਭਿੰਨ ਤੇ ਲੇਖਾ ॥",
      "s": 7
    },
    {
      "t": "ਜਿਨ ਨਰ ਏਕ ਵਹੈ ਠਹਰਾਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਤਨਹੀਂ ਪਰਮ ਤੱਤੁ ਕਹ ਪਾਯੋ ॥੩੬॥",
      "s": 7
    },
    {
      "t": "ਏਕਹ ਰੂਪ ਅਨੂਪ ਸਰੂਪਾ ॥",
      "s": 7
    },
    {
      "t": "ਰੰਕ ਭਯੋ ਰਾਵਤ ਕਹੂੱ ਭੂਪਾ ॥",
      "s": 7
    },
    {
      "t": "ਭਿੰਨ ਭਿੰਨ ਸਭਹਨ ਉਰਝਾਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਸਭ ਤੇ ਜੁਦੋ ਨ ਕਿਨਹੂੰ ਪਾਯੋ ॥੩੭॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਭਿੰਨ ਭਿੰਨ ਸਭਹੂੰ ਉਪਜਾਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਭਿੰਨ ਭਿੰਨ ਕਰ ਤਿਨੋ ਖਪਾਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਆਪ ਕਿਸੂ ਕੋ ਦੋਸ ਨ ਲੀਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਅਉਰਨ ਸਿਰ ਬੁਰਿਆਈ ਦੀਨਾ ॥੩੮॥",
      "s": 7
    },
    {
      "t": "ਅਥ ਪ੍ਰਥਮ ਮਛ ਅਵਤਾਰ ਕਥਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਸੰਖਾਸੁਰ ਦਾਨਵ ਪੁਨ ਭਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਬਹੁ ਬਿਧਿ ਕੈ ਜਗ ਕੋ ਦੁਖ ਦਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਮੱਛ ਅਵਤਾਰ ਆਪ ਪੁਨ ਧਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਆਪਨ ਜਾਪ ਆਪ ਮੋ ਕਰਾ ॥੩੯॥",
      "s": 7
    },
    {
      "t": "ਪ੍ਰਿਥਮੈ ਤੁੱਛ ਮੀਨ ਬਪੁ ਧਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਪੈਠਿ ਸਮੁੰਦ੍ਰ ਝਕਝੋਰਨ ਕਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਪੁਨਿ ਪੁਨਿ ਕਰਤ ਭਯੋ ਬਿਸਥਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਸੰਖਾਸੁਰ ਤਬ ਕੋਪ ਬਿਚਾਰਾ ॥੪੦॥",
      "s": 7
    }
  ]
}
