{
  "page": 163,
  "lines": [
    {
      "t": "ਚਤੁਰਥ ਭਨ ਧਾਤ ਸਿਤੰ ਰੁਕਮੰ ॥",
      "s": 7
    },
    {
      "t": "ਬਹੁਰੋ ਕਥ ਤਾਂਬਰ ਕਲੀ ਪਿਤਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਕਥਿ ਅਸਟਮ ਜਿਸਤੁ ਹੈ ਧਾਤ ਧਰੰ ॥੯॥",
      "s": 7
    },
    {
      "t": "ਉਪਧਾਤ ਕਥਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਤੋਟਕ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਸੁਰਮੰ ਸਿੰਗਰਫ ਹਰਤਾਲ ਗਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਚਤੁਰਥ ਤਿਹ ਸਿੰਬਲਖਾਰ ਭਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਮ੍ਰਿਤ ਸੰਖ ਮਨਾਸਿਲ ਅਭ੍ਰਕਯੰ ॥",
      "s": 7
    },
    {
      "t": "ਭਨਿ ਅਸਟਮ ਲੋਣ ਰਸੰ ਲਵਣੰ ॥੧੦॥",
      "s": 7
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਧਾਤੁ ਉਪਧਾਤ ਜਥਾ ਸਕਤਿ ਸੋਹੂੰ ਕਹੀ ਬਨਾਇ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਖਾਨਨ ਮਹਿ ਭੀ ਹੋਤ ਹੈ ਕੋਈ ਕਹੂੰ ਕਮਾਇ ॥੧੧॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਰਤਨ ਉਪਰਤਨ ਨਿਕਾਸੇ ਤਬਹੀ ॥",
      "s": 7
    },
    {
      "t": "ਧਾਤ ਉਪਧਾਤ ਦਿਰਬ ਮੋ ਸਬ ਹੀ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਹ ਤਬ ਹੀ ਬਿਸਨਹਿ ਹਿਰ ਲਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਅਵਰਨਿ ਬਾਟ ਅਵਰ ਨਹਿ ਦਯੋ ॥੧੨॥",
      "s": 7
    },
    {
      "t": "ਸਾਰੰਗ ਸਰ ਅਸਿ ਚਕ੍ਰ ਗਦਾ ਲੀਅ ॥",
      "s": 7
    },
    {
      "t": "ਪਾਚਾਮਰ ਲੈ ਨਾਦ ਅਧਿਕ ਕੀਅ ॥",
      "s": 7
    },
    {
      "t": "ਸੂਲ ਪਿਨਾਕ ਬਿਸਹ ਕਰਿ ਲੀਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਸੋ ਲੈ ਮਹਾਦੇਵ ਕਉ ਦੀਨਾ ॥੧੩॥",
      "s": 7
    },
    {
      "t": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਦੀਯੋ ਇੰਦ੍ਰ ਐਰਾਵਤੰ ਬਾਜ ਸੂਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਉਠੇ ਦੀਹ ਦਾਨੋ ਜੁਧੰ ਲੋਹ ਪੂਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਅਨੀ ਦਾਨਵੀ ਦੇਖਿ ਉਠੀ ਅਪਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਤਬੈ ਬਿਸਨ ਜੂ ਚਿਤਿ ਕੀਨੀ ਬਿਚਾਰੰ ॥੧੪॥",
      "s": 7
    },
    {
      "t": "ਅਥ ਨਰ ਨਾਰਾਇਣ ਅਵਤਾਰ ਕਥਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਨਰੰ ਅਉਰ ਨਾਰਾਇਣੰ ਰੂਪ ਧਾਰੀ ॥",
      "s": 7
    },
    {
      "t": "ਭਯੋ ਸਾਮੁਹੇ ਸਸਤ੍ਰ ਅਸਤ੍ਰੰ ਸੰਭਾਰੀ ॥",
      "s": 7
    },
    {
      "t": "ਭਟੰ ਐਠਿ ਫੈਂਟੇ ਭੁਜੰ ਠੋਕਿ ਭੂਪੰ ॥",
      "s": 7
    },
    {
      "t": "ਬਜੇ ਸੂਲ ਸੇਲੰ ਭਏ ਆਪ ਰੂਪੰ ॥੧੫॥",
      "s": 7
    },
    {
      "t": "ਪਰਿਯੋ ਆਪ ਮੋ ਲੋਹ ਕ੍ਰੋਹੰ ਅਪਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਧਰਿਯੋ ਐਸ ਕੈ ਬਿਸਨੁ ਤ੍ਰਿਤੀਆਵਤਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਨਰੰ ਏਕੁ ਨਾਰਾਇਣੰ ਦੁਐ ਸਰੂਪੰ ॥",
      "s": 7
    },
    {
      "t": "ਦਿਪੈ ਜੋਤਿ ਸਉਦਰ ਜੁ ਧਾਰੇ ਅਨੂਪੰ ॥੧੬॥",
      "s": 7
    },
    {
      "t": "ਉਠੈ ਟੂਕ ਕੋਪੰ ਗੁਰਜੰ ਪ੍ਰਹਾਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਜੁਟੇ ਜੰਗ ਕੋ ਜੰਗ ਜੋਧਾ ਜੁਝਾਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਉਡੀ ਧੂਰਿ ਪੂਰੰ ਛੁਹੀ ਐਨ ਗੈਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਡਿਗੇ ਦੇਵਤਾ ਦੈਤ ਕੰਪਿਯੋ ਤ੍ਰਿਨੈਨੰ ॥੧੭॥",
      "s": 7
    },
    {
      "t": "ਗਿਰੇ ਬੀਰ ਏਕੰ ਅਨੇਕੰ ਪ੍ਰਕਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਸੁਭੈ ਜੰਗ ਮੋ ਜੰਗ ਜੋਧਾ ਜੁਝਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਪਰੀ ਤਛ ਮੁਛੰ ਸਭੈ ਅੰਗ ਭੰਗੰ ॥",
      "s": 7
    },
    {
      "t": "ਮਨੋ ਪਾਨ ਕੈ ਭੰਗ ਪੌਢੇ ਮਲੰਗੰ ॥੧੮॥",
      "s": 7
    },
    {
      "t": "ਦਿਸਾ ਮਉ ਨ ਆਈ ਅਨੀ ਦੈਤ ਰਾਜੰ ॥",
      "s": 7
    },
    {
      "t": "ਭਜੈ ਸਰਬ ਦੇਵੰ ਤਜੇ ਸਰਬ ਸਾਜੰ ॥",
      "s": 7
    },
    {
      "t": "ਗਿਰੇ ਸੰਜ ਪੁੰਜ ਸਿਰੰ ਬਾਹੁ ਬੀਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਸੁਭੈ ਬਾਨ ਜਿਉ ਚੇਤਿ ਪੁਹਪੰ ਕਰੀਰੰ ॥੧੯॥",
      "s": 7
    }
  ]
}
