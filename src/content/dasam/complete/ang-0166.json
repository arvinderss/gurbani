{
  "page": 166,
  "lines": [
    {
      "t": "ਥਟਿਯੋ ਧਰਮ ਰਾਜੰ ਜਿਤੇ ਦੇਵ ਸਰਬੰ ॥",
      "s": 7
    },
    {
      "t": "ਉਤਾਰਿਯੋ ਭਲੀ ਭਾਤ ਸੋ ਤਾਹਿ ਗਰਬੰ ॥੧੪॥",
      "s": 7
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਬੈਰਾਹ ਖਸਟਮ ਅਵਤਾਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੬॥",
      "s": 7
    },
    {
      "t": "ਅਥ ਨਰਸਿੰਘ ਅਵਤਾਰ ਕਥਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਸ੍ਰੀ ਭਗਉਤੀ ਜੀ ਸਹਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਪਾਧਰੀ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਇਹ ਭਾਤਿ ਕੀਯੋ ਦਿਵਰਾਜ ਰਾਜ ॥",
      "s": 7
    },
    {
      "t": "ਭੰਡਾਰ ਭਰੇ ਸੁਭ ਸਰਬ ਸਾਜ ॥",
      "s": 7
    },
    {
      "t": "ਜਬ ਦੇਵਤਾਨ ਬਢਿਯੋ ਗਰੂਰ ॥",
      "s": 7
    },
    {
      "t": "ਬਲਵੰਤ ਦੈਤ ਉਠੇ ਕਰੂਰ ॥੧॥",
      "s": 7
    },
    {
      "t": "ਲਿਨੋ ਛਿਨਾਇ ਦਿਵਰਾਜ ਰਾਜ ॥",
      "s": 7
    },
    {
      "t": "ਬਾਜਿਤ੍ਰ ਨੇਕ ਉਠੇ ਸੁ ਬਾਜਿ ॥",
      "s": 7
    },
    {
      "t": "ਇਹ ਭਾਤਿ ਜਗਤਿ ਦੋਹੀ ਫਿਰਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਜਲੰ ਬਾ ਥਲੇਅੰ ਹਿਰਿਨਾਛ ਰਾਇ ॥੨॥",
      "s": 7
    },
    {
      "t": "ਇਕ ਦ੍ਯੋਸ ਗਯੋ ਨਿਜ ਨਾਰਿ ਤੀਰ ॥",
      "s": 7
    },
    {
      "t": "ਸਜਿ ਸੁਧ ਸਾਜ ਨਿਜ ਅੰਗਿ ਬੀਰ ॥",
      "s": 7
    },
    {
      "t": "ਕਿਹ ਭਾਤਿ ਸ੍ਵਤ੍ਰਿਯ ਮੋ ਭਯੋ ਨਿਰੁਕਤ ॥",
      "s": 7
    },
    {
      "t": "ਤਬ ਭਯੋ ਦੁਸਟ ਕੋ ਬੀਰਜ ਮੁਕਤ ॥੩॥",
      "s": 7
    },
    {
      "t": "ਪ੍ਰਹਲਾਦ ਭਗਤ ਲੀਨੋ ਵਤਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਸਬ ਕਰਨਿ ਕਾਜ ਸੰਤਨ ਉਧਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਚਟਸਾਰ ਪੜਨਿ ਸਉਪ੍ਯੋ ਨ੍ਰਿਪਾਲਿ ॥",
      "s": 7
    },
    {
      "t": "ਪਟੀਯਹਿ ਕਹਿਯੋ ਲਿਖਿ ਦੈ ਗੁਪਾਲ ॥੪॥",
      "s": 7
    },
    {
      "t": "ਤੋਟਕ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਇਕਿ ਦਿਵਸ ਗਯੋ ਚਟਸਾਰਿ ਨ੍ਰਿਪੰ ॥",
      "s": 7
    }
  ]
}
