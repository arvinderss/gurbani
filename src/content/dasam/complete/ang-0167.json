{
  "page": 167,
  "lines": [
    {
      "t": "ਚਿਤਿ ਚੌਕ ਰਹਿਯੋ ਸੁਭਿ ਦੇਖਿ ਸੁਤੰ ॥",
      "s": 7
    },
    {
      "t": "ਜੋ ਪੜਿਯੋ ਦਿਜ ਤੇ ਸੁਨ ਤਾਹਿ ਰੜੋ ॥",
      "s": 7
    },
    {
      "t": "ਨਿਰਭੈ ਸਿਸੁ ਨਾਮੁ ਗੁਪਾਲ ਪੜੋ ॥੫॥",
      "s": 7
    },
    {
      "t": "ਸੁਨਿ ਨਾਮੁ ਗੁਪਾਲ ਰਿਸ੍ਰਯੋ ਅਸੁਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਬਿਨੁ ਮੋਹਿ ਸੁ ਕਉਣੁ ਭਜੋ ਦੁਸਰੰ ॥",
      "v": [
        [
          1,
          1
        ],
        [
          3,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਜੀਯ ਮਾਹਿ ਧਰੋ ਸਿਸੁ ਯਾਹਿ ਹਨੋ ॥",
      "s": 7
    },
    {
      "t": "ਜੜ ਕਿਉ ਭਗਵਾਨ ਕੋ ਨਾਮ ਭਨੋ ॥੬॥",
      "s": 7
    },
    {
      "t": "ਜਲ ਅਉਰ ਥਲੰ ਇਕ ਬੀਰ ਮਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਇਹ ਕਾਹਿ ਗੁਪਾਲ ਕੋ ਨਾਮੁ ਭਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਤਬ ਹੀ ਤਿਹ ਬਾਧਤ ਥੰਮ ਭਏ ॥",
      "s": 7
    },
    {
      "t": "ਸੁਨਿ ਸ੍ਰਵਨਨ ਦਾਨਵ ਬੈਨ ਧਏ ॥੭॥",
      "s": 7
    },
    {
      "t": "ਗਹਿ ਮੂੜ ਚਲੇ ਸਿਸੁ ਮਾਰਨ ਕੋ ॥",
      "s": 7
    },
    {
      "t": "ਨਿਕਸ੍ਰਯੋ ਬ ਗੁਪਾਲ ਉਬਾਰਨ ਕੋ ॥",
      "s": 7
    },
    {
      "t": "ਚਕਚਉਧ ਰਹੇ ਜਨ ਦੇਖਿ ਸਬੈ ॥",
      "s": 7
    },
    {
      "t": "ਨਿਕਸ੍ਰਯੋ ਹਰਿ ਫਾਰਿ ਕਿਵਾਰ ਜਬੈ ॥੮॥",
      "s": 7
    },
    {
      "t": "ਲਖਿ ਦੇਵ ਦਿਵਾਰ ਸਬੈ ਥਹਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਅਵਿਲੋਕਿ ਚਰਾਚਰ ਹੂੰਹਿ ਹਿਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਗਰਜੇ ਨਰਸਿੰਘ ਨਰਾਤ ਕਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਦ੍ਰਿਗ ਰਤ ਕੀਏ ਮੁਖ ਸ੍ਰੋਣ ਭਰੰ ॥੯॥",
      "s": 7
    },
    {
      "t": "ਲਖਿ ਦਾਨਵ ਭਾਜ ਚਲੇ ਸਬ ਹੀ ॥",
      "s": 7
    },
    {
      "t": "ਗਰਜਿਯੋ ਨਰਸਿੰਘ ਰਣੰ ਜਬ ਹੀ ॥",
      "s": 7
    },
    {
      "t": "ਇਕ ਭੂਪਤਿ ਠਾਢਿ ਰਹਿਯੋ ਰਣ ਮੈ ॥",
      "s": 7
    },
    {
      "t": "ਗਹਿ ਹਾਥਿ ਗਦਾ ਨਿਰਭੈ ਮਨ ਮੈ ॥੧੦॥",
      "s": 7
    },
    {
      "t": "ਲਰਜੇ ਸਬ ਸੂਰ ਨ੍ਰਿਪੰ ਗਰਜੇ ॥",
      "s": 7
    },
    {
      "t": "ਸਮੁਹਾਤ ਭਏ ਭਟ ਕੇਹਰਿ ਕੇ ॥",
      "s": 7
    },
    {
      "t": "ਜੁ ਗਏ ਸਮੁਹੇ ਛਿਤ ਤੈ ਪਟਕੇ ॥",
      "s": 7
    },
    {
      "t": "ਰਣਿ ਭੈ ਰਣਧੀਰ ਬਟਾ ਨਟ ਕੇ ॥੧੧॥",
      "s": 7
    },
    {
      "t": "ਬਬਕੇ ਰਣਧੀਰ ਸੁ ਬੀਰ ਘਣੇ ॥",
      "s": 7
    },
    {
      "t": "ਰਹਿਗੇ ਮਨੋ ਕਿੰਸਕ ਸ੍ਰੋਣ ਸਣੇ ॥",
      "s": 7
    },
    {
      "t": "ਉਮਗੇ ਚਹੂੰ ਓਰਨ ਤੇ ਰਿਪੁ ਯੌ ॥",
      "s": 7
    },
    {
      "t": "ਬਰਸਾਤਿ ਬਹਾਰਨ ਅਭ੍ਰਨ ਜਿਯੋ ॥੧੨॥",
      "s": 7
    },
    {
      "t": "ਬਰਖੈ ਸਰ ਸੁਧ ਸਿਲਾ ਸਿਤਿਯੰ ॥",
      "s": 7
    },
    {
      "t": "ਉਮਡੇ ਬਰਬੀਰ ਦਸੋ ਦਿਸਿਯੰ ॥",
      "s": 7
    },
    {
      "t": "ਚਮਕੰਤ ਕ੍ਰਿਪਾਣ ਸੁ ਬਾਣ ਜੁਧੰ ॥",
      "s": 7
    },
    {
      "t": "ਫਹਰੰਤ ਧੁਜਾ ਜਨੁ ਬੀਰ ਕ੍ਰੁਧੰ ॥੧੩॥",
      "s": 7
    },
    {
      "t": "ਹਹਰੰਤ ਹਠੀ ਬਰਖੰਤ ਸਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਜਨੁ ਸਾਵਨ ਮੇਘ ਬੁਠਿਯੋ ਦੁਸਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਫਰਹੰਤ ਧੁਜਾ ਹਹਰੰਤ ਹਯੰ ॥",
      "s": 7
    },
    {
      "t": "ਉਪਜਿਯੋ ਜੀਅ ਦਾਨਵ ਰਾਇ ਭਯੰ ॥੧੪॥",
      "s": 7
    },
    {
      "t": "ਹਿਹਨਾਤ ਹਯੰ ਗਰਜੰਤ ਗਜੰ ॥",
      "s": 7
    },
    {
      "t": "ਭਟ ਬਾਹ ਕਟੀ ਜਨੁ ਇੰਦ੍ਰ ਧੁਜੰ ॥",
      "s": 7
    },
    {
      "t": "ਤਰਫੰਤ ਭਟੰ ਗਰਜੰ ਗਜੰ ॥",
      "s": 7
    },
    {
      "t": "ਸੁਨ ਕੈ ਧੁਨਿ ਸਾਵਣ ਮੇਘ ਲਜੰ ॥੧੫॥",
      "s": 7
    },
    {
      "t": "ਬਿਚਲ੍ਰਯੋ ਪਗ ਦ੍ਵੈਕੁ ਫਿਰਿਯੋ ਪੁਨਿ ਜਿਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਕਰਿ ਪੁੰਛ ਲਗੇ ਅਹਿ ਕ੍ਰੁਧਤ ਜਿਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਰਣਰੰਗ ਸਮੈ ਮੁਖ ਯੋ ਚਮਕ੍ਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਲਖਿ ਸੂਰ ਸਰੋਰਹੁ ਸੋ ਦਮਕ੍ਰਯੋ ॥੧੬॥",
      "s": 7
    },
    {
      "t": "ਰਣ ਰੰਗ ਤੁਰੰਗਨ ਐਸ ਭਯੋ ॥",
      "s": 7
    }
  ]
}
