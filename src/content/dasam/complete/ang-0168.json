{
  "page": 168,
  "lines": [
    {
      "t": "ਸਿਵ ਧਿਆਨ ਛੁਟ੍ਰਯੋ ਬ੍ਰਹਮੰਡ ਗਿਰਿਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਸਰ ਸੇਲ ਸਿਲਾ ਸਿਤ ਐਸ ਬਹੇ ॥",
      "s": 7
    },
    {
      "t": "ਨਭ ਅਉਰ ਧਰਾ ਦੋਊ ਪੂਰਿ ਰਹੇ ॥੧੭॥",
      "s": 7
    },
    {
      "t": "ਗਣ ਗੰਧ੍ਰਬ ਦੇਖਿ ਦੋਊ ਹਰਖੇ ॥",
      "s": 7
    },
    {
      "t": "ਪੁਹਪਾਵਲਿ ਦੇਵ ਸਭੈ ਬਰਖੇ ॥",
      "s": 7
    },
    {
      "t": "ਮਿਲ ਗੇ ਭਟ ਆਪ ਬਿਖੈ ਦੋਊ ਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਸਿਸ ਖੇਲਤ ਰੈਣਿ ਹੁਡੂਹੁਡ ਜਿਯੋ ॥੧੮॥",
      "s": 7
    },
    {
      "t": "ਬੇਲੀ ਬ੍ਰਿੰਦਮ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਰਣਧੀਰ ਬੀਰ ਸੁ ਗਜਹੀ ॥",
      "s": 7
    },
    {
      "t": "ਲਖਿ ਦੇਵ ਅਦੇਵ ਸੁ ਲਜਹੀ ॥",
      "s": 7
    },
    {
      "t": "ਇਕ ਸੂਰ ਘਾਇਲ ਘੂੰਮਹੀ ॥",
      "s": 7
    },
    {
      "t": "ਜਨੁ ਧੂਮਿ ਅਧੋਮੁਖ ਧੂਮਹੀ ॥੧੯॥",
      "s": 7
    },
    {
      "t": "ਭਟ ਏਕ ਅਨੇਕ ਪ੍ਰਕਾਰ ਹੀ ॥",
      "s": 7
    },
    {
      "t": "ਜੁਝੇ ਅਜੁਝ ਜੁਝਾਰ ਹੀ ॥",
      "s": 7
    },
    {
      "t": "ਫਹਰੰਤ ਬੈਰਕ ਬਾਣਯੰ ॥",
      "s": 7
    },
    {
      "t": "ਥਹਰੰਤ ਜੋਧ ਕਿਕਾਣਯੰ ॥੨੦॥",
      "s": 7
    },
    {
      "t": "ਤੋਮਰ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਹਿਰਣਾਤ ਕੋਟ ਕਿਕਾਨ ॥",
      "s": 7
    },
    {
      "t": "ਬਰਖੰਤ ਸੇਲ ਜੁਆਨ ॥",
      "s": 7
    },
    {
      "t": "ਛੁਟਕੰਤ ਸਾਇਕ ਸੁਧ ॥",
      "s": 7
    },
    {
      "t": "ਮਚਿਯੋ ਅਨੂਪਮ ਜੁਧ ॥੨੧॥",
      "s": 7
    },
    {
      "t": "ਭਟ ਏਕ ਅਨੇਕ ਪ੍ਰਕਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਜੁਝੇ ਅਨੰਤ ਸ੍ਵਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਬਾਹੈ ਕ੍ਰਿਪਾਣ ਨਿਸੰਗ ॥",
      "s": 7
    },
    {
      "t": "ਮਚਿਯੋ ਅਪੂਰਬ ਜੰਗ ॥੨੨॥",
      "s": 7
    },
    {
      "t": "ਦੋਧਕ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਬਾਹਿ ਕ੍ਰਿਪਾਣ ਸੁ ਬਾਣ ਭਟ ਗਣ ॥",
      "s": 7
    },
    {
      "t": "ਅੰਤਿ ਗਿਰੈ ਪੁਨਿ ਜੂਝਿ ਮਹਾ ਰਣਿ ॥",
      "s": 7
    },
    {
      "t": "ਘਾਇ ਲਗੈ ਇਮ ਘਾਇਲ ਝੂਲੈ ॥",
      "s": 7
    },
    {
      "t": "ਫਾਗੁਨਿ ਅੰਤਿ ਬਸੰਤ ਸੇ ਫੂਲੈ ॥੨੩॥",
      "s": 7
    },
    {
      "t": "ਬਾਹਿ ਕਟੀ ਭਟ ਏਕਨ ਐਸੀ ॥",
      "s": 7
    },
    {
      "t": "ਸੁੰਡ ਮਨੋ ਗਜ ਰਾਜਨ ਜੈਸੀ ॥",
      "s": 7
    },
    {
      "t": "ਸੋਹਤ ਏਕ ਅਨੇਕ ਪ੍ਰਕਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਫੂਲ ਖਿਲੇ ਜਨੁ ਮਧਿ ਫੁਲਵਾਰੰ ॥੨੪॥",
      "s": 7
    },
    {
      "t": "ਸ੍ਰੋਣ ਰੰਗੇ ਅਰਿ ਏਕ ਅਨੇਕੰ ॥",
      "s": 7
    },
    {
      "t": "ਫੂਲ ਰਹੇ ਜਨੁ ਕਿੰਸਕ ਨੇਕੰ ॥",
      "s": 7
    },
    {
      "t": "ਧਾਵਤ ਘਾਵ ਕ੍ਰਿਪਾਣ ਪ੍ਰਹਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਜਾਨੁ ਕਿ ਕੋਪ ਪ੍ਰਤਛ ਦਿਖਾਰੰ ॥੨੫॥",
      "s": 7
    },
    {
      "t": "ਤੋਟਕ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਜੂਝਿ ਗਿਰੇ ਅਰਿ ਏਕ ਅਨੇਕੰ ॥",
      "s": 7
    },
    {
      "t": "ਘਾਇ ਲਗੇ ਬਿਸੰਭਾਰ ਬਿਸੇਖੰ ॥",
      "s": 7
    },
    {
      "t": "ਕਾਟਿ ਗਿਰੇ ਭਟ ਏਕਹਿ ਵਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਸਾਬੁਨ ਜਾਨੁ ਗਈ ਬਹਿ ਤਾਰੰ ॥੨੬॥",
      "s": 7
    },
    {
      "t": "ਪੂਰ ਪਰੇ ਭਏ ਚੂਰ ਸਿਪਾਹੀ ॥",
      "s": 7
    },
    {
      "t": "ਸੁਆਮਿ ਕੇ ਕਾਜ ਕੀ ਲਾਜ ਨਿਬਾਹੀ ॥",
      "s": 7
    },
    {
      "t": "ਬਾਹਿ ਕ੍ਰਿਪਾਣਨ ਬਾਣ ਸੁ ਬੀਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਅੰਤਿ ਭਜੇ ਭਯ ਮਾਨਿ ਅਧੀਰੰ ॥੨੭॥",
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    }
  ]
}
