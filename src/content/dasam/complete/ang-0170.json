{
  "page": 170,
  "lines": [
    {
      "t": "ਕੰਪਾਈ ਸਟਾ ਪੂਛ ਫੇਰੀ ਬਿਸਾਲੰ ॥੩੩॥",
      "s": 7
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਗਰਜਤ ਰਣਿ ਨਰਸਿੰਘ ਕੇ ਭਜੇ ਸੂਰ ਅਨੇਕ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਏਕ ਟਿਕਿਯੋ ਹਿਰਿਨਾਛ ਤਹ ਅਵਰ ਨ ਜੋਧਾ ਏਕੁ ॥੩੪॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਮੁਸਟ ਜੁਧ ਜੁਟੇ ਭਟ ਦੋਊ ॥",
      "s": 7
    },
    {
      "t": "ਤੀਸਰ ਤਾਹਿ ਨ ਪੇਖੀਅਤ ਕੋਊ ॥",
      "s": 7
    },
    {
      "t": "ਭਏ ਦੁਹੁਨ ਕੇ ਰਾਤੇ ਨੈਣਾ ॥",
      "s": 7
    },
    {
      "t": "ਦੇਖਤ ਦੇਵ ਤਮਾਸੇ ਗੈਣਾ ॥੩੫॥",
      "s": 7
    },
    {
      "t": "ਅਸਟ ਦਿਵਸ ਅਸਟੇ ਨਿਸਿ ਜੁਧਾ ॥",
      "s": 7
    },
    {
      "t": "ਕੀਨੋ ਦੁਹੂੰ ਭਟਨ ਮਿਲਿ ਕ੍ਰੁਧਾ ॥",
      "s": 7
    },
    {
      "t": "ਬਹੁਰੋ ਅਸੁਰ ਕਿਛੁ ਕੁ ਮੁਰਝਾਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਗਿਰਿਯੋ ਭੂਮਿ ਜਨੁ ਬ੍ਰਿਛ ਪੁਰਾਨਾ ॥੩੬॥",
      "s": 7
    },
    {
      "t": "ਸੀਚਿ ਬਾਰਿ ਪੁਨਿ ਤਾਹਿ ਜਗਾਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਜਗੋ ਮੂਰਛਨਾ ਪੁਨਿ ਜੀਯ ਆਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਬਹੁਰੋ ਭਿਰੇ ਸੂਰ ਦੋਈ ਕ੍ਰੁਧਾ ॥",
      "s": 7
    },
    {
      "t": "ਮੰਡਿਯੋ ਬਹੁਰਿ ਆਪ ਮਹਿ ਜੁਧਾ ॥੩੭॥",
      "s": 7
    },
    {
      "t": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਹਲਾ ਚਾਲ ਕੈ ਕੈ ਪੁਨਰ ਬੀਰ ਢੂਕੇ ॥",
      "s": 7
    },
    {
      "t": "ਮਚਿਯੋ ਜੁਧ ਜਿਯੋ ਕਰਨ ਸੰਗੰ ਘੜੂਕੇ ॥",
      "s": 7
    },
    {
      "t": "ਨਖੰ ਪਾਤ ਦੋਊ ਕਰੇ ਦੈਤ ਘਾਤੰ ॥",
      "s": 7
    },
    {
      "t": "ਮਨੋ ਗਜ ਜੁਟੇ ਬਨੰ ਮਸਤਿ ਮਾਤੰ ॥੩੮॥",
      "s": 7
    },
    {
      "t": "ਪੁਨਰ ਨਰਸਿੰਘੰ ਧਰਾ ਤਾਹਿ ਮਾਰਿਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਪੁਰਾਨੋ ਪਲਾਸੀ ਮਨੋ ਬਾਇ ਡਾਰਿਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਹਨ੍ਯੋ ਦੇਖਿ ਦੁਸਟੰ ਭਈ ਪੁਹਪ ਬਰਖੰ ॥",
      "s": 7
    },
    {
      "t": "ਕੀਏ ਦੇਵਤਿਯੋ ਆਨ ਕੈ ਜੀਤ ਕਰਖੰ ॥੩੯॥",
      "s": 7
    },
    {
      "t": "ਪਾਧਰੀ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਕੀਨੋ ਨਰਸਿੰਘ ਦੁਸਟੰ ਸੰਘਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਧਰਿਯੋ ਸੁ ਬਿਸਨ ਸਪਤਮ ਵਤਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਲਿਨੋ ਸੁ ਭਗਤ ਅਪਨੋ ਛਿਨਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਸਬ ਸਿਸਟਿ ਧਰਮ ਕਰਮਨ ਚਲਾਇ ॥੪੦॥",
      "s": 7
    },
    {
      "t": "ਪ੍ਰਹਲਾਦ ਕਰਿਯੋ ਨ੍ਰਿਪ ਛਤ੍ਰ ਫੇਰਿ ॥",
      "s": 7
    },
    {
      "t": "ਦੀਨੋ ਸੰਘਾਰ ਸਬ ਇਮ ਅੰਧੇਰ ॥",
      "s": 7
    },
    {
      "t": "ਸਬ ਦੁਸਟ ਅਰਿਸਟ ਦਿਨੇ ਖਪਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਪੁਨਿ ਲਈ ਜੋਤਿ ਜੋਤਹਿ ਮਿਲਾਇ ॥੪੧॥",
      "s": 7
    },
    {
      "t": "ਸਭ ਦੁਸਟ ਮਾਰਿ ਕੀਨੇ ਅਭੇਖ ॥",
      "s": 7
    },
    {
      "t": "ਪੁਨ ਮਿਲ੍ਯੋ ਜਾਇ ਭੀਤਰ ਅਲੇਖ ॥",
      "s": 7
    },
    {
      "t": "ਕਬਿ ਜਥਾਮਤਿ ਕਥ੍ਯੋ ਬਿਚਾਰੁ ॥",
      "s": 7
    },
    {
      "t": "ਇਮ ਧਰਿਯੋ ਬਿਸਨੁ ਸਪਤਮ ਵਤਾਰ ॥੪੨॥",
      "s": 7
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਨਰਸਿੰਘ ਸਪਤਮੋ ਅਵਤਾਰ ਸਮਾਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੭॥",
      "s": 7
    },
    {
      "t": "ਅਥ ਬਾਵਨ ਅਵਤਾਰ ਬਰਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਸ੍ਰੀ ਭਗਉਤੀ ਜੀ ਸਹਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਭਏ ਦਿਵਸ ਕੇਤੈ ਨਰਸਿੰਘਾਵਤਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਪੁਨਰ ਭੂਮਿ ਮੋ ਪਾਪਾ ਬਾਢ੍ਯੋ ਅਪਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਕਰੇ ਲਾਗ ਜਗੰ ਪੁਨਰ ਦੈਤ ਦਾਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਬਲਿ ਰਾਜ ਕੀ ਦੇਹਿ ਬਢਿਯੋ ਗੁਮਾਨੰ ॥੧॥",
      "s": 7
    },
    {
      "t": "ਨ ਪਾਵੈ ਬਲੰ ਦੇਵਤਾ ਜਗ ਬਾਸੰ ॥",
      "s": 7
    }
  ]
}
