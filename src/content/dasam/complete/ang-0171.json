{
  "page": 171,
  "lines": [
    {
      "t": "ਭਈ ਇੰਦ੍ਰ ਕੀ ਰਾਜਧਾਨੀ ਬਿਨਾਸੰ ॥",
      "s": 7
    },
    {
      "t": "ਕਰੀ ਜੋਗ ਅਰਾਧਨਾ ਸਰਬ ਦੇਵੰ ॥",
      "s": 7
    },
    {
      "t": "ਪ੍ਰਸੰਨੰ ਭਏ ਕਾਲ ਪੁਰਖੰ ਅਭੇਵੰ ॥੨॥",
      "s": 7
    },
    {
      "t": "ਦੀਯੋ ਆਇਸੰ ਕਾਲਪੁਰਖੰ ਅਪਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਧਰੋ ਬਾਵਨਾ ਬਿਸਨੁ ਅਸਟਮ ਵਤਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਲਈ ਬਿਸਨੁ ਆਗਿਆ ਚਲਿਯੋ ਧਾਇ ਐਸੇ ॥",
      "s": 7
    },
    {
      "t": "ਲਹਿਯੋ ਦਾਰਦੀ ਭੂਪ ਭੰਡਾਰ ਜੈਸੇ ॥੩॥",
      "s": 7
    },
    {
      "t": "ਨਰਾਜ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਸਰੂਪ ਛੋਟ ਧਾਰਿ ਕੈ ॥",
      "s": 7
    },
    {
      "t": "ਚਲਿਯੋ ਤਹਾ ਬਿਚਾਰਿ ਕੈ ॥",
      "s": 7
    },
    {
      "t": "ਸਭਾ ਨਰੇਸ ਜਾਨ੍ਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਤਹੀ ਸੁ ਪਾਵ ਠਾਨ੍ਰਯੋ ॥੪॥",
      "s": 7
    },
    {
      "t": "ਸੁ ਬੇਦ ਚਾਰ ਉਚਾਰ ਕੈ ॥",
      "s": 7
    },
    {
      "t": "ਸੁਣ੍ਯੋ ਨ੍ਰਿਪੰ ਸੁਧਾਰ ਕੈ ॥",
      "s": 7
    },
    {
      "t": "ਬੁਲਾਇ ਬਿਪੁ ਕੋ ਲਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਮਲਯਾਗਰ ਮੂੜਕਾ ਦਯੋ ॥੫॥",
      "s": 7
    },
    {
      "t": "ਪਦਾਰਘ ਦੀਪ ਦਾਨ ਦੈ ॥",
      "s": 7
    },
    {
      "t": "ਪ੍ਰਦਛਨਾ ਅਨੇਕ ਕੈ ॥",
      "s": 7
    },
    {
      "t": "ਕਰੋਰਿ ਦਛਨਾ ਦਈ ॥",
      "s": 7
    },
    {
      "t": "ਨ ਹਾਥਿ ਬਿਪ ਨੈ ਲਈ ॥੬॥",
      "s": 7
    },
    {
      "t": "ਕਹਿਯੋ ਨ ਮੋਰ ਕਾਜ ਹੈ ॥",
      "s": 7
    },
    {
      "t": "ਮਿਥ੍ਯਾ ਇਹ ਤੋਰ ਸਾਜ ਹੈ ॥",
      "s": 7
    },
    {
      "t": "ਅਢਾਇ ਪਾਵ ਭੂਮਿ ਦੈ ॥",
      "s": 7
    },
    {
      "t": "ਬਸੇਖ ਪੂਰ ਕੀਰਤਿ ਲੈ ॥੭॥",
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਜਬ ਦਿਜ ਐਸ ਬਖਾਨੀ ਬਾਨੀ ॥",
      "s": 7
    },
    {
      "t": "ਭੂਪਤਿ ਸਹਤ ਨ ਜਾਨ੍ਯੋ ਰਾਨੀ ॥",
      "s": 7
    },
    {
      "t": "ਪੈਰ ਅਢਾਇ ਭੂੰਮਿ ਦੇ ਕਹੀ ॥",
      "s": 7
    },
    {
      "t": "ਦ੍ਰਿੜ ਕਰਿ ਬਾਤ ਦਿਜੋਤਮ ਗਹੀ ॥੮॥",
      "s": 7
    },
    {
      "t": "ਦਿਜਬਰ ਸੁਕ੍ਰ ਹੁਤੋ ਨ੍ਰਿਪ ਤੀਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਜਾਨ ਗਯੋ ਸਭ ਭੇਦੁ ਵਜੀਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਜਿਯੋ ਜਿਯੋ ਦੇਨ ਪ੍ਰਿਥਵੀ ਨ੍ਰਿਪ ਕਹੈ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਮੁ ਤਿਮੁ ਨਾਹਿ ਪੁਰੋਹਿਤ ਗਹੈ ॥੯॥",
      "s": 7
    },
    {
      "t": "ਜਬ ਨ੍ਰਿਪ ਦੇਨ ਧਰਾ ਮਨੁ ਕੀਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਤਬ ਹੀ ਉਤਰ ਸੁਕ੍ਰ ਇਮ ਦੀਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਲਘੁ ਦਿਜ ਯਾਹਿ ਨ ਭੂਪ ਪਛਾਨੋ ॥",
      "s": 7
    },
    {
      "t": "ਬਿਸਨੁ ਅਵਤਾਰ ਇਸੀ ਕਰਿ ਮਾਨੋ ॥੧੦॥",
      "s": 7
    },
    {
      "t": "ਸੁਨਤ ਬਚਨ ਦਾਨਵ ਸਭ ਹਸੇ ॥",
      "s": 7
    },
    {
      "t": "ਉਚਰਤ ਸੁਕ੍ਰ ਕਹਾ ਘਰਿ ਬਸੇ ॥",
      "s": 7
    },
    {
      "t": "ਸਸਿਕ ਸਮਾਨ ਨ ਦਿਜ ਮਹਿ ਮਾਸਾ ॥",
      "s": 7
    },
    {
      "t": "ਕਸ ਕਰਹੈ ਇਹ ਜਗ ਬਿਨਾਸਾ ॥੧੧॥",
      "s": 7
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਸੁਕ੍ਰੋਬਾਚ ॥",
      "s": 7
    },
    {
      "t": "ਜਿਮ ਚਿਨਗਾਰੀ ਅਗਨਿ ਕੀ ਗਿਰਤ ਸਘਨ ਬਨ ਮਾਹਿ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਅਧਿਕ ਤਨਿਕ ਤੇ ਹੋਤ ਹੈ ਤਿਮ ਦਿਜਬਰ ਨਰ ਨਾਹਿ ॥੧੨॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਹਸਿ ਭੂਪਤਿ ਇਹ ਬਾਤ ਬਖਾਨੀ ॥",
      "s": 7
    },
    {
      "t": "ਸੁਨਹੋ ਸੁਕ੍ਰ ਤੁਮ ਬਾਤ ਨ ਜਾਨੀ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 7
    }
  ]
}
