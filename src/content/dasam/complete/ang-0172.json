{
  "page": 172,
  "lines": [
    {
      "t": "ਫੁਨਿ ਇਹ ਸਮੋ ਸਭੋ ਛਲ ਜੈ ਹੈ ॥",
      "s": 7
    },
    {
      "t": "ਹਰਿ ਸੋ ਫੇਰਿ ਨ ਭਿਛਕ ਐ ਹੈ ॥੧੩॥",
      "s": 7
    },
    {
      "t": "ਮਨ ਮਹਿ ਬਾਤ ਇਹੈ ਠਹਰਾਈ ॥",
      "s": 7
    },
    {
      "t": "ਮਨ ਮੋ ਧਰੀ ਨ ਕਿਸੂ ਬਤਾਈ ॥",
      "s": 7
    },
    {
      "t": "ਭ੍ਰਿਤ ਤੇ ਮਾਗ ਕਮੰਡਲ ਏਸਾ ॥",
      "s": 7
    },
    {
      "t": "ਲਗ੍ਯੋ ਦਾਨ ਤਿਹ ਦੇਨ ਨਰੇਸਾ ॥੧੪॥",
      "s": 7
    },
    {
      "t": "ਸੁਕ੍ਰ ਬਾਤ ਮਨ ਮੋ ਪਹਿਚਾਨੀ ॥",
      "s": 7
    },
    {
      "t": "ਭੇਦ ਨ ਲਹਤ ਭੂਪ ਅਗਿਆਨੀ ॥",
      "s": 7
    },
    {
      "t": "ਧਾਰਿ ਮਕਰਿ ਕੇ ਜਾਰ ਸਰੂਪਾ ॥",
      "s": 7
    },
    {
      "t": "ਪੈਠਿਯੋ ਮਧ ਕਮੰਡਲ ਭੂਪਾ ॥੧੫॥",
      "s": 7
    },
    {
      "t": "ਨ੍ਰਿਪ ਬਰ ਪਾਨਿ ਸੁਰਾਹੀ ਲਈ ॥",
      "s": 7
    },
    {
      "t": "ਦਾਨ ਸਮੈ ਦਿਜਬਰ ਕੀ ਭਈ ॥",
      "s": 7
    },
    {
      "t": "ਦਾਨ ਹੇਤ ਜਬ ਹਾਥ ਚਲਾਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਨਿਕਸ ਨੀਰ ਕਰਿ ਤਾਹਿ ਨ ਆਯੋ ॥੧੬॥",
      "s": 7
    },
    {
      "t": "ਤੋਮਰ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਚਮਕ੍ਯੋ ਤਬੈ ਦਿਜਰਾਜ ॥",
      "s": 7
    },
    {
      "t": "ਕਰੀਐ ਨ੍ਰਿਪੇਸੁ ਇਲਾਜ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਤਿਨਕਾ ਮਿਲੈ ਇਹ ਬੀਚਿ ॥",
      "s": 7
    },
    {
      "t": "ਇਕ ਚਛ ਹੁਐ ਹੈ ਨੀਚ ॥੧੭॥",
      "s": 7
    },
    {
      "t": "ਤਿਨੁਕਾ ਨ੍ਰਿਪਤ ਕਰਿ ਲੀਨ ॥",
      "s": 7
    },
    {
      "t": "ਭੀਤਰ ਕਮੰਡਲ ਦੀਨ ॥",
      "s": 7
    },
    {
      "t": "ਸੁਕ੍ਰ ਆਖਿ ਲਗੀਆ ਜਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਇਕ ਚਛ ਭਯੋ ਦਿਜ ਰਾਇ ॥੧੮॥",
      "s": 7
    },
    {
      "t": "ਨੇਤ੍ਰ ਤੇ ਜੁ ਗਿਰਿਯੋ ਨੀਰ ॥",
      "s": 7
    }
  ]
}
