{
  "page": 173,
  "lines": [
    {
      "t": "ਸੋਈ ਲੀਯੋ ਕਰਿ ਦਿਜ ਬੀਰ ॥",
      "s": 7
    },
    {
      "t": "ਕਰਿ ਨੀਰ ਚੁਵਨ ਨ ਦੀਨ ॥",
      "s": 7
    },
    {
      "t": "ਇਮ ਸੁਆਮਿ ਕਾਰਜ ਕੀਨ ॥੧੯॥",
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਚਛ ਨੀਰ ਕਰ ਭੀਤਰ ਪਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਵਹੈ ਸੰਕਲਪ ਦਿਜਹ ਕਰਿ ਧਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਐਸ ਤਬੈ ਨਿਜ ਦੇਹ ਬਢਾਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਲੋਕ ਛੇਦਿ ਪਰਲੋਕਿ ਸਿਧਾਯੋ ॥੨੦॥",
      "s": 7
    },
    {
      "t": "ਨਿਰਖ ਲੋਗ ਅਦਭੁਤ ਬਿਸਮਏ ॥",
      "s": 7
    },
    {
      "t": "ਦਾਨਵ ਪੇਖਿ ਮੂਰਛਨ ਭਏ ॥",
      "s": 7
    },
    {
      "t": "ਪਾਵ ਪਤਾਰ ਛੁਯੋ ਸਿਰ ਕਾਸਾ ॥",
      "s": 7
    },
    {
      "t": "ਚਕ੍ਰਿਤ ਭਏ ਲਖਿ ਲੋਕ ਤਮਾਸਾ ॥੨੧॥",
      "s": 7
    },
    {
      "t": "ਏਕੈ ਪਾਵ ਪਤਾਰਹਿ ਛੂਆ ॥",
      "s": 7
    },
    {
      "t": "ਦੂਸਰ ਪਾਵ ਗਗਨ ਲਉ ਹੂਆ ॥",
      "s": 7
    },
    {
      "t": "ਭਿਦਿਯੋ ਅੰਡ ਬ੍ਰਹਮੰਡ ਅਪਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਹ ਤੇ ਗਿਰੀ ਗੰਗ ਕੀ ਧਾਰਾ ॥੨੨॥",
      "s": 7
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਭੂਪ ਅਚੰਭਵ ਲਹਾ ॥",
      "s": 7
    },
    {
      "t": "ਮਨ ਕ੍ਰਮ ਬਚਨ ਚਕ੍ਰਿਤ ਹੁਐ ਰਹਾ ॥",
      "s": 7
    },
    {
      "t": "ਸੁ ਕੁਛ ਭਯੋ ਜੋਊ ਸੁਕ੍ਰਿ ਉਚਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਸੋਈ ਅਖੀਯਨ ਹਮ ਆਜ ਨਿਹਾਰਾ ॥੨੩॥",
      "s": 7
    },
    {
      "t": "ਅਰਧਿ ਦੇਹਿ ਅਪਨੋ ਮਿਨਿ ਦੀਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਕੈ ਭੂਪਤਿ ਜਸੁ ਲੀਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਜਬ ਲਉ ਗੰਗ ਜਮੁਨ ਕੋ ਨੀਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਤਬ ਲਉ ਚਲੀ ਕਥਾ ਜਗਿ ਧੀਰਾ ॥੨੪॥",
      "s": 7
    },
    {
      "t": "ਬਿਸਨ ਪ੍ਰਸੰਨਿ ਪ੍ਰਤਛ ਹੁਐ ਕਹਾ ॥",
      "s": 7
    },
    {
      "t": "ਚੋਬਦਾਰੁ ਦੁਆਰੇ ਹੁਐ ਰਹਾ ॥",
      "s": 7
    },
    {
      "t": "ਕਹਿਯੋ ਚਲੇ ਤਬ ਲਗੈ ਕਹਾਨੀ ॥",
      "s": 7
    },
    {
      "t": "ਜਬ ਲਗ ਗੰਗ ਜਮੁਨ ਕੋ ਪਾਨੀ ॥੨੫॥",
      "s": 7
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਜਹ ਸਾਧਨ ਸੰਕਟ ਪਰੈ ਤਹ ਤਹ ਭਏ ਸਹਾਇ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਦੁਆਰਪਾਲ ਹੁਐ ਦਰਿ ਬਸੇ ਭਗਤ ਹੇਤ ਹਰਿਰਾਇ ॥੨੬॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਅਸਟਮ ਅਵਤਾਰ ਬਿਸਨ ਅਸ ਧਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਸਾਧਨ ਸਬੈ ਕ੍ਰਿਤਾਰਥ ਕਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਅਬ ਨਵਮੋ ਬਰਨੋ ਅਵਤਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਸੁਨਹੁ ਸੰਤ ਚਿਤ ਲਾਇ ਸੁ ਧਾਰਾ ॥੨੭॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਬਾਵਨ ਅਸਟਮੋ ਅਵਤਾਰ ਬਲਿ ਛਲਨ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੮॥",
      "s": 7
    },
    {
      "t": "ਅਥ ਪਰਸਰਾਮ ਅਵਤਾਰ ਕਥਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਸ੍ਰੀ ਭਗਉਤੀ ਜੀ ਸਹਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਪੁਨਿ ਕੇਤਿਕ ਦਿਨ ਭਏ ਬਿਤੀਤਾ ॥",
      "s": 7
    },
    {
      "t": "ਛਤ੍ਰਨਿ ਸਕਲ ਧਰਾ ਕਹੁ ਜੀਤਾ ॥",
      "s": 7
    },
    {
      "t": "ਅਧਿਕ ਜਗਤ ਮਹਿ ਊਚ ਜਨਾਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਬਾਸਵ ਬਲਿ ਕਹੂੰ ਲੈਨ ਨ ਪਾਯੋ ॥੧॥",
      "s": 7
    },
    {
      "t": "ਬਿਆਕੁਲ ਸਕਲ ਦੇਵਤਾ ਭਏ ॥",
      "s": 7
    },
    {
      "t": "ਮਿਲਿ ਕਰਿ ਸਭੁ ਬਾਸਵ ਪੈ ਗਏ ॥",
      "s": 7
    },
    {
      "t": "ਛਤ੍ਰੀ ਰੂਪ ਧਰੇ ਸਭੁ ਅਸੁਰਨ ॥",
      "s": 7
    },
    {
      "t": "ਆਵਤ ਕਹਾ ਭੂਪ ਤੁਮਰੇ ਮਨਿ ॥੨॥",
