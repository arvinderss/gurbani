{
  "page": 174,
  "lines": [
    {
      "t": "ਸਬ ਦੇਵਨ ਮਿਲਿ ਕਰਿਯੋ ਬਿਚਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਛੀਰਸਮੁਦ੍ਰ ਕਹੁ ਚਲੇ ਸੁਧਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਕਾਲ ਪੁਰਖੁ ਕੀ ਕਰੀ ਬਡਾਈ ॥",
      "s": 7
    },
    {
      "t": "ਇਮ ਆਗਿਆ ਤਹ ਤੈ ਤਿਨਿ ਆਈ ॥੩॥",
      "s": 7
    },
    {
      "t": "ਦਿਜ ਜਮਦਗਨਿ ਜਗਤ ਮੋ ਸੋਹਤ ॥",
      "s": 7
    },
    {
      "t": "ਨਿਤ ਉਠਿ ਕਰਤ ਅਘਨ ਓਘਨ ਹਤ ॥",
      "s": 7
    },
    {
      "t": "ਤਹ ਤੁਮ ਧਰੋ ਬਿਸਨ ਅਵਤਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਹਨਹੁ ਸਕ੍ਰ ਕੇ ਸਤ੍ਰ ਸੁਧਾਰਾ ॥੪॥",
      "s": 7
    },
    {
      "t": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਜਯੋ ਜਾਮਦਗਨੰ ਦਿਜੰ ਆਵਤਾਰੀ ॥",
      "s": 7
    },
    {
      "t": "ਭਯੋ ਰੇਣੁਕਾ ਤੇ ਕਵਾਚੀ ਕੁਠਾਰੀ ॥",
      "s": 7
    },
    {
      "t": "ਧਰਿਯੋ ਛਤ੍ਰੀਯਾ ਪਾਤ ਕੋ ਕਾਲ ਰੂਪੰ ॥",
      "s": 7
    },
    {
      "t": "ਹਨ੍ਯੋ ਜਾਇ ਜਉਨੈ ਸਹੰਸਾਸਤ੍ਰ ਭੂਪੰ ॥੫॥",
      "s": 7
    },
    {
      "t": "ਕਹਾ ਗੰਮ ਏਤੀ ਕਥਾ ਸਰਬ ਭਾਖਉ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਕਥਾ ਬ੍ਰਿਧ ਤੇ ਥੋਰੀਐ ਬਾਤ ਰਾਖਉ ॥",
      "s": 7
    },
    {
      "t": "ਭਰੇ ਗਰਬ ਛਤ੍ਰੀ ਨਰੇਸੰ ਅਪਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਨੈ ਨਾਸ ਕੋ ਪਾਣਿ ਧਾਰਿਯੋ ਕੁਠਾਰੰ ॥੬॥",
      "s": 7
    },
    {
      "t": "ਹੁਤੀ ਨੰਦਨੀ ਸਿੰਧ ਜਾ ਕੀ ਸੁਪੁਤ੍ਰੀ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਸੈ ਮਾਗ ਹਾਰਿਯੋ ਸਹੰਸਾਸਤ੍ਰ ਛਤ੍ਰੀ ॥",
      "s": 7
    },
    {
      "t": "ਲੀਯੋ ਛੀਨ ਗਾਯੰ ਹਤਿਯੋ ਰਾਮ ਤਾਤੰ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਸੀ ਬੈਰ ਕੀਨੇ ਸਬੈ ਭੂਪ ਪਾਤੰ ॥੭॥",
      "s": 7
    },
    {
      "t": "ਗਈ ਬਾਲ ਤਾ ਤੇ ਲੀਯੋ ਸੋਧ ਤਾ ਕੋ ॥",
      "s": 7
    },
    {
      "t": "ਹਨਿਯੋ ਤਾਤ ਮੇਰੋ ਕਹੋ ਨਾਮੁ ਵਾ ਕੋ ॥",
      "s": 7
    },
    {
      "t": "ਸਹੰਸਾਸਤ੍ਰ ਭੂਪੰ ਸੁਣਿਯੋ ਸ੍ਰਉਣ ਨਾਮੰ ॥",
      "s": 7
    },
    {
      "t": "ਗਹੇ ਸਸਤ੍ਰ ਅਸਤ੍ਰੰ ਚਲਿਯੋ ਤਉਨ ਠਾਮੰ ॥੮॥",
      "s": 7
    },
    {
      "t": "ਕਹੋ ਰਾਜ ਮੇਰੋ ਹਨਿਯੋ ਤਾਤ ਕੈਸੇ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਅਬੈ ਜੁਧ ਜੀਤੋ ਹਨੋ ਤੋਹਿ ਤੈਸੇ ॥",
      "s": 7
    },
    {
      "t": "ਕਹਾ ਮੂੜ ਬੈਠੋ ਸੁ ਅਸਤ੍ਰੰ ਸੰਭਾਰੋ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਚਲੋ ਭਾਜ ਨਾ ਤੋ ਸਬੈ ਸਸਤ੍ਰ ਡਾਰੋ ॥੯॥",
      "s": 7
    },
    {
      "t": "ਸੁਣੇ ਬੋਲ ਬੰਕੇ ਭਰਿਯੋ ਭੂਪ ਕੋਪੰ ॥",
      "s": 7
    },
    {
      "t": "ਉਠਿਯੋ ਰਾਜ ਸਰਦੂਲ ਲੈ ਪਾਣਿ ਧੋਪੰ ॥",
      "s": 7
    },
    {
      "t": "ਹਠਿਯੋ ਖੇਤਿ ਖੂਨੀ ਦਿਜੰ ਖੇਤ੍ਰ ਹਾਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਚਹੇ ਆਜ ਹੀ ਜੁਧ ਮੋ ਸੋ ਮਚਾਯੋ ॥੧੦॥",
      "s": 7
    },
    {
      "t": "ਧਏ ਸੂਰ ਸਰਬੰ ਸੁਨੇ ਬੈਨ ਰਾਜੰ ॥",
      "s": 7
    },
    {
      "t": "ਚੜਿਯੋ ਕ੍ਰੁਧ ਜੁਧੰ ਸ੍ਰਜੇ ਸਰਬ ਸਾਜੰ ॥",
      "s": 7
    },
    {
      "t": "ਗਦਾ ਸੈਹਥੀ ਸੂਲ ਸੇਲੰ ਸੰਭਾਰੀ ॥",
      "s": 7
    },
    {
      "t": "ਚਲੇ ਜੁਧ ਕਾਜੰ ਬਡੇ ਛਤ੍ਰਧਾਰੀ ॥੧੧॥",
      "s": 7
    },
    {
      "t": "ਨਰਾਜ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਕ੍ਰਿਪਾਣ ਪਾਣ ਧਾਰਿ ਕੈ ॥",
      "s": 7
    },
    {
      "t": "ਚਲੇ ਬਲੀ ਪੁਕਾਰਿ ਕੈ ॥",
      "s": 7
    },
    {
      "t": "ਸੁ ਮਾਰਿ ਮਾਰਿ ਭਾਖਹੀ ॥",
      "s": 7
    },
    {
      "t": "ਸਰੋਘ ਸ੍ਰੋਣ ਚਾਖਹੀ ॥੧੨॥",
      "s": 7
    },
    {
      "t": "ਸੰਜੋਇ ਸੈਹਥੀਨ ਲੈ ॥",
      "s": 7
    },
    {
      "t": "ਚੜੇ ਸੁ ਬੀਰ ਰੋਸ ਕੈ ॥",
      "s": 7
    },
    {
      "t": "ਚਟਾਕ ਚਾਬਕੰ ਉਠੇ ॥",
      "s": 7
    },
    {
      "t": "ਸਹੰਸ੍ਰ ਸਾਇਕੰ ਬੁਠੈ ॥੧੩॥",
      "s": 7
    },
    {
      "t": "ਰਸਾਵਲ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਭਏ ਏਕ ਠਉਰੇ ॥",
      "s": 7
    }
  ]
}
