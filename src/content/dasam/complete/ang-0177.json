{
  "page": 177,
  "lines": [
    {
      "t": "ਚਲਿਯੋ ਰੋਸ ਸ੍ਰੀ ਰਾਮ ਲੀਨੇ ਕੁਠਾਰੰ ॥੩੧॥",
      "s": 7
    },
    {
      "t": "ਸੁਨ੍ਯੋ ਸਰਬ ਭੂਪੰ ਹਠੀ ਰਾਮ ਆਏ ॥",
      "s": 7
    },
    {
      "t": "ਸਭੰ ਜੁਧੁ ਕੋ ਸਸਤ੍ਰ ਅਸਤ੍ਰੰ ਬਨਾਏ ॥",
      "s": 7
    },
    {
      "t": "ਚੜੇ ਚਉਪ ਕੈ ਕੈ ਕੀਏ ਜੁਧ ਐਸੇ ॥",
      "s": 7
    },
    {
      "t": "ਮਨੋ ਰਾਮ ਸੋ ਰਾਵਣੰ ਲੰਕ ਜੈਸੇ ॥੩੨॥",
      "s": 7
    },
    {
      "t": "ਲਗੇ ਸਸਤ੍ਰੰ ਅਸਤ੍ਰੰ ਲਖੇ ਰਾਮ ਅੰਗੰ ॥",
      "s": 7
    },
    {
      "t": "ਗਹੇ ਬਾਣ ਪਾਣੰ ਕੀਏ ਸਤ੍ਰ ਭੰਗੰ ॥",
      "s": 7
    },
    {
      "t": "ਭੁਜਾ ਹੀਣ ਏਕੰ ਸਿਰੰ ਹੀਣ ਕੇਤੇ ॥",
      "s": 7
    },
    {
      "t": "ਸਬੈ ਮਾਰ ਡਾਰੇ ਗਏ ਬੀਰ ਜੇਤੇ ॥੩੩॥",
      "s": 7
    },
    {
      "t": "ਕਰੀ ਛਤ੍ਰਹੀਣ ਛਿਤੰ ਕੀਸ ਬਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਹਣੇ ਐਸ ਹੀ ਭੂਪ ਸਰਬੰ ਸੁਧਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਕਥਾ ਸਰਬ ਜਉ ਛੋਰ ਤੇ ਲੈ ਸੁਨਾਉ ॥",
      "s": 7
    },
    {
      "t": "ਹ੍ਰਿਦੈ ਗ੍ਰੰਥ ਕੇ ਬਾਢਬੇ ਤੇ ਡਰਾਉ ॥੩੪॥",
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਕਰਿ ਜਗ ਮੋ ਇਹ ਭਾਤਿ ਅਖਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਨਵਮ ਵਤਾਰ ਬਿਸਨ ਇਮ ਧਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਅਬ ਬਰਨੋ ਦਸਮੋ ਅਵਤਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਸੰਤ ਜਨਾ ਕਾ ਪ੍ਰਾਨ ਅਧਾਰਾ ॥੩੫॥",
      "s": 7
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕੇ ਨਵਮੋ ਅਵਤਾਰ ਪਰਸਰਾਮ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੯॥",
      "s": 7
    },
    {
      "t": "ਅਥ ਬ੍ਰਹਮਾ ਅਵਤਾਰ ਕਥਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਸ੍ਰੀ ਭਗਉਤੀ ਜੀ ਸਹਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਅਬ ਉਚਰੋ ਮੈ ਕਥਾ ਚਿਰਾਨੀ ॥",
      "s": 7
    },
    {
      "t": "ਜਿਮ ਉਪਜ੍ਯੋ ਬ੍ਰਹਮਾ ਸੁਰ ਗਿਆਨੀ ॥",
      "s": 7
    },
    {
      "t": "ਚਤੁਰਾਨਨ ਅਘ ਓਘਨ ਹਰਤਾ ॥",
      "s": 7
    },
    {
      "t": "ਉਪਜ੍ਯੋ ਸਕਲ ਸ੍ਰਿਸਟਿ ਕੋ ਕਰਤਾ ॥੧॥",
      "s": 7
    },
    {
      "t": "ਜਬ ਜਬ ਬੇਦ ਨਾਸ ਹੋਇ ਜਾਹੀ ॥",
      "s": 7
    },
    {
      "t": "ਤਬ ਤਬ ਪੁਨਿ ਬ੍ਰਹਮਾ ਪ੍ਰਗਟਾਹੀ ॥",
      "s": 7
    },
    {
      "t": "ਤਾ ਤੇ ਬਿਸਨ ਬ੍ਰਹਮ ਬਪੁ ਧਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਚਤੁਰਾਨਨ ਕਰ ਜਗਤ ਉਚਰਾ ॥੨॥",
      "s": 7
    },
    {
      "t": "ਜਬ ਹੀ ਬਿਸਨ ਬ੍ਰਹਮ ਬਪੁ ਧਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਤਬ ਸਬ ਬੇਦ ਪ੍ਰਚੁਰ ਜਗਿ ਕਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਸਾਸਤ੍ਰ ਸਿੰਮ੍ਰਿਤ ਸਕਲ ਬਨਾਏ ॥",
      "s": 7
    },
    {
      "t": "ਜੀਵ ਜਗਤ ਕੇ ਪੰਥਿ ਲਗਾਏ ॥੩॥",
      "s": 7
    },
    {
      "t": "ਜੇ ਜੇ ਹੁਤੇ ਅਘਨ ਕੇ ਕਰਤਾ ॥",
      "s": 7
    },
    {
      "t": "ਤੇ ਤੇ ਭਏ ਪਾਪ ਤੇ ਹਰਤਾ ॥",
      "s": 7
    },
    {
      "t": "ਪਾਪ ਕਰਮੁ ਕਹ ਪ੍ਰਗਟਿ ਦਿਖਾਏ ॥",
      "s": 7
    },
    {
      "t": "ਧਰਮ ਕਰਮ ਸਬ ਜੀਵ ਚਲਾਏ ॥੪॥",
      "s": 7
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਭਯੋ ਬ੍ਰਹਮ ਅਵਤਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਸਬ ਪਾਪਨ ਕੋ ਮੇਟਨਹਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਪ੍ਰਜਾ ਲੋਕੁ ਸਬ ਪੰਥ ਚਲਾਏ ॥",
      "s": 7
    },
    {
      "t": "ਪਾਪ ਕਰਮ ਤੇ ਸਬੈ ਹਟਾਏ ॥੫॥",
      "s": 7
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਪ੍ਰਜਾ ਪਵਿਤ੍ਰ ਕਰ ਧਰਿਯੋ ਬ੍ਰਹਮ ਅਵਤਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਧਰਮ ਕਰਮ ਲਾਗੇ ਸਬੈ ਪਾਪ ਕਰਮ ਕਹ ਡਾਰਿ ॥੬॥",
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਦਸਮ ਅਵਤਾਰ ਬਿਸਨ ਕੋ ਬ੍ਰਹਮਾ ॥",
      "s": 7
    },
    {
      "t": "ਧਰਿਯੋ ਜਗਤਿ ਭੀਤਰਿ ਸੁਭ ਕਰਮਾ ॥",
      "s": 7
    }
  ]
}
