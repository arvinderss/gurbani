{
  "page": 182,
  "lines": [
    {
      "t": "ਤਬ ਕੋਪ ਕਰੰ ਸਿਵ ਸੂਲ ਲੀਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਅਰਿ ਕੋ ਸਿਰੁ ਕਾਟਿ ਦੁਖੰਡ ਕੀਯੋ ॥੩੯॥",
      "s": 7
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕੇ ਪਿਨਾਕਿ ਪ੍ਰਬੰਧਹਿ ਅੰਧਕ ਬਧਹਿ ਰੁਦ੍ਰੋਸਤਤਿ ਧਯਾਇ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੦॥",
      "s": 7
    },
    {
      "t": "ਅਥ ਗਉਰ ਬਧਹ ਕਥਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਸ੍ਰੀ ਭਗਉਤੀ ਜੀ ਸਹਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਤੋਟਕ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਸੁਰ ਰਾਜ ਪ੍ਰਸੰਨਿ ਭਏ ਤਬ ਹੀ ॥",
      "s": 7
    },
    {
      "t": "ਅਰਿ ਅੰਧਕ ਨਾਸ ਸੁਨਿਯੋ ਜਬ ਹੀ ॥",
      "s": 7
    },
    {
      "t": "ਇਮ ਕੈ ਦਿਨ ਕੇਤਕ ਬੀਤ ਗਏ ॥",
      "s": 7
    },
    {
      "t": "ਸਿਵ ਧਾਮਿ ਸਤਕ੍ਰਿਤ ਜਾਤ ਭਏ ॥੧॥",
      "s": 7
    },
    {
      "t": "ਤਬ ਰੁਦ੍ਰ ਭਯਾਨਕ ਰੂਪ ਧਰਿਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਹਰਿ ਹੇਰਿ ਹਰੰ ਹਥਿਯਾਰ ਹਰਿਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਤਬ ਹੀ ਸਿਵ ਕੋਪ ਅਖੰਡ ਕੀਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਇਕ ਜਨਮ ਅੰਗਾਰ ਅਪਾਰ ਲੀਯੋ ॥੨॥",
      "s": 7
    },
    {
      "t": "ਤਿਹ ਤੇਜ ਜਰੇ ਜਗ ਜੀਵ ਸਬੈ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਹ ਡਾਰ ਦਯੋ ਮਧਿ ਸਿੰਧੁ ਤਬੈ ॥",
      "s": 7
    },
    {
      "t": "ਸੋਊ ਡਾਰ ਦਯੋ ਸਿੰਧੁ ਮਹਿ ਨ ਗਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਹ ਆਨਿ ਜਲੰਧਰ ਰੂਪ ਲਯੋ ॥੩॥",
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਭਯੋ ਅਸੁਰ ਬਲਵਾਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਲਯੋ ਕੁਬੇਰ ਕੋ ਲੂਟ ਖਜਾਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਪਕਰ ਸਮਸ ਤੇ ਬ੍ਰਹਮੁ ਰੁਵਾਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਇੰਦ੍ਰ ਜੀਤਿ ਸਿਰ ਛਤ੍ਰ ਢੁਰਾਯੋ ॥੪॥",
      "s": 7
    },
    {
      "t": "ਜੀਤਿ ਦੇਵਤਾ ਪਾਇ ਲਗਾਏ ॥",
      "s": 7
    },
    {
      "t": "ਰੁਦ੍ਰ ਬਿਸਨੁ ਨਿਜ ਪੁਰੀ ਬਸਾਏ ॥",
      "s": 7
    },
    {
      "t": "ਚਉਦਹ ਰਤਨ ਆਨਿ ਰਾਖੇ ਗ੍ਰਿਹ ॥",
      "s": 7
    },
    {
      "t": "ਜਹਾ ਤਹਾ ਬੈਠਾਏ ਨਵ ਗ੍ਰਹ ॥੫॥",
      "s": 7
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਜੀਤਿ ਬਸਾਏ ਨਿਜ ਪੁਰੀ ਅਸੁਰ ਸਕਲ ਅਸੁਰਾਰ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਪੂਜਾ ਕਰੀ ਮਹੇਸ ਕੀ ਗਿਰਿ ਕੈਲਾਸ ਮਧਾਰ ॥੬॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਧ੍ਰਯਾਨ ਬਿਧਾਨ ਕਰੇ ਬਹੁ ਭਾਤਾ ॥",
      "s": 7
    },
    {
      "t": "ਸੇਵਾ ਕਰੀ ਅਧਿਕ ਦਿਨ ਰਾਤਾ ॥",
      "s": 7
    },
    {
      "t": "ਐਸ ਭਾਤਿ ਤਿਹ ਕਾਲ ਬਿਤਾਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਅਬ ਪ੍ਰਸੰਗਿ ਸਿਵ ਊਪਰ ਆਯੋ ॥੭॥",
      "s": 7
    },
    {
      "t": "ਭੂਤਰਾਟ ਕੋ ਨਿਰਖਿ ਅਤੁਲ ਬਲ ॥",
      "s": 7
    },
    {
      "t": "ਕਾਪਤ ਭਏ ਅਨਿਕ ਅਰਿ ਜਲ ਥਲ ॥",
      "s": 7
    },
    {
      "t": "ਦਛ ਪ੍ਰਜਾਪਤਿ ਹੋਤ ਨ੍ਰਿਪਤ ਬਰ ॥",
      "s": 7
    },
    {
      "t": "ਦਸ ਸਹੰਸ੍ਰ ਦੁਹਿਤਾ ਤਾ ਕੇ ਘਰ ॥੮॥",
      "s": 7
    },
    {
      "t": "ਤਿਨ ਇਕ ਬਾਰ ਸੁਯੰਬਰ ਕੀਯਾ ॥",
      "s": 7
    },
    {
      "t": "ਦਸ ਸਹੰਸ੍ਰ ਦੁਹਿਤਾਇਸ ਦੀਯਾ ॥",
      "s": 7
    },
    {
      "t": "ਜੋ ਬਰੁ ਰੁਚੇ ਬਰਹੁ ਅਬ ਸੋਈ ॥",
      "s": 7
    },
    {
      "t": "ਊਚ ਨੀਚ ਰਾਜਾ ਹੋਇ ਕੋਈ ॥੯॥",
      "s": 7
    },
    {
      "t": "ਜੋ ਜੋ ਜਿਸੈ ਰੁਚਾ ਤਿਨਿ ਬਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਸਬ ਪ੍ਰਸੰਗ ਨਹੀ ਜਾਤ ਉਚਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਜੋ ਬਿਰਤਾਤ ਕਹਿ ਛੋਰਿ ਸੁਨਾਊ ॥",
      "s": 7
    },
    {
      "t": "ਕਥਾ ਬ੍ਰਿਧਿ ਤੇ ਅਧਿਕ ਡਰਾਊ ॥੧੦॥",
      "s": 7
    },
    {
      "t": "ਚਾਰ ਸੁਤਾ ਕਸਪ ਕਹ ਦੀਨੀ ॥",
      "s": 7
    }
  ]
}
