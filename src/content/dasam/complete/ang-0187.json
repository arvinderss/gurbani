{
  "page": 187,
  "lines": [
    {
      "t": "ਕਰਿਯੋ ਕੋਪ ਕੈ ਜੁਧ ਭਾਤੰ ਅਨੇਕੰ ॥੪੫॥",
      "s": 7
    },
    {
      "t": "ਗਿਰਿਯੋ ਜਾਨੁ ਕੂਟਸਥਲੀ ਬ੍ਰਿਛ ਮੂਲੰ ॥",
      "s": 7
    },
    {
      "t": "ਗਿਰਿਯੋ ਦਛ ਤੈਸੇ ਕਟਿਯੋ ਸੀਸ ਸੂਲੰ ॥",
      "s": 7
    },
    {
      "t": "ਪਰਿਯੋ ਰਾਜ ਰਾਜੰ ਭਯੋ ਦੇਹ ਘਾਤੰ ॥",
      "s": 7
    },
    {
      "t": "ਹਨਿਯੋ ਜਾਨ ਬਜ੍ਰੰ ਭਯੋ ਪਬ ਪਾਤੰ ॥੪੬॥",
      "s": 7
    },
    {
      "t": "ਗਯੋ ਗਰਬ ਸਰਬੰ ਭਜੋ ਸੂਰਬੀਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਚਲਿਯੋ ਭਾਜ ਅੰਤਹਪੁਰ ਹੁਐ ਅਧੀਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਗਰੇ ਡਾਰ ਅੰਚਰ ਪਰੈ ਰੁਦ੍ਰ ਪਾਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਅਹੋ ਰੁਦ੍ਰ ਕੀਜੈ ਕ੍ਰਿਪਾ ਕੈ ਸਹਾਯੰ ॥੪੭॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਹਮ ਤੁਮਰੋ ਹਰਿ ਓਜ ਨ ਜਾਨਾ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਤੁਮ ਹੋ ਮਹਾ ਤਪੀ ਬਲਵਾਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਸੁਨਤ ਬਚਨ ਭਏ ਰੁਦ੍ਰ ਕ੍ਰਿਪਾਲਾ ॥",
      "s": 7
    },
    {
      "t": "ਅਜਾ ਸੀਸ ਨ੍ਰਿਪ ਜੋਰਿ ਉਤਾਲਾ ॥੪੮॥",
      "s": 7
    },
    {
      "t": "ਰੁਦ੍ਰ ਕਾਲ ਕੋ ਧਰਾ ਧਿਆਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਬਹੁਰਿ ਜੀਯਾਇ ਨਰੇਸ ਉਠਾਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਰਾਜ ਸੁਤਾ ਪਤਿ ਸਕਲ ਜੀਯਾਏ ॥",
      "s": 7
    },
    {
      "t": "ਕਉਤਕ ਨਿਰਖਿ ਸੰਤ ਤ੍ਰਿਪਤਾਏ ॥੪੯॥",
      "s": 7
    },
    {
      "t": "ਨਾਰਿ ਹੀਨ ਸਿਵ ਕਾਮ ਖਿਝਾਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਤਾ ਤੇ ਸੁੰਭ ਘਨੋ ਦੁਖੁ ਪਾਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਅਧਿਕ ਕੋਪ ਕੈ ਕਾਮ ਜਰਾਯਸ ॥",
      "s": 7
    },
    {
      "t": "ਬਿਤਨ ਨਾਮ ਤਿਹ ਤਦਿਨ ਕਹਾਯਸ ॥੫੦॥",
      "s": 7
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਰੁਦ੍ਰ ਪ੍ਰਬੰਧ ਦਛ ਬਧਹੀ ਰੁਦ੍ਰ ਮਹਾਤਮੇ ਗਉਰ ਬਧਹ ਗਿਆਰਵੋ ਅਵਤਾਰ ਸੰਪੂਰਣਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੧॥",
      "s": 7
    },
    {
      "t": "ਅਥ ਜਲੰਧਰ ਅਵਤਾਰ ਕਥਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਸ੍ਰੀ ਭਗਉਤੀ ਜੀ ਸਹਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਵਹੁ ਜੋ ਜਰੀ ਰੁਦ੍ਰ ਕੀ ਦਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਨਿ ਹਿਮ ਗਿਰਿ ਗ੍ਰਿਹਿ ਲਿਯ ਅਵਤਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਛੁਟੀ ਬਾਲਤਾ ਜਬ ਸੁਧਿ ਆਈ ॥",
      "s": 7
    },
    {
      "t": "ਬਹੁਰੋ ਮਿਲੀ ਨਾਥ ਕਹੁ ਜਾਈ ॥੧॥",
      "s": 7
    },
    {
      "t": "ਜਿਹ ਬਿਧਿ ਮਿਲੀ ਰਾਮ ਸੋ ਸੀਤਾ ॥",
      "s": 7
    },
    {
      "t": "ਜੈਸਕ ਚਤੁਰ ਬੇਦ ਤਨ ਗੀਤਾ ॥",
      "s": 7
    },
    {
      "t": "ਜੈਸੇ ਮਿਲਤ ਸਿੰਧ ਤਨ ਗੰਗਾ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਯੋ ਮਿਲਿ ਗਈ ਰੁਦ੍ਰ ਕੈ ਸੰਗਾ ॥੨॥",
      "s": 7
    },
    {
      "t": "ਜਬ ਤਿਹ ਬ੍ਯਾਹਿ ਰੁਦ੍ਰ ਘਰਿ ਆਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਨਿਰਖਿ ਜਲੰਧਰ ਤਾਹਿ ਲੁਭਾਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਦੂਤ ਏਕ ਤਹ ਦੀਯ ਪਠਾਈ ॥",
      "s": 7
    },
    {
      "t": "ਲਿਆਉ ਰੁਦ੍ਰ ਤੇ ਨਾਰਿ ਛਿਨਾਈ ॥੩॥",
      "s": 7
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਜਲੰਧੁਰ ਬਾਚ ॥",
      "s": 7
    },
    {
      "t": "ਕੈ ਸਿਵ ਨਾਰਿ ਸੀਗਾਰ ਕੈ ਮਮ ਗ੍ਰਿਹ ਦੇਹ ਪਠਾਇ ॥",
      "v": [
        [
          1,
          1
        ],
        [
          4,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਨਾਤਰ ਸੂਲ ਸੰਭਾਰ ਕੇ ਸੰਗਿ ਲਰਹੁ ਮੁਰਿ ਆਇ ॥੪॥",
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਕਥਾ ਭਈ ਇਹ ਦਿਸ ਇਹ ਭਾਤਾ ॥",
      "s": 7
    },
    {
      "t": "ਅਬ ਕਹੋ ਬਿਸਨ ਤ੍ਰੀਯਾ ਕੀ ਬਾਤਾ ॥",
      "s": 7
    },
    {
      "t": "ਬ੍ਰਿੰਦਾਰਿਕ ਦਿਨ ਏਕ ਪਕਾਏ ॥",
      "s": 7
    },
    {
      "t": "ਦੈਤ ਸਭਾ ਤੇ ਬਿਸਨੁ ਬੁਲਾਏ ॥੫॥",
      "s": 7
    },
    {
      "t": "ਆਇ ਗਯੋ ਤਹ ਨਾਰਦ ਰਿਖਿ ਬਰ ॥",
      "s": 7
    }
  ]
}
