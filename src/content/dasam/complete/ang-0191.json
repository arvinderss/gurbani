{
  "page": 191,
  "lines": [
    {
      "t": "ਅਥ ਮਧੁ ਕੈਟਬ ਬਧਨ ਕਥਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਸ੍ਰੀ ਭਗਉਤੀ ਜੀ ਸਹਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਕਾਲ ਪੁਰਖ ਕੀ ਦੇਹਿ ਮੋ ਕੋਟਿਕ ਬਿਸਨ ਮਹੇਸ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਕੋਟਿ ਇੰਦ੍ਰ ਬ੍ਰਹਮਾ ਕਿਤੇ ਰਵਿ ਸਸਿ ਕ੍ਰੋਰਿ ਜਲੇਸ ॥੧॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਸ੍ਰਮਿਤ ਬਿਸਨੁ ਤਹ ਰਹਤ ਸਮਾਈ ॥",
      "s": 7
    },
    {
      "t": "ਸਿੰਧੁ ਬਿੰਧੁ ਜਹ ਗਨਿਯੋ ਨ ਜਾਈ ॥",
      "s": 7
    },
    {
      "t": "ਸੇਸਨਾਗਿ ਸੇ ਕੋਟਿਕ ਤਹਾ ॥",
      "s": 7
    },
    {
      "t": "ਸੋਵਤ ਸੈਨ ਸਰਪ ਕੀ ਜਹਾ ॥੨॥",
      "s": 7
    },
    {
      "t": "ਸਹੰਸ੍ਰ ਸੀਸ ਤਬ ਧਰ ਤਨ ਜੰਗਾ ॥",
      "s": 7
    },
    {
      "t": "ਸਹੰਸ੍ਰ ਪਾਵ ਕਰ ਸਹੰਸ ਅਭੰਗਾ ॥",
      "s": 7
    },
    {
      "t": "ਸਹੰਸਰਾਛ ਸੋਭਤ ਹੈ ਤਾ ਕੇ ॥",
      "s": 7
    },
    {
      "t": "ਲਛਮੀ ਪਾਵ ਪਲੋਸਤ ਵਾ ਕੇ ॥੩॥",
      "s": 7
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਮਧੁ ਕੀਟਭ ਕੇ ਬਧ ਨਮਿਤ ਜਾ ਦਿਨ ਜਗਤ ਮੁਰਾਰਿ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਸੁ ਕਬਿ ਸ੍ਯਾਮ ਤਾ ਕੋ ਕਹੈ ਚੌਦਸਵੋ ਅਵਤਾਰ ॥੪॥",
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਸ੍ਰਵਣ ਮੈਲ ਤੇ ਅਸੁਰ ਪ੍ਰਕਾਸਤ ॥",
      "s": 7
    },
    {
      "t": "ਚੰਦ ਸੂਰ ਜਨੁ ਦੁਤੀਯ ਪ੍ਰਭਾਸਤ ॥",
      "s": 7
    },
    {
      "t": "ਮਾਯਾ ਤਜਤ ਬਿਸਨੁ ਕਹੁ ਤਬ ਹੀ ॥",
      "s": 7
    },
    {
      "t": "ਕਰਤ ਉਪਾਧਿ ਅਸੁਰ ਮਿਲਿ ਜਬ ਹੀ ॥੫॥",
      "s": 7
    },
    {
      "t": "ਤਿਨ ਸੋ ਕਰਤ ਬਿਸਨੁ ਘਮਸਾਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਬਰਖ ਹਜਾਰ ਪੰਚ ਪਰਮਾਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਕਾਲ ਪੁਰਖ ਤਬ ਹੋਤ ਸਹਾਈ ॥",
      "s": 7
    },
    {
      "t": "ਦੁਹੂੰਅਨਿ ਹਨਤ ਕ੍ਰੋਧ ਉਪਜਾਈ ॥੬॥",
      "s": 7
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਧਾਰਤ ਹੈ ਐਸੋ ਬਿਸਨੁ ਚੌਦਸਵੋ ਅਵਤਾਰ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਸੰਤ ਸੰਬੂਹਨਿ ਸੁਖ ਨਮਿਤ ਦਾਨਵ ਦੁਹੂੰ ਸੰਘਾਰ ॥੭॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਮਧੁ ਕੈਟਭ ਬਧਹ ਚਤਰਦਸਵੋ ਅਵਤਾਰ ਬਿਸਨੁ ਸਮਾਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੪॥",
      "s": 7
    },
    {
      "t": "ਅਥ ਅਰਿਹੰਤ ਦੇਵ ਅਵਤਾਰ ਕਥਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਸ੍ਰੀ ਭਗਉਤੀ ਜੀ ਸਹਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਜਬ ਜਬ ਦਾਨਵ ਕਰਤ ਪਾਸਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਤਬ ਤਬ ਬਿਸਨੁ ਕਰਤ ਸੰਘਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਸਕਲ ਅਸੁਰ ਇਕਠੇ ਤਹਾ ਭਏ ॥",
      "s": 7
    },
    {
      "t": "ਸੁਰ ਅਰਿ ਗੁਰੁ ਮੰਦਰਿ ਚਲਿ ਗਏ ॥੧॥",
      "s": 7
    },
    {
      "t": "ਸਬਹੂੰ ਮਿਲਿ ਅਸ ਕਰਿਯੋ ਬਿਚਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਦਈਤਨ ਕਰਤ ਘਾਤ ਅਸੁਰਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਤਾ ਤੇ ਐਸ ਕਰੌ ਕਿਛੁ ਘਾਤਾ ॥",
      "s": 7
    },
    {
      "t": "ਜਾ ਤੇ ਬਨੇ ਹਮਾਰੀ ਬਾਤਾ ॥੨॥",
      "s": 7
    },
    {
      "t": "ਦਈਤ ਗੁਰੂ ਇਮ ਬਚਨ ਬਖਾਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਤੁਮ ਦਾਨਵੋ ਨ ਭੇਦ ਪਛਾਨਾ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਵੇ ਮਿਲਿ ਜਗ ਕਰਤ ਬਹੁ ਭਾਤਾ ॥",
      "s": 7
    },
    {
      "t": "ਕੁਸਲ ਹੋਤ ਤਾ ਤੇ ਦਿਨ ਰਾਤਾ ॥੩॥",
      "s": 7
    },
    {
      "t": "ਤੁਮ ਹੂੰ ਕਰੋ ਜਗ ਆਰੰਭਨ ॥",
      "s": 7
    },
    {
      "t": "ਬਿਜੈ ਹੋਇ ਤੁਮਰੀ ਤਾ ਤੇ ਰਣ ॥",
      "s": 7
    },
    {
      "t": "ਜਗ ਅਰੰਭ੍ਯ ਦਾਨਵਨ ਕਰਾ ॥",
      "s": 7
    }
  ]
