{
  "page": 198,
  "lines": [
    {
      "t": "ਜਿਮ ਕਉਾਂਧਿਤ ਸਾਵਣ ਬਿਜੁ ਘਣੰ ॥੨੬॥",
      "s": 7
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਕਥਾ ਬ੍ਰਿਧ ਤੇ ਮੈ ਡਰੋ ਕਹਾ ਕਰੋ ਬਖਯਾਨ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਨਿਸਾਹੰਤ ਅਸੁਰੇਸ ਸੋ ਸਰ ਤੇ ਭਯੋ ਨਿਦਾਨ ॥੨੭॥",
      "v": [
        [
          2,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕੇ ਸੂਰਜ ਅਵਤਾਰ ਅਸਟ ਦਸਮੋ ਅਵਤਾਰ ਸਮਾਪਤ ॥੧੮॥",
      "s": 7
    },
    {
      "t": "ਅਥ ਚੰਦ੍ਰ ਅਵਤਾਰ ਕਥਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਸ੍ਰੀ ਭਗਉਤੀ ਜੀ ਸਹਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਦੋਧਕ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਫੇਰਿ ਗਨੋ ਨਿਸਰਾਜ ਬਿਚਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਜੈਸ ਧਰਯੋ ਅਵਤਾਰ ਮੁਰਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਬਾਤ ਪੁਰਾਤਨ ਭਾਖ ਸੁਨਾਊਾਂ ॥",
      "s": 7
    },
    {
      "t": "ਜਾ ਤੇ ਕਬ ਕੁਲ ਸਰਬ ਰਿਝਾਊਾਂ ॥੧॥",
      "s": 7
    },
    {
      "t": "ਦੋਧਕ ॥",
      "s": 7
    },
    {
      "t": "ਨੈਕ ਕ੍ਰਿਸਾ ਕਹੁ ਠਉਰ ਨ ਹੋਈ ॥",
      "s": 7
    },
    {
      "t": "ਭੂਖਨ ਲੋਗ ਮਰੈ ਸਭ ਕੋਈ ॥",
      "s": 7
    },
    {
      "t": "ਅੰਧਿ ਨਿਸਾ ਦਿਨ ਭਾਨੁ ਜਰਾਵੈ ॥",
      "s": 7
    },
    {
      "t": "ਤਾ ਤੇ ਕ੍ਰਿਸ ਕਹੂੰ ਹੋਨ ਨ ਪਾਵੈ ॥੨॥",
      "s": 7
    },
    {
      "t": "ਲੋਗ ਸਭੈ ਇਹ ਤੇ ਅਕੁਲਾਨੇ ॥",
      "s": 7
    },
    {
      "t": "ਭਾਜਿ ਚਲੇ ਜਿਮ ਪਾਤ ਪੁਰਾਨੇ ॥",
      "s": 7
    },
    {
      "t": "ਭਾਤ ਹੀ ਭਾਤ ਕਰੇ ਹਰਿ ਸੇਵਾ ॥",
      "s": 7
    },
    {
      "t": "ਤਾ ਤੇ ਪ੍ਰਸੰਨ ਭਏ ਗੁਰਦੇਵਾ ॥੩॥",
      "s": 7
    },
    {
      "t": "ਨਾਰਿ ਨ ਸੇਵ ਕਰੈਂ ਨਿਜ ਨਾਥੰ ॥",
      "s": 7
    },
    {
      "t": "ਲੀਨੇ ਹੀ ਰੋਸੁ ਫਿਰੈਂ ਜੀਅ ਸਾਥੰ ॥",
      "s": 7
    },
    {
      "t": "ਕਾਮਨਿ ਕਾਮੁ ਕਹੂੰ ਨ ਸੰਤਾਵੈ ॥",
      "s": 7
    },
    {
      "t": "ਕਾਮ ਬਿਨਾ ਕੋਊ ਕਾਮੁ ਨ ਭਾਵੈ ॥੪॥",
      "s": 7
    },
    {
      "t": "ਤੋਮਰ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਪੂਜੇ ਨ ਕੋ ਤ੍ਰੀਯਾ ਨਾਥ ॥",
      "s": 7
    },
    {
      "t": "ਐਂਠੀ ਫਿਰੈ ਜੀਅ ਸਾਥ ॥",
      "s": 7
    },
    {
      "t": "ਦੁਖੁ ਵੈ ਨ ਤਿਨ ਕਹੁ ਕਾਮ ॥",
      "s": 7
    },
    {
      "t": "ਤਾ ਤੇ ਨ ਬਿਨਵਤ ਬਾਮ ॥੫॥",
      "s": 7
    },
    {
      "t": "ਕਰ ਹੈ ਨ ਪਤਿ ਕੀ ਸੇਵ ॥",
      "s": 7
    },
    {
      "t": "ਪੂਜੈ ਨ ਗੁਰ ਗੁਰਦੇਵ ॥",
      "s": 7
    },
    {
      "t": "ਧਰ ਹੈਂ ਨ ਹਰਿ ਕੋ ਧਯਾਨ ॥",
      "s": 7
    },
    {
      "t": "ਕਰਿ ਹੈਂ ਨ ਨਿਤ ਇਸਨਾਨ ॥੬॥",
      "s": 7
    },
    {
      "t": "ਤਬ ਕਾਲ ਪੁਰਖ ਬੁਲਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਬਿਸਨੈ ਕਹਯੋ ਸਮਝਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਸਸਿ ਕੋ ਧਰਿਹੁ ਅਵਤਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਨਹੀ ਆਨ ਬਾਤ ਬਿਚਾਰ ॥੭॥",
      "s": 7
    },
    {
      "t": "ਤਬ ਬਿਸਨ ਸੀਸ ਨਿਵਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਕਰਿ ਜੋਰਿ ਕਹੀ ਬਨਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਧਰਿਹੋਂ ਦਿਨਾਤ ਵਤਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਜਿਤ ਹੋਇ ਜਗਤ ਕੁਮਾਰ ॥੮॥",
      "s": 7
    },
    {
      "t": "ਤਬ ਮਹਾ ਤੇਜ ਮੁਰਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਧਰਿਯੋ ਸੁ ਚੰਦ੍ਰ ਅਵਤਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਤਨ ਕੈ ਮਦਨ ਕੋ ਬਾਨ ॥",
      "s": 7
    },
    {
      "t": "ਮਾਰਿਯੋ ਤ੍ਰੀਯਨ ਕਹ ਤਾਨ ॥੯॥",
      "s": 7
    },
    {
      "t": "ਤਾ ਤੇ ਭਈ ਤ੍ਰੀਯ ਦੀਨ ॥",
      "s": 7
    },
    {
      "t": "ਸਭ ਗਰਬ ਹੁਐ ਗਯੋ ਛੀਨ ॥",
      "s": 7
    }
  ]
}
