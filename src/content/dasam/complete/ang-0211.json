{
  "page": 211,
  "lines": [
    {
      "t": "ਕੁਵੰਡਾਨ ਡਾਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਨਰੇਸੋ ਦਿਖਾਰੇ ॥੧੦੯॥",
      "s": 7
    },
    {
      "t": "ਲਯੋ ਰਾਮ ਪਾਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਭਰਯੋ ਬੀਰ ਮਾਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਹਸਯੋ ਐਚ ਲੀਨੋ ॥",
      "s": 7
    },
    {
      "t": "ਉਭੈ ਟੂਕ ਕੀਨੋ ॥੧੧੦॥",
      "s": 7
    },
    {
      "t": "ਸਭੈ ਦੇਵ ਹਰਖੇ ॥",
      "s": 7
    },
    {
      "t": "ਘਨੰ ਪੁਹਪ ਬਰਖੇ ॥",
      "s": 7
    },
    {
      "t": "ਲਜਾਨੇ ਨਰੇਸੰ ॥",
      "s": 7
    },
    {
      "t": "ਚਲੇ ਆਪ ਦੇਸੰ ॥੧੧੧॥",
      "s": 7
    },
    {
      "t": "ਤਬੈ ਰਾਜ ਕੰਨਿਆ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਹੂੰ ਲੋਕ ਧੰਨਿਆ ॥",
      "s": 7
    },
    {
      "t": "ਧਰੇ ਫੂਲ ਮਾਲਾ ॥",
      "s": 7
    },
    {
      "t": "ਬਰਿਯੋ ਰਾਮ ਬਾਲਾ ॥੧੧੨॥",
      "s": 7
    },
    {
      "t": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਕਿਧੌ ਦੇਵ ਕੰਨਿਆ ਕਿਧੌ ਬਾਸਵੀ ਹੈ ॥",
      "s": 7
    },
    {
      "t": "ਕਿਧੌ ਜਛਨੀ ਕਿੰਨ੍ਰਨੀ ਨਾਗਨੀ ਹੈ ॥",
      "s": 7
    },
    {
      "t": "ਕਿਧੌ ਗੰਧ੍ਰਬੀ ਦੈਤ ਜਾ ਦੇਵਤਾ ਸੀ ॥",
      "s": 7
    },
    {
      "t": "ਕਿਧੌ ਸੂਰਜਾ ਸੁਧ ਸੋਧੀ ਸੁਧਾ ਸੀ ॥੧੧੩॥",
      "s": 7
    },
    {
      "t": "ਕਿਧੌ ਜਛ ਬਿਦਿਆ ਧਰੀ ਗੰਧ੍ਰਬੀ ਹੈ ॥",
      "s": 7
    },
    {
      "t": "ਕਿਧੌ ਰਾਗਨੀ ਭਾਗ ਪੂਰੇ ਰਚੀ ਹੈ ॥",
      "s": 7
    },
    {
      "t": "ਕਿਧੌ ਸੁਵਰਨ ਕੀ ਚਿਤ੍ਰ ਕੀ ਪੁਤ੍ਰਕਾ ਹੈ ॥",
      "s": 7
    },
    {
      "t": "ਕਿਧੌ ਕਾਮ ਕੀ ਕਾਮਨੀ ਕੀ ਪ੍ਰਭਾ ਹੈ ॥੧੧੪॥",
      "s": 7
    },
    {
      "t": "ਕਿਧੌ ਚਿਤ੍ਰ ਕੀ ਪੁਤ੍ਰਕਾ ਸੀ ਬਨੀ ਹੈ ॥",
      "s": 7
    },
    {
      "t": "ਕਿਧੌ ਸੰਖਨੀ ਚਿਤ੍ਰਨੀ ਪਦਮਨੀ ਹੈ ॥",
      "s": 7
    },
    {
      "t": "ਕਿਧੌ ਰਾਗ ਪੂਰੇ ਭਰੀ ਰਾਗ ਮਾਲਾ ॥",
      "s": 7
    },
    {
      "t": "ਬਰੀ ਰਾਮ ਤੈਸੀ ਸੀਆ ਆਜ ਬਾਲਾ ॥੧੧੫॥",
      "s": 7
    },
    {
      "t": "ਛਕੇ ਪ੍ਰੇਮ ਦੋਨੋ ਲਗੇ ਨੈਨ ਐਸੇ ॥",
      "s": 7
    },
    {
      "t": "ਮਨੋ ਫਾਧ ਫਾਧੈ ਮ੍ਰਿਗੀਰਾਜ ਜੈਸੇ ॥",
      "s": 7
    },
    {
      "t": "ਬਿਧੁੰ ਬਾਕ ਬੈਣੀ ਕਟੰ ਦੇਸ ਛੀਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਰੰਗੇ ਰੰਗ ਰਾਮੰ ਸੁਨੈਣੰ ਪ੍ਰਬੀਣੰ ॥੧੧੬॥",
      "s": 7
    },
    {
      "t": "ਜਿਣੀ ਰਾਮ ਸੀਤਾ ਸੁਣੀ ਸ੍ਰਉਣ ਰਾਮੰ ॥",
      "s": 7
    },
    {
      "t": "ਗਹੇ ਸਸਤ੍ਰ ਅਸਤ੍ਰੰ ਰਿਸਯੋ ਤਉਨ ਜਾਮੰ ॥",
      "s": 7
    },
    {
      "t": "ਕਹਾ ਜਾਤ ਭਾਖਿਯੋ ਰਹੋ ਰਾਮ ਠਾਢੇ ॥",
      "v": [
        [
          1,
          1
        ],
        [
          2,
          2
        ],
        [
          4,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਲਖੋ ਆਜ ਕੈਸੇ ਭਏ ਬੀਰ ਗਾਢੇ ॥੧੧੭॥",
      "s": 7
    },
    {
      "t": "ਭਾਖਾ ਪਿੰਗਲ ਦੀ ॥",
      "s": 7
    },
    {
      "t": "ਸੁੰਦਰੀ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਭਟ ਹੁੰਕੇ ਧੁੰਕੇ ਬੰਕਾਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਰਣ ਬਜੇ ਗਜੇ ਨਗਾਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਰਣ ਹੁਲ ਕਲੋਲੰ ਹੁਲਾਲੰ ॥",
      "s": 7
    },
    {
      "t": "ਢਲ ਹਲੰ ਢਲੰ ਉਛਾਲੰ ॥੧੧੮॥",
      "s": 7
    },
    {
      "t": "ਰਣ ਉਠੇ ਕੁਠੇ ਮੁਛਾਲੇ ॥",
      "s": 7
    },
    {
      "t": "ਸਰ ਛੁਟੇ ਜੁਟੇ ਭੀਹਾਲੇ ॥",
      "s": 7
    },
    {
      "t": "ਰਤੁ ਡਿਗੇ ਭਿਗੇ ਜੋਧਾਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਕਣਣੰਛੇ ਕਛੇ ਕਿਕਾਣੰ ॥੧੧੯॥",
      "s": 7
    },
    {
      "t": "ਭੀਖਣੀਯੰ ਭੇਰੀ ਭੁੰਕਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਝਲ ਲੰਕੇ ਖੰਡੇ ਦੁਧਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਜੁਧੰ ਜੁਝਾਰੰ ਬੁਬਾੜੇ ॥",
      "s": 7
    }
  ]
