{
  "page": 212,
  "lines": [
    {
      "t": "ਰੁਲੀਏ ਪਖਰੀਏ ਆਹਾੜੇ ॥੧੨੦॥",
      "s": 7
    },
    {
      "t": "ਬਕੇ ਬਬਾੜੇ ਬੰਕਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਨਚੇ ਪਖਰੀਏ ਜੁਝਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਬਜੇ ਸੰਗਲੀਏ ਭੀਹਾਲੇ ॥",
      "s": 7
    },
    {
      "t": "ਰਣ ਰਤੇ ਮਤੇ ਮੁਛਾਲੇ ॥੧੨੧॥",
      "s": 7
    },
    {
      "t": "ਉਛਲੀਏ ਕਛੀ ਕਛਾਲੇ ॥",
      "s": 7
    },
    {
      "t": "ਉਡੇ ਜਣੁ ਪਬੰ ਪਛਾਲੇ ॥",
      "s": 7
    },
    {
      "t": "ਜੁਟੇ ਭਟ ਛੁਟੇ ਮੁਛਾਲੇ ॥",
      "s": 7
    },
    {
      "t": "ਰੁਲੀਏ ਆਹਾੜੰ ਪਖਰਾਲੇ ॥੧੨੨॥",
      "s": 7
    },
    {
      "t": "ਬਜੇ ਸੰਧੂਰੰ ਨਗਾਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਕਛੇ ਕਛੀਲੇ ਲੁਝਾਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਗਣ ਹੂਰੰ ਪੂਰੰ ਗੈਣਾਯੰ ॥",
      "s": 7
    },
    {
      "t": "ਅੰਜਨਯੰ ਅੰਜੇ ਨੈਣਾਯੰ ॥੧੨੩॥",
      "s": 7
    },
    {
      "t": "ਰਣ ਣਕੇ ਨਾਦੰ ਨਾਫੀਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਬਬਾੜੇ ਬੀਰੰ ਹਾਬੀਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਉਘੇ ਜਣੁ ਨੇਜੇ ਜਟਾਲੇ ॥",
      "s": 7
    },
    {
      "t": "ਛੁਟੇ ਸਿਲ ਸਿਤਿਯੰ ਮੁਛਾਲੇ ॥੧੨੪॥",
      "s": 7
    },
    {
      "t": "ਭਟ ਡਿਗੇ ਘਾਯੰ ਅਘਾਯੰ ॥",
      "s": 7
    },
    {
      "t": "ਤਨ ਸੁਭੇ ਅਧੇ ਅਧਾਯੰ ॥",
      "s": 7
    },
    {
      "t": "ਦਲ ਗਜੇ ਬਜੇ ਨੀਸਾਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਚੰਚਲੀਏ ਤਾਜੀ ਚੀਹਾਣੰ ॥੧੨੫॥",
      "s": 7
    },
    {
      "t": "ਚਵ ਦਿਸਯੰ ਚਿੰਕੀ ਚਾਵੰਡੈ ॥",
      "s": 7
    },
    {
      "t": "ਖੰਡੇ ਖੰਡੇ ਕੈ ਆਖੰਡੈ ॥",
      "s": 7
    },
    {
      "t": "ਰਣ ੜੰਕੇ ਗਿਧੰ ਉਧਾਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਜੈ ਜੰਪੈ ਸਿੰਧੰ ਸੁਧਾਣੰ ॥੧੨੬॥",
      "s": 7
    },
    {
      "t": "ਫੁਲੇ ਜਣੁ ਕਿੰਸਕ ਬਾਸੰਤੰ ॥",
      "s": 7
    },
    {
      "t": "ਰਣ ਰਤੇ ਸੂਰਾ ਸਾਮੰਤੰ ॥",
      "s": 7
    },
    {
      "t": "ਡਿਗੇ ਰਣ ਸੁੰਡੀ ਸੁੰਡਾਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਧਰ ਭੂਰੰ ਪੂਰੰ ਮੁੰਡਾਣੰ ॥੧੨੭॥",
      "s": 7
    },
    {
      "t": "ਮਧੁਰ ਧੁਨਿ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਤਰ ਭਰ ਰਾਮੰ ॥",
      "s": 7
    },
    {
      "t": "ਪਰਹਰ ਕਾਮੰ ॥",
      "s": 7
    },
    {
      "t": "ਧਰ ਬਰ ਧੀਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਪਰਹਰਿ ਤੀਰੰ ॥੧੨੮॥",
      "s": 7
    },
    {
      "t": "ਦਰ ਬਰ ਗਯਾਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਪਰ ਹਰਿ ਧਯਾਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਥਰਹਰ ਕੰਪੈ ॥",
      "s": 7
    },
    {
      "t": "ਹਰਿ ਹਰਿ ਜੰਪੈ ॥੧੨੯॥",
      "s": 7
    },
    {
      "t": "ਕ੍ਰੋਧੰ ਗਲਿਤੰ ॥",
      "s": 7
    },
    {
      "t": "ਬੋਧੰ ਦਲਿਤੰ ॥",
      "s": 7
    },
    {
      "t": "ਕਰ ਸਰ ਸਰਤਾ ॥",
      "s": 7
    },
    {
      "t": "ਧਰਮਰ ਹਰਤਾ ॥੧੩੦॥",
      "s": 7
    },
    {
      "t": "ਸਰਬਰ ਪਾਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਧਰ ਕਰ ਮਾਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਅਰ ਉਰ ਸਾਲੀ ॥",
      "s": 7
    },
    {
      "t": "ਧਰ ਉਰਿ ਮਾਲੀ ॥੧੩੧॥",
      "s": 7
    },
    {
      "t": "ਕਰ ਬਰ ਕੋਪੰ ॥",
      "s": 7
    },
    {
      "t": "ਥਰਹਰ ਧੋਪੰ ॥",
      "s": 7
    }
  ]
}
