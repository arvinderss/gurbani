{
  "page": 216,
  "lines": [
    {
      "t": "ਰਾਮ ਸੀਆ ਬਰ ਕੈ ਘਰਿ ਆਏ ॥",
      "s": 7
    },
    {
      "t": "ਦੇਸ ਬਿਦੇਸਨ ਹੋਤ ਬਧਾਏ ॥੧੫੮॥",
      "s": 7
    },
    {
      "t": "ਜਹ ਤਹ ਹੋਤ ਉਛਾਹ ਅਪਾਰੂ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਹੂੰ ਸੁਤਨ ਕੋ ਬਯਾਹ ਬਿਚਾਰੂ ॥",
      "s": 7
    },
    {
      "t": "ਬਾਜਤ ਤਾਲ ਮ੍ਰਿਦੰਗ ਅਪਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਨਾਚਤ ਕੋਟਨ ਕੋਟ ਅਖਾਰੰ ॥੧੫੯॥",
      "s": 7
    },
    {
      "t": "ਬਨਿ ਬਨਿ ਬੀਰ ਪਖਰੀਆ ਚਲੇ ॥",
      "s": 7
    },
    {
      "t": "ਜੋਬਨਵੰਤ ਸਿਪਾਹੀ ਭਲੇ ॥",
      "s": 7
    },
    {
      "t": "ਭਏ ਜਾਇ ਇਸਥਤ ਨ੍ਰਿਪ ਦਰ ਪਰ ॥",
      "s": 7
    },
    {
      "t": "ਮਹਾਰਥੀ ਅਰੁ ਮਹਾ ਧਨੁਰਧਰ ॥੧੬੦॥",
      "s": 7
    },
    {
      "t": "ਬਾਜਤ ਜੰਗ ਮੁਚੰਗ ਅਪਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਢੋਲ ਮ੍ਰਿਦੰਗ ਸੁਰੰਗ ਸੁਧਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਗਾਵਤ ਗੀਤ ਚੰਚਲਾ ਨਾਰੀ ॥",
      "s": 7
    },
    {
      "t": "ਨੈਨ ਨਚਾਇ ਬਜਾਵਤ ਤਾਰੀ ॥੧੬੧॥",
      "s": 7
    },
    {
      "t": "ਭਿਛਕਨ ਹਵਸ ਨ ਧਨ ਕੀ ਰਹੀ ॥",
      "s": 7
    },
    {
      "t": "ਦਾਨ ਸ੍ਵਰਨ ਸਰਤਾ ਹੁਇ ਬਹੀ ॥",
      "s": 7
    },
    {
      "t": "ਏਕ ਬਾਤ ਮਾਗਨ ਕਉ ਆਵੈ ॥",
      "s": 7
    },
    {
      "t": "ਬੀਸਕ ਬਾਤ ਘਰੈ ਲੈ ਜਾਵੈ ॥੧੬੨॥",
      "s": 7
    },
    {
      "t": "ਬਨਿ ਬਨਿ ਚਲਤ ਭਏ ਰਘੁਨੰਦਨ ॥",
      "s": 7
    },
    {
      "t": "ਫੂਲੇ ਪੁਹਪ ਬਸੰਤ ਜਾਨੁ ਬਨ ॥",
      "s": 7
    },
    {
      "t": "ਸੋਭਤ ਕੇਸਰ ਅੰਗਿ ਡਰਾਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਆਨੰਦ ਹੀਏ ਉਛਰ ਜਨ ਆਯੋ ॥੧੬੩॥",
      "s": 7
    },
    {
      "t": "ਸਾਜਤ ਭਏ ਅਮਿਤ ਚਤੁਰੰਗਾ ॥",
      "s": 7
    },
    {
      "t": "ਉਮਡ ਚਲਤ ਜਿਹ ਬਿਧਿ ਕਰਿ ਗੰਗਾ ॥",
      "s": 7
    }
  ]
}
