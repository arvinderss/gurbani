{
  "page": 228,
  "lines": [
    {
      "t": "ਕਾ ਕਰਯੋ ਕੁਕਾਜ ॥",
      "s": 7
    },
    {
      "t": "ਕਯੋ ਜੀਐ ਨਿਲਾਜ ॥",
      "s": 7
    },
    {
      "t": "ਮੋਹਿ ਜੈਬੇ ਤਹੀ ॥",
      "s": 7
    },
    {
      "t": "ਰਾਮ ਹੈ ਗੇ ਜਹੀ ॥੨੭੬॥",
      "s": 7
    },
    {
      "t": "ਕੁਸਮ ਬਚਿਤ੍ਰ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਨ ਬਨਬਾਸੀ ਰਘੁਬਰ ਜਾਨੈ ॥",
      "s": 7
    },
    {
      "t": "ਦੁਖ ਸੁਖ ਸਮ ਕਰ ਸੁਖ ਦੁਖ ਮਾਨੈ ॥",
      "s": 7
    },
    {
      "t": "ਬਲਕਲ ਧਰ ਕਰ ਅਬ ਬਨ ਜੈਹੈਂ ॥",
      "s": 7
    },
    {
      "t": "ਰਘੁਪਤ ਸੰਗ ਹਮ ਬਨ ਫਲ ਖੈਹੈਂ ॥੨੭੭॥",
      "s": 7
    },
    {
      "t": "ਇਮ ਕਹਾ ਬਚਨਾ ਘਰ ਬਰ ਛੋਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਬਲਕਲ ਧਰਿ ਤਨ ਭੂਖਨ ਤੋਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਅਵਧਿਸ ਜਾਰੇ ਅਵਧਹਿ ਛਾਡਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਰਘੁਪਤਿ ਪਗ ਤਰ ਕਰ ਘਰ ਮਾਡਿਯੋ ॥੨੭੮॥",
      "s": 7
    },
    {
      "t": "ਲਖਿ ਜਲ ਥਲ ਕਹ ਤਜਿ ਕੁਲ ਧਾਏ ॥",
      "s": 7
    },
    {
      "t": "ਮਨੁ ਮਨ ਸੰਗਿ ਲੈ ਤਿਹ ਠਾ ਆਏ ॥",
      "s": 7
    },
    {
      "t": "ਲਖਿ ਬਲ ਰਾਮੰ ਖਲ ਦਲ ਭੀਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਗਹਿ ਧਨ ਪਾਣੰ ਸਿਤ ਧਰ ਤੀਰੰ ॥੨੭੯॥",
      "s": 7
    },
    {
      "t": "ਗਹਿ ਧਨੁ ਰਾਮੰ ਸਰ ਬਰ ਪੂਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਅਰਬਰ ਥਹਰੇ ਖਲ ਦਲ ਸੂਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਨਰ ਬਰ ਹਰਖੇ ਘਰ ਘਰ ਅਮਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਅਮਰਰਿ ਧਰਕੇ ਲਹਿ ਕਰਿ ਸਮਰੰ ॥੨੮੦॥",
      "s": 7
    },
    {
      "t": "ਤਬ ਚਿਤ ਅਪਨੇ ਭਰਥਰ ਜਾਨੀ ॥",
      "s": 7
    },
    {
      "t": "ਰਨ ਰੰਗ ਰਾਤੇ ਰਘੁਬਰ ਮਾਨੀ ॥",
      "s": 7
    },
    {
      "t": "ਦਲ ਬਲ ਤਜਿ ਕਰਿ ਇਕਲੇ ਨਿਸਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਰਘੁਬਰ ਨਿਰਖੇ ਸਭ ਦੁਖ ਬਿਸਰੇ ॥੨੮੧॥",
      "s": 7
    },
    {
      "t": "ਦ੍ਰਿਗ ਜਬ ਨਿਰਖੇ ਭਟ ਮਣ ਰਾਮੰ ॥",
      "s": 7
    },
    {
      "t": "ਸਿਰ ਧਰ ਟੇਕਯੰ ਤਜ ਕਰ ਕਾਮੰ ॥",
      "s": 7
    },
    {
      "t": "ਇਮ ਗਤਿ ਲਖਿ ਕਰ ਰਘੁਪਤਿ ਜਾਨੀ ॥",
      "s": 7
    },
    {
      "t": "ਭਰਥਰ ਆਏ ਤਜਿ ਰਜਧਾਨੀ ॥੨੮੨॥",
      "s": 7
    },
    {
      "t": "ਰਿਪਹਾ ਨਿਰਖੇ ਭਰਥਰ ਜਾਨੇ ॥",
      "s": 7
    },
    {
      "t": "ਅਵਧਿਸ ਮੂਏ ਤਿਨ ਮਾਨ ਮਾਨੇ ॥",
      "s": 7
    },
    {
      "t": "ਰਘੁਬਰ ਲਛਮਨ ਪਰਹਰ ਬਾਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਗਿਰ ਤਰ ਆਏ ਤਜ ਅਭਿਮਾਨੰ ॥੨੮੩॥",
      "s": 7
    },
    {
      "t": "ਦਲ ਬਲ ਤਜਿ ਕਰਿ ਮਿਲਿ ਗਲ ਰੋਏ ॥",
      "s": 7
    },
    {
      "t": "ਦੁਖ ਕਸਿ ਬਿਧਿ ਦੀਆ ਸੁਖ ਸਭ ਖੋਏ ॥",
      "v": [
        [
          3,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਅਬ ਘਰ ਚਲੀਏ ਰਘੁਬਰ ਮੇਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਤਜਿ ਹਠਿ ਲਾਗੇ ਸਭ ਪਗ ਤੇਰੇ ॥੨੮੪॥",
      "s": 7
    },
    {
      "t": "ਰਾਮ ਬਾਚ ਭਰਥ ਸੋਂ ॥",
      "s": 7
    },
    {
      "t": "ਕੰਠ ਅਭੂਖਨ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਭਰਥ ਕੁਮਾਰ ਨ ਅਉਹਠ ਕੀਜੈ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਜਾਹ ਘਰੈ ਨ ਹਮੈ ਦੁਖ ਦੀਜੈ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਰਾਜ ਕਹਯੋ ਜੁ ਹਮੈ ਹਮ ਮਾਨੀ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਤ੍ਰਿਯੋਦਸ ਬਰਖ ਬਸੈ ਬਨ ਧਾਨੀ ॥੨੮੫॥",
      "s": 7
    },
    {
      "t": "ਤ੍ਰਿਯੋਦਸ ਬਰਖ ਬਿਤੈ ਫਿਰਿ ਐਹੈਂ ॥",
      "s": 7
    },
    {
      "t": "ਰਾਜ ਸੰਘਾਸਨ ਛਤ੍ਰ ਸੁਹੈਹੈਂ ॥",
      "s": 7
    },
    {
      "t": "ਜਾਹੁ ਘਰੈ ਸਿਖ ਮਾਨ ਹਮਾਰੀ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਰੋਵਤ ਤੋਰਿ ਉਤੈ ਮਹਤਾਰੀ ॥੨੮੬॥",
      "s": 7
    },
    {
      "t": "ਭਰਥ ਬਾਚ ਰਾਮ ਪ੍ਰਤਿ ॥",
      "s": 7
    }
  ]
}
