  "page": 233,
  "lines": [
    {
      "t": "ਪ੍ਰਭ ਭ੍ਰਾਤ ਸੰਗਿ ॥",
      "s": 7
    },
    {
      "t": "ਸੀਅ ਸੰਗ ਸੁਰੰਗ ॥",
      "s": 7
    },
    {
      "t": "ਤਜਿ ਚਿੰਤ ਅੰਗ ॥",
      "s": 7
    },
    {
      "t": "ਧਸ ਬਨ ਨਿਸੰਗ ॥੩੨੭॥",
      "s": 7
    },
    {
      "t": "ਧਰਿ ਬਾਨ ਪਾਨ ॥",
      "s": 7
    },
    {
      "t": "ਕਟਿ ਕਸਿ ਕ੍ਰਿਪਾਨ ॥",
      "s": 7
    },
    {
      "t": "ਭੁਜ ਬਰ ਅਜਾਨ ॥",
      "s": 7
    },
    {
      "t": "ਚਲ ਤੀਰਥ ਨਾਨ ॥੩੨੮॥",
      "s": 7
    },
    {
      "t": "ਗੋਦਾਵਰਿ ਤੀਰ ॥",
      "s": 7
    },
    {
      "t": "ਗਏ ਸਹਿਤ ਬੀਰ ॥",
      "s": 7
    },
    {
      "t": "ਤਜ ਰਾਮ ਚੀਰ ॥",
      "s": 7
    },
    {
      "t": "ਕੀਅ ਸੁਚ ਸਰੀਰ ॥੩੨੯॥",
      "s": 7
    },
    {
      "t": "ਲਖਿ ਰਾਮ ਰੂਪ ॥",
      "s": 7
    },
    {
      "t": "ਅਤਿਭੁਤ ਅਨੂਪ ॥",
      "s": 7
    },
    {
      "t": "ਜਹ ਹੁਤੀ ਸੂਪ ॥",
      "s": 7
    },
    {
      "t": "ਤਹ ਗਏ ਭੂਪ ॥੩੩੦॥",
      "s": 7
    },
    {
      "t": "ਕਹੀ ਤਾਹਿ ਧਾਤਿ ॥",
      "s": 7
    },
    {
      "t": "ਸੁਨਿ ਸੂਪ ਬਾਤਿ ॥",
      "s": 7
    },
    {
      "t": "ਦੁਐ ਅਤਿਥ ਨਾਤ ॥",
      "s": 7
    },
    {
      "t": "ਲਹਿ ਅਨੂਪ ਗਾਤ ॥੩੩੧॥",
      "s": 7
    },
    {
      "t": "ਸੁੰਦਰੀ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਸੂਪਨਖਾ ਇਹ ਭਾਤਿ ਸੁਨੀ ਜਬ ॥",
      "s": 7
    },
    {
      "t": "ਧਾਇ ਚਲੀ ਅਬਿਲੰਬ ਤ੍ਰਿਯਾ ਤਬ ॥",
      "s": 7
    },
    {
      "t": "ਕਾਮ ਸਰੂਪ ਕਲੇਵਰ ਜਾਨੈ ॥",
      "s": 7
    }
  ]
}
