{
  "page": 234,
  "lines": [
    {
      "t": "ਰੂਪ ਅਨੂਪ ਤਿਹੂੰ ਪੁਰ ਮਾਨੈ ॥੩੩੨॥",
      "s": 7
    },
    {
      "t": "ਧਾਇ ਕਹਯੋ ਰਘੁਰਾਇ ਭਏ ਤਿਹ ॥",
      "s": 7
    },
    {
      "t": "ਜੈਸ ਨ੍ਰਿਲਾਜ ਕਹੈ ਨ ਕੋਊ ਕਿਹ ॥",
      "s": 7
    },
    {
      "t": "ਹਉ ਅਟਕੀ ਤੁਮਰੀ ਛਬਿ ਕੇ ਬਰ ॥",
      "s": 7
    },
    {
      "t": "ਰੰਗ ਰੰਗੀ ਰੰਗਏ ਦ੍ਰਿਗ ਦੂਪਰ ॥੩੩੩॥",
      "s": 7
    },
    {
      "t": "ਰਾਮ ਬਾਚ ॥",
      "s": 7
    },
    {
      "t": "ਸੁੰਦਰੀ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਜਾਹ ਤਹਾ ਜਹ ਭ੍ਰਾਤਿ ਹਮਾਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਵੈ ਰਿਝਹੈ ਲਖ ਨੈਨ ਤਿਹਾਰੇ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਸੰਗ ਸੀਆ ਅਵਿਲੋਕ ਕ੍ਰਿਸੋਦਰ ॥",
      "s": 7
    },
    {
      "t": "ਕੈਸੇ ਕੈ ਰਾਖ ਸਕੋ ਤੁਮ ਕਉ ਘਰਿ ॥੩੩੪॥",
      "s": 7
    },
    {
      "t": "ਮਾਤ ਪਿਤਾ ਕਹ ਮੋਹ ਤਜਯੋ ਮਨ ॥",
      "s": 7
    },
    {
      "t": "ਸੰਗ ਫਿਰੀ ਹਮਰੇ ਬਨ ਹੀ ਬਨ ॥",
      "s": 7
    },
    {
      "t": "ਤਾਹਿ ਤਜੌ ਕਸ ਕੈ ਸੁਨਿ ਸੁੰਦਰ ॥",
      "v": [
        [
          3,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਜਾਹੁ ਤਹਾ ਜਹਾ ਭ੍ਰਾਤ ਕ੍ਰਿਸੋਦਰਿ ॥੩੩੫॥",
      "v": [
        [
          3,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਜਾਤ ਭਈ ਸੁਨ ਬੈਨ ਤ੍ਰਿਯਾ ਤਹ ॥",
      "s": 7
    },
    {
      "t": "ਬੈਠ ਹੁਤੇ ਰਣਧੀਰ ਜਤੀ ਜਹ ॥",
      "s": 7
    },
    {
      "t": "ਸੋ ਨ ਬਰੈ ਅਤਿ ਰੋਸ ਭਰੀ ਤਬ ॥",
      "s": 7
    },
    {
      "t": "ਨਾਕ ਕਟਾਇ ਗਈ ਗ੍ਰਿਹ ਕੋ ਸਭ ॥੩੩੬॥",
      "s": 7
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕੇ ਰਾਮ ਅਵਤਾਰ ਕਥਾ ਸੂਪਨਖਾ ਕੋ ਨਾਕ ਕਾਟਬੋ ਧਯਾਇ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੫॥",
      "s": 7
    },
    {
      "t": "ਅਥ ਖਰਦੂਖਨ ਦਈਤ ਜੁਧ ਕਥਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਸੁੰਦਰੀ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਰਾਵਨ ਤੀਰ ਰੁਰੋਤ ਭਈ ਜਬ ॥",
      "s": 7
    },
    {
      "t": "ਰੋਸ ਭਰੇ ਦਨੁ ਬੰਸ ਬਲੀ ਸਭ ॥",
      "s": 7
    },
    {
      "t": "ਲੰਕਸ ਧੀਰ ਬਜੀਰ ਬੁਲਾਏ ॥",
      "s": 7
    },
    {
      "t": "ਦੂਖਨ ਔ ਖਰ ਦਈਤ ਪਠਾਏ ॥੩੩੭॥",
      "s": 7
    },
    {
      "t": "ਸਾਜ ਸਨਾਹ ਸੁਬਾਹ ਦੁਰੰ ਗਤ ॥",
      "s": 7
    },
    {
      "t": "ਬਾਜਤ ਬਾਜ ਚਲੇ ਗਜ ਗਜਤ ॥",
      "s": 7
    },
    {
      "t": "ਮਾਰ ਹੀ ਮਾਰ ਦਸੋ ਦਿਸ ਕੂਕੇ ॥",
      "s": 7
    },
    {
      "t": "ਸਾਵਨ ਕੀ ਘਟ ਜਯੋਂ ਘੁਰ ਢੂਕੇ ॥੩੩੮॥",
      "s": 7
    },
    {
      "t": "ਗਜਤ ਹੈ ਰਣਬੀਰ ਮਹਾ ਮਨ ॥",
      "s": 7
    },
    {
      "t": "ਤਜਤ ਹੈਂ ਨਹੀ ਭੂਮਿ ਅਯੋਧਨ ॥",
      "s": 7
    },
    {
      "t": "ਛਾਜਤ ਹੈ ਚਖ ਸ੍ਰੋਣਤ ਸੋ ਸਰ ॥",
      "s": 7
    },
    {
      "t": "ਨਾਦਿ ਕਰੈਂ ਕਿਲਕਾਰ ਭਯੰਕਰ ॥੩੩੯॥",
      "s": 7
    },
    {
      "t": "ਤਾਰਕਾ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਰਨਿ ਰਾਜ ਕੁਮਾਰ ਬਿਰਚਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਸਰ ਸੇਲ ਸਰਾਸਨ ਨਚਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਸੁ ਬਿਰੁਧ ਅਵਧਿ ਸੁ ਗਾਜਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਰਣ ਰੰਗਹਿ ਰਾਮ ਬਿਰਾਜਹਿਗੇ ॥੩੪੦॥",
      "s": 7
    },
    {
      "t": "ਸਰ ਓਘ ਪ੍ਰਓਘ ਪ੍ਰਹਾਰੈਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਰਣਿ ਰੰਗ ਅਭੀਤ ਬਿਹਾਰੈਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਸਰ ਸੂਲ ਸਨਾਹਰਿ ਛੁਟਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਦਿਤ ਪੁਤ੍ਰ ਪਰਾ ਪਰ ਲੁਟਹਿਗੇ ॥੩੪੧॥",
      "s": 7
    },
    {
      "t": "ਸਰ ਸੰਕ ਅਸੰਕਤ ਬਾਹਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਬਿਨੁ ਭੀਤ ਭਯਾ ਦਲ ਦਾਹਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਛਿਤਿ ਲੁਥ ਬਿਲੁਥ ਬਿਥਾਰਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਤਰੁ ਸਣੈ ਸਮੂਲ ਉਪਾਰਹਿਗੇ ॥੩੪੨॥",
      "s": 7
    },
    {
      "t": "ਨਵ ਨਾਦ ਨਫੀਰਨ ਬਾਜਤ ਭੇ ॥",
      "s": 7
    }
  ]
}
