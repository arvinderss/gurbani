{
  "page": 244,
  "lines": [
    {
      "t": "ਕਾਰੈ ਲਾਗ ਮੰਤ੍ਰੰ ਕੁਮੰਤ੍ਰੰ ਬਿਚਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਇਤੈ ਉਚਰੇ ਬੈਨ ਭ੍ਰਾਤੰ ਲੁਝਾਰੰ ॥੪੧੭॥",
      "s": 7
    },
    {
      "t": "ਜਲੰ ਗਾਗਰੀ ਸਪਤ ਸਾਹੰਸ੍ਰ ਪੂਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਮੁਖੰ ਪੁਛ ਲਯੋ ਕੁੰਭਕਾਨੰ ਕਰੂਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਕੀਯੋ ਮਾਸਹਾਰੰ ਮਹਾ ਮਦਯ ਪਾਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਉਠਯੋ ਲੈ ਗਦਾ ਕੋ ਭਰਯੋ ਵੀਰ ਮਾਨੰ ॥੪੧੮॥",
      "s": 7
    },
    {
      "t": "ਭਜੀ ਬਾਨਰੀ ਪੇਖ ਸੈਨਾ ਅਪਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਤ੍ਰਸੇ ਜੂਥ ਪੈ ਜੂਥ ਜੋਧਾ ਜੁਝਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਉਠੈ ਗਦ ਸਦੰ ਨਿਨਦੰਤਿ ਵੀਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਫਿਰੈ ਰੁੰਡ ਮੁੰਡੰ ਤਨੰ ਤਛ ਤੀਰੰ ॥੪੧੯॥",
      "s": 7
    },
    {
      "t": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਗਿਰੈ ਮੁੰਡ ਤੁੰਡੰ ਭਸੁੰਡੰ ਗਜਾਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਫਿਰੈ ਰੁੰਡ ਮੁੰਡੰ ਸੁ ਝੁੰਡੰ ਨਿਸਾਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਰੜੈ ਕੰਕ ਬੰਕੰ ਸਸੰਕੰਤ ਜੋਧੰ ॥",
      "s": 7
    },
    {
      "t": "ਉਠੀ ਕੂਹ ਜੂਹੰ ਮਿਲੇ ਸੈਣ ਕ੍ਰੋਧੰ ॥੪੨੦॥",
      "s": 7
    },
    {
      "t": "ਝਿਮੀ ਤੇਗ ਤੇਜੰ ਸਰੋਸੰ ਪ੍ਰਹਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਖਿਮੀ ਦਾਮਨੀ ਜਾਣੁ ਭਾਦੋ ਮਝਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਹਸੇ ਕੰਕ ਬੰਕੰ ਕਸੇ ਸੂਰਵੀਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਢਲੀ ਢਾਲ ਮਾਲੰ ਸੁਭੇ ਤਛ ਤੀਰੰ ॥੪੨੧॥",
      "s": 7
    },
    {
      "t": "ਬਿਰਾਜ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਹਕ ਦੇਬੀ ਕਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਸਦ ਭੈਰੋ ਰਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਚਾਵਡੀ ਚਿੰਕਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਡਾਕਣੀ ਡਿੰਕਰੰ ॥੪੨੨॥",
      "s": 7
    },
    {
      "t": "ਪਤ੍ਰ ਜੁਗਣ ਭਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਲੁਥ ਬਿਥੁਥਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਸੰਮੁਹੇ ਸੰਘਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਹੂਹ ਕੂਹੰ ਭਰੰ ॥੪੨੩॥",
      "s": 7
    },
    {
      "t": "ਅਛਰੀ ਉਛਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਸਿੰਧੁਰੈ ਸਿੰਧਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਮਾਰ ਮਾਰੁਚਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਬਜ ਗਜੇ ਸੁਰੰ ॥੪੨੪॥",
      "s": 7
    },
    {
      "t": "ਉਝਰੇ ਲੁਝਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਝੁਮਰੇ ਜੁਝਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਬਜੀਯੰ ਡੰਮਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਤਾਲਣੋ ਤੁੰਬਰੰ ॥੪੨੫॥",
      "s": 7
    },
    {
      "t": "ਰਸਾਵਲ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਪਰੀ ਮਾਰ ਮਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਮੰਡੇ ਸਸਤ੍ਰ ਧਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਰਟੈ ਮਾਰ ਮਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਤੁਟੈ ਖਗ ਧਾਰੰ ॥੪੨੬॥",
      "s": 7
    },
    {
      "t": "ਉਠੈ ਛਿਛ ਅਪਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਬਹੈ ਸ੍ਰੋਣ ਧਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਹਸੈ ਮਾਸਹਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਪੀਐ ਸ੍ਰੋਣ ਸਯਾਰੰ ॥੪੨੭॥",
      "s": 7
    },
    {
      "t": "ਗਿਰੇ ਚਉਰ ਚਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਭਜੇ ਏਕ ਹਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਰਟੈ ਏਕ ਮਾਰੰ ॥",
