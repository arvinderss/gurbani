{
  "page": 246,
  "lines": [
    {
      "t": "ਹਣੇ ਭੂਮ ਮਾਥੰ ॥੪੪੦॥",
      "s": 7
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕੇ ਰਾਮਵਤਾਰ ਕੁੰਭਕਰਨ ਬਧਹਿ ਧਯਾਇ ਸਮਾਪਤਮ ਸਤੁ ॥",
      "s": 7
    },
    {
      "t": "ਅਥ ਤ੍ਰਿਮੁੰਡ ਜੁਧ ਕਥਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਰਸਾਵਲ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਪਠਯੋ ਤੀਨ ਮੁੰਡੰ ॥",
      "s": 7
    },
    {
      "t": "ਚਲਯੋ ਸੈਨ ਝੁੰਡੰ ॥",
      "s": 7
    },
    {
      "t": "ਕ੍ਰਿਤੀ ਚਿਤ੍ਰ ਜੋਧੀ ॥",
      "s": 7
    },
    {
      "t": "ਮੰਡੇ ਪਰਮ ਕ੍ਰੋਧੀ ॥੪੪੧॥",
      "s": 7
    },
    {
      "t": "ਬਕੈਂ ਮਾਰ ਮਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਤਜੈ ਬਾਣ ਧਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਹਨੂਮੰਤ ਕੋਪੇ ॥",
      "s": 7
    },
    {
      "t": "ਰਣੰ ਪਾਇ ਰੋਪੇ ॥੪੪੨॥",
      "s": 7
    },
    {
      "t": "ਅਸੰ ਛੀਨ ਲੀਨੋ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਸੀ ਕੰਠਿ ਦੀਨੋ ॥",
      "s": 7
    },
    {
      "t": "ਹਨਯੋ ਖਸਟ ਨੈਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਹਸੇ ਦੇਵ ਗੈਣੰ ॥੪੪੩॥",
      "s": 7
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਰਾਮਵਤਾਰ ਤ੍ਰਿਮੁੰਡ ਬਧਹ ਧਯਾਇ ਸਮਾਪਤਮ ਸਤੁ ॥",
      "s": 7
    },
    {
      "t": "ਅਥ ਮਹੋਦਰ ਮੰਤ੍ਰੀ ਜੁਧ ਕਥਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਰਸਾਵਲ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਸੁਣਯੋ ਲੰਕ ਨਾਥੰ ॥",
      "s": 7
    },
    {
      "t": "ਧੁਣੇ ਸਰਬ ਮਾਥੰ ॥",
      "s": 7
    },
    {
      "t": "ਕਰਯੋ ਮਦ ਪਾਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਭਰੇ ਬੀਰ ਮਾਣੰ ॥੪੪੪॥",
      "s": 7
    },
    {
      "t": "ਮਹਿਖੁਆਸ ਕਰਖੈਂ ॥",
      "s": 7
    },
    {
      "t": "ਸਰੰਧਾਰ ਬਰਖੈਂ ॥",
      "s": 7
    },
    {
      "t": "ਮਹੋਦ੍ਰਾਦਿ ਵੀਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਹਠੇ ਖਗ ਧੀਰੰ ॥੪੪੫॥",
      "s": 7
    },
    {
      "t": "ਮੋਹਣੀ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਢਲ ਹਲ ਸੁਢਲੀ ਢੋਲਾਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਰਣ ਰੰਗ ਅਭੰਗ ਕਲੋਲਾਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਭਰਣੰਕ ਸੁ ਨਦੰ ਨਾਫੀਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਬਰਣੰਕਸੁ ਬਜੇ ਮਜੀਰੰ ॥੪੪੬॥",
      "s": 7
    },
    {
      "t": "ਭਰਣੰਕਸੁ ਭੇਰੀ ਘੋਰਾਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਜਣੁ ਸਾਵਣ ਭਾਦੋ ਮੋਰਾਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਉਛਲੀਏ ਪ੍ਰਖਰੇ ਪਾਵੰਗੰ ॥",
      "s": 7
    },
    {
      "t": "ਮਚੇ ਜੁਝਾਰੇ ਜੋਧੰਗੰ ॥੪੪੭॥",
      "s": 7
    },
    {
      "t": "ਸਿੰਧੁਰੀਏ ਸੁੰਡੀ ਦੰਤਾਲੇ ॥",
      "s": 7
    },
    {
      "t": "ਨਚੇ ਪਖਰੀਏ ਮੁਛਾਲੇ ॥",
      "s": 7
    },
    {
      "t": "ਓਰੜੀਏ ਸਰਬੰ ਸੈਣਾਯੰ ॥",
      "s": 7
    },
    {
      "t": "ਦੇਖੰਤ ਸੁ ਦੇਵੰ ਗੈਣਾਯੰ ॥੪੪੮॥",
      "s": 7
    },
    {
      "t": "ਝਲੈ ਅਵਝੜੀਯੰ ਉਝਾੜੰ ॥",
      "s": 7
    },
    {
      "t": "ਰਣ ਉਠੈ ਬੈਹੈਂ ਬਬਾੜੰ ॥",
      "s": 7
    },
    {
      "t": "ਘੈ ਘੁਮੇ ਘਾਯੰ ਅਘਾਯੰ ॥",
      "s": 7
    },
    {
      "t": "ਭੂਅ ਡਿਗੇ ਅਧੋ ਅਧਾਯੰ ॥੪੪੯॥",
      "s": 7
    },
    {
      "t": "ਰਿਸ ਮੰਡੈ ਛੰਡੈ ਅਉ ਛੰਡੈ ॥",
      "s": 7
    },
    {
      "t": "ਹਠਿ ਹਸੈ ਕਸੈ ਕੋ ਅੰਡੈ ॥",
      "s": 7
    },
    {
      "t": "ਰਿਸ ਬਾਹੈਂ ਗਾਹੈਂ ਜੋਧਾਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਰਣ ਹੋਹੈਂ ਜੋਹੈਂ ਕ੍ਰੋਧਾਣੰ ॥੪੫੦॥",
      "s": 7
    }
  ]
}
