{
  "page": 247,
  "lines": [
    {
      "t": "ਰਣ ਗਜੈ ਸਜੈ ਸਸਤ੍ਰਾਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਧਨੁ ਕਰਖੈਂ ਬਰਖੈਂ ਅਸਤ੍ਰਾਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਦਲ ਗਾਹੈ ਬਾਹੈ ਹਥਿਯਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਰਣ ਰੁਝੈ ਲੁੰਝੈ ਲੁਝਾਰੰ ॥੪੫੧॥",
      "s": 7
    },
    {
      "t": "ਭਟ ਭੇਦੇ ਛੇਦੇ ਬਰਮਾਯੰ ॥",
      "s": 7
    },
    {
      "t": "ਭੂਅ ਡਿਗੇ ਚਉਰੰ ਚਰਮਾਯੰ ॥",
      "s": 7
    },
    {
      "t": "ਉਘੇ ਜਣ ਨੇਜੇ ਮਤਵਾਲੇ ॥",
      "s": 7
    },
    {
      "t": "ਚਲੇ ਜਯੋਂ ਰਾਵਲ ਜਟਾਲੇ ॥੪੫੨॥",
      "s": 7
    },
    {
      "t": "ਹਠੇ ਤਰਵਰੀਏ ਹੰਕਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਮੰਚੇ ਪਖਰੀਏ ਸੂਰਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਅਕੁੜਿਯੰ ਵੀਰੰ ਐਠਾਲੇ ॥",
      "s": 7
    },
    {
      "t": "ਤਨ ਸੋਹੇ ਪਤ੍ਰੀ ਪਤ੍ਰਾਲੇ ॥੪੫੩॥",
      "s": 7
    },
    {
      "t": "ਨਵ ਨਾਮਕ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਤਰਭਰ ਪਰ ਸਰ ॥",
      "s": 7
    },
    {
      "t": "ਨਿਰਖਤ ਸੁਰ ਨਰ ॥",
      "s": 7
    },
    {
      "t": "ਹਰ ਪੁਰ ਪੁਰ ਸੁਰ ॥",
      "s": 7
    },
    {
      "t": "ਨਿਰਖਤ ਬਰ ਨਰ ॥੪੫੪॥",
      "s": 7
    },
    {
      "t": "ਬਰਖਤ ਸਰ ਬਰ ॥",
      "s": 7
    },
    {
      "t": "ਕਰਖਤ ਧਨੁ ਕਰਿ ॥",
      "s": 7
    },
    {
      "t": "ਪਰਹਰ ਪੁਰ ਕਰ ॥",
      "s": 7
    },
    {
      "t": "ਨਿਰਖਤ ਬਰ ਨਰ ॥੪੫੫॥",
      "s": 7
    },
    {
      "t": "ਸਰ ਬਰ ਧਰ ਕਰ ॥",
      "s": 7
    },
    {
      "t": "ਪਰਹਰ ਪੁਰ ਸਰ ॥",
      "s": 7
    },
    {
      "t": "ਪਰਖਤ ਉਰ ਨਰ ॥",
      "s": 7
    }
  ]
