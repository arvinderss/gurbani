{
  "page": 250,
  "lines": [
    {
      "t": "ਥਲ ਗਯੋ ਨਕੁੰਭਲਾ ਹੋਮ ਕਰਣ ॥੪੭੯॥",
      "s": 7
    },
    {
      "t": "ਲਘ ਬੀਰ ਤੀਰ ਲੰਕੇਸ ਆਨ ॥",
      "s": 7
    },
    {
      "t": "ਇਮ ਕਹੈ ਬੈਣ ਤਜ ਭ੍ਰਾਤ ਕਾਨ ॥",
      "s": 7
    },
    {
      "t": "ਆਇ ਹੈ ਸਤ੍ਰੁ ਇਹ ਘਾਤ ਹਾਥ ॥",
      "s": 7
    },
    {
      "t": "ਇੰਦ੍ਰਾਰ ਬੀਰ ਅਰਬਰ ਪ੍ਰਮਾਥ ॥੪੮੦॥",
      "s": 7
    },
    {
      "t": "ਨਿਜ ਮਾਸ ਕਾਟ ਕਰ ਕਰਤ ਹੋਮ ॥",
      "s": 7
    },
    {
      "t": "ਥਰਹਰਤ ਭੂੰਮਿ ਅਰ ਚਕਤ ਬਯੋਮ ॥",
      "s": 7
    },
    {
      "t": "ਤਹ ਗਯੋ ਰਾਮ ਭ੍ਰਾਤਾ ਨਿਸੰਗਿ ॥",
      "s": 7
    },
    {
      "t": "ਕਰ ਧਰੇ ਧਨੁਖ ਕਟ ਕਸਿ ਨਿਖੰਗ ॥੪੮੧॥",
      "s": 7
    },
    {
      "t": "ਚਿੰਤੀ ਸੁ ਚਿਤ ਦੇਵੀ ਪ੍ਰਚੰਡ ॥",
      "s": 7
    },
    {
      "t": "ਅਰ ਹਣਯੋ ਬਾਣ ਕੀਨੋ ਦੁਖੰਡ ॥",
      "s": 7
    },
    {
      "t": "ਰਿਪ ਫਿਰੇ ਮਾਰ ਦੁੰਦਭ ਬਜਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਉਤ ਭਜੇ ਦਈਤ ਦਲਪਤਿ ਜੁਝਾਇ ॥੪੮੨॥",
      "s": 7
    },
    {
      "t": "ਇਤਿ ਇੰਦ੍ਰਜੀਤ ਬਧਹਿ ਧਿਆਇ ਸਮਾਪਤਮ ਸਤੁ ॥",
      "s": 7
    },
    {
      "t": "ਅਥ ਅਤਕਾਇ ਦਈਤ ਜੁਧ ਕਥਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਸੰਗੀਤ ਪਧਿਸਟਕਾ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਕਾਗੜਦੰਗ ਕੋਪ ਕੈ ਦਈਤ ਰਾਜ ॥",
      "s": 7
    },
    {
      "t": "ਜਾਗੜਦੰਗ ਜੁਧ ਕੋ ਸਜਯੋ ਸਾਜ ॥",
      "s": 7
    },
    {
      "t": "ਬਾਗੜਦੰਗ ਬੀਰ ਬੁਲੇ ਅਨੰਤ ॥",
      "s": 7
    },
    {
      "t": "ਰਾਗੜਦੰਗ ਰੋਸ ਰੋਹੇ ਦੁਰੰਤ ॥੪੮੩॥",
      "s": 7
    },
    {
      "t": "ਪਾਗੜਦੰਗ ਪਰਮ ਬਾਜੀ ਬੁਲੰਤ ॥",
      "s": 7
    },
    {
      "t": "ਚਾਗੜਦੰਗ ਚਤ੍ਰ ਨਟ ਜਯੋਂ ਕੁਦੰਤ ॥",
      "s": 7
    },
    {
      "t": "ਕਾਗੜਦੰਗ ਕ੍ਰੂਰ ਕਢੇ ਹਥਿਆਰ ॥",
      "s": 7
    },
    {
      "t": "ਆਗੜਦੰਗ ਆਨ ਬਜੇ ਜੁਝਾਰ ॥੪੮੪॥",
      "s": 7
    }
  ]
}
