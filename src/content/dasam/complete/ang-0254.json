{
  "page": 254,
  "lines": [
    {
      "t": "ਰਿਪੁ ਕਰਯੋ ਸਸਤ੍ਰ ਅਸਤ੍ਰੰ ਬਿਹੀਨ ॥",
      "s": 7
    },
    {
      "t": "ਬਹੁ ਸਸਤ੍ਰ ਸਾਸਤ੍ਰ ਬਿਦਿਆ ਪ੍ਰਬੀਨ ॥",
      "s": 7
    },
    {
      "t": "ਹਯ ਮੁਕਟ ਸੂਤ ਬਿਨੁ ਭਯੋ ਗਵਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਕਛੁ ਚਪੇ ਚੋਰ ਜਿਮ ਬਲ ਸੰਭਾਰ ॥੫੧੩॥",
      "s": 7
    },
    {
      "t": "ਰਿਪੁ ਹਣੇ ਬਾਣ ਬਜ੍ਰਵ ਘਾਤ ॥",
      "s": 7
    },
    {
      "t": "ਸਮ ਚਲੇ ਕਾਲ ਕੀ ਜੁਆਲ ਤਾਤ ॥",
      "s": 7
    },
    {
      "t": "ਤਬ ਕੁਪਯੋ ਵੀਰ ਅਤਕਾਇ ਐਸ ॥",
      "s": 7
    },
    {
      "t": "ਜਨ ਪ੍ਰਲੈ ਕਾਲ ਕੋ ਮੇਘ ਜੈਸ ॥੫੧੪॥",
      "s": 7
    },
    {
      "t": "ਇਮ ਕਰਨ ਲਾਗ ਲਪਟੈਂ ਲਬਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਜਿਮ ਜੁਬਣ ਹੀਣ ਲਪਟਾਇ ਨਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਜਿਮ ਦੰਤ ਰਹਤ ਗਹ ਸ੍ਵਾਨ ਸਸਕ ॥",
      "s": 7
    },
    {
      "t": "ਜਿਮ ਗਏ ਬੈਸ ਬਲ ਬੀਰਜ ਰਸਕ ॥੫੧੫॥",
      "s": 7
    },
    {
      "t": "ਜਿਮ ਦਰਬ ਹੀਣ ਕਛੁ ਕਰਿ ਬਪਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਜਣ ਸਸਤ੍ਰ ਹੀਣ ਰੁਝਯੋ ਜੁਝਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਜਿਮ ਰੂਪ ਹੀਣ ਬੇਸਯਾ ਪ੍ਰਭਾਵ ॥",
      "s": 7
    },
    {
      "t": "ਜਣ ਬਾਜ ਹੀਣ ਰਥ ਕੋ ਚਲਾਵ ॥੫੧੬॥",
      "s": 7
    },
    {
      "t": "ਤਬ ਤਮਕ ਤੇਗ ਲਛਮਣ ਉਦਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਤਹ ਹਣਯੋ ਸੀਸ ਕਿਨੋ ਦੁਫਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਤਬ ਗਿਰਯੋ ਬੀਰ ਅਤਿਕਾਇ ਏਕ ॥",
      "s": 7
    },
    {
      "t": "ਲਖ ਤਾਹਿ ਸੂਰ ਭਜੇ ਅਨੇਕ ॥੫੧੭॥",
      "s": 7
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕੇ ਰਾਮਵਤਾਰ ਅਤਕਾਇ ਬਧਹਿ ਧਿਆਇ ਸਮਾਪਤਮ ਸਤੁ ॥੧੪॥",
      "s": 7
    },
    {
      "t": "ਅਥ ਮਕਰਾਛ ਜੁਧ ਕਥਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਪਾਧਰੀ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਤਬ ਰੁਕਯੋ ਸੈਨ ਮਕਰਾਛ ਆਨ ॥",
      "s": 7
    },
    {
      "t": "ਕਹ ਜਾਹੁ ਰਾਮ ਨਹੀ ਪੈਹੋ ਜਾਨ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਜਿਨ ਹਤਯੋ ਤਾਤ ਰਣ ਮੋ ਅਖੰਡ ॥",
      "s": 7
    },
    {
      "t": "ਸੋ ਲਰੋ ਆਨ ਮੋ ਸੋਂ ਪ੍ਰਚੰਡ ॥੫੧੮॥",
      "s": 7
    },
    {
      "t": "ਇਮ ਸੁਣਿ ਕੁਬੈਣ ਰਾਮਾਵਤਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਗਹਿ ਸਸਤ੍ਰ ਅਸਤ੍ਰ ਕੋਪਯੋ ਜੁਝਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਬਹੁ ਤਾਣ ਬਾਣ ਤਿਹ ਹਣੇ ਅੰਗ ॥",
      "s": 7
    },
    {
      "t": "ਮਕਰਾਛ ਮਾਰਿ ਡਾਰਯੋ ਨਿਸੰਗ ॥੫੧੯॥",
      "s": 7
    },
    {
      "t": "ਜਬ ਹਤੇ ਬੀਰ ਅਰ ਹਣੀ ਸੈਨ ॥",
      "s": 7
    },
    {
      "t": "ਤਬ ਭਜੌ ਸੂਰ ਹੁਐ ਕਰ ਨਿਚੈਨ ॥",
      "s": 7
    },
    {
      "t": "ਤਬ ਕੁੰਭ ਔਰ ਅਨਕੁੰਭ ਆਨ ॥",
      "s": 7
    },
    {
      "t": "ਦਲ ਰੁਕਯੋ ਰਾਮ ਕੋ ਤਯਾਗ ਕਾਨ ॥੫੨੦॥",
      "s": 7
    },
    {
      "t": "ਇਤਿ ਮਰਾਛ ਬਧਹ ॥",
      "s": 7
    },
    {
      "t": "ਅਜਬਾ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਤ੍ਰਪੇ ਤਾਜੀ ॥",
      "s": 7
    },
    {
      "t": "ਗਜੇ ਗਾਜੀ ॥",
      "s": 7
    },
    {
      "t": "ਸਜੇ ਸਸਤ੍ਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਕਛੇ ਅਸਤ੍ਰੰ ॥੫੨੧॥",
      "s": 7
    },
    {
      "t": "ਤੁਟੇ ਤ੍ਰਾਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਛੁਟੇ ਬਾਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਰੁਪੇ ਬੀਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਬੁਠੇ ਤੀਰੰ ॥੫੨੨॥",
      "s": 7
    },
    {
      "t": "ਘੁਮੇ ਘਾਯੰ ॥",
      "s": 7
    },
    {
      "t": "ਜੁਮੇ ਚਾਯੰ ॥",
      "s": 7
    },
    {
      "t": "ਰਜੇ ਰੋਸੰ ॥",
      "s": 7
    }
  ]
