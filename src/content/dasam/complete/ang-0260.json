{
  "page": 260,
  "lines": [
    {
      "t": "ਬਬਰਖ ਤੀਖਣੋ ਸਰੰ ॥੫੭੪॥",
      "s": 7
    },
    {
      "t": "ਸੰਗੀਤ ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਜਾਗੜਦੰਗ ਜੁਝਯੋ ਭਾਗੜਦੰਗ ਭ੍ਰਾਤੰ ॥",
      "s": 7
    },
    {
      "t": "ਰਾਗੜਦੰਗ ਰਾਮੰ ਤਾਗੜਦੰਗ ਤਾਤੰ ॥",
      "s": 7
    },
    {
      "t": "ਬਾਗੜਦੰਗ ਬਾਣੰ ਛਾਗੜਦੰਗ ਛੋਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਆਗੜਦੰਗ ਆਕਾਸ ਤੇ ਜਾਨ ਓਰੇ ॥੫੭੫॥",
      "s": 7
    },
    {
      "t": "ਬਾਗੜਦੰਗ ਬਾਜੀ ਰਥੀ ਬਾਣ ਕਾਟੇ ॥",
      "s": 7
    },
    {
      "t": "ਗਾਗੜਦੰਗ ਗਾਜੀ ਗਜੀ ਵੀਰ ਡਾਟੇ ॥",
      "s": 7
    },
    {
      "t": "ਮਾਗੜਦੰਗ ਮਾਰੇ ਸਾਗੜਦੰਗ ਸੂਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਬਾਗੜਦੰਗ ਬਯਾਹੈਂ ਹਾਗੜਦੰਗ ਹੂਰੰ ॥੫੭੬॥",
      "s": 7
    },
    {
      "t": "ਜਾਗੜਦੰਗ ਜੀਤਾ ਖਾਗੜਦੰਗ ਖੇਤੰ ॥",
      "s": 7
    },
    {
      "t": "ਭਾਗੜਦੰਗ ਭਾਗੇ ਕਾਗੜਦੰਗ ਕੇਤੰ ॥",
      "s": 7
    },
    {
      "t": "ਸਾਗੜਦੰਗ ਸੂਰਾਨੁ ਜੁੰਆਨ ਪੇਖਾ ॥",
      "s": 7
    },
    {
      "t": "ਪਾਗੜਦੰਗ ਪ੍ਰਾਨਾਨ ਤੇ ਪ੍ਰਾਨ ਲੇਖਾ ॥੫੭੭॥",
      "s": 7
    },
    {
      "t": "ਚਾਗੜਦੰਗ ਚਿੰਤੰ ਪਾਗੜਦੰਗ ਪ੍ਰਾਜੀ ॥",
      "s": 7
    },
    {
      "t": "ਸਾਗੜਦੰਗ ਸੈਨਾ ਲਾਗੜਦੰਗ ਲਾਜੀ ॥",
      "s": 7
    },
    {
      "t": "ਸਾਗੜਦੰਗ ਸੁਗ੍ਰੀਵ ਤੇ ਆਦਿ ਲੈ ਕੈ ॥",
      "s": 7
    },
    {
      "t": "ਕਾਗੜਦੰਗ ਕੋਪੇ ਤਾਗੜਦੰਗ ਤੈ ਕੈ ॥੫੭੮॥",
      "s": 7
    },
    {
      "t": "ਹਾਗੜਦੰਗ ਹਨੂ ਕਾਗੜਦੰਗ ਕੋਪਾ ॥",
      "s": 7
    },
    {
      "t": "ਬਾਗੜਦੰਗ ਬੀਰਾ ਨਮੋ ਪਾਵ ਰੋਪਾ ॥",
      "s": 7
    },
    {
      "t": "ਸਾਗੜਦੰਗ ਸੂਰੰ ਹਾਗੜਦੰਗ ਹਾਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਤਾਗੜਦੰਗ ਤੈ ਕੈ ਹਨੂ ਤਉ ਪੁਕਾਰੇ ॥੫੭੯॥",
      "s": 7
    },
    {
      "t": "ਸਾਗੜਦੰਗ ਸੁਨਹੋ ਰਾਗੜਦੰਗ ਰਾਮੰ ॥",
      "s": 7
    },
    {
      "t": "ਦਾਗੜਦੰਗ ਦੀਜੇ ਪਾਗੜਦੰਗ ਪਾਨੰ ॥",
      "s": 7
    }
  ]
}
