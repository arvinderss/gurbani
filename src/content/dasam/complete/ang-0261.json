{
  "page": 261,
  "lines": [
    {
      "t": "ਪਾਗੜਦੰਗ ਪੀਠੰ ਠਾਗੜਦੰਗ ਠੋਕੋ ॥",
      "s": 7
    },
    {
      "t": "ਹਰੋ ਆਜ ਪਾਨੰ ਸੁਰੰ ਮੋਹ ਲੋਕੋ ॥੫੮੦॥",
      "s": 7
    },
    {
      "t": "ਆਗੜਦੰਗ ਐਸੇ ਕਹਯੋ ਅਉ ਉਡਾਨੋ ॥",
      "s": 7
    },
    {
      "t": "ਗਾਗੜਦੰਗ ਗੈਨੰ ਮਿਲਯੋ ਮਧ ਮਾਨੋ ॥",
      "s": 7
    },
    {
      "t": "ਰਾਗੜਦੰਗ ਰਾਮੰ ਆਗੜਦੰਗ ਆਸੰ ॥",
      "s": 7
    },
    {
      "t": "ਬਾਗੜਦੰਗ ਬੈਠੇ ਨਾਗੜਦੰਗ ਨਿਰਾਸੰ ॥੫੮੧॥",
      "s": 7
    },
    {
      "t": "ਆਗੜਦੰਗ ਆਗੇ ਕਾਗੜਦੰਗ ਕੋਊ ॥",
      "s": 7
    },
    {
      "t": "ਮਾਗੜਦੰਗ ਮਾਰੇ ਸਾਗੜਦੰਗ ਸੋਊ ॥",
      "s": 7
    },
    {
      "t": "ਨਾਗੜਦੰਗ ਨਾਕੀ ਤਾਗੜਦੰਗ ਤਾਲੰ ॥",
      "s": 7
    },
    {
      "t": "ਮਾਗੜਦੰਗ ਮਾਰੇ ਬਾਗੜਦੰਗ ਬਿਸਾਲੰ ॥੫੮੨॥",
      "s": 7
    },
    {
      "t": "ਆਗੜਦੰਗ ਏਕੰ ਦਾਗੜਦੰਗ ਦਾਨੋ ॥",
      "s": 7
    },
    {
      "t": "ਚਾਗੜਦੰਗ ਚੀਰਾ ਦਾਗੜਦੰਗ ਦੁਰਾਨੋ ॥",
      "s": 7
    },
    {
      "t": "ਦਾਗੜਦੰਗ ਦੋਖੀ ਬਾਗੜਦੰਗ ਬੂਟੀ ॥",
      "s": 7
    },
    {
      "t": "ਆਗੜਦੰਗ ਹੈ ਏਕ ਤੇ ਏਕ ਜੂਟੀ ॥੫੮੩॥",
      "s": 7
    },
    {
      "t": "ਚਾਗੜਦੰਗ ਚਉਕਾ ਹਾਗੜਦੰਗ ਹਨਵੰਤਾ ॥",
      "s": 7
    },
    {
      "t": "ਜਾਗੜਦੰਗ ਜੋਧਾ ਮਹਾ ਤੇਜ ਮੰਤਾ ॥",
      "s": 7
    },
    {
      "t": "ਆਗੜਦੰਗ ਉਖਾਰਾ ਪਾਗੜਦੰਗ ਪਹਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਆਗੜਦੰਗ ਲੈ ਅਉਖਧੀ ਕੋ ਸਿਧਾਰੰ ॥੫੮੪॥",
      "s": 7
    },
    {
      "t": "ਆਗੜਦੰਗ ਆਏ ਜਹਾ ਰਾਮ ਖੇਤੰ ॥",
      "s": 7
    },
    {
      "t": "ਬਾਗੜਦੰਗ ਬੀਰੰ ਜਹਾ ਤੇ ਅਚੇਤੰ ॥",
      "s": 7
    },
    {
      "t": "ਬਾਗੜਦੰਗ ਬਿਸਲਯਾ ਮਾਗੜਦੰਗ ਮੁਖੰ ॥",
      "s": 7
    },
    {
      "t": "ਡਾਗੜਦੰਗ ਡਾਰੀ ਸਾਗੜਦੰਗ ਸੁਖੰ ॥੫੮੫॥",
      "s": 7
    },
    {
      "t": "ਜਾਗੜਦੰਗ ਜਾਗੇ ਸਾਗੜਦੰਗ ਸੂਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਘਾਗੜਦੰਗ ਘੁਮੀ ਹਾਗੜਦੰਗ ਹੂਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਛਾਗੜਦੰਗ ਛੂਟੇ ਨਾਗੜਦੰਗ ਨਾਦੰ ॥",
      "s": 7
    },
    {
      "t": "ਬਾਗੜਦੰਗ ਬਾਜੇ ਨਾਗੜਦੰਗ ਨਾਦੰ ॥੫੮੬॥",
      "s": 7
    },
    {
