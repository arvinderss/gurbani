      "s": 7
    },
    {
      "t": "ਮਿਲੈ ਮੋਹਿ ਸੀਤਾ ॥",
      "s": 7
    },
    {
      "t": "ਚਲੈ ਧਰਮ ਗੀਤਾ ॥",
      "s": 7
    },
    {
      "t": "ਪਠਯੋ ਪਉਨ ਪੂਤੰ ॥",
      "s": 7
