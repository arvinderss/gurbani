{
  "page": 270,
  "lines": [
    {
      "t": "ਸੀਤਾ ਰਵਨ ਕਹਾ ਹੈ ॥੬੬੭॥",
      "s": 7
    },
    {
      "t": "ਮਾਦਰ ਖੁਸਾਲ ਖਾਤਰ ॥",
      "s": 7
    },
    {
      "t": "ਕੀਨੇ ਹਜਾਰ ਛਾਵਰ ॥",
      "s": 7
    },
    {
      "t": "ਮਾਤੁਰ ਸਿਤਾ ਬਧਾਈ ॥",
      "s": 7
    },
    {
      "t": "ਵਹ ਗੁਲ ਚਿਹਰ ਕਹਾ ਹੈ ॥੬੬੮॥",
      "s": 7
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਰਾਮ ਅਵਤਾਰ ਸੀਤਾ ਅਯੁਧਿਆ ਆਗਮ ਨਾਮ ਧਿਆਇ ਸਮਾਪਤੰ ॥",
      "s": 7
    },
    {
      "t": "ਅਥ ਮਾਤਾ ਮਿਲਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਰਸਾਵਲ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਸੁਨੇ ਰਾਮ ਆਏ ॥",
      "s": 7
    },
    {
      "t": "ਸਭੈ ਲੋਗ ਧਾਏ ॥",
      "s": 7
    },
    {
      "t": "ਲਗੇ ਆਨ ਪਾਯੰ ॥",
      "s": 7
    },
    {
      "t": "ਮਿਲੇ ਰਾਮ ਰਾਯੰ ॥੬੬੯॥",
      "s": 7
    },
    {
      "t": "ਕੋਊ ਚਉਰ ਢਾਰੈਂ ॥",
      "s": 7
    },
    {
      "t": "ਕੋਊ ਪਾਨ ਖੁਆਰੈਂ ॥",
      "s": 7
    },
    {
      "t": "ਪਰੇ ਮਾਤ ਪਾਯੰ ॥",
      "s": 7
    },
    {
      "t": "ਲਏ ਕੰਠ ਲਾਯੰ ॥੬੭੦॥",
      "s": 7
    },
    {
      "t": "ਮਿਲੈ ਕੰਠ ਰੋਵੈਂ ॥",
      "s": 7
    },
    {
      "t": "ਮਨੋ ਸੋਕ ਧੋਵੈਂ ॥",
      "s": 7
    },
    {
      "t": "ਕਰੈਂ ਬੀਰ ਬਾਤੈਂ ॥",
      "s": 7
    },
    {
      "t": "ਸੁਨੇ ਸਰਬ ਮਾਤੈਂ ॥੬੭੧॥",
      "s": 7
    },
    {
      "t": "ਮਿਲੈ ਲਛ ਮਾਤੰ ॥",
      "s": 7
    },
    {
      "t": "ਪਰੇ ਪਾਇ ਭ੍ਰਾਤੰ ॥",
      "s": 7
    },
    {
      "t": "ਕਰਿਯੋ ਦਾਨ ਏਤੋ ॥",
      "s": 7
    },
    {
      "t": "ਗਨੈ ਕਉਨ ਕੇਤੋ ॥੬੭੨॥",
      "s": 7
    }
  ]
}
