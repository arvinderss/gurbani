{
  "page": 271,
  "lines": [
    {
      "t": "ਮਿਲੇ ਭਰਥ ਮਾਤੰ ॥",
      "s": 7
    },
    {
      "t": "ਕਹੀ ਸਰਬ ਬਾਤੰ ॥",
      "s": 7
    },
    {
      "t": "ਧਨੰ ਮਾਤ ਤੋ ਕੋ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਅਰਿਣੀ ਕੀਨ ਮੋ ਕੋ ॥੬੭੩॥",
      "s": 7
    },
    {
      "t": "ਕਹਾ ਦੋਸ ਤੇਰੈ ॥",
      "s": 7
    },
    {
      "t": "ਲਿਖੀ ਲੇਖ ਮੇਰੈ ॥",
      "s": 7
    },
    {
      "t": "ਹੁਨੀ ਹੋ ਸੁ ਹੋਈ ॥",
      "s": 7
    },
    {
      "t": "ਕਹੈ ਕਉਨ ਕੋਈ ॥੬੭੪॥",
      "s": 7
    },
    {
      "t": "ਕਰੋ ਬੋਧ ਮਾਤੰ ॥",
      "s": 7
    },
    {
      "t": "ਮਿਲਯੋ ਫੇਰਿ ਭ੍ਰਾਤੰ ॥",
      "s": 7
    },
    {
      "t": "ਸੁਨਯੋ ਭਰਥ ਧਾਏ ॥",
      "s": 7
    },
    {
      "t": "ਪਗੰ ਸੀਸ ਲਾਏ ॥੬੭੫॥",
      "s": 7
    },
    {
      "t": "ਭਰੇ ਰਾਮ ਅੰਕੰ ॥",
      "s": 7
    },
    {
      "t": "ਮਿਟੀ ਸਰਬ ਸੰਕੰ ॥",
      "s": 7
    },
    {
      "t": "ਮਿਲਯੰ ਸਤ੍ਰ ਹੰਤਾ ॥",
      "s": 7
    },
    {
      "t": "ਸਰੰ ਸਾਸਤ੍ਰ ਗੰਤਾ ॥੬੭੬॥",
      "s": 7
    },
    {
      "t": "ਜਟੰ ਧੂਰ ਝਾਰੀ ॥",
      "s": 7
    },
    {
      "t": "ਪਗੰ ਰਾਮ ਰਾਰੀ ॥",
      "s": 7
    },
    {
      "t": "ਕਰੀ ਰਾਜ ਅਰਚਾ ॥",
      "s": 7
    },
    {
      "t": "ਦਿਜੰ ਬੇਦ ਚਰਚਾ ॥੬੭੭॥",
      "s": 7
    },
    {
      "t": "ਕਰੈਂ ਗੀਤ ਗਾਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਭਰੇ ਵੀਰ ਮਾਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਦੀਯੰ ਰਾਮ ਰਾਜੰ ॥",
      "s": 7
    },
    {
      "t": "ਸਰੇ ਸਰਬ ਕਾਜੰ ॥੬੭੮॥",
      "s": 7
    },
    {
      "t": "ਬੁਲੈ ਬਿਪ ਲੀਨੇ ॥",
      "s": 7
    },
    {
      "t": "ਸ੍ਰੁਤੋਚਾਰ ਕੀਨੇ ॥",
      "s": 7
    },
    {
      "t": "ਭਏ ਰਾਮ ਰਾਜਾ ॥",
      "s": 7
    },
    {
      "t": "ਬਜੇ ਜੀਤ ਬਾਜਾ ॥੬੭੯॥",
      "s": 7
    },
    {
      "t": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਚਹੂੰ ਚਕ ਕੇ ਛਤ੍ਰਧਾਰੀ ਬੁਲਾਏ ॥",
      "s": 7
    },
    {
      "t": "ਧਰੇ ਅਤ੍ਰ ਨੀਕੇ ਪੁਰੀ ਅਉਧ ਆਏ ॥",
      "s": 7
    },
    {
      "t": "ਗਹੇ ਰਾਮ ਪਾਯੰ ਪਰਮ ਪ੍ਰੀਤ ਕੈ ਕੈ ॥",
      "s": 7
    },
    {
      "t": "ਮਿਲੇ ਚਤ੍ਰ ਦੇਸੀ ਬਡੀ ਭੇਟ ਦੈ ਕੈ ॥੬੮੦॥",
      "s": 7
    },
    {
      "t": "ਦਏ ਚੀਨ ਮਾਚੀਨ ਚੀਨੰਤ ਦੇਸੰ ॥",
      "s": 7
    },
    {
      "t": "ਮਹਾ ਸੁੰਦ੍ਰੀ ਚੇਰਕਾ ਚਾਰ ਕੇਸੰ ॥",
      "s": 7
    },
    {
      "t": "ਮਨੰ ਮਾਨਕੰ ਹੀਰ ਚੀਰੰ ਅਨੇਕੰ ॥",
      "s": 7
    },
    {
      "t": "ਕੀਏ ਖੇਜ ਪਈਯੈ ਕਹੂੰ ਏਕ ਏਕੰ ॥੬੮੧॥",
      "s": 7
    },
    {
      "t": "ਮਨੰ ਮੁਤੀਯੰ ਮਾਨਕੰ ਬਾਜ ਰਾਜੰ ॥",
      "s": 7
    },
    {
      "t": "ਦਏ ਦੰਤਪੰਤੀ ਸਜੇ ਸਰਬ ਸਾਜੰ ॥",
      "s": 7
    },
    {
      "t": "ਰਥੰ ਬੇਸਟੰ ਹੀਰ ਚੀਰੰ ਅਨੰਤੰ ॥",
      "s": 7
    },
    {
      "t": "ਮਨੰ ਮਾਨਕੰ ਬਧ ਰਧੰ ਦੁਰੰਤੰ ॥੬੮੨॥",
      "s": 7
    },
    {
      "t": "ਕਿਤੇ ਸ੍ਵੇਤ ਐਰਾਵਤੰ ਤੁਲਿ ਦੰਤੀ ॥",
      "s": 7
    },
    {
      "t": "ਦਏ ਮੁਤਯੰ ਸਾਜ ਸਜੇ ਸੁਪੰਤੀ ॥",
      "s": 7
    },
    {
      "t": "ਕਿਤੇ ਬਾਜ ਰਾਜੰ ਜਰੀ ਜੀਨ ਸੰਗੰ ॥",
      "s": 7
    },
    {
      "t": "ਨਚੈ ਨਟ ਮਾਨੋ ਮਚੇ ਜੰਗ ਰੰਗੰ ॥੬੮੩॥",
      "s": 7
    },
    {
      "t": "ਕਿਤੇ ਪਖਰੇ ਪੀਲ ਰਾਜਾ ਪ੍ਰਮਾਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਦਏ ਬਾਜ ਰਾਜੀ ਸਿਰਾਜੀ ਨ੍ਰਿਪਾਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਦਈ ਰਕਤ ਨੀਲੰ ਮਣੀ ਰੰਗ ਰੰਗੰ ॥",
      "s": 7
    }
  ]
}
