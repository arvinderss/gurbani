  "lines": [
    {
      "t": "ਚਿਕਾਰ ਚਾਵਡੀ ਨਭੰ ਫਿਕੰਤ ਫਿੰਕਰੀ ਫਿਰੰ ॥",
      "v": [
        [
          2,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਭਕਾਰ ਭੂਤ ਪ੍ਰੇਤਣੰ ਡਿਕਾਰ ਡਾਕਣੀ ਡੁਲੰ ॥੭੯੨॥",
      "v": [
        [
          2,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਗਿਰੈ ਧਰੰ ਧੁਰੰ ਧਰੰ ਧਰਾ ਧਰੰ ਧਰੰ ਜਿਵੰ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਭਭਜਿ ਸ੍ਰਉਣਤੰ ਤਣੈ ਉਠੰਤ ਭੈ ਕਰੀ ਧੁਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਉਠੰਤ ਗਦ ਸਦਣੰ ਨਨਦ ਨਿਫਿਰੰ ਰਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਬਬਰਖ ਸਾਇਕੰ ਸਿਤੰ ਘੁਮੰਤ ਜੋਧਣੋ ਬ੍ਰਣੰ ॥੭੯੩॥",
      "v": [
        [
          2,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਭਜੰਤ ਭੈ ਧਰੰ ਭਟੰ ਬਿਲੋਕ ਭਰਥਣੋ ਰਣੰ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਚਲਯੋ ਚਿਰਾਇ ਕੈ ਚਪੀ ਬਬਰਖ ਸਾਇਕੋ ਸਿਤੰ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਸੁ ਕ੍ਰੁਧ ਸਾਇਕੰ ਸਿਸੰ ਬਬਧ ਭਾਲਣੋ ਭਟੰ ॥",
      "s": 7
    },
    {
      "t": "ਪਪਾਤ ਪ੍ਰਿਥਵੀਯੰ ਹਠੀ ਮਮੋਹ ਆਸ੍ਰ ਮੰਗਤੰ ॥੭੯੪॥",
      "v": [
        [
          2,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕੇ ਰਾਮਾਵਤਾਰੇ ਭਰਥ ਬਧਹਿ ਧਿਆਇ ਸਮਾਪਤੰ ॥",
      "s": 7
    },
    {
      "t": "ਅਨੂਪ ਨਰਾਜ ਛੰਦ",
      "s": 7
    },
    {
      "t": "ਭਭਜਿ ਭੀਤਣੋ ਭਟੰ ਤਤਜਿ ਭਰਥਣੋ ਭੂਅੰ ॥",
      "s": 7
    },
    {
      "t": "ਗਿਰੰਤ ਲੁਥਤੰ ਉਠੰ ਰੁਰੋਦ ਰਾਘਵੰ ਤਟੰ ॥",
      "s": 7
    },
    {
      "t": "ਜੁਝੇ ਸੁ ਭ੍ਰਾਤ ਭਰਥਣੋ ਸੁਣੰਤ ਜਾਨਕੀ ਪਤੰ ॥",
