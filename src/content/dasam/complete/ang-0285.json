    {
      "t": "ਭੂਖਨ ਅੰਗ ਅਨੂਪ ਉਤਾਰੇ ॥੮੧੮॥",
      "s": 7
    },
    {
      "t": "ਮੂਰਛ ਭਏ ਸਭ ਲਏ ਉਠਈ ॥",
      "s": 7
    },
    {
      "t": "ਬਾਜ ਸਹਿਤ ਤਹ ਗੇ ਜਹ ਮਾਈ ॥",
      "s": 7
    },
    {
      "t": "ਦੇਖਿ ਸੀਆ ਪਤਿ ਮੁਖ ਰੋ ਦੀਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਕਹਯੋ ਪੂਤ ਬਿਧਵਾ ਮੁਹਿ ਕੀਨਾ ॥੮੧੯॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕੇ ਰਾਮਵਤਾਰ ਲਵ ਬਾਜ ਬਾਧਵੇ ਰਾਮ ਬਧਹ ॥",
      "s": 7
    },
    {
      "t": "ਅਥ ਸੀਤਾ ਨੇ ਸਭ ਜੀਵਾਏ ਕਥਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਸੀਤਾ ਬਾਚ ਪੁਤ੍ਰਨ ਸੋ ॥",
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਅਬ ਮੋ ਕਉ ਕਾਸਟ ਦੇ ਆਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਜਰਉ ਲਾਗਿ ਪਹਿ ਹੋਊਾਂ ਮਸਾਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਸੁਨਿ ਮੁਨਿ ਰਾਜ ਬਹੁਤ ਬਿਧਿ ਰੋਏ ॥",
      "s": 7
    },
    {
      "t": "ਇਨ ਬਾਲਨ ਹਮਰੇ ਸੁਖ ਖੋਏ ॥੮੨੦॥",
      "s": 7
    },
    {
      "t": "ਜਬ ਸੀਤਾ ਤਨ ਚਹਾ ਕਿ ਕਾਢੂੰ ॥",
      "s": 7
    },
