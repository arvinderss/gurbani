        ]
      ],
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਬਹੁਤੁ ਭਾਤਿ ਕਰ ਸਿਸਨ ਸਮੋਧਾ ॥",
      "s": 7
    },
    {
      "t": "ਸੀਯ ਰਘੁਬੀਰ ਚਲੇ ਪੁਰਿ ਅਉਧਾ ॥",
      "s": 7
    },
    {
      "t": "ਅਨਿਕ ਬੇਖ ਸੇ ਸਸਤ੍ਰ ਸੁਹਾਏ ॥",
      "s": 7
    },
    {
      "t": "ਜਾਨਤ ਤੀਨ ਰਾਮ ਬਨ ਆਏ ॥੮੨੮॥",
      "s": 7
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕੇ ਰਾਮਵਤਾਰੇ ਤਿਹੂ ਭਿਰਾਤਨ ਸੈਨਾ ਸਹਿਤ ਜੀਬੋ ॥",
      "s": 7
    },
    {
      "t": "ਸੀਤਾ ਦੁਹੂ ਪੁਤ੍ਰਨ ਸਹਿਤ ਪੁਰੀ ਅਵਧ ਪ੍ਰਵੇਸ ਕਥਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਹੂੰ ਮਾਤ ਕੰਠਨ ਸੋ ਲਾਏ ॥",
      "s": 7
    },
    {
      "t": "ਦੋਊ ਪੁਤ੍ਰ ਪਾਇਨ ਲਪਟਾਏ ॥",
      "s": 7
    },
    {
      "t": "ਬਹੁਰ ਆਨਿ ਸੀਤਾ ਪਗ ਪਰੀ ॥",
      "s": 7
    },
    {
      "t": "ਮਿਟ ਗਈ ਤਹੀਂ ਦੁਖਨ ਕੀ ਘਰੀ ॥੮੨੯॥",
      "s": 7
    },
    {
      "t": "ਬਾਜ ਮੇਧ ਪੂਰਨ ਕੀਅ ਜਗਾ ॥",
      "s": 7
    },
    {
      "t": "ਕਉਸਲੇਸ ਰਘੁਬੀਰ ਅਭਗਾ ॥",
      "s": 7
    },
    {
      "t": "ਗ੍ਰਿਹ ਸਪੂਤ ਦੋ ਪੂਤ ਸੁਹਾਏ ॥",
      "s": 7
    },
    {
      "t": "ਦੇਸ ਬਿਦੇਸ ਜੀਤ ਗ੍ਰਹ ਆਏ ॥੮੩੦॥",
      "s": 7
    },
    {
      "t": "ਜੇਤਿਕ ਕਹੇ ਸੁ ਜਗ ਬਿਧਾਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਬਿਧ ਪੂਰਬ ਕੀਨੇ ਤੇ ਨਾਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਏਕ ਘਾਟ ਸਤ ਕੀਨੇ ਜਗਾ ॥",
      "s": 7
    },
    {
      "t": "ਚਟ ਪਟ ਚਕ੍ਰ ਇੰਦ੍ਰ ਉਠਿ ਭਗਾ ॥੮੩੧॥",
      "s": 7
    },
    {
      "t": "ਰਾਜਸੁਇ ਕੀਨੇ ਦਸ ਬਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਬਾਜ ਮੇਧਿ ਇਕੀਸ ਪ੍ਰਕਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਗਵਾਲੰਭ ਅਜਮੇਧ ਅਨੇਕਾ ॥",
      "s": 7
    }
