    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਜੈਸ ਮ੍ਰਿਤਕ ਕੇ ਹੁਤੇ ਪ੍ਰਕਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਤੈਸੇਈ ਕਰੇ ਬੇਦ ਅਨੁਸਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਰਾਮ ਸਪੂਤ ਜਾਹਿੰ ਘਰ ਮਾਹੀ ॥",
      "s": 7
    },
    {
      "t": "ਤਾਕਹੁ ਤੋਟ ਕੋਊ ਕਹ ਨਾਹੀ ॥੮੪੨॥",
      "s": 7
    },
    {
      "t": "ਬਹੁ ਬਿਧਿ ਗਤਿ ਕੀਨੀ ਪ੍ਰਭ ਮਾਤਾ ॥",
      "s": 7
    },
    {
      "t": "ਤਬ ਲਉ ਭਈ ਕੈਕਈ ਸਾਤਾ ॥",
      "s": 7
    },
    {
      "t": "ਤਾ ਕੇ ਮਰਤ ਸੁਮਿਤ੍ਰਾ ਮਰੀ ॥",
      "s": 7
    },
    {
      "t": "ਦੇਖਹੁ ਕਾਲ ਕ੍ਰਿਆ ਕਸ ਕਰੀ ॥੮੪੩॥",
      "s": 7
    },
    {
      "t": "ਏਕ ਦਿਵਸ ਜਾਨਕਿ ਤ੍ਰਿਯ ਸਿਖਾ ॥",
      "s": 7
    },
    {
      "t": "ਭੀਤ ਭਏ ਰਾਵਣ ਕਹ ਲਿਖਾ ॥",
      "s": 7
    },
    {
      "t": "ਜਬ ਰਘੁਬਰ ਤਿਹ ਆਨ ਨਿਹਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਕਛੁਕ ਕੋਪ ਇਮ ਬਚਨ ਉਚਾਰਾ ॥੮੪੪॥",
      "s": 7
    },
    {
      "t": "ਰਾਮ ਬਾਚ ਮਨ ਮੈ ॥",
      "s": 7
    },
    {
      "t": "ਯਾ ਕੋ ਕਛੁ ਰਾਵਨ ਸੋ ਹੋਤਾ ॥",
      "s": 7
    },
    {
      "t": "ਤਾ ਤੇ ਚਿਤ੍ਰ ਚਿਤ੍ਰਕੈ ਦੇਖਾ ॥",
      "s": 7
    },
    {
      "t": "ਬਚਨ ਸੁਨਤ ਸੀਤਾ ਭਈ ਰੋਖਾ ॥",
      "s": 7
    },
    {
      "t": "ਪ੍ਰਭ ਮੁਹਿ ਅਜਹੂੰ ਲਗਾਵਤ ਦੋਖਾ ॥੮੪੫॥",
