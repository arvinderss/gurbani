    {
      "t": "ਬੈਸ ਲਖੈ ਛਤ੍ਰੀ ਕਹ ਦੇਵਾ ॥੮੩੮॥",
      "s": 7
    },
    {
      "t": "ਸੂਦ੍ਰ ਸਭਨ ਕੀ ਸੇਵ ਕਮਾਵੈ ॥",
      "s": 7
    },
    {
      "t": "ਜਹ ਕੋਈ ਕਹੈ ਤਹੀ ਵਹ ਧਾਵੈ ॥",
      "s": 7
    },
    {
      "t": "ਜੈਸਕ ਹੁਤੀ ਬੇਦ ਸਾਸਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਨਿਕਸਾ ਤੈਸ ਰਾਮ ਕੀ ਰਸਨਾ ॥੮੩੯॥",
      "s": 7
    },
    {
      "t": "ਰਾਵਣਾਦਿ ਰਣਿ ਹਾਕ ਸੰਘਾਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਸੇਵਕ ਗਣ ਤਾਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਲੰਕਾ ਦਈ ਟੰਕ ਜਨੁ ਦੀਨੋ ॥",
      "s": 7
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਰਾਜ ਜਗਤ ਮੈ ਕੀਨੋ ॥੮੪੦॥",
      "s": 7
    },
    {
      "t": "ਦੋਹਰਾ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਬਹੁ ਬਰਖਨ ਲਉ ਰਾਮ ਜੀ ਰਾਜ ਕਰਾ ਅਰ ਟਾਲ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਬ੍ਰਹਮਰੰਧ੍ਰ ਕਹ ਫੋਰ ਕੈ ਭਯੋ ਕਉਸਲਿਆ ਕਾਲ ॥੮੪੧॥",
