{
  "page": 289,
  "lines": [
    {
      "t": "ਤਿਮ ਰਘੁਬਰ ਤਨ ਕੋ ਤਜਾ ਸ੍ਰੀ ਜਾਨਕੀ ਬਿਯੋਗ ॥੮੫੦॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਰਾਮਵਤਾਰੇ ਸੀਤਾ ਕੇ ਹੇਤ ਮ੍ਰਿਤ ਲੋਕ ਸੇ ਗਏ ਧਿਆਇ ਸਮਾਪਤੰ ॥",
      "s": 7
    },
    {
      "t": "ਅਥ ਤੀਨੋ ਭ੍ਰਾਤਾ ਤ੍ਰੀਅਨ ਸਹਿਤ ਮਰਬੋ ਕਥਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਰਉਰ ਪਰੀ ਸਗਰੇ ਪੁਰ ਮਾਹੀ ॥",
      "s": 7
    },
    {
      "t": "ਕਾਹੂੰ ਰਹੀ ਕਛੂ ਸੁਧ ਨਾਹੀ ॥",
      "s": 7
    },
    {
      "t": "ਨਰ ਨਾਰੀ ਡੋਲਤ ਦੁਖਿਆਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਜਾਨੁਕ ਗਿਰੇ ਜੂਝਿ ਜੁਝਿਆਰੇ ॥੮੫੧॥",
      "s": 7
    },
    {
      "t": "ਸਗਰ ਨਗਰ ਮਹਿ ਪਰ ਗਈ ਰਉਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਬਯਾਕੁਲ ਗਿਰੇ ਹਸਤ ਅਰੁ ਘੋਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਨਰ ਨਾਰੀ ਮਨ ਰਹਤ ਉਦਾਸਾ ॥",
      "s": 7
    },
    {
      "t": "ਕਹਾ ਰਾਮ ਕਰ ਗਏ ਤਮਾਸਾ ॥੮੫੨॥",
      "s": 7
    },
    {
      "t": "ਭਰਥਊ ਜੋਗ ਸਾਧਨਾ ਸਾਜੀ ॥",
      "s": 7
    },
    {
      "t": "ਜੋਗ ਅਗਨ ਤਨ ਤੇ ਉਪਰਾਜੀ ॥",
      "s": 7
    },
    {
      "t": "ਬ੍ਰਹਮਰੰਧ੍ਰ ਝਟ ਦੈ ਕਰ ਫੋਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਪ੍ਰਭ ਸੌ ਚਲਤ ਅੰਗ ਨਹੀ ਮੋਰਾ ॥੮੫੩॥",
      "s": 7
    },
    {
      "t": "ਸਕਲ ਜੋਗ ਕੇ ਕੀਏ ਬਿਧਾਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਲਛਮਨ ਤਜੇ ਤੈਸ ਹੀ ਪ੍ਰਾਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਬ੍ਰਹਮਰੰਧ੍ਰ ਲਵ ਅਰਿ ਫੁਨ ਫੂਟਾ ॥",
      "s": 7
    },
    {
      "t": "ਪ੍ਰਭ ਚਰਨਨ ਤਰ ਪ੍ਰਾਨ ਨਿਖੂਟਾ ॥੮੫੪॥",
      "s": 7
    },
    {
      "t": "ਲਵ ਕੁਸ ਦੋਊ ਤਹਾ ਚਲ ਗਏ ॥",
      "s": 7
    },
    {
      "t": "ਰਘੁਬਰ ਸੀਅਹਿ ਜਰਾਵਤ ਭਏ ॥",
      "s": 7
    },
    {
      "t": "ਅਰ ਪਿਤ ਭ੍ਰਾਤ ਤਿਹੂੰ ਕਹ ਦਹਾ ॥",
      "s": 7
    },
    {
      "t": "ਰਾਜ ਛਤ੍ਰ ਲਵ ਕੇ ਸਿਰ ਰਹਾ ॥੮੫੫॥",
      "s": 7
    },
    {
      "t": "ਤਿਹੂੰਅਨ ਕੀ ਇਸਤ੍ਰੀ ਤਿਹ ਆਈ ॥",
      "s": 7
    },
    {
      "t": "ਸੰਗਿ ਸਤੀ ਹ੍ਵੈ ਸੁਰਗ ਸਿਧਾਈ ॥",
      "s": 7
    },
    {
      "t": "ਲਵ ਸਿਰ ਧਰਾ ਰਾਜ ਕਾ ਸਾਜਾ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਹੂੰਅਨ ਤਿਹੂੰ ਕੁੰਟ ਕੀਅ ਰਾਜਾ ॥੮੫੬॥",
      "s": 7
    },
    {
      "t": "ਉਤਰ ਦੇਸ ਆਪੁ ਕੁਸ ਲੀਆ ॥",
      "s": 7
    },
    {
      "t": "ਭਰਥ ਪੁਤ੍ਰ ਕਹ ਪੂਰਬ ਦੀਆ ॥",
      "s": 7
    },
    {
      "t": "ਦਛਨ ਦੀਅ ਲਛਨ ਕੇ ਬਾਲਾ ॥",
      "s": 7
    },
    {
      "t": "ਪਛਮ ਸਤ੍ਰੁਘਨ ਸੁਤ ਬੈਠਾਲਾ ॥੮੫੭॥",
      "s": 7
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਰਾਮ ਕਥਾ ਜੁਗ ਜੁਗ ਅਟਲ ਸਭ ਕੋਈ ਭਾਖਤ ਨੇਤ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਸੁਰਗ ਬਾਸ ਰਘੁਬਰ ਕਰਾ ਸਗਰੀ ਪੁਰੀ ਸਮੇਤ ॥੮੫੮॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਇਤਿ ਰਾਮ ਭਿਰਾਤ ਤ੍ਰੀਅਨ ਸਹਿਤ ਸੁਰਗ ਗਏ ਅਰ ਸਗਰੀ ਪੁਰੀ ਸਹਿਤ ਸੁਰਗ ਗਏ ਧਿਆਇ ਸਮਾਪਤਮ ॥",
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਜੋ ਇਹ ਕਥਾ ਸੁਨੈ ਅਰੁ ਗਾਵੈ ॥",
      "s": 7
    },
    {
      "t": "ਦੂਖ ਪਾਪ ਤਿਹ ਨਿਕਟਿ ਨ ਆਵੈ ॥",
      "s": 7
    },
    {
      "t": "ਬਿਸਨ ਭਗਤਿ ਕੀ ਏ ਫਲ ਹੋਈ ॥",
      "s": 7
    },
    {
      "t": "ਆਧਿ ਬਯਾਧਿ ਛ੍ਵੈ ਸਕੈ ਨ ਕੋਇ ॥੮੫੯॥",
      "s": 7
    },
    {
      "t": "ਸੰਮਤ ਸਤ੍ਰਹ ਸਹਸ ਪਚਾਵਨ ॥",
      "s": 7
    },
    {
      "t": "ਹਾੜ ਵਦੀ ਪ੍ਰਿਥਮੈ ਸੁਖ ਦਾਵਨ ॥",
      "s": 7
    },
    {
      "t": "ਤ੍ਵ ਪ੍ਰਸਾਦਿ ਕਰਿ ਗ੍ਰੰਥ ਸੁਧਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਭੂਲ ਪਰੀ ਲਹੁ ਲੇਹੁ ਸੁਧਾਰਾ ॥੮੬੦॥",
