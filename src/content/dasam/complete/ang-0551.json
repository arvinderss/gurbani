{
  "page": 551,
  "lines": [
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਦਸਮ ਸਿਕੰਧ ਪੁਰਾਣੇ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਕ੍ਰਿਸਨਾਵਤਾਰੇ ਧਯਾਇ ਇਕੀਸਵੋ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥",
      "s": 7
    },
    {
      "t": "ਚੌਬੀਸ ਅਵਤਾਰ ॥",
      "s": 7
    },
    {
      "t": "ੴ ਵਾਹਿਗੁਰੂ ਜੀ ਕੀ ਫਤਹ ॥",
      "s": 7
    },
    {
      "t": "ਅਥ ਨਰ ਅਵਤਾਰ ਕਥਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਅਬ ਬਾਈਸ੍ਵੋ ਗਨਿ ਅਵਤਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਜੈਸ ਰੂਪ ਕਹੁ ਧਰੋ ਮੁਰਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਨਰ ਅਵਤਾਰ ਭਯੋ ਅਰਜੁਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਜਿਹ ਜੀਤੇ ਜਗ ਕੇ ਭਟ ਗਨਾ ॥੧॥",
      "s": 7
    },
    {
      "t": "ਪ੍ਰਿਥਮ ਨਿਵਾਤ ਕਵਚ ਸਭ ਮਾਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਇੰਦ੍ਰ ਤਾਤ ਕੇ ਸੋਕ ਨਿਵਾਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਬਹੁਰੇ ਜੁਧ ਰੁਦ੍ਰ ਤਨ ਕੀਆ ॥",
      "s": 7
    },
    {
      "t": "ਰੀਝੈ ਭੂਤਿ ਰਾਟ ਬਰੁ ਦੀਆ ॥੨॥",
      "s": 7
    },
    {
      "t": "ਬਹੁਰਿ ਦੁਰਜੋਧਨ ਕਹ ਮੁਕਤਾਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਗੰਧ੍ਰਬ ਰਾਜ ਬਿਮੁਖ ਫਿਰਿ ਆਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਖਾਡਵ ਬਨ ਪਾਵਕਹਿ ਚਰਾਵਾ ॥",
      "s": 7
    },
    {
      "t": "ਬੂੰਦ ਏਕ ਪੈਠੈ ਨਹਿ ਪਾਵਾ ॥੩॥",
      "s": 7
    },
    {
      "t": "ਜਉ ਕਹਿ ਕਥਾ ਪ੍ਰਸੰਗ ਸੁਨਾਊ ॥",
      "s": 7
    },
    {
      "t": "ਗ੍ਰੰਥ ਬਢਨ ਤੇ ਹ੍ਰਿਦੈ ਡਰਾਊ ॥",
      "s": 7
    },
    {
      "t": "ਤਾ ਤੇ ਥੋਰੀ ਕਥਾ ਕਹਾਈ ॥",
      "s": 7
    },
    {
      "t": "ਭੂਲ ਦੇਖਿ ਕਬਿ ਲੇਹੁ ਬਨਾਈ ॥੪॥",
      "s": 7
    },
    {
      "t": "ਕਊਰਵ ਜੀਤਿ ਗਾਵ ਸਬ ਆਨੀ ॥",
      "s": 7
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਤਿਨ ਮਹਿ ਅਭਿਮਾਨੀ ॥",
      "s": 7
    },
    {
      "t": "ਕ੍ਰਿਸਨ ਚੰਦ ਕਹੁ ਬਹੁਰਿ ਰਿਝਾਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਜਾ ਤੈ ਜੈਤਪਤ੍ਰ ਕਹੁ ਪਾਯੋ ॥੫॥",
      "s": 7
    },
    {
      "t": "ਗਾਗੇਵਹਿ ਭਾਨੁਜ ਕਹੁ ਮਾਰ੍ਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਘੋਰ ਭਯਾਨ ਅਯੋਧਨ ਪਾਰ੍ਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਦੁਰਜੋਧਨ ਜੀਤਾ ਅਤਿ ਬਲਾ ॥",
      "s": 7
    }
  ]
}
