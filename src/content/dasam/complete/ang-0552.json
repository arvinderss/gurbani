{
  "page": 552,
  "lines": [
    {
      "t": "ਪਾਵਤ ਭਯੋ ਰਾਜ ਅਬਿਚਲਾ ॥੬॥",
      "s": 7
    },
    {
      "t": "ਕਹ ਲਗਿ ਕਰਤ ਕਥਾ ਕਹੁ ਜਾਊ ॥",
      "s": 7
    },
    {
      "t": "ਗ੍ਰੰਥ ਬਢਨ ਤੇ ਅਧਿਕ ਡਰਾਊ ॥",
      "s": 7
    },
    {
      "t": "ਕਥਾ ਬ੍ਰਿਧ ਕਸ ਕਰੌ ਬਿਚਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਬਾਈਸਵੋ ਅਰਜੁਨ ਅਵਤਾਰਾ ॥੭॥",
      "s": 7
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਨਰ ਅਵਤਾਰ ਬਾਈਸਵੋ ਸੰਪੂਰਣੰ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੨॥",
      "s": 7
    },
    {
      "t": "ਅਥ ਬਊਧ ਅਵਤਾਰ ਤੇਈਸਵੌ ਕਥਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਅਬ ਮੈ ਗਨੋ ਬਊਧ ਅਵਤਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਜੈਸ ਰੂਪ ਕਹੁ ਧਰਾ ਮੁਰਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਬਊਧ ਅਵਤਾਰ ਇਹੀ ਕੋ ਨਾਊ ॥",
      "s": 7
    },
    {
      "t": "ਜਾਕਰ ਨਾਵ ਨ ਥਾਵ ਨ ਗਾਊ ॥੧॥",
      "s": 7
    },
    {
      "t": "ਜਾਕਰ ਨਾਵ ਨ ਠਾਵ ਬਖਾਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਬਊਧ ਅਵਤਾਰ ਵਹੀ ਪਹਚਾਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਸਿਲਾ ਸਰੂਪ ਰੂਪ ਤਿਹ ਜਾਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਕਥਾ ਨ ਜਾਹਿ ਕਲੂ ਮਹਿ ਮਾਨਾ ॥੨॥",
      "s": 7
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਰੂਪ ਰੇਖ ਜਾਕਰ ਨ ਕਛੁ ਅਰੁ ਕਛੁ ਨਹਿਨ ਆਕਾਰ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਸਿਲਾ ਰੂਪ ਬਰਤਤ ਜਗਤ ਸੋ ਬਊਧ ਅਵਤਾਰ ॥੩॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਬਊਧ ਅਵਤਾਰ ਤੇਈਸਵੋ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੩॥",
      "s": 7
    },
    {
      "t": "ਅਥ ਨਿਹਕਲੰਕੀ ਚੌਬੀਸਵੌ ਅਵਤਾਰ ਕਥਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਅਬ ਮੈ ਮਹਾ ਸੁਧ ਮਤਿ ਕਰਿ ਕੈ ॥",
      "s": 7
    },
    {
      "t": "ਕਹੋ ਕਥਾ ਚਿਤੁ ਲਾਇ ਬਿਚਰਿ ਕੈ ॥",
      "s": 7
    },
    {
      "t": "ਚਉਬੀਸਵੋ ਕਲਕੀ ਅਵਤਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਤਾ ਕਰ ਕਹੋ ਪ੍ਰਸੰਗ ਸੁਧਾਰਾ ॥੧॥",
      "s": 7
    },
    {
      "t": "ਭਾਰਾਕ੍ਰਿਤ ਹੋਤ ਜਬ ਧਰਣੀ ॥",
      "s": 7
    },
    {
      "t": "ਪਾਪ ਗ੍ਰਸਤ ਕਛੁ ਜਾਤ ਨ ਬਰਣੀ ॥",
      "s": 7
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਹੋਤ ਉਤਪਾਤਾ ॥",
      "s": 7
    },
    {
      "t": "ਪੁਤ੍ਰਹਿ ਸੇਜਿ ਸੋਵਤ ਲੈ ਮਾਤਾ ॥੨॥",
      "s": 7
    },
    {
      "t": "ਸੁਤਾ ਪਿਤਾ ਤਨ ਰਮਤ ਨਿਸੰਕਾ ॥",
      "s": 7
    },
    {
      "t": "ਭਗਨੀ ਭਰਤ ਭ੍ਰਾਤ ਕਹੁ ਅੰਕਾ ॥",
      "s": 7
    },
    {
      "t": "ਭ੍ਰਾਤ ਬਹਨ ਤਨ ਕਰਤ ਬਿਹਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਇਸਤ੍ਰੀ ਤਜੀ ਸਕਲ ਸੰਸਾਰਾ ॥੩॥",
      "s": 7
    },
    {
      "t": "ਸੰਕਰ ਬਰਣ ਪ੍ਰਜਾ ਸਭ ਹੋਈ ॥",
      "s": 7
    },
    {
      "t": "ਏਕ ਗ੍ਰਯਾਤ ਕੋ ਰਹਾ ਨ ਕੋਈ ॥",
      "s": 7
    },
    {
      "t": "ਅਤਿ ਬਿਭਚਾਰ ਫਸੀ ਬਰ ਨਾਰੀ ॥",
      "s": 7
    },
    {
      "t": "ਧਰਮ ਰੀਤ ਕੀ ਪ੍ਰੀਤਿ ਬਿਸਾਰੀ ॥੪॥",
      "s": 7
    },
    {
      "t": "ਘਰਿ ਘਰਿ ਝੂਠ ਅਮਸਿਆ ਭਈ ॥",
      "s": 7
    },
    {
      "t": "ਸਾਚ ਕਲਾ ਸਸਿ ਕੀ ਦੁਰ ਗਈ ॥",
      "s": 7
    },
    {
      "t": "ਜਹ ਤਹ ਹੋਨ ਲਗੇ ਉਤਪਾਤਾ ॥",
      "s": 7
    },
    {
      "t": "ਭੋਗਤ ਪੂਤ ਸੇਜਿ ਚੜਿ ਮਾਤਾ ॥੫॥",
      "s": 7
    },
    {
      "t": "ਢੂੰਢਤ ਸਾਚ ਨ ਕਤਹੂੰ ਪਾਯਾ ॥",
      "s": 7
    },
    {
      "t": "ਝੂਠ ਹੀ ਸੰਗ ਸਬੋ ਚਿਤ ਲਾਯਾ ॥",
      "s": 7
    },
    {
      "t": "ਭਿੰਨ ਭਿੰਨ ਗ੍ਰਿਹ ਗ੍ਰਿਹ ਮਤ ਹੋਈ ॥",
      "s": 7
    },
    {
      "t": "ਸਾਸਤ੍ਰ ਸਿਮ੍ਰਿਤ ਛੁਐ ਨ ਕੋਈ ॥੬॥",
      "s": 7
    },
    {
      "t": "ਹਿੰਦਵ ਕੋਈ ਨ ਤੁਰਕਾ ਰਹਿ ਹੈ ॥",
      "s": 7
    },
    {
      "t": "ਭਿਨ ਭਿਨ ਘਰਿ ਘਰਿ ਮਤ ਗਹਿ ਹੈ ॥",
      "s": 7
    }
  ]
}
