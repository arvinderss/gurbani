    },
    {
      "t": "ਜਾਨੁਕ ਧਰਮ ਪੰਖ ਕਰਿ ਭਜਿਯਾ ॥",
      "s": 7
    },
    {
      "t": "ਡੋਲਤ ਜਹ ਤਹ ਪੁਰਖ ਅਪਾਵਨ ॥",
      "s": 7
    },
    {
      "t": "ਲਾਗਤ ਕਤ ਹੀ ਧਰਮ ਕੋ ਦਾਵਨ ॥੮੩॥",
      "s": 7
    },
    {
      "t": "ਅਰਥਹ ਛਾਡਿ ਅਨਰਥ ਬਤਾਵਤ ॥",
      "s": 7
    },
    {
      "t": "ਧਰਮ ਕਰਮ ਚਿਤਿ ਏਕ ਨ ਲਿਆਵਤ ॥",
      "s": 7
    },
    {
      "t": "ਕਰਮ ਧਰਮ ਕੀ ਕ੍ਰਿਆ ਭੁਲਾਵਤ ॥",
      "s": 7
    },
    {
      "t": "ਜਹਾ ਤਹਾ ਆਰਿਸਟ ਬਤਾਵਤ ॥੮੪॥",
