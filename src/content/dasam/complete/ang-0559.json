  "lines": [
    {
      "t": "ਪਾਪ ਕਮੈ ਵਹ ਦੁਰਗਤਿ ਪੈ ਹੈ ॥",
      "s": 7
    },
    {
      "t": "ਪਾਪ ਸਮੁੰਦ ਜੈ ਹੈ ਨ ਤਰਿ ॥੭੭॥",
      "s": 7
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਠਉਰ ਠਉਰ ਨਵ ਮਤ ਚਲੇ ਉਠਾ ਧਰਮ ਕੋ ਦੌਰ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਸੁਕ੍ਰਿਤ ਜਹ ਤਹ ਦੁਰ ਰਹੀ ਪਾਪ ਭਇਓ ਸਿਰਮੌਰ ॥੭੮॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਨਵਪਦੀ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਜਹ ਤਹ ਕਰਨ ਲਗੇ ਸਭ ਪਾਪਨ ॥",
      "s": 7
    },
    {
      "t": "ਧਰਮ ਕਰਮ ਤਜਿ ਕਰ ਹਰਿ ਜਾਪਨ ॥",
      "s": 7
    },
    {
      "t": "ਪਾਹਨ ਕਉ ਸੁ ਕਰਤ ਸਬ ਬੰਦਨ ॥",
      "s": 7
    },
    {
      "t": "ਡਾਰਤ ਧੂਪ ਦੀਪ ਸਿਰਿ ਚੰਦਨ ॥੭੯॥",
      "s": 7
    },
    {
      "t": "ਜਹ ਤਹ ਧਰਮ ਕਰਮ ਤਜਿ ਭਾਗਤ ॥",
      "s": 7
    },
    {
      "t": "ਉਠਿ ਉਠਿ ਪਾਪ ਕਰਮ ਸੌ ਲਾਗਤ ॥",
      "s": 7
    },
    {
      "t": "ਜਹ ਤਹ ਭਈ ਧਰਮ ਗਤਿ ਲੋਪੰ ॥",
      "s": 7
    },
    {
      "t": "ਪਾਪਹਿ ਲਗੀ ਚਉਗਨੀ ਓਪੰ ॥੮੦॥",
      "s": 7
    },
    {
      "t": "ਭਾਜ੍ਯੋ ਧਰਮ ਭਰਮ ਤਜਿ ਅਪਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਜਾਨੁਕ ਹੁਤੋ ਲਖਾ ਇਹ ਸੁਪਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਸਭ ਸੰਸਾਰ ਤਜੀ ਤ੍ਰੀਅ ਆਪਨ ॥",
      "s": 7
    },
    {
      "t": "ਮੰਤ੍ਰ ਕੁਮੰਤ੍ਰ ਲਗੇ ਮਿਲਿ ਜਾਪਨ ॥੮੧॥",
      "s": 7
    },
    {
      "t": "ਚਹੁ ਦਿਸ ਘੋਰ ਪ੍ਰਚਰ ਭਇਓ ਪਾਪਾ ॥",
      "s": 7
    },
    {
      "t": "ਕੋਊ ਨ ਜਾਪ ਸਕੈ ਹਰਿ ਜਾਪਾ ॥",
      "s": 7
    },
    {
      "t": "ਪਾਪ ਕ੍ਰਿਆ ਸਭ ਜਾ ਚਲ ਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਧਰਮ ਕ੍ਰਿਆ ਯਾ ਜਗ ਤੇ ਗਈ ॥੮੨॥",
      "s": 7
    },
    {
      "t": "ਅੜਿਲ ਦੂਜਾ ॥",
      "s": 7
    },
    {
      "t": "ਜਹਾ ਤਹਾ ਆਧਰਮ ਉਪਜਿਯਾ ॥",
