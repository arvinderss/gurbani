    {
      "t": "ਕਹੂੰ ਨ ਚਰਚਾ ॥੧੬੦॥",
      "s": 7
    },
    {
      "t": "ਮਧੁਭਾਰ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਸਬ ਦੇਸ ਢਾਲ ॥",
      "s": 7
    },
    {
      "t": "ਜਹ ਤਹ ਕੁਚਾਲ ॥",
      "s": 7
    },
    {
      "t": "ਜਹ ਤਹ ਅਨਰਥ ॥",
      "s": 7
    },
    {
      "t": "ਨਹੀ ਹੋਤ ਅਰਥ ॥੧੬੧॥",
      "s": 7
    },
    {
      "t": "ਸਬ ਦੇਸ ਰਾਜ ॥",
      "s": 7
    },
    {
      "t": "ਨਿਤਪ੍ਰਤਿ ਕੁਕਾਜ ॥",
      "s": 7
    },
    {
      "t": "ਨਹੀ ਹੋਤ ਨਿਆਇ ॥",
      "s": 7
    },
    {
      "t": "ਜਹ ਤਹ ਅਨ੍ਯਾਇ ॥੧੬੨॥",
      "s": 7
    },
    {
      "t": "ਛਿਤ ਭਈ ਸੁਦ੍ਰ ॥",
      "s": 7
    },
    {
      "t": "ਕ੍ਰਿਤ ਕਰਤ ਛੁਦ੍ਰ ॥",
      "s": 7
    },
    {
      "t": "ਤਹ ਬਿਪ੍ਰ ਏਕ ॥",
      "s": 7
    },
    {
      "t": "ਜਿਹ ਗੁਨ ਅਨੇਕ ॥੧੬੩॥",
      "s": 7
    },
    {
      "t": "ਪਾਧਰੀ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਨਿਤ ਜਪਤ ਬਿਪ੍ਰ ਦੇਬੀ ਪ੍ਰਚੰਡ ॥",
      "s": 7
    },
    {
      "t": "ਜਿਹ ਕੀਨ ਧੂਮ੍ਰ ਲੋਚਨ ਦੁਖੰਡ ॥",
      "s": 7
    },
    {
      "t": "ਜਿਹ ਕੀਨ ਦੇਵ ਦੇਵਿਸ ਸਹਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਜਿਹ ਲੀਨ ਰੁਦ੍ਰ ਕਰਿ ਬਚਾਇ ॥੧੬੪॥",
      "s": 7
    },
    {
      "t": "ਜਿਹ ਹਤੇ ਸੁੰਭ ਨੈਸੁੰਭ ਬੀਰ ॥",
      "s": 7
    },
    {
      "t": "ਜਿਨ ਜੀਤ ਇੰਦ੍ਰ ਕੀਨੋ ਫਕੀਰ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਨਿ ਗਹੀ ਸਰਨ ਜਗ ਮਾਤ ਜਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਹਿ ਕੀਅਸ ਚੰਡਿਕਾ ਦੇਵਰਾਇ ॥੧੬੫॥",
      "s": 7
    },
    {
      "t": "ਤਿਹਿ ਜਪਤ ਰੈਣ ਦਿਨ ਦਿਜ ਉਦਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਜਿਹਿ ਹਣਿਓ ਰੋਸਿ ਰਣਿ ਬਾਸਵਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਗ੍ਰਿਹ ਹੁਤੀ ਤਾਸੁ ਇਸਤ੍ਰੀ ਕੁਚਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਹ ਗਹਿਓ ਨਾਹ ਦਿਨ ਇਕ ਨਿਹਾਰਿ ॥੧੬੬॥",
      "s": 7
    },
    {
      "t": "ਤ੍ਰੀਯੋ ਬਾਚ ਪਤਿ ਸੋ ॥",
      "s": 7
    },
    {
      "t": "ਕਿਹ ਕਾਜ ਮੂੜ ਸੇਵੰਤ ਦੇਵਿ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਕਿਹ ਹੇਤ ਤਾਸੁ ਬੁਲਤ ਅਭੇਵਿ ॥",
      "s": 7
    },
    {
      "t": "ਕਿਹ ਕਾਰਣ ਵਾਹਿ ਪਗਿਆਨ ਪਰੰਤ ॥",
      "s": 7
    },
    {
      "t": "ਕਿਮ ਜਾਨ ਬੂਝ ਦੋਜਖਿ ਗਿਰੰਤ ॥੧੬੭॥",
      "s": 7
    },
    {
      "t": "ਕਿਹ ਕਾਜ ਮੂਰਖ ਤਿਹ ਜਪਤ ਜਾਪ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਨਹੀ ਡਰਤ ਤਉਨ ਕੋ ਥਪਤ ਥਾਪ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਕੈਹੋ ਪੁਕਾਰ ਰਾਜਾ ਸਮੀਪ ॥",
      "s": 7
    },
    {
      "t": "ਦੈ ਹੈ ਨਿਕਾਰ ਤੁਹਿ ਬਾਧਿ ਦੀਪ ॥੧੬੮॥",
      "s": 7
    },
    {
      "t": "ਨਹੀ ਲਖਾ ਤਾਹਿ ਬ੍ਰਹਮਾ ਕੁਨਾਰਿ ॥",
      "s": 7
    },
    {
      "t": "ਧਰਮਾਰਥ ਆਨਿ ਲਿਨੋ ਵਤਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਸੂਦ੍ਰੰ ਸਮਸਤ ਨਾਸਾਰਥ ਹੇਤੁ ॥",
      "s": 7
    },
    {
      "t": "ਕਲਕੀ ਵਤਾਰ ਕਰਬੇ ਸਚੇਤ ॥੧੬੯॥",
      "s": 7
    },
    {
      "t": "ਹਿਤ ਜਾਨਿ ਤਾਸੁ ਹਟਕਿਓ ਕੁਨਾਰਿ ॥",
      "s": 7
    },
    {
      "t": "ਨਹੀ ਲੋਕ ਤ੍ਰਾਸ ਬੁਲੇ ਭਤਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਤਬ ਕੁੜ੍ਰਹੀ ਨਾਰਿ ਚਿਤ ਰੋਸ ਠਾਨਿ ॥",
      "s": 7
    },
    {
      "t": "ਸੰਭਲ ਨਰੇਸ ਤਨ ਕਹੀ ਆਨਿ ॥੧੭੦॥",
      "s": 7
    },
    {
      "t": "ਪੂਜੰਤ ਦੇਵ ਦੀਨੋ ਦਿਖਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਹ ਗਹਾ ਕੋਪ ਕਰਿ ਸੂਦ੍ਰ ਰਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਗਹਿ ਤਾਹਿ ਅਧਿਕ ਦੀਨੀ ਸਜਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਕੈ ਹਨਤ ਤੋਹਿ ਕੈ ਜਪ ਨ ਮਾਇ ॥੧੭੧॥",
