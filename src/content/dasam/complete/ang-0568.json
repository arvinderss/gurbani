{
  "page": 568,
  "lines": [
    {
      "t": "ਰਾਜਾ ਸੂਦ੍ਰ ਬਾਚ ॥",
      "s": 7
    },
    {
      "t": "ਨਹੀ ਹਨਤ ਤੋਹ ਦਿਜ ਕਹੀ ਆਜ ॥",
      "v": [
        [
          3,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਨਹੀ ਬੋਰ ਬਾਰ ਮੋ ਪੂਜ ਸਾਜ ॥",
      "s": 7
    },
    {
      "t": "ਕੈ ਤਜਹੁ ਸੇਵ ਦੇਵੀ ਪ੍ਰਚੰਡ ॥",
      "s": 7
    },
    {
      "t": "ਨਹੀ ਕਰਤ ਆਜ ਤੋ ਕੋ ਦੁਖੰਡ ॥੧੭੨॥",
      "s": 7
    },
    {
      "t": "ਬਿਪ੍ਰ ਬਾਚ ਰਾਜਾ ਸੌ॥",
      "s": 7
    },
    {
      "t": "ਕੀਜੈ ਦੁਖੰਡ ਨਹਿ ਤਜੋ ਸੇਵ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਸੁਨਿ ਲੇਹੁ ਸਾਚ ਤੁਹਿ ਕਹੋ ਦੇਵ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਕਿਉ ਨ ਹੋਹਿ ਟੂਕ ਤਨ ਕੇ ਹਜਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਨਹੀ ਤਜੋ ਪਾਇ ਦੇਵੀ ਉਦਾਰ ॥੧੭੩॥",
      "s": 7
    },
    {
      "t": "ਸੁਨ ਭਯੋ ਬੈਨ ਸੂਦਰ ਸੁ ਕ੍ਰੁਧ ॥",
      "s": 7
    },
    {
      "t": "ਜਣ ਜੁਟ੍ਰਯੋ ਆਣਿ ਮਕਰਾਛ ਜੁਧ ॥",
      "s": 7
    },
    {
      "t": "ਦੋਊ ਦ੍ਰਿਗ ਸਕ੍ਰੁਧ ਸ੍ਰੋਣਤ ਚੁਚਾਨ ॥",
      "s": 7
    },
    {
      "t": "ਜਨ ਕਾਲ ਤਾਹਿ ਦੀਨੀ ਨਿਸਾਨ ॥੧੭੪॥",
      "s": 7
    },
    {
      "t": "ਅਤਿ ਗਰਬ ਮੂੜ ਭ੍ਰਿਤਨ ਬੁਲਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਉਚਰੇ ਬੈਨ ਇਹ ਹਣੋ ਜਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਲੈ ਗਏ ਤਾਸੁ ਦ੍ਰੋਹੀ ਦੁਰੰਤ ॥",
      "s": 7
    },
    {
      "t": "ਜਹ ਸੰਭ੍ਰ ਸੁਭ ਦੇਵਲ ਸੁਭੰਤ ॥੧੭੫॥",
      "s": 7
    },
    {
      "t": "ਤਿਹ ਬਾਧ ਆਂਖ ਮੁਸਕੈਂ ਚੜਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਕਰਿ ਲੀਨ ਕਾਢਿ ਅਸਿ ਕੋ ਨਚਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਜਬ ਲਗੇ ਦੇਨ ਤਿਹ ਤੇਗ ਤਾਨ ॥",
      "s": 7
    },
    {
      "t": "ਤਬ ਕੀਓ ਕਾਲ ਕੋ ਬਿਪ੍ਰ ਧਿਆਨ ॥੧੭੬॥",
      "s": 7
    },
    {
      "t": "ਜਬ ਕੀਯੋ ਚਿਤ ਮੋ ਬਿਪ੍ਰ ਧਿਆਨ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਹ ਦੀਨ ਦਰਸ ਤਬ ਕਾਲ ਆਨਿ ॥",
      "s": 7
    }
  ]
}
