{
  "page": 569,
  "lines": [
    {
      "t": "ਨਹੀ ਕਰੋ ਚਿੰਤ ਚਿਤ ਮਾਝਿ ਏਕ ॥",
      "s": 7
    },
    {
      "t": "ਤਵ ਹੇਤੁ ਸਤ੍ਰੁ ਹਨਿ ਹੈ ਅਨੇਕ ॥੧੭੭॥",
      "s": 7
    },
    {
      "t": "ਤਬ ਪਰੀ ਸੂੰਕ ਭੋਹਰ ਮਝਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਉਪਜਿਓ ਆਨਿ ਕਲਕੀ ਵਤਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਤਾੜ ਪ੍ਰਮਾਨੁ ਕਰਿ ਅਸਿ ਉਤੰਗ ॥",
      "s": 7
    },
    {
      "t": "ਤੁਰਕਛ ਸੁਵਛ ਤਾਜੀ ਸੁਰੰਗ ॥੧੭੮॥",
      "s": 7
    },
    {
      "t": "ਸਿਰਖੰਡੀ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਵਜੇ ਨਾਦ ਸੁਰੰਗੀ ਧਗਾ ਘੋਰੀਆ ॥",
      "s": 7
    },
    {
      "t": "ਨਚੇ ਜਾਣ ਫਿਰੰਗੀ ਵਜੇ ਘੁੰਘਰੂ ॥",
      "s": 7
    },
    {
      "t": "ਗਦਾ ਤ੍ਰਿਸੂਲ ਨਿਖੰਗੀ ਝੂਲਨ ਬੈਰਖਾ ॥",
      "s": 7
    },
    {
      "t": "ਸਾਵਨ ਜਾਣ ਉਮੰਗੀ ਘਟਾ ਡਰਾਵਣੀ ॥੧੭੯॥",
      "s": 7
    },
    {
      "t": "ਬਾਣੇ ਅੰਗ ਭੁਜੰਗੀ ਸਾਵਲ ਸੋਹਣੇ ॥",
      "s": 7
    },
    {
      "t": "ਤ੍ਰੈ ਸੈ ਹਥ ਉਤੰਗੀ ਖੰਡਾ ਧੂਹਿਆ ॥",
      "s": 7
    },
    {
      "t": "ਤਾਜੀ ਭਉਰ ਪਿਲੰਗੀ ਛਾਲਾ ਪਾਈਆ ॥",
      "s": 7
    },
    {
      "t": "ਭੰਗੀ ਜਾਣ ਭਿੜੰਗੀ ਨਚੇ ਦਾਇਰੀ ॥੧੮੦॥",
      "s": 7
    },
    {
      "t": "ਬਜੇ ਨਾਦ ਸੁਰੰਗੀ ਅਣੀਆਂ ਜੁਟੀਆਂ ॥",
      "s": 7
    },
    {
      "t": "ਪੈਰੇ ਧਾਰ ਪਵੰਗੀ ਫਉਜਾ ਚੀਰ ਕੈ ॥",
      "s": 7
    },
    {
      "t": "ਉਠੈ ਛੈਲ ਛਲੰਗੀ ਛਾਲਾ ਪਾਈਆਂ ॥",
      "s": 7
    },
    {
      "t": "ਝਾੜਿ ਝੜਾਕ ਝੜੰਗੀ ਤੇਗਾ ਵਜੀਆਂ ॥੧੮੧॥",
      "s": 7
    },
    {
      "t": "ਸਮਾਨਕਾ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਜੁ ਦੇਖ ਦੇਖ ਕੈ ਸਬੈ ॥",
      "s": 7
    },
    {
      "t": "ਸੁ ਭਾਜਿ ਭਾਜਿ ਗੇ ਤਬੇ ॥",
      "s": 7
    },
    {
      "t": "ਕਹਿਓ ਸੁ ਸੋਭ ਸੋਭ ਹੀ ॥",
      "s": 7
    },
    {
      "t": "ਬਿਲੋਕਿ ਲੋਕ ਲੋਭ ਹੀ ॥੧੮੨॥",
      "s": 7
    },
    {
      "t": "ਪ੍ਰਚੰਡ ਰੂਪ ਰਾਜਈ ॥",
      "s": 7
    },
    {
      "t": "ਬਿਲੋਕਿ ਭਾਨ ਲਾਜਈ ॥",
      "s": 7
    },
    {
      "t": "ਸੁ ਚੰਡ ਤੇਜ ਇਉ ਲਸੈ ॥",
      "s": 7
    },
    {
      "t": "ਪ੍ਰਚੰਡ ਜੋਤਿ ਕੋ ਹਸੈ ॥੧੮੩॥",
      "s": 7
    },
    {
      "t": "ਸੁ ਕੋਪਿ ਕੋਪ ਕੈ ਹਠੀ ॥",
      "s": 7
    },
    {
      "t": "ਚਪੈ ਚਿਰਾਇ ਜਿਉ ਭਠੀ ॥",
      "s": 7
    },
    {
      "t": "ਪ੍ਰਚੰਡ ਮੰਡਲੀ ਲਸੈ ॥",
      "s": 7
    },
    {
      "t": "ਕਿ ਮਾਰਤੰਡ ਕੋ ਹਸੈ ॥੧੮੪॥",
      "s": 7
    },
    {
      "t": "ਸੁ ਕੋਪ ਓਪ ਦੈ ਬਲੀ ॥",
      "s": 7
    },
    {
      "t": "ਕਿ ਰਾਜ ਮੰਡਲੀ ਚਲੀ ॥",
      "s": 7
    },
    {
      "t": "ਸੁ ਅਸਤ੍ਰ ਸਸਤ੍ਰ ਪਾਨਿ ਲੈ ॥",
      "s": 7
    },
    {
      "t": "ਬਿਸੇਖ ਬੀਰ ਮਾਨ ਕੈ ॥੧੮੫॥",
      "s": 7
    },
    {
      "t": "ਤੋਮਰ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਭਟ ਸਸਤ੍ਰ ਅਸਤ੍ਰ ਨਚਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਚਿਤ ਕੋਪ ਓਪ ਬਢਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਤੁਰਕਛ ਅਛ ਤੁਰੰਗ ॥",
      "s": 7
    },
    {
      "t": "ਰਣ ਰੰਗਿ ਚਾਰ ਉਤੰਗ ॥੧੮੬॥",
      "s": 7
    },
    {
      "t": "ਕਰਿ ਕ੍ਰੋਧ ਪੀਸਤ ਦਾਤ ॥",
      "s": 7
    },
    {
      "t": "ਕਹਿ ਆਪੁ ਆਪਨ ਬਾਤ ॥",
      "s": 7
    },
    {
      "t": "ਭਟ ਭੈਰਹਵ ਹੈ ਧੀਰ ॥",
      "s": 7
    },
    {
      "t": "ਕਰਿ ਕੋਪ ਛਾਡਤ ਤੀਰ ॥੧੮੭॥",
      "s": 7
    },
    {
      "t": "ਕਰ ਕੋਪ ਕਲਿ ਅਵਤਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਗਹਿ ਪਾਨਿ ਅਜਾਨ ਕੁਠਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਤਨਕੇਕ ਕੀਨ ਪ੍ਰਹਾਰ ॥",
      "s": 7
    }
  ]
}
