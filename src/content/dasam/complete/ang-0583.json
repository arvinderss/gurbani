{
  "page": 583,
  "lines": [
    {
      "t": "ਗਜ ਬਾਜ ਰਥੀ ਰਥ ਕੂਟਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਗਹਿ ਕੇਸਨ ਏਕਿਨ ਝੂਟਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਲਖ ਲਾਤਨ ਮੁਸਟ ਪ੍ਰਹਾਰਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਰਣਿ ਦਾਤਨ ਕੇਸਨੁ ਪਾਰਹਿਗੇ ॥੩੧੮॥",
      "s": 7
    },
    {
      "t": "ਅਵਣੇਸ ਅਣੀਣਿ ਸੁਧਾਰਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਕਰਿ ਬਾਣ ਕ੍ਰਿਪਾਣ ਸੰਭਾਰਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਕਰਿ ਰੋਸ ਦੁਹੂੰ ਦਿਸਿ ਧਾਵਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਰਣਿ ਸੀਝਿ ਦਿਵਾਲਯ ਪਾਵਹਿਗੇ ॥੩੧੯॥",
      "s": 7
    },
    {
      "t": "ਛਣਣੰਕਿ ਕ੍ਰਿਪਾਣ ਛਣਕਹਿਗੀ ॥",
      "s": 7
    },
    {
      "t": "ਝਣਣਕਿ ਸੰਜੋਅ ਝਣਕਹਿਗੀ ॥",
      "s": 7
    },
    {
      "t": "ਕਣਣੰਛਿ ਕੰਧਾਰਿ ਕਣਛਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਰਣਰੰਗਿ ਸੁ ਚਾਚਰ ਮਚਹਿਗੇ ॥੩੨੦॥",
      "s": 7
    },
    {
      "t": "ਦੁਹੂੰ ਓਰ ਤੇ ਸਾਗ ਅਨਚਹਿਗੀ ॥",
      "s": 7
    },
    {
      "t": "ਜਟਿ ਧੂਰਿ ਧਰਾਰੰਗਿ ਰਚਹਿਗੀ ॥",
      "s": 7
    },
    {
      "t": "ਕਰਵਾਰਿ ਕਟਾਰੀਆ ਬਜਹਿਗੀ ॥",
      "s": 7
    },
    {
      "t": "ਘਟ ਸਾਵਣਿ ਜਾਣੁ ਸੁ ਗਜਹਿਗੀ ॥੩੨੧॥",
      "s": 7
    },
    {
      "t": "ਭਟ ਦਾਤਨ ਪੀਸ ਰਿਸਾਵਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਦੁਹੂੰ ਓਰਿ ਤੁਰੰਗ ਨਚਾਵਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਰਣਿ ਬਾਣ ਕਮਾਣਣਿ ਛੋਰਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਹਯ ਤ੍ਰਾਣ ਸਨਾਹਿਨ ਫੋਰਹਿਗੇ ॥੩੨੨॥",
      "s": 7
    },
    {
      "t": "ਘਟਿ ਜਿਉ ਘਣਿ ਕੀ ਘੁਰਿ ਢੂਕਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਮੁਖ ਮਾਰ ਦਸੋ ਦਿਸ ਕੂਕਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਮੁਖ ਮਾਰ ਮਹਾ ਸੁਰ ਬੋਲਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਗਿਰਿ ਕੰਚਨ ਜੇਮਿ ਨ ਡੋਲਹਿਗੇ ॥੩੨੩॥",
      "s": 7
    },
    {
      "t": "ਹਯ ਕੋਟਿ ਗਜੀ ਗਜ ਜੁਝਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਕਵਿ ਕੋਟਿ ਕਹਾ ਲਗ ਬੁਝਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਗਣ ਦੇਵ ਅਦੇਵ ਨਿਹਾਰਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਜੈ ਸਦ ਨਿਨਦ ਪੁਕਾਰਹਿਗੇ ॥੩੨੪॥",
      "s": 7
    },
    {
      "t": "ਲਖ ਬੈਰਖ ਬਾਨ ਸੁਹਾਵਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਰਣ ਰੰਗ ਸਮੈ ਫਹਰਾਵਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਬਰ ਢਾਲ ਢਲਾ ਢਲ ਢੂਕਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਮੁਖ ਮਾਰ ਦਸੋ ਦਿਸਿ ਕੂਕਹਿਗੇ ॥੩੨੫॥",
      "s": 7
    },
    {
      "t": "ਤਨ ਤ੍ਰਾਣ ਪੁਰਜਨ ਉਡਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਗਡਵਾਰ ਗਾਡਾਗਡ ਗੁਡਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਰਣਿ ਬੈਰਖ ਬਾਨ ਝਮਕਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਭਟ ਭੂਤ ਪਰੇਤ ਭਭਕਹਿਗੇ ॥੩੨੬॥",
      "s": 7
    },
    {
      "t": "ਬਰ ਬੈਰਖ ਬਾਨ ਕ੍ਰਿਪਾਣ ਕਹੂੰ ॥",
      "s": 7
    },
    {
      "t": "ਰਣਿ ਬੋਲਤ ਆਜ ਲਗੇ ਅਜਹੂੰ ॥",
      "s": 7
    },
    {
      "t": "ਗਹਿ ਕੇਸਨ ਤੇ ਭ੍ਰਮਾਵਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਦਸਹੂੰ ਦਿਸਿ ਤਾਕਿ ਚਲਾਵਹਿਗੇ ॥੩੨੭॥",
      "s": 7
    },
    {
      "t": "ਅਰੁਣੰ ਬਰਣੰ ਭਟ ਪੇਖੀਅਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਤਰਣੰ ਕਿਰਣੰ ਸਰ ਲੇਖੀਅਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਬਹੁ ਭਾਤਿ ਪ੍ਰਭਾ ਭਟ ਪਾਵਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਰੰਗ ਕਿੰਸੁਕ ਦੇਖਿ ਲਜਾਵਹਿਗੇ ॥੩੨੮॥",
      "s": 7
    },
    {
      "t": "ਗਜ ਬਾਜ ਰਥੀ ਰਥ ਜੁਝਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਕਵਿ ਲੋਗ ਕਹਾ ਲਗਿ ਬੁਝਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਜਸੁ ਜੀਤ ਕੈ ਗੀਤ ਬਨਾਵਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਜੁਗ ਚਾਰ ਲਗੈ ਜਸੁ ਗਾਵਹਿਗੇ ॥੩੨੯॥",
      "s": 7
    }
  ]
}
