{
  "page": 587,
  "lines": [
    {
      "t": "ਸਸਿ ਸੋਭ ਹਰੇ ॥੩੫੯॥",
      "s": 7
    },
    {
      "t": "ਅਸ੍ਰਯ ਉਪਾਸਿਕ ਹੈਂ ॥",
      "s": 7
    },
    {
      "t": "ਅਰਿ ਨਾਸਿਕ ਹੈਂ ॥",
      "s": 7
    },
    {
      "t": "ਬਰ ਦਾਇਕ ਹੈਂ ॥",
      "s": 7
    },
    {
      "t": "ਪ੍ਰਭ ਪਾਇਕ ਹੈਂ ॥੩੬੦॥",
      "s": 7
    },
    {
      "t": "ਸੰਗੀਤ ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਬਾਗੜਦੰ ਬੀਰੰ ਜਾਗੜਦੰ ਜੂਟੇ ॥",
      "s": 7
    },
    {
      "t": "ਤਾਗੜਦੰ ਤੀਰੰ ਛਾਗੜਦੰ ਛੂਟੇ ॥",
      "s": 7
    },
    {
      "t": "ਸਾਗੜਦੰ ਸੁਆਰੰ ਜਾਗੜਦੰ ਜੂਝੇ ॥",
      "s": 7
    },
    {
      "t": "ਕਾਗੜਦੰ ਕੋਪੇ ਰਾਗੜਦੰ ਰੁਝੈ ॥੩੬੧॥",
      "s": 7
    },
    {
      "t": "ਮਾਗੜਦੰ ਮਾਚਿਓ ਜਾਗੜਦੰ ਜੁਧੰ ॥",
      "s": 7
    },
    {
      "t": "ਜਾਗੜਦੰ ਜੋਧਾ ਕਾਗੜਦੰ ਕ੍ਰੁੰਧੰ ॥",
      "s": 7
    },
    {
      "t": "ਸਾਗੜਦੰ ਸਾਗੰ ਡਾਗੜਦੰ ਡਾਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਬਾਗੜਦੰ ਬੀਰੰ ਆਗੜਦੰ ਉਤਾਰੇ ॥੩੬੨॥",
      "s": 7
    },
    {
      "t": "ਤਾਗੜਦੰ ਤੈ ਕੈ ਜਾਗੜਦੰ ਜੁਆਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਛਾਗੜਦੰ ਛੋਰੈ ਬਾਗੜਦੰ ਬਾਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਜਾਗੜਦੰ ਜੂਝੇ ਬਾਗੜਦੰ ਬਾਜੀ ॥",
      "s": 7
    },
    {
      "t": "ਡਾਗੜਦੰ ਡੋਲੈ ਤਾਗੜਦੰ ਤਾਜੀ ॥੩੬੩॥",
      "s": 7
    },
    {
      "t": "ਖਾਗੜਦੰ ਖੂਨੀ ਖਯਾਗੜਦੰ ਖੇਤੰ ॥",
      "s": 7
    },
    {
      "t": "ਝਾਗੜਦੰ ਝੂਝੇ ਆਗੜਦੰ ਅਚੇਤੰ ॥",
      "s": 7
    },
    {
      "t": "ਆਗੜਦੰ ਉਠੇ ਕਾਗੜਦੰ ਕੋਪੇ ॥",
      "s": 7
    },
    {
      "t": "ਡਾਗੜਦੰ ਡਾਰੇ ਧਾਗੜਦੰ ਧੋਪੇ ॥੩੬੪॥",
      "s": 7
    },
    {
      "t": "ਨਾਗੜਦੰ ਨਾਚੇ ਰਾਗੜਦੰ ਰੁਦ੍ਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਭਾਗੜਦੰ ਭਾਜੇ ਛਾਗੜਦੰ ਛੁਦ੍ਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਜਾਗੜਦੰ ਜੁਝੇ ਵਾਗੜਦੰ ਵੀਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਲਾਗੜਦੰ ਲਾਗੇ ਤਾਗੜਦੰ ਤੀਰੰ ॥੩੬੫॥",
      "s": 7
    },
    {
      "t": "ਰਾਗੜਦੰ ਰੁਝੇ ਸਾਗੜਦੰ ਸੂਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਘਾਗੜਦੰ ਘੁਮੀ ਹਾਗੜਦੰ ਹੂਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਤਾਗੜਦੰ ਤਕੈ ਜਾਗੜਦੰ ਜੁਆਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਮਾਗੜਦੰ ਮੋਹੀ ਤਾਗੜਦੰ ਤਾਨੰ ॥੩੬੬॥",
      "s": 7
    },
    {
      "t": "ਦਾਗੜਦੰ ਦੇਖੈ ਰਾਗੜਦੰ ਰੂਪੰ ॥",
      "s": 7
    },
    {
      "t": "ਪਾਗੜਦੰ ਪ੍ਰੇਮੰ ਕਾਗੜਦੰ ਕੂਪੰ ॥",
      "s": 7
    },
    {
      "t": "ਡਾਗੜਦੰ ਡੁਬੀ ਪਾਗੜਦੰ ਪਿਆਰੀ ॥",
      "s": 7
    },
    {
      "t": "ਕਾਗੜਦੰ ਕਾਮੰ ਮਾਗੜਦੰ ਮਾਰੀ ॥੩੬੭॥",
      "s": 7
    },
    {
      "t": "ਮਾਗੜਦੰ ਮੋਹੀ ਬਾਗੜਦੰ ਬਾਲਾ ॥",
      "s": 7
    },
    {
      "t": "ਰਾਗੜਦੰ ਰੂਪੰ ਆਗੜਦੰ ਉਜਾਲਾ ॥",
      "s": 7
    },
    {
      "t": "ਦਾਗੜਦੰ ਦੇਖੈ ਸਾਗੜਦੰ ਸੂਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਬਾਗੜਦੰ ਬਾਜੇ ਤਾਗੜਦੰ ਤੂਰੰ ॥੩੬੮॥",
      "s": 7
    },
    {
      "t": "ਰਾਗੜਦੰ ਰੂਪੰ ਕਾਗੜਦੰ ਕਾਮੰ ॥",
      "s": 7
    },
    {
      "t": "ਨਾਗੜਦੰ ਨਾਚੈ ਬਾਗੜਦੰ ਬਾਮੰ ॥",
      "s": 7
    },
    {
      "t": "ਰਾਗੜਦੰ ਰੀਝੇ ਸਾਗੜਦੰ ਸੂਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਬਾਗੜਦੰ ਬਿਆਹੈ ਹਾਗੜਦੰ ਹੂਰੰ ॥੩੬੯॥",
      "s": 7
    },
    {
      "t": "ਕਾਗੜਦੰ ਕੋਪਾ ਭਾਗੜਦੰ ਭੂਪੰ ॥",
      "s": 7
    },
    {
      "t": "ਕਾਗੜਦੰ ਕਾਲੰ ਰਾਗੜਦੰ ਰੂਪੰ ॥",
      "s": 7
    },
    {
      "t": "ਰਾਗੜਦੰ ਰੋਸੰ ਧਾਗੜਦੰ ਧਾਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਚਾਗੜਦੰ ਚਲ੍ਯੋ ਆਗੜਦੰ ਆਯੋ ॥੩੭੦॥",
      "s": 7
    },
    {
      "t": "ਆਗੜਦੰ ਅਰੜੇ ਗਾਗੜਦੰ ਗਾਜੀ ॥",
      "s": 7
    },
    {
      "t": "ਨਾਗੜਦੰ ਨਾਚੇ ਤਾਗੜਦੰ ਤਾਜੀ ॥",
      "s": 7
    }
  ]
}
