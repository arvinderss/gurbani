{
  "page": 588,
  "lines": [
    {
      "t": "ਜਾਗੜਦੰ ਜੁਝੇ ਖਾਗੜਦੰ ਖੇਤੰ ॥",
      "s": 7
    },
    {
      "t": "ਰਾਗੜਦੰ ਰਹਸੇ ਪਾਗੜਦੰ ਪ੍ਰੇਤੰ ॥੩੭੧॥",
      "s": 7
    },
    {
      "t": "ਮਾਗੜਦੰ ਮਾਰੇ ਬਾਗੜਦੰ ਬੀਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਪਾਗੜਦੰ ਪਰਾਨੇ ਭਾਗੜਦੰ ਭੀਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਧਾਗੜਦੰ ਧਾਯੋ ਰਾਗੜਦੰ ਰਾਜਾ ॥",
      "s": 7
    },
    {
      "t": "ਰਾਗੜਦੰ ਰਣਕੇ ਬਾਗੜਦੰ ਬਾਜਾ ॥੩੭੨॥",
      "s": 7
    },
    {
      "t": "ਟਾਗੜਦੰ ਟੂਟੇ ਤਾਗੜਦੰ ਤਾਲੰ ॥",
      "s": 7
    },
    {
      "t": "ਆਗੜਦੰ ਉਠੇ ਜਾਗੜਦੰ ਜੁਆਲੰ ॥",
      "s": 7
    },
    {
      "t": "ਭਾਗੜਦੰ ਭਾਜੇ ਬਾਗੜਦੰ ਬੀਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਲਾਗੜਦੰ ਲਾਗੇ ਤਾਗੜਦੰ ਤੀਰੰ ॥੩੭੩॥",
      "s": 7
    },
    {
      "t": "ਰਾਗੜਦੰ ਰਹਸੀ ਦਾਗੜਦੰ ਦੇਵੀ ॥",
      "s": 7
    },
    {
      "t": "ਗਾਗੜਦੰ ਗੈਣ ਆਗੜਦੰ ਭੇਵੀ ॥",
      "s": 7
    },
    {
      "t": "ਭਾਗੜਦੰ ਭੈਰੰ ਭਾਗੜਦੰ ਪ੍ਰੇਤੰ ॥",
      "s": 7
    },
    {
      "t": "ਹਾਗੜਦੰ ਹਸੇ ਖਾਗੜਦੰ ਖੇਤੰ ॥੩੭੪॥",
      "s": 7
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਅਸਿ ਟੁਟੇ ਲੁਟੇ ਘਨੇ ਤੁਟੇ ਸਸਤ੍ਰ ਅਨੇਕ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਜੇ ਜੁਟੇ ਕੁਟੇ ਸਬੈ ਰਹਿ ਗਯੋ ਭੂਪਤਿ ਏਕ ॥੩੭੫॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਪੰਕਜ ਬਾਟਿਕਾ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਸੈਨ ਜੁਝਤ ਨ੍ਰਿਪ ਭਯੋ ਅਤਿ ਆਕੁਲ ॥",
      "s": 7
    },
    {
      "t": "ਧਾਵਤ ਭਯੋ ਸਾਮੁਹਿ ਅਤਿ ਬਿਆਕੁਲ ॥",
      "s": 7
    },
    {
      "t": "ਸੰਨਿਧ ਹ੍ਵੈ ਚਿਤ ਮੈ ਅਤਿ ਕ੍ਰੁਧਤ ॥",
      "s": 7
    },
    {
      "t": "ਆਵਤ ਭਯੋ ਰਿਸ ਕੈ ਕਰਿ ਜੁਧਤ ॥੩੭੬॥",
      "s": 7
    },
    {
      "t": "ਸਸਤ੍ਰ ਪ੍ਰਹਾਰ ਅਨੇਕ ਕਰੇ ਤਬ ॥",
      "s": 7
    },
    {
      "t": "ਜੰਗ ਜੁਟਿਓ ਅਪਨੋ ਦਲ ਲੈ ਸਬ ॥",
      "s": 7
    }
  ]
}
