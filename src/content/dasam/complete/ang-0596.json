{
  "page": 596,
  "lines": [
    {
      "t": "ਛਾਗੜਦੰ ਛੂਟੇ ਬਾਗੜਦੰ ਬਾਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਰਾਗੜਦੰ ਰੋਕੀ ਦਾਗੜਦੰ ਦਿਸਾਣੰ ॥੪੪੬॥",
      "s": 7
    },
    {
      "t": "ਮਾਗੜਦੰ ਮਾਰੇ ਬਾਗੜਦੰ ਬਾਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਟਾਗੜਦੰ ਟੂਟੇ ਤਾਗੜਦੰ ਤਾਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਲਾਗੜਦੰ ਲਾਗੇ ਦਾਗੜਦੰ ਦਾਹੇ ॥",
      "s": 7
    },
    {
      "t": "ਡਾਗੜਦੰ ਡਾਰੇ ਬਾਗੜਦੰ ਬਾਹੇ ॥੪੪੭॥",
      "s": 7
    },
    {
      "t": "ਬਾਗੜਦੰ ਬਰਖੇ ਫਾਗੜਦੰ ਫੂਲੰ ॥",
      "s": 7
    },
    {
      "t": "ਮਾਗੜਦੰ ਮਿਟਿਓ ਸਾਗੜਦੰ ਸੂਲੰ ॥",
      "s": 7
    },
    {
      "t": "ਮਾਗੜਦੰ ਮਾਰਿਓ ਭਾਗੜਦੰ ਭੂਪੰ ॥",
      "s": 7
    },
    {
      "t": "ਕਾਗੜਦੰ ਕੋਪੇ ਰਾਗੜਦੰ ਰੂਪੰ ॥੪੪੮॥",
      "s": 7
    },
    {
      "t": "ਜਾਗੜਦੰ ਜੰਪੈ ਪਾਗੜਦੰ ਪਾਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਦਾਗੜਦੰ ਦੇਵੰ ਆਗੜਦੰ ਆਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਸਾਗੜਦੰ ਸਿਧੰ ਕਾਗੜਦੰ ਕ੍ਰਿਤ ॥",
      "s": 7
    },
    {
      "t": "ਬਾਗੜਦੰ ਬਨਾਏ ਕਾਗੜਦੰ ਕਬਿਤੰ ॥੪੪੯॥",
      "s": 7
    },
    {
      "t": "ਰਾਗੜਦੰ ਗਾਵੈ ਕਾਗੜਦੰ ਕਬਿਤੰ ॥",
      "s": 7
    },
    {
      "t": "ਧਾਗੜਦੰ ਧਾਵੈ ਬਾਗੜਦੰ ਬਿਤ੍ਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਹਾਗੜਦੰ ਹੋਹੀ ਜਾਗੜਦੰ ਜਾਤ੍ਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਨਾਗੜਦੰ ਨਾਚੈ ਪਾਗੜਦੰ ਪਾਤ੍ਰਾ ॥੪੫੦॥",
      "s": 7
    },
    {
      "t": "ਪਾਧਰੀ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਸੰਭਰ ਨਰੇਸ ਮਾਰਿਓ ਨਿਦਾਨ ॥",
      "s": 7
    },
    {
      "t": "ਢੋਲੰ ਮਿਦੰਗ ਬਜੇ ਪ੍ਰਮਾਨ ॥",
      "s": 7
    },
    {
      "t": "ਭਾਜੇ ਸੁਬੀਰ ਤਜਿ ਜੁਧ ਤ੍ਰਾਸਿ ॥",
      "s": 7
    },
    {
      "t": "ਤਜਿ ਸਸਤ੍ਰ ਸਰਬ ਹ੍ਵੈ ਚਿਤਿ ਨਿਰਾਸ ॥੪੫੧॥",
      "s": 7
    },
    {
      "t": "ਬਰਖੰਤ ਦੇਵ ਪੁਹਪਣ ਬ੍ਰਿਸਟ ॥",
      "s": 7
    },
    {
      "t": "ਹੋਵੰਤ ਜਗ ਜਹ ਤਹ ਸੁ ਇਸਟ ॥",
      "s": 7
    },
    {
      "t": "ਪੂਜੰਤ ਲਾਗ ਦੇਵੀ ਕਰਾਲ ॥",
      "s": 7
    },
    {
      "t": "ਹੋਵੰਤ ਸਿਧ ਕਾਰਜ ਸੁ ਢਾਲ ॥੪੫੨॥",
      "s": 7
    },
    {
      "t": "ਪਾਵੰਤ ਦਾਨ ਜਾਚਕ ਦੁਰੰਤ ॥",
      "s": 7
    },
    {
      "t": "ਭਾਖੰਤ ਕ੍ਰਿਤ ਜਹ ਤਹ ਬਿਅੰਤ ॥",
      "s": 7
    },
    {
      "t": "ਜਗ ਧੂਪ ਦੀਪ ਜਗਿ ਆਦਿ ਦਾਨ ॥",
      "s": 7
    },
    {
      "t": "ਹੋਵੰਤ ਹੋਮ ਬੇਦਨ ਬਿਧਾਨ ॥੪੫੩॥",
      "s": 7
    },
    {
      "t": "ਪੂਜੰਤ ਲਾਗ ਦੇਬੀ ਦੁਰੰਤ ॥",
      "s": 7
    },
    {
      "t": "ਤਜਿ ਸਰਬ ਕਾਮ ਜਹ ਤਹ ਮਹੰਤ ॥",
      "s": 7
    },
    {
      "t": "ਬਾਧੀ ਧੁਜਾਨ ਪਰਮੰ ਪ੍ਰਚੰਡ ॥",
      "s": 7
    },
    {
      "t": "ਪ੍ਰਚੁਰਿਓ ਸੁ ਧਰਮ ਖੰਡੇ ਅਖੰਡ ॥੪੫੪॥",
      "s": 7
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਕਲਕੀ ਅਵਤਾਰ ਸੰਭਰ ਨਰੇਸ ਬਧਹ ਬਿਜਯ ਭਏਤ ਨਾਮ ਪ੍ਰਥਮ ਧਿਆਇ ਬਰਨਨੰ ਸਮਾਪਤੰ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧॥",
      "s": 7
    },
    {
      "t": "ਅਥ ਦੇਸੰਤਰ ਜੁਧ ਕਥਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਰਸਾਵਲ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਹਣ੍ਯੋ ਸੰਭਰੇਸੰ ॥",
      "s": 7
    },
    {
      "t": "ਚਤੁਰ ਚਾਰੁ ਦੇਸੰ ॥",
      "s": 7
    },
    {
      "t": "ਚਲੀ ਧਰਮ ਚਰਚਾ ॥",
      "s": 7
    },
    {
      "t": "ਕਰੈ ਕਾਲ ਅਰਚਾ ॥੪੫੫॥",
      "s": 7
    },
    {
      "t": "ਜਿਤਿਓ ਦੇਸ ਐਸੇ ॥",
      "s": 7
    },
    {
      "t": "ਚੜਿਓ ਕੋਪ ਕੈਸੇ ॥",
      "s": 7
    },
    {
      "t": "ਬੁਲਿਓ ਸਰਬ ਸੈਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਕਰੇ ਰਕਤ ਨੈਣੰ ॥੪੫੬॥",
      "s": 7
    },
    {
      "t": "ਦਈ ਜੀਤ ਬੰਬੰ ॥",
      "s": 7
    },
    {
      "t": "ਗਡਿਓ ਜੁਧ ਖੰਭੰ ॥",
      "s": 7
    }
  ]
}
