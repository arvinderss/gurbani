  "lines": [
    {
      "t": "ਘੁਰੇ ਜਾਣ ਸ੍ਯਾਮੰ ਘਟਾ ਜਿਮਿ ਜ੍ਵਾਲੰ ॥",
      "s": 7
    },
    {
      "t": "ਨਚੇ ਈਸ ਸੀਸੰ ਪੁਐ ਰੁੰਡ ਮਾਲੰ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਜੁਝੇ ਬੀਰ ਧੀਰੰ ਬਰੈ ਬੀਨਿ ਬਾਲੰ ॥੪੮੬॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਗਿਰੈ ਅੰਗ ਭੰਗੰ ਭ੍ਰਮੰ ਰੁੰਡ ਮੁੰਡੰ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਗਜੀ ਬਾਜ ਗਾਜੀ ਗਿਰੈ ਬੀਰ ਝੁੰਡੰ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਇਕੰ ਹਾਕ ਹੰਕੈਤਿ ਧਰਕੈਤ ਸੂਰੰ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਉਠੇ ਤਛ ਮੁਛੰ ਭਈ ਲੋਹ ਪੂਰੰ ॥੪੮੭॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਰਸਾਵਲ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਅਰੇ ਜੇ ਸੁ ਮਾਰੇ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਮਿਲੇ ਤੇ ਜੁ ਹਾਰੇ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਲਏ ਸਰਬ ਸੰਗੰ ॥",
      "s": 7
    },
    {
      "t": "ਰਸੇ ਰੀਝ ਰੰਗੰ ॥੪੮੮॥",
      "s": 7
    },
    {
      "t": "ਦਇਓ ਦਾਨ ਏਤੋ ॥",
      "s": 7
    },
    {
      "t": "ਕਥੈ ਕਬਿ ਕੇਤੋ ॥",
      "s": 7
    },
    {
      "t": "ਰਿਝੇ ਸਰਬ ਰਾਜਾ ॥",
      "s": 7
    },
    {
      "t": "ਬਜੇ ਬੰਬ ਬਾਜਾ ॥੪੮੯॥",
      "s": 7
    },
    {
      "t": "ਖੁਰਾਸਾਨ ਜੀਤਾ ॥",
      "s": 7
    },
    {
      "t": "ਸਬਹੂੰ ਸੰਗ ਲੀਤਾ ॥",
      "s": 7
    },
    {
      "t": "ਦਇਓ ਆਪ ਮੰਤ੍ਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਭਲੇ ਅਉਰ ਜੰਤ੍ਰੰ ॥੪੯੦॥",
      "s": 7
    },
    {
      "t": "ਚਲਿਓ ਦੇ ਨਗਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਮਿਲਿਓ ਸੈਨ ਭਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਕ੍ਰਿਪਾਣੀ ਨਿਖੰਗੰ ॥",
      "s": 7
    },
    {
      "t": "ਸਕ੍ਰੋਧੀ ਭੜੰਗੰ ॥੪੯੧॥",
      "s": 7
    },
    {
      "t": "ਤੋਟਕ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਭੂਅ ਕੰਪਤ ਜੰਪਤ ਸੇਸ ਫਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਘਹਰੰਤ ਸੁ ਘੁੰਘਰ ਘੋਰ ਰਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਸਰ ਤਜਤ ਗਜਤ ਕ੍ਰੋਧ ਜੁਧੰ ॥",
      "s": 7
    },
    {
      "t": "ਮੁਖ ਮਾਰ ਉਚਾਰਿ ਜੁਝਾਰ ਕ੍ਰੁਧੰ ॥੪੯੨॥",
      "s": 7
    },
    {
      "t": "ਬ੍ਰਿਨ ਝਲਤ ਘਲਤ ਘਾਇ ਘਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਕੜਕੁਟ ਸੁ ਪਖਰ ਬਖਤਰਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਗਣ ਗਿਧ ਸੁ ਬ੍ਰਿਧ ਰੜੰਤ ਨਭੰ ॥",
      "s": 7
    },
    {
      "t": "ਕਿਲਕਾਰਤ ਡਾਕਿਣ ਉਚ ਸੁਭੰ ॥੪੯੩॥",
      "s": 7
    },
    {
      "t": "ਗਣਿ ਹੂਰ ਸੁ ਪੂਰ ਫਿਰੀ ਗਗਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਅਵਿਲੋਕਿ ਸਬਾਹਿ ਲਗੀ ਸਰਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਮੁਖ ਭਾਵਤ ਗਾਵਤ ਗੀਤ ਸੁਰੀ ॥",
      "s": 7
    },
    {
