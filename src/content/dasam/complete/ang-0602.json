{
  "page": 602,
  "lines": [
    {
      "t": "ਅਸਿ ਲਸਤ ਰਸਤ ਤੇਗ ਜਗੀ ॥੫੦੩॥",
      "s": 7
    },
    {
      "t": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਹਨੇ ਪਛਮੀ ਦੀਹ ਦਾਨੋ ਦਿਵਾਨੇ ॥",
      "s": 7
    },
    {
      "t": "ਦਿਸਾ ਦਛਨੀ ਆਨਿ ਬਾਜੇ ਨਿਸਾਨੇ ॥",
      "s": 7
    },
    {
      "t": "ਹਨੇ ਬੀਰ ਬੀਜਾਪੁਰੀ ਗੋਲਕੁੰਡੀ ॥",
      "s": 7
    },
    {
      "t": "ਗਿਰੇ ਤਛ ਮੁਛੰ ਨਚੀ ਰੁੰਡ ਮੁੰਡੀ ॥੫੦੪॥",
      "s": 7
    },
    {
      "t": "ਸਬੈ ਸੇਤੁਬੰਧੀ ਸੁਧੀ ਬੰਦ੍ਰ ਬਾਸੀ ॥",
      "s": 7
    },
    {
      "t": "ਮੰਡੇ ਮਛਬੰਦ੍ਰੀ ਹਠੀ ਜੁਧ ਰਾਸੀ ॥",
      "s": 7
    },
    {
      "t": "ਦ੍ਰਹੀ ਦ੍ਰਾਵੜੇ ਤੇਜ ਤਾਤੇ ਤਿਲੰਗੀ ॥",
      "s": 7
    },
    {
      "t": "ਹਤੇ ਸੂਰਤੀ ਜੰਗ ਭੰਗੀ ਫਿਰੰਗੀ ॥੫੦੫॥",
      "s": 7
    },
    {
      "t": "ਚਪੇ ਚਾਦ ਰਾਜਾ ਚਲੇ ਚਾਦ ਬਾਸੀ ॥",
      "s": 7
    },
    {
      "t": "ਬਡੇ ਬੀਰ ਬਈਦਰਭਿ ਸੰਰੋਸ ਰਾਸੀ ॥",
      "s": 7
    },
    {
      "t": "ਜਿਤੇ ਦਛਨੀ ਸੰਗ ਲਿਨੇ ਸੁਧਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਦਿਸਾ ਪ੍ਰਾਚਿਯੰ ਕੋਪਿ ਕੀਨੋ ਸਵਾਰੰ ॥੫੦੬॥",
      "s": 7
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਕਲਕੀ ਅਵਤਾਰ ਦਛਨ ਜੈ ਬਿਜਯ ਨਾਮ ਦੂਜਾ ਧਿਆਯ ਸਮਾਪਤੰ ॥੨॥",
      "s": 7
    },
    {
      "t": "ਪਾਧਰੀ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਪਛਮਹਿ ਜੀਤਿ ਦਛਨ ਉਜਾਰਿ ॥",
      "s": 7
    },
    {
      "t": "ਕੋਪਿਓ ਕਛੂਕੁ ਕਲਕੀ ਵਤਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਕੀਨੋ ਪਯਾਣ ਪੂਰਬ ਦਿਸਾਣ ॥",
      "s": 7
    },
    {
      "t": "ਬਜੀਅ ਜੈਤ ਪਤ੍ਰੰ ਨਿਸਾਣ ॥੫੦੭॥",
      "s": 7
    },
    {
      "t": "ਮਾਗਧਿ ਮਹੀਪ ਮੰਡੇ ਮਹਾਨ ॥",
      "s": 7
    },
    {
      "t": "ਦਸ ਚਾਰ ਚਾਰੁ ਬਿਦਿਯਾ ਨਿਧਾਨ ॥",
      "s": 7
    },
    {
      "t": "ਬੰਗੀ ਕਲਿੰਗ ਅੰਗੀ ਅਜੀਤ ॥",
      "s": 7
    },
    {
      "t": "ਮੋਰੰਗ ਅਗੋਰ ਨਯਪਾਲ ਅਭੀਤ ॥੫੦੮॥",
      "s": 7
    },
    {
      "t": "ਛਜਾਦਿ ਕਰਣ ਇਕਾਦ ਪਾਵ ॥",
      "s": 7
    },
    {
      "t": "ਮਾਰੇ ਮਹੀਪ ਕਰ ਕੈ ਉਪਾਵ ॥",
      "s": 7
    },
    {
      "t": "ਖੰਡੇ ਅਖੰਡ ਜੋਧਾ ਦੁਰੰਤ ॥",
      "s": 7
    },
    {
      "t": "ਲਿਨੋ ਛਿਨਾਇ ਪੂਰਬੁ ਪਰੰਤ ॥੫੦੯॥",
      "s": 7
    },
    {
      "t": "ਦਿਨੋ ਨਿਕਾਰ ਰਾਛਸ ਦ੍ਰੁਬੁਧ ॥",
      "s": 7
    },
    {
      "t": "ਕਿਨੋ ਪਯਾਨ ਉਤਰ ਸੁਕ੍ਰੁਧ ॥",
      "s": 7
    },
    {
      "t": "ਮੰਡੇ ਮਹੀਪ ਮਾਵਾਸ ਥਾਨ ॥",
      "s": 7
    },
    {
      "t": "ਖੰਡੇ ਅਖੰਡ ਖੂਨੀ ਖੁਰਾਨ ॥੫੧੦॥",
      "s": 7
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਕਲਕੀ ਵਤਾਰ ਪੂਰਬ ਜੀਤ ਬਿਜਯ ਨਾਮ ਤੀਜਾ ਧਿਆਯ ਸਮਾਪਤੰ ॥੩॥",
      "s": 7
    },
    {
      "t": "ਪਾਧਰੀ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਇਹ ਭਾਤਿ ਪੂਰਬ ਪਟਨ ਉਪਟਿ ॥",
      "s": 7
    },
    {
      "t": "ਖੰਡੇ ਅਖੰਡ ਕਟੇ ਅਕਟ ॥",
      "s": 7
    },
    {
      "t": "ਫਟੇ ਅਫਟ ਖੰਡੇ ਅਖੰਡ ॥",
      "s": 7
    },
    {
      "t": "ਬਜੇ ਨਿਸਾਨ ਮਚਿਓ ਘਮੰਡ ॥੫੧੧॥",
      "s": 7
    },
    {
      "t": "ਜੋਰੇ ਸੁ ਜੰਗ ਜੋਧਾ ਜੁਝਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਜੋ ਤਜੇ ਬਾਣ ਗਜਤ ਲੁਝਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਭਾਜੰਤ ਭੀਰ ਭਹਰੰਤ ਭਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਭਭਕੰਤ ਘਾਇ ਡਿਗੇ ਅਘਾਇ ॥੫੧੨॥",
      "s": 7
    },
    {
      "t": "ਸਾਜੰਤ ਸਾਜ ਬਾਜਤ ਤੁਫੰਗ ॥",
      "s": 7
    },
    {
      "t": "ਨਾਚੰਤ ਭੂਤ ਭੈਧਰ ਸੁਰੰਗ ॥",
      "s": 7
    },
    {
      "t": "ਬਬਕੰਤ ਬਿਤਾਲ ਕਹਕੰਤ ਕਾਲ ॥",
      "s": 7
    },
    {
      "t": "ਡਮਕੰਤ ਡਉਰ ਮੁਕਤੰਤ ਜ੍ਵਾਲ ॥੫੧੩॥",
      "s": 7
    },
    {
      "t": "ਭਾਜੰਤ ਭੀਰ ਤਜਿ ਬੀਰ ਖੇਤ ॥",
      "s": 7
    },
    {
      "t": "ਨਾਚੰਤ ਭੂਤ ਬੇਤਾਲ ਪ੍ਰੇਤ ॥",
      "s": 7
    }
  ]
}
