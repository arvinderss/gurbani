{
  "page": 603,
  "lines": [
    {
      "t": "ਕ੍ਰੀੜੰਤ ਈਸ ਪੋਅੰਤ ਕਪਾਲ ॥",
      "s": 7
    },
    {
      "t": "ਨਿਰਖਤ ਬੀਰ ਛਕਿ ਬਰਤ ਬਾਲ ॥੫੧੪॥",
      "s": 7
    },
    {
      "t": "ਧਾਵੰਤ ਬੀਰ ਬਾਹੰਤ ਘਾਵ ॥",
      "s": 7
    },
    {
      "t": "ਨਾਚੰਤ ਭੂਤ ਗਾਵੰਤ ਚਾਵ ॥",
      "s": 7
    },
    {
      "t": "ਡਮਕੰਤ ਡਉਰੁ ਨਾਚੰਤ ਈਸ ॥",
      "s": 7
    },
    {
      "t": "ਰੀਝੰਤ ਹਿਮਦ੍ਰਿ ਅੰਤ ਸੀਸ ॥੫੧੫॥",
      "s": 7
    },
    {
      "t": "ਗੰਧ੍ਰਭ ਸਿਧ ਚਾਰਣ ਪ੍ਰਸਿਧ ॥",
      "s": 7
    },
    {
      "t": "ਕਥੰਤ ਕਾਬਿ ਸੋਭੰਤ ਸਿਧ ॥",
      "s": 7
    },
    {
      "t": "ਗਾਵੰਤ ਬੀਨ ਬੀਨਾ ਬਜੰਤ ॥",
      "s": 7
    },
    {
      "t": "ਰੀਝੰਤ ਦੇਵ ਮੁਨਿ ਮਨਿ ਡੁਲੰਤ ॥੫੧੬॥",
      "s": 7
    },
    {
      "t": "ਗੁੰਜਤ ਗਜਿੰਦ੍ਰ ਹੈਵਰ ਅਸੰਖ ॥",
      "s": 7
    },
    {
      "t": "ਬੁਲਤ ਸੁਬਾਹ ਮਾਰੂ ਬਜੰਤ ॥",
      "s": 7
    },
    {
      "t": "ਉਠੰਤ ਨਾਦ ਪੂਰਤ ਦਿਸਾਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਡੁਲਤ ਮਹੇਾਂਦ੍ਰ ਮਹਿ ਧਰ ਮਹਾਣੰ ॥੫੧੭॥",
      "s": 7
    },
    {
      "t": "ਖੁਲੰਤ ਖੇਤਿ ਖੂਨੀ ਖਤੰਗ ॥",
      "s": 7
    },
    {
      "t": "ਛੁਟੰਤ ਬਾਣ ਜੁਟੇ ਨਿਸੰਗ ॥",
      "s": 7
    },
    {
      "t": "ਭਿਦੰਤ ਮਰਮ ਜੁਝਤ ਸੁਬਾਹ ॥",
      "s": 7
    },
    {
      "t": "ਘੁਮੰਤ ਗੈਣਿ ਅਛ੍ਰੀ ਉਛਾਹ ॥੫੧੮॥",
      "s": 7
    },
    {
      "t": "ਸਰਖੰਤ ਸੇਲ ਬਰਖੰਤ ਬਾਣ ॥",
      "s": 7
    },
    {
      "t": "ਹਰਖੰਤ ਹੂਰ ਪਰਖੰਤ ਜੁਆਣ ॥",
      "s": 7
    },
    {
      "t": "ਬਾਜੰਤ ਢੋਲ ਡਉਰੂ ਕਰਾਲ ॥",
      "s": 7
    },
    {
      "t": "ਨਾਚੰਤ ਭੂਤ ਭੈਰੋ ਕਪਾਲਿ ॥੫੧੯॥",
      "s": 7
    },
    {
      "t": "ਹਰੜੰਤ ਹਥ ਖਰੜੰਤ ਖੋਲ ॥",
      "s": 7
    },
    {
      "t": "ਟਿਰੜੰਤ ਟੀਕ ਝਿਰੜੰਤ ਝੋਲ ॥",
      "s": 7
    },
    {
      "t": "ਦਰੜੰਤ ਦੀਹ ਦਾਨੋ ਦੁਰੰਤ ॥",
      "s": 7
    },
    {
      "t": "ਹਰੜੰਤ ਹਾਸ ਹਸਤ ਮਹੰਤ ॥੫੨੦॥",
      "s": 7
    },
    {
      "t": "ਉਤਭੁਜ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਹਹਾਸੰ ਕਪਾਲੰ ॥",
      "s": 7
    },
    {
      "t": "ਸੁ ਬਾਸੰ ਛਤਾਲੰ ॥",
      "s": 7
    },
    {
      "t": "ਪ੍ਰਭਾਸੰ ਜ੍ਵਾਲੰ ॥",
      "s": 7
    },
    {
      "t": "ਅਨਾਸੰ ਕਰਾਲੰ ॥੫੨੧॥",
      "s": 7
    },
    {
      "t": "ਮਹਾ ਰੂਪ ਧਾਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਦੁਰੰ ਦੁਖ ਤਾਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਸਰੰਨੀ ਉਧਾਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਅਘੀ ਪਾਪ ਵਾਰੇ ॥੫੨੨॥",
      "s": 7
    },
    {
      "t": "ਦਿਪੈ ਜੋਤਿ ਜ੍ਵਾਲਾ ॥",
      "s": 7
    },
    {
      "t": "ਕਿਧੌ ਜ੍ਵਾਲ ਮਾਲਾ ॥",
      "s": 7
    },
    {
      "t": "ਮਨੋ ਜ੍ਵਾਲ ਬਾਲਾ ॥",
      "s": 7
    },
    {
      "t": "ਸਰੂਪੰ ਕਰਾਲਾ ॥੫੨੩॥",
      "s": 7
    },
    {
      "t": "ਧਰੇ ਖਗ ਪਾਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਹੂੰ ਲੋਗ ਮਾਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਦਯੰ ਦੀਹ ਦਾਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਭਰੇ ਸਉਜ ਮਾਨੰ ॥੫੨੪॥",
      "s": 7
    },
    {
      "t": "ਅਜੰਨ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਅਜੀਤੇ ਜੀਤ ਜੀਤ ਕੈ ॥",
      "s": 7
    },
    {
      "t": "ਅਭੀਰੀ ਭਾਜੇ ਭੀਰ ਹ੍ਵੈ ॥",
      "s": 7
    },
    {
      "t": "ਸਿਧਾਰੇ ਚੀਨ ਰਾਜ ਪੈ ॥",
      "s": 7
    },
    {
      "t": "ਸਥੋਈ ਸਰਬ ਸਾਥ ਕੈ ॥੫੨੫॥",
      "s": 7
    }
  ]
}
