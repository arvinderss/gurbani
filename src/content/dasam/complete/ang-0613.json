{
  "page": 613,
  "lines": [
    {
      "t": "ਕਲਿ ਤਾਸੁ ਆਗਿਆ ਦੀਨ ॥",
      "s": 8
    },
    {
      "t": "ਤਬ ਬੇਦ ਬ੍ਰਹਮਾ ਕੀਨ ॥",
      "s": 8
    },
    {
      "t": "ਤਬ ਤਾਸੁ ਬਾਢ੍ਯੋ ਗਰਬ ॥",
      "s": 8
    },
    {
      "t": "ਸਰਿ ਆਪੁ ਜਾਨ ਨ ਸਰਬ ॥੨੨॥",
      "s": 8
    },
    {
      "t": "ਸਰਿ ਮੋਹ ਕਬਿ ਨਹਿ ਕੋਇ ॥",
      "s": 8
    },
    {
      "t": "ਇਕ ਆਪ ਹੋਇ ਤ ਹੋਇ ॥",
      "s": 8
    },
    {
      "t": "ਕਛੁ ਕਾਲ ਕੀ ਭੂਅ ਬਕ੍ਰ ॥",
      "s": 8
    },
    {
      "t": "ਛਿਤਿ ਡਾਰੀਆ ਜਿਮ ਸਕ੍ਰ ॥੨੩॥",
      "s": 8
    },
    {
      "t": "ਜਬ ਗਿਰ੍ਯੋ ਭੂ ਤਰਿ ਆਨਿ ॥",
      "s": 8
    },
    {
      "t": "ਮੁਖ ਚਾਰ ਬੇਦ ਨਿਧਾਨ ॥",
      "s": 8
    },
    {
      "t": "ਉਠਿ ਲਾਗਿਆ ਫਿਰ ਸੇਵ ॥",
      "s": 8
    },
    {
      "t": "ਜੀਅ ਜਾਨਿ ਦੇਵਿ ਅਭੇਵ ॥੨੪॥",
      "s": 8
    },
    {
      "t": "ਦਸ ਲਖ ਬਰਖ ਪ੍ਰਮਾਨ ॥",
      "s": 8
    },
    {
      "t": "ਕੀਅ ਦੇਵਿ ਸੇਵ ਮਹਾਨ ॥",
      "s": 8
    },
    {
      "t": "ਕਿਮਿ ਹੋਇ ਮੋਹਿ ਉਧਾਰ ॥",
      "s": 8
    },
    {
      "t": "ਅਸ ਦੇਹੁ ਦੇਵ ਬਿਚਾਰ ॥੨੫॥",
      "s": 8
    },
    {
      "t": "ਦੇਵੋ ਵਾਚ ਬ੍ਰਹਮਾ ਪ੍ਰਤਿ ॥",
      "s": 8
    },
    {
      "t": "ਮਨ ਚਿਤ ਕੈ ਕਰਿ ਸੇਵ ॥",
      "s": 8
    },
    {
      "t": "ਤਬ ਰੀਝਿ ਹੈ ਗੁਰਦੇਵ ॥",
      "s": 8
    },
    {
      "t": "ਤਬ ਹੋਇ ਨਾਥ ਸਨਾਥ ॥",
      "s": 8
    },
    {
      "t": "ਜਗਨਾਥ ਦੀਨਾ ਨਾਥ ॥੨੬॥",
      "s": 8
    },
    {
      "t": "ਸੁਨਿ ਬੈਨ ਯੌ ਮੁਖਚਾਰ ॥",
      "s": 8
    },
    {
      "t": "ਕੀਅ ਚਉਕ ਚਿਤਿ ਬਿਚਾਰ ॥",
      "s": 8
    },
    {
      "t": "ਉਠਿ ਲਾਗਿਆ ਹਰਿ ਸੇਵ ॥",
      "s": 8
    },
    {
      "t": "ਜਿਹ ਭਾਤਿ ਭਾਖ੍ਯੋ ਦੇਵ ॥੨੭॥",
      "s": 8
    },
    {
      "t": "ਪਰਿ ਪਾਇ ਚੰਡਿ ਪ੍ਰਚੰਡ ॥",
      "s": 8
    },
    {
      "t": "ਜਿਹ ਮੰਡ ਦੁਸਟ ਅਖੰਡ ॥",
      "s": 8
    },
    {
      "t": "ਜ੍ਵਾਲਾਛ ਲੋਚਨ ਧੂਮ ॥",
      "s": 8
    },
    {
      "t": "ਹਨਿ ਜਾਸੁ ਡਾਰੇ ਭੂਮਿ ॥੨੮॥",
      "s": 8
    },
    {
      "t": "ਤਿਸੁ ਜਾਪਿ ਹੋ ਜਬ ਜਾਪ ॥",
      "s": 8
    },
    {
      "t": "ਤਬ ਹੋਇ ਪੂਰਨ ਸ੍ਰਾਪ ॥",
      "s": 8
    },
    {
      "t": "ਉਠਿ ਲਾਗ ਕਾਲ ਜਪੰਨ ॥",
      "s": 8
    },
    {
      "t": "ਹਠਿ ਤਿਆਗ ਆਵ ਸਰੰਨ ॥੨੯॥",
      "s": 8
    },
    {
      "t": "ਜੇ ਜਾਤ ਤਾਸੁ ਸਰੰਨਿ ॥",
      "s": 8
    },
    {
      "t": "ਤੇ ਹੈ ਧਰਾ ਮੈ ਧਨਿ ॥",
      "s": 8
    },
    {
      "t": "ਤਿਨ ਕਉ ਨ ਕਉਨੈ ਤ੍ਰਾਸ ॥",
      "s": 8
    },
    {
      "t": "ਸਬ ਹੋਤ ਕਾਰਜ ਰਾਸ ॥੩੦॥",
      "s": 8
    },
    {
      "t": "ਦਸ ਲਛ ਬਰਖ ਪ੍ਰਮਾਨ ॥",
      "s": 8
    },
    {
      "t": "ਰਹ੍ਯੋ ਠਾਢ ਏਕ ਪਗਾਨ ॥",
      "s": 8
    },
    {
      "t": "ਚਿਤ ਲਾਇ ਕੀਨੀ ਸੇਵ ॥",
      "s": 8
    },
    {
      "t": "ਤਬ ਰੀਝਿ ਗੇ ਗੁਰਦੇਵ ॥੩੧॥",
      "s": 8
    },
    {
      "t": "ਜਬ ਭੇਤ ਦੇਵੀ ਦੀਨ ॥",
      "s": 8
    },
    {
      "t": "ਤਬ ਸੇਵ ਬ੍ਰਹਮਾ ਕੀਨ ॥",
      "s": 8
    },
    {
      "t": "ਜਬ ਸੇਵ ਕੀ ਚਿਤ ਲਾਇ ॥",
      "s": 8
    },
    {
      "t": "ਤਬ ਰੀਝਿ ਗੇ ਹਰਿ ਰਾਇ ॥੩੨॥",
      "s": 8
    },
    {
      "t": "ਤਬ ਭਯੋ ਸੁ ਐਸ ਉਚਾਰ ॥",
      "s": 8
    },
    {
      "t": "ਹਉ ਆਹਿ ਗ੍ਰਬ ਪ੍ਰਹਾਰ ॥",
      "s": 8
    },
    {
      "t": "ਮਮ ਗਰਬ ਕਹੂੰ ਨ ਛੋਰਿ ॥",
      "s": 8
    },
    {
      "t": "ਸਭ ਕੀਨ ਜੇਰ ਮਰੋਰਿ ॥੩੩॥",
      "s": 8
    },
    {
      "t": "ਤੈ ਗਰਬ ਕੀਨ ਸੁ ਕਾਹਿ ॥",
      "s": 8
    },
    {
      "t": "ਨਹਿ ਮੋਹ ਭਾਵਤ ਤਾਹਿ ॥",
      "s": 8
    },
    {
      "t": "ਅਬ ਕਹੋ ਏਕ ਬਿਚਾਰ ॥",
      "s": 8
    },
    {
      "t": "ਜਿਮਿ ਹੋਇ ਤੋਹਿ ਉਧਾਰ ॥੩੪॥",
      "s": 8
    },
    {
      "t": "ਧਰਿ ਸਪਤ ਭੂਮਿ ਵਤਾਰ ॥",
      "s": 8
    },
    {
      "t": "ਤਬ ਹੋਇ ਤੋਹਿ ਉਧਾਰਿ ॥",
      "s": 8
    },
    {
      "t": "ਸੋਈ ਮਾਨ ਬ੍ਰਹਮਾ ਲੀਨ ॥",
      "s": 8
    },
    {
      "t": "ਧਰਿ ਜਨਮ ਜਗਤਿ ਨਵੀਨ ॥੩੫॥",
      "s": 8
    },
    {
      "t": "ਮੁਰਿ ਨਿੰਦ ਉਸਤਤਿ ਤੂਲਿ ॥",
      "s": 8
    },
    {
      "t": "ਇਮਿ ਜਾਨਿ ਜੀਯ ਜਿਨਿ ਭੂਲਿ ॥",
      "s": 8
    },
    {
      "t": "ਇਕ ਕਹੋ ਔਰ ਬਿਚਾਰ ॥",
      "s": 8
    },
    {
      "t": "ਸੁਨਿ ਲੇਹੁ ਬ੍ਰਹਮ ਕੁਮਾਰ ॥੩੬॥",
      "s": 8
    },
    {
      "t": "ਇਕ ਬਿਸਨੁ ਮੋਹਿ ਧਿਆਨ ॥",
      "s": 8
    },
    {
      "t": "ਬਹੁ ਸੇਵਿ ਮੋਹਿ ਰਿਝਾਨ ॥",
      "s": 8
    },
    {
      "t": "ਤਿਨਿ ਮਾਗਿਆ ਬਰ ਐਸ ॥",
      "s": 8
    },
    {
      "t": "ਮਮ ਦੀਨ ਤਾ ਕਹੁ ਤੈਸ ॥੩੭॥",
      "s": 8
    },
    {
      "t": "ਮਮ ਤਾਸ ਭੇਦ ਨ ਕੋਇ ॥",
      "s": 8
    },
    {
      "t": "ਸਬ ਲੋਕ ਜਾਨਤ ਸੋਇ ॥",
      "s": 8
    },
    {
      "t": "ਤਿਹ ਜਾਨ ਹੈ ਕਰਤਾਰ ॥",
      "s": 8
    },
    {
      "t": "ਸਬ ਲੋਕ ਅਲੋਕ ਪਹਾਰ ॥੩੮॥",
      "s": 8
    },
    {
      "t": "ਜਬ ਜਬ ਧਰੇ ਬਪੁ ਸੋਇ ॥",
      "s": 8
    },
    {
      "t": "ਜੋ ਜੋ ਪਰਾਕ੍ਰਮ ਹੋਇ ॥",
      "s": 8
    },
    {
      "t": "ਸੋ ਸੋ ਕਥੌ ਅਬਿਚਾਰ ॥",
      "s": 8
    }
  ]
}
