{
  "page": 622,
  "lines": [
    {
      "t": "ਚਚਕਤ ਚੰਦ ॥",
      "s": 8
    },
    {
      "t": "ਧਧਕਤ ਇੰਦ ॥",
      "s": 8
    },
    {
      "t": "ਫਨਿਮਨ ਫਟੰਤ ॥",
      "s": 8
    },
    {
      "t": "ਭੂਅਧਰ ਭਜੰਤ ॥੧੦੧॥",
      "s": 8
    },
    {
      "t": "ਸੰਜੁਤਾ ਛੰਦ ॥",
      "s": 8
    },
    {
      "t": "ਜਸ ਠੌਰ ਠੌਰ ਸਬੋ ਸੁਨ੍ਯੋ ॥",
      "s": 8
    },
    {
      "t": "ਅਰਿ ਬ੍ਰਿੰਦ ਸੀਸ ਸਬੋ ਧੁਨ੍ਰਯੋ ॥",
      "s": 8
    },
    {
      "t": "ਜਗ ਜਗ ਸਾਜ ਭਲੇ ਕਰੇ ॥",
      "s": 8
    },
    {
      "t": "ਦੁਖ ਪੁੰਜ ਦੀਨਨ ਕੇ ਹਰੇ ॥੧੦੨॥",
      "s": 8
    },
    {
      "t": "ਇਤਿ ਜੁਜਾਤਿ ਰਾਜਾ ਮ੍ਰਿਤ ਬਸਿ ਹੋਤ ਭਏ ॥੫॥੫॥",
      "s": 8
    },
    {
      "t": "ਅਥ ਬੇਨ ਰਾਜੇ ਕੋ ਰਾਜ ਕਥਨੰ ॥",
      "s": 8
    },
    {
      "t": "ਸੰਜੁਤਾ ਛੰਦ ॥",
      "s": 8
    },
    {
      "t": "ਪੁਨਿ ਬੇਣੁ ਰਾਜ ਮਹੇਸ ਭਯੋ ॥",
      "s": 8
    },
    {
      "t": "ਨਿਜਿ ਡੰਡ ਕਾਹੂੰ ਤੇ ਨ ਲਯੋ ॥",
      "s": 8
    },
    {
      "t": "ਜੀਅ ਭਾਤਿ ਭਾਤਿ ਸੁਖੀ ਨਰਾ ॥",
      "s": 8
    },
    {
      "t": "ਅਤਿ ਗਰਬ ਸ੍ਰਬ ਛੁਟਿਓ ਧਰਾ ॥੧੦੩॥",
      "s": 8
    },
    {
      "t": "ਜੀਅ ਜੰਤ ਸਬ ਦਿਖਿਯਤ ਸੁਖੀ ॥",
      "s": 8
    },
    {
      "t": "ਤਰਿ ਦ੍ਰਿਸਟਿ ਆਵਤ ਨ ਦੁਖੀ ॥",
      "s": 8
    },
    {
      "t": "ਸਬ ਠੌਰ ਠੌਰ ਪ੍ਰਿਥੀ ਬਸੀ ॥",
      "s": 8
    },
    {
      "t": "ਜਨੁ ਭੂਮਿ ਰਾਜ ਸਿਰੀ ਲਸੀ ॥੧੦੪॥",
      "s": 8
    },
    {
      "t": "ਇਹ ਭਾਤਿ ਰਾਜ ਕਮਾਇ ਕੈ ॥",
      "s": 8
    },
    {
      "t": "ਸੁਖ ਦੇਸ ਸਰਬ ਬਸਾਇ ਕੈ ॥",
      "s": 8
    },
    {
      "t": "ਬਹੁ ਦੋਖ ਦੀਨਨ ਕੇ ਦਹੇ ॥",
      "s": 8
    },
    {
      "t": "ਸੁਨਿ ਥਕਤ ਦੇਵ ਸਮਸਤ ਭਏ ॥੧੦੫॥",
      "s": 8
    },
    {
      "t": "ਬਹੁ ਰਾਜ ਸਾਜ ਕਮਾਇ ਕੈ ॥",
      "s": 8
    },
    {
      "t": "ਸਿਰਿ ਅਤ੍ਰਪਤ੍ਰ ਫਿਰਾਇ ਕੈ ॥",
      "s": 8
    },
    {
      "t": "ਪੁਨਿ ਜੋਤਿ ਜੋਤਿ ਬਿਖੈ ਮਿਲੀ ॥",
      "s": 8
    },
    {
      "t": "ਅਰਿ ਛੈਨੁ ਬੇਨੁ ਮਹਾਬਲੀ ॥੧੦੬॥",
      "s": 8
    },
    {
      "t": "ਅਬਿਕਾਰ ਭੂਪ ਜਿਤੇ ਭਏ ॥",
      "s": 8
    },
    {
      "t": "ਕਰਿ ਰਾਜ ਅੰਤ ਸਮੈ ਗਏ ॥",
      "s": 8
    },
    {
      "t": "ਕਬਿ ਕੌਨ ਨਾਮ ਤਿਨੈ ਗਨੈ ॥",
      "s": 8
    },
    {
      "t": "ਸੰਕੇਤ ਕਰਿ ਇਤੇ ਭਨੈ ॥੧੦੭॥",
      "s": 8
    },
    {
      "t": "ਇਤਿ ਬੇਨੁ ਰਾਜਾ ਮ੍ਰਿਤ ਬਸ ਹੋਤ ਭਏ ॥੬॥੫॥",
      "s": 8
    },
    {
      "t": "ਅਥ ਮਾਨਧਾਤਾ ਕੋ ਰਾਜੁ ਕਥਨੰ",
      "s": 8
    },
    {
      "t": "ਦੋਧਕ ਛੰਦ ॥",
      "s": 8
    },
    {
      "t": "ਜੇਤਕ ਭੂਪ ਭਏ ਅਵਨੀ ਪਰ ॥",
      "s": 8
    },
    {
      "t": "ਨਾਮ ਸਕੈ ਤਿਨ ਕੇ ਕਵਿ ਕੋ ਧਰਿ ॥",
      "s": 8
    },
    {
      "t": "ਨਾਮ ਜਥਾਮਤਿ ਭਾਖਿ ਸੁਨਾਊ ॥",
      "s": 8
    },
    {
      "t": "ਚਿਤ ਤਊ ਅਪਨੇ ਡਰ ਪਾਊ ॥੧੦੮॥",
      "s": 8
    },
    {
      "t": "ਬੇਨੁ ਗਏ ਜਗ ਤੇ ਨ੍ਰਿਪਤਾ ਕਰਿ ॥",
      "s": 8
    },
    {
      "t": "ਮਾਨਧਾਤ ਭਏ ਬਸੁਧਾ ਧਰਿ ॥",
      "s": 8
    },
    {
      "t": "ਬਾਸਵ ਲੋਗ ਗਏ ਜਬ ਹੀ ਵਹ ॥",
      "s": 8
    },
    {
      "t": "ਉਠਿ ਦਯੋ ਅਰਧਾਸਨ ਬਾਸਵ ਤਿਹ ॥੧੦੯॥",
      "s": 8
    },
    {
      "t": "ਰੋਸ ਭਰ੍ਯੋ ਤਬ ਮਾਨ ਮਹੀਧਰ ॥",
      "s": 8
    },
    {
      "t": "ਹਾਕਿ ਗਹ੍ਰਯੋ ਕਰਿ ਖਗ ਭਯੰਕਰ ॥",
      "s": 8
    },
    {
      "t": "ਮਾਰਨ ਲਾਗ ਜਬੈ ਰਿਸ ਇੰਦ੍ਰਹਿ ॥",
      "s": 8
    },
    {
      "t": "ਬਾਹ ਗਹੀ ਤਤਕਾਲ ਦਿਜਿੰਦ੍ਰਹਿ ॥੧੧੦॥",
      "s": 8
    },
    {
      "t": "ਨਾਸ ਕਰੋ ਜਿਨਿ ਬਾਸਵ ਕੋ ਨ੍ਰਿਪ ॥",
      "s": 8
    }
  ]
}
