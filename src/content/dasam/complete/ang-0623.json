{
  "page": 623,
  "lines": [
    {
      "t": "ਆਸਨ ਅਰਧ ਦਯੋ ਤੁਹ ਯਾ ਬ੍ਰਤ ॥",
      "s": 8
    },
    {
      "t": "ਹੈ ਲਵਨਾਸ੍ਰ ਮਹਾਸੁਰ ਭੂਧਰਿ ॥",
      "s": 8
    },
    {
      "t": "ਤਾਹਿ ਨ ਮਾਰ ਸਕੇ ਤੁਮ ਕਿਉ ਕਰ ॥੧੧੧॥",
      "s": 8
    },
    {
      "t": "ਜੌ ਤੁਮ ਤਾਹਿ ਸੰਘਾਰ ਕੈ ਆਵਹੁ ॥",
      "s": 8
    },
    {
      "t": "ਤੌ ਤੁਮ ਇੰਦ੍ਰ ਸਿੰਘਾਸਨ ਪਾਵਹੁ ॥",
      "s": 8
    },
    {
      "t": "ਐਸੇ ਕੈ ਅਰਧ ਸਿੰਘਾਸਨ ਬੈਠਹੁ ॥",
      "s": 8
    },
    {
      "t": "ਸਾਚੁ ਕਹੋ ਪਰ ਨਾਕੁ ਨ ਐਠਹੁ ॥੧੧੨॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 8
    },
    {
      "t": "ਅਸਤਰ ਛੰਦ ॥",
      "s": 8
    },
    {
      "t": "ਧਾਯੋ ਅਸਤ੍ਰ ਲੈ ਕੇ ਤਹਾ ॥",
      "s": 8
    },
    {
      "t": "ਮਥੁਰਾ ਮੰਡਲ ਦਾਨੋ ਥਾ ਜਹਾ ॥",
      "s": 8
    },
    {
      "t": "ਮਹਾ ਗਰਬੁ ਕੈ ਕੈ ਮਹਾ ਮੰਦ ਬੁਧੀ ॥",
      "s": 8
    },
    {
      "t": "ਮਹਾ ਜੋਰ ਕੈ ਕੈ ਦਲੰ ਪਰਮ ਕ੍ਰੁਧੀ ॥੧੧੩॥",
      "s": 8
    },
    {
      "t": "ਮਹਾ ਘੋਰ ਕੈ ਕੈ ਘਨੰ ਕੀ ਘਟਾ ਜਿਯੋ ॥",
      "s": 8
    },
    {
      "t": "ਸੁ ਧਾਇਆ ਰਣੰ ਬਿਜੁਲੀ ਕੀ ਛਟਾ ਜਿਯੋ ॥",
      "s": 8
    },
    {
      "t": "ਸੁਨੇ ਸਰਬ ਦਾਨੋ ਸੁ ਸਾਮੁਹਿ ਸਿਧਾਇ ॥",
      "s": 8
    },
    {
      "t": "ਮਹਾ ਕ੍ਰੋਧ ਕੈ ਕੈ ਸੁ ਬਾਜੀ ਨਚਾਏ ॥੧੧੪॥",
      "s": 8
    },
    {
      "t": "ਮੇਦਕ ਛੰਦ ॥",
      "s": 8
    },
    {
      "t": "ਅਬ ਏਕ ਕੀਏ ਬਿਨੁ ਯੌ ਨ ਟਰੈ ॥",
      "s": 8
    },
    {
      "t": "ਦੋਊ ਦਾਤਨ ਪੀਸ ਹੰਕਾਰਿ ਪਰੈ ॥",
      "s": 8
    },
    {
      "t": "ਜਬ ਲੌ ਨ ਸੁਨੋ ਲਵ ਖੇਤ ਮਰਾ ॥",
      "s": 8
    },
    {
      "t": "ਤਬ ਲਉ ਨ ਲਖੋ ਰਨਿ ਬਾਜ ਟਰਾ ॥੧੧੫॥",
      "s": 8
    },
    {
      "t": "ਅਬ ਹੀ ਰਣਿ ਏਕ ਕੀ ਏਕ ਕਰੈ ॥",
      "s": 8
    },
    {
      "t": "ਬਿਨੁ ਏਕ ਕੀਏ ਰਣਿ ਤੇ ਨ ਟਰੈ ॥",
      "s": 8
    },
    {
      "t": "ਬਹੁ ਸਾਲ ਸਿਲਾ ਤਲ ਬ੍ਰਿਛ ਛੁਟੇ ॥",
      "s": 8
    },
    {
      "t": "ਦੁਹੂੰ ਓਰਿ ਜਬੈ ਰਣ ਬੀਰ ਜੁਟੇ ॥੧੧੬॥",
      "s": 8
    },
    {
      "t": "ਕੁਪ ਕੈ ਲਵ ਪਾਨਿ ਤ੍ਰਿਸੂਲ ਲਯੋ ॥",
      "s": 8
    },
    {
      "t": "ਸਿਰਿ ਧਾਤਯਮਾਨ ਦੁਖੰਡ ਕਿਯੋ ॥",
      "s": 8
    },
    {
      "t": "ਬਹੁ ਜੂਥਪ ਜੂਥਨ ਸੈਨ ਭਜੀ ॥",
      "s": 8
    },
    {
      "t": "ਨ ਉਚਾਇ ਸਕੈ ਸਿਰੁ ਐਸ ਲਜੀ ॥੧੧੭॥",
      "s": 8
    },
    {
      "t": "ਘਨ ਜੈਸੇ ਭਜੇ ਘਨ ਘਾਇਲ ਹੁਐ ॥",
      "s": 8
    },
    {
      "t": "ਬਰਖਾ ਜਿਮਿ ਸ੍ਰੋਣਤ ਧਾਰ ਚੁਐ ॥",
      "s": 8
    },
    {
      "t": "ਸਭ ਮਾਨ ਮਹੀਪਤਿ ਛੇਤ੍ਰਹਿ ਦੈ ॥",
      "s": 8
    },
    {
      "t": "ਸਬ ਹੀ ਦਲ ਭਾਜਿ ਚਲਾ ਜੀਅ ਲੈ ॥੧੧੮॥",
      "s": 8
    },
    {
      "t": "ਇਕ ਘੂਮਤ ਘਾਇਲ ਸੀਸ ਫੁਟੇ ॥",
      "s": 8
    },
    {
      "t": "ਇਕ ਸ੍ਰੋਣ ਚੁਚਾਵਤ ਕੇਸ ਛੁਟੇ ॥",
      "s": 8
    },
    {
      "t": "ਰਣਿ ਮਾਰ ਕੈ ਮਾਨਿ ਤ੍ਰਿਸੂਲ ਲੀਏ ॥",
      "s": 8
    },
    {
      "t": "ਭਟ ਭਾਤਹਿ ਭਾਤਿ ਭਜਾਇ ਦੀਏ ॥੧੧੯॥",
      "s": 8
    },
    {
      "t": "ਇਤਿ ਮਾਨਧਾਤਾ ਰਾਜ ਸਮਾਪਤੰ ॥੭॥੫॥",
      "s": 8
    },
    {
      "t": "ਅਥ ਦਲੀਪ ਕੋ ਰਾਜ ਕਥਨੰ ॥",
      "s": 8
    },
    {
      "t": "ਤੋਟਕ ਛੰਦ ॥",
      "s": 8
    },
    {
      "t": "ਰਣ ਮੋ ਮਾਨ ਮਹੀਪ ਹਏ ॥",
      "s": 8
    },
    {
      "t": "ਤਬ ਆਨਿ ਦਿਲੀਪ ਦਿਲੀਸ ਭਏ ॥",
      "s": 8
    },
    {
      "t": "ਬਹੁ ਭਾਤਿਨ ਦਾਨਵ ਦੀਹ ਦਲੇ ॥",
      "s": 8
    },
    {
      "t": "ਸਬ ਠੌਰ ਸਬੈ ਉਠਿ ਧਰਮ ਪਲੇ ॥੧੨੦॥",
      "s": 8
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 8
    },
    {
      "t": "ਜਬ ਨ੍ਰਿਪ ਹਨਾ ਮਾਨਧਾਤਾ ਬਰ ॥",
      "s": 8
    },
    {
      "t": "ਸਿਵ ਤ੍ਰਿਸੂਲ ਕਰਿ ਧਰਿ ਲਵਨਾਸੁਰ ॥",
      "s": 8
    },
    {
      "t": "ਭਯੋ ਦਲੀਪ ਜਗਤ ਕੋ ਰਾਜਾ ॥",
      "s": 8
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਜਿਹ ਰਾਜ ਬਿਰਾਜਾ ॥੧੨੧॥",
      "s": 8
    },
    {
      "t": "ਮਹਾਰਥੀ ਅਰੁ ਮਹਾ ਨ੍ਰਿਪਾਰਾ ॥",
      "s": 8
    },
    {
      "t": "ਕਨਕ ਅਵਟਿ ਸਾਚੇ ਜਨੁ ਢਾਰਾ ॥",
      "s": 8
    },
    {
      "t": "ਅਤਿ ਸੁੰਦਰ ਜਨੁ ਮਦਨ ਸਰੂਪਾ ॥",
      "s": 8
    },
    {
      "t": "ਜਾਨੁਕ ਬਨੇ ਰੂਪ ਕੋ ਭੂਪਾ ॥੧੨੨॥",
      "s": 8
    },
    {
      "t": "ਬਹੁ ਬਿਧਿ ਕਰੇ ਜਗ ਬਿਸਥਾਰਾ ॥",
      "s": 8
    },
    {
      "t": "ਬਿਧਵਤ ਹੋਮ ਦਾਨ ਮਖਸਾਰਾ ॥",
      "s": 8
    },
    {
      "t": "ਧਰਮ ਧੁਜਾ ਜਹ ਤਹ ਬਿਰਾਜੀ ॥",
      "s": 8
    },
    {
      "t": "ਇੰਦ੍ਰਾਵਤੀ ਨਿਰਖਿ ਦੁਤਿ ਲਾਜੀ ॥੧੨੩॥",
      "s": 8
    },
    {
      "t": "ਪਗ ਪਗ ਜਗਿ ਖੰਭ ਕਹੁ ਗਾਡਾ ॥",
      "s": 8
    },
    {
      "t": "ਘਰਿ ਘਰਿ ਅੰਨ ਸਾਲ ਕਰਿ ਛਾਡਾ ॥",
      "s": 8
    },
    {
      "t": "ਭੂਖਾ ਨਾਗ ਜੁ ਆਵਤ ਕੋਈ ॥",
      "s": 8
    },
    {
      "t": "ਤਤਛਿਨ ਇਛ ਪੁਰਾਵਤ ਸੋਈ ॥੧੨੪॥",
      "s": 8
    },
    {
      "t": "ਜੋ ਜਿਹੰ ਮੁਖ ਮਾਗਾ ਤਿਹ ਪਾਵਾ ॥",
      "s": 8
    },
    {
      "t": "ਬਿਮੁਖ ਆਸ ਫਿਰਿ ਭਿਛਕ ਨ ਆਵਾ ॥",
      "s": 8
    },
    {
      "t": "ਧਾਮਿ ਧਾਮਿ ਧੁਜਾ ਧਰਮ ਬਧਾਈ ॥",
      "s": 8
    },
    {
      "t": "ਧਰਮਾਵਤੀ ਨਿਰਖਿ ਮੁਰਛਾਈ ॥੧੨੫॥",
      "s": 8
    },
    {
      "t": "ਮੂਰਖ ਕੋਊ ਰਹੈ ਨਹਿ ਪਾਵਾ ॥",
      "s": 8
    },
    {
      "t": "ਬਾਰ ਬੂਢ ਸਭ ਸੋਧਿ ਪਢਾਵਾ ॥",
      "s": 8
    },
    {
      "t": "ਘਰਿ ਘਰਿ ਹੋਤ ਭਈ ਹਰਿ ਸੇਵਾ ॥",
      "s": 8
    },
    {
      "t": "ਜਹ ਤਹ ਮਾਨਿ ਸਬੈ ਗੁਰ ਦੇਵਾ ॥੧੨੬॥",
      "s": 8
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਰਾਜ ਦਿਲੀਪ ਬਡੋ ਕਰਿ ॥",
      "s": 8
    },
    {
      "t": "ਮਹਾਰਥੀ ਅਰੁ ਮਹਾ ਧਨੁਰ ਧਰ ॥",
      "s": 8
    },
    {
      "t": "ਕੋਕ ਸਾਸਤ੍ਰ ਸਿਮ੍ਰਿਤਿ ਸੁਰ ਗਿਆਨਾ ॥",
      "s": 8
    }
  ]
}
