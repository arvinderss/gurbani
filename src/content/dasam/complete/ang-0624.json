{
  "page": 624,
  "lines": [
    {
      "t": "ਜੋਤਿਵੰਤ ਦਸ ਚਾਰਿ ਨਿਧਾਨਾ ॥੧੨੭॥",
      "s": 8
    },
    {
      "t": "ਮਹਾ ਕ੍ਰਮਠੀ ਮਹਾ ਸੁਜਾਨੂ ॥",
      "s": 8
    },
    {
      "t": "ਮਹਾ ਜੋਤਿ ਦਸ ਚਾਰਿ ਨਿਧਾਨੂ ॥",
      "s": 8
    },
    {
      "t": "ਅਤਿ ਸਰੂਪ ਅਰੁ ਅਮਿਤ ਪ੍ਰਭਾਸਾ ॥",
      "s": 8
    },
    {
      "t": "ਮਹਾ ਮਾਨ ਅਰੁ ਮਹਾ ਉਦਾਸਾ ॥੧੨੮॥",
      "s": 8
    },
    {
      "t": "ਬੇਦ ਅੰਗ ਖਟ ਸਾਸਤ੍ਰ ਪ੍ਰਬੀਨਾ ॥",
      "s": 8
    },
    {
      "t": "ਧਨੁਰਬੇਦ ਪ੍ਰਭ ਕੇ ਰਸ ਲੀਨਾ ॥",
      "s": 8
    },
    {
      "t": "ਖੜਗਨ ਈਸ੍ਵਰ ਪੁਨਿ ਅਤੁਲ ਬਲ ॥",
      "s": 8
    },
    {
      "t": "ਅਰਿ ਅਨੇਕ ਜੀਤੇ ਜਿਨਿ ਦਲਿ ਮਲਿ ॥੧੨੯॥",
      "s": 8
    },
    {
      "t": "ਖੰਡ ਅਖੰਡ ਜੀਤਿ ਬਡ ਰਾਜਾ ॥",
      "s": 8
    },
    {
      "t": "ਆਨਿ ਸਮਾਨ ਨ ਆਪੁ ਬਿਰਾਜਾ ॥",
      "s": 8
    },
    {
      "t": "ਅਤਿ ਬਲਿਸਟ ਅਸਿ ਤੇਜ ਪ੍ਰਚੰਡਾ ॥",
      "s": 8
    },
    {
      "t": "ਅਰਿ ਅਨੇਕ ਜਿਨਿ ਸਾਧਿ ਉਦੰਡਾ ॥੧੩੦॥",
      "s": 8
    },
    {
      "t": "ਦੇਸ ਬਿਦੇਸ ਅਧਿਕ ਜਿਹ ਜੀਤਾ ॥",
      "s": 8
    },
    {
      "t": "ਜਹ ਤਹ ਚਲੀ ਰਾਜ ਕੀ ਨੀਤਾ ॥",
      "s": 8
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਸਿਰਿ ਛਤ੍ਰ ਬਿਰਾਜਾ ॥",
      "s": 8
    },
    {
      "t": "ਤਜਿ ਹਠ ਚਰਨਿ ਲਗੇ ਬਡ ਰਾਜਾ ॥੧੩੧॥",
      "s": 8
    },
    {
      "t": "ਜਹ ਤਹ ਹੋਤ ਧਰਮ ਕੀ ਰੀਤਾ ॥",
      "s": 8
    },
    {
      "t": "ਕਹੂੰ ਨ ਪਾਵਤਿ ਹੋਨਿ ਅਨੀਤਾ ॥",
      "s": 8
    },
    {
      "t": "ਦਾਨ ਨਿਸਾਨ ਚਹੂੰ ਚਕ ਬਾਜਾ ॥",
      "s": 8
    },
    {
      "t": "ਕਰਨ ਕੁਬੇਰ ਬੇਣੁ ਬਲਿ ਰਾਜਾ ॥੧੩੨॥",
      "s": 8
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਰਾਜ ਕਮਾਈ ॥",
      "s": 8
    },
    {
      "t": "ਆ ਸਮੁਦ੍ਰ ਲੌ ਫਿਰੀ ਦੁਹਾਈ ॥",
      "s": 8
    },
    {
      "t": "ਜਹ ਤਹ ਕਰਮ ਪਾਪ ਭਯੋ ਦੂਰਾ ॥",
      "s": 8
    },
    {
      "t": "ਧਰਮ ਕਰਮ ਸਭ ਕਰਤ ਹਜੂਰਾ ॥੧੩੩॥",
      "s": 8
    },
    {
      "t": "ਜਹ ਤਹ ਪਾਪ ਛਪਾ ਸਬ ਦੇਸਾ ॥",
      "s": 8
    },
    {
      "t": "ਧਰਮ ਕਰਮ ਉਠਿ ਲਾਗਿ ਨਰੇਸਾ ॥",
      "s": 8
    },
    {
      "t": "ਆ ਸਮੁਦ੍ਰ ਲੌ ਫਿਰੀ ਦੁਹਾਈ ॥",
      "s": 8
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਕਰੀ ਦਿਲੀਪ ਰਜਾਈ ॥੧੩੪॥",
      "s": 8
    },
    {
      "t": "ਇਤਿ ਦਲੀਪ ਰਾਜ ਸਮਾਪਤੰ ॥੮॥੫॥",
      "s": 8
    },
    {
      "t": "ਅਥ ਰਘੁ ਰਾਜਾ ਕੋ ਰਾਜ ਕਥਨੰ ॥",
      "s": 8
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 8
    },
    {
      "t": "ਬਹੁਰ ਜੋਤਿ ਸੋ ਜੋਤਿ ਮਿਲਾਨੀ ॥",
      "s": 8
    },
    {
      "t": "ਸਬ ਜਗ ਐਸ ਕ੍ਰਿਆ ਪਹਿਚਾਨੀ ॥",
      "s": 8
    },
    {
      "t": "ਸ੍ਰੀ ਰਘੁਰਾਜ ਰਾਜੁ ਜਗਿ ਕੀਨਾ ॥",
      "s": 8
    },
    {
      "t": "ਅਤ੍ਰਪਤ੍ਰ ਸਿਰਿ ਢਾਰਿ ਨਵੀਨਾ ॥੧੩੫॥",
      "s": 8
    },
    {
      "t": "ਬਹੁਤੁ ਭਾਤਿ ਕਰਿ ਜਗਿ ਪ੍ਰਕਾਰਾ ॥",
      "s": 8
    },
    {
      "t": "ਦੇਸ ਦੇਸ ਮਹਿ ਧਰਮ ਬਿਥਾਰਾ ॥",
      "s": 8
    },
    {
      "t": "ਪਾਪੀ ਕੋਈ ਨਿਕਟਿ ਨ ਰਾਖਾ ॥",
      "s": 8
    },
    {
      "t": "ਝੂਠ ਬੈਨ ਕਿਹੂੰ ਭੂਲਿ ਨ ਭਾਖਾ ॥੧੩੬॥",
      "s": 8
    },
    {
      "t": "ਨਿਸਾ ਤਾਸੁ ਨਿਸ ਨਾਥ ਪਛਾਨਾ ॥",
      "s": 8
    },
    {
      "t": "ਦਿਨਕਰ ਤਾਹਿ ਦਿਵਸ ਅਨੁਮਾਨਾ ॥",
      "s": 8
    },
    {
      "t": "ਬੇਦਨ ਤਾਹਿ ਬ੍ਰਹਮ ਕਰਿ ਲੇਖਾ ॥",
      "s": 8
    },
    {
      "t": "ਦੇਵਨ ਇੰਦ੍ਰ ਰੂਪ ਅਵਿਰੇਖਾ ॥੧੩੭॥",
      "s": 8
    },
    {
      "t": "ਬਿਪਨ ਸਬਨ ਬ੍ਰਹਸਪਤਿ ਦੇਖ੍ਯੋ ॥",
      "s": 8
    },
    {
      "t": "ਦੈਤਨ ਗੁਰੂ ਸੁਕ੍ਰ ਕਰਿ ਪੇਖ੍ਯੋ ॥",
      "s": 8
    },
    {
      "t": "ਰੋਗਨ ਤਾਹਿ ਅਉਖਧੀ ਮਾਨਾ ॥",
      "s": 8
    },
    {
      "t": "ਜੋਗਿਨ ਪਰਮ ਤਤ ਪਹਿਚਾਨਾ ॥੧੩੮॥",
      "s": 8
    },
    {
      "t": "ਬਾਲਨ ਬਾਲ ਰੂਪ ਅਵਿਰੇਖ੍ਰਯੋ ॥",
      "s": 8
    },
    {
      "t": "ਜੋਗਨ ਮਹਾ ਜੋਗ ਕਰਿ ਦੇਖ੍ਯੋ ॥",
      "s": 8
    },
    {
      "t": "ਦਾਤਨ ਮਹਾਦਾਨਿ ਕਰਿ ਮਾਨ੍ਯੋ ॥",
      "s": 8
    },
    {
      "t": "ਭੋਗਨ ਭੋਗ ਰੂਪ ਪਹਚਾਨ੍ਯੋ ॥੧੩੯॥",
      "s": 8
    },
    {
      "t": "ਸੰਨਿਆਸਨ ਦਤ ਰੂਪ ਕਰਿ ਜਾਨ੍ਯੋ ॥",
      "s": 8
    },
    {
      "t": "ਜੋਗਨ ਗੁਰ ਗੋਰਖ ਕਰਿ ਮਾਨ੍ਯੋ ॥",
      "s": 8
    },
    {
      "t": "ਰਾਮਾਨੰਦ ਬੈਰਾਗਿਨ ਜਾਨਾ ॥",
      "s": 8
    },
    {
      "t": "ਮਹਾਦੀਨ ਤੁਰਕਨ ਪਹਚਾਨਾ ॥੧੪੦॥",
      "s": 8
    },
    {
      "t": "ਦੇਵਨ ਇੰਦ੍ਰ ਰੂਪ ਕਰਿ ਲੇਖਾ ॥",
      "s": 8
    },
    {
      "t": "ਦੈਤਨ ਸੁੰਭ ਰਾਜਾ ਕਰਿ ਪੇਖਾ ॥",
      "s": 8
    },
    {
      "t": "ਜਛਨ ਜਛ ਰਾਜ ਕਰਿ ਮਾਨਾ ॥",
      "s": 8
    },
    {
      "t": "ਕਿਨ੍ਰਨ ਕਿਨ੍ਰਦੇਵ ਪਹਚਾਨਾ ॥੧੪੧॥",
      "s": 8
    },
    {
      "t": "ਕਾਮਿਨ ਕਾਮ ਰੂਪ ਕਰਿ ਦੇਖ੍ਯੋ ॥",
      "s": 8
    },
    {
      "t": "ਰੋਗਨ ਰੂਪ ਧਨੰਤਰ ਪੇਖ੍ਯੋ ॥",
      "s": 8
    },
    {
      "t": "ਰਾਜਨ ਲਖ੍ਯੋ ਰਾਜ ਅਧਿਕਾਰੀ ॥",
      "s": 8
    },
    {
      "t": "ਜੋਗਨ ਲਖ੍ਯੋ ਜੋਗੀਸਰ ਭਾਰੀ ॥੧੪੨॥",
      "s": 8
    },
    {
      "t": "ਛਤ੍ਰਨ ਬਡੋ ਛਤ੍ਰਪਤਿ ਜਾਨਾ ॥",
      "s": 8
    },
    {
      "t": "ਅਤ੍ਰਿਨ ਮਹਾ ਸਸਤ੍ਰਧਰ ਮਾਨਾ ॥",
      "s": 8
    },
    {
      "t": "ਰਜਨੀ ਤਾਸੁ ਚੰਦ੍ਰ ਕਰਿ ਲੇਖਾ ॥",
      "s": 8
    },
    {
      "t": "ਦਿਨੀਅਰ ਕਰਿ ਤਿਹ ਦਿਨ ਅਵਿਰੇਖਾ ॥੧੪੩॥",
      "s": 8
    },
    {
      "t": "ਸੰਤਨ ਸਾਤਿ ਰੂਪ ਕਰਿ ਜਾਨ੍ਯੋ ॥",
      "s": 8
    },
    {
      "t": "ਪਾਵਕ ਤੇਜ ਰੂਪ ਅਨੁਮਾਨ੍ਰਯੋ ॥",
      "s": 8
    },
    {
      "t": "ਧਰਤੀ ਤਾਸੁ ਧਰਾਧਰ ਜਾਨਾ ॥",
      "s": 8
    },
    {
      "t": "ਹਰਣਿ ਏਣਰਾਜ ਪਹਿਚਾਨਾ ॥੧੪੪॥",
      "s": 8
    }
  ]
}
