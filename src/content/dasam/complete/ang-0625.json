{
  "page": 625,
  "lines": [
    {
      "t": "ਛਤ੍ਰਿਨ ਤਾ ਸਬੁ ਛਤ੍ਰਿਪਤਿ ਸੂਝਾ ॥",
      "s": 8
    },
    {
      "t": "ਜੋਗਿਨ ਮਹਾ ਜੋਗ ਕਰ ਬੂਝਾ ॥",
      "s": 8
    },
    {
      "t": "ਹਿਮਧਰ ਤਾਹਿ ਹਿਮਾਲਯ ਜਾਨਾ ॥",
      "s": 8
    },
    {
      "t": "ਦਿਨਕਰ ਅੰਧਕਾਰਿ ਅਨੁਮਾਨਾ ॥੧੪੫॥",
      "s": 8
    },
    {
      "t": "ਜਲ ਸਰੂਪ ਜਲ ਤਾਸੁ ਪਛਾਨਾ ॥",
      "s": 8
    },
    {
      "t": "ਮੇਘਨ ਇੰਦ੍ਰਦੇਵ ਕਰ ਮਾਨਾ ॥",
      "s": 8
    },
    {
      "t": "ਬੇਦਨ ਬ੍ਰਹਮ ਰੂਪ ਕਰ ਦੇਖਾ ॥",
      "s": 8
    },
    {
      "t": "ਬਿਪਨ ਬ੍ਯਾਸ ਜਾਨਿ ਅਵਿਰੇਖਾ ॥੧੪੬॥",
      "s": 8
    },
    {
      "t": "ਲਖਮੀ ਤਾਹਿ ਬਿਸਨੁ ਕਰਿ ਮਾਨ੍ਯੋ ॥",
      "s": 8
    },
    {
      "t": "ਬਾਸਵ ਦੇਵ ਬਾਸਵੀ ਜਾਨ੍ਯੋ ॥",
      "s": 8
    },
    {
      "t": "ਸੰਤਨ ਸਾਤਿ ਰੂਪ ਕਰਿ ਦੇਖਾ ॥",
      "s": 8
    },
    {
      "t": "ਸਤ੍ਰਨ ਕਲਹ ਸਰੂਪ ਬਿਸੇਖਾ ॥੧੪੭॥",
      "s": 8
    },
    {
      "t": "ਰੋਗਨ ਤਾਹਿ ਅਉਖਧੀ ਸੂਝਾ ॥",
      "s": 8
    },
    {
      "t": "ਭਾਮਿਨ ਭੋਗ ਰੂਪ ਕਰਿ ਬੂਝਾ ॥",
      "s": 8
    },
    {
      "t": "ਮਿਤ੍ਰਨ ਮਹਾ ਮਿਤ੍ਰ ਕਰਿ ਜਾਨਾ ॥",
      "s": 8
    },
    {
      "t": "ਜੋਗਿਨ ਪਰਮ ਤਤੁ ਪਹਚਾਨਾ ॥੧੪੮॥",
      "s": 8
    },
    {
      "t": "ਮੋਰਨ ਮਹਾ ਮੇਘ ਕਰਿ ਮਾਨਿਆ ॥",
      "s": 8
    },
    {
      "t": "ਦਿਨਕਰ ਚਿਤ ਚਕਵੀ ਜਾਨਿਆ ॥",
      "s": 8
    },
    {
      "t": "ਚੰਦ ਸਰੂਪ ਚਕੋਰਨ ਸੂਝਾ ॥",
      "s": 8
    },
    {
      "t": "ਸ੍ਵਾਤਿ ਬੂੰਦ ਸੀਪਨ ਕਰਿ ਬੂਝਾ ॥੧੪੯॥",
      "s": 8
    },
    {
      "t": "ਮਾਸ ਬਸੰਤ ਕੋਕਿਲਾ ਜਾਨਾ ॥",
      "s": 8
    },
    {
      "t": "ਸ੍ਵਾਤਿ ਬੂੰਦ ਚਾਤ੍ਰਕ ਅਨੁਮਾਨਾ ॥",
      "s": 8
    },
    {
      "t": "ਸਾਧਨ ਸਿਧਿ ਰੂਪ ਕਰਿ ਦੇਖਾ ॥",
      "s": 8
    },
    {
      "t": "ਰਾਜਨ ਮਹਾਰਾਜ ਅਵਿਰੇਖਾ ॥੧੫੦॥",
      "s": 8
    },
    {
      "t": "ਦਾਨ ਸਰੂਪ ਭਿਛਕਨ ਜਾਨਾ ॥",
      "s": 8
    },
    {
      "t": "ਕਾਲ ਸਰੂਪ ਸਤ੍ਰੁ ਅਨੁਮਾਨਾ ॥",
      "s": 8
    },
    {
      "t": "ਸਾਸਤ੍ਰ ਸਰੂਪ ਸਿਮ੍ਰਿਤਨ ਦੇਖਾ ॥",
      "s": 8
    },
    {
      "t": "ਸਤਿ ਸਰੂਪ ਸਾਧ ਅਵਿਰੇਖਾ ॥੧੫੧॥",
      "s": 8
    },
    {
      "t": "ਸੀਲ ਰੂਪ ਸਾਧਵਿਨ ਚੀਨਾ ॥",
      "s": 8
    },
    {
      "t": "ਦਿਆਲ ਸਰੂਪ ਦਇਆ ਚਿਤਿ ਕੀਨਾ ॥",
      "s": 8
    },
    {
      "t": "ਮੋਰਨ ਮੇਘ ਰੂਪ ਪਹਿਚਾਨਾ ॥",
      "s": 8
    },
    {
      "t": "ਚੋਰਨ ਤਾਹਿ ਭੋਰ ਕਰਿ ਜਾਨਾ ॥੧੫੨॥",
      "s": 8
    },
    {
      "t": "ਕਾਮਿਨ ਕੇਲ ਰੂਪ ਕਰਿ ਸੂਝਾ ॥",
      "s": 8
    },
    {
      "t": "ਸਾਧਨ ਸਿਧਿ ਰੂਪ ਤਿਹ ਬੂਝਾ ॥",
      "s": 8
    },
    {
      "t": "ਫਣਪਤੇਸ ਫਣੀਅਰ ਕਰਿ ਜਾਨ੍ਯੋ ॥",
      "s": 8
    },
    {
      "t": "ਅੰਮ੍ਰਿਤ ਰੂਪ ਦੇਵਤਨ ਮਾਨ੍ਯੋ ॥੧੫੩॥",
      "s": 8
    },
    {
      "t": "ਮਣਿ ਸਮਾਨ ਫਣੀਅਰ ਕਰਿ ਸੂਝਾ ॥",
      "s": 8
    },
    {
      "t": "ਪ੍ਰਾਣਿਨ ਪ੍ਰਾਨ ਰੂਪ ਕਰਿ ਬੂਝਾ ॥",
      "s": 8
    },
    {
      "t": "ਰਘੁ ਬੰਸੀਅਨ ਰਘੁਰਾਜ ਪ੍ਰਮਾਨ੍ਰਯੋ ॥",
      "s": 8
    },
    {
      "t": "ਕੇਵਲ ਕ੍ਰਿਸਨ ਜਾਦਵਨ ਜਾਨ੍ਯੋ ॥੧੫੪॥",
      "s": 8
    },
    {
      "t": "ਬਿਪਤਿ ਹਰਨ ਬਿਪਤਹਿ ਕਰਿ ਜਾਨਾ ॥",
      "s": 8
    },
    {
      "t": "ਬਲਿ ਮਹੀਪ ਬਾਵਨ ਪਹਚਾਨਾ ॥",
      "s": 8
    },
    {
      "t": "ਸਿਵ ਸਰੂਪ ਸਿਵ ਸੰਤਨ ਪੇਖਾ ॥",
      "s": 8
    },
    {
      "t": "ਬ੍ਯਾਸ ਪਰਾਸੁਰ ਤੁਲ ਬਸੇਖਾ ॥੧੫੫॥",
      "s": 8
    },
    {
      "t": "ਬਿਪ੍ਰਨ ਬੇਦ ਸਰੂਪ ਬਖਾਨਾ ॥",
      "s": 8
    },
    {
      "t": "ਛਤ੍ਰਿ ਜੁਧ ਰੂਪ ਕਰਿ ਜਾਨਾ ॥",
      "s": 8
    },
    {
      "t": "ਜਉਨ ਜਉਨ ਜਿਹ ਭਾਤਿ ਬਿਚਾਰਾ ॥",
      "s": 8
    },
    {
      "t": "ਤਉਨੈ ਕਾਛਿ ਕਾਛਿ ਅਨੁਹਾਰਾ ॥੧੫੬॥",
      "s": 8
    }
  ]
}
