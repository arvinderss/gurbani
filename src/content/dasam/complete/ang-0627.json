{
  "page": 627,
  "lines": [
    {
      "t": "ਇਹ ਬਿਧਿ ਰਾਜੁ ਕਰ੍ਯੋ ਰਘੁ ਰਾਜਾ ॥",
      "s": 8
    },
    {
      "t": "ਦਾਨ ਨਿਸਾਨ ਚਹੂੰ ਦਿਸ ਬਾਜਾ ॥",
      "s": 8
    },
    {
      "t": "ਚਾਰੋ ਦਿਸਾ ਬੈਠ ਰਖਵਾਰੇ ॥",
      "s": 8
    },
    {
      "t": "ਮਹਾਬੀਰ ਅਰੁ ਰੂਪ ਉਜਿਆਰੇ ॥੧੭੫॥",
      "s": 8
    },
    {
      "t": "ਬੀਸ ਸਹੰਸ੍ਰ ਬਰਖ ਪਰਮਾਨਾ ॥",
      "s": 8
    },
    {
      "t": "ਰਾਜੁ ਕਰਾ ਦਸ ਚਾਰ ਨਿਧਾਨਾ ॥",
      "s": 8
    },
    {
      "t": "ਭਾਤਿ ਅਨੇਕ ਕਰੇ ਨਿਤਿ ਧਰਮਾ ॥",
      "s": 8
    },
    {
      "t": "ਔਰ ਨ ਸਕੈ ਐਸ ਕਰ ਕਰਮਾ ॥੧੭੬॥",
      "s": 8
    },
    {
      "t": "ਪਾਧੜੀ ਛੰਦ ॥",
      "s": 8
    },
    {
      "t": "ਇਹੁ ਭਾਤਿ ਰਾਜੁ ਰਘੁਰਾਜ ਕੀਨ ॥",
      "s": 8
    },
    {
      "t": "ਗਜ ਬਾਜ ਸਾਜ ਦੀਨਾਨ ਦੀਨ ॥",
      "s": 8
    },
    {
      "t": "ਨ੍ਰਿਪ ਜੀਤਿ ਜੀਤਿ ਲਿਨੇ ਅਪਾਰ ॥",
      "s": 8
    },
    {
      "t": "ਕਰਿ ਖੰਡ ਖੰਡ ਖੰਡੇ ਗੜਵਾਰ ॥੧੭੭॥",
      "s": 8
    },
    {
      "t": "ਇਤਿ ਰਘੁ ਰਾਜ ਸਮਾਪਤਹਿ ॥੯॥੫॥",
      "s": 8
    },
    {
      "t": "ਅਥ ਅਜ ਰਾਜਾ ਕੋ ਰਾਜ ਕਥਨੰ ॥",
      "s": 8
    },
    {
      "t": "ਪਾਧੜੀ ਛੰਦ ॥",
      "s": 8
    },
    {
      "t": "ਫੁਨਿ ਭਏ ਰਾਜ ਅਜਰਾਜ ਬੀਰ ॥",
      "s": 8
    },
    {
      "t": "ਜਿਨਿ ਭਾਤਿ ਭਾਤਿ ਜਿਤੇ ਪ੍ਰਬੀਰ ॥",
      "s": 8
    },
    {
      "t": "ਕਿਨੇ ਖਰਾਬ ਖਾਨੇ ਖਵਾਸ ॥",
      "s": 8
    },
    {
      "t": "ਜਿਤੇ ਮਹੀਪ ਤੋਰੇ ਮਵਾਸ ॥੧॥",
      "s": 8
    },
    {
      "t": "ਜਿਤੇ ਅਜੀਤ ਮੁੰਡੇ ਅਮੁੰਡ ॥",
      "s": 8
    },
    {
      "t": "ਖੰਡੇ ਅਖੰਡ ਕਿਨੇ ਘਮੰਡ ॥",
      "s": 8
    },
    {
      "t": "ਦਸ ਚਾਰਿ ਚਾਰਿ ਬਿਦਿਆ ਨਿਧਾਨ ॥",
      "s": 8
    },
    {
      "t": "ਅਜਰਾਜ ਰਾਜ ਰਾਜਾ ਮਹਾਨ ॥੨॥",
      "s": 8
    },
    {
      "t": "ਸੂਰਾ ਸੁਬਾਹ ਜੋਧਾ ਪ੍ਰਚੰਡ ॥",
      "s": 8
    },
    {
      "t": "ਸ੍ਰੁਤਿ ਸਰਬ ਸਾਸਤ੍ਰ ਬਿਦਿਆ ਉਦੰਡ ॥",
      "s": 8
    },
    {
      "t": "ਮਾਨੀ ਮਹਾਨ ਸੁੰਦਰ ਸਰੂਪ ॥",
      "s": 8
    },
    {
      "t": "ਅਵਿਲੋਕਿ ਜਾਸੁ ਲਾਜੰਤ ਭੂਪ ॥੩॥",
      "s": 8
    },
    {
      "t": "ਰਾਜਾਨ ਰਾਜ ਰਾਜਾਧਿਰਾਜ ॥",
      "s": 8
    },
    {
      "t": "ਗ੍ਰਿਹ ਭਰੇ ਸਰਬ ਸੰਪਤਿ ਸਮਾਜ ॥",
      "s": 8
    },
    {
      "t": "ਅਵਿਲੋਕ ਰੂਪ ਰੀਝੰਤ ਨਾਰਿ ॥",
      "s": 8
    },
    {
      "t": "ਸ੍ਰੁਤਿ ਦਾਨ ਸੀਲ ਬਿਦਿਆ ਉਦਾਰ ॥੪॥",
      "s": 8
    },
    {
      "t": "ਜੌ ਕਹੋ ਕਥਾ ਬਾਢੰਤ ਗ੍ਰੰਥ ॥",
      "s": 8
    },
    {
      "t": "ਸੁਣਿ ਲੇਹੁ ਮਿਤ੍ਰ ਸੰਛੇਪ ਕੰਥ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 8
    },
    {
      "t": "ਬੈਦਰਭ ਦੇਸਿ ਰਾਜਾ ਸੁਬਾਹ ॥",
      "s": 8
    },
    {
      "t": "ਚੰਪਾਵਤੀ ਸੁ ਗ੍ਰਿਹ ਨਾਰਿ ਤਾਹਿ ॥੫॥",
      "s": 8
    },
    {
      "t": "ਤਿਹ ਜਈ ਏਕ ਕੰਨਿਆ ਅਪਾਰ ॥",
      "s": 8
    },
    {
      "t": "ਤਿਹ ਮਤੀਇੰਦ੍ਰ ਨਾਮਾ ਉਦਾਰ ॥",
      "s": 8
    },
    {
      "t": "ਜਬ ਭਈ ਜੋਗ ਬਰ ਕੇ ਕੁਮਾਰਿ ॥",
      "s": 8
    },
    {
      "t": "ਤਬ ਕੀਨ ਬੈਠਿ ਰਾਜਾ ਬਿਚਾਰਿ ॥੬॥",
      "s": 8
    },
    {
      "t": "ਲਿਨੇ ਬੁਲਾਇ ਨ੍ਰਿਪ ਸਰਬ ਦੇਸ ॥",
      "s": 8
    },
    {
      "t": "ਧਾਏ ਸੁਬਾਹ ਲੈ ਦਲ ਅਸੇਸ ॥",
      "s": 8
    },
    {
      "t": "ਮੁਖ ਭਈ ਆਨਿ ਸਰਸ੍ਵਤੀ ਆਪੁ ॥",
      "s": 8
    },
    {
      "t": "ਜਿਹਿ ਜਪਤ ਲੋਗ ਮਿਲਿ ਸਰਬ ਜਾਪੁ ॥੭॥",
      "s": 8
    },
    {
      "t": "ਤਬ ਦੇਸ ਦੇਸ ਕੇ ਭੂਪ ਆਨਿ ॥",
      "s": 8
    },
    {
      "t": "ਕਿਨੋ ਪ੍ਰਣਾਮ ਰਾਜਾ ਮਹਾਨਿ ॥",
      "s": 8
    },
    {
      "t": "ਤਹ ਬੈਠਿ ਰਾਜ ਸੋਭੰਤ ਐਸੁ ॥",
      "s": 8
    },
    {
      "t": "ਜਨ ਦੇਵ ਮੰਡਲੀ ਸਮ ਨ ਤੈਸੁ ॥੮॥",
      "s": 8
    }
  ]
}
