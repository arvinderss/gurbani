{
  "page": 635,
  "lines": [
    {
      "t": "ਦਸ ਅਸਟ ਸਾਸਤ੍ਰ ਪ੍ਰਮਾਨ ॥",
      "s": 8
    },
    {
      "t": "ਕਲਿ ਜੁਗਿਯ ਲਾਗ ਨਿਹਾਰਿ ॥",
      "s": 8
    },
    {
      "t": "ਭਏ ਕਾਲਿਦਾਸ ਅਬਿਚਾਰ ॥੧॥",
      "s": 8
    },
    {
      "t": "ਲਖਿ ਰੀਝ ਬਿਕ੍ਰਮਜੀਤ ॥",
      "s": 8
    },
    {
      "t": "ਅਤਿ ਗਰਬਵੰਤ ਅਜੀਤ ॥",
      "s": 8
    },
    {
      "t": "ਅਤਿ ਗਿਆਨ ਮਾਨ ਗੁਨੈਨ ॥",
      "s": 8
    },
    {
      "t": "ਸੁਭ ਕ੍ਰਾਤਿ ਸੁੰਦਰ ਨੈਨ ॥੨॥",
      "s": 8
    },
    {
      "t": "ਰਘੁ ਕਾਬਿ ਕੀਨ ਸੁਧਾਰਿ ॥",
      "s": 8
    },
    {
      "t": "ਕਰਿ ਕਾਲਿਦਾਸ ਵਤਾਰ ॥",
      "s": 8
    },
    {
      "t": "ਕਹ ਲੌ ਬਖਾਨੋ ਤਉਨ ॥",
      "s": 8
    },
    {
      "t": "ਜੋ ਕਾਬਿ ਕੀਨੋ ਜਉਨ ॥੩॥",
      "s": 8
    },
    {
      "t": "ਧਰਿ ਸਪਤ ਬ੍ਰਹਮ ਵਤਾਰ ॥",
      "s": 8
    },
    {
      "t": "ਤਬ ਭਇਓ ਤਾਸੁ ਉਧਾਰ ॥",
      "s": 8
    },
    {
      "t": "ਤਬ ਧਰਾ ਬ੍ਰਹਮ ਸਰੂਪ ॥",
      "s": 8
    },
    {
      "t": "ਮੁਖਚਾਰ ਰੂਪ ਅਨੂਪ ॥੪॥",
      "s": 8
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਸਪਤਮੋ ਅਵਤਾਰ ਬ੍ਰਹਮਾ ਕਾਲਿਦਾਸ ਸਮਾਪਤਮ ॥੭॥",
      "s": 8
    },
    {
      "t": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "s": 9
    },
    {
      "t": "ਸ੍ਰੀ ਭਗਉਤੀ ਜੀ ਸਹਾਇ ॥",
      "s": 9
    },
    {
      "t": "ਅਥ ਰੁਦ੍ਰ ਅਵਤਾਰ ਕਥਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਤੋਮਰ ਛੰਦ ॥",
      "s": 9
    },
    {
      "t": "ਅਬ ਕਹੋ ਤਉਨ ਸੁਧਾਰਿ ॥",
      "s": 9
    },
    {
      "t": "ਜੇ ਧਰੇ ਰੁਦ੍ਰ ਅਵਤਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਅਤਿ ਜੋਗ ਸਾਧਨ ਕੀਨ ॥",
      "s": 9
    },
    {
      "t": "ਤਬ ਗਰਬ ਕੇ ਰਸਿ ਭੀਨ ॥੧॥",
      "s": 9
    },
    {
      "t": "ਸਰਿ ਆਪ ਜਾਨ ਨ ਅਉਰ ॥",
      "s": 9
    },
    {
      "t": "ਸਬ ਦੇਸ ਮੋ ਸਬ ਠੌਰ ॥",
      "s": 9
    },
    {
      "t": "ਤਬ ਕੋਪਿ ਕੈ ਇਮ ਕਾਲ ॥",
      "s": 9
    },
    {
      "t": "ਇਮ ਭਾਖਿ ਬੈਣ ਉਤਾਲ ॥੨॥",
      "s": 9
    },
    {
      "t": "ਜੇ ਗਰਬ ਲੋਕ ਕਰੰਤ ॥",
      "s": 9
    },
    {
      "t": "ਤੇ ਜਾਨ ਕੂਪ ਪਰੰਤ ॥",
      "s": 9
    },
    {
      "t": "ਮੁਰ ਨਾਮ ਗਰਬ ਪ੍ਰਹਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਸੁਨ ਲੇਹੁ ਰੁਦ੍ਰ ਬਿਚਾਰ ॥੩॥",
      "s": 9
    },
    {
      "t": "ਕੀਅ ਗਰਬ ਕੋ ਮੁਖ ਚਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਕਛੁ ਚਿਤ ਮੋ ਅਬਿਚਾਰਿ ॥",
      "s": 9
    },
    {
      "t": "ਜਬ ਧਰੇ ਤਿਨ ਤਨ ਸਾਤ ॥",
      "s": 9
    },
    {
      "t": "ਤਬ ਬਨੀ ਤਾ ਕੀ ਬਾਤ ॥੪॥",
      "s": 9
    },
    {
      "t": "ਤਿਮ ਜਨਮੁ ਧਰੁ ਤੈ ਜਾਇ ॥",
      "s": 9
    },
    {
      "t": "ਚਿਤ ਦੇ ਸੁਨੋ ਮੁਨਿ ਰਾਇ ॥",
      "s": 9
    },
    {
      "t": "ਨਹੀ ਐਸ ਹੋਇ ਉਧਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਸੁਨ ਲੇਹੁ ਰੁਦ੍ਰ ਬਿਚਾਰ ॥੫॥",
      "s": 9
    },
    {
      "t": "ਸੁਨਿ ਸ੍ਰਵਨ ਏ ਸਿਵ ਬੈਨ ॥",
      "s": 9
    },
    {
      "t": "ਹਠ ਛਾਡਿ ਸੁੰਦਰ ਨੈਨ ॥",
      "s": 9
    },
    {
      "t": "ਤਿਹ ਜਾਨਿ ਗਰਬ ਪ੍ਰਹਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਛਿਤਿ ਲੀਨ ਆਨਿ ਵਤਾਰ ॥੬॥",
      "s": 9
    },
    {
      "t": "ਪਾਧਰੀ ਛੰਦ ॥",
      "s": 9
    },
    {
      "t": "ਜਿਮ ਕਥੇ ਸਰਬ ਰਾਜਾਨ ਰਾਜ ॥",
      "s": 9
    },
    {
      "t": "ਤਿਮ ਕਹੇ ਰਿਖਿਨ ਸਬ ਹੀ ਸਮਾਜ ॥",
      "s": 9
    },
    {
      "t": "ਜਿਹ ਜਿਹ ਪ੍ਰਕਾਰ ਤਿਹ ਕਰਮ ਕੀਨ ॥",
      "s": 9
    },
    {
      "t": "ਜਿਹ ਭਾਤਿ ਜੇਮਿ ਦਿਜ ਬਰਨ ਲੀਨ ॥੭॥",
      "s": 9
    },
    {
      "t": "ਜੇ ਜੇ ਚਰਿਤ੍ਰ ਕਿਨੇ ਪ੍ਰਕਾਸ ॥",
      "s": 9
    },
    {
      "t": "ਤੇ ਤੇ ਚਰਿਤ੍ਰ ਭਾਖੋ ਸੁ ਬਾਸ ॥",
      "s": 9
    },
    {
      "t": "ਰਿਖਿ ਪੁਤ੍ਰ ਏਸ ਭਏ ਰੁਦ੍ਰ ਦੇਵ ॥",
      "s": 9
    },
    {
      "t": "ਮੋਨੀ ਮਹਾਨ ਮਾਨੀ ਅਭੇਵ ॥੮॥",
      "s": 9
    },
    {
      "t": "ਪੁਨਿ ਭਏ ਅਤ੍ਰਿ ਰਿਖਿ ਮੁਨਿ ਮਹਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਦਸ ਚਾਰ ਚਾਰ ਬਿਦਿਆ ਨਿਧਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਲਿਨੇ ਸੁ ਜੋਗ ਤਜਿ ਰਾਜ ਆਨਿ ॥",
      "s": 9
    },
    {
      "t": "ਸੇਵਿਆ ਰੁਦ੍ਰ ਸੰਪਤਿ ਨਿਧਾਨ ॥੯॥",
      "s": 9
    },
    {
      "t": "ਕਿਨੋ ਸੁ ਯੋਗ ਬਹੁ ਦਿਨ ਪ੍ਰਮਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਰੀਝਿਓ ਰੁਦ੍ਰ ਤਾ ਪਰ ਨਿਦਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਬਰੁ ਮਾਗ ਪੁਤ੍ਰ ਜੋ ਰੁਚੈ ਤੋਹਿ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 9
    },
    {
      "t": "ਬਰੁ ਦਾਨੁ ਤਉਨ ਮੈ ਦੇਉ ਤੋਹਿ ॥੧੦॥",
      "s": 9
    },
    {
      "t": "ਕਰਿ ਜੋਰਿ ਅਤ੍ਰਿ ਤਬ ਭਯੋ ਠਾਢ ॥",
      "s": 9
    },
    {
      "t": "ਉਠਿ ਭਾਗ ਆਨ ਅਨੁਰਾਗ ਬਾਢ ॥",
      "s": 9
    },
    {
      "t": "ਗਦ ਗਦ ਸੁ ਬੈਣ ਭਭਕੰਤ ਨੈਣ ॥",
      "s": 9
    },
    {
      "t": "ਰੋਮਾਨ ਹਰਖ ਉਚਰੇ ਸੁ ਬੈਣ ॥੧੧॥",
      "s": 9
    },
    {
      "t": "ਜੋ ਦੇਤ ਰੁਦ੍ਰ ਬਰੁ ਰੀਝ ਮੋਹਿ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 9
    },
    {
      "t": "ਗ੍ਰਿਹ ਹੋਇ ਪੁਤ੍ਰ ਸਮ ਤੁਲਿ ਤੋਹਿ ॥",
      "s": 9
    },
    {
      "t": "ਕਹਿ ਕੈ ਤਥਾਸਤੁ ਭਏ ਅੰਤ੍ਰ ਧਿਆਨ ॥",
      "s": 9
    },
    {
      "t": "ਗ੍ਰਿਹ ਗਯੋ ਅਤ੍ਰਿ ਮੁਨਿ ਮਨਿ ਮਹਾਨ ॥੧੨॥",
      "s": 9
    },
    {
      "t": "ਗ੍ਰਿਹਿ ਬਰੀ ਆਨਿ ਅਨਸੂਆ ਨਾਰਿ ॥",
      "s": 9
    },
    {
      "t": "ਜਨੁ ਪਠਿਓ ਤਤੁ ਨਿਜ ਸਿਵ ਨਿਕਾਰਿ ॥",
      "s": 9
    }
  ]
}
