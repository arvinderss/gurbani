{
  "page": 636,
  "lines": [
    {
      "t": "ਬ੍ਰਹਮਾ ਰੁ ਬਿਸਨ ਨਿਜ ਤੇਜ ਕਾਢਿ ॥",
      "s": 9
    },
    {
      "t": "ਆਏ ਸੁ ਮਧਿ ਅਨਿਸੂਆ ਛਾਡਿ ॥੧੩॥",
      "s": 9
    },
    {
      "t": "ਭਈ ਕਰਤ ਜੋਗ ਬਹੁ ਦਿਨ ਪ੍ਰਮਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਅਨਸੂਆ ਨਾਮ ਗੁਨ ਗਨ ਮਹਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਅਤਿ ਤੇਜਵੰਤ ਸੋਭਾ ਸੁਰੰਗ ॥",
      "s": 9
    },
    {
      "t": "ਜਨੁ ਧਰਾ ਰੂਪ ਦੂਸਰ ਅਨੰਗ ॥੧੪॥",
      "s": 9
    },
    {
      "t": "ਸੋਭਾ ਅਪਾਰ ਸੁੰਦਰ ਅਨੰਤ ॥",
      "s": 9
    },
    {
      "t": "ਸਊਹਾਗ ਭਾਗ ਬਹੁ ਬਿਧਿ ਲਸੰਤ ॥",
      "s": 9
    },
    {
      "t": "ਜਿਹ ਨਿਰਖਿ ਰੂਪ ਸੋਰਹਿ ਲੁਭਾਇ ॥",
      "s": 9
    },
    {
      "t": "ਆਭਾ ਅਪਾਰ ਬਰਨੀ ਨ ਜਾਇ ॥੧੫॥",
      "s": 9
    },
    {
      "t": "ਨਿਸ ਨਾਥ ਦੇਖਿ ਆਨਨ ਰਿਸਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਜਲਿ ਜਾਇ ਨੈਨ ਲਹਿ ਰੋਸ ਮਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਤਮ ਨਿਰਖਿ ਕੇਸ ਕੀਅ ਨੀਚ ਡੀਠ ॥",
      "s": 9
    },
    {
      "t": "ਛਪਿ ਰਹਾ ਜਾਨੁ ਗਿਰ ਹੇਮ ਪੀਠ ॥੧੬॥",
      "s": 9
    },
    {
      "t": "ਕੰਠਹਿ ਕਪੋਤਿ ਲਖਿ ਕੋਪ ਕੀਨ ॥",
      "s": 9
    },
    {
      "t": "ਨਾਸਾ ਨਿਹਾਰਿ ਬਨਿ ਕੀਰ ਲੀਨ ॥",
      "s": 9
    },
    {
      "t": "ਰੋਮਾਵਲਿ ਹੇਰਿ ਜਮੁਨਾ ਰਿਸਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਲਜਾ ਮਰੰਤ ਸਾਗਰ ਡੁਬਾਨ ॥੧੭॥",
      "s": 9
    },
    {
      "t": "ਬਾਹੂ ਬਿਲੋਕਿ ਲਾਜੈ ਮ੍ਰਿਨਾਲ ॥",
      "s": 9
    },
    {
      "t": "ਖਿਸਿਯਾਨ ਹੰਸ ਅਵਿਲੋਕਿ ਚਾਲ ॥",
      "s": 9
    },
    {
      "t": "ਜੰਘਾ ਬਿਲੋਕਿ ਕਦਲੀ ਲਜਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਨਿਸ ਰਾਟ ਆਪ ਘਟਿ ਰੂਪ ਮਾਨ ॥੧੮॥",
      "s": 9
    },
    {
      "t": "ਇਹ ਭਾਤਿ ਤਾਸੁ ਬਰਣੋ ਸਿੰਗਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਕੋ ਸਕੈ ਕਬਿ ਮਹਿਮਾ ਉਚਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਐਸੀ ਸਰੂਪ ਅਵਿਲੋਕ ਅਤ੍ਰਿ ॥",
      "s": 9
    },
    {
      "t": "ਜਨੁ ਲੀਨ ਰੂਪ ਕੋ ਛੀਨ ਛਤ੍ਰ ॥੧੯॥",
      "s": 9
    },
    {
      "t": "ਕੀਨੀ ਪ੍ਰਤਗਿ ਤਿਹ ਸਮੇ ਨਾਰਿ ॥",
      "s": 9
    },
    {
      "t": "ਬ੍ਰਯਾਹੈ ਨ ਭੋਗ ਭੋਗੈ ਭਤਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਮੈ ਬਰੌ ਤਾਸੁ ਰੁਚਿ ਮਾਨਿ ਚਿਤ ॥",
      "s": 9
    },
    {
      "t": "ਜੋ ਸਹੈ ਕਸਟ ਐਸੇ ਪਵਿਤ ॥੨੦॥",
      "s": 9
    },
    {
      "t": "ਰਿਖਿ ਮਾਨਿ ਬੈਨ ਤਬ ਬਰ੍ਰਯੋ ਵਾਹਿ ॥",
      "s": 9
    },
    {
      "t": "ਜਨੁ ਲੀਨ ਲੂਟ ਸੀਗਾਰ ਤਾਹਿ ॥",
      "s": 9
    },
    {
      "t": "ਲੈ ਗਯੋ ਧਾਮਿ ਕਰਿ ਨਾਰਿ ਤਉਨ ॥",
      "s": 9
    },
    {
      "t": "ਪਿਤ ਦਤ ਦੇਵ ਮੁਨਿ ਅਤ੍ਰਿ ਜਉਨ ॥੨੧॥",
      "s": 9
    },
    {
      "t": "ਅਥ ਰੁਦ੍ਰ ਵਤਾਰ ਦਤ ਕਥਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਤੋਮਰ ਛੰਦ ॥",
      "s": 9
    },
    {
      "t": "ਬਹੁ ਬਰਖ ਬੀਤ ਕਿਨੋ ਬਿਵਾਹਿ ॥",
      "s": 9
    },
    {
      "t": "ਇਕ ਭਯੋ ਆਨਿ ਅਉਰੈ ਉਛਾਹਿ ॥",
      "s": 9
    },
    {
      "t": "ਤਿਹ ਗਏ ਧਾਮਿ ਬ੍ਰਹਮਾਦਿ ਆਦਿ ॥",
      "s": 9
    },
    {
      "t": "ਕਿਨੀ ਸੁ ਸੇਵ ਤ੍ਰੀਯ ਬਹੁ ਪ੍ਰਸਾਦਿ ॥੨੨॥",
      "s": 9
    },
    {
      "t": "ਬਹੁ ਧੂਪ ਦੀਪ ਅਰੁ ਅਰਘ ਦਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਪਾਦਰਘਿ ਆਦਿ ਕਿਨੇ ਸੁਜਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਅਵਿਲੋਕਿ ਭਗਤਿ ਤਿਹ ਚਤੁਰ ਬਾਕ ॥",
      "s": 9
    },
    {
      "t": "ਇੰਦ੍ਰਾਦਿ ਬਿਸਨੁ ਬੈਠੇ ਪਿਨਾਕ ॥੨੩॥",
      "s": 9
    },
    {
      "t": "ਅਵਿਲੋਕਿ ਭਗਤਿ ਭਏ ਰਿਖ ਪ੍ਰਸੰਨ ॥",
      "s": 9
    },
    {
      "t": "ਜੋ ਤਿਹੂ ਮਧਿ ਲੋਕਾਨਿ ਧਨਿ ॥",
      "s": 9
    },
    {
      "t": "ਕਿਨੋ ਸੁ ਐਸ ਬ੍ਰਹਮਾ ਉਚਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਤੈ ਪੁਤ੍ਰਵੰਤ ਹੂਜੋ ਕੁਮਾਰਿ ॥੨੪॥",
      "s": 9
    }
  ]
}
