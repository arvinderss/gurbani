{
  "page": 640,
  "lines": [
    {
      "t": "ਅਤਿ ਗਿਆਨਵੰਤ ਕਰਮਨ ਪ੍ਰਬੀਨ ॥",
      "s": 9
    },
    {
      "t": "ਅਨ ਆਸ ਗਾਤ ਹਰਿ ਕੋ ਅਧੀਨ ॥",
      "s": 9
    },
    {
      "t": "ਛਬਿ ਦਿਪਤ ਕੋਟ ਸੂਰਜ ਪ੍ਰਮਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਚਕ ਰਹਾ ਚੰਦ ਲਖਿ ਆਸਮਾਨ ॥੬੦॥",
      "s": 9
    },
    {
      "t": "ਉਪਜਿਯਾ ਆਪ ਇਕ ਜੋਗ ਰੂਪ ॥",
      "s": 9
    },
    {
      "t": "ਪੁਨਿ ਲਗੋ ਜੋਗ ਸਾਧਨ ਅਨੂਪ ॥",
      "s": 9
    },
    {
      "t": "ਗ੍ਰਿਹ ਪ੍ਰਿਥਮ ਛਾਡਿ ਉਠਿ ਚਲਾ ਦਤ ॥",
      "s": 9
    },
    {
      "t": "ਪਰਮੰ ਪਵਿਤ੍ਰ ਨਿਰਮਲੀ ਮਤਿ ॥੬੧॥",
      "s": 9
    },
    {
      "t": "ਜਬ ਕੀਨ ਜੋਗ ਬਹੁ ਦਿਨ ਪ੍ਰਮਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਤਬ ਕਾਲ ਦੇਵ ਰੀਝੇ ਨਿਦਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਇਮਿ ਭਈ ਬਿਓਮ ਬਾਨੀ ਬਨਾਇ ॥",
      "s": 9
    },
    {
      "t": "ਤੁਮ ਸੁਣਹੁ ਬੈਨ ਸੰਨ੍ਯਾਸ ਰਾਇ ॥੬੨॥",
      "s": 9
    },
    {
      "t": "ਆਕਾਸ ਬਾਨੀ ਬਾਚਿ ਦਤ ਪ੍ਰਤਿ ॥",
      "s": 9
    },
    {
      "t": "ਪਾਧੜੀ ਛੰਦ ॥",
      "s": 9
    },
    {
      "t": "ਗੁਰ ਹੀਣ ਮੁਕਤਿ ਨਹੀ ਹੋਤ ਦਤ ॥",
      "s": 9
    },
    {
      "t": "ਤੁਹਿ ਕਹੋ ਬਾਤ ਸੁਨਿ ਬਿਮਲ ਮਤ ॥",
      "s": 9
    },
    {
      "t": "ਗੁਰ ਕਰਹਿ ਪ੍ਰਿਥਮ ਤਬ ਹੋਗਿ ਮੁਕਤਿ ॥",
      "s": 9
    },
    {
      "t": "ਕਹਿ ਦੀਨ ਕਾਲ ਤਿਹ ਜੋਗ ਜੁਗਤ ॥੬੩॥",
      "s": 9
    },
    {
      "t": "ਬਹੁ ਭਾਤਿ ਦਤ ਦੰਡਵਤ ਕੀਨ ॥",
      "s": 9
    },
    {
      "t": "ਆਸਾ ਬਿਰਹਤਿ ਹਰਿ ਕੋ ਅਧੀਨ ॥",
      "s": 9
    },
    {
      "t": "ਬਹੁ ਭਾਤ ਜੋਗ ਸਾਧਨਾ ਸਾਧਿ ॥",
      "s": 9
    },
    {
      "t": "ਆਦਗ ਜੋਗ ਮਹਿਮਾ ਅਗਾਧ ॥੬੪॥",
      "s": 9
    },
    {
      "t": "ਤਬ ਨਮਸਕਾਰ ਕਰਿ ਦਤ ਦੇਵ ॥",
      "s": 9
    },
    {
      "t": "ਉਚਰੰਤ ਪਰਮ ਉਸਤਤਿ ਅਭੇਵ ॥",
      "s": 9
    },
    {
      "t": "ਜੋਗੀਨ ਜੋਗ ਰਾਜਾਨ ਰਾਜ ॥",
      "s": 9
    },
    {
      "t": "ਅਨਭੂਤ ਅੰਗ ਜਹ ਤਹ ਬਿਰਾਜ ॥੬੫॥",
      "s": 9
    },
    {
      "t": "ਜਲ ਥਲ ਬਿਯਾਪ ਜਿਹ ਤੇਜ ਏਕ ॥",
      "s": 9
    },
    {
      "t": "ਗਾਵੰਤ ਜਾਸੁ ਮੁਨਿ ਗਨ ਅਨੇਕ ॥",
      "s": 9
    },
    {
      "t": "ਜਿਹ ਨੇਤਿ ਨੇਤਿ ਭਾਖੰਤ ਨਿਗਮ ॥",
      "s": 9
    },
    {
      "t": "ਤੇ ਆਦਿ ਅੰਤ ਮਧਹ ਅਗਮ ॥੬੬॥",
      "s": 9
    },
    {
      "t": "ਜਿਹ ਏਕ ਰੂਪ ਕਿਨੇ ਅਨੇਕ ॥",
      "s": 9
    },
    {
      "t": "ਪੁਹਮੀ ਅਕਾਸ ਕਿਨੇ ਬਿਬੇਕ ॥",
      "s": 9
    },
    {
      "t": "ਜਲ ਬਾ ਥਲੇਸ ਸਬ ਠੌਰ ਜਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਅਨਭੈ ਅਜੋਨਿ ਅਨਿ ਆਸ ਮਾਨ ॥੬੭॥",
      "s": 9
    },
    {
      "t": "ਪਾਵਨ ਪ੍ਰਸਿਧ ਪਰਮੰ ਪੁਨੀਤ ॥",
      "s": 9
    },
    {
      "t": "ਆਜਾਨ ਬਾਹ ਅਨਭਉ ਅਜੀਤ ॥",
      "s": 9
    },
    {
      "t": "ਪਰਮੰ ਪ੍ਰਸਿਧ ਪੂਰਣ ਪੁਰਾਣ ॥",
      "s": 9
    },
    {
      "t": "ਰਾਜਾਨ ਰਾਜ ਭੋਗੀ ਮਹਾਣ ॥੬੮॥",
      "s": 9
    },
    {
      "t": "ਅਨਛਿਜ ਤੇਜ ਅਨਭੈ ਪ੍ਰਕਾਸ ॥",
      "s": 9
    },
    {
      "t": "ਖੜਗਨ ਸਪੰਨ ਪਰਮੰ ਪ੍ਰਭਾਸ ॥",
      "s": 9
    },
    {
      "t": "ਆਭਾ ਅਨੰਤ ਬਰਨੀ ਨ ਜਾਇ ॥",
      "s": 9
    },
    {
      "t": "ਫਿਰ ਫਿਰੇ ਸਰਬ ਮਤਿ ਕੋ ਚਲਾਇ ॥੬੯॥",
      "s": 9
    },
    {
      "t": "ਸਬਹੂ ਬਖਾਨ ਜਿਹ ਨੇਤਿ ਨੇਤਿ ॥",
      "s": 9
    },
    {
      "t": "ਅਕਲੰਕ ਰੂਪ ਆਭਾ ਅਮੇਤ ॥",
      "s": 9
    },
    {
      "t": "ਸਰਬੰ ਸਮ੍ਰਿਧ ਜਿਹ ਪਾਨ ਲਾਗ ॥",
      "s": 9
    },
    {
      "t": "ਜਿਹ ਨਾਮ ਲੇਤ ਸਬ ਪਾਪ ਭਾਗ ॥੭੦॥",
      "s": 9
    },
    {
      "t": "ਗੁਨ ਸੀਲ ਸਾਧੁ ਤਾ ਕੇ ਸੁਭਾਇ ॥",
      "s": 9
    },
    {
      "t": "ਬਿਨੁ ਤਾਸ ਸਰਨਿ ਨਹੀ ਕੋਊ ਉਪਾਇ ॥",
      "s": 9
    }
  ]
}
