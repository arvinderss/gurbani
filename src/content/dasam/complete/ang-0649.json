{
  "page": 649,
  "lines": [
    {
      "t": "ਇਤਿ ਮਨ ਨੂੰ ਗੁਰੂ ਦੂਸਰ ਠਹਰਾਇਆ ਸਮਾਪਤੰ ॥੨॥",
      "s": 9
    },
    {
      "t": "ਅਥ ਤ੍ਰਿਤੀ ਗੁਰੂ ਮਕਰਕਾ ਕਥਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 9
    },
    {
      "t": "ਚਉਬੀਸ ਗੁਰੂ ਕੀਨ ਜਿਹਾ ਭਾਤਾ ॥",
      "s": 9
    },
    {
      "t": "ਅਬ ਸੁਨ ਲੇਹੁ ਕਹੋ ਇਹ ਬਾਤਾ ॥",
      "s": 9
    },
    {
      "t": "ਏਕ ਮਕਰਕਾ ਦਤ ਨਿਹਾਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਐਸ ਹ੍ਰਿਦੇ ਅਨੁਮਾਨ ਬਿਚਾਰੀ ॥੧੭੬॥",
      "s": 9
    },
    {
      "t": "ਆਪਨ ਹੀਐ ਐਸ ਅਨੁਮਾਨਾ ॥",
      "s": 9
    },
    {
      "t": "ਤੀਸਰ ਗੁਰੁ ਯਾਹਿ ਹਮ ਮਾਨਾ ॥",
      "s": 9
    },
    {
      "t": "ਪ੍ਰੇਮ ਸੂਤ ਕੀ ਡੋਰਿ ਬਢਾਵੈ ॥",
      "s": 9
    },
    {
      "t": "ਤਬ ਹੀ ਨਾਥ ਨਿਰੰਜਨ ਪਾਵੈ ॥੧੭੭॥",
      "s": 9
    },
    {
      "t": "ਆਪਨ ਆਪੁ ਆਪ ਮੋ ਦਰਸੈ ॥",
      "s": 9
    },
    {
      "t": "ਅੰਤਰਿ ਗੁਰੂ ਆਤਮਾ ਪਰਸੈ ॥",
      "s": 9
    },
    {
      "t": "ਏਕ ਛਾਡਿ ਕੈ ਅਨਤ ਨ ਧਾਵੈ ॥",
      "s": 9
    },
    {
      "t": "ਤਬ ਹੀ ਪਰਮ ਤਤੁ ਕੋ ਪਾਵੈ ॥੧੭੮॥",
      "s": 9
    },
    {
      "t": "ਏਕ ਸਰੂਪ ਏਕ ਕਰਿ ਦੇਖੈ ॥",
      "s": 9
    },
    {
      "t": "ਆਨ ਭਾਵ ਕੋ ਭਾਵ ਨੇ ਪੇਖੈ ॥",
      "s": 9
    },
    {
      "t": "ਏਕ ਆਸ ਤਜਿ ਅਨਤ ਨ ਧਾਵੈ ॥",
      "s": 9
    },
    {
      "t": "ਤਬ ਹੀ ਨਾਥ ਨਿਰੰਜਨ ਪਾਵੈ ॥੧੭੯॥",
      "s": 9
    },
    {
      "t": "ਕੇਵਲ ਅੰਗ ਰੰਗ ਤਿਹ ਰਾਚੈ ॥",
      "s": 9
    },
    {
      "t": "ਏਕ ਛਾਡਿ ਰਸ ਨੇਕ ਨ ਮਾਚੈ ॥",
      "s": 9
    },
    {
      "t": "ਪਰਮ ਤਤੁ ਕੋ ਧਿਆਨ ਲਗਾਵੈ ॥",
      "s": 9
    },
    {
      "t": "ਤਬ ਹੀ ਨਾਥ ਨਿਰੰਜਨ ਪਾਵੈ ॥੧੮੦॥",
      "s": 9
    },
    {
      "t": "ਤੀਸਰ ਗੁਰੂ ਮਕਰਿਕਾ ਠਾਨੀ ॥",
      "s": 9
    },
    {
      "t": "ਆਗੇ ਚਲਾ ਦਤ ਅਭਿਮਾਨੀ ॥",
      "s": 9
    },
    {
      "t": "ਤਾ ਕਰ ਭਾਵ ਹ੍ਰਿਦੇ ਮਹਿ ਲੀਨਾ ॥",
      "s": 9
    },
    {
      "t": "ਹਰਖਵੰਤ ਤਬ ਚਲਾ ਪ੍ਰਬੀਨਾ ॥੧੮੧॥",
      "s": 9
    },
    {
      "t": "ਇਤਿ ਤ੍ਰਿਤੀ ਗੁਰੂ ਮਕਰਕਾ ਸਮਾਪਤੰ ॥੩॥",
      "s": 9
    },
    {
      "t": "ਅਥ ਬਕ ਚਤਰਥ ਗੁਰੂ ਕਥਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 9
    },
    {
      "t": "ਜਬੈ ਦਤ ਗੁਰੁ ਅਗੈ ਸਿਧਾਰਾ ॥",
      "s": 9
    },
    {
      "t": "ਮਛ ਰਾਸਕਰ ਬੈਠਿ ਨਿਹਾਰਾ ॥",
      "s": 9
    },
    {
      "t": "ਉਜਲ ਅੰਗ ਅਤਿ ਧਿਆਨ ਲਗਾਵੈ ॥",
      "s": 9
    },
    {
      "t": "ਮੋਨੀ ਸਰਬ ਬਿਲੋਕਿ ਲਜਾਵੈ ॥੧੮੨॥",
      "s": 9
    },
    {
      "t": "ਜੈਸਕ ਧਿਆਨ ਮਛ ਕੇ ਕਾਜਾ ॥",
      "s": 9
    },
    {
      "t": "ਲਾਵਤ ਬਕ ਨਾਵੈ ਨਿਰਲਾਜਾ ॥",
      "s": 9
    },
    {
      "t": "ਭਲੀ ਭਾਤਿ ਇਹ ਧਿਆਨ ਲਗਾਵੈ ॥",
      "s": 9
    },
    {
      "t": "ਭਾਵ ਤਾਸ ਕੋ ਮੁਨਿ ਮਨ ਭਾਵੈ ॥੧੮੩॥",
      "s": 9
    },
    {
      "t": "ਐਸੋ ਧਿਆਨ ਨਾਥ ਹਿਤ ਲਈਐ ॥",
      "s": 9
    },
    {
      "t": "ਤਬ ਹੀ ਪਰਮ ਪੁਰਖ ਕਹੁ ਪਈਐ ॥",
      "s": 9
    },
    {
      "t": "ਮਛਾਤਕ ਲਖਿ ਦਤ ਲੁਭਾਨਾ ॥",
      "s": 9
    },
    {
      "t": "ਚਤਰਥ ਗੁਰੂ ਤਾਸ ਅਨੁਮਾਨਾ ॥੧੮੪॥",
      "s": 9
    },
    {
      "t": "ਇਤਿ ਮਛਾਤਕ ਚਤੁਰਥ ਗੁਰੂ ਸਮਾਪਤੰ ॥੪॥",
      "s": 9
    },
    {
      "t": "ਅਥ ਬਿੜਾਲ ਪੰਚਮ ਗੁਰੂ ਨਾਮ ॥",
      "s": 9
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 9
    },
    {
      "t": "ਆਗੇ ਚਲਾ ਦਤ ਮੁਨਿ ਰਾਈ ॥",
      "s": 9
    },
    {
      "t": "ਸੀਸ ਜਟਾ ਕਹ ਜੂਟ ਛਕਾਈ ॥",
      "s": 9
    },
    {
      "t": "ਦੇਖਾ ਏਕ ਬਿੜਾਲ ਜੁ ਆਗੇ ॥",
      "s": 9
    }
  ]
}
