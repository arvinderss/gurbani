{
  "page": 651,
  "lines": [
    {
      "t": "ਤਹਾ ਏਕ ਚੇਰਕਾ ਨਿਹਾਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਚੰਦਨ ਘਸਤ ਮਨੋ ਮਤਵਾਰੀ ॥੧੯੫॥",
      "s": 9
    },
    {
      "t": "ਚੰਦਨ ਘਸਤ ਨਾਰਿ ਸੁਭ ਧਰਮਾ ॥",
      "s": 9
    },
    {
      "t": "ਏਕ ਚਿਤ ਹ੍ਵੈ ਆਪਨ ਘਰ ਮਾ ॥",
      "s": 9
    },
    {
      "t": "ਏਕ ਚਿਤ ਨਹੀ ਚਿਤ ਚਲਾਵੈ ॥",
      "s": 9
    },
    {
      "t": "ਪ੍ਰਿਤਮਾ ਚਿਤ੍ਰ ਬਿਲੋਕਿ ਲਜਾਵੈ ॥੧੯੬॥",
      "s": 9
    },
    {
      "t": "ਦਤ ਲਏ ਸੰਨ੍ਯਾਸਨ ਸੰਗਾ ॥",
      "s": 9
    },
    {
      "t": "ਜਾਤ ਭਯੋ ਤਹ ਭੇਟਤ ਅੰਗਾ ॥",
      "s": 9
    },
    {
      "t": "ਸੀਸ ਉਚਾਇ ਨ ਤਾਸ ਨਿਹਾਰਾ ॥",
      "s": 9
    },
    {
      "t": "ਰਾਵ ਰੰਕ ਕੋ ਜਾਤ ਬਿਚਾਰਾ ॥੧੯੭॥",
      "s": 9
    },
    {
      "t": "ਤਾ ਕੋ ਦਤ ਬਿਲੋਕਿ ਪ੍ਰਭਾਵਾ ॥",
      "s": 9
    },
    {
      "t": "ਅਸਟਮ ਗੁਰੂ ਤਾਹਿ ਠਹਰਾਵਾ ॥",
      "s": 9
    },
    {
      "t": "ਧੰਨਿ ਧੰਨਿ ਇਹ ਚੇਰਕਾ ਸਭਾਗੀ ॥",
      "s": 9
    },
    {
      "t": "ਜਾ ਕੀ ਪ੍ਰੀਤਿ ਨਾਥ ਸੰਗਿ ਲਾਗੀ ॥੧੯੮॥",
      "s": 9
    },
    {
      "t": "ਐਸ ਪ੍ਰੀਤਿ ਹਰਿ ਹੇਤ ਲਗਇਯੈ ॥",
      "s": 9
    },
    {
      "t": "ਤਬ ਹੀ ਨਾਥ ਨਿਰੰਜਨ ਪਇਯੈ ॥",
      "s": 9
    },
    {
      "t": "ਬਿਨੁ ਚਿਤਿ ਦੀਨ ਹਾਥਿ ਨਹੀ ਆਵੈ ॥",
      "s": 9
    },
    {
      "t": "ਚਾਰ ਬੇਦ ਇਮਿ ਭੇਦ ਬਤਾਵੈ ॥੧੯੯॥",
      "s": 9
    },
    {
      "t": "ਇਤਿ ਚੇਰਕਾ ਅਸਟਮੋ ਗੁਰੂ ਸਮਾਪਤੰ ॥੮॥",
      "s": 9
    },
    {
      "t": "ਅਥ ਬਨਜਾਰਾ ਨਵਮੋ ਗੁਰੂ ਕਥਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 9
    },
    {
      "t": "ਆਗੇ ਚਲਾ ਜੋਗ ਜਟ ਧਾਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਲਏ ਸੰਗਿ ਚੇਲਕਾ ਅਪਾਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਦੇਖਤ ਬਨਖੰਡ ਨਗਰ ਪਹਾਰਾ ॥",
      "s": 9
    },
    {
      "t": "ਆਵਤ ਲਖਾ ਏਕ ਬਨਜਾਰਾ ॥੨੦੦॥",
      "s": 9
    },
    {
      "t": "ਧਨ ਕਰ ਭਰੇ ਸਬੈ ਭੰਡਾਰਾ ॥",
      "s": 9
    },
    {
      "t": "ਚਲਾ ਸੰਗ ਲੈ ਟਾਡ ਅਪਾਰਾ ॥",
      "s": 9
    },
    {
      "t": "ਅਮਿਤ ਗਾਵ ਲਵੰਗਨ ਕੇ ਭਰੇ ॥",
      "s": 9
    },
    {
      "t": "ਬਿਧਨਾ ਤੇ ਨਹੀ ਜਾਤ ਬਿਚਰੇ ॥੨੦੧॥",
      "s": 9
    },
    {
      "t": "ਰਾਤਿ ਦਿਵਸ ਤਿਨ ਦ੍ਰਬ ਕੀ ਆਸਾ ॥",
      "s": 9
    },
    {
      "t": "ਬੇਚਨ ਚਲਾ ਛਾਡਿ ਘਰ ਵਾਸਾ ॥",
      "s": 9
    },
    {
      "t": "ਔਰ ਆਸ ਦੂਸਰ ਨਹੀ ਕੋਈ ॥",
      "s": 9
    },
    {
      "t": "ਏਕੈ ਆਸ ਬਨਜ ਕੀ ਹੋਈ ॥੨੦੨॥",
      "s": 9
    },
    {
      "t": "ਛਾਹ ਧੂਪ ਕੋ ਤ੍ਰਾਸ ਨ ਮਾਨੈ ॥",
      "s": 9
    },
    {
      "t": "ਰਾਤਿ ਅਉ ਦਿਵਸ ਗਵਨ ਈ ਠਾਨੈ ॥",
      "s": 9
    },
    {
      "t": "ਪਾਪ ਪੁੰਨ ਕੀ ਅਉਰ ਨ ਬਾਤਾ ॥",
      "s": 9
    },
    {
      "t": "ਏਕੈ ਰਸ ਮਾਤ੍ਰਾ ਕੇ ਰਾਤਾ ॥੨੦੩॥",
      "s": 9
    },
    {
      "t": "ਤਾ ਕਹ ਦੇਖਿ ਦਤ ਹਰਿ ਭਗਤੂ ॥",
      "s": 9
    },
    {
      "t": "ਜਾ ਕਰ ਰੂਪ ਜਗਤਿ ਜਗ ਮਗਤੂ ॥",
      "s": 9
    },
    {
      "t": "ਐਸ ਭਾਤਿ ਜੋ ਸਾਹਿਬ ਧਿਆਈਐ ॥",
      "s": 9
    },
    {
      "t": "ਤਬ ਹੀ ਪੁਰਖ ਪੁਰਾਤਨ ਪਾਈਐ ॥੨੦੪॥",
      "s": 9
    },
    {
      "t": "ਇਤਿ ਬਨਜਾਰਾ ਨਉਮੋ ਗੁਰੂ ਸਮਾਪਤੰ ॥੯॥",
      "s": 9
    },
    {
      "t": "ਅਥ ਕਾਛਨ ਦਸਮੋ ਗੁਰੂ ਕਥਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 9
    },
    {
      "t": "ਚਲਾ ਮੁਨੀ ਤਜਿ ਪਰਹਰਿ ਆਸਾ ॥",
      "s": 9
    },
    {
      "t": "ਮਹਾ ਮੋਨਿ ਅਰੁ ਮਹਾ ਉਦਾਸਾ ॥",
      "s": 9
    },
    {
      "t": "ਪਰਮ ਤਤ ਬੇਤਾ ਬਡਭਾਗੀ ॥",
      "s": 9
    },
    {
      "t": "ਮਹਾ ਮੋਨ ਹਰਿ ਕੋ ਅਨੁਰਾਗੀ ॥੨੦੫॥",
      "s": 9
    }
  ]
}
