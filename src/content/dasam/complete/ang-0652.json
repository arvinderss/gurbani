{
  "page": 652,
  "lines": [
    {
      "t": "ਪਰਮ ਪੁਰਖ ਪੂਰੋ ਬਡਭਾਗੀ ॥",
      "s": 9
    },
    {
      "t": "ਮਹਾ ਮੁਨੀ ਹਰਿ ਕੇ ਰਸ ਪਾਗੀ ॥",
      "s": 9
    },
    {
      "t": "ਬ੍ਰਹਮ ਭਗਤ ਖਟ ਗੁਨ ਰਸ ਲੀਨਾ ॥",
      "s": 9
    },
    {
      "t": "ਏਕ ਨਾਮ ਕੇ ਰਸ ਸਉ ਭੀਨਾ ॥੨੦੬॥",
      "s": 9
    },
    {
      "t": "ਉਜਲ ਗਾਤ ਮਹਾ ਮੁਨਿ ਸੋਹੈ ॥",
      "s": 9
    },
    {
      "t": "ਸੁਰ ਨਰ ਮੁਨਿ ਸਭ ਕੋ ਮਨ ਮੋਹੈ ॥",
      "s": 9
    },
    {
      "t": "ਜਹ ਜਹ ਜਾਇ ਦਤ ਸੁਭ ਕਰਮਾ ॥",
      "s": 9
    },
    {
      "t": "ਤਹ ਤਹ ਹੋਤ ਸਭੈ ਨਿਹਕਰਮਾ ॥੨੦੭॥",
      "s": 9
    },
    {
      "t": "ਭਰਮ ਮੋਹ ਤਿਹ ਦੇਖਤ ਭਾਗੈ ॥",
      "s": 9
    },
    {
      "t": "ਰਾਮ ਭਗਤਿ ਸਭ ਹੀ ਉਠਿ ਲਾਗੈ ॥",
      "s": 9
    },
    {
      "t": "ਪਾਪ ਤਾਪ ਸਭ ਦੂਰ ਪਰਾਈ ॥",
      "s": 9
    },
    {
      "t": "ਨਿਸਿ ਦਿਨ ਰਹੈ ਏਕ ਲਿਵ ਲਾਈ ॥੨੦੮॥",
      "s": 9
    },
    {
      "t": "ਕਾਛਨ ਏਕ ਤਹਾ ਮਿਲ ਗਈ ॥",
      "s": 9
    },
    {
      "t": "ਸੋਆ ਚੂਕ ਪੁਕਾਰਤ ਭਈ ॥",
      "s": 9
    },
    {
      "t": "ਭਾਵ ਯਾਹਿ ਮਨ ਮਾਹਿ ਨਿਹਾਰਾ ॥",
      "s": 9
    },
    {
      "t": "ਦਸਵੋ ਗੁਰੂ ਤਾਹਿ ਬੀਚਾਰਾ ॥੨੦੯॥",
      "s": 9
    },
    {
      "t": "ਜੋ ਸੋਵੈ ਸੋ ਮੂਲੁ ਗਵਾਵੈ ॥",
      "s": 9
    },
    {
      "t": "ਜੋ ਜਾਗੈ ਹਰਿ ਹ੍ਰਿਦੈ ਬਸਾਵੈ ॥",
      "s": 9
    },
    {
      "t": "ਸਤਿ ਬੋਲਿ ਯਾ ਕੀ ਹਮ ਮਾਨੀ ॥",
      "s": 9
    },
    {
      "t": "ਜੋਗ ਧਿਆਨ ਜਾਗੈ ਤੇ ਜਾਨੀ ॥੨੧੦॥",
      "s": 9
    },
    {
      "t": "ਇਤਿ ਕਾਛਨ ਗੁਰੂ ਦਸਵੋ ਸਮਾਪਤੰ ॥੧੦॥",
      "s": 9
    },
    {
      "t": "ਅਥ ਸੁਰਥ ਯਾਰਮੋ ਗੁਰੂ ਕਥਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 9
    },
    {
      "t": "ਆਗੇ ਦਤ ਦੇਵ ਤਬ ਚਲਾ ॥",
      "s": 9
    },
    {
      "t": "ਸਾਧੇ ਸਰਬ ਜੋਗ ਕੀ ਕਲਾ ॥",
      "s": 9
    },
    {
      "t": "ਅਮਿਤ ਤੇਜ ਅਰੁ ਉਜਲ ਪ੍ਰਭਾਉ ॥",
      "s": 9
    },
    {
      "t": "ਜਾਨੁਕ ਬਨਾ ਦੂਸਰ ਹਰਿ ਰਾਉ ॥੨੧੧॥",
      "s": 9
    },
    {
      "t": "ਸਭ ਹੀ ਕਲਾ ਜੋਗ ਕੀ ਸਾਧੀ ॥",
      "s": 9
    },
    {
      "t": "ਮਹਾ ਸਿਧਿ ਮੋਨੀ ਮਨਿ ਲਾਧੀ ॥",
      "s": 9
    },
    {
      "t": "ਅਧਿਕ ਤੇਜ ਅਰੁ ਅਧਿਕ ਪ੍ਰਭਾਵਾ ॥",
      "s": 9
    },
    {
      "t": "ਜਾ ਲਖਿ ਇੰਦ੍ਰਾਸਨ ਥਹਰਾਵਾ ॥੨੧੨॥",
      "s": 9
    },
    {
      "t": "ਮਧੁਭਾਰ ਛੰਦ ॥ ਤ੍ਵਪ੍ਰਸਾਦਿ ॥",
      "s": 9
    },
    {
      "t": "ਮੁਨਿ ਮਨਿ ਉਦਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਗੁਨ ਗਨ ਅਪਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਹਰਿ ਭਗਤਿ ਲੀਨ ॥",
      "s": 9
    },
    {
      "t": "ਹਰਿ ਕੋ ਅਧੀਨ ॥੨੧੩॥",
      "s": 9
    },
    {
      "t": "ਤਜਿ ਰਾਜ ਭੋਗ ॥",
      "s": 9
    },
    {
      "t": "ਸੰਨ੍ਯਾਸ ਜੋਗ ॥",
      "s": 9
    },
    {
      "t": "ਸੰਨ੍ਯਾਸ ਰਾਇ ॥",
      "s": 9
    },
    {
      "t": "ਹਰਿ ਭਗਤ ਭਾਇ ॥੨੧੪॥",
      "s": 9
    },
    {
      "t": "ਮੁਖ ਛਬਿ ਅਪਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਪੂਰਣ ਵਤਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਖੜਗੰ ਅਸੇਖ ॥",
      "s": 9
    },
    {
      "t": "ਬਿਦਿਆ ਬਿਸੇਖ ॥੨੧੫॥",
      "s": 9
    },
    {
      "t": "ਸੁੰਦਰ ਸਰੂਪ ॥",
      "s": 9
    },
    {
      "t": "ਮਹਿਮਾ ਅਨੂਪ ॥",
      "s": 9
    },
    {
      "t": "ਆਭਾ ਅਪਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਮੁਨਿ ਮਨਿ ਉਦਾਰ ॥੨੧੬॥",
      "s": 9
    }
  ]
}
