  "lines": [
    {
      "t": "ਚਤੁਰ ਬੇਦ ਚਰਚਾ ॥੨੫੭॥",
      "s": 9
    },
    {
      "t": "ਸ੍ਰੁਤੰ ਸਰਬ ਪਾਠੰ ॥",
      "s": 9
    },
    {
      "t": "ਸੁ ਸੰਨ੍ਯਾਸ ਰਾਠੰ ॥",
      "s": 9
    },
    {
      "t": "ਮਹਾਜੋਗ ਨ੍ਯਾਸੰ ॥",
      "s": 9
    },
    {
      "t": "ਸਦਾਈ ਉਦਾਸੰ ॥੨੫੮॥",
      "s": 9
    },
    {
      "t": "ਖਟੰ ਸਾਸਤ੍ਰ ਚਰਚਾ ॥",
      "s": 9
    },
    {
      "t": "ਰਟੈ ਬੇਦ ਅਰਚਾ ॥",
      "s": 9
    },
    {
      "t": "ਮਹਾ ਮੋਨ ਮਾਨੀ ॥",
      "s": 9
    },
    {
      "t": "ਕਿ ਸੰਨ੍ਯਾਸ ਧਾਨੀ ॥੨੫੯॥",
      "s": 9
    },
    {
      "t": "ਚਲਾ ਦਤ ਆਗੈ ॥",
      "s": 9
    },
    {
      "t": "ਲਖੇ ਪਾਪ ਭਾਗੈ ॥",
      "s": 9
    },
    {
      "t": "ਲਖੀ ਏਕ ਕੰਨਿਆ ॥",
      "s": 9
    },
    {
      "t": "ਤਿਹੂੰ ਲੋਗ ਧੰਨਿਆ ॥੨੬੦॥",
      "s": 9
    },
    {
      "t": "ਮਹਾ ਬ੍ਰਹਮਚਾਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਸੁ ਧਰਮਾਧਿਕਾਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਲਖੀ ਪਾਨਿ ਵਾ ਕੇ ॥",
      "s": 9
    },
    {
      "t": "ਗੁਡੀ ਬਾਲਿ ਤਾ ਕੇ ॥੨੬੧॥",
      "s": 9
    },
    {
      "t": "ਖਿਲੈ ਖੇਲ ਤਾ ਸੋ ॥",
      "s": 9
    },
    {
      "t": "ਇਸੋ ਹੇਤ ਵਾ ਸੋ ॥",
      "s": 9
    },
    {
      "t": "ਪੀਐ ਪਾਨਿ ਨ ਆਵੈ ॥",
      "s": 9
    },
    {
      "t": "ਇਸੋ ਖੇਲ ਭਾਵੈ ॥੨੬੨॥",
      "s": 9
    },
    {
      "t": "ਗਏ ਮੋਨਿ ਮਾਨੀ ॥",
      "s": 9
    },
    {
      "t": "ਤਰੈ ਦਿਸਟ ਆਨੀ ॥",
      "s": 9
    },
    {
      "t": "ਨ ਬਾਲਾ ਨਿਹਾਰ੍ਯੋ ॥",
      "s": 9
    },
    {
      "t": "ਨ ਖੇਲੰ ਬਿਸਾਰ੍ਯੋ ॥੨੬੩॥",
      "s": 9
    },
    {
      "t": "ਲਖੀ ਦਤ ਬਾਲਾ ॥",
      "s": 9
    },
    {
      "t": "ਮਨੋ ਰਾਗਮਾਲਾ ॥",
      "s": 9
    },
    {
      "t": "ਰੰਗੀ ਰੰਗਿ ਖੇਲੰ ॥",
      "s": 9
    },
    {
      "t": "ਮਨੋ ਨਾਗ੍ਰ ਬੇਲੰ ॥੨੬੪॥",
      "s": 9
    },
    {
      "t": "ਤਬੈ ਦਤ ਰਾਯੰ ॥",
      "s": 9
    },
    {
      "t": "ਲਖੇ ਤਾਸ ਜਾਯੰ ॥",
      "s": 9
    },
    {
      "t": "ਗੁਰੂ ਤਾਸ ਕੀਨਾ ॥",
      "s": 9
    },
    {
      "t": "ਮਹਾ ਮੰਤ੍ਰ ਭੀਨਾ ॥੨੬੫॥",
      "s": 9
    },
    {
      "t": "ਗੁਰੂ ਤਾਸ ਜਾਨ੍ਯੋ ॥",
      "s": 9
    },
    {
      "t": "ਇਮੰ ਮੰਤ੍ਰ ਠਾਨ੍ਰਯੋ ॥",
      "s": 9
    },
    {
      "t": "ਦਸੰ ਦ੍ਵੈ ਨਿਧਾਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਗੁਰੂ ਦਤ ਜਾਨੰ ॥੨੬੬॥",
      "s": 9
    },
    {
      "t": "ਰੁਣਝੁਣ ਛੰਦ ॥",
      "s": 9
    },
    {
      "t": "ਲਖਿ ਛਬਿ ਬਾਲੀ ॥",
      "s": 9
    },
    {
      "t": "ਅਤਿ ਦੁਤਿ ਵਾਲੀ ॥",
      "s": 9
    },
    {
      "t": "ਅਤਿਭੁਤ ਰੂਪੰ ॥",
      "s": 9
    },
    {
      "t": "ਜਣੁ ਬੁਧਿ ਕੂਪੰ ॥੨੬੭॥",
      "s": 9
    },
    {
      "t": "ਫਿਰ ਫਿਰ ਪੇਖਾ ॥",
      "s": 9
    },
    {
      "t": "ਬਹੁ ਬਿਧਿ ਲੇਖਾ ॥",
      "s": 9
    },
    {
      "t": "ਤਨ ਮਨ ਜਾਨਾ ॥",
      "s": 9
    },
    {
      "t": "ਗੁਨ ਗਨ ਮਾਨਾ ॥੨੬੮॥",
      "s": 9
    },
    {
      "t": "ਤਿਹ ਗੁਰ ਕੀਨਾ ॥",
      "s": 9
    },
    {
      "t": "ਅਤਿ ਜਸੁ ਲੀਨਾ ॥",
      "s": 9
