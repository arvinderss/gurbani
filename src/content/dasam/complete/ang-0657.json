{
  "page": 657,
  "lines": [
    {
      "t": "ਅਗਿ ਤਬ ਚਾਲਾ ॥",
      "s": 9
    },
    {
      "t": "ਜਨੁ ਮਨਿ ਜ੍ਵਾਲਾ ॥੨੬੯॥",
      "s": 9
    },
    {
      "t": "ਇਤਿ ਦੁਆਦਸ ਗੁਰੂ ਲੜਕੀ ਗੁਡੀ ਖੇਡਤੀ ਸਮਾਪਤੰ ॥੧੨॥",
      "s": 9
    },
    {
      "t": "ਅਥ ਭ੍ਰਿਤ ਤ੍ਰੋਦਸਮੋ ਗੁਰੂ ਕਥਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਤੋਮਰ ਛੰਦ ॥",
      "s": 9
    },
    {
      "t": "ਤਬ ਦਤ ਦੇਵ ਮਹਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਦਸ ਚਾਰ ਚਾਰ ਨਿਧਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਅਤਿਭੁਤ ਉਤਮ ਗਾਤ ॥",
      "s": 9
    },
    {
      "t": "ਹਰਿ ਨਾਮੁ ਲੇਤ ਪ੍ਰਭਾਤ ॥੨੭੦॥",
      "s": 9
    },
    {
      "t": "ਅਕਲੰਕ ਉਜਲ ਅੰਗ ॥",
      "s": 9
    },
    {
      "t": "ਲਖਿ ਲਾਜ ਗੰਗ ਤਰੰਗ ॥",
      "s": 9
    },
    {
      "t": "ਅਨਭੈ ਅਭੂਤ ਸਰੂਪ ॥",
      "s": 9
    },
    {
      "t": "ਲਖਿ ਜੋਤਿ ਲਾਜਤ ਭੂਪ ॥੨੭੧॥",
      "s": 9
    },
    {
      "t": "ਅਵਲੋਕਿ ਸੁ ਭ੍ਰਿਤ ਏਕ ॥",
      "s": 9
    },
    {
      "t": "ਗੁਨ ਮਧਿ ਜਾਸੁ ਅਨੇਕ ॥",
      "s": 9
    },
    {
      "t": "ਅਧਿ ਰਾਤਿ ਠਾਢਿ ਦੁਆਰਿ ॥",
      "s": 9
    },
    {
      "t": "ਬਹੁ ਬਰਖ ਮੇਘ ਫੁਹਾਰ ॥੨੭੨॥",
      "s": 9
    },
    {
      "t": "ਅਧਿ ਰਾਤਿ ਦਤ ਨਿਹਾਰਿ ॥",
      "s": 9
    },
    {
      "t": "ਗੁਣਵੰਤ ਬਿਕ੍ਰਮ ਅਪਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਜਲ ਮੁਸਲਧਾਰ ਪਰੰਤ ॥",
      "s": 9
    },
    {
      "t": "ਨਿਜ ਨੈਨ ਦੇਖਿ ਮਹੰਤ ॥੨੭੩॥",
      "s": 9
    },
    {
      "t": "ਇਕ ਚਿਤ ਠਾਢ ਸੁ ਐਸ ॥",
      "s": 9
    },
    {
      "t": "ਸੋਵਰਨ ਮੂਰਤਿ ਜੈਸ ॥",
      "s": 9
    },
    {
      "t": "ਦ੍ਰਿੜ ਦੇਖਿ ਤਾ ਕੀ ਮਤਿ ॥",
      "s": 9
    },
    {
      "t": "ਅਤਿ ਮਨਹਿ ਰੀਝੇ ਦਤ ॥੨੭੪॥",
      "s": 9
    },
    {
      "t": "ਨਹੀ ਸੀਤ ਮਾਨਤ ਘਾਮ ॥",
      "s": 9
    },
    {
      "t": "ਨਹੀ ਚਿਤ ਲ੍ਯਾਵਤ ਛਾਮ ॥",
      "s": 9
    },
    {
      "t": "ਨਹੀ ਨੈਕੁ ਮੋਰਤ ਅੰਗ ॥",
      "s": 9
    },
    {
      "t": "ਇਕ ਪਾਇ ਠਾਢ ਅਭੰਗ ॥੨੭੫॥",
      "s": 9
    },
    {
      "t": "ਢਿਗ ਦਤ ਤਾ ਕੇ ਜਾਇ ॥",
      "s": 9
    },
    {
      "t": "ਅਵਿਲੋਕਿ ਤਾਸੁ ਬਨਾਏ ॥",
      "s": 9
    },
    {
      "t": "ਅਧਿ ਰਾਤ੍ਰਿ ਨਿਰਜਨ ਤ੍ਰਾਸ ॥",
      "s": 9
    },
    {
      "t": "ਅਸਿ ਲੀਨ ਠਾਢ ਉਦਾਸ ॥੨੭੬॥",
      "s": 9
    },
    {
      "t": "ਬਰਖੰਤ ਮੇਘ ਮਹਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਭਾਜੰਤ ਭੂਮਿ ਨਿਧਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਜਗਿ ਜੀਵ ਸਰਬ ਸੁ ਭਾਸ ॥",
      "s": 9
    },
    {
      "t": "ਉਠਿ ਭਾਜ ਤ੍ਰਾਸ ਉਦਾਸ ॥੨੭੭॥",
      "s": 9
    },
    {
      "t": "ਇਹ ਠਾਢ ਭੂਪਤਿ ਪਉਰ ॥",
      "s": 9
    },
    {
      "t": "ਮਨ ਜਾਪ ਜਾਪਤ ਗਉਰ ॥",
      "s": 9
    },
    {
      "t": "ਨਹੀ ਨੈਕੁ ਮੋਰਤ ਅੰਗ ॥",
      "s": 9
    },
    {
      "t": "ਇਕ ਪਾਵ ਠਾਢ ਅਭੰਗ ॥੨੭੮॥",
      "s": 9
    },
    {
      "t": "ਅਸਿ ਲੀਨ ਪਾਨਿ ਕਰਾਲ ॥",
      "s": 9
    },
    {
      "t": "ਚਮਕੰਤ ਉਜਲ ਜ੍ਵਾਲ ॥",
      "s": 9
    },
    {
      "t": "ਜਨ ਕਾਹੂ ਕੋ ਨਹੀ ਮਿਤ੍ਰ ॥",
      "s": 9
    },
    {
      "t": "ਇਹ ਭਾਤਿ ਪਰਮ ਪਵਿਤ੍ਰ ॥੨੭੯॥",
      "s": 9
    },
    {
      "t": "ਨਹੀ ਨੈਕੁ ਉਚਾਵਤ ਪਾਉ ॥",
      "s": 9
    },
    {
      "t": "ਬਹੁ ਭਾਤਿ ਸਾਧਤ ਦਾਉ ॥",
      "s": 9
    },
    {
      "t": "ਅਨਆਸ ਭੂਪਤਿ ਭਗਤ ॥",
      "s": 9
    }
  ]
}
