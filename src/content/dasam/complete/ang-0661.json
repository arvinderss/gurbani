{
  "page": 661,
  "lines": [
    {
      "t": "ਕਿ ਸੁਵ੍ਰਣੰ ਪ੍ਰਭਾ ਹੈ ॥੩੨੧॥",
      "s": 9
    },
    {
      "t": "ਕਿ ਪਦਮੰ ਦ੍ਰਿਗੀ ਹੈ ॥",
      "s": 9
    },
    {
      "t": "ਕਿ ਪਰਮੰ ਪ੍ਰਭੀ ਹੈ ॥",
      "s": 9
    },
    {
      "t": "ਕਿ ਬੀਰਾਬਰਾ ਹੈ ॥",
      "s": 9
    },
    {
      "t": "ਕਿ ਸਸਿ ਕੀ ਸੁਭਾ ਹੈ ॥੩੨੨॥",
      "s": 9
    },
    {
      "t": "ਕਿ ਨਾਗੇਸਜਾ ਹੈ ॥",
      "s": 9
    },
    {
      "t": "ਨਾਗਨ ਪ੍ਰਭਾ ਹੈ ॥",
      "s": 9
    },
    {
      "t": "ਕਿ ਨਲਨੰ ਦ੍ਰਿਗੀ ਹੈ ॥",
      "s": 9
    },
    {
      "t": "ਕਿ ਮਲਿਨੀ ਮ੍ਰਿਗੀ ਹੈ ॥੩੨੩॥",
      "s": 9
    },
    {
      "t": "ਕਿ ਅਮਿਤੰ ਪ੍ਰਭਾ ਹੈ ॥",
      "s": 9
    },
    {
      "t": "ਕਿ ਅਮਿਤੋਤਮਾ ਹੈ ॥",
      "s": 9
    },
    {
      "t": "ਕਿ ਅਕਲੰਕ ਰੂਪੰ ॥",
      "s": 9
    },
    {
      "t": "ਕਿ ਸਭ ਜਗਤ ਭੂਪੰ ॥੩੨੪॥",
      "s": 9
    },
    {
      "t": "ਮੋਹਣੀ ਛੰਦ ॥",
      "s": 9
    },
    {
      "t": "ਜੁਬਣਮਯ ਮੰਤੀ ਸੁ ਬਾਲੀ ॥",
      "s": 9
    },
    {
      "t": "ਮੁਖ ਨੂਰੰ ਪੂਰੰ ਉਜਾਲੀ ॥",
      "s": 9
    },
    {
      "t": "ਮ੍ਰਿਗ ਨੈਣੀ ਬੈਣੀ ਕੋਕਿਲਾ ॥",
      "s": 9
    },
    {
      "t": "ਸਸਿ ਆਭਾ ਸੋਭਾ ਚੰਚਲਾ ॥੩੨੫॥",
      "s": 9
    },
    {
      "t": "ਘਣਿ ਮੰਝੈ ਜੈ ਹੈ ਚੰਚਾਲੀ ॥",
      "s": 9
    },
    {
      "t": "ਮ੍ਰਿਦੁਹਾਸਾ ਨਾਸਾ ਖੰਕਾਲੀ ॥",
      "s": 9
    },
    {
      "t": "ਚਖੁ ਚਾਰੰ ਹਾਰੰ ਕੰਠਾਯੰ ॥",
      "s": 9
    },
    {
      "t": "ਮ੍ਰਿਗ ਨੈਣੀ ਬੇਣੀ ਮੰਡਾਯੰ ॥੩੨੬॥",
      "s": 9
    },
    {
      "t": "ਗਜ ਗਾਮੰ ਬਾਮੰ ਸੁ ਗੈਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਮ੍ਰਿਦਹਾਸੰ ਬਾਸੰ ਬਿਧ ਬੈਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਚਖੁ ਚਾਰੰ ਹਾਰੰ ਨਿਰਮਲਾ ॥",
      "s": 9
    },
    {
      "t": "ਲਖਿ ਆਭਾ ਲਜੀ ਚੰਚਲਾ ॥੩੨੭॥",
      "s": 9
    },
    {
      "t": "ਦ੍ਰਿੜ ਧਰਮਾ ਕਰਮਾ ਸੁਕਰਮੰ ॥",
      "s": 9
    },
    {
      "t": "ਦੁਖ ਹਰਤਾ ਸਰਤਾ ਜਾਣੁ ਧਰਮੰ ॥",
      "s": 9
    },
    {
      "t": "ਮੁਖ ਨੂਰੰ ਭੂਰੰ ਸੁ ਬਾਸਾ ॥",
      "s": 9
    },
    {
      "t": "ਚਖੁ ਚਾਰੀ ਬਾਰੀ ਅੰਨਾਸਾ ॥੩੨੮॥",
      "s": 9
    },
    {
      "t": "ਚਖੁ ਚਾਰੰ ਬਾਰੰ ਚੰਚਾਲੀ ॥",
      "s": 9
    },
    {
      "t": "ਸਤ ਧਰਮਾ ਕਰਮਾ ਸੰਚਾਲੀ ॥",
      "s": 9
    },
    {
      "t": "ਦੁਖ ਹਰਣੀ ਦਰਣੀ ਦੁਖ ਦ੍ਵੰਦੰ ॥",
      "s": 9
    },
    {
      "t": "ਪ੍ਰਿਯਾ ਭਕਤਾ ਬਕਤਾ ਹਰਿ ਛੰਦੰ ॥੩੨੯॥",
      "s": 9
    },
    {
      "t": "ਰੰਭਾ ਉਰਬਸੀਆ ਘ੍ਰਿਤਾਚੀ ॥",
      "s": 9
    },
    {
      "t": "ਅਛੈ ਮੋਹਣੀ ਆਜੇ ਰਾਚੀ ॥",
      "s": 9
    },
    {
      "t": "ਲਖਿ ਸਰਬੰ ਗਰਬੰ ਪਰਹਾਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਮੁਖਿ ਨੀਚੇ ਧਾਮੰ ਸਿਧਾਰੀ ॥੩੩੦॥",
      "s": 9
    },
    {
      "t": "ਗੰਧਰਬੰ ਸਰਬੰ ਦੇਵਾਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਗਿਰਜਾ ਗਾਇਤ੍ਰੀ ਲੰਕਾਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਸਾਵਿਤ੍ਰੀ ਚੰਦ੍ਰੀ ਇੰਦ੍ਰਾਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਲਖਿ ਲਜੀ ਸੋਭਾ ਸੂਰਜਾਣੀ ॥੩੩੧॥",
      "s": 9
    },
    {
      "t": "ਨਾਗਣੀਆ ਨ੍ਰਿਤਿਆ ਜਛਾਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਪਾਪਾ ਪਾਵਿਤ੍ਰੀ ਪਬਾਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਪਈਸਾਚ ਪ੍ਰੇਤੀ ਭੂਤੇਸੀ ॥",
      "s": 9
    },
    {
      "t": "ਭਿੰਭਰੀਆ ਭਾਮਾ ਭੂਪੇਸੀ ॥੩੩੨॥",
      "s": 9
    },
    {
      "t": "ਬਰ ਬਰਣੀ ਹਰਣੀ ਸਬ ਦੁਖੰ ॥",
      "s": 9
    },
    {
      "t": "ਸੁਖ ਕਰਨੀ ਤਰੁਣੀ ਸਸਿ ਮੁਖੰ ॥",
      "s": 9
    }
  ]
}
