{
  "page": 662,
  "lines": [
    {
      "t": "ਉਰਗੀ ਗੰਧ੍ਰਬੀ ਜਛਾਨੀ ॥",
      "s": 9
    },
    {
      "t": "ਲੰਕੇਸੀ ਭੇਸੀ ਇੰਦ੍ਰਾਣੀ ॥੩੩੩॥",
      "s": 9
    },
    {
      "t": "ਦ੍ਰਿਗ ਬਾਨੰ ਤਾਨੰ ਮਦਮਤੀ ॥",
      "s": 9
    },
    {
      "t": "ਜੁਬਨ ਜਗਮਗਣੀ ਸੁਭਵੰਤੀ ॥",
      "s": 9
    },
    {
      "t": "ਉਰਿ ਧਾਰੰ ਹਾਰੰ ਬਨਿ ਮਾਲੰ ॥",
      "s": 9
    },
    {
      "t": "ਮੁਖਿ ਸੋਭਾ ਸਿਖਿਰੰ ਜਨ ਜ੍ਵਾਲੰ ॥੩੩੪॥",
      "s": 9
    },
    {
      "t": "ਛਤਪਤ੍ਰੀ ਛਤ੍ਰੀ ਛਤ੍ਰਾਲੀ ॥",
      "s": 9
    },
    {
      "t": "ਬਿਧੁ ਬੈਣੀ ਨੈਣੀ ਨ੍ਰਿਮਾਲੀ ॥",
      "s": 9
    },
    {
      "t": "ਅਸਿ ਉਪਾਸੀ ਦਾਸੀ ਨਿਰਲੇਪੰ ॥",
      "s": 9
    },
    {
      "t": "ਬੁਧਿ ਖਾਨੰ ਮਾਨੰ ਸੰਛੇਪੰ ॥੩੩੫॥",
      "s": 9
    },
    {
      "t": "ਸੁਭ ਸੀਲੰ ਡੀਲੰ ਸੁਖ ਥਾਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਮੁਖ ਹਾਸੰ ਰਾਸੰ ਨਿਰਬਾਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਪ੍ਰਿਯਾ ਭਕਤਾ ਬਕਤਾ ਹਰਿ ਨਾਮੰ ॥",
      "s": 9
    },
    {
      "t": "ਚਿਤ ਲੈਣੀ ਦੈਣੀ ਆਰਾਮੰ ॥੩੩੬॥",
      "s": 9
    },
    {
      "t": "ਪ੍ਰਿਯ ਭਕਤਾ ਠਾਢੀ ਏਕੰਗੀ ॥",
      "s": 9
    },
    {
      "t": "ਰੰਗ ਏਕੈ ਰੰਗੈ ਸੋ ਰੰਗੀ ॥",
      "s": 9
    },
    {
      "t": "ਨਿਰ ਬਾਸਾ ਆਸਾ ਏਕਾਤੰ ॥",
      "s": 9
    },
    {
      "t": "ਪਤਿ ਦਾਸੀ ਭਾਸੀ ਪਰਭਾਤੰ ॥੩੩੭॥",
      "s": 9
    },
    {
      "t": "ਅਨਿ ਨਿੰਦ੍ਰ ਅਨਿੰਦਾ ਨਿਰਹਾਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਪ੍ਰਿਯ ਭਕਤਾ ਬਕਤਾ ਬ੍ਰਤਚਾਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਬਾਸੰਤੀ ਟੋਡੀ ਗਉਡੀ ਹੈ ॥",
      "s": 9
    },
    {
      "t": "ਭੁਪਾਲੀ ਸਾਰੰਗ ਗਉਰੀ ਛੈ ॥੩੩੮॥",
      "s": 9
    },
    {
      "t": "ਹਿੰਡੋਲੀ ਮੇਘ ਮਲਾਰੀ ਹੈ ॥",
      "s": 9
    },
    {
      "t": "ਜੈਜਾਵੰਤੀ ਗੌਡ ਮਲਾਰੀ ਛੈ ॥",
      "s": 9
    },
    {
      "t": "ਬੰਗਲੀਆ ਰਾਗੁ ਬਸੰਤੀ ਛੈ ॥",
      "s": 9
    },
    {
      "t": "ਬੈਰਾਰੀ ਸੋਭਾਵੰਤੀ ਹੈ ॥੩੩੯॥",
      "s": 9
    },
    {
      "t": "ਸੋਰਠਿ ਸਾਰੰਗ ਬੈਰਾਰੀ ਛੈ ॥",
      "s": 9
    },
    {
      "t": "ਪਰਜ ਕਿ ਸੁਧ ਮਲਾਰੀ ਛੈ ॥",
      "s": 9
    },
    {
      "t": "ਹਿੰਡੋਲੀ ਕਾਫੀ ਤੈਲੰਗੀ ॥",
      "s": 9
    },
    {
      "t": "ਭੈਰਵੀ ਦੀਪਕੀ ਸੁਭੰਗੀ ॥੩੪੦॥",
      "s": 9
    },
    {
      "t": "ਸਰਬੇਵੰ ਰਾਗੰ ਨਿਰਬਾਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਲਖਿ ਲੋਭੀ ਆਭਾ ਗਰਬਾਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਜਉ ਕਥਉ ਸੋਭਾ ਸਰਬਾਣੰ ॥",
      "s": 9
    },
    {
      "t": "ਤਉ ਬਾਢੇ ਏਕੰ ਗ੍ਰੰਥਾਣੰ ॥੩੪੧॥",
      "s": 9
    },
    {
      "t": "ਲਖਿ ਤਾਮ ਦਤੰ ਬ੍ਰਤਚਾਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਸਬ ਲਗੇ ਪਾਨੰ ਜਟਧਾਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਤਨ ਮਨ ਭਰਤਾ ਕਰ ਰਸ ਭੀਨਾ ॥",
      "s": 9
    },
    {
      "t": "ਚਵ ਦਸਵੋ ਤਾ ਕੌ ਗੁਰੁ ਕੀਨਾ ॥੩੪੨॥",
      "s": 9
    },
    {
      "t": "ਇਤਿ ਪ੍ਰਿਯ ਭਗਤ ਇਸਤ੍ਰੀ ਚਤੁਰਦਸਵਾ ਗੁਰੂ ਸਮਾਪਤੰ ॥੧੪॥",
      "s": 9
    },
    {
      "t": "ਅਥ ਬਾਨਗਰ ਪੰਧਰਵੋ ਗੁਰੂ ਕਥਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਤੋਟਕ ਛੰਦ ॥",
      "s": 9
    },
    {
      "t": "ਕਰਿ ਚਉਦਸਵੋਂ ਗੁਰੁ ਦਤ ਮੁਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਮਗ ਲਗੀਆ ਪੂਰਤ ਨਾਦ ਧੁਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਭ੍ਰਮ ਪੂਰਬ ਪਛਮ ਉਤ੍ਰ ਦਿਸੰ ॥",
      "s": 9
    },
    {
      "t": "ਤਕਿ ਚਲੀਆ ਦਛਨ ਮੋਨ ਇਸੰ ॥੩੪੩॥",
      "s": 9
    },
    {
      "t": "ਅਵਿਲੋਕਿ ਤਹਾ ਇਕ ਚਿਤ੍ਰ ਪੁਰੰ ॥",
      "s": 9
    },
    {
      "t": "ਜਨੁ ਕ੍ਰਾਤਿ ਦਿਵਾਲਯ ਸਰਬ ਹਰੰ ॥",
      "s": 9
    },
    {
      "t": "ਨਗਰੇਸ ਤਹਾ ਬਹੁ ਮਾਰਿ ਮ੍ਰਿਗੰ ॥",
      "s": 9
    }
  ]
}
