{
  "page": 663,
  "lines": [
    {
      "t": "ਸਬ ਸਿੰਘ ਮ੍ਰਿਗੀਪਤਿ ਘਾਇ ਖਗੰ ॥੩੪੪॥",
      "s": 9
    },
    {
      "t": "ਚਤੁਰੰ ਲਏ ਨ੍ਰਿਪ ਸੰਗਿ ਘਨੀ ॥",
      "s": 9
    },
    {
      "t": "ਥਹਰੰਤ ਧੁਜਾ ਚਮਕੰਤ ਅਨੀ ॥",
      "s": 9
    },
    {
      "t": "ਬਹੁ ਭੂਖਨ ਚੀਰ ਜਰਾਵ ਜਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਤ੍ਰਿਦਸਾਲਯ ਕੀ ਜਨੁ ਕ੍ਰਾਤਿ ਹਰੀ ॥੩੪੫॥",
      "s": 9
    },
    {
      "t": "ਤਹ ਬੈਠ ਹੁਤੋ ਇਕ ਬਾਣਗਰੰ ॥",
      "s": 9
    },
    {
      "t": "ਬਿਨੁ ਪ੍ਰਾਣ ਕਿਧੌ ਨਹੀ ਬੈਨੁਚਰੰ ॥",
      "s": 9
    },
    {
      "t": "ਤਹ ਬਾਜਤ ਬਾਜ ਮ੍ਰਿਦੰਗ ਗਣੰ ॥",
      "s": 9
    },
    {
      "t": "ਡਫ ਢੋਲਕ ਝਾਝ ਮੁਚੰਗ ਭਣੰ ॥੩੪੬॥",
      "s": 9
    },
    {
      "t": "ਦਲ ਨਾਥ ਲਏ ਬਹੁ ਸੰਗਿ ਦਲੰ ॥",
      "s": 9
    },
    {
      "t": "ਜਲ ਬਾਰਿਧ ਜਾਨੁ ਪ੍ਰਲੈ ਉਛਲੰ ॥",
      "s": 9
    },
    {
      "t": "ਹਯ ਹਿੰਸਤ ਚਿੰਸਤ ਗੂੜ ਗਜੰ ॥",
      "s": 9
    },
    {
      "t": "ਗਲ ਗਜਤ ਲਜਤ ਸੁੰਡ ਲਜੰ ॥੩੪੭॥",
      "s": 9
    },
    {
      "t": "ਦ੍ਰੁਮ ਢਾਹਤ ਗਾਹਤ ਗੂੜ ਦਲੰ ॥",
      "s": 9
    },
    {
      "t": "ਕਰ ਖੀਚਤ ਸੀਚਤ ਧਾਰ ਜਲੰ ॥",
      "s": 9
    },
    {
      "t": "ਸੁਖ ਪਾਵਤ ਧਾਵਤ ਪੇਖਿ ਪ੍ਰਭੈ ॥",
      "s": 9
    },
    {
      "t": "ਅਵਲੋਕਿ ਬਿਮੋਹਤ ਰਾਜ ਸੁਭੈ ॥੩੪੮॥",
      "s": 9
    },
    {
      "t": "ਚਪਿ ਡਾਰਤ ਚਾਚਰ ਭਾਨੁ ਸੂਅੰ ॥",
      "s": 9
    },
    {
      "t": "ਸੁਖ ਪਾਵਤ ਦੇਖ ਨਰੇਸ ਭੂਅੰ ॥",
      "s": 9
    },
    {
      "t": "ਗਲ ਗਜਤ ਢੋਲ ਮ੍ਰਿਦੰਗ ਸੁਰੰ ॥",
      "s": 9
    },
    {
      "t": "ਬਹੁ ਬਾਜਤ ਨਾਦ ਨਯੰ ਮੁਰਜੰ ॥੩੪੯॥",
      "s": 9
    },
    {
      "t": "ਕਲਿ ਕਿੰਕਣਿ ਭੂਖਤ ਅੰਗਿ ਬਰੰ ॥",
      "s": 9
    },
    {
      "t": "ਤਨ ਲੇਪਤ ਚੰਦਨ ਚਾਰ ਪ੍ਰਭੰ ॥",
      "s": 9
    },
    {
      "t": "ਮ੍ਰਿਦੁ ਡੋਲਤ ਬੋਲਤ ਬਾਤ ਮੁਖੰ ॥",
      "s": 9
    },
    {
      "t": "ਗ੍ਰਿਹਿ ਆਵਤ ਖੇਲ ਅਖੇਟ ਸੁਖੰ ॥੩੫੦॥",
      "s": 9
    },
    {
      "t": "ਮੁਖ ਪੋਛ ਗੁਲਾਬ ਫੁਲੇਲ ਸੁਭੰ ॥",
      "s": 9
    },
    {
      "t": "ਕਲਿ ਕਜਲ ਸੋਹਤ ਚਾਰੁ ਚਖੰ ॥",
      "s": 9
    },
    {
      "t": "ਮੁਖ ਉਜਲ ਚੰਦ ਸਮਾਨ ਸੁਭੰ ॥",
      "s": 9
    },
    {
      "t": "ਅਵਿਲੋਕਿ ਛਕੇ ਗਣ ਗੰਧ੍ਰਬਿਸੰ ॥੩੫੧॥",
      "s": 9
    },
    {
      "t": "ਸੁਭ ਸੋਭਤ ਹਾਰ ਅਪਾਰ ਉਰੰ ॥",
      "s": 9
    },
    {
      "t": "ਤਿਲਕੰ ਦੁਤਿ ਕੇਸਰ ਚਾਰੁ ਪ੍ਰਭੰ ॥",
      "s": 9
    },
    {
      "t": "ਅਨਸੰਖ ਅਛੂਹਨ ਸੰਗ ਦਲੰ ॥",
      "s": 9
    },
    {
      "t": "ਤਿਹ ਜਾਤ ਭਏ ਸਨ ਸੈਨ ਮਗੰ ॥੩੫੨॥",
      "s": 9
    },
    {
      "t": "ਫਿਰਿ ਆਇ ਗਏ ਤਿਹ ਪੈਂਡ ਮੁਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਕਲਿ ਬਾਜਤ ਸੰਖਨ ਨਾਦ ਧੁਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਅਵਿਲੋਕਿ ਤਹਾ ਇਕ ਬਾਨ ਗਰੰ ॥",
      "s": 9
    },
    {
      "t": "ਸਿਰ ਨੀਚ ਮਨੋ ਲਿਖ ਚਿਤ੍ਰ ਧਰੰ ॥੩੫੩॥",
      "s": 9
    },
    {
      "t": "ਅਵਿਲੋਕ ਰਿਖੀਸਰ ਤੀਰ ਗਰੰ ॥",
      "s": 9
    },
    {
      "t": "ਹਸਿ ਬੈਨ ਸੁ ਭਾਤਿ ਇਮੰ ਉਚਰੰ ॥",
      "s": 9
    },
    {
      "t": "ਕਹੁ ਭੂਪ ਗਏ ਲੀਏ ਸੰਗਿ ਦਲੰ ॥",
      "s": 9
    },
    {
      "t": "ਕਹਿਓ ਸੋ ਨ ਗੁਰੂ ਅਵਿਲੋਕ ਦ੍ਰਿਗੰ ॥੩੫੪॥",
      "s": 9
    },
    {
      "t": "ਚਕਿ ਚਿਤ ਰਹੇ ਅਚਿਤ ਮੁਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਅਨਖੰਡ ਤਪੀ ਨਹੀ ਜੋਗ ਡੁਲੰ ॥",
      "s": 9
    },
    {
      "t": "ਅਨਆਸ ਅਭੰਗ ਉਦਾਸ ਮਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਅਬਿਕਾਰ ਅਪਾਰ ਪ੍ਰਭਾਸ ਸਭੰ ॥੩੫੫॥",
      "s": 9
    },
    {
      "t": "ਅਨਭੰਗ ਪ੍ਰਭਾ ਅਨਖੰਡ ਤਪੰ ॥",
      "s": 9
    },
    {
      "t": "ਅਬਿਕਾਰ ਜਤੀ ਅਨਿਆਸ ਜਪੰ ॥",
      "s": 9
    },
    {
      "t": "ਅਨਖੰਡ ਬ੍ਰਤੰ ਅਨਡੰਡ ਤਨੰ ॥",
      "s": 9
    }
  ]
}
