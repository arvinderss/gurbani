{
  "page": 664,
  "lines": [
    {
      "t": "ਹਠਵੰਤ ਬ੍ਰਤੀ ਰਿਖਿ ਅਤ੍ਰ ਸੂਅੰ ॥੩੫੬॥",
      "s": 9
    },
    {
      "t": "ਅਵਿਲੋਕਿ ਸਰੰ ਕਰਿ ਧਿਆਨ ਜੁਤੰ ॥",
      "s": 9
    },
    {
      "t": "ਰਹਿ ਰੀਝ ਜਟੀ ਹਠਵੰਤ ਬ੍ਰਤੰ ॥",
      "s": 9
    },
    {
      "t": "ਗੁਰੁ ਮਾਨਿਸ ਪੰਚਦਸ੍ਵੋ ਪ੍ਰਬਲੰ ॥",
      "s": 9
    },
    {
      "t": "ਹਠ ਛਾਡਿ ਸਬੈ ਤਿਨ ਪਾਨ ਪਰੰ ॥੩੫੭॥",
      "s": 9
    },
    {
      "t": "ਇਮਿ ਨਾਹ ਸੌ ਜੋ ਨਰ ਨੇਹ ਕਰੈ ॥",
      "s": 9
    },
    {
      "t": "ਭਵ ਧਾਰ ਅਪਾਰਹਿ ਪਾਰ ਪਰੈ ॥",
      "s": 9
    },
    {
      "t": "ਤਨ ਕੇ ਮਨ ਕੇ ਭ੍ਰਮ ਪਾਸਿ ਧਰੇ ॥",
      "s": 9
    },
    {
      "t": "ਕਰਿ ਪੰਦ੍ਰਸਵੋ ਗੁਰੁ ਪਾਨ ਪਰੇ ॥੩੫੮॥",
      "s": 9
    },
    {
      "t": "ਇਤਿ ਪੰਦ੍ਰਸਵ ਗੁਰੂ ਬਾਨਗਰ ਸਮਾਪਤੰ ॥੧੫॥",
      "s": 9
    },
    {
      "t": "ਅਥ ਚਾਵਡਿ ਸੋਰਵੋ ਗੁਰੁ ਕਥਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਤੋਟਕ ਛੰਦ ॥",
      "s": 9
    },
    {
      "t": "ਮੁਖ ਬਿਭੂਤ ਭਗਵੇ ਭੇਸ ਬਰੰ ॥",
      "s": 9
    },
    {
      "t": "ਸੁਭ ਸੋਭਤ ਚੇਲਕ ਸੰਗ ਨਰੰ ॥",
      "s": 9
    },
    {
      "t": "ਗੁਨ ਗਾਵਤ ਗੋਬਿੰਦ ਏਕ ਮੁਖੰ ॥",
      "s": 9
    },
    {
      "t": "ਬਨ ਡੋਲਤ ਆਸ ਉਦਾਸ ਸੁਖੰ ॥੩੫੯॥",
      "s": 9
    },
    {
      "t": "ਸੁਭ ਸੂਰਤਿ ਪੂਰਤ ਨਾਦ ਨਵੰ ॥",
      "s": 9
    },
    {
      "t": "ਅਤਿ ਉਜਲ ਅੰਗ ਬਿਭੂਤ ਰਿਖੰ ॥",
      "s": 9
    },
    {
      "t": "ਨਹੀ ਬੋਲਤ ਡੋਲਤ ਦੇਸ ਦਿਸੰ ॥",
      "s": 9
    },
    {
      "t": "ਗੁਨ ਚਾਰਤ ਧਾਰਤ ਧ੍ਯਾਨ ਹਰੰ ॥੩੬੦॥",
      "s": 9
    },
    {
      "t": "ਅਵਿਲੋਕਯ ਚਾਵੰਡਿ ਚਾਰੁ ਪ੍ਰਭੰ ॥",
      "s": 9
    },
    {
      "t": "ਗ੍ਰਿਹਿ ਜਾਤ ਉਡੀ ਗਹਿ ਮਾਸੁ ਮੁਖੰ ॥",
      "s": 9
    },
    {
      "t": "ਲਖਿ ਕੈ ਪਲ ਚਾਵੰਡਿ ਚਾਰ ਚਲੀ ॥",
      "s": 9
    },
    {
      "t": "ਤਿਹ ਤੇ ਅਤਿ ਪੁਸਟ ਪ੍ਰਮਾਥ ਬਲੀ ॥੩੬੧॥",
      "s": 9
    },
    {
      "t": "ਅਵਿਲੋਕਿਸ ਮਾਸ ਅਕਾਸ ਉਡੀ ॥",
      "s": 9
    },
    {
      "t": "ਅਤਿ ਜੁਧੁ ਤਹੀ ਤਿਹੰ ਸੰਗ ਮੰਡੀ ॥",
      "s": 9
    },
    {
      "t": "ਤਜਿ ਮਾਸੁ ਚੜਾ ਉਡਿ ਆਪ ਚਲੀ ॥",
      "s": 9
    },
    {
      "t": "ਲਹਿ ਕੈ ਚਿਤ ਚਾਵੰਡਿ ਚਾਰ ਬਲੀ ॥੩੬੨॥",
      "s": 9
    },
    {
      "t": "ਅਵਿਲੋਕਿ ਸੁ ਚਾਵੰਡਿ ਚਾਰ ਪਲੰ ॥",
      "s": 9
    },
    {
      "t": "ਤਜਿ ਤ੍ਰਾਸ ਭਾਈ ਥਿਰ ਭੂਮਿ ਥਲੰ ॥",
      "s": 9
    },
    {
      "t": "ਲਖਿ ਤਾਸੁ ਮਨੰ ਮੁਨਿ ਚਉਕ ਰਹ੍ਯੋ ॥",
      "s": 9
    },
    {
      "t": "ਚਿਤ ਸੋਰ੍ਰਹਸਵੇ ਗੁਰੁ ਤਾਸੁ ਕਹ੍ਯੋ ॥੩੬੩॥",
      "s": 9
    },
    {
      "t": "ਕੋਊ ਐਸ ਤਜੈ ਜਬ ਸਰਬ ਧਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਕਰਿ ਕੈ ਬਿਨੁ ਆਸ ਉਦਾਸ ਮਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਤਬ ਪਾਚਉ ਇੰਦ੍ਰੀ ਤਿਆਗ ਰਹੈ ॥",
      "s": 9
    },
    {
      "t": "ਇਨ ਚੀਲਨ ਜਿਉ ਸ੍ਰੁਤ ਐਸ ਕਹੈ ॥੩੬੪॥",
      "s": 9
    },
    {
      "t": "ਇਤਿ ਸੋਰ੍ਰਹਵੋ ਗੁਰੂ ਚਾਵੰਡਿ ਸਮਾਪਤੰ ॥੧੬॥",
      "s": 9
    },
    {
      "t": "ਅਥ ਦੁਧੀਰਾ ਸਤਾਰਵੋ ਗੁਰੂ ਕਥਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਤੋਟਕ ਛੰਦ ॥",
      "s": 9
    },
    {
      "t": "ਕਰਿ ਸੋਰਸਵੋ ਰਿਖਿ ਤਾਸੁ ਗੁਰੰ ॥",
      "s": 9
    },
    {
      "t": "ਉਠਿ ਚਲੀਆ ਬਾਟ ਉਦਾਸ ਚਿਤੰ ॥",
      "s": 9
    },
    {
      "t": "ਮੁਖਿ ਪੂਰਤ ਨਾਦਿ ਨਿਨਾਦ ਧੁਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਸੁਨਿ ਰੀਝਤ ਗੰਧ੍ਰਬ ਦੇਵ ਨਰੰ ॥੩੬੫॥",
      "s": 9
    },
    {
      "t": "ਚਲਿ ਜਾਤ ਭਏ ਸਰਿਤਾ ਨਿਕਟੰ ॥",
      "s": 9
    },
    {
      "t": "ਹਠਵੰਤ ਰਿਖੰ ਤਪਸਾ ਬਿਕਟ ॥",
      "s": 9
    },
    {
      "t": "ਅਵਿਲੋਕ ਦੁਧੀਰਯਾ ਏਕ ਤਹਾ ॥",
      "s": 9
    },
    {
      "t": "ਉਛਰੰਤ ਹੁਤੇ ਨਦਿ ਮਛ ਜਹਾ ॥੩੬੬॥",
      "s": 9
    },
    {
      "t": "ਥਰਕੰਤ ਹੁਤੋ ਇਕ ਚਿਤ ਨਭੰ ॥",
      "s": 9
    }
  ]
}
