{
  "page": 666,
  "lines": [
    {
      "t": "ਘਨ ਮੈ ਜਿਮ ਬਿਦੁਲਤਾ ਝਮਕੈ ॥",
      "s": 9
    },
    {
      "t": "ਰਿਖਿ ਮੋ ਗੁਨ ਤਾਸ ਸਬੈ ਦਮਕੈ ॥੩੭੮॥",
      "s": 9
    },
    {
      "t": "ਜਸ ਛਾਡਤ ਭਾਨੁ ਅਨੰਤ ਛਟਾ ॥",
      "s": 9
    },
    {
      "t": "ਰਿਖਿ ਕੇ ਤਿਮ ਸੋਭਤ ਜੋਗ ਜਟਾ ॥",
      "s": 9
    },
    {
      "t": "ਜਿਨ ਕੀ ਦੁਖ ਫਾਸ ਕਹੂੰ ਨ ਕਟੀ ॥",
      "s": 9
    },
    {
      "t": "ਰਿਖਿ ਭੇਟਤ ਤਾਸੁ ਛਟਾਕ ਛੁਟੀ ॥੩੭੯॥",
      "s": 9
    },
    {
      "t": "ਨਰ ਜੋ ਨਹੀ ਨਰਕਨ ਤੇ ਨਿਵਰੈ ॥",
      "s": 9
    },
    {
      "t": "ਰਿਖਿ ਭੇਟਤ ਤਉਨ ਤਰਾਕ ਤਰੈ ॥",
      "s": 9
    },
    {
      "t": "ਜਿਨ ਕੇ ਸਮਤਾ ਕਹੂੰ ਨਾਹਿ ਠਟੀ ॥",
      "s": 9
    },
    {
      "t": "ਰਿਖਿ ਪੂਜਿ ਘਟੀ ਸਬ ਪਾਪ ਘਟੀ ॥੩੮੦॥",
      "s": 9
    },
    {
      "t": "ਇਤ ਬਧਿ ਤਉਨ ਬਿਠੋ ਮ੍ਰਿਗਹਾ ॥",
      "s": 9
    },
    {
      "t": "ਜਸ ਹੇਰਤ ਛੇਰਿਨਿ ਭੀਮ ਭਿਡਹਾ ॥",
      "s": 9
    },
    {
      "t": "ਤਿਹ ਜਾਨ ਰਿਖੀਨ ਹੀ ਸਾਸ ਸਸ੍ਰਯੋ ॥",
      "s": 9
    },
    {
      "t": "ਮ੍ਰਿਗ ਜਾਨ ਮੁਨੀ ਕਹੁ ਬਾਨ ਕਸ੍ਰਯੋ ॥੩੮੧॥",
      "s": 9
    },
    {
      "t": "ਸਰ ਪੇਖ ਸਬੈ ਤਿਹ ਸਾਧ ਕਹੈ ॥",
      "s": 9
    },
    {
      "t": "ਮ੍ਰਿਗ ਹੋਇ ਨ ਰੇ ਮੁਨਿ ਰਾਜ ਇਹੈ ॥",
      "v": [
        [
          3,
          1
        ]
      ],
      "s": 9
    },
    {
      "t": "ਨਹ ਬਾਨ ਸਰਾਸਨ ਪਾਨ ਤਜੇ ॥",
      "s": 9
    },
    {
      "t": "ਅਸ ਦੇਖਿ ਦ੍ਰਿੜੰ ਮੁਨਿ ਰਾਜ ਲਜੇ ॥੩੮੨॥",
      "s": 9
    },
    {
      "t": "ਬਹੁਤੇ ਚਿਰ ਜਿਉ ਤਿਹ ਧ੍ਯਾਨ ਛੁਟਾ ॥",
      "s": 9
    },
    {
      "t": "ਅਵਿਲੋਕ ਧਰੇ ਰਿਖਿ ਪਾਲ ਜਟਾ ॥",
      "s": 9
    },
    {
      "t": "ਕਸ ਆਵਤ ਹੋ ਡਰੁ ਡਾਰਿ ਅਬੈ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 9
    },
    {
      "t": "ਮੁਹਿ ਲਾਗਤ ਹੋ ਮ੍ਰਿਗ ਰੂਪ ਸਬੈ ॥੩੮੩॥",
      "s": 9
    },
    {
      "t": "ਰਿਖ ਪਾਲ ਬਿਲੋਕਿ ਤਿਸੈ ਦਿੜਤਾ ॥",
      "s": 9
    },
    {
      "t": "ਗੁਰੁ ਮਾਨ ਕਰੀ ਬਹੁਤੈ ਉਪਮਾ ॥",
      "s": 9
    },
    {
      "t": "ਮ੍ਰਿਗ ਸੋ ਜਿਹ ਕੋ ਚਿਤ ਐਸ ਲਗ੍ਯੋ ॥",
      "s": 9
    },
    {
      "t": "ਪਰਮੇਸਰ ਕੈ ਰਸ ਜਾਨ ਪਗ੍ਰਯੋ ॥੩੮੪॥",
      "s": 9
    },
    {
      "t": "ਮੁਨ ਕੋ ਤਬ ਪ੍ਰੇਮ ਪ੍ਰਸੀਜ ਹੀਆ ॥",
      "s": 9
    },
    {
      "t": "ਗੁਰ ਠਾਰਸਮੋ ਮ੍ਰਿਗ ਨਾਸ ਕੀਆ ॥",
      "s": 9
    },
    {
      "t": "ਮਨ ਮੋ ਤਬ ਦਤ ਬੀਚਾਰ ਕੀਆ ॥",
      "s": 9
    },
    {
      "t": "ਗੁਨ ਮ੍ਰਿਗਹਾ ਕੋ ਚਿਤ ਬੀਚ ਲੀਆ ॥੩੮੫॥",
      "s": 9
    },
    {
      "t": "ਹਰਿ ਸੋ ਹਿਤੁ ਜੋ ਇਹ ਭਾਤਿ ਕਰੈ ॥",
      "s": 9
    },
    {
      "t": "ਭਵ ਭਾਰ ਅਪਾਰਹ ਪਾਰ ਪਰੈ ॥",
      "s": 9
    },
    {
      "t": "ਮਲ ਅੰਤਰਿ ਯਾਹੀ ਇਸਨਾਨ ਕਟੈ ॥",
      "s": 9
    },
    {
      "t": "ਜਗ ਤੇ ਫਿਰਿ ਆਵਨ ਜਾਨ ਮਿਟੈ ॥੩੮੬॥",
      "s": 9
    },
    {
      "t": "ਗੁਰੁ ਜਾਨ ਤਬੈ ਤਿਹ ਪਾਇ ਪਰਾ ॥",
      "s": 9
    },
    {
      "t": "ਭਵ ਭਾਰ ਅਪਾਰ ਸੁ ਪਾਰ ਤਰਾ ॥",
      "s": 9
    },
    {
      "t": "ਦਸ ਅਸਟਸਮੋ ਗੁਰੁ ਤਾਸੁ ਕੀਯੋ ॥",
      "s": 9
    },
    {
      "t": "ਕਬਿ ਬਾਧਿ ਕਬਿਤਨ ਮਧਿ ਲੀਯੋ ॥੩੮੭॥",
      "s": 9
    },
    {
      "t": "ਸਬ ਹੀ ਸਿਖ ਸੰਜੁਤਿ ਪਾਨ ਗਹੇ ॥",
      "s": 9
    },
    {
      "t": "ਅਵਿਲੋਕਿ ਚਰਾਚਰਿ ਚਉਧ ਰਹੇ ॥",
      "s": 9
    },
    {
      "t": "ਪਸੁ ਪਛ ਚਰਾਚਰ ਜੀਵ ਸਬੈ ॥",
      "s": 9
    },
    {
      "t": "ਗਣ ਗੰਧ੍ਰਬ ਭੂਤ ਪਿਸਾਚ ਤਬੈ ॥੩੮੮॥",
      "s": 9
    },
    {
      "t": "ਇਤਿ ਅਠਦਸਵੋ ਗੁਰੂ ਮ੍ਰਿਗਹਾ ਸਮਾਪਤੰ ॥੧੮॥",
      "s": 9
    },
    {
      "t": "ਅਥ ਨਲਨੀ ਸੁਕ ਉਨੀਵੋ ਗੁਰੂ ਕਥਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਕ੍ਰਿਪਾਣ ਕ੍ਰਿਤ ਛੰਦ ॥",
      "s": 9
    },
    {
      "t": "ਮੁਨਿ ਅਤਿ ਅਪਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਗੁਣ ਗਣ ਉਦਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਬਿਦਿਆ ਬਿਚਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਨਿਤ ਕਰਤ ਚਾਰ ॥੩੮੯॥",
      "s": 9
    },
    {
      "t": "ਲਖਿ ਛਬਿ ਸੁਰੰਗ ॥",
      "s": 9
    },
    {
      "t": "ਲਾਜਤ ਅਨੰਗ ॥",
      "s": 9
    },
    {
      "t": "ਪਿਖਿ ਬਿਮਲ ਅੰਗ ॥",
      "s": 9
    },
    {
      "t": "ਚਕਿ ਰਹਤ ਗੰਗ ॥੩੯੦॥",
      "s": 9
    },
    {
      "t": "ਲਖਿ ਦੁਤਿ ਅਪਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਰੀਝਤ ਕੁਮਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਗ੍ਯਾਨੀ ਅਪਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਗੁਨ ਗਨ ਉਦਾਰ ॥੩੯੧॥",
      "s": 9
    },
    {
      "t": "ਅਬਯਕਤ ਅੰਗ ॥",
      "s": 9
    },
    {
      "t": "ਆਭਾ ਅਭੰਗ ॥",
      "s": 9
    },
    {
      "t": "ਸੋਭਾ ਸੁਰੰਗ ॥",
      "s": 9
    },
    {
      "t": "ਤਨ ਜਨੁ ਅਨੰਗ ॥੩੯੨॥",
      "s": 9
    },
    {
      "t": "ਬਹੁ ਕਰਤ ਨ੍ਯਾਸ ॥",
      "s": 9
    },
    {
      "t": "ਨਿਸਿ ਦਿਨ ਉਦਾਸ ॥",
      "s": 9
    },
    {
      "t": "ਤਜਿ ਸਰਬ ਆਸ ॥",
      "s": 9
    },
    {
      "t": "ਅਤਿ ਬੁਧਿ ਪ੍ਰਕਾਸ ॥੩੯੩॥",
      "s": 9
    },
    {
      "t": "ਤਨਿ ਸਹਤ ਧੂਪ ॥",
      "s": 9
    },
    {
      "t": "ਸੰਨ੍ਯਾਸ ਭੂਪ ॥",
      "s": 9
    },
    {
      "t": "ਤਨਿ ਛਬਿ ਅਨੂਪ ॥",
      "s": 9
    },
    {
      "t": "ਜਨੁ ਸਿਵ ਸਰੂਪ ॥੩੯੪॥",
      "s": 9
    },
    {
      "t": "ਮੁਖ ਛਬਿ ਪ੍ਰਚੰਡ ॥",
      "s": 9
    },
    {
      "t": "ਆਭਾ ਅਭੰਗ ॥",
      "s": 9
    },
    {
      "t": "ਜੁਟਿ ਜੋਗ ਜੰਗ ॥",
      "s": 9
    }
  ]
}
