{
  "page": 670,
  "lines": [
    {
      "t": "ਗ੍ਰਿਹਿਤੰ ਬਾਮੰ ॥",
      "s": 9
    },
    {
      "t": "ਭ੍ਰਮਤੰ ਮੋਹੰ ॥",
      "s": 9
    },
    {
      "t": "ਮਮਤੰ ਮੋਹੰ ॥੪੩੧॥",
      "s": 9
    },
    {
      "t": "ਮਮਤਾ ਬੁਧੰ ॥",
      "s": 9
    },
    {
      "t": "ਸ੍ਰਿਹਤੰ ਲੋਗੰ ॥",
      "s": 9
    },
    {
      "t": "ਅਹਿਤਾ ਧਰਮੰ ॥",
      "s": 9
    },
    {
      "t": "ਲਹਿਤਹ ਭੋਗੰ ॥੪੩੨॥",
      "s": 9
    },
    {
      "t": "ਗ੍ਰਿਸਤੰ ਬੁਧੰ ॥",
      "s": 9
    },
    {
      "t": "ਮਮਤਾ ਮਾਤੰ ॥",
      "s": 9
    },
    {
      "t": "ਇਸਤ੍ਰੀ ਨੇਹੰ ॥",
      "s": 9
    },
    {
      "t": "ਪੁਤ੍ਰੰ ਭ੍ਰਾਤੰ ॥੪੩੩॥",
      "s": 9
    },
    {
      "t": "ਗ੍ਰਸਤੰ ਮੋਹੰ ॥",
      "s": 9
    },
    {
      "t": "ਧਰਿਤੰ ਕਾਮੰ ॥",
      "s": 9
    },
    {
      "t": "ਜਲਤੰ ਕ੍ਰੋਧੰ ॥",
      "s": 9
    },
    {
      "t": "ਪਲਿਤੰ ਦਾਮੰ ॥੪੩੪॥",
      "s": 9
    },
    {
      "t": "ਦਲਤੰ ਬਿਯੋਧੰ ॥",
      "s": 9
    },
    {
      "t": "ਤਕਿਤੰ ਦਾਵੰ ॥",
      "s": 9
    },
    {
      "t": "ਅੰਤਹ ਨਰਕੰ ॥",
      "s": 9
    },
    {
      "t": "ਗੰਤਹ ਪਾਵੰ ॥੪੩੫॥",
      "s": 9
    },
    {
      "t": "ਤਜਿਤੰ ਸਰਬੰ ॥",
      "s": 9
    },
    {
      "t": "ਗ੍ਰਹਿਤੰ ਏਕੰ ॥",
      "s": 9
    },
    {
      "t": "ਪ੍ਰਭਤੰ ਭਾਵੰ ॥",
      "s": 9
    },
    {
      "t": "ਤਜਿਤੰ ਦ੍ਵੈਖੰ ॥੪੩੬॥",
      "s": 9
    },
    {
      "t": "ਨਲਿਨੀ ਸੁਕਿ ਜਯੰ ॥",
      "s": 9
    },
    {
      "t": "ਤਜਿਤੰ ਦਿਰਬੰ ॥",
      "s": 9
    },
    {
      "t": "ਸਫਲੀ ਕਰਮੰ ॥",
      "s": 9
    },
    {
      "t": "ਲਹਿਤੰ ਸਰਬੰ ॥੪੩੭॥",
      "s": 9
    },
    {
      "t": "ਇਤਿ ਨਲਿਨੀ ਸੁਕ ਉਨੀਸਵੋ ਗੁਰੂ ਬਰਨਨੰ ॥੧੯॥",
      "s": 9
    },
    {
      "t": "ਅਥ ਸਾਹ ਬੀਸਵੋ ਗੁਰੁ ਕਥਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 9
    },
    {
      "t": "ਆਗੇ ਚਲਾ ਦਤ ਜਟ ਧਾਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਬੇਜਤ ਬੇਣ ਬਿਖਾਨ ਅਪਾਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਅਸਥਾਵਰ ਲਖਿ ਚੇਤਨ ਭਏ ॥",
      "s": 9
    },
    {
      "t": "ਚੇਤਨ ਦੇਖ ਚਕ੍ਰਿਤ ਹ੍ਵੈ ਗਏ ॥੪੩੮॥",
      "s": 9
    },
    {
      "t": "ਮਹਾ ਰੂਪ ਕਛੁ ਕਹਾ ਨ ਜਾਈ ॥",
      "s": 9
    },
    {
      "t": "ਨਿਰਖਿ ਚਕ੍ਰਿਤ ਰਹੀ ਸਕਲ ਲੁਕਾਈ ॥",
      "s": 9
    },
    {
      "t": "ਜਿਤ ਜਿਤ ਜਾਤ ਪਥਹਿ ਰਿਖਿ ਗ੍ਯੋ ॥",
      "s": 9
    },
    {
      "t": "ਜਾਨੁਕ ਪ੍ਰੇਮ ਮੇਘ ਬਰਖ੍ਰਯੋ ॥੪੩੯॥",
      "s": 9
    },
    {
      "t": "ਤਹ ਇਕ ਲਖਾ ਸਾਹ ਧਨਵਾਨਾ ॥",
      "s": 9
    },
    {
      "t": "ਮਹਾ ਰੂਪ ਧਰਿ ਦਿਰਬ ਨਿਧਾਨਾ ॥",
      "s": 9
    },
    {
      "t": "ਮਹਾ ਜੋਤਿ ਅਰੁ ਤੇਜ ਅਪਾਰੂ ॥",
      "s": 9
    },
    {
      "t": "ਆਪ ਘੜਾ ਜਾਨੁਕ ਮੁਖਿ ਚਾਰੂ ॥੪੪੦॥",
      "s": 9
    },
    {
      "t": "ਬਿਕ੍ਰਿਅ ਬੀਚ ਅਧਿਕ ਸਵਧਾਨਾ ॥",
      "s": 9
    },
    {
      "t": "ਬਿਨੁ ਬਿਪਾਰ ਜਿਨ ਅਉਰ ਨ ਜਾਨਾ ॥",
      "s": 9
    },
    {
      "t": "ਆਸ ਅਨੁਰਕਤ ਤਾਸੁ ਬ੍ਰਿਤ ਲਾਗਾ ॥",
      "s": 9
    },
    {
      "t": "ਮਾਨਹੁ ਮਹਾ ਜੋਗ ਅਨੁਰਾਗਾ ॥੪੪੧॥",
      "s": 9
    },
    {
      "t": "ਤਹਾ ਰਿਖਿ ਗਏ ਸੰਗਿ ਸੰਨ੍ਯਾਸਨ ॥",
      "s": 9
    },
    {
      "t": "ਕਈ ਛੋਹਨੀ ਜਾਤ ਨਹੀ ਗਨਿ ॥",
      "s": 9
    }
  ]
}
