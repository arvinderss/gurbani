{
  "page": 673,
  "lines": [
    {
      "t": "ਸੰਗੀਤ ਕਰਤ ਬਿਚਾਰ ॥੪੬੮॥",
      "s": 9
    },
    {
      "t": "ਦੁਤਿ ਮਾਨ ਰੂਪ ਅਪਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਗੁਣਵੰਤ ਸੀਲ ਉਦਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਸੁਖ ਸਿੰਧੁ ਰਾਗ ਨਿਧਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਹਰਿ ਲੇਤ ਹੇਰਤਿ ਪ੍ਰਾਨ ॥੪੬੯॥",
      "s": 9
    },
    {
      "t": "ਅਕਲੰਕ ਜੁਬਨ ਮਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਸੁਖ ਸਿੰਧੁ ਸੁੰਦਰਿ ਥਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਇਕ ਚਿਤ ਗਾਵਤ ਰਾਗ ॥",
      "s": 9
    },
    {
      "t": "ਉਫਟੰਤ ਜਾਨੁ ਸੁਹਾਗ ॥੪੭੦॥",
      "s": 9
    },
    {
      "t": "ਤਿਹ ਪੇਖ ਕੈ ਜਟਿ ਰਾਜ ॥",
      "s": 9
    },
    {
      "t": "ਸੰਗ ਲੀਨ ਜੋਗ ਸਮਾਜ ॥",
      "s": 9
    },
    {
      "t": "ਰਹਿ ਰੀਝ ਆਪਨ ਚਿਤ ॥",
      "s": 9
    },
    {
      "t": "ਜੁਗ ਰਾਜ ਜੋਗ ਪਵਿਤ ॥੪੭੧॥",
      "s": 9
    },
    {
      "t": "ਇਹ ਭਾਤਿ ਜੋ ਹਰਿ ਸੰਗ ॥",
      "s": 9
    },
    {
      "t": "ਹਿਤ ਕੀਜੀਐ ਅਨਭੰਗ ॥",
      "s": 9
    },
    {
      "t": "ਤਬ ਪਾਈਐ ਹਰਿ ਲੋਕ ॥",
      "s": 9
    },
    {
      "t": "ਇਹ ਬਾਤ ਮੈ ਨਹੀ ਸੋਕ ॥੪੭੨॥",
      "s": 9
    },
    {
      "t": "ਚਿਤ ਚਉਪ ਸੋ ਭਰ ਚਾਇ ॥",
      "s": 9
    },
    {
      "t": "ਗੁਰ ਜਾਨਿ ਕੈ ਪਰਿ ਪਾਇ ॥",
      "s": 9
    },
    {
      "t": "ਚਿਤ ਤਊਨ ਕੇ ਰਸ ਭੀਨ ॥",
      "s": 9
    },
    {
      "t": "ਗੁਰੁ ਤੇਈਸਵੋ ਤਿਹ ਕੀਨ ॥੪੭੩॥",
      "s": 9
    },
    {
      "t": "ਇਤਿ ਜਛਣੀ ਨਾਰਿ ਰਾਗ ਗਾਵਤੀ ਗੁਰੂ ਤੇਈਸਵੋ ਸਮਾਪਤੰ ॥੨੩॥",
      "s": 9
    },
    {
      "t": "ਤੋਮਰ ਛੰਦ ॥",
      "s": 9
    },
    {
      "t": "ਤਬ ਬਹੁਤ ਬਰਖ ਪ੍ਰਮਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਚੜਿ ਮੇਰ ਸ੍ਰਿੰਗ ਮਹਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਕੀਅ ਘੋਰ ਤਪਸਾ ਉਗ੍ਰ ॥",
      "s": 9
    },
    {
      "t": "ਤਬ ਰੀਝਏ ਕਛੁ ਸੁਗ੍ਰ ॥੪੭੪॥",
      "s": 9
    },
    {
      "t": "ਜਗ ਦੇਖ ਕੇ ਬਿਵਹਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਮੁਨਿ ਰਾਜ ਕੀਨ ਬਿਚਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਇਨ ਕਉਨ ਸੋ ਉਪਜਾਇ ॥",
      "s": 9
    },
    {
      "t": "ਫਿਰਿ ਲੇਤਿ ਆਪਿ ਮਿਲਾਇ ॥੪੭੫॥",
      "s": 9
    },
    {
      "t": "ਤਿਹ ਚੀਨੀਐ ਕਰਿ ਗਿਆਨ ॥",
      "s": 9
    },
    {
      "t": "ਤਬ ਹੋਇ ਪੂਰਣ ਧ੍ਯਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਤਿਹ ਜਾਣੀਐ ਜਤ ਜੋਗ ॥",
      "s": 9
    },
    {
      "t": "ਤਬ ਹੋਇ ਦੇਹ ਅਰੋਗ ॥੪੭੬॥",
      "s": 9
    },
    {
      "t": "ਤਬ ਏਕ ਪੁਰਖ ਪਛਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਜਗ ਨਾਸ ਜਾਹਿਨ ਜਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਸਬ ਜਗਤ ਕੋ ਪਤਿ ਦੇਖਿ ॥",
      "s": 9
    },
    {
      "t": "ਅਨਭਉ ਅਨੰਤ ਅਭੇਖ ॥੪੭੭॥",
      "s": 9
    },
    {
      "t": "ਬਿਨ ਏਕ ਨਾਹਿਨ ਸਾਤਿ ॥",
      "s": 9
    },
    {
      "t": "ਸਭ ਤੀਰਥ ਕਿਯੁੰ ਨ ਅਨਾਤ ॥",
      "s": 9
    },
    {
      "t": "ਜਬ ਸੇਵਿਹੋ ਇਕਿ ਨਾਮ ॥",
      "s": 9
    },
    {
      "t": "ਤਬ ਹੋਇ ਪੂਰਣ ਕਾਮ ॥੪੭੮॥",
      "s": 9
    },
    {
      "t": "ਬਿਨੁ ਏਕ ਚੌਬਿਸ ਫੋਕ ॥",
      "s": 9
    },
    {
      "t": "ਸਬ ਹੀ ਧਰਾ ਸਬ ਲੋਕ ॥",
      "s": 9
    },
    {
      "t": "ਜਿਨਿ ਏਕ ਕਉ ਪਹਿਚਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਤਿਨ ਚਉਬਿਸੋ ਰਸ ਮਾਨ ॥੪੭੯॥",
      "s": 9
    },
    {
      "t": "ਜੇ ਏਕ ਕੇ ਰਸ ਭੀਨ ॥",
      "s": 9
    },
    {
      "t": "ਤਿਨਿ ਚਉਬਿਸੋ ਰਸਿ ਲੀਨ ॥",
      "s": 9
    },
    {
      "t": "ਜਿਨ ਏਕ ਕੋ ਨਹੀ ਬੂਝ ॥",
      "s": 9
    },
    {
      "t": "ਤਿਹ ਚਉਬਿਸੈ ਨਹੀ ਸੂਝ ॥੪੮੦॥",
      "s": 9
    },
    {
      "t": "ਜਿਨਿ ਏਕ ਕੌ ਨਹੀ ਚੀਨ ॥",
      "s": 9
    }
  ]
}
