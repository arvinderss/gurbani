{
  "page": 679,
  "lines": [
    {
      "t": "ਮਤ ਦੇਸ ਦੇਸ ਰਾਜਾ ਕਰੋਰ ॥",
      "s": 9
    },
    {
      "t": "ਦੇ ਹੀਰ ਚੀਰ ਬਹੁ ਦਿਰਬ ਸਾਜ ॥",
      "s": 9
    },
    {
      "t": "ਸਨਮਾਨ ਦਾਨ ਬਹੁ ਭਾਤਿ ਰਾਜ ॥੪੦॥",
      "s": 9
    },
    {
      "t": "ਅਨਭੈ ਅਭੰਗ ਅਵਧੂਤ ਛਤ੍ਰ ॥",
      "s": 9
    },
    {
      "t": "ਅਨਜੀਤ ਜੁਧ ਬੇਤਾ ਅਤਿ ਅਤ੍ਰ ॥",
      "s": 9
    },
    {
      "t": "ਅਨਗੰਜ ਸੂਰ ਅਬਿਚਲ ਜੁਝਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਰਣ ਰੰਗ ਅਭੰਗ ਜਿਤੇ ਹਜਾਰ ॥੪੧॥",
      "s": 9
    },
    {
      "t": "ਸਬ ਦੇਸ ਦੇਸ ਕੇ ਜੀਤ ਰਾਵ ॥",
      "s": 9
    },
    {
      "t": "ਕਰ ਕ੍ਰੁਧ ਜੁਧ ਨਾਨਾ ਉਪਾਵ ॥",
      "s": 9
    },
    {
      "t": "ਕੈ ਸਾਮ ਦਾਮ ਅਰੁ ਦੰਡ ਭੇਦ ॥",
      "s": 9
    },
    {
      "t": "ਅਵਨੀਪ ਸਰਬ ਜੋਰੇ ਅਛੇਦ ॥੪੨॥",
      "s": 9
    },
    {
      "t": "ਜਬ ਸਰਬ ਭੂਪ ਜੋਰੇ ਮਹਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਜੈ ਜੀਤ ਪਤ੍ਰ ਦਿਨੋ ਨਿਸਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਦੈ ਹੀਰ ਚੀਰ ਅਨਭੰਗ ਦਿਰਬ ॥",
      "s": 9
    },
    {
      "t": "ਮਹਿਪਾਲ ਮੋਹਿ ਡਾਰੇ ਸੁ ਸਰਬ ॥੪੩॥",
      "s": 9
    },
    {
      "t": "ਇਕ ਦਯੋਸ ਬੀਤ ਪਾਰਸ੍ਵ ਰਾਇ ॥",
      "s": 9
    },
    {
      "t": "ਉਤਿਸਟ ਦੇਵਿ ਪੂਜੰਤ ਜਾਇ ॥",
      "s": 9
    },
    {
      "t": "ਉਸਤਤਿ ਕਿਨ ਬਹੁ ਬਿਧਿ ਪ੍ਰਕਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਸੋ ਕਹੋ ਛੰਦ ਮੋਹਣਿ ਮਝਾਰ ॥੪੪॥",
      "s": 9
    },
    {
      "t": "ਮੋਹਣੀ ਛੰਦ ॥",
      "s": 9
    },
    {
      "t": "ਜੈ ਦੇਵੀ ਭੇਵੀ ਭਾਵਾਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਭਉ ਖੰਡੀ ਦੁਰਗਾ ਸਰਬਾਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਕੇਸਰੀਆ ਬਾਹੀ ਕਊਮਾਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਭੈਖੰਡੀ ਭੈਰਵਿ ਉਧਾਰੀ ॥੪੫॥",
      "s": 9
    },
    {
      "t": "ਅਕਲੰਕਾ ਅਤ੍ਰੀ ਛਤ੍ਰਾਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਮੋਹਣੀਅੰ ਸਰਬੰ ਲੋਕਾਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਰਕਤਾਗੀ ਸਾਗੀ ਸਾਵਿਤ੍ਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਪਰਮੇਸ੍ਰੀ ਪਰਮਾ ਪਾਵਿਤ੍ਰੀ ॥੪੬॥",
      "s": 9
    },
    {
      "t": "ਤੋਤਲੀਆ ਜਿਹਬਾ ਕਊਮਾਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਭਵ ਭਰਣੀ ਹਰਣੀ ਉਧਾਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਮ੍ਰਿਦੁ ਰੂਪਾ ਭੂਪਾ ਬੁਧਾਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਜੈ ਜੰਪੈ ਸੁਧੰ ਸਿਧਾਣੀ ॥੪੭॥",
      "s": 9
    },
    {
      "t": "ਜਗ ਧਾਰੀ ਭਾਰੀ ਭਗਤਾਯੰ ॥",
      "s": 9
    },
    {
      "t": "ਕਰਿ ਧਾਰੀ ਭਾਰੀ ਮੁਕਤਾਯੰ ॥",
      "s": 9
    },
    {
      "t": "ਸੁੰਦਰ ਗੋਫਣੀਆ ਗੁਰਜਾਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਤੇ ਬਰਣੀ ਹਰਣੀ ਭਾਮਾਣੀ ॥੪੮॥",
      "s": 9
    },
    {
      "t": "ਭਿੰਭਰੀਆ ਜਛੰ ਸਰਬਾਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਗੰਧਰਬੀ ਸਿਧੰ ਚਾਰਾਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਅਕਲੰਕ ਸਰੂਪੰ ਨਿਰਮਲੀਅੰ ॥",
      "s": 9
    },
    {
      "t": "ਘਣ ਮਧੇ ਮਾਨੋ ਚੰਚਲੀਅੰ ॥੪੯॥",
      "s": 9
    },
    {
      "t": "ਅਸਿਪਾਣੰ ਮਾਣੰ ਲੋਕਾਯੰ ॥",
      "s": 9
    },
    {
      "t": "ਸੁਖ ਕਰਣੀ ਹਰਣੀ ਸੋਕਾਯੰ ॥",
      "s": 9
    },
    {
      "t": "ਦੁਸਟ ਹੰਤੀ ਸੰਤੰ ਉਧਾਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਅਨਛੇਦਾਭੇਦਾ ਕਉਮਾਰੀ ॥੫੦॥",
      "s": 9
    },
    {
      "t": "ਆਨੰਦੀ ਗਿਰਜਾ ਕਉਮਾਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਅਨਛੇਦਾਭੇਦਾ ਉਧਾਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਅਨਗੰਜ ਅਭੰਜਾ ਖੰਕਾਲੀ ॥",
      "s": 9
    },
    {
      "t": "ਮ੍ਰਿਗਨੈਣੀ ਰੂਪੰ ਉਜਾਲੀ ॥੫੧॥",
      "s": 9
    },
    {
      "t": "ਰਕਤਾਗੀ ਰੁਦ੍ਰਾ ਪਿੰਗਾਛੀ ॥",
      "s": 9
    },
    {
      "t": "ਕਟਿ ਕਛੀ ਸ੍ਵਛੀ ਹੁਲਾਸੀ ॥",
      "s": 9
    },
    {
      "t": "ਰਕਤਾਲੀ ਰਾਮਾ ਧਉਲਾਲੀ ॥",
      "s": 9
    },
    {
      "t": "ਮੋਹਣੀਆ ਮਾਈ ਖੰਕਾਲੀ ॥੫੨॥",
      "s": 9
    },
    {
      "t": "ਜਗਦਾਨੀ ਮਾਨੀ ਭਾਵਾਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਭਵਖੰਡੀ ਦੁਰਗਾ ਦੇਵਾਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਰੁਦ੍ਰਾਗੀ ਰੁਦ੍ਰਾ ਰਕਤਾਗੀ ॥",
      "s": 9
    },
    {
      "t": "ਪਰਮੇਸਰੀ ਮਾਈ ਧਰਮਾਗੀ ॥੫੩॥",
      "s": 9
    },
    {
      "t": "ਮਹਿਖਾਸੁਰ ਦਰਣੀ ਮਹਿਪਾਲੀ ॥",
      "s": 9
    },
    {
      "t": "ਚਿਛੁਰਾਸਰ ਹੰਤੀ ਖੰਕਾਲੀ ॥",
      "s": 9
    },
    {
      "t": "ਅਸਿ ਪਾਣੀ ਮਾਣੀ ਦੇਵਾਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਜੈ ਦਾਤੀ ਦੁਰਗਾ ਭਾਵਾਣੀ ॥੫੪॥",
      "s": 9
    },
    {
      "t": "ਪਿੰਗਾਛੀ ਪਰਮਾ ਪਾਵਿਤ੍ਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਸਾਵਿਤ੍ਰੀ ਸੰਧਿਆ ਗਾਇਤ੍ਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਭੈ ਹਰਣੀ ਭੀਮਾ ਭਾਮਾਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਜੈ ਦੇਵੀ ਦੁਰਗਾ ਦੇਵਾਣੀ ॥੫੫॥",
      "s": 9
    },
    {
      "t": "ਦੁਰਗਾ ਦਲ ਗਾਹੀ ਦੇਵਾਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਭੈ ਖੰਡੀ ਸਰਬੰ ਭੂਤਾਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਜੈ ਚੰਡੀ ਮੁੰਡੀ ਸਤ੍ਰੁ ਹੰਤੀ ॥",
      "s": 9
    },
    {
      "t": "ਜੈ ਦਾਤੀ ਮਾਤਾ ਜੈਅੰਤੀ ॥੫੬॥",
      "s": 9
    },
    {
      "t": "ਸੰਸਰਣੀ ਤਰਾਣੀ ਲੋਕਾਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਭਿੰਭਰਾਣੀ ਦਰਣੀ ਦਈਤਾਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਕੇਕਰਣੀ ਕਾਰਣ ਲੋਕਾਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਦੁਖ ਹਰਣੀ ਦੇਵੰ ਇੰਦ੍ਰਾਣੀ ॥੫੭॥",
      "s": 9
    }
  ]
}
