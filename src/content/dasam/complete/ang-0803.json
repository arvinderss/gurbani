{
  "page": 803,
  "lines": [
    {
      "t": "ਦੇਵ ਸਬਦ ਕਹੁ ਆਦਿ ਬਖਾਨਹੁ ॥",
      "s": 13
    },
    {
      "t": "ਨ੍ਰਿਪ ਪਦ ਤੀਨ ਬਾਰ ਪੁਨਿ ਠਾਨਹੁ ॥",
      "s": 13
    },
    {
      "t": "ਸਤ੍ਰੁ ਸਬਦ ਕੋ ਬਹੁਰਿ ਭਣਿਜੈ ॥",
      "s": 13
    },
    {
      "t": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਕਲ ਲਹਿਜੈ ॥੧੨੫੭॥",
      "s": 13
    },
    {
      "t": "ਅਮਰ ਸਬਦ ਕਹੁ ਆਦਿ ਉਚਾਰਹੁ ॥",
      "s": 13
    },
    {
      "t": "ਨ੍ਰਿਪ ਪਦ ਤੀਨ ਬਾਰ ਪੁਨਿ ਡਾਰਹੁ ॥",
      "s": 13
    },
    {
      "t": "ਅਰਿ ਕਹਿ ਨਾਮ ਤੁਪਕ ਕੇ ਲੀਜੈ ॥",
      "s": 13
    },
    {
      "t": "ਕਬਿਤ ਕਾਬਿ ਕੇ ਭੀਤਰ ਦੀਜੈ ॥੧੨੫੮॥",
      "s": 13
    },
    {
      "t": "ਨ੍ਰਿਜਰ ਸਬਦ ਕੋ ਆਦਿ ਉਚਰੀਐ ॥",
      "s": 13
    },
    {
      "t": "ਨ੍ਰਿਪ ਪਦ ਤੀਨ ਬਾਰ ਪੁਨਿ ਧਰੀਐ ॥",
      "s": 13
    },
    {
      "t": "ਅਰਿ ਕਹਿ ਨਾਮ ਤੁਪਕ ਕੇ ਜਾਨਹੁ ॥",
      "s": 13
    },
    {
      "t": "ਸੰਕ ਛਾਡਿ ਨਿਰਸੰਕ ਬਖਾਨਹੁ ॥੧੨੫੯॥",
      "s": 13
    },
    {
      "t": "ਬਿਬੁਧ ਸਬਦ ਕੋ ਆਦਿ ਭਣੀਜੈ ॥",
      "s": 13
    },
    {
      "t": "ਤੀਨ ਬਾਰ ਨ੍ਰਿਪ ਸਬਦ ਧਰੀਜੈ ॥",
      "s": 13
    },
    {
      "t": "ਰਿਪੁ ਕਹਿ ਨਾਮ ਤੁਪਕ ਕੇ ਲਹੀਅਹਿ ॥",
      "s": 13
    },
    {
      "t": "ਸੰਕਾ ਤਿਆਗਿ ਸਭਾ ਮੈ ਕਹੀਅਹਿ ॥੧੨੬੦॥",
      "s": 13
    },
    {
      "t": "ਸੁਰ ਪਦ ਆਦਿ ਸਬਦ ਕੋ ਧਾਰੀਐ ॥",
      "s": 13
    },
    {
      "t": "ਤੀਨ ਬਾਰ ਨ੍ਰਿਪ ਪਦ ਕਹੁ ਡਾਰੀਐ ॥",
      "s": 13
    },
    {
      "t": "ਅਰਿ ਪਦ ਤਾ ਕੇ ਅੰਤਿ ਬਖਾਨੋ ॥",
      "s": 13
    },
    {
      "t": "ਸਭ ਸ੍ਰੀ ਨਾਮ ਤੁਪਕ ਕੇ ਜਾਨੋ ॥੧੨੬੧॥",
      "s": 13
    },
    {
      "t": "ਸੁਮਨ ਸਬਦ ਕੋ ਆਦਿ ਬਖਾਨਹੁ ॥",
      "s": 13
    },
    {
      "t": "ਤੀਨ ਬਾਰ ਨਾਇਕ ਪਦ ਠਾਨਹੁ ॥",
      "s": 13
    },
    {
      "t": "ਅਰਿ ਪਦ ਤਾ ਕੇ ਅੰਤਿ ਭਣਿਜੈ ॥",
      "s": 13
    },
    {
      "t": "ਨਾਮ ਤੁਪਕ ਕੇ ਸਕਲ ਲਹਿਜੈ ॥੧੨੬੨॥",
      "s": 13
    }
  ]
}
