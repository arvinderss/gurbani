        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਬੀਸ ਸਹੰਸ ਟਕਾ ਤਿਸੈ ਦਈ ਛਿਮਾਹੀ ਬਾਧਿ ॥੧੨॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੋ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੇਈਸਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੩॥੪੬੦॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਸੋਰਠਾ ॥",
      "s": 14
    },
    {
      "t": "ਦੀਨੋ ਬਹੁਰਿ ਪਠਾਇ ਬੰਦਸਾਲ ਪਿਤ ਪੂਤ ਕਉ ॥",
      "v": [
        [
          2,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਲੀਨੋ ਬਹੁਰਿ ਬੁਲਾਇ ਭੋਰ ਹੋਤ ਅਪੁਨੇ ਨਿਕਟਿ ॥੧॥",
      "v": [
        [
          2,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਪੁਨਿ ਮੰਤ੍ਰੀ ਇਕ ਕਥਾ ਉਚਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਹੁ ਰਾਇ ਇਕ ਬਾਤ ਹਮਾਰੀ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਏਕ ਚਰਿਤ ਤ੍ਰਿਯ ਤੁਮਹਿ ਸੁਨਾਊ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਤੁਮ ਕੌ ਅਧਿਕ ਰਿਝਾਊ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਉਤਰ ਦੇਸ ਨ੍ਰਿਪਤਿ ਇਕ ਭਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੂਰਜ ਬੰਸ ਮਾਹਿ ਉਜਿਯਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਚੰਦ੍ਰਮਤੀ ਤਾ ਕੀ ਪਟਰਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਨਹੁ ਛੀਰ ਸਿੰਧ ਮਥਿਆਨੀ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਸੁਤਾ ਤਾ ਕੇ ਭਵ ਲਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨਕ ਡਾਰਿ ਗੋਦ ਰਵਿ ਦਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜੋਬਨ ਜੇਬ ਅਧਿਕ ਤਿਹ ਬਾਢੀ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਨਹੁ ਚੰਦ੍ਰ ਸਾਰ ਮਥਿ ਕਾਢੀ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਧਰਿਯੋ ਸੁਮੇਰ ਕੁਅਰਿ ਤਿਹ ਨਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਸਮ ਔਰ ਨ ਜਗ ਮੈ ਬਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੁੰਦਰਿ ਤਿਹੂੰ ਭਵਨ ਮਹਿ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨੁਕ ਕਲਾ ਚੰਦ੍ਰ ਕੀ ਵਈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਜੋਬਨ ਜੇਬ ਅਧਿਕ ਤਿਹ ਧਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਮੈਨ ਸੁਨਾਰ ਭਰਨੁ ਜਨੁ ਭਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਵਾ ਕੀ ਪ੍ਰਭਾ ਜਾਤ ਨਹਿ ਕਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨਕ ਫੂਲ ਮਾਲਤੀ ਰਹੀ ॥੬॥",
