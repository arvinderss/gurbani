  "lines": [
    {
      "t": "ਸਰ ਅਨੰਗ ਕੇ ਤਨ ਗਡੇ ਕਢੇ ਦਸਊਅਲਿ ਫੂਟਿ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਲੋਕ ਲਾਜ ਕੁਲ ਕਾਨਿ ਸਭ ਗਈ ਤਰਕ ਦੈ ਤੂਟਿ ॥੧੨॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਏਕ ਪੁਰਖ ਸੁੰਦਰ ਹੁਤੋ ਤਾ ਕੌ ਲਯੋ ਬੁਲਾਇ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਮੈਨ ਭੋਗ ਤਾ ਸੌ ਕਿਯੋ ਹ੍ਰਿਦੈ ਹਰਖ ਉਪਜਾਇ ॥੧੩॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਸੌ ਭੋਗ ਕਰਤ ਤ੍ਰਿਯ ਰਸੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਨ ਹ੍ਵੈ ਨਾਰਿ ਭਵਨ ਤਿਹ ਬਸੀ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਤ ਨਿਸਾ ਕਹ ਤਾਹਿ ਬੁਲਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਮਨ ਭਾਵਤ ਕੇ ਭੋਗ ਕਮਾਵੈ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਆਵਤ ਤਾਹਿ ਲੋਗ ਸਭ ਰੋਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਚੋਰ ਪਛਾਨਿ ਪਾਹਰੂ ਟੋਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਚੇਰੀ ਤਿਨ ਬਚਨ ਸੁਨਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਗ੍ਰਿਹ ਜਾਰ ਸੁ ਪੈਠੈ ਪਾਵੈ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਭੋਗ ਜਾਰ ਸੋ ਤ੍ਰਿਯ ਅਤਿ ਕਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਕੇ ਭੋਗਨ ਭਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਕਾਮ ਕੋ ਤ੍ਰਿਯ ਉਪਜਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਲਪਟਿ ਲਪਟਿ ਕਰਿ ਭੋਗ ਕਮਾਵੈ ॥੧੬॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਚੇਰੀ ਪਹਰੂਨ ਕੋ ਉਤਰ ਦੇਤ ਬਨਾਇ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤਬ ਵਹੁ ਪਾਵਤ ਪੈਠਬੋ ਮੀਤ ਮਿਲਤ ਤਿਹ ਆਇ ॥੧੭॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਰੈਨਿ ਭਈ ਤ੍ਰਿਯ ਮਿਤ੍ਰ ਬੁਲਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯ ਕੋ ਭੇਸ ਧਾਰਿ ਸੋ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਤਾ ਸੋ ਬਚਨ ਉਚਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਹਮ ਸੋ ਭੋਗ ਅਧਿਕ ਤੁਮ ਕਰੇ ॥੧੮॥",
      "s": 14
    },
    {
      "t": "ਨਾਰਿ ਕਹਿਯੋ ਸੁਨਿ ਮਿਤ੍ਰ ਹਮਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੋ ਬਾਤ ਸੋ ਕਰਹੁ ਪ੍ਯਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਮੰਤ੍ਰ ਮੋਰ ਕਾਨਨ ਧਰਿ ਲੀਜਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਅਵਰ ਕਿਸੂ ਤਨ ਭੇਦ ਨ ਦੀਜਹੁ ॥੧੯॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਦਿਵਸ ਤੁਮ ਬਨ ਮੈ ਜੈਯਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਬਾਵਰੀ ਭੀਤਰਿ ਨੈਯਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਮੋਹਿ ਮਿਲੇ ਜਦੁਪਤਿ ਯੌ ਕਹਿਯਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਏ ਬਚ ਭਾਖਿ ਮੌਨ ਹ੍ਵੈ ਰਹਿਯਹੁ ॥੨੦॥",
      "s": 14
    },
    {
      "t": "ਤੁਮ ਜੋ ਲੋਗ ਦੇਖ ਹੈ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਯੌ ਕਹਿ ਯਹੁ ਤਿਨ ਬਚਨ ਸੁਨਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਆਨਿ ਗਾਵ ਤੇ ਬਚਨ ਕਹੈਂਗੇ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨ ਬਤਿਯਾ ਹਮ ਚਕ੍ਰਿਤ ਰਹੈਂਗੇ ॥੨੧॥",
      "s": 14
    },
    {
      "t": "ਚੜਿ ਝੰਪਾਨ ਸੁ ਤਹਾ ਹਮ ਐ ਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਗੁਰੂ ਭਾਖਿ ਤਵ ਸੀਸ ਝੁਕੈ ਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਲੈ ਤੋ ਕੋ ਅਪਨੇ ਘਰ ਜੈਹੋ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਕੇ ਭੋਗ ਕਮੈਹੋ ॥੨੨॥",
      "s": 14
    },
    {
      "t": "ਤਵਨੈ ਜਾਰ ਤੈਸ ਹੀ ਕਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਵਨ ਭਾਤਿ ਅਬਲਾ ਕਹਿ ਦਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭਯੋ ਪ੍ਰਾਤ ਬਨ ਮਾਹਿ ਸਿਧਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਬਾਵਰੀ ਮਾਹਿ ਬਿਹਾਰਿਯੋ ॥੨੩॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਜਨ ਕਰਿ ਬਾਪੀ ਬਿਖੈ ਬੈਠਿਯੋ ਧ੍ਯਾਨ ਲਗਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਿਯੋ ਆਨਿ ਮੁਹਿ ਦੈ ਗਏ ਦਰਸਨ ਸ੍ਰੀ ਜਦੁਰਾਇ ॥੨੪॥",
