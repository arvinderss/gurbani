    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਰਾਨੀ ਤਿਹ ਓਰ ਨਿਹਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਯਹੈ ਆਪਨੇ ਹ੍ਰਿਦੈ ਬਿਚਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜੋਗਿਨ ਯਹ ਰਾਜਾ ਸੋ ਲਹਿਯੈ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਜਿ ਮਾਨੁਖਨ ਯਾ ਕੌ ਗਹਿਯੈ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਜਿ ਮਾਨੁਖਨ ਗਹਿ ਲਯੋ ਲੀਨੋ ਧਾਮ ਬੁਲਾਇ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਦੁਹਿਤਾ ਦਈ ਬਿਵਾਹਿ ਕੈ ਜਾਨਿ ਦੇਸ ਕੌ ਰਾਇ ॥੫॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਬਚਨ ਸੁਨਤ ਨ੍ਰਿਪ ਰਿਸਿ ਭਰਿਯੋ ਛੋਡਿ ਰਾਮ ਕੋ ਜਾਪ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਦੁਹਿਤਾ ਦਈ ਬਿਵਾਹਿ ਤਿਹ ਜਾ ਕੈ ਮਾਇ ਨ ਬਾਪ ॥੬॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਰਾਜਾ ਬਾਚ ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਇ ਨ ਬਾਪ ਜਾਨਿਯਤ ਜਾ ਕੌ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਹਿਤਾ ਕਹੂ ਦੀਜਿਯਤ ਤਾ ਕੌ ॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਕੌ ਅਬੈ ਬਾਧਿ ਕਰਿ ਮਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਦੁਹਤਾ ਸਹਿਤ ਸੰਘਾਰੋ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਬਚਨ ਸੁਨਤ ਡਰਿ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਚੀਨਤ ਕਛੂ ਉਪਾਇ ਨ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਤੇ ਜਾਮਾਤਾ ਨਹਿ ਮਰਿਯੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਤਾ ਸਹਿਤ ਇਹ ਜਿਯਤ ਨਿਕਰਿਯੈ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਏਕ ਮੰਗਾਇ ਪਿਟਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਹੂੰਅਨ ਦੁਹੂੰ ਕਨਾਰੇ ਡਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਪਿਟਾਰੋ ਔਰ ਮੰਗਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਵਹ ਪਿਟਾਰ ਤਿਹ ਭੀਤਰ ਪਾਯੋ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਅੰਤਰ ਹੂੰ ਕੇ ਪਿਟਾਰ ਮੈ ਡਾਰੇ ਰਤਨ ਅਪਾਰ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਢਕਨੌ ਦੈ ਦੁਤਿਯ ਮੈ ਦਈ ਮਿਠਾਈ ਡਾਰਿ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਤਿਯ ਪਿਟਾਰ ਮਿਠਾਈ ਡਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਵਹ ਪਿਟਾਰ ਨਹਿ ਦੇਤ ਦਿਖਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਕੋ ਦ੍ਰਿਸਟਿ ਸਿਰੀਨੀ ਆਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੋ ਭੇਦ ਨ ਕੋਉ ਪਾਵੈ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਪਠੇ ਚੇਰਿ ਯਹ ਨ੍ਰਿਪਤਿ ਬੁਲਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਗਹਿ ਬਹਿਯਾ ਸਭ ਸਦਨ ਦਿਖਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਹਮ ਕਾ ਤੁਮ ਤੇ ਨੈਕ ਨ ਡਰਿ ਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਨੁ ਤਵ ਕਹੇ ਸਗਾਈ ਕਰਿ ਹੈ ॥੧੨॥",
