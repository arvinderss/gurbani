{
  "page": 924,
  "lines": [
    {
      "t": "ਜਰਨ ਮਰਨ ਕਾ ਨਿਗ੍ਰਹ ਧਾਰਿਯੋ ॥੬੩॥",
      "s": 14
    },
    {
      "t": "ਚਿਤਾ ਜਰਾਇ ਜਰਨ ਜਬ ਲਾਗ੍ਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਬੈਤਾਲ ਤਹਾ ਤੇ ਜਾਗ੍ਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੰਚਿ ਅੰਮ੍ਰਿਤ ਤਿਹ ਦੁਹੂੰਨ ਜਿਯਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਕੇ ਚਿਤ ਕੋ ਤਾਪੁ ਮਿਟਾਯੋ ॥੬੪॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਹਿ ਸੈਥੀ ਪਾਵਕ ਬਰਿਯੋ ਦੁਹੂੰਅਨ ਲਯੋ ਬਚਾਇ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਕਾਮਾ ਦਈ ਦਿਜੋਤ ਮਹਿ ਧੰਨ੍ਯ ਬਿਕ੍ਰਮਾਰਾਇ ॥੬੫॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਪੁਰਖ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕਾਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੯੧॥੧੬੩੪॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਦਛਿਨ ਦੇਸ ਬਿਚਛਨ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜੋਗੀ ਗਏ ਭਏ ਘਰ ਬਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਮੰਗਲ ਸੈਨ ਰਾਵ ਜਗੁ ਕਹਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਅਰਿ ਕੁਲ ਜਾ ਤੇ ਤ੍ਰਿਣ ਗਹਈ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਸਰੂਪ ਕਲਾ ਤਾ ਕੀ ਬਰ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਨਹੁ ਮਹਾ ਰੁਦ੍ਰ ਕੀ ਪ੍ਯਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਸੋ ਨੇਹ ਨ੍ਰਿਪਤਿ ਕੋ ਰਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਰੈ ਸੋਈ ਜੋਈ ਵਹ ਕਹੈ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਰੁਆਮਲ ਛੰਦ ॥",
      "s": 14
    },
    {
      "t": "ਰੰਗ ਮਹਲ ਬਿਖੈ ਹੁਤੇ ਨਰ ਰਾਇ ਤਵਨੈ ਕਾਲ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਰੂਪ ਪ੍ਰਭਾ ਬਿਰਾਜਤੀ ਤਹ ਸੁੰਦਰੀ ਲੈ ਬਾਲ ॥",
      "v": [
        [
          2,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਕਾਨ੍ਰਹਰੇ ਨਾਦ ਔ ਨਫੀਰੀ ਬੇਨੁ ਬੀਨ ਮ੍ਰਿਦੰਗ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿਨ ਕੇ ਕੁਲਾਹਲ ਹੋਤ ਨਾਨਾ ਰੰਗ ॥੩॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਏਕ ਨਟੂਆ ਤਹ ਰਹੈ ਤਿਹ ਬਿਸੁਨ ਦਤ੍ਵਾ ਨਾਮ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਰਾਵ ਜੂ ਤਾ ਕੌ ਨਚਾਵਤ ਰਹੈ ਆਠੌ ਜਾਮ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਅਮਿਤ ਰੂਪ ਬਿਲੋਕਿ ਤਾ ਕੌ ਰਾਨਿਯਹਿ ਨਿਜੁ ਨੈਨ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਹ੍ਵੈ ਗਿਰੀ ਬਿਸੰਭਾਰ ਭੂ ਪੈ ਬਧੀ ਸਾਯਕ ਮੈਨ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਤੋਮਰ ਛੰਦ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨਿਯਿਹ ਸਖੀ ਪਠਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਲਯੋ ਧਾਮ ਬੁਲਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਤਜਿ ਕੈ ਨ੍ਰਿਪਤਿ ਕੀ ਕਾਨਿ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਸੌ ਰਮੀ ਰੁਚਿ ਮਾਨਿ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਅਮਿਤ ਰੂਪ ਨਿਹਾਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਸਿਵ ਸਤ੍ਰੁ ਗਯੋ ਸਰ ਮਾਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਲੌ ਨ੍ਰਿਪਤਿ ਗਯੋ ਆਇ ॥",
      "s": 14
    },
    {
      "t": "ਅਬਲਾ ਅਧਿਕ ਦੁਖ ਪਾਇ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਕਿਯੋ ਇਹੈ ਉਪਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਦੇਗ ਲਈ ਮੰਗਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਪੈ ਤਵਾ ਕੌ ਦੀਨ ॥",
      "s": 14
    },
    {
      "t": "ਕੋਊ ਸਕੈ ਤਾਹਿ ਨ ਚੀਨ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਮੈ ਘਨੌ ਜਲ ਪਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਰ ਕੌ ਨ ਬੂੰਦਿਕ ਢਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਮੈ ਗੁਲਾਬਹਿ ਪਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਢਿਯੌ ਪਤਿਹਿ ਦਿਖਰਾਇ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੀਂਚ੍ਰਯੋ ਵਹੈ ਗੁਲਾਬ ਲੈ ਪਤਿ ਕੀ ਪਗਿਯਾ ਮਾਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਛਿਰਕਿ ਸਭਨ ਪਹਿ ਕਾਢਿਯੌ ਭੇਦ ਲਹਿਯੋ ਜੜ ਨਾਹਿ ॥੯॥",
