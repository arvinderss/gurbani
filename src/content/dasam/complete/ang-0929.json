  "lines": [
    {
      "t": "ਦਓਜਈ ਅਫਰੀਦੀਏ ਕੋਪਿ ਆਏ ॥",
      "s": 14
    },
    {
      "t": "ਹਠੇ ਸੂਰ ਲੋਦੀ ਮਹਾ ਕੋਪ ਕੈ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਪਰੇ ਆਨਿ ਕੈ ਬਾਢਵਾਰੀਨ ਲੈ ਕੈ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਪਰੀ ਬਾਢਵਾਰੀਨ ਕੀ ਮਾਰਿ ਭਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਗਏ ਜੂਝਿ ਜੋਧਾ ਬਡੇਈ ਹੰਕਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਮਾਰਿ ਬਾਨਨ ਕੀ ਗਾੜ ਐਸੀ ॥",
      "s": 14
    },
    {
      "t": "ਮਨੌ ਕੁਆਰ ਕੇ ਮੇਘ ਕੀ ਬ੍ਰਿਸਟਿ ਜੈਸੀ ॥੧੬॥",
      "s": 14
    },
    {
      "t": "ਪਰੇ ਆਨਿ ਜੋਧਾ ਚਹੂੰ ਓਰ ਭਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਮਾਰ ਹੀ ਮਾਰਿ ਐਸੇ ਪੁਕਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਹਟੇ ਨਾਹਿ ਛਤ੍ਰੀ ਛਕੇ ਛੋਭ ਐਸੇ ॥",
      "s": 14
    },
    {
      "t": "ਮਨੋ ਸਾਚ ਸ੍ਰੀ ਕਾਲ ਕੀ ਜ੍ਵਾਲ ਜੈਸੇ ॥੧੭॥",
      "s": 14
    },
    {
      "t": "ਧਏ ਅਰਬ ਆਛੇ ਮਹਾ ਸੂਰ ਭਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਕਰੈ ਤੀਨਹੂੰ ਲੋਕ ਜਿਨ ਕੌ ਜੁਹਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਲਏ ਹਾਥ ਤਿਰਸੂਲ ਐਸੋ ਭ੍ਰਮਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਮਨੋ ਮੇਘ ਮੈ ਦਾਮਨੀ ਦਮਕਿ ਜਾਵੈ ॥੧੮॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਧਾਏ ਬੀਰ ਜੋਰਿ ਦਲ ਭਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਨਾ ਬਧੇ ਬਡੇ ਹੰਕਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਨ ਧਨੁਹਿਯਨ ਬਾਨ ਚਲਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਧੇ ਗੋਲ ਸਾਮੁਹੇ ਆਵੈ ॥੧੯॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਅਬਲਾ ਵਹ ਨੈਨ ਨਿਹਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਕੇ ਸਸਤ੍ਰ ਪ੍ਰਹਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਮੂੰਡ ਜੰਘ ਬਾਹਨ ਬਿਨੁ ਕੀਨੇ ॥",
      "s": 14
    },
    {
      "t": "ਪਠੈ ਧਾਮ ਜਮ ਕੇ ਸੋ ਦੀਨੇ ॥੨੦॥",
      "s": 14
    },
    {
      "t": "ਜੂਝਿ ਅਨੇਕ ਸੁਭਟ ਰਨ ਗਏ ॥",
      "s": 14
    },
    {
      "t": "ਹੈ ਗੈ ਰਥੀ ਬਿਨਾ ਅਸਿ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਜੂਝੈ ਬੀਰ ਖੇਤ ਭਟ ਭਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਚੇ ਸੂਰ ਬੀਰ ਹੰਕਾਰੀ ॥੨੧॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਲਗੇ ਬ੍ਰਿਣਨ ਕੇ ਸੂਰਮਾ ਪਰੇ ਧਰਨਿ ਪੈ ਆਇ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਗਿਰ ਪਰੇ ਉਠਿ ਪੁਨਿ ਲਰੇ ਅਧਿਕ ਹ੍ਰਿਦੈ ਕਰਿ ਚਾਇ ॥੨੨॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਭੁਜੰਗ ਛੰਦ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਤੇ ਗੋਫਨੈ ਗੁਰਜ ਗੋਲੇ ਉਭਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਤੇ ਚੰਦ੍ਰ ਤ੍ਰਿਸੂਲ ਸੈਥੀ ਸੰਭਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਤੇ ਪਰਘ ਫਾਸੀ ਲਏ ਹਾਥ ਡੋਲੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਤੇ ਮਾਰ ਹੀ ਮਾਰਿ ਕੈ ਬੀਰ ਬੋਲੈ ॥੨੩॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਤਿ ਚਿਤ ਕੋਪ ਬਢਾਇ ਕੈ ਸੂਰਨ ਸਕਲਨ ਘਾਇ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਜਹਾ ਬਾਲਿ ਠਾਢੀ ਹੁਤੀ ਤਹਾ ਪਰਤ ਭੇ ਆਇ ॥੨੪॥",
      "v": [
        [
          3,
