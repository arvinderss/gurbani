    {
      "t": "ਭੁਜੰਗ ਛੰਦ ॥",
      "s": 14
    },
    {
      "t": "ਚਹੂੰ ਓਰ ਤੇ ਚਾਵਡੈ ਚੀਤਕਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਰਹੇ ਗਿਧ ਆਕਾਸ ਮੰਡਰਾਇ ਭਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਲਗੇ ਘਾਇ ਜੋਧਾ ਗਿਰੇ ਭੂਮਿ ਭਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਐਸੀ ਭਾਤਿ ਝੂਮੇ ਮਨੌ ਮਤਵਾਰੇ ॥੨੭॥",
      "s": 14
    },
    {
      "t": "ਪਰੀ ਬਾਨ ਗੋਲਾਨ ਕੀ ਭੀਰ ਭਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੈ ਤੀਰ ਤਰਵਾਰਿ ਕਾਤੀ ਕਟਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਹਠੈ ਐਠਿਯਾਰੇ ਮਹਾਬੀਰ ਧਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਬਧੇ ਗੋਲ ਗਾੜੇ ਚਲੇ ਖੇਤ ਆਏ ॥੨੮॥",
      "s": 14
    },
    {
      "t": "ਗੁਰਿਯਾ ਖੇਲ ਮਹਮੰਦਿ ਲੇਜਾਕ ਮਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਦਓਜਈ ਅਫਰੀਤਿ ਲੋਦੀ ਸੰਘਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਬਲੀ ਸੂਰ ਨ੍ਰਯਾਜੀ ਐਸੀ ਭਾਤਿ ਕੂਟੇ ॥",
      "s": 14
    },
    {
      "t": "ਚਲੇ ਭਾਜ ਜੋਧਾ ਸਭੈ ਸੀਸ ਫੂਟੇ ॥੨੯॥",
      "s": 14
    },
    {
      "t": "ਸਵੈਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੂਰ ਗਏ ਕਟਿ ਕੈ ਝਟ ਦੈ ਤਬ ਬਾਲ ਕੁਪੀ ਹਥਿਆਰ ਸੰਭਾਰੇ ॥",
      "v": [
        [
          5,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਪਟਿਸ ਲੋਹ ਹਥੀ ਪਰਸੇ ਇਕ ਬਾਰ ਹੀ ਬੈਰਨਿ ਕੇ ਤਨ ਝਾਰੇ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਏਕ ਲਰੇ ਇਕ ਹਾਰਿ ਟਰੇ ਇਕ ਦੇਖਿ ਡਰੇ ਮਰਿ ਗੇ ਬਿਨੁ ਮਾਰੇ ॥",
