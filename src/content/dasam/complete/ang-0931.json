    {
      "t": "ਆਨਿ ਬਾਲ ਸੋ ਜੂਝ ਮਚਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਚਤੁਰ ਬਾਨ ਤਬ ਤ੍ਰਿਯਾ ਪ੍ਰਹਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਚਾਰੋ ਅਸ੍ਵ ਮਾਰ ਹੀ ਡਾਰੇ ॥੩੮॥",
      "s": 14
    },
    {
      "t": "ਪੁਨਿ ਰਥ ਕਾਟਿ ਸਾਰਥੀ ਮਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਰਬ ਰਾਇ ਕੋ ਬਾਨ ਪ੍ਰਹਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੋਹਿਤ ਕੈ ਤਾ ਕੋ ਗਹਿ ਲੀਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੁੰਦਭਿ ਤਬੈ ਜੀਤਿ ਕੌ ਦੀਨੋ ॥੩੯॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੋ ਬਾਧਿ ਧਾਮ ਲੈ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਸੋ ਦਰਬੁ ਲੁਟਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜੈ ਦੁੰਦਭੀ ਦ੍ਵਾਰ ਪੈ ਬਾਜੀ ॥",
      "s": 14
    },
    {
      "t": "ਗ੍ਰਿਹ ਕੇ ਲੋਕ ਸਕਲ ਭੇ ਰਾਜੀ ॥੪੦॥",
