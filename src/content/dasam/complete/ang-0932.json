{
  "page": 932,
  "lines": [
    {
      "t": "ਕਹਾ ਲੌ ਗਨੌ ਮੈ ਨਹੀ ਜਾਤ ਬੂਝੇ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਰੂਆਲ ਛੰਦ ॥",
      "s": 14
    },
    {
      "t": "ਅਮਿਤ ਸੈਨਾ ਲੈ ਚਲਿਯੋ ਤਹ ਆਪੁ ਰਾਜਾ ਸੰਗ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਜੋਰਿ ਕੋਰਿ ਸੁ ਬੀਰ ਮੰਤ੍ਰੀ ਸਸਤ੍ਰ ਧਾਰਿ ਸੁਰੰਗਿ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸੂਲ ਸੈਥਿਨ ਕੇ ਲਗੇ ਅਰੁ ਬੇਧਿ ਬਾਨਨ ਸਾਥ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਜੂਝਿ ਜੂਝਿ ਗਏ ਤਹਾ ਰਨ ਭੂਮਿ ਮਧਿ ਪ੍ਰਮਾਥ ॥੧੦॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਭੁਜੰਗ ਛੰਦ ॥",
      "s": 14
    },
    {
      "t": "ਜਗੇ ਜੰਗ ਜੋਧਾ ਗਏ ਜੂਝਿ ਭਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਤੇ ਭੂਮਿ ਘੂਮੈ ਸੁ ਮਨੋ ਮਤਵਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਤੇ ਮਾਰ ਹੀ ਮਾਰਿ ਐਸੇ ਪੁਕਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਤੇ ਸਸਤ੍ਰ ਛੋਰੈ ਤ੍ਰਿਯਾ ਭੇਖ ਧਾਰੈ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਜਬੈ ਆਨਿ ਜੋਧਾ ਚਹੂੰ ਘਾਤ ਗਜੇ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਸੰਖ ਔ ਦੁੰਦਭੀ ਨਾਦ ਵਜੇ ॥",
      "s": 14
    },
    {
      "t": "ਪਰੀ ਜੌ ਅਭੀਤਾਨ ਕੀ ਭੀਰ ਭਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਬੈ ਆਪੁ ਸ੍ਰੀ ਕਾਲਿਕਾ ਕਿਲਕਾਰੀ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਤਹਾ ਆਪੁ ਲੈ ਰੁਦ੍ਰ ਡੌਰੂ ਬਜਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਚਤਰ ਸਾਠਿ ਮਿਲਿ ਜੋਗਨੀ ਗੀਤ ਗਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਕੋਪਿ ਕੈ ਡਾਕਨੀ ਹਾਕ ਮਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਭੂਤ ਔ ਪ੍ਰੇਤ ਨਾਗੇ ਬਿਹਾਰੈ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਤੋਮਰ ਛੰਦ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਬਿਕ੍ਰਮੈ ਰਿਸਿ ਖਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਭਟ ਭਾਤਿ ਭਾਤਿ ਬੁਲਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਚਿਤ ਮੈ ਅਧਿਕ ਹਠ ਠਾਨਿ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਠਾ ਪਰਤ ਭੇ ਆਨਿ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਅਤਿ ਤਹ ਸੁ ਜੋਧਾ ਆਨਿ ॥",
      "s": 14
    },
    {
      "t": "ਲਰਿ ਮਰਤ ਭੇ ਤਜਿ ਕਾਨਿ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਜੰਤ੍ਰ ਕੋਟਿ ਬਜਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਰਨ ਰਾਗ ਮਾਰੂ ਗਾਇ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਆਨਿ ਪਰੇ ਤੇ ਸਕਲ ਨਿਬੇਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਉਮਡੇ ਔਰ ਕਾਲ ਕੇ ਪ੍ਰੇਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਜੇ ਚਲਿ ਦਲ ਰਨ ਮੰਡਲ ਆਏ ॥",
      "s": 14
    },
    {
      "t": "ਲਰਿ ਮਰਿ ਕੈ ਸਭ ਸ੍ਵਰਗ ਸਿਧਾਏ ॥੧੬॥",
      "s": 14
    },
    {
      "t": "ਐਸੀ ਭਾਤਿ ਸੈਨ ਜਬ ਲਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਬੀਰ ਜੀਯਤ ਨ ਉਬਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਹਠਿ ਰਾਵ ਆਪਿ ਦੋਊ ਧਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਬਾਦਿਤ੍ਰ ਬਜਾਏ ॥੧੭॥",
      "s": 14
    },
    {
      "t": "ਤੁਰਹੀ ਨਾਦ ਨਫੀਰੀ ਬਾਜੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੰਖ ਢੋਲ ਕਰਨਾਏ ਗਾਜੀ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਮੋ ਘੁਰੇ ਨਗਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਖਤ ਸੁਰ ਬਿਵਾਨ ਚੜਿ ਸਾਰੇ ॥੧੮॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਬਿਕ੍ਰਮਾ ਤਿਹ ਘਾਇ ਚਲਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਆਪਿ ਆਨਿ ਸ੍ਰੀ ਚੰਡਿ ਬਚਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਬ੍ਰਿਣ ਏਕ ਲਗਨ ਨਹਿ ਦੇਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੇਵਕ ਜਾਨਿ ਰਾਖਿ ਕੈ ਲੇਵੈ ॥੧੯॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਵੀ ਭਗਤ ਪਛਾਨਿ ਤਿਹ ਲਗਨ ਨ ਦੀਨੇ ਘਾਇ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਬਜ੍ਰ ਬਾਨ ਬਰਛੀਨ ਕੋ ਬਿਕ੍ਰਮ ਰਹਿਯੋ ਚਲਾਇ ॥੨੦॥",
      "v": [
        [
          3,
