      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਲਬਾਹਨ ਕੀ ਇਕ ਪਟਰਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਰਨ ਹੇਰਿ ਅਧਿਕ ਡਰਪਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਪੂਜਿ ਗੌਰਜਾ ਤਾਹਿ ਮਨਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਤ ਭਵਿਖ੍ਯ ਵਹੈ ਠਹਿਰਾਈ ॥੨੧॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤਿਹ ਦਰਸੁ ਗੌਰਜਾ ਦਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਉਠਿ ਰਾਣੀ ਤਿਹ ਸੀਸ ਝੁਕਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਜਗ ਮਾਤ ਮਨਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜੀਤ ਹੋਇ ਹਮਰੀ ਬਰੁ ਪਾਯੋ ॥੨੨॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਲਬਾਹਨ ਬਿਕ੍ਰਮ ਭਏ ਬਾਜਿਯੋ ਲੋਹ ਅਪਾਰ ॥",
      "v": [
        [
          2,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਆਠ ਜਾਮ ਆਹਵ ਬਿਖੈ ਜੁਧ ਭਯੋ ਬਿਕਰਾਰ ॥੨੩॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰਯਾਲਕੋਟਿ ਨਾਯਕ ਰਿਸਿ ਭਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਚਿਤ੍ਰ ਬਚਿਤ੍ਰ ਚੌਪਿ ਰਨ ਕਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਨਿ ਧਨ ਬਾਨ ਬਜ੍ਰ ਸੇ ਮਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਵ ਬਿਕ੍ਰਮਾ ਸ੍ਵਰਗ ਸਿਧਾਰੇ ॥੨੪॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜੀਤਿ ਬਿਕ੍ਰਮਾਜੀਤ ਕੋ ਚਿਤ ਮੈ ਹਰਖ ਬਢਾਇ ॥",
      "v": [
        [
          2,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਅੰਤਹ ਪੁਰ ਆਵਤ ਭਯੋ ਅਧਿਕ ਹ੍ਰਿਦੈ ਸੁਖੁ ਪਾਇ ॥੨੫॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਰਾਜਾ ਅੰਤਹ ਪੁਰ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨ੍ਯੋ ਜੁ ਬਰੁ ਰਾਨੀ ਜੂ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੋ ਕੌ ਕਹਿਯੋ ਜੀਤਿ ਇਹ ਦਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਸੌ ਪ੍ਰੀਤਿ ਅਧਿਕ ਹ੍ਵੈ ਗਈ ॥੨੬॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਹਮਰੇ ਹਿਤ ਇਹ ਰਾਨਿਯੈ ਲੀਨੀ ਗੌਰਿ ਮਨਾਇ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਰੀਝਿ ਭਗੌਤੀ ਬਰੁ ਦਯੋ ਤਬ ਹਮ ਜਿਤੇ ਬਨਾਇ ॥੨੭॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਸ ਦਿਨ ਰਹੈ ਤਵਨ ਕੇ ਡੇਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਔਰ ਰਾਨਿਯਨ ਓਰ ਨ ਹੇਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਤ ਮਾਸ ਰਹਤੇ ਜਬ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਬੀ ਪੂਤ ਏਕ ਤਿਹ ਦਯੋ ॥੨੮॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੋ ਨਾਮ ਰਿਸਾਲੂ ਰਾਖਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਐਸੋ ਬਚਨ ਚੰਡਿਕਾ ਭਾਖਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਜਤੀ ਜੋਧਾ ਇਹ ਹੋਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਸਮ ਔਰ ਨ ਜਗ ਮੈ ਕੋਈ ॥੨੯॥",
      "s": 14
    },
    {
      "t": "ਜ੍ਯੋ ਜ੍ਯੋ ਬਢਤ ਰਿਸਾਲੂ ਜਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਤਿ ਅਖੇਟ ਕਰੈ ਮ੍ਰਿਗ ਘਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੈਰ ਦੇਸ ਦੇਸਨ ਕੋ ਕਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਸਹੂ ਰਾਜਾ ਤੇ ਨਹਿ ਡਰੈ ॥੩੦॥",
      "s": 14
    },
    {
      "t": "ਖੇਲ ਅਖੇਟਕ ਜਬ ਗ੍ਰਿਹ ਆਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਚੌਪਰ ਕੀ ਖੇਲਿ ਮਚਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਜੀਤਿ ਚੀਤਿ ਰਾਜਨ ਕੌ ਲੇਈ ॥",
      "s": 14
    },
    {
      "t": "ਛੋਰਿ ਛੋਰਿ ਚਿਤ੍ਰ ਕਰਿ ਦੇਈ ॥੩੧॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਡੋਮ ਤਾ ਕੋ ਗ੍ਰਿਹ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਖੇਲ ਰਿਸਾਲੂ ਸਾਥ ਰਚਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪਗਿਯਾ ਬਸਤ੍ਰ ਅਸ੍ਵ ਜਬ ਹਾਰੇ ॥",
      "s": 14
    }
  ]
