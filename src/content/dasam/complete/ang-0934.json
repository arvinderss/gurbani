  "page": 934,
  "lines": [
    {
      "t": "ਚਿਤ੍ਰ ਚਿਤ ਯੌ ਬਚਨ ਉਚਾਰੇ ॥੩੨॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਰ ਬਾਜ ਤੋਹਿ ਤਬ ਜਾਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੇਰੋ ਕਹਿਯੋ ਏਕ ਤੁਮ ਮਾਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਿਰਕਪ ਕੇ ਸੰਗ ਖੇਲ ਰਚਾਵੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਇਹ ਖੇਲ ਜੀਤਿ ਗ੍ਰਿਹ ਆਵੋ ॥੩੩॥",
      "s": 14
    },
    {
      "t": "ਯੌ ਸੁਣ ਬਚਨ ਰਿਸਾਲੂ ਧਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਚੜਿ ਘੋਰਾ ਪੈ ਤਹੀ ਸਿਧਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਿਰਕਪ ਕੇ ਦੇਸੰਤਰ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਆਨਿ ਰਾਵ ਸੌ ਖੇਲ ਰਚਾਯੋ ॥੩੪॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਸਿਰਕਪ ਛਲ ਅਧਿਕ ਸੁ ਧਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਸਸਤ੍ਰ ਅਸਤ੍ਰ ਬਸਤ੍ਰਨ ਜੁਤ ਹਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਧਨ ਹਰਾਇ ਸਿਰ ਬਾਜੀ ਲਾਗੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੋਊ ਜੀਤਿ ਲਈ ਬਡਭਾਗੀ ॥੩੫॥",
      "s": 14
    },
    {
      "t": "ਜੀਤਿ ਤਾਹਿ ਮਾਰਨ ਲੈ ਧਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਯੌ ਸੁਨਿ ਕੈ ਰਨਿਵਾਸਹਿ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਕੀ ਸੁਤਾ ਕੋਕਿਲਾ ਲੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਯ ਤੇ ਬਧ ਯਾ ਕੌ ਨਹਿ ਕੀਜੈ ॥੩੬॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤਿਹ ਜਾਨ ਮਾਫ ਕੈ ਦਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੀ ਸੁਤਾ ਕੋਕਿਲਾ ਲਈ ॥",
      "s": 14
    },
    {
      "t": "ਦੰਡਕਾਰ ਮੈ ਸਦਨ ਸਵਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੇ ਬੀਚ ਰਾਖ ਤਿਹ ਧਾਰਿਯੋ ॥੩੭॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੌ ਲਰਿਕਾਪਨ ਜਬ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜੋਬਨ ਆਨਿ ਦਮਾਮੋ ਦਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜਾ ਨਿਕਟ ਨ ਤਾ ਕੇ ਆਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਤੇ ਅਤਿ ਰਾਨੀ ਦੁਖੁ ਪਾਵੇ ॥੩੮॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਦਿਵਸ ਰਾਜਾ ਜਬ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਰਾਨੀ ਯੌ ਬਚਨ ਸੁਨਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਹਮ ਕੋ ਲੈ ਤੁਮ ਸੰਗ ਸਿਧਾਰੌ ॥",
      "s": 14
    },
    {
      "t": "ਬਨ ਮੈ ਜਹਾ ਮ੍ਰਿਗਨ ਕੌ ਮਾਰੌ ॥੩੯॥",
      "s": 14
    },
    {
      "t": "ਲੈ ਰਾਜਾ ਤਿਹ ਸੰਗ ਸਿਧਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਹ ਮ੍ਰਿਗ ਹਨਤ ਹੇਤ ਤਹ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੈ ਫੇਰਾ ਸਰ ਸੌ ਮ੍ਰਿਗ ਮਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਯਹ ਕੌਤਕ ਕੋਕਿਲਾ ਨਿਹਾਰਿਯੋ ॥੪੦॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਰਾਨੀ ਯੌ ਬਚਨ ਉਚਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨੋ ਬਾਤ ਨ੍ਰਿਪ ਨਾਥ ਹਮਾਰੇ ॥",
