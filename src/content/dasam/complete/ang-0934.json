        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਦ੍ਰਿਗ ਸਰ ਸੋ ਮ੍ਰਿਗ ਕੋ ਹੌ ਮਾਰੌ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਮ ਠਾਢੇ ਯਹ ਚਰਿਤ ਨਿਹਾਰੋ ॥੪੧॥",
      "s": 14
    },
    {
      "t": "ਘੂੰਘਟ ਛੋਰਿ ਕੋਕਿਲਾ ਧਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਮ੍ਰਿਗ ਲਖਿ ਤਾਹਿ ਗਯੋ ਉਰਝਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਮਿਤ ਰੂਪ ਜਬ ਤਾਹਿ ਨਿਹਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਠਾਢਿ ਰਹਿਯੋ ਨਹਿ ਸੰਕ ਪਧਾਰਿਯੋ ॥੪੨॥",
      "s": 14
    },
    {
      "t": "ਕਰ ਸੌ ਮ੍ਰਿਗ ਰਾਨੀ ਜਬ ਗਹਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਯਹ ਕੌਤਕ ਰੀਸਾਲੂ ਲਹਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਚਿਤ ਭੀਤਰ ਅਧਿਕ ਰਿਸਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਨ ਕਾਟ ਕੈ ਤਾਹਿ ਪਠਾਯੋ ॥੪੩॥",
      "s": 14
    },
    {
      "t": "ਕਾਨ ਕਟਿਯੋ ਮ੍ਰਿਗ ਲਖਿ ਜਬ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਹੋਡੀ ਮਹਲਨ ਤਰ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਿੰਧ ਦੇਸ ਏਸ੍ਵਰ ਗਹਿ ਲਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਚੜਿ ਘੋੜਾ ਪੈ ਪਾਛੇ ਧਯੋ ॥੪੪॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਆਗੇ ਤਾ ਕੇ ਮ੍ਰਿਗ ਧਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਲ ਕੋਕਿਲਾ ਕੇ ਤਰ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਹੋਡੀ ਤਾ ਕੋ ਰੂਪ ਨਿਹਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਹਰਿ ਅਰਿ ਸਰ ਤਾ ਕੌ ਤਨੁ ਮਾਰਿਯੋ ॥੪੫॥",
      "s": 14
    },
    {
      "t": "ਹੋਡੀ ਜਬ ਕੋਕਿਲਾ ਨਿਹਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਹਸਿ ਬਾਤ ਇਹ ਭਾਤਿ ਉਚਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਹਮ ਤੁਮ ਆਉ ਬਿਰਾਜਹਿੰ ਦੋਊ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੋ ਭੇਦ ਨ ਪਾਵਤ ਕੋਊ ॥੪੬॥",
      "s": 14
    },
    {
      "t": "ਹੈ ਤੇ ਉਤਰ ਭਵਨ ਪਗ ਧਾਰਿਯੋ ॥",
