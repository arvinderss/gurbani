  "lines": [
    {
      "t": "ਰਾਝਨ ਹੀਰ ਪ੍ਰੇਮ ਮੈ ਰਹੈ ਏਕ ਹੀ ਹੋਇ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਕਹਿਬੇ ਕੌ ਤਨ ਏਕ ਹੀ ਲਹਿਬੇ ਕੋ ਤਨ ਦੋਇ ॥੨੬॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਐਸੀ ਪ੍ਰੀਤਿ ਪ੍ਰਿਯਾ ਕੀ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਿਗਰੀ ਬਿਸਰਿ ਤਾਹਿ ਸੁਧਿ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਝਾ ਜੂ ਕੇ ਰੂਪ ਉਰਝਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਲੋਕ ਲਾਜ ਤਜਿ ਭਈ ਦਿਵਾਨੀ ॥੨੭॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਚੂਚਕ ਇਹ ਭਾਤਿ ਬਿਚਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਯਹ ਕੰਨ੍ਯਾ ਨਹਿ ਜਿਯਤ ਹਮਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਹੀ ਯਹ ਖੇਰਾ ਕੋ ਦੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਮੈ ਤਨਿਕ ਢੀਲ ਨਹਿ ਕੀਜੈ ॥੨੮॥",
      "s": 14
    },
    {
      "t": "ਖੇਰਹਿ ਬੋਲ ਤੁਰਤੁ ਤਿਹ ਦਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਝਾ ਅਤਿਥ ਹੋਇ ਸੰਗ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਗਤ ਭੀਖ ਘਾਤ ਜਬ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਲੈ ਤਾ ਕੋ ਸੁਰ ਲੋਕ ਸਿਧਾਯੋ ॥੨੯॥",
      "s": 14
    },
    {
      "t": "ਰਾਝਾ ਹੀਰ ਮਿਲਤ ਜਬ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਚਿਤ ਕੇ ਸਕਲ ਸੋਕ ਮਿਟਿ ਗਏ ॥",
      "s": 14
    },
    {
      "t": "ਹਿਯਾ ਕੀ ਅਵਧਿ ਬੀਤਿ ਜਬ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਟਿ ਦੁਹੂੰ ਸੁਰ ਪੁਰ ਕੀ ਲਈ ॥੩੦॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਝਾ ਭਯੋ ਸੁਰੇਸ ਤਹ ਭਈ ਮੈਨਕਾ ਹੀਰ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਯਾ ਜਗ ਮੈ ਗਾਵਤ ਸਦਾ ਸਭ ਕਬਿ ਕੁਲ ਜਸ ਧੀਰ ॥੩੧॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਅਠਾਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੯੮॥੧੮੨੮॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਪੋਠੋਹਾਰਿ ਨਾਰਿ ਇਕ ਰਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਰੁਦ੍ਰ ਕਲਾ ਤਾ ਕੋ ਜਗ ਕਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਗ੍ਰਿਹ ਰੋਜ ਖੁਦਾਈ ਆਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਧਨ ਡਰ ਪਾਇ ਤਾਹਿ ਲੈ ਜਾਵੈ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਦਿਨ ਇਨ ਕਛੁ ਧਨੁ ਨਹਿ ਦਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕੋਪ ਖਦਾਇਨ ਕੇ ਮਨ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਹੀ ਹਾਥ ਕੁਰਾਨ ਉਠਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਮਿਲਿ ਗਿਲਿ ਭਵਨ ਤਵਨ ਕੇ ਆਏ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਹਾਨਤ ਕਹਿਯੋ ਨਬੀ ਕੀ ਕਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਯਹ ਸੁਨਿ ਬਚਨ ਨਾਰਿ ਅਤਿ ਡਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਕੋ ਸਦਨ ਬੀਚ ਬੈਠਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਖਾਨ ਮੁਹਬਤ ਸਾਥ ਜਤਾਯੋ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੇ ਤੁਰਤ ਪਯਾਦੇ ਆਏ ॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਗ੍ਰਿਹ ਮੈ ਬੈਠਾਇ ਛਿਪਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਖਾਨਾ ਭਲੋ ਤਿਨਾਗੇ ਰਾਖ੍ਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਆਪੁ ਖਦਾਇਨ ਸੋ ਯੋ ਭਾਖ੍ਯੋ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਹਾਨਤ ਮੈ ਨ ਨਬੀ ਕੀ ਕਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਮੋ ਤੌ ਕਹੋ ਚੂਕ ਕਾ ਪਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੀ ਜੋ ਨਿੰਦਾ ਮੈ ਕਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਪਨੇ ਮਾਰਿ ਕਟਾਰੀ ਮਰੋ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਕਛੁ ਲੈਨੋ ਹੋਇ ਸੁ ਲੀਜੈ ॥",
      "v": [
        [
          3,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਹਾਨਤ ਕੋ ਮੁਹਿ ਦੋਸੁ ਨ ਦੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਹਸਿ ਖੁਦਾਇਨ ਬਚਨ ਉਚਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਧਨ ਲਾਲਚ ਹਮ ਚਰਿਤ ਸੁ ਧਾਰਿਯੋ ॥੬॥",
      "s": 14
    }
  ]
}
