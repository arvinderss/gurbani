{
  "page": 948,
  "lines": [
    {
      "t": "ਤਿਸੀ ਪੈਂਡ ਹ੍ਵੈ ਆਪੁ ਸਿਧਾਈ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਜੀ ਔ ਕੁਟਵਾਰ ਪੈ ਨਿਜੁ ਪਤਿ ਸਾਧਿ ਦਿਖਾਇ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਪ੍ਰਥਮੈ ਧਨੁ ਪਹੁਚਾਇ ਕੈ ਬਹੁਰਿ ਮਿਲੀ ਤਿਹ ਜਾਇ ॥੧੦॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਕੋਊ ਐਸੀ ਭਾਤਿ ਬਖਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਯਾਇ ਨ ਭਯੋ ਤਾਹਿ ਕਰ ਮਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਧਨੁ ਬਿਨੁ ਨਾਰਿ ਝਖਤ ਅਤਿ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਹ੍ਵੈ ਜੋਗਨ ਬਨ ਮਾਝ ਸਿਧਈ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਚਾਰ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੦੪॥੧੯੪੬॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਲਿਮਰਦਾ ਕੌ ਸੁਤ ਇਕ ਰਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਸ ਬੇਗ ਨਾਮਾ ਜਗ ਕਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਬਚਾ ਜੌਹਰੀ ਕੋ ਤਿਨ ਹੇਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਰੁਦ੍ਰ ਰਿਪੁ ਤਾ ਕੌ ਘੇਰਿਯੋ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੇ ਦ੍ਵਾਰੇ ਦੇਖਨ ਜਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਰੂਪ ਨਿਹਾਰਿ ਹ੍ਰਿਦੈ ਸੁਖੁ ਪਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਕੇਲ ਕਰੋ ਯਾ ਸੋ ਚਿਤ ਭਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਰਤੁ ਦੂਤ ਗ੍ਰਿਹ ਤਾਹਿ ਪਠਾਯੋ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਦੂਤ ਅਨੇਕ ਉਪਚਾਰ ਬਨਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਮੋਹਨ ਰਾਇ ਹਾਥ ਨਹਿ ਆਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਤਾ ਸੋ ਇਹ ਭਾਤਿ ਉਚਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਸ ਬੇਗ ਤਾ ਸੌ ਖਿਝਿ ਮਾਰਿਯੋ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਚੋਟਨ ਲਗੇ ਦੂਤ ਰਿਸਿ ਭਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੂਰਖ ਜਾਨਿ ਜਤਨ ਤਿਹ ਕਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੋਹਨ ਆਜੁ ਕਹਿਯੋ ਮੈ ਐਹੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੌ ਤਾਸ ਬੇਗ ਤੂ ਪੈਹੋ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਯਹ ਸੁਨਿ ਬੈਨ ਫੂਲਿ ਜੜ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਚ ਬਾਤ ਚੀਨਤ ਚਿਤ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਲੋਗ ਉਠਾਇ ਪਾਨ ਮਦ ਕਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਨੁਖ ਹੁਤੋ ਜੋਨਿ ਪਸੁ ਪਰਿਯੋ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਮੋ ਮਨ ਮੋਲ ਮੋਹਨਹਿ ਲਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤੇ ਮੈ ਚੇਰੋ ਹ੍ਵੈ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਬਾਰ ਜੌ ਤਾਹਿ ਨਿਹਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਨੁ ਮਨੁ ਧਨ ਤਾ ਪੈ ਸਭ ਵਾਰੋ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਬਿਨੁ ਸੁਧਿ ਭਏ ਦੂਤ ਤਿਹ ਚੀਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਅੰਡ ਫੋਰਿ ਆਸਨ ਪਰ ਦੀਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਖਨ ਬਸਤ੍ਰ ਪਾਗ ਤਿਹ ਹਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਮੂਰਖ ਕੌ ਸੁਧਿ ਕਛੂ ਨ ਪਰੀ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਮਦਰਾ ਕੀ ਅਤਿ ਭਈ ਖੁਮਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਾਤ ਲਗੇ ਜੜ ਬੁਧਿ ਨ ਸੰਭਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਬੀਤੀ ਰੈਨਿ ਭਯੋ ਉਜਿਯਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਨ ਮਨ ਅਪਨੇ ਆਪ ਸੰਭਾਰੋ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਹਾਥ ਜਾਇ ਆਸਨ ਪਰ ਪਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਚੌਕਿ ਬਚਨ ਤਬ ਮੂੜ ਉਚਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਕਟ ਆਪਨੋ ਦੂਤ ਬੁਲਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਕਹਿ ਭੇਦ ਸਕਲ ਸਮੁਝਾਯੋ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    }
  ]
}
