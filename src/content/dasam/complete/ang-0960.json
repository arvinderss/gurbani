{
  "page": 960,
  "lines": [
    {
      "t": "ਆਛੇ ਅਰੁਨ ਬਸਤ੍ਰ ਤਨ ਧਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਹੂੰ ਹਾਥ ਨਰਿਏਰ ਉਛਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਹੁਤੋ ਦਰਬ ਸੋ ਸਕਲ ਲੁਟਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਆਪੁ ਸਤੀ ਕੌ ਭੇਖ ਬਨਾਯੋ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਮਾਰਗ ਰਾਜ ਹ੍ਵੈ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਹੀ ਆਨਿ ਤ੍ਰਿਯ ਚਿਤਹਿ ਬਨਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਲੌ ਰਾਇ ਆਇ ਹੀ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਹੇਰਤ ਤਵਨ ਸਤੀ ਕੌ ਭਯੋ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਰਾਇ ਬਿਹਸਿ ਤਿਹ ਓਰ ਨਿਹਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਕਟ ਬੋਲਿ ਭ੍ਰਿਤ ਬਚਨ ਉਚਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੋ ਸੋਧ ਲੇਹੁ ਤੁਮ ਜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਕੌਨ ਸਤੀ ਹ੍ਵੈਬੈ ਕਹ ਆਈ ॥੧੬॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਤ ਰਾਵ ਕੋ ਦੂਤ ਬਚ ਤਹਾ ਪਹੂਚ੍ਯੋ ਜਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਸਕਲ ਸਤੀ ਕੋ ਭੇਦ ਲੈ ਨ੍ਰਿਪ ਪਤਿ ਕਹਿਯੋ ਸੁਨਾਇ ॥੧੭॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਯੌ ਸੁਨ ਬਚਨ ਰੀਝਿ ਨ੍ਰਿਪ ਰਹਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਧੰਨਿ ਧੰਨਿ ਮੁਖ ਤੇ ਤਿਹ ਕਹਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਹਮ ਯਾ ਸੋ ਕਛੁ ਪ੍ਰੀਤਿ ਨ ਜਾਗੀ ॥",
      "s": 14
    },
    {
      "t": "ਮੇਰੇ ਹੇਤ ਦੇਨ ਜਿਯ ਲਾਗੀ ॥੧੮॥",
      "s": 14
    },
    {
      "t": "ਧ੍ਰਿਗ ਮੋ ਕੋ ਮੈ ਭੇਦ ਨ ਚੀਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਲੌ ਬ੍ਯਾਹ ਨ ਯਾ ਸੋ ਕੀਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਨ ਨਾਰਿਨ ਸੌ ਪ੍ਰੀਤਿ ਲਗਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਇਹ ਸਮੈ ਕਾਮ ਨਹਿ ਆਈ ॥੧੯॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਮੈ ਇਹ ਅਬੈ ਬਿਯਾਹੂੰ ॥",
      "s": 14
    },
    {
      "t": "ਤਨ ਲਗਿ ਯਾ ਸੋ ਨੇਹ ਨਿਬਾਹੂੰ ॥",
      "s": 14
    },
    {
      "t": "ਬਰਤਿ ਅਗਨਿ ਤੇ ਤਾਹਿ ਉਬਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੋ ਸੋ ਜਰੀ ਨ ਤਨ ਕੋ ਜਾਰੋ ॥੨੦॥",
      "s": 14
    },
    {
      "t": "ਚਿਤਾ ਅਗਨਿ ਜੋ ਸਤੀ ਜਗਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਰਹਾਨਲ ਸੋਈ ਠਹਿਰਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੇ ਤੀਰ ਭਾਵਰੈ ਦੀਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਕ ਹੁਤੀ ਰਾਨੀ ਬਿਧਿ ਕੀਨੀ ॥੨੧॥",
