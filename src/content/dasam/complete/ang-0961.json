{
  "page": 961,
  "lines": [
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਵਹੁ ਨ੍ਰਿਪਤਿ ਅਖੇਟਕ ਆਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਵਾਨਨ ਤੇ ਬਹੁਤ ਮ੍ਰਿਗਨ ਗਹਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਜਨ ਸਾਥ ਆਬਿਯਨ ਲੇਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਅਮਿਤ ਦਰਬੁ ਹੁਸਨਾਕਨ ਦੇਹੀ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਨਿਤਿਪ੍ਰਤਿ ਅਧਿਕ ਮ੍ਰਿਗਨ ਕੌ ਮਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਸਦਾ ਸੁ ਬਨ ਕੇ ਬੀਚ ਬਿਹਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਹੂ ਹਾਥ ਸੌ ਤੀਰ ਚਲਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਕਹਾ ਜਾਨ ਪਸੁ ਪਾਵੈ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਦਿਵਸ ਨ੍ਰਿਪ ਅਖਿਟ ਸਿਧਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਰੋ ਹਰਿਨ ਹੇਰਿ ਲਲਚਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੀਂਗਨ ਤੇ ਜੀਯਤ ਗਹਿ ਲੈਹੌ ॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਕੌ ਘਾਇ ਨ ਲਾਗਨ ਦੈਹੌ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਹੇਰਿ ਹਰਿਨ ਕਹ ਤੁਰੈ ਧਵਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪਾਛੋ ਚਲਿਯੋ ਤਵਨ ਕੋ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਪਰਦੇਸ ਗਯੋ ਚਲਿ ਸੋਈ ॥",
      "s": 14
    },
    {
      "t": "ਚਾਕਰ ਤਹਾ ਨ ਪਹੂੰਚ੍ਯੋ ਕੋਈ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਪ੍ਰਭਾ ਇਕ ਰਾਜ ਦੁਲਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜਾ ਕੋ ਪ੍ਰਾਨਨ ਤੇ ਪ੍ਯਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਧੌਲਰ ਊਚ ਤਵਨ ਕੌ ਰਾਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਮਨੋ ਚੰਦ੍ਰਮਾ ਕੋਲ ਬਿਰਾਜੈ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਤਪਤੀ ਨਦੀ ਤੀਰ ਤਿਹ ਬਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੂਰਜ ਸੁਤਾ ਤਾਹਿ ਜਗ ਕਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਪੰਛੀ ਤਹਾ ਚੁਗਤ ਅਤਿ ਸੋਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਹੇਰਨਿਹਾਰਨ ਕੋ ਮਨੁ ਮੋਹੈ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਸੁੰਦਰ ਤਾਹਿ ਝਰੋਖੇ ਜਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਢ੍ਯੋ ਆਨਿ ਰਾਇ ਮ੍ਰਿਗ ਤਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਰੈ ਧਵਾਇ ਸ੍ਰਮਿਤ ਤਿਹ ਕੀਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰਿੰਗਨ ਤੇ ਸ੍ਰਿੰਗੀ ਗਹਿ ਲੀਨੋ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਯਹ ਕੌਤਕ ਨ੍ਰਿਪ ਸੁਤਾ ਨਿਹਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਯਹੈ ਆਪਨੇ ਹ੍ਰਿਦੈ ਬਿਚਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੈ ਅਬ ਹੀ ਇਹ ਨ੍ਰਿਪ ਕੌ ਬਰੌ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਤਰ ਮਾਰਿ ਕਟਾਰੀ ਮਰੌ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਐਸੀ ਪ੍ਰੀਤਿ ਰਾਇ ਸੌ ਜੋਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਹੂ ਪਾਸ ਜਾਤ ਨਹਿ ਤੋਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਨੈਨ ਸੈਨ ਦੈ ਤਾਹਿ ਬਲਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੈਨ ਭੋਗ ਤਹਿ ਸਾਥ ਕਮਾਯੋ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਐਸੀ ਫਬਤ ਦੁਹੂੰਨ ਕੀ ਜੋਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁਕ ਕ੍ਰਿਸਨ ਬ੍ਰਿਖਭਾਨ ਕਿਸੋਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਹੂੰ ਹਾਥ ਤਿਹ ਕੁਚਨ ਮਰੋਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁ ਖੋਯੋ ਨਿਧਨੀ ਧਨੁ ਟੋਰੈ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਬਾਰ ਬਾਰ ਤਿਹ ਗਰੇ ਲਗਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁ ਕੰਦ੍ਰਪ ਕੋ ਦ੍ਰਪੁ ਮਿਟਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਭੋਗਤ ਤਾਹਿ ਜੰਘ ਲੈ ਕਾਧੇ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁ ਦ੍ਵੈ ਮੈਨ ਤਰਕਸਨ ਬਾਧੇ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਸੌ ਚੁੰਬਨ ਕੀਨੇ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਆਸਨ ਤ੍ਰਿਯ ਦੀਨੇ ॥",
      "s": 14
    },
    {
      "t": "ਗਹਿ ਗਹਿ ਤਾ ਸੋ ਗਰੇ ਲਗਾਈ ॥",
      "s": 14
    }
  ]
}
