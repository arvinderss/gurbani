    {
      "t": "ਤ੍ਰਿਦਸ ਇਕਤ੍ਰ ਸਕਲ ਹ੍ਵੈ ਗਏ ॥",
      "s": 14
    },
    {
      "t": "ਇੰਦ੍ਰਤੁ ਦੇਤ ਜੁਜਤਹਿ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਤਿਨ ਰਾਜ ਇੰਦ੍ਰ ਮੋ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰੂਪ ਨਿਹਾਰ ਸਚੀ ਲਲਚਾਯੋ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਕਹਿਯੋ ਤਾਹਿ ਸੁਨਿ ਸਚੀ ਪਿਆਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਹੋਵਹੁ ਤੁਮ ਤ੍ਰਿਯਾ ਹਮਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਖੋਜਤ ਇੰਦ੍ਰ ਹਾਥ ਨਹਿ ਐਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕਹ ਖੋਜਿ ਕਹੂੰ ਕਾ ਕੈਹੈ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਰੋਇ ਸਚੀ ਯੌ ਬਚਨ ਉਚਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਗਯੋ ਏਸ ਪਰਦੇਸ ਹਮਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਜੇ ਹਮਰੇ ਸਤ ਕੌ ਤੂੰ ਟਰਿ ਹੈਂ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਨਰਕ ਕੇ ਭੀਤਰ ਪਰਿ ਹੈਂ ॥੮॥",
      "s": 14
    },
    {
