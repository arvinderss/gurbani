  "lines": [
    {
      "t": "ਜਾਇ ਰਾਵ ਪ੍ਰਤਿ ਯਹੈ ਉਚਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਵ ਦੇਖਨ ਕੌ ਹਿਯੋ ਹਮਾਰੋ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਯੌ ਸੁਨਿ ਬਚਨ ਰਾਵ ਤਿਹ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਚਾਰਿ ਚਾਰਿ ਭੀਤਰਿ ਬੈਠਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਆਯੁਧ ਦੇਖਨ ਕੌ ਲਏ ॥",
      "s": 14
    },
    {
      "t": "ਹਾਥੋ ਹਾਥ ਕਾਢਿ ਕੈ ਦਏ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਆਯੁਧੁ ਕਾਢਿ ਐਸ ਬਿਧਿ ਦਏ ॥",
      "s": 14
    },
    {
      "t": "ਜੋਰੇ ਏਕ ਬਨਾਵਤ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੀ ਬਾਹ ਸੀਵਿ ਦੋਊ ਲੀਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਨੁ ਬਾਧੋ ਮੁਸਕੈ ਜਨ ਦੀਨੀ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਭਾਟ ਕੌ ਭੇਦ ਬਤਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜਾ ਕੇ ਮੁਖ ਪੈ ਕਹਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਸਭ ਸਸਤ੍ਰ ਦੈ ਮੁਝ ਡਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਤੌ ਦਾਤਾ ਤੂ ਜਾਨ ਹਮਾਰੈ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਯਹ ਸੁਨਿ ਨ੍ਰਿਪਤਿ ਸਸਤ੍ਰ ਦੈ ਡਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਹੋਰ ਰਹੇ ਮੰਤ੍ਰੀਨ ਨਿਵਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨ੍ਯੋ ਨ੍ਰਿਪਤਿ ਨਿਰਾਯੁਧ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਗੋ ਆਨਿ ਤਾਹਿ ਪਹਿਰਯੋ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਬਾਗੋ ਪਹਿਰਿਯੋ ਨ੍ਰਿਪਤਿ ਬਾਹ ਕਢੀ ਨਹਿ ਜਾਹਿ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤੀਰ ਖਾਨ ਠਾਢੋ ਹੁਤੋ ਮੁਸਕੈ ਲਈ ਚਰਾਇ ॥੯॥",
