{
  "page": 987,
  "lines": [
    {
      "t": "ਸਾਠਿ ਸਹਸ੍ਰ ਰਥੀ ਹੂੰ ਕੂਟੇ ॥੨੧॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਏਤੀ ਸੈਨ ਸੰਘਾਰਿ ਕੈ ਪੈਦਲ ਹਨ੍ਯੋ ਅਪਾਰ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁ ਕਰਿ ਜਏ ਨ ਕਾਖਿ ਤੇ ਆਏ ਨਹਿ ਸੰਸਾਰ ॥੨੨॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਹੀ ਬੀਰ ਜੁਧ ਕਰਿ ਹਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਤੇ ਗਏ ਨ ਦਾਨੌ ਮਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਖੇਤ ਛੋਰਿ ਸਭ ਹੀ ਘਰ ਗਏ ॥",
      "s": 14
    },
    {
      "t": "ਮਤੋ ਕਰਤ ਐਸੀ ਬਿਧਿ ਭਏ ॥੨੩॥",
      "s": 14
    },
    {
      "t": "ਸਵੈਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਕੈਸੇ ਹੂੰ ਮਾਰਿਯੋ ਮਰੈ ਨ ਨਿਸਾਚਰ ਜੁਧ ਸਭੈ ਕਰਿ ਕੈ ਭਟ ਹਾਰੇ ॥",
      "v": [
        [
          5,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਬਾਨ ਕ੍ਰਿਪਾਨ ਗਦਾ ਬਰਛੀਨ ਕੇ ਭਾਤਿ ਅਨੇਕਨ ਘਾਇ ਪ੍ਰਹਾਰੇ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸੋ ਨਹਿ ਭਾਜਤ ਗਾਜਤ ਹੈ ਰਨ ਹੋਤ ਨਿਵਰਤਨ ਕ੍ਯੋ ਹੂੰ ਨਿਵਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਸ ਤਜੈ ਕਹੂੰ ਜਾਇ ਬਸੈ ਕਹ ਆਵਤ ਹੈ ਮਨ ਮੰਤ੍ਰ ਤਿਹਾਰੇ ॥੨੪॥",
      "v": [
        [
          5,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਇੰਦ੍ਰਮਤੀ ਬੇਸ੍ਵਾ ਤਹ ਰਹਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਰੂਪ ਤਾ ਕੌ ਜਗ ਕਹਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੂਰਜ ਚੰਦ੍ਰ ਜੋਤਿ ਜੋ ਧਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁ ਯਾਹੀ ਤੇ ਲੈ ਉਜਿਯਾਰੀ ॥੨੫॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਬੀਰਾ ਤਹ ਤੇ ਲਯੋ ਚਲੀ ਤਹਾ ਕਹ ਧਾਇ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਬਸਤ੍ਰ ਪਹਿਰਿ ਤਿਤ ਕੌ ਚਲੀ ਜਿਤ ਅਸੁਰਨ ਕੋ ਰਾਇ ॥੨੬॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਮੇਵਾ ਔਰ ਮਿਠਾਈ ਲਈ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਟਨ ਮੋ ਧਰ ਪਰ ਭਰਿ ਦਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਹ ਫਲ ਖਾਤ ਅਸੁਰ ਕੋ ਰਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਲੈ ਬਨ ਸੌ ਸਕਲ ਲਗਾਈ ॥੨੭॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਦਾਨੋ ਕੌ ਭੂਖਿ ਸੰਤਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਬਨ ਕੇ ਭਛਨ ਫਲ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਟ ਫੋਰਿ ਪਕਵਾਨ ਚਬਾਇਸ ॥",
      "s": 14
    },
    {
      "t": "ਮਦਰਾ ਪਿਯਤ ਅਧਿਕ ਮਨ ਭਾਇਸ ॥੨੮॥",
      "s": 14
    },
    {
      "t": "ਪੀ ਮਦਰਾ ਭਯੋ ਮਤ ਅਭਿਮਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਯਹ ਜਬ ਬਾਤ ਬੇਸੁਵਨ ਜਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਬਾਦਿਤ੍ਰ ਬਜਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਗੀਤਿ ਅਨੇਕ ਤਾਨ ਕੈ ਗਾਏ ॥੨੯॥",
      "s": 14
    },
    {
      "t": "ਜ੍ਯੋਂ ਜ੍ਯੋਂ ਪਾਤ੍ਰ ਨਾਚਤੀ ਆਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਯੋਂ ਤ੍ਯੋਂ ਦਾਨੋ ਸੀਸ ਢੁਰਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਕੋਪ ਕਥਾ ਜਿਯ ਤੇ ਜਬ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਕਰ ਕੀ ਗਦਾ ਬਖਸਿ ਕਰ ਦਈ ॥੩੦॥",
      "s": 14
    },
    {
      "t": "ਆਈ ਨਿਕਟ ਲਖੀ ਜਬ ਪ੍ਯਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਹੁਤੀ ਕ੍ਰਿਪਾਨ ਸੋਊ ਦੈ ਡਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਆਯੁਧ ਬਖਸਿ ਨਿਰਾਯੁਧ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਯਹ ਸਭ ਭੇਦ ਤਿਨੈ ਲਖਿ ਲਯੋ ॥੩੧॥",
      "s": 14
    },
    {
      "t": "ਨਾਚਤ ਨਿਕਟ ਦੈਂਤ ਕੇ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਕਰ ਕਰ ਸੋਂ ਗਈ ਛੁਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਸੋ ਜੰਤ੍ਰ ਮੰਤ੍ਰ ਇਹ ਕੀਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਟ੍ਯੋ ਤਨਿਕ ਕੈਦ ਕਰਿ ਲੀਯੋ ॥੩੨॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    }
  ]
}
