{
  "page": 994,
  "lines": [
    {
      "t": "ਤੁਰਤੁ ਏਕ ਤਹ ਸਖੀ ਪਠਾਈ ॥੧੭॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨੋ ਮਿਤ੍ਰ ਬਿਨੁ ਨਿਸਿ ਭਈ ਹ੍ਯਾਂ ਨ ਪਹੂਚਹੁ ਆਇ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਨ ਕੋਊ ਸੋਧਿ ਪਛਾਨਿ ਕੈ ਤਿਨ ਪ੍ਰਤਿ ਕਹੈ ਨ ਜਾਇ ॥੧੮॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਸਖੀ ਤਿਹ ਆਨਿ ਜਤਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬੈਠਿ ਬਾਗ ਮੈ ਦਿਵਸ ਬਿਤਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੂਰਜ ਛਪਿਯੋ ਰੈਨਿ ਜਬ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਟ ਗਾਵ ਤਾ ਕੇ ਕੀ ਲਈ ॥੧੯॥",
      "s": 14
    },
    {
      "t": "ਰੈਨਿ ਭਈ ਤਾ ਕੇ ਤਬ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਡਾਰਤ ਬਾਜ ਪ੍ਰਿਸਟਿ ਤਿਹ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਹਰਿ ਤਾ ਕੋ ਦੇਸੌਰ ਸਿਧਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਪਹੁਚਿਯੋ ਤਾ ਕੋ ਸਰ ਮਾਰਿਯੋ ॥੨੦॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਰੈਨਿ ਸਕਲ ਤਾ ਕੋ ਲੈ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਉਤਰਤ ਚੜੇ ਦਿਵਸ ਕੇ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਥੋ ਸੁ ਕੁਮਾਰ ਅਧਿਕ ਤਨ ਹਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਔਰ ਸਾਹਿਬਾ ਸਾਥ ਬਿਹਾਰਿਯੋ ॥੨੧॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰਮਤ ਭਯੋ ਤਹ ਕਛੁ ਸ੍ਵੈ ਰਹਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਲੌ ਸਭ ਸਮਧਿਨ ਸੁਨਿ ਲਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਚੜੇ ਤੁਰੈ ਸਭ ਸੂਰ ਰਿਸਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਧੇ ਗੋਲ ਤਹਾ ਕਹ ਧਾਏ ॥੨੨॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਸਾਹਿਬਾ ਦ੍ਰਿਗ ਛੋਰਿ ਨਿਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਹੇਰੈ ਚਹੂੰ ਓਰ ਅਸਵਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੰਗ ਭਾਈ ਦੋਊ ਤਾਹਿ ਨਿਹਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਕਰੁਣਾ ਬਹੇ ਨੈਨ ਕਜਰਾਰੇ ॥੨੩॥",
      "s": 14
    },
    {
      "t": "ਜੌ ਹਮਰੇ ਪਤਿ ਇਨੇ ਨਿਹਰਿ ਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਹੂੰ ਬਾਨ ਦੁਹੂਅਨੰ ਕਹ ਹਰਿ ਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਕਛੂ ਜਤਨ ਅਬ ਕੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਤੇ ਰਾਖਿ ਭਾਇਯਨ ਲੀਜੈ ॥੨੪॥",
      "s": 14
    },
    {
      "t": "ਸੋਵਤ ਹੁਤੋ ਮੀਤ ਨ ਜਗਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਡ ਭਏ ਤਰਕਸ ਅਟਕਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਔਰ ਸਸਤ੍ਰ ਲੈ ਕਹੂੰ ਦੁਰਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਖੋਜੇ ਹੁਤੇ ਜਾਤ ਨਹਿ ਪਾਏ ॥੨੫॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਲੌ ਆਇ ਸੂਰ ਸਭ ਗਏ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਰੋ ਮਾਰ ਪੁਕਾਰਤ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਮਿਰਜਾ ਜੂ ਨੈਨ ਉਘਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਾ ਗਏ ਹਥਿਯਾਰ ਹਮਾਰੇ ॥੨੬॥",
      "s": 14
    },
    {
      "t": "ਭੌਡੀ ਰਾਡ ਕਹਿਯੋ ਕ੍ਯਾ ਕਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਰਕਸ ਟਾਗਿ ਜਾਡ ਪੈ ਧਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪਹੁਚੇ ਆਨਿ ਪਖਰਿਯਾ ਭਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਾ ਧਰੇ ਤੇ ਸਸਤ੍ਰ ਹਮਾਰੇ ॥੨੭॥",
      "s": 14
    },
    {
      "t": "ਸਸਤ੍ਰਨ ਬਿਨਾ ਕਹੋ ਕਿਹ ਮਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੁ ਨਾਰੀ ਕ੍ਯਾ ਮੰਤ੍ਰ ਬਿਚਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਥੀ ਕੋਊ ਸੰਗ ਮੈ ਨਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਚਿੰਤਾ ਅਧਿਕ ਇਹੈ ਚਿਤ ਮਾਹੀ ॥੨੮॥",
      "s": 14
    },
    {
      "t": "ਹੇਰ ਰਹਿਯੋ ਆਯੁਧ ਨਹਿ ਪਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਲਗ ਘੇਰ ਦੁਬਹਿਯਾ ਆਏ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯ ਕੋ ਬਾਜ ਪ੍ਰਿਸਟਿ ਪਰ ਡਾਰਿਯੋ ॥",
      "s": 14
    }
  ]
}
