{
  "page": 995,
  "lines": [
    {
      "t": "ਨਗਰ ਆਪਨੇ ਓਰ ਸਿਧਾਰਿਯੋ ॥੨੯॥",
      "s": 14
    },
    {
      "t": "ਬਿਨੁ ਆਯੁਧ ਭਜਿ ਚਲਿਯੋ ਨਿਹਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਭੈ ਹ੍ਵੈ ਸਭਹੂੰਨ ਬਿਚਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਇਨ ਦੁਹੂੰਅਨ ਕੌ ਜਾਨ ਨ ਦੈਹੌ ॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਕੌ ਮਾਰਿ ਆਜੁ ਹੀ ਲੈਹੈ ॥੩੦॥",
      "s": 14
    },
    {
      "t": "ਕੋਊ ਪਕਰਿ ਸੈਹਥੀ ਧਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਨੂੰ ਕਾਢਿ ਕਰ ਖੜਗ ਨਚਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਨੂੰ ਮਾਰਿ ਬਾਨਨ ਕੀ ਕਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਪਾਗ ਉਤਰਿ ਮਿਰਜਾ ਕੀ ਪਰੀ ॥੩੧॥",
      "s": 14
    },
    {
      "t": "ਪਾਗ ਉਤਰਿ ਤਾ ਕੀ ਜਬ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਮੂੰਡੀ ਹੋਤਿ ਨਾਗ ਤਿਹ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁੰਦਰ ਅਧਿਕ ਕੇਸ ਤਿਹ ਛੂਟੇ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਹੀ ਸੂਰ ਜੁਧ ਕਹ ਜੂਟੇ ॥੩੨॥",
      "s": 14
    },
    {
      "t": "ਕਿਨੀ ਬਿਸਿਖ ਕਸਿ ਤਾਹਿ ਪ੍ਰਹਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਨਹੂੰ ਖੜਗ ਕਾਢਿ ਤਿਹ ਮਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਨਹੂੰ ਵਾਰਿ ਗੁਰਜ ਕੋ ਕੀਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਖੇਤ ਮਾਰਿ ਮਿਰਜਾ ਕੌ ਲੀਨੋ ॥੩੩॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਿਥਮ ਨਾਸ ਮਿਰਜਾ ਕੌ ਕਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰੌ ਜਾਇ ਸਾਹਿਬਹਿ ਧਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬੈਠੇ ਤਿਸੀ ਬਿਰਛ ਤਰ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਹ ਤਿਨ ਦੁਹੂੰਅਨ ਰੈਨਿ ਬਿਤਾਈ ॥੩੪॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਮਰ ਭਰਾਤ ਕੇ ਕੀ ਤੁਰਤੁ ਜਮਧਰ ਲਈ ਨਿਕਾਰਿ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਕਿਯੋ ਪਯਾਨੌ ਮੀਤ ਪਹਿ ਉਦਰ ਕਟਾਰੀ ਮਾਰ ॥੩੫॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਥਮ ਮੀਤ ਤਹ ਤੇ ਨਿਕਰਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਬਿਰਛ ਤਰ ਆਨਿ ਸੁਵਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭ੍ਰਾਤਨ ਮੋਹ ਬਹੁਰਿ ਲਖਿ ਕਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਸਤ੍ਰਨ ਟਾਗਿ ਜਾਡ ਪਰ ਦਿਯੋ ॥੩੬॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਥਮੈ ਰੂਪ ਹੇਰਿ ਤਿਹ ਬਿਗਸੀ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਜੁ ਪਤਿ ਕੈ ਤਾ ਕੌ ਲੈ ਨਿਕਸੀ ॥",
      "s": 14
    },
    {
      "t": "ਭ੍ਰਾਤਿਨ ਹੇਰਿ ਮੋਹ ਮਨ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਜੁ ਪ੍ਰੀਤਮ ਕੋ ਨਾਸ ਕਰਾਯੋ ॥੩੭॥",
      "s": 14
    },
    {
      "t": "ਵਹ ਤ੍ਰਿਯ ਪੀਰ ਪਿਯਾ ਕੇ ਬਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਆਪਹੁ ਮਾਰਿ ਕਟਾਰੀ ਮਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਤ੍ਰਿਯ ਚਰਿਤ ਚਹੈ ਸੁ ਬਨਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਵ ਅਦੇਵ ਭੇਵ ਨਹਿ ਪਾਵੈ ॥੩੮॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਥਮ ਤਹਾ ਤੇ ਕਾਢਿ ਕੈ ਪੁਨਿ ਨਿਜੁ ਮੀਤ ਹਨਾਇ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਪੁਨਿ ਜਮਧਰ ਉਰ ਹਨਿ ਮਰੀ ਭ੍ਰਾਤ ਮੋਹ ਕੇ ਭਾਇ ॥੩੯॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਭੂਤ ਭਵਿਖ ਭਵਾਨ ਮੈ ਸੁਨਿਯਤ ਸਦਾ ਬਨਾਇ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚਤੁਰਿ ਚਰਿਤ੍ਰਨ ਕੌ ਸਦਾ ਭੇਵ ਨ ਪਾਯੋ ਜਾਇ ॥੪੦॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਉਨਤੀਸਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੨੯॥੨੫੬੩॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਮਤਿ ਕੁਅਰਿ ਰਾਨੀ ਇਕ ਸੁਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਬੇਦ ਪੁਰਾਨ ਬਿਖੈ ਅਤਿ ਗੁਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਸਿਵ ਕੀ ਅਧਿਕ ਉਪਾਸਕ ਰਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਹਰ ਹਰ ਸਦਾ ਬਕਤ੍ਰ ਤੇ ਕਹੈ ॥੧॥",
      "s": 14
    }
  ]
}
