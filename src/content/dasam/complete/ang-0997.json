{
  "page": 997,
  "lines": [
    {
      "t": "ਕਹੁ ਤੁ ਤੁਮ ਤਾ ਕੌ ਗਹਿ ਲ੍ਯਾਊ ॥",
      "s": 14
    },
    {
      "t": "ਆਨਿ ਰਾਵ ਜੂ ਤੁਮੈ ਦਿਖਾਊ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਜੋ ਮੁਹਿ ਕਹੋ ਤਾਹਿ ਸੋਊ ਕੀਜੈ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਡਾਰਿ ਮਹਲ ਊਪਰ ਤੇ ਦੀਜੈ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਥਮ ਨ੍ਰਿਪਹਿ ਇਹ ਭਾਤਿ ਜਤਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰੋ ਬਾਧਿ ਜਾਰ ਕੌ ਲ੍ਯਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਆਪੁ ਭੋਗ ਜਿਹ ਸਾਥ ਕਮਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਰਾਵ ਕੌ ਆਨ ਦਿਖਾਯੋ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਹੇਰਿ ਤਾਹਿ ਰਿਸਿ ਭਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਸਖਿਯਨ ਕੌ ਆਗ੍ਯਾ ਯੌ ਕਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਧੌਲਰ ਤੇ ਯਾ ਕੌ ਤੁਮ ਡਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਆਇਸੁ ਰਾਜਾ ਕੋ ਨ ਨਿਹਾਰੋ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਵੈ ਸਖਿਆਂ ਤਾ ਕੌ ਲੈ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਚੀਨਤ ਸਦਨ ਸੁ ਆਗੇ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਕਲ ਰਾਵ ਕੋ ਸੋਕ ਨਿਵਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰੂੰਈ ਪੈ ਤਾ ਕੌ ਗਹਿ ਡਾਰਿਯੋ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਰਾਜੈ ਲਖੀ ਦੁਸਟ ਇਹ ਘਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਤਨਿ ਤਨਿਕ ਖੇਦ ਨਹਿ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਉਠਿ ਤਹ ਤੇ ਨਿਜੁ ਧਾਮ ਸਿਧਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਚਰਿਤ੍ਰ ਨਿਜੁ ਜਾਰ ਲੰਘਾਯੋ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਪੁਨਿ ਰਾਜੇ ਇਹ ਭਾਤਿ ਉਚਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਜੋ ਚੋਰ ਧਾਮ ਤੇ ਡਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੋਹਿ ਆਨ ਵਹੁ ਮ੍ਰਿਤਕ ਦਿਖੈਯੈ ॥",
      "s": 14
    },
    {
      "t": "ਆਗ੍ਯਾ ਮੋਹਿ ਮਾਨਿ ਯਹ ਲੈਯੈ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਨਰ ਹ੍ਯਾਂ ਤੇ ਮਿਲੈ ਬਗਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਟੂਕ ਟੂਕ ਹ੍ਵੈ ਕੈ ਸੋ ਜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਲ ਤਿਲ ਭਯੋ ਦ੍ਰਿਸਟਿ ਨਹਿ ਆਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੌ ਕੌਨ ਖੋਜ ਕਰ ਲ੍ਯਾਵੈ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਤਿਲ ਤਿਲ ਪਾਇ ਅੰਗ ਤਿਹ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਗੀਧ ਕਾਕ ਆਮਿਖ ਭਖਿ ਗਏ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੋ ਅੰਗ ਦ੍ਰਿਸਟਿ ਨਹਿ ਆਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਕੌਨ ਬਿਯੋ ਤਾ ਕੌ ਲੈ ਆਵੈ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਭੁਜੰਗ ਛੰਦ ॥",
      "s": 14
    },
    {
      "t": "ਦਿਯੋ ਡਾਰਿ ਜਾ ਕੋ ਮਹਾਰਾਜ ਐਸੇ ॥",
      "v": [
        [
          4,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਲਹਿਯੋ ਜਾਇ ਤਾ ਕੌ ਕਛੂ ਅੰਗ ਕੈਸੇ ॥",
      "s": 14
    },
    {
      "t": "ਕਈ ਟੂਕ ਹ੍ਵੈ ਕੈ ਪਰਿਯੋ ਕਹੂੰ ਜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਗਏ ਗੀਧ ਔ ਕਾਕ ਤਾ ਕੌ ਚਬਾਈ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਯੌ ਸੁਨਿ ਮੋਨਿ ਨ੍ਰਿਪਤਿ ਮੁਖ ਧਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਦ੍ਰਿਸਟਿ ਰਾਜ ਕਾਰਜ ਪਰ ਕਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਅਪਨੋ ਮੀਤ ਬਚਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਵਾ ਪਸੁ ਕੌ ਯੌ ਚਰਿਤ੍ਰ ਦਿਖਾਯੋ ॥੧੬॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਇਕਤੀਹ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੩੧॥੨੫੯੧॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਪਲਾਊ ਦੇਸ ਸੁਨੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਮੰਗਲ ਦੇਵ ਸੁ ਰਾਵ ਭਨੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਘਰਿ ਕੁਅਰਿ ਤਾ ਕੀ ਬਰ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁਕ ਜਗਤ ਕੀ ਜੋਤਿ ਸਵਾਰੀ ॥੧॥",
      "s": 14
    }
  ]
}
