  "lines": [
    {
      "t": "ਤਾ ਪਰ ਏਕ ਤਵਾ ਕੌ ਡਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮਖਨੀ ਲੈ ਘੇਇਯਾ ਤਿਹ ਕਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਪਤ ਮਿਟਾਇ ਤਵਨ ਪਰ ਧਰਿਯੋ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਵਾ ਸੁ ਜਰਿ ਕੈ ਤਾਸੁ ਪੈ ਘੇਇਯਾ ਧਰਿਯੋ ਬਨਾਇ ॥",
      "v": [
        [
          5,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਲੀਪਿ ਮ੍ਰਿਤਕਾ ਸੌ ਲਿਯੋ ਦੀਨੀ ਆਗਿ ਜਰਾਇ ॥੧੫॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਖੀਰ ਭਰੀ ਜਹ ਦੇਗ ਥੀ ਤਹੀ ਧਰੀ ਲੈ ਸੋਇ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਦੁਗਧ ਫੇਨ ਸੋ ਜਾਨਿਯੈ ਜਾਰ ਨ ਚੀਨੈ ਕੋਇ ॥੧੬॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਟਰਿ ਆਵਤ ਰਾਜ ਗੈ ਲੀਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਸੋ ਆਦਰੁ ਕੀਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਨਏ ਮਹਲ ਜੇ ਹਮੈ ਸਵਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਤੇ ਤੁਮ ਰਾਇ ਦ੍ਰਿਸਟਿ ਨਹਿ ਡਾਰੇ ॥੧੭॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਟਰਿ ਆਗੇ ਪਤਿ ਕੌ ਲਿਯੋ ਰਹੀ ਚਰਨ ਸੌ ਲਾਗਿ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਬਹੁਤ ਦਿਨਨ ਆਏ ਨ੍ਰਿਪਤਿ ਧੰਨ੍ਯ ਹਮਾਰੇ ਭਾਗ ॥੧੮॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਚਿਤ ਚਿੰਤ ਰਾਵ ਜੂ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਆਗੇ ਤ੍ਰਿਯ ਭਾਖਿ ਸੁਨਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੈ ਸਭ ਸਦਨ ਦ੍ਰਿਸਟਿ ਮੈ ਕੈ ਹੌ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਰਿ ਪਕਰਿ ਜਮ ਧਾਮ ਪਠੈ ਹੌ ॥੧੯॥",
      "s": 14
    },
    {
      "t": "ਸਕਲ ਸਦਨ ਫਿਰਿ ਨ੍ਰਿਪਹਿ ਦਿਖਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਰਹਿਯੋ ਬਿਲੋਕਿ ਚੋਰ ਨਹਿ ਪਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਜਹਾ ਦੇਗ ਮੈ ਜਾਰਹਿ ਡਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਹੀ ਆਨਿ ਪਤਿ ਕੌ ਬੈਠਾਰਿਯੋ ॥੨੦॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਰਾਜਾ ਆਵਤ ਸੁਨਿ ਪਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਮੋਦ ਭਯੋ ਮਨ ਸੋਕ ਮਿਟਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਯਹ ਸਭ ਖਾਨ ਪਕ੍ਵਾਏ ਤਬ ਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਟਤ ਸੁਨੇ ਪਿਯਾਰੇ ਜਬ ਹੀ ॥੨੧॥",
      "s": 14
    },
    {
      "t": "ਤਵਨ ਦੇਗ ਕੋ ਢਾਪਨੁਤਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਥਮ ਦੂਧ ਪ੍ਯਾਰੇ ਕੋ ਪ੍ਰਯਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਬਾਟਿ ਲੋਗਨ ਕੌ ਦੀਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੂਰਖ ਰਾਵ ਭੇਦ ਨਹਿ ਚੀਨੋ ॥੨੨॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਦੇਗ ਅਤਿਥਾਨ ਪਠਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਦੂਜੀ ਬੈਰਾਗਿਨ ਕੇ ਦ੍ਰਯਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਤੀਜੀ ਦੇਗ ਸੰਨ੍ਯਾਸਨ ਦਈ ॥",
      "s": 14
    },
    {
      "t": "ਚੌਥੀ ਬ੍ਰਹਮਚਾਰਿਯਨ ਲਈ ॥੨੩॥",
      "s": 14
    },
    {
      "t": "ਪੰਚਈ ਦੇਗ ਚਾਕਰਨ ਦੀਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਛਟਈ ਦੇਗ ਪਿਯਾਦਨ ਲੀਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਗ ਸਪਤਈ ਤਾਹਿ ਡਰਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਖੀ ਸੰਗ ਦੈ ਘਰੁ ਪਹਚਾਯੋ ॥੨੪॥",
      "s": 14
    },
    {
      "t": "ਦੇਖਤ ਨ੍ਰਿਪ ਕੇ ਜਾਰ ਨਿਕਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੂੜ ਰਾਵ ਕਛੁ ਸੋ ਨ ਬਿਚਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਚਿਤ ਰਾਨੀ ਮੈ ਦੀਨੌ ॥",
      "s": 14
    },
    {
      "t": "ਮੋਰੈ ਹਿਤਨ ਬਧਾਵੌ ਕੀਨੌ ॥੨੫॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਮੁਖੁ ਦਿਸਿ ਜੜ ਦੇਖਤ ਰਹਿਯੋ ਤ੍ਰਿਯ ਸੋ ਨੇਹੁਪਜਾਇ ॥",
