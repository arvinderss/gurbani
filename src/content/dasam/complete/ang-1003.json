      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸਬਕ ਸਿੰਘ ਤੇ ਨੈਕ ਨ ਡਰੌ ॥",
      "s": 14
    },
    {
      "t": "ਇਨ ਕੀਨੋ ਗ੍ਰਿਹ ਖ੍ਵਾਰ ਹਮਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੈਹੂੰ ਤਿਹ ਤ੍ਰਿਯ ਸੰਗ ਬਿਹਾਰੋ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਰੋਮਾਤਕ ਤੁਮ ਪ੍ਰਥਮ ਲਗਾਵੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਕਲ ਤ੍ਰਿਯਾ ਕੌ ਭੇਸ ਛਕਾਵੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਤੁਮ ਕੌ ਰਾਜਾ ਲਖਿ ਪੈ ਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਰਤੁ ਮਦਨ ਕੇ ਬਸਿ ਹ੍ਵੈ ਜੈ ਹੈ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਜਾਰ ਕੇਸ ਸਭ ਦੂਰਿ ਕਰਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਖਨ ਅੰਗ ਅਨੂਪ ਸੁਹਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਇ ਦਰਸ ਰਾਜਾ ਕੋ ਦਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਕੋ ਮੋਹਿ ਆਤਮਾ ਲਿਯੋ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਰਾਜੈ ਤਾ ਕੋ ਲਖਿ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੌਰਿ ਸਦਨ ਰਾਨੀ ਕੇ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਹੇ ਸੁੰਦਰਿ ਮੈ ਤ੍ਰਿਯਿਕ ਨਿਹਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨੁਕ ਮਹਾ ਰੁਦ੍ਰ ਕੀ ਪ੍ਯਾਰੀ ॥੧੬॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਮੁਹਿ ਤਿਹ ਤੂ ਆਜ ਮਿਲਾਵੈਂ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਮਾਗੈ ਮੁਖ ਤੇ ਸੋ ਪਾਵੈਂ ॥",
