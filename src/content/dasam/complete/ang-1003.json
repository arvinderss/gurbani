      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਮਰੀ ਪ੍ਰਭਾ ਕਹੋ ਕਾ ਰਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਜ ਨਾਰੀ ਰਾਜੈ ਜੋ ਚਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੀ ਤ੍ਰਿਯ ਸੋ ਔਰ ਬਿਹਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਧ੍ਰਿਗ ਤਾ ਕੋ ਸਭ ਜਗਤ ਉਚਾਰੈ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਥਮ ਭੋਗ ਮਨ ਭਾਵਤੋ ਰਾਨੀ ਕਿਯੋ ਬਨਾਇ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਬਚਨ ਤਾ ਸੌ ਕਹਿਯੋ ਐਸੇ ਰਿਸ ਉਪਜਾਇ ॥੧੦॥",
      "v": [
        [
          4,
