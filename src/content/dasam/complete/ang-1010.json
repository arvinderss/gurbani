{
  "page": 1010,
  "lines": [
    {
      "t": "ਤਬ ਹੀ ਸੈਨ ਕੈਰਵਨ ਭਾਜਿਯੋ ॥੩੬॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯ ਕੌ ਜੁਧ ਬਿਲੌਕਿ ਕੈ ਪਾਰਥ ਭਯੋ ਪ੍ਰਸੰਨ੍ਯ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਿਯੋ ਆਜੁ ਤੈ ਦ੍ਰੋਪਤੀ ਧਰਨੀ ਤਲ ਮੈ ਧੰਨ੍ਯ ॥੩੭॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਮੈ ਅਬ ਬਿਕਿ ਦਾਮਨ ਬਿਨੁ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁ ਤੈ ਦਾਸ ਮੋਲ ਕੋ ਲਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਕਛੁ ਕਹੌ ਕਾਰਜ ਤਵ ਕਰਿਹੋ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਾਨ ਜਾਨ ਤੇ ਨੈਕੁ ਨ ਡਰਿਹੋ ॥੩੮॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਰੁਨ ਬਿਧਾਤੈ ਤਵ ਕਰਿਯੋ ਤਰਨੀ ਕੀਨੋ ਮੋਹਿ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਕੇਲ ਕਰੇ ਬਿਨੁ ਜਾਤ ਲੈ ਲਾਜ ਨ ਲਾਗਤ ਤੋਹਿ ॥੩੯॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਨਾਵਲੀ ਧਨੰਜੈ ਧਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਮੁਰਛਿਤ ਸਕਲ ਸੈਨ ਕਰਿ ਡਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਦ੍ਰੁਪਤੀ ਸਾਥ ਬਿਹਾਰਿਯੋ ਸੋਊ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੋ ਦੇਖਤ ਭਯੋ ਨ ਕੋਊ ॥੪੦॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਚੁੰਬਨ ਆਸਨ ਲੈ ਘਨੇ ਰਤਿ ਮਾਨੀ ਦ੍ਰੁਪਤੀਸ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤਾ ਪਰ ਕੋਊ ਨ ਪਰ ਸਕੇ ਠਟਕਿ ਰਹੇ ਅਵਨੀਸ ॥੪੧॥",
      "v": [
        [
          5,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਜੀਤਿ ਕੈਰਵਨ ਕੇ ਦਲਹਿ ਦ੍ਰੁਪਤਿਹ ਲਯੋ ਛਿਨਾਇ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਮਾਰੇ ਹਾਰੇ ਗਏ ਧੰਨ੍ਯ ਧਨੰਜੈ ਰਾਇ ॥੪੨॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਥਮ ਸੂਰਮਾ ਸਕਲ ਨਿਵਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਬਚੇ ਭਾਜੇ ਭਿਰੇ ਤੇ ਮਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਜੀਤਿ ਦ੍ਰੋਪਤੀ ਅਤਿ ਸੁਖ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਪਾਰਥ ਗ੍ਰਿਹ ਓਰ ਸਿਧਾਯੋ ॥੪੩॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਸੈਤੀਸਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੩੭॥੨੭੫੯॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਆਭਾਵਤੀ ਓਡਛੇ ਰਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੁੰਦਰੀ ਭਵਨ ਚੌਦਹੂੰ ਜਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੌ ਅਤਿ ਹੀ ਰੂਪ ਬਿਰਾਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਰੀ ਆਸੁਰਿਨਿ ਕੌ ਮਨੁ ਲਾਜੈ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਰੂਪਮਾਨ ਤਿਹ ਨੈਨ ਨਿਹਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੋ ਚੀਤਿ ਮੀਤ ਕਰਿ ਡਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਵਾ ਕੇ ਧਾਮ ਬੁਲਾਵਨ ਕੀਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਸੋ ਆਸਨ ਦੀਨੋ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਕੇਸਅਰਿ ਬਕਤ੍ਰ ਲਗਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਕੇਸਨ ਕੌ ਦੂਰਿ ਕਰਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪੁਰਖਹੁ ਤੇ ਇਸਤ੍ਰੀ ਕਰਿ ਡਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਮਿਤ ਪਤਿ ਲੈ ਤੀਰਥਨ ਸਿਧਾਰੀ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਪਤਿ ਕੋ ਕਹੀ ਬਾਤ ਸਮੁਝਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਮੋਰੀ ਹਿਯਾ ਬਹਿਨ ਇਕ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਸੰਗ ਲੈ ਤੀਰਥ ਲੈਹੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਹੀ ਪਾਪ ਬਿਦਾ ਕਰ ਦੈਹੋ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਅੜਿਲ ॥",
      "s": 14
    },
    {
      "t": "ਪਤਿ ਮਿਤ ਲੈ ਕੇ ਸੰਗ ਸਿਧਾਈ ਤੀਰਥਨ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਐਸ ਸਹੇਟ ਬਨਾਈ ਅਪਨੇ ਯਾਰ ਤਨ ॥",
      "v": [
