  "lines": [
    {
      "t": "ਹਮ ਸਭ ਕੀ ਪ੍ਰਤਿਪਾਰਾ ਕੀਜੈ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਪਤ੍ਰੀ ਬਾਚਿ ਫੂਲਿ ਜੜ ਗਏ ॥",
      "s": 14
    },
    {
      "t": "ਜੋਰਿ ਬਰਾਤਹਿ ਆਵਤ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਹੀ ਭਦ੍ਰ ਸੈਨ ਪੁਰ ਆਏ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਰਾਨੀ ਯੌ ਬਚਨ ਸੁਨਾਏ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਏਕ ਸਾਊ ਹ੍ਯਾਂ ਆਵਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਹਮ ਤੇ ਪਾਵ ਪੁਜਾਵਤ ਜਾਵਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਪਾਛੇ ਆਪੁਨ ਨ੍ਰਿਪ ਆਵੈ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸੂਰਜ ਕਲਾ ਕੋ ਲੈ ਘਰ ਜਾਵੈ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਹਮਰੇ ਧਾਮ ਰੀਤਿ ਇਹ ਪਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਜਾਤ ਦੂਰਿ ਨਹਿ ਕਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਏਕ ਜੋਧਾ ਪ੍ਰਥਮਾਵਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਪਾਛੈ ਰਾਜਾ ਕੌ ਲ੍ਯਾਵਹਿ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਏਕ ਸਾਊ ਤਹ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਡਾਰਿ ਡਾਰਿ ਫਾਸੀ ਤ੍ਰਿਯ ਘਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਸੰਘਾਰਿ ਡਾਰਿ ਕਰਿ ਦੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਦੂਸਰ ਕੌ ਯੌ ਹੀ ਬਧ ਕੀਜੈ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਸੂਰਨ ਕੋ ਪ੍ਰਥਮ ਸੰਘਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਰਿ ਭੋਹਰਨ ਭੀਤਰਿ ਡਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਪਾਛੇ ਨ੍ਰਿਪ ਬੋਲ ਪਠਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਡਾਰਿ ਫਾਸ ਗਰ ਘਾਯੋ ॥੧੧॥",
      "s": 14
