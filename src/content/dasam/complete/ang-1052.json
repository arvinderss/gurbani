  "lines": [
    {
      "t": "ਮੂਰਖ ਰਾਵ ਭੇਦ ਨਹਿ ਪਾਵੈ ॥੨੨॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਛਿਆਸਠਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੬੬॥੩੨੯੬॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਸ ਬਰੇਲੀ ਕੇ ਬਿਖੈ ਬੀਰ ਬਡੋ ਧਨ ਰਾਵ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸਾਹ ਪਰੀ ਤਾ ਕੀ ਤ੍ਰਿਯਾ ਰਾਖਤ ਸਭ ਕੋ ਭਾਵ ॥੧॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਪਾਤ੍ਰ ਰਾਜਾ ਕੇ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਖਨ ਬਸਤ੍ਰ ਅਨੂਪ ਸੁਹਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਬਰ ਅਟਿਕ ਤਵਨ ਪਰ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨਿਨ ਡਾਰਿ ਹ੍ਰਿਦੈ ਤੇ ਦਯੋ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਭ੍ਰਾਤ ਨ੍ਰਿਪ ਕੋ ਹੁਤੋ ਜਾ ਕੋ ਰੂਪ ਅਪਾਰ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸਾਹ ਪਰੀ ਤਾ ਸੌ ਬਿਧੀ ਰਾਜਾ ਕੋ ਡਰ ਡਾਰਿ ॥੩॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਤਪ੍ਰਤਿ ਰਾਨੀ ਤਾਹਿ ਬੁਲਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਤਿਹ ਸੰਗ ਕਮਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜਾ ਕੌ ਹਿਯ ਤੇ ਬਿਸਰਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੌ ਰਾਜ ਦੇਉ ਠਹਰਾਯੋ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਮੈ ਰਾਜ ਦੇਤ ਹੌ ਤੋ ਕੌ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਜੁ ਨਾਰੀ ਕਰਿਯਹੁ ਤੁਮ ਮੋ ਕੌ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਮੈ ਤੁਮੈ ਕਹੌਂ ਸੋ ਕਰਿਯਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਰਾਜਾ ਤੇ ਨੈਕ ਨ ਡਰਿਯਹੁ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਮਨ ਬੀਸਕ ਇਕ ਬਿਸਹਿ ਮੰਗੈਯੈ ॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਭੋਜਨ ਕੇ ਬੀਚ ਡਰੈਯੈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜਾ ਸਹਿਤ ਆਨ ਸਭ ਖੈ ਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਛਿਨਕਿਕ ਬਿਖੈ ਮ੍ਰਿਤਕ ਹ੍ਵੈ ਜੈਹੈ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਕੌ ਪ੍ਰਥਮ ਸੰਘਾਰਿ ਕੈ ਲੀਜੈ ਰਾਜੁ ਛਿਨਾਇ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਆਪ ਦੇਸ ਪਤਿ ਹੂਜਿਯੈ ਮੋਹਿ ਸਹਿਤ ਸੁਖ ਪਾਇ ॥੭॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤਿਨ ਜਾਰ ਕਾਜ ਸੋਊ ਕਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੈਨ ਸਹਿਤ ਨਿਵਤੋ ਨ੍ਰਿਪ ਦਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਭੋਜਨ ਭੀਤਰ ਬਿਸੁ ਡਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਸਭਹਿਨ ਬੇਸ੍ਵਾ ਸਹਿਤ ਖਵਾਰੀ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਸੈਨ ਸਹਿਤ ਭਛਤ ਨ੍ਰਿਪ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਘਰਿਕਿਕ ਬਿਖੈ ਮੌਤ ਮਰਿ ਗਏ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਯਤ ਬਚੇ ਤੋ ਤਿਨ ਗਹਿ ਘਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਤੇ ਏਕ ਜਾਨ ਨਹਿ ਪਾਏ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਕੌ ਮਾਰਿ ਰਾਜ ਤਿਨ ਲਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੌ ਨਿਜੁ ਨਾਰੀ ਲੈ ਕਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਹਾਥ ਠਾਢ ਕੀਨੋ ਤਿਹ ਘਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪਾਇ ਪਰਿਯੋ ਤਿਹ ਆਨਿ ਮਿਲਾਯੋ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਐਸੋ ਚਰਿਤ ਚੰਚਲਾ ਕੀਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਜੁ ਨਾਯਕ ਕੌ ਬਧ ਕਰਿ ਦੀਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਔਰ ਸੂਰਮਨ ਕੌ ਬਧ ਕਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਜਾਰ ਅਪਨੈ ਕੋ ਦਿਯੋ ॥੧੧॥",
      "s": 14
