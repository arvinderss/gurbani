  "lines": [
    {
      "t": "ਹੋ ਜਲ ਜੀਵਨ ਕਹ ਐਸੇ ਚਰਿਤ੍ਰ ਦਿਖਾਇ ਕੈ ॥੭॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕੋਟ ਦ੍ਵਾਰਿ ਕਰਿ ਮਤਸ ਦ੍ਰਿਗ ਬੰਧ੍ਰਯੋ ਅਪਨੋ ਗਾਉ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤਾ ਦਿਨ ਤੋ ਤਾ ਕੌ ਪਰਿਯੋ ਮਛਲੀ ਬੰਦਰ ਨਾਉ ॥੮॥",
      "v": [
        [
          5,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਖੋਜਿ ਖੋਜਿ ਤਿਹ ਭੂੰਮਿ ਤੇ ਕਾਢੇ ਰਤਨ ਅਨੇਕ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਰੰਕ ਸਭੈ ਰਾਜਾ ਭਏ ਰਹਿਯੋ ਨ ਦੁਰਬਲ ਏਕ ॥੯॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਸਤਹਤਰਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੭੭॥੩੪੬੫॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਸੁਮੇਰ ਦੇਵਿ ਬਰ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਅਤਿ ਸੁੰਦਰ ਪ੍ਰਭੁ ਆਪੁ ਸਵਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜੋਤਿ ਮਤੀ ਦੁਹਿਤਾ ਤਿਹ ਸੋਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਵ ਅਦੇਵਨ ਕੋ ਮਨੁ ਮੋਹੈ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਕੋਰਿ ਕੁਅਰਿ ਤਿਹ ਸਵਤਿ ਸੁਨਿਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਬੈਰ ਭਾਵ ਤਿਨ ਮਾਝ ਭਨਿਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਰਾਨੀ ਕੋਊ ਘਾਤ ਨ ਪਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਛਲ ਸੋ ਤਿਹ ਸ੍ਵਰਗ ਪਠਾਵੈ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਦੁਹਿਤਾ ਬੋਲਿ ਨਿਕਟ ਤਿਹ ਲਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਿਛਾ ਇਹੈ ਸਿਖਾਵਤ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਰਿਯਾ ਖੇਲਿ ਕੂਕ ਜਬ ਦੀਜੌ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਮ ਸਵਤਿ ਹਮਰੀ ਕੌ ਲੀਜੌ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਬੋਲਿ ਸਵਾਰੀ ਸੁਤਾ ਖਿਲਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਕੋਰਿ ਕੁਅਰਿ ਪਰ ਕੂਕ ਦਿਰਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਅਧਿਕ ਕੋਪ ਤਬ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਚੜਿ ਝੰਪਾਨ ਮਾਰਨ ਤਿਨ ਗਈ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਸਵਤਿਨ ਖਬਰਿ ਐਸ ਸੁਨਿ ਪਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਚੜਿ ਰਾਨੀ ਹਮਰੇ ਪਰ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਜੁ ਕਰ ਗ੍ਰਿਹਨ ਆਗਿ ਲੈ ਦੀਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਰਿ ਬਰਿ ਬਾਟ ਸ੍ਵਰਗ ਕੀ ਲੀਨੀ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਚਰਿਤ੍ਰ ਇਨ ਰਾਨਿਯਹਿ ਸਵਤਨਿ ਦਈ ਸੰਘਾਰਿ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਰਾਜ ਪਾਟ ਅਪਨੋ ਕਿਯੋ ਦੁਸਟ ਅਰਿਸਟ ਨਿਵਾਰਿ ॥੬॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਅਠਤਰਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੭੮॥੩੪੭੧॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਹ ਬਧੂ ਪਛਿਮ ਇਕ ਰਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮਵਤੀ ਤਾ ਕੌ ਜਗ ਕਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੌ ਪਤਿ ਪਰਦੇਸ ਸਿਧਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਰਖ ਬੀਤ ਗੇ ਗ੍ਰਿਹ ਨ ਸੰਭਾਰੋ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਸੁਧਿ ਪਤਿ ਕੀ ਅਬਲਾ ਤਜਿ ਦੀਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਮਾਨਨਿ ਕੀ ਤਿਨ ਗਤਿ ਲੀਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਊਚ ਨੀਚ ਨਹਿ ਠੌਰ ਬਿਚਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਚਾਹੈ ਤਿਹ ਸਾਥ ਬਿਹਾਰੈ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਲੌ ਨਾਥ ਤਵਨ ਕੋ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਦੂਤਿਯਹਿ ਬੋਲਿ ਪਠਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕੋਊ ਮਿਲਾਇ ਮੋਹਿ ਤ੍ਰਿਯ ਦੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਚਾਹੈ ਚਿਤ ਮੈ ਸੋਊ ਲੀਜੈ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਵਾ ਕੀ ਨਾਰਿ ਦੂਤਿਯਹਿ ਭਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਆਨਿ ਸਾਹੁ ਕੋ ਤੁਰਤ ਮਿਲਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਹੁ ਜਬੈ ਤਿਨ ਬਾਲ ਪਛਾਨਿਯੋ ॥",
      "s": 14
    }
  ]
