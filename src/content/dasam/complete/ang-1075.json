{
  "page": 1075,
  "lines": [
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਮਿਸਰੀ ਕੇ ਹੀਰਾ ਕਰ ਲਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਲੈ ਹਜਰਤਿ ਕੇ ਹਾਜਰ ਕਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਹਜਹਾ ਤਿਹ ਕਛੂ ਨ ਚੀਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਤੀਸ ਹਜਾਰ ਰੁਪੈਯਾ ਦੀਨੋ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਸੌ ਸਾਹਹਿ ਛਲਿ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਉਠੀ ਸਭਾ ਆਵਤ ਸੋਊ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਪੰਦ੍ਰਹ ਸਹਸ੍ਰ ਆਪੁ ਤ੍ਰਿਯ ਲੀਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਪੰਦ੍ਰਹ ਸਹਸ੍ਰ ਮੀਤ ਕੋ ਦੀਨੋ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਹਜਹਾ ਛਲਿ ਮੀਤ ਸੌ ਕਾਮ ਕਲੋਲ ਕਮਾਇ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਧਾਮ ਆਨਿ ਪਹੁਚਤ ਭਈ ਸਕਿਯੋ ਨ ਕੋਊ ਪਾਇ ॥੧੦॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਉਨਾਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੮੯॥੩੫੮੯॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਦਿਨ ਬਾਗ ਚੰਚਲਾ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਹਸਿ ਹਸਿ ਬਚਨ ਬਖਾਨਤ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਨਿਸਿ ਰਾਜ ਪ੍ਰਭਾ ਤ੍ਰਿਯ ਤਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਐਸੀ ਭਾਤਿ ਉਚਾਰਿਯੋ ਉਹਾ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਜੌ ਰਾਜੇ ਤੇ ਬਾਰਿ ਭਿਰਾਊ ॥",
      "s": 14
    },
    {
      "t": "ਅਪਨੀ ਝਾਟੈ ਸਭੈ ਮੁੰਡਾਊ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤ੍ਰਿਯ ਹੋਡ ਸਕਲ ਤੁਮ ਹਾਰਹੁ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਨਿਜੁ ਨੈਨਨ ਇਹ ਚਰਿਤ ਨਿਹਾਰਹੁ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਯੌ ਕਹਿ ਕੈ ਸੁਭ ਭੇਸ ਬਨਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਵ ਅਦੇਵਨ ਕੋ ਬਿਰਮਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਚਰਿਤ੍ਰ ਸਿੰਘ ਰਾਜਾ ਜਬ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਿ ਇਹ ਬਚਨ ਚੰਚਲਾ ਪਾਯੋ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਬੈਠ ਝਰੋਖਾ ਦਈ ਦਿਖਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜਾ ਰਹੇ ਰੂਪ ਉਰਝਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਬਾਰ ਇਹ ਕੌ ਜੌ ਪਾਊ ॥",
      "s": 14
    },
    {
      "t": "ਜਨਮ ਸਹਸ੍ਰ ਲਗੇ ਬਲਿ ਜਾਊ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਪਠੈ ਸਹਚਰੀ ਲਈ ਬੁਲਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰੀਤਿ ਸਹਿਤ ਰਸ ਰੀਤੁਪਜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਬਲਾ ਤਬ ਮੁਰਛਿਤ ਹ੍ਵੈ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਪਾਨਿ ਪਾਨਿ ਉਚਰਤ ਮੁਖ ਭਈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਉਠ ਕਰਿ ਆਪੁ ਰਾਵ ਤਬ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕਹ ਪਾਨਿ ਪਯਾਵਤ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪਾਨਿ ਪਿਏ ਬਹੁਰੇ ਸੁਧਿ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜੈ ਫਿਰਿ ਚੁੰਬਨ ਤਿਹ ਲਈ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਸੁਧਿ ਮੈ ਅਬਲਾ ਕਛੁ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਕਾਮ ਕੀ ਕੇਲ ਮਚਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਦੋਊ ਤਰਨ ਨ ਕੋਊ ਹਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਯੌ ਰਾਜਾ ਤਿਹ ਸਾਥ ਬਿਹਾਰੈ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਬਾਲ ਇਹ ਭਾਤਿ ਉਚਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨੋ ਰਾਵ ਤੁਮ ਬਾਤ ਹਮਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯ ਕੀ ਝਾਟਿ ਨ ਮੂੰਡੀ ਜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਬੇਦ ਪੁਰਾਨਨ ਮੈ ਸੁਨਿ ਪਾਈ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਹਸਿ ਕਰਿ ਰਾਵ ਬਚਨ ਯੌ ਠਾਨ੍ਰਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੈ ਅਪੁਨੇ ਜਿਯ ਸਾਚ ਨ ਜਾਨ੍ਯੋ ॥",
      "s": 14
    }
  ]
}
