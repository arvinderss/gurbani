    {
      "t": "ਹਮੈ ਨਗਜ ਸੈਨਾ ਮੌ ਦੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਹਿੰਦੂ ਧਰਮ ਰਾਖਿ ਕਰਿ ਲੀਜੈ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਨਾਵਨ ਕੌ ਸੁਭ ਵਾਰੋ ਦਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਲਨ ਸਹਿਤ ਦੇਸ ਮਗੁ ਲਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰਜਪੂਤਨ ਰੂਮਾਲ ਫਿਰਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਹਮ ਮਿਲਨੇ ਹਜਰਤਿ ਕੌ ਆਏ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਕੌ ਕਿਨੀ ਨ ਚੋਟਿ ਚਲਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਰਾਨੀ ਹਜਰਤਿ ਪਹ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਪਕ ਤਲੋ ਤੈ ਜਬੈ ਉਬਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਹੀ ਕਾਢਿ ਕ੍ਰਿਪਾਨੈ ਪਰੇ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਜੌਨੈ ਸੂਰ ਸਰੋਹੀ ਬਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਜੈਬੋ ਟਿਕੈ ਨ ਬਖਤਰ ਰਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਏਕੈ ਤੀਰ ਏਕ ਅਸਵਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਏਕੈ ਘਾਇ ਏਕ ਗਜ ਭਾਰਾ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਪਰ ਪਰੈ ਖੜਗ ਕੀ ਧਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁਕ ਬਹੇ ਬਿਰਛ ਪਰ ਆਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਟਿ ਕਟਿ ਸੁਭਟ ਧਰਨਿ ਪਰ ਪਰਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਚਟਪਟ ਆਨਿ ਅਪਛਰਾ ਬਰਹੀ ॥੧੬॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਨਛੋਰੈ ਰਘੁਨਾਥ ਸਿੰਘ ਕੀਨੋ ਕੋਪ ਅਪਾਰ ॥",
