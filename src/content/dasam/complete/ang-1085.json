{
  "page": 1085,
  "lines": [
    {
      "t": "ਤੁਮ ਹਜਰਤਿ ਸੌ ਐਸ ਉਚਰੋ ॥੧੮॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਬਸਤ੍ਰ ਹਮਰੋ ਤੁਮ ਲੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਥਮ ਪਾਲਕੀ ਮੈ ਧਰਿ ਦੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਪਰ ਭਵਰ ਗੁੰਜਾਰਤ ਜੈ ਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਲੋਕ ਨਹਿ ਪੈ ਹੈ ॥੧੯॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਗੋਰੈ ਬਾਦਿਲ ਸੋਈ ਕਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਬਿਧਿ ਮੰਤ੍ਰ ਪਦੁਮਿਨੀ ਦਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਗੜ ਕੇ ਲਹਤ ਡੋਰਿਕਾ ਧਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਪਦੁਮਿਨਿ ਅਗ੍ਰ ਪਾਲਕੀ ਕਰੀ ॥੨੦॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਪਦਮਿਨਿ ਕੇ ਪਟ ਪਰ ਘਨੇ ਭਵਰ ਕਰੈ ਗੁੰਜਾਰ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਲੋਕ ਸਭੈ ਪਦੁਮਿਨਿ ਲਖੈ ਬਸਤ੍ਰ ਨ ਸਕੈ ਬਿਚਾਰਿ ॥੨੧॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਮੈ ਡਾਰਿ ਲੁਹਾਰਿਕ ਲਯੌ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੌ ਬਸਤ੍ਰ ਤਵਨ ਪਰ ਦਯੌ ॥",
      "s": 14
    },
    {
      "t": "ਛੈਨੀ ਔਰ ਹਥੌਰਾ ਲਏ ॥",
      "s": 14
    },
    {
      "t": "ਵਾ ਬਢਈ ਕੇ ਕਰ ਮੋ ਦਏ ॥੨੨॥",
      "s": 14
    },
    {
      "t": "ਦੂਤ ਦਿਲੀਸਹਿ ਬਚਨ ਉਚਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਗ੍ਰਿਹ ਆਵਤ ਪਦੁਮਿਨਿ ਤਿਹਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨਾ ਸਾਥ ਪ੍ਰਥਮ ਮਿਲਿ ਆਊ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਤਿਹਾਰੀ ਸੇਜ ਸੁਹਾਊ ॥੨੩॥",
      "s": 14
    },
    {
      "t": "ਯੌ ਕਹਿ ਬਢੀ ਤਹਾ ਚਲਿ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੀ ਕਟਤ ਬੇਰਿਯੈ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਪਾਲਕੀ ਪ੍ਰਥਮ ਬੈਠਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਤੇ ਓਹਿ ਡੋਰੀ ਪਹੁਚਾਯੋ ॥੨੪॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਤੇ ਨਿਕਰਿ ਅਵਰ ਮੋ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਨਤ ਤਹਾ ਤੇ ਨਿਕਸਤ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਤਹਾ ਪਹੂੰਚ੍ਯੋ ਜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਬੈ ਦੁਰਗ ਮੈ ਬਜੀ ਬਧਾਈ ॥੨੫॥",
      "s": 14
    },
    {
      "t": "ਗੜ ਪਰ ਜਬੈ ਬਧਾਈ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਊਅਨ ਕਾਢਿ ਕ੍ਰਿਪਾਨੈ ਲਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਪਰ ਪਹੁਚਿ ਖੜਗ ਕਹ ਝਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਏਕੈ ਘਾਇ ਮਾਰ ਹੀ ਡਾਰਿਯੋ ॥੨੬॥",
      "s": 14
    },
    {
      "t": "ਧੁਕਿ ਧੁਕਿ ਪਰੇ ਧਰਨਿ ਭਟ ਭਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁਕ ਕਰਵਤਨ ਬਿਰਛ ਬਿਦਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਜੁਝਿ ਜੁਝਿ ਮਰੈ ਅਧਿਕ ਰਿਸਿ ਭਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਨ ਦਿਖਯਤ ਤਾਜਿਯਨ ਚਰੇ ॥੨੭॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜੈਨ ਲਾਵਦੀ ਸਾਹ ਕੌ ਤਬ ਹੀ ਦਯੋ ਭਜਾਇ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਰਤਨ ਸੈਨ ਰਾਨਾ ਗਏ ਗੜ ਇਹ ਚਰਿਤ ਦਿਖਾਇ ॥੨੮॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਗੋਰਾ ਬਾਦਿਲ ਕੌ ਦਿਯੋ ਅਤਿ ਧਨ ਛੋਰਿ ਭੰਡਾਰ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤਾ ਦਿਨ ਤੈ ਪਦੁਮਿਨਿ ਭਏ ਬਾਢੀ ਪ੍ਰੀਤਿ ਅਪਾਰ ॥੨੯॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਨਿੰਨਾਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੯੯॥੩੭੨੭॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਗਤਿ ਦੇਸ ਏਸ੍ਵਰ ਬਡੋ ਦ੍ਰੁਗਤਿ ਸਿੰਘ ਇਕ ਭੂਪ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਦੇਗ ਤੇਗ ਪੂਰੋ ਪੁਰਖ ਸੁੰਦਰ ਕਾਮ ਸਰੂਪ ॥੧॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤੋਟਕ ਛੰਦ ॥",
      "s": 14
    },
    {
      "t": "ਉਡਗਿੰਦ੍ਰ ਪ੍ਰਭਾ ਇਕ ਤਾ ਕੀ ਤ੍ਰਿਯਾ ॥",
      "s": 14
