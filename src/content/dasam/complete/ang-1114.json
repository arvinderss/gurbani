    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਉਤੈ ਮੀਤ ਤਿਨ ਲਿਯੋ ਬੁਲਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਰੀਤਿ ਕਰਿ ਪ੍ਰੀਤੁਪਜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਕਰਿ ਕਰਿ ਕੁਵਤਿ ਸੇਜ ਚਰਕਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਹਾਥ ਤਨ ਘੰਟ ਬਜਾਵੈ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਤਾ ਕੌ ਰਤਿ ਕੀਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਜੜ ਧੁਨਿ ਘੰਟਾ ਕੀ ਚੀਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਕਛੂ ਨਹਿ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਦੁਹਿਤਾ ਕਸ ਕਰਮ ਕਮਾਯੋ ॥੧੨॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤਾ ਸੌ ਭੋਗ ਬਹੁਤ ਬਿਧਿ ਕੀਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਲਪਟਿ ਲਪਟਿ ਆਸਨ ਕਹ ਦੀਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਚੁੰਬਨ ਆਲਿੰਗਨ ਕੀਨੇ ਤਿਨ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਨ ਲਹਿਯੋ ਮੂੜ ਰਾਜੈ ਇਨ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਕੇਲ ਤਾ ਸੌ ਬਹੁ ਕਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰੋ ਛੋਰ ਦ੍ਵਾਰ ਕਹ ਦਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪਠੈ ਸਹਚਰੀ ਪਿਤਾ ਬੁਲਾਇਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮਨ ਮੈ ਅਧਿਕ ਜਾਰ ਦੁਖ ਪਾਯੋ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਕੌ ਪਿਤਾ ਮੋਹਿ ਗਹਿ ਲੈਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਹਮੈ ਜਮਪੁਰੀ ਪਠੈਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਚਿੰਤਾਤੁਰ ਥਰਹਰਿ ਕੰਪਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਜ੍ਯੋਂ ਕਦਲੀ ਕਹ ਬਾਤ ਡੁਲਾਵੈ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਜਾਰ ਬਾਚ ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਮੋਰੇ ਪ੍ਰਾਨ ਰਾਖਿ ਅਬ ਲੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਹਕ ਮੁਹਿ ਨ ਅਜਾਏ ਕੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਮੋਰੋ ਮੂੰਡਿ ਕਾਟ ਨ੍ਰਿਪ ਦੈਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਪਰਦੀ ਕੇ ਕੰਠ ਚੜੈਹੈ ॥੧੬॥",
      "s": 14
    },
    {
      "t": "ਸੁਤਾ ਬਾਚ ॥",
