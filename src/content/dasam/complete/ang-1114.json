      "s": 14
    },
    {
      "t": "ਧੀਰਜ ਚਿਤ ਆਪਨੇ ਧਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਤੇਰੋ ਅਬ ਮੈ ਪ੍ਰਾਨ ਉਬਰਿਹੌ ॥",
      "s": 14
    },
    {
      "t": "ਪਿਤ ਹੇਰਤ ਤੋ ਕੌ ਪਤਿ ਕਰਿਹੌ ॥੧੭॥",
