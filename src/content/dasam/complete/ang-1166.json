  "lines": [
    {
      "t": "ਸੁਨਹੁ ਸ੍ਰਵਨ ਧਰਿ ਕਥਾ ਪ੍ਯਾਰੇ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਪਤਿ ਦੇਖਤ ਕਹਿਯੋ ਭੋਗ ਕਮੈ ਹੌ ॥",
      "s": 14
    },
    {
      "t": "ਬ੍ਰਹਮ ਭੋਜ ਤਾ ਤੇ ਕਰਵੈ ਹੌ ॥",
      "s": 14
    },
    {
      "t": "ਜੀਯੋ ਮਤੀ ਤਬਹੂੰ ਤੁਮ ਜਨਿਯਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਮੋਰੀ ਸਾਚ ਕਹੀ ਤਬ ਮਨਿਯਹੁ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਯੌ ਕਹਿ ਬਚਨਨ ਬਹੁਰਿ ਉਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਪਤਿ ਗਯੋ ਜਬ ਹੀ ਅਨਤ ਨਿਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਬਾਢੀ ਤਿਹ ਬੋਲਿ ਪਠਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਤਿਹ ਸੰਗ ਕਮਾਯੋ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਜਾਟਿਨਿ ਭੋਗ ਜਬੈ ਜੜ ਆਯੋ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਆਨ ਰਮਤ ਲਖਿ ਤ੍ਰਿਯਹਿ ਰਿਸਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਢਿ ਕ੍ਰਿਪਾਨ ਮਹਾ ਪਸੁ ਧਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਰ ਤੇ ਪਕਰਿ ਸਹਚਰੀ ਲਯੋ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਜਾਰ ਏਕ ਉਠਿ ਲਾਤ ਪ੍ਰਹਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਗਿਰਤ ਭਯੋ ਪਸੁ ਪ੍ਰਿਥੀ ਮੰਝਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਹਿ ਛੀਨ ਤੈ ਉਠਿ ਨ ਸਕਤ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਰ ਪਤਰਿ ਭਾਜਿ ਜਾਤ ਭਯੋ ॥੧੦॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਉਠਤ ਭਯੋ ਮੂਰਖ ਬਹੁ ਕਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਪਾਇਨ ਆਇ ਲਗੀ ਤਬ ਬਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਜੌ ਪਿਯ ਮੁਰ ਅਪਰਾਧ ਬਿਚਾਰੋ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਕਾਢਿ ਕ੍ਰਿਪਾਨ ਮਾਰ ਹੀ ਡਾਰੋ ॥੧੧॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਜਿਨ ਨਿਰਭੈ ਤੁਹਿ ਲਾਤ ਪ੍ਰਹਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਵਹਿ ਆਗੈ ਮੈ ਕਵਨ ਬਿਚਾਰੀ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤੁਮ ਭੂਅ ਗਿਰੇ ਜਵਨ ਕੇ ਮਾਰੇ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਖਾਇ ਲੋਟਨੀ ਕਛੁ ਨ ਸੰਭਾਰੇ ॥੧੨॥",
