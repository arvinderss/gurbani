    },
    {
      "t": "ਬਲ ਸੌ ਦਾਬਿ ਰਾਨ ਤਰ ਦੀਨਾ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਮੋਰ ਧਰਮ ਪ੍ਰਭੁ ਆਪ ਬਚਾਯੋ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਜਾ ਤੇ ਦਰਸੁ ਤਿਹਾਰੋ ਪਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜੌ ਤੂੰ ਅਬ ਇਹ ਠੌਰ ਨ ਆਤੋ ॥",
      "s": 14
    },
    {
      "t": "ਜੋਰਾਵਰੀ ਜਾਰ ਭਜਿ ਜਾਤੋ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਮੁਰਿ ਏਕ ਪਰੀਛਾ ਲੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਤੇ ਦੂਰਿ ਚਿਤ ਭ੍ਰਮੁ ਕੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਮੂਤ੍ਰ ਜਰਤ ਜੌ ਦਿਯਾ ਨਿਹਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਹਸਿ ਹਸਿ ਮੁਹਿ ਸਾਥ ਬਿਹਾਰੋ ॥੧੬॥",
      "s": 14
    },
    {
      "t": "ਪਾਤ੍ਰ ਏਕ ਤਟ ਮੂਤ੍ਰਿਯੋ ਜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਮੈ ਰਾਖ ਤੇਲ ਕੋ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਪਿਯ ਮੁਰ ਚਿਤ ਤੋ ਸੌ ਅਤਿ ਡਰਾ ॥",
      "v": [
        [
          0,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਲਘੁ ਅਤਿ ਹੀ ਮੈ ਕਰਾ ॥੧੭॥",
      "s": 14
    },
    {
      "t": "ਲਘ ਕੋ ਕਰੈ ਪਾਤ੍ਰ ਸਭ ਭਰਾ ॥",
