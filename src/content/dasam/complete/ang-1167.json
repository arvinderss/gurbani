{
  "page": 1167,
  "lines": [
    {
      "t": "ਜਾ ਤੇ ਡਰਤ ਹਮਾਰੇ ਪ੍ਰਾਨਾ ॥੧੮॥",
      "s": 14
    },
    {
      "t": "ਵਹੀ ਤੇਲ ਭੇ ਦੀਪ ਜਗਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪਤਿ ਦੇਖਤ ਜਿਹ ਲਘੁ ਠਹਰਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਜੜ ਕਛੂ ਨ ਜਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੀਲਵਤੀ ਇਸਤ੍ਰੀ ਕਰ ਮਾਨਾ ॥੧੯॥",
      "s": 14
    },
    {
      "t": "ਰੀਝਿ ਬਚਨ ਇਹ ਭਾਤਿ ਉਚਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੈ ਤੇਰੋ ਸਤ ਸਾਚੁ ਨਿਹਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਚੇਰਾ ਮੈ ਭਯੋ ਤਿਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੋ ਸੁ ਕਰੌ ਕਾਜ ਬਹੁ ਹਾਰਾ ॥੨੦॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਮੂਤ੍ਰ ਭਏ ਤੈ ਦੀਪ ਜਗਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਚਮਤਕਾਰ ਇਹ ਹਮੈ ਦਿਖਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪਟੁਕਾ ਡਾਰਿ ਗ੍ਰੀਵ ਪਗ ਪਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਘਰੀ ਚਾਰਿ ਲਗਿ ਨਾਕ ਰਗਰਾ ॥੨੧॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਰਿਸਾਲੂ ਨਿਰਖ੍ਰਯੋ ਆਂਖਿਨ ਐਸ ਚਰਿਤ੍ਰ ॥",
      "s": 14
    },
    {
      "t": "ਕੈ ਹਮ ਆਜੁ ਬਿਲੋਕਿਯੋ ਸਾਚ ਕਹਤ ਤ੍ਰਿਯ ਮਿਤ੍ਰ ॥੨੨॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਤੂ ਕਹੈ ਜੁ ਮੁਹਿ ਸੋਈ ਕਰੌ ॥",
      "v": [
        [
          3,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਹ੍ਵੈ ਕਰ ਦਾਸ ਨੀਰ ਤਵ ਭਰੌ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਹਸਿ ਹਸਿ ਤ੍ਰਿਯ ਕੌ ਗਰੇ ਲਗਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਕਛੂ ਮੂਰਖ ਨਹਿ ਪਾਵੈ ॥੨੩॥",
      "s": 14
    },
    {
      "t": "ਬਿਹਸਿ ਨਾਰਿ ਇਹ ਭਾਤਿ ਉਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਬ੍ਰਹਮ ਭੋਜ ਕਰੁ ਨਾਥ ਸ ਭਾਰਾ ॥",
      "v": [
        [
          3,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਭਲੀ ਭਾਤਿ ਦਿਜ ਪ੍ਰਿਥਮ ਜਿਵਾਵੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰੋ ਸੇਜ ਹਮਾਰੀ ਆਵੋ ॥੨੪॥",
      "s": 14
    },
    {
      "t": "ਕਛੂ ਨ ਲਖਾ ਦੈਵ ਕੇ ਮਾਰੇ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਬ੍ਰਹਮ ਭੋਜ ਕਹ ਕਿਯਾ ਸਵਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਭਲੀ ਭਾਤਿ ਦਿਜ ਪ੍ਰਥਮ ਜਿਵਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਨਾਰਿ ਕੀ ਸੇਜ ਸਿਧਾਏ ॥੨੫॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਤ੍ਰਿਯ ਕਹੀ ਵਹੈ ਗਤਿ ਕੀਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਜੀਤਿ ਹੋਡ ਨਨਦਿ ਤੇ ਲੀਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਤੇਲ ਮੂਤ੍ਰ ਕਹਿ ਦੀਪ ਜਗਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬ੍ਰਹਮ ਦੰਡ ਪਤਿ ਤੇ ਕਰਵਾਯੋ ॥੨੬॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਹਰੀਫ ਕਹਾਵਤ ਹੁਤੋ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਲਿ ਨ ਭਾਗਹਿ ਪੀਵਤ ਸੁਤੋ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਚਰਿਤ੍ਰ ਕਰਿ ਦ੍ਰਿਗਨ ਦਿਖਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਸੌ ਵਹਿ ਤ੍ਰਿਯ ਡਹਕਾਯੋ ॥੨੭॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਥਮ ਭੋਗ ਪਿਯ ਲਖਤ ਕਮਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਰਿ ਮੂਤ੍ਰ ਭੇ ਦੀਪ ਦਖਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬ੍ਰਹਮ ਭੋਜ ਉਲਟੋ ਤਾ ਪਰ ਕਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਪਤਿ ਜਾਨੀ ਪਤਿਬ੍ਰਤਾ ਤ੍ਰਿਯਾ ਘਰ ॥੨੮॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਤਿਰਪਨ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੫੩॥੪੭੭੦॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਬੇਸ੍ਵਾ ਏਕ ਠੌਰ ਇਕ ਸੁਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਪਾਤ੍ਰ ਕਲਾ ਨਾਮਾ ਬਹੁ ਗੁਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਤਰੁਨਿ ਕੀ ਦਿਪਤਿ ਬਿਰਾਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਰੰਭਾ ਕੋ ਨਿਰਖਤ ਮਨ ਲਾਜੈ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਬਿਸਨ ਕੇਤੁ ਇਕ ਰਾਇ ਤਹਾ ਕੋ ॥",
      "s": 14
    }
  ]
}
