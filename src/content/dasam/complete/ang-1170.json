  "lines": [
    {
      "t": "ਸਰਿਤਾ ਬਹੁਤ ਬਹਤ ਜਿਹ ਬਨ ਮੈ ॥",
      "s": 14
    },
    {
      "t": "ਝਰਨਾ ਚਲਤ ਲਗਤ ਸੁਖ ਮਨ ਮੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੋਭਾ ਅਧਿਕ ਨ ਬਰਨੀ ਜਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖੇ ਹੀ ਆਭਾ ਬਨਿ ਆਵੈ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਹੀ ਜਾਤ ਭਯਾ ਸੋ ਰਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੀ ਪ੍ਰਭਾ ਨ ਬਰਨੀ ਜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਮਰਤ ਭਯੋ ਮ੍ਰਿਗਹਿ ਲੈ ਤਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਵ ਦੈਂਤ ਜਾ ਨਿਰਖਤ ਜਹਾ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਵ ਦਾਨਵਨ ਕੀ ਸੁਤਾ ਜਿਹ ਬਨ ਸੇਵਤ ਨਿਤ੍ਯ ॥",
      "s": 14
    },
    {
      "t": "ਸਦਾ ਬਸਾਯੋ ਰਾਖ ਹੀ ਤਾਹਿ ਚਿਤ ਜ੍ਯੋ ਮਿਤ੍ਰਯ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਛ ਗੰਧ੍ਰਬੀ ਅਤਿ ਉਨਮਦਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੇਵਤ ਹੈਂ ਤਿਹ ਬਨ ਕੌ ਸਦਾ ॥",
      "s": 14
    },
    {
      "t": "ਨਰੀ ਨਾਗਨੀ ਕੌ ਚਿਤ ਲ੍ਯਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਨਟੀ ਨ੍ਰਿਤਕਾ ਕੌਨ ਗਨਾਵੈ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਕੀ ਦੁਤਿ ਤਿਨ ਹੀ ਬਨੀ ਕੋ ਕਬਿ ਸਕਤ ਬਤਾਇ ॥",
      "v": [
        [
          5,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਲਖੇ ਲਗਨ ਲਾਗੀ ਰਹੈ ਪਲਕ ਨ ਜੋਰੀ ਜਾਇ ॥੧੩॥",
