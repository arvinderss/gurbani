      "s": 14
    },
    {
      "t": "ਚਿਤ ਕੇ ਤਾਪ ਬਿਦਾ ਕਰਿ ਦੀਏ ॥੭੫॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕੁਅਰਿ ਸਜਨ ਸੋ ਰਤਿ ਕਰਤ ਰੀਝ ਰਹੀ ਮਨ ਮਾਹਿ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਵਹਿ ਦਿਨ ਪੂਜਾ ਰੁਦ੍ਰ ਕੀ ਭੂਲਿ ਕਰੀ ਤਿਨ ਨਾਹਿ ॥੭੬॥",
      "v": [
