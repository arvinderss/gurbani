{
  "page": 1201,
  "lines": [
    {
      "t": "ਦਿਜ ਬਾਚ ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਦਿਜ ਅਧਿਕ ਕੋਪ ਹ੍ਵੈ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭਰਭਰਾਇ ਠਾਢਾ ਉਠਿ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਮੈ ਇਹ ਰਾਜਾ ਪੈ ਜੈਹੌ ॥",
      "s": 14
    },
    {
      "t": "ਤਹੀ ਬਾਧਿ ਕਰਿ ਤੋਹਿ ਮੰਗੈ ਹੌ ॥੧੧੯॥",
      "s": 14
    },
    {
      "t": "ਕੁਅਰਿ ਬਾਚ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤਿਨ ਕੁਅਰਿ ਦਿਜਹਿ ਗਹਿ ਲਿਆ ॥",
      "s": 14
    },
    {
      "t": "ਡਾਰ ਨਦੀ ਕੇ ਭੀਤਰ ਦਿਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਗੋਤਾ ਪਕਰਿ ਆਠ ਸੈ ਦੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਪਵਿਤ੍ਰ ਭਲੀ ਬਿਧਿ ਕੀਨਾ ॥੧੨੦॥",
      "s": 14
    },
    {
      "t": "ਕਹੀ ਕੁਅਰਿ ਪਿਤੁ ਪਹਿ ਮੈ ਜੈ ਹੌਂ ॥",
      "s": 14
    },
    {
      "t": "ਤੈ ਮੁਹਿ ਡਾਰਾ ਹਾਥ ਬਤੈ ਹੌਂ ॥",
      "s": 14
    },
    {
      "t": "ਤੇਰੇ ਦੋਨੋ ਹਾਥ ਕਟਾਊਾਂ ॥",
      "s": 14
    },
    {
      "t": "ਤੌ ਰਾਜਾ ਕੀ ਸੁਤਾ ਕਹਾਊਾਂ ॥੧੨੧॥",
      "s": 14
    },
    {
      "t": "ਦਿਜ ਵਾਚ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਸੁਨਿ ਬਾਤ ਮਿਸ੍ਰ ਡਰ ਪਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਲਾਗਤ ਪਾਇ ਕੁਅਰਿ ਕੇ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੋਊ ਕਰੋ ਜੁ ਮੋਹਿ ਉਚਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਮ ਨਿਜੁ ਜਿਯ ਤੇ ਕੋਪ ਨਿਵਾਰੋ ॥੧੨੨॥",
      "s": 14
    },
    {
      "t": "ਕੁਅਰਿ ਬਾਚ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਮ ਕਹਿਯਹੁ ਮੈ ਪ੍ਰਥਮ ਅਨਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਧਨ ਨਿਮਿਤਿ ਮੈ ਦਰਬੁ ਲੁਟਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪਾਹਨ ਕੀ ਪੂਜਾ ਨਹਿ ਕਰਿਯੈ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਕਾਲ ਕੇ ਪਾਇਨ ਪਰਿਯੈ ॥੧੨੩॥",
      "s": 14
    },
    {
      "t": "ਕਬਿਯੋ ਬਾਚ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਦਿਜ ਮਹਾ ਕਾਲ ਕੋ ਧ੍ਰਯਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਰਿਤਾ ਮਹਿ ਪਾਹਨਨ ਬਹਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੂਜੇ ਕਾਨ ਨ ਕਿਨਹੂੰ ਜਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਾ ਮਿਸ੍ਰ ਪਰ ਹਾਲ ਬਿਹਾਨਾ ॥੧੨੪॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਸੌ ਮਿਸਰਹਿ ਛਲਾ ਪਾਹਨ ਦਏ ਬਹਾਇ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਮਹਾ ਕਾਲ ਕੋ ਸਿਖ੍ਯ ਕਰਿ ਮਦਰਾ ਭਾਗ ਪਿਵਾਇ ॥੧੨੫॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਛਿਆਸਠਿ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੬੬॥੫੧੯੫॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਰੂਪ ਸੈਨ ਇਕ ਨ੍ਰਿਪਤਿ ਸੁਲਛਨ ॥",
      "s": 14
    },
    {
      "t": "ਤੇਜਵਾਨ ਬਲਵਾਨ ਬਿਚਛਨ ॥",
      "s": 14
    },
    {
      "t": "ਸਕਲ ਮਤੀ ਤਾ ਕੇ ਘਰ ਦਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਸਮ ਕਹੂੰ ਨ ਰਾਜ ਕੁਮਾਰਾ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਤਹਿ ਇਕ ਬਸੈ ਤੁਰਕਨੀ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਸਮ ਰੂਪ ਨ ਮੈਨ ਦੁਲਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਰਾਜਾ ਕੀ ਛਬਿ ਨਿਰਖੀ ਜਬ ॥",
      "s": 14
    },
    {
      "t": "ਮੋਹਿ ਰਹੀ ਤਰੁਨੀ ਤਾ ਪਰ ਤਬ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਰੂਪ ਸੈਨ ਪਹਿ ਸਖੀ ਪਠਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਲਗੀ ਲਗਨ ਤੁਹਿ ਸਾਥ ਜਤਾਈ ॥",
      "v": [
        [
          3,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਕ ਦਿਨ ਮੁਰਿ ਕਹਿਯੋ ਸੇਜ ਸੁਹੈਯੈ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਥ ਸਨਾਥ ਅਨਾਥਹਿ ਕੈਯੈ ॥੩॥",
      "v": [
        [
          0,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਮਿ ਦੂਤੀ ਪ੍ਰਤਿ ਨ੍ਰਿਪਤਿ ਉਚਾਰਾ ॥",
      "s": 14
    }
  ]
}
