{
  "page": 1202,
  "lines": [
    {
      "t": "ਤ੍ਰਿਯ ਆਗੇ ਪਤਿ ਜਿਯਤ ਤਿਹਾਰਾ ॥",
      "v": [
        [
          0,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਜੌ ਤੌ ਪ੍ਰਥਮ ਕਾਜਿਯਹਿ ਮਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਪਾਛੇ ਮੁਹਿ ਸੰਗਿ ਬਿਹਾਰੈ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਿ ਸਹਚਰਿ ਤਿਹ ਜਾਇ ਜਤਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਹਮ ਕੋ ਇਮਿ ਭਾਖ ਸੁਨਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜੌ ਤੈ ਪ੍ਰਥਮ ਕਾਜਿਯਹਿ ਘਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਉਪਰਾਤ ਬਹੁਰਿ ਮੁਹਿ ਪਾਵੈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਿ ਤ੍ਰਿਯ ਬਾਤ ਚਿਤ ਮਹਿ ਰਾਖੀ ॥",
      "s": 14
    },
    {
      "t": "ਔਰ ਨ ਕਿਸੀ ਔਰਤਹਿ ਭਾਖੀ ॥",
      "s": 14
    },
    {
      "t": "ਰੈਨਿ ਸਮੈ ਕਾਜੀ ਜਬ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਢਿ ਕ੍ਰਿਪਾਨ ਸੋਵਤਹਿ ਘਾਯੋ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੋ ਕਾਟਿ ਮੂੰਡ ਕਰਿ ਲਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਲੈ ਰਾਜਾ ਕੇ ਹਾਜਰ ਕਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਵ ਨਿਮਿਤ ਕਾਜੀ ਮੈ ਘਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਮੁਹਿ ਸੰਗ ਕਰੋ ਮਨ ਭਾਯੋ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਸਿਰ ਨਿਰਖਿ ਨ੍ਰਿਪਤਿ ਤਿਹ ਲਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮਨ ਕੇ ਬਿਖੈ ਅਧਿਕ ਡਰ ਪਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪਤਿ ਮਾਰਤ ਜਿਹ ਲਗੀ ਨ ਬਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਾ ਉਪਪਤਿ ਤਿਹ ਅਗ੍ਰ ਬਿਚਾਰਾ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਧਿਕ ਧਿਕ ਬਚ ਤਿਹ ਤ੍ਰਿਯਹ ਉਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਭੋਗ ਕਰਬ ਮੈ ਤਜਾ ਤਿਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯ ਪਾਪਨਿ ਤੈ ਭਰਤਾ ਘਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਮੋਹਿ ਅਧਿਕ ਡਰ ਆਯੋ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਤੈ ਜਾਹਿ ਪਾਪਨੀ ਤਹੀ ॥",
      "v": [
        [
          3,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਨਿਜ ਕਰ ਨਾਥ ਸੰਘਾਰਾ ਜਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਤੇਰੋ ਸਭ ਹੀ ਧ੍ਰਿਗ ਸਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਹੀ ਲਗਿ ਜੀਵਤ ਨਿਰਲਾਜਾ ॥੧੦॥",
      "v": [
        [
          3,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਹਿਤ ਮੇਰੇ ਜਿਨ ਪਤਿ ਹਨਾ ਕੀਨਾ ਬਡਾ ਕੁਕਾਜ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਜਮਧਰ ਮਾਰਿ ਨ ਮਰਤ ਹੈ ਅਬ ਲੌ ਜਿਯਤ ਨਿਲਾਜ ॥੧੧॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਤ ਬਚਨ ਏ ਨਾਰਿ ਰਿਸਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਲਜਿਤ ਭਈ ਘਰ ਕੋ ਫਿਰੀ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਪਤਿ ਕੋ ਮੂੰਡ ਤਿਸੀ ਘਰ ਡਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਆਇ ਧਾਮ ਇਸ ਭਾਤਿ ਪੁਕਾਰਾ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਾਤ ਭਏ ਸਭ ਲੋਗ ਬੁਲਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਸਭਹਿਨ ਕਾਜੀ ਮ੍ਰਿਤਕ ਦਿਖਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੋਨਤ ਧਾਰ ਪਰਤ ਜਿਹ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਮਗੁ ਹ੍ਵੈ ਕਰਿ ਖੋਜਤ ਭਈ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਜਹ ਜਹ ਜਾਇ ਸ੍ਰੋਨ ਕੀ ਧਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਹੇਰਤ ਜਨ ਚਲੇ ਅਪਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਸਭਹੂੰ ਲੈ ਠਾਢੋ ਕੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਹ ਨਿਜੁ ਹਾਥ ਡਾਰਿ ਸਿਰ ਦੀਨਾ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਮੂੰਡ ਕਟ੍ਯੋ ਸਭਹਿਨ ਲਖਿ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਕਾਜੀ ਯਾਹੀ ਨ੍ਰਿਪ ਘਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕਹ ਬਾਧਿ ਲੈ ਗਏ ਤਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਹਾਗੀਰ ਬੈਠਾ ਥੋ ਜਹਾ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਬ੍ਰਿਤਾਤ ਕਹਿ ਪ੍ਰਥਮ ਸੁਨਾਯੋ ॥",
      "s": 14
    }
  ]
}
