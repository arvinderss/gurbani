{
  "page": 1203,
  "lines": [
    {
      "t": "ਇਹ ਕਾਜੀ ਰਾਜੈ ਇਨ ਘਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਹਜਰਤਿ ਬਾਧਿ ਤ੍ਰਿਯਹਿ ਕਹ ਦੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਕਛੂ ਜਿਯ ਮਾਝ ਨ ਚੀਨਾ ॥੧੬॥",
      "s": 14
    },
    {
      "t": "ਮਾਰਨ ਕੌ ਲੈ ਤਾਹਿ ਸਿਧਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਆਂਖਿਨ ਹੀ ਮਹਿ ਨ੍ਰਿਪਹਿ ਜਤਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਮੁਰ ਜਿਯ ਰਾਖੁ ਕਹੈ ਸੌ ਕਰਿ ਹੌ ॥",
      "s": 14
    },
    {
      "t": "ਲੈ ਘਟ ਸੀਸ ਪਾਨਿ ਕੌ ਭਰਿ ਹੌ ॥੧੭॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਸੁੰਦਰਿ ਇਹ ਭਾਤਿ ਬਿਚਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਮਾਨਾ ਨ੍ਰਿਪ ਕਹਾ ਹਮਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੌ ਛਾਡਿ ਹਾਥ ਤੇ ਦੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਖੂਨ ਬਖਸ੍ਯੋ ਮੈ ਇਹ ਕੀਨਾ ॥੧੮॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਥਮਹਿ ਛਾਡਿ ਮਿਤ੍ਰ ਕਹ ਦੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਪੁਨ ਇਹ ਭਾਤਿ ਉਚਾਰਨ ਕੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਮੈ ਸੈਰ ਮਕਾ ਕੇ ਜੈ ਹੌ ॥",
      "s": 14
    },
    {
      "t": "ਮਰੀ ਤ ਗਈ ਜਿਯਤ ਫਿਰਿ ਐ ਹੌ ॥੧੯॥",
      "s": 14
    },
    {
      "t": "ਲੋਗਨ ਸੈਰ ਭਵਾਰੋ ਦਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਆਪੁ ਪੈਂਡ ਤਿਹ ਗ੍ਰਿਹ ਕੌ ਲਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਨਿਰਖਿ ਰਾਜਾ ਡਰਪਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਤਿਹ ਸੰਗ ਕਮਾਨਾ ॥੨੦॥",
      "s": 14
    },
    {
      "t": "ਲੋਗ ਕਹੈ ਮਕਾ ਕਹ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਹੁਆਂ ਕੀ ਸੁਧਿ ਕਿਨਹੂੰ ਨਹਿ ਲਈ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਾ ਬਾਲ ਇਨ ਚਰਿਤ ਦਿਖਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਹ ਛਲ ਸੌ ਕਾਜੀ ਕਹ ਘਾਯੋ ॥੨੧॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਸਾਥ ਕਾਜਿਯਹਿ ਮਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਮਿਤ੍ਰ ਕਹ ਚਰਿਤ ਦਿਖਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਨ ਕੀ ਅਗਮ ਅਗਾਧਿ ਕਹਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਦਾਨਵ ਦੇਵ ਨ ਕਿਨਹੂੰ ਜਾਨੀ ॥੨੨॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਸਤਸਠਿ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੬੭॥੫੨੧੭॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਚੰਪਾਵਤੀ ਨਗਰ ਦਿਸਿ ਦਛਿਨ ॥",
      "s": 14
    },
    {
      "t": "ਚੰਪਤ ਰਾਇ ਨ੍ਰਿਪਤਿ ਸੁਭ ਲਛਨ ॥",
      "s": 14
    },
    {
      "t": "ਚੰਪਾਵਤੀ ਧਾਮ ਤਿਹ ਦਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਸਮ ਕਹੂੰ ਨ ਰਾਜ ਦੁਲਾਰਾ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਚੰਪਕਲਾ ਦੁਹਿਤਾ ਤਾ ਕੇ ਗ੍ਰਿਹ ॥",
      "s": 14
    },
    {
      "t": "ਰੂਪਮਾਨ ਦੁਤਿਮਾਨ ਅਧਿਕ ਵਹ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਤਿਹ ਅੰਗ ਮੈਨਤਾ ਵਈ ॥",
      "s": 14
    },
    {
      "t": "ਲਰਿਕਾਪਨ ਕੀ ਸੁਧਿ ਬੁਧਿ ਗਈ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਹੁਤੋ ਬਾਗ ਇਕ ਤਹਾ ਅਪਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਸਰ ਨੰਦਨ ਕਹਾ ਬਿਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਹਾ ਗਈ ਵਹੁ ਕੁਅਰਿ ਮੁਦਿਤ ਮਨ ॥",
      "s": 14
    },
    {
      "t": "ਲਏ ਸੁੰਦਰੀ ਸੰਗ ਕਰਿ ਅਨਗਨ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਨਿਰਖਾ ਇਕ ਸਾਹ ਸਰੂਪਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੂਰਤਿ ਸੀਰਤਿ ਮਾਝਿ ਅਨੂਪਾ ॥",
      "s": 14
    },
    {
      "t": "ਰੀਝੀ ਕੁਅਰਿ ਅਟਕਿ ਗੀ ਤਬ ਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੁੰਦਰ ਸੁਘਰ ਨਿਹਾਰਿਯੋ ਜਬ ਹੀ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਸੁਧਿ ਭੂਲਿ ਸਦਨ ਕੀ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਆਠ ਟੂਕ ਤਿਹ ਉਪਰ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਗ੍ਰਿਹ ਐਬੇ ਕੀ ਬੁਧਿ ਨ ਆਈ ॥",
      "s": 14
    }
  ]
}
