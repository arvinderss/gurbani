{
  "page": 1204,
  "lines": [
    {
      "t": "ਤਹੀ ਉਧਰਿ ਤਿਹ ਸੰਗ ਸਿਧਾਈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਸਹਚਰਿ ਭੇਦ ਚਰਿਤ ਇਕ ਜਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਸਾਥ ਚਰਿਤ੍ਰ ਪ੍ਰਮਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਰੋਇ ਰੋਇ ਧੁਨਿ ਊਚ ਪੁਕਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਦੈ ਦੈ ਮੂੰਡ ਧਰਨਿ ਸੌ ਮਾਰੈ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਚੰਪਕਲਾ ਰਾਜਾ ਕੀ ਜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਛਸ ਗਹੀ ਆਨਿ ਦੁਖਦਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਛੁਰੈਯੈ ਜਾਨ ਨ ਦੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਬੇਗਹਿ ਬਧ ਦਾਨਵ ਕੋ ਕੀਜੈ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਏ ਸੁਨਿ ਬੈਨ ਲੋਗ ਸਭ ਧਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਢੇ ਖੜਗ ਬਾਗ ਮੈ ਆਏ ॥",
      "s": 14
    },
    {
      "t": "ਦੈਤ ਵੈਤ ਤਹ ਕਛੁ ਨ ਨਿਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਚਕ੍ਰਿਤ ਭੇ ਜਿਯ ਮਾਝ ਬਿਚਾਰਾ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਹਰਿ ਦਾਨਵ ਤਿਹ ਗਯੋ ਅਕਾਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਕੁਅਰਿ ਤੇ ਭਏ ਨਿਰਾਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਰੋਇ ਪੀਟ ਦੁਹਿਤਾ ਕਹ ਹਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜਾ ਭਏ ਅਧਿਕ ਦੁਖਿਯਾਰੇ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਕੇਤਿਕ ਦਿਨਨ ਸਕਲ ਧਨ ਖਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਸ ਬਿਦੇਸ ਫਿਰਤ ਦੁਖ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਕੁਅਰਿ ਮਿਤ੍ਰਹਿ ਕੌ ਤ੍ਯਾਗੀ ॥",
      "s": 14
    },
    {
      "t": "ਆਧੀ ਰਤਿ ਦੇਸ ਕੌ ਭਾਗੀ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਲਿਖਿ ਪਤ੍ਰੀ ਪਿਤ ਪਾਸ ਪਠਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਦਾਨਵ ਤੇ ਮੈ ਦੇਵ ਛੁਰਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਪਠੈ ਮਨੁਛ ਅਬ ਬੋਲਿ ਪਠਾਵਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਮੋਹਿ ਮਿਲਾਇ ਅਧਿਕ ਸੁਖ ਪਾਵਹੁ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਪੜਿ ਪਤ੍ਰੀ ਪਿਤ ਕੰਠ ਲਗਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਪਾਲਕੀ ਤਹਾ ਪਠਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਚੰਪਕਲਾ ਕਹ ਗ੍ਰਿਹ ਲੈ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੂਰਖ ਭੇਦ ਅਭੇਦ ਨ ਪਾਯੋ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਅਠਸਠ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੬੮॥੫੨੨੯॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਗੂਆ ਬੰਦਰ ਇਕ ਰਹਤ ਨ੍ਰਿਪਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੋ ਡੰਡ ਭਰਤ ਭੂਆਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਪ੍ਰਮਾਨ ਤਾ ਕੇ ਘਰ ਮੈ ਧਨ ॥",
      "s": 14
    },
    {
      "t": "ਚੰਦ੍ਰ ਸੂਰ ਕੈ ਇੰਦ੍ਰ ਦੁਤਿਯ ਜਨੁ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਮਿਤ੍ਰ ਮਤੀ ਤਾ ਕੀ ਅਰਧੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਪੁੰਨ੍ਰਯਮਾਨ ਦੂਸਰ ਜਨੁ ਗੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਮੀਨ ਕੇਤੁ ਰਾਜਾ ਤਹ ਰਾਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੋ ਨਿਰਖਿ ਮੀਨ ਧੁਜ ਲਾਜੈ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਅੜਿਲ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਝਖਕੇਤੁ ਮਤੀ ਦੁਹਿਤਾ ਤਿਹ ਜਾਨਿਯੈ ॥",
      "v": [
        [
          2,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਅਪ੍ਰਮਾਨ ਅਬਲਾ ਕੀ ਪ੍ਰਭਾ ਪ੍ਰਮਾਨਿਯੈ ॥",
      "v": [
        [
          2,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਜਾ ਸਮ ਸੁੰਦਰਿ ਕਹੂੰ ਨ ਜਗ ਮਹਿ ਜਾਨਿਯਤ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਹੋ ਰੂਪਮਾਨ ਉਹਿ ਕੀ ਸੀ ਵਹੀ ਬਖਾਨਿਯਤ ॥੩॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਾਤ ਭਏ ਨ੍ਰਿਪ ਸਭਾ ਲਗਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਊਚ ਨੀਚ ਸਭ ਲਿਯਾ ਬੁਲਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਇਕ ਪੁਤ੍ਰ ਸਾਹੁ ਕੋ ਆਯੋ ॥",
      "s": 14
    }
  ]
