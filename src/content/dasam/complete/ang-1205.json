{
  "page": 1205,
  "lines": [
    {
      "t": "ਜਿਹ ਸਮ ਦਿਤਿ ਆਦਿਤਿ ਨ ਜਾਯੋ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਅੜਿਲ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਕੁਅਰਿ ਰਹੀ ਥਕਿਤ ਸੁ ਤਾਹਿ ਨਿਹਾਰਿ ਕਰਿ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚਕ੍ਰਿਤ ਚਿਤ ਮਹਿ ਰਹੀ ਚਰਿਤ੍ਰ ਬਿਚਾਰਿ ਕਰਿ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸਖੀ ਪਠੀ ਤਿਹ ਧਾਮ ਮਿਲਨ ਕੀ ਆਸ ਕੈ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਹੋ ਚਾਹ ਰਹੀ ਜਸ ਮੇਘ ਪਪਿਹਰਾ ਪ੍ਯਾਸ ਕੈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਤਿ ਪ੍ਰਸੰਨ੍ਯ ਚਿਤ ਮਹਿ ਭਈ ਮਨ ਭਾਵਨ ਕਹ ਪਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਸਹਚਰਿ ਕੋ ਜੁ ਦਰਦ੍ਰਿ ਥੋ ਤਤਛਿਨ ਦਿਯਾ ਮਿਟਾਇ ॥੬॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਹੀ ਤਰੁਨਿ ਤਰੁਨ ਕੌ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਤਿਨ ਗਰੇ ਲਗਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰੈਨਿ ਸਗਰਿ ਰਤਿ ਕਰਤ ਬਿਹਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਚਾਰਿ ਪਹਰ ਪਲ ਚਾਰ ਪਛਾਨੀ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਪਿਛਲੀ ਪਹਰ ਰਾਤ੍ਰਿ ਜਬ ਰਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਕੁਅਰਿ ਐਸੇ ਤਿਹ ਕਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਹਮ ਤੁਮ ਆਵ ਨਿਕਸਿ ਦੋਊ ਜਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਔਰ ਦੇਸ ਦੋਊ ਕਹੂੰ ਸੁਹਾਵੈ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਤੁਹਿ ਮੁਹਿ ਕਹ ਧਨ ਕੀ ਥੁਰ ਨਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਮਰੀ ਚਹਤ ਕੁਸਲ ਮਨ ਮਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਯੌ ਕਹਿ ਦੁਹੂੰ ਅਧਿਕ ਧਨੁ ਲੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਔਰੇ ਦੇਸ ਪਯਾਨਾ ਕੀਨਾ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਚਤੁਰਿ ਭੇਦ ਸਹਚਰਿ ਇਕ ਪਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਗ੍ਰਿਹ ਕੋ ਦਈ ਆਗਿ ਲਗਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਰਨਿਯਨਿ ਰਾਨੀ ਜਰੀ ਸੁਨਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਰੋਵਤ ਆਪੁ ਨ੍ਰਿਪਹਿ ਪਹਿ ਧਾਈ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਕਹਾ ਨ੍ਰਿਪਹਿ ਜਰਿ ਮਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਮ ਤਾ ਕੀ ਕਛੁ ਸੁਧਿ ਨ ਕਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਤਿਨ ਕੇ ਚਲਿ ਅਸਤਿ ਉਠਾਵੌ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਨੁਖ ਦੈ ਗੰਗਾ ਪਹੁਚਾਵੌ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਸੁਨਿ ਬਚਨ ਉਤਾਇਲ ਧਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਹ ਗ੍ਰਿਹ ਜਰਤ ਹੁਤੋ ਤਹ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਹਹਾ ਕਰਤ ਰਾਨੀਯਹਿ ਨਿਕਾਰਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਜਰਤਿ ਅਗਨਿ ਤੇ ਯਾਹਿ ਉਬਾਰਹੁ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਜਾਨੀ ਜਰੀ ਅਗਨਿ ਮਹਿ ਰਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਉਧਲਿ ਗਈ ਮਨ ਬਿਖੈ ਨ ਆਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਸੋਕ ਮਨ ਮਾਹਿ ਬਢਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਜਾ ਸਹਿਤ ਕਛੁ ਭੇਦ ਨ ਪਾਯੋ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਧਨਿ ਧਨਿ ਇਹ ਰਾਨੀ ਕੋ ਧਰਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਨ ਅਸਿ ਕੀਨਾ ਦੁਹਕਰਿ ਕਰਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਲਜਾ ਨਿਮਿਤ ਪ੍ਰਾਨ ਦੈ ਡਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਰਿ ਕਰਿ ਮਰੀ ਨ ਰੌਰਨ ਪਾਰਾ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਉਨਹਤਰਿ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੬੯॥੫੨੪੩॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਮੋਰੰਗ ਦਿਸਿ ਇਕ ਰਹਤ ਨ੍ਰਿਪਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੇ ਦਿਪਤ ਤੇਜ ਕੀ ਜ੍ਵਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਪੂਰਬ ਦੇ ਤਿਹ ਨਾਰਿ ਭਣਿਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਕੋ ਅਬਲਾ ਪਟਤਰ ਤਿਹ ਦਿਜੈ ॥੧॥",
      "s": 14
    }
  ]
}
