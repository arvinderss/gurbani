{
  "page": 1206,
  "lines": [
    {
      "t": "ਪੂਰਬ ਸੈਨ ਨ੍ਰਿਪਤਿ ਕੋ ਨਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਨ ਜੀਤੇ ਅਨਗਨ ਸੰਗ੍ਰਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੇ ਚੜਤ ਅਮਿਤ ਦਲ ਸੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਹੈ ਗੈ ਰਥ ਪੈਦਲ ਚਤੁਰੰਗਾ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਇਕ ਆਯੋ ਸਾਹ ਅਪਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੇ ਸੰਗ ਇਕ ਪੁਤ੍ਰ ਪ੍ਯਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੋ ਰੂਪ ਕਹੈ ਨਹੀ ਆਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਊਖ ਲਿਖਤ ਲੇਖਨ ਹ੍ਵੈ ਜਾਵੈ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਪੂਰਬ ਦੇ ਤਿਹ ਊਪਰ ਅਟਕੀ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਲਿ ਗਈ ਸਭ ਹੀ ਸੁਧਿ ਘਟਿ ਕੀ ॥",
      "s": 14
    },
    {
      "t": "ਲਗਿਯੋ ਕੁਅਰ ਸੋ ਨੇਹ ਅਪਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਬਿਨੁ ਰੁਚੈ ਨ ਭੋਜਨ ਬਾਰਾ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਦਿਵਸ ਤਿਹ ਬੋਲਿ ਪਠਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਕੇਲ ਰੁਚਿ ਮਾਨਿ ਕਮਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਹੂੰਅਨ ਐਸੇ ਬਧਾ ਸਨੇਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਨ ਕੋ ਭਾਖਿ ਨ ਆਵਤ ਨੇਹਾ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਸਾਹੁ ਪੁਤ੍ਰ ਤਬ ਸਾਹੁ ਬਿਸਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੇ ਸਦਾ ਰਹਿਤ ਜਿਯ ਧਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪਿਤਾ ਸੰਗ ਕਛੁ ਕਲਹ ਬਢਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਚੜਿ ਘੋਰਾ ਪਰਦੇਸ ਸਿਧਾਯੋ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਅੜਿਲ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯ ਨਿਮਿਤ ਨਿਜੁ ਪਿਤੁ ਸੌ ਕਲਹ ਬਢਾਇ ਕੈ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੜਿ ਬਾਜੀ ਪਰ ਚਲਾ ਦੇਸ ਕਹ ਧਾਇ ਕੈ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਪਿਤੁ ਜਾਨ੍ਯੋ ਸੁਤ ਮੇਰੋ ਦੇਸ ਅਪਨੇ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਹੌ ਅਰਧ ਰਾਤ੍ਰਿ ਗੇ ਗ੍ਰਿਹ ਰਾਨੀ ਆਵਤ ਭਯੋ ॥੭॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਤੇ ਸਾਹੁ ਜਬੈ ਉਠਿ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਰਾਨੀ ਅਸ ਚਰਿਤ ਬਨਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਨਿਪੁੰਸਕ ਕਰਿ ਠਹਰਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜਾ ਸੌ ਇਸ ਭਾਤਿ ਜਤਾਯੋ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਮੈ ਇਕ ਮੋਲ ਨਿਪੁੰਸਕ ਆਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੋ ਰੂਪ ਨ ਜਾਤ ਬਖਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਅਪਨੇ ਕਾਜ ਕਰੈ ਹੌ ॥",
      "s": 14
    },
    {
      "t": "ਮਨ ਭਾਵਤ ਕੇ ਭੋਗ ਕਮੈ ਹੌ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਭਲੀ ਭਲੀ ਰਾਜਾ ਕਹੀ ਭੇਦ ਨ ਸਕਾ ਬਿਚਾਰ ॥",
      "s": 14
    },
    {
      "t": "ਪੁਰਖ ਨਿਪੁੰਸਕ ਭਾਖਿ ਤ੍ਰਿਯ ਰਾਖਾ ਧਾਮ ਸੁਧਾਰਿ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਰਮ੍ਯੋ ਕਰਤ ਰਾਨੀ ਭਏ ਤਵਨ ਪੁਰਖ ਦਿਨ ਰੈਨਿ ॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪਤਿ ਨਿਪੁੰਸਕ ਤਿਹ ਲਖੈ ਕਛੂ ਨ ਭਾਖੈ ਬੈਨ ॥੧੧॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਸਤਰ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੭੦॥੫੨੫੪॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਤੇਲੰਗਾ ਜਹ ਦੇਸ ਅਪਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਮਰ ਸੈਨ ਤਹ ਕੋ ਸਰਦਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਬਿਲਾਸ ਦੇਇ ਘਰ ਰਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੀ ਜਾਤ ਨ ਪ੍ਰਭਾ ਬਖਾਨੀ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਇਕ ਛੈਲ ਪੁਰੀ ਸੰਨ੍ਯਾਸੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਪੁਰ ਮਦ੍ਰ ਦੇਸ ਕੌ ਬਾਸੀ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਨਿਰਖਿ ਲਗਨਿ ਤਿਹ ਲਾਗੀ ॥",
      "s": 14
    }
  ]
}
