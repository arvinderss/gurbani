  "lines": [
    {
      "t": "ਜਾ ਤੇ ਨੀਂਦ ਭੂਖ ਸਭ ਭਾਗੀ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਕੀ ਤਾਹੂ ਸੌ ਲਾਗੀ ॥",
      "s": 14
    },
    {
      "t": "ਛੂਟੈ ਕਹਾ ਅਨੋਖੀ ਜਾਗੀ ॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਦਿਨ ਤਿਹ ਸੌ ਭੋਗ ਕਮਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭੋਗ ਕਿਯਾ ਤਿਮ ਦ੍ਰਿੜ ਤ੍ਰਿਯ ਭਾਯੋ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਬਹੁ ਦਿਨ ਭੋਗ ਤਵਨ ਸੰਗਿ ਕਿਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਐਸੁਪਦੇਸ ਤਵਨ ਕਹ ਦਿਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਜੌ ਮੈ ਕਹੌ ਮਿਤ੍ਰ ਸੋ ਕੀਜਹੁ ॥",
      "v": [
        [
          3,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਮੇਰੋ ਕਹਿਯੋ ਮਾਨਿ ਕਰਿ ਲੀਜਹੁ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਜੁ ਮ੍ਰਿਤਕ ਪਰਿਯੋ ਲਖਿ ਪੈਯੌ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੋ ਕਾਟਿ ਲਿੰਗ ਲੈ ਐਯੌ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਕੁਪੀਨ ਬਿਖੈ ਦ੍ਰਿੜ ਰਖਿਯਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਦੂਸਰੇ ਨਰਹਿ ਨ ਭਖਿਯਹੁ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਅੜਿਲ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਮੈ ਦੇਹੋ ਤੁਮੈ ਉਰਾਭੇ ਲਾਇ ਕੈ ॥",
