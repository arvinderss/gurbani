{
  "page": 1214,
  "lines": [
    {
      "t": "ਤਾ ਕੇ ਸੰਗ ਰੋਸਨਾ ਰਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਬਿਧ ਬਿਧਨ ਤਨ ਪ੍ਰੀਤੁਪਜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਤਿਹ ਸੰਗ ਕਮਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਪੀਰ ਅਪਨੋ ਠਹਿਰਾਯੋ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਔਰੰਗ ਸਾਹ ਭੇਦ ਨਹਿ ਜਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਵਹੈ ਮੁਰੀਦ ਭਈ ਤਿਹ ਮਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਪੀਯ ਸਮੁਝਿ ਤਿਹ ਭੋਗ ਕਮਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਪੀਰ ਭਾਖਿ ਸਭਹੂੰਨ ਸੁਨਾਵੈ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਦਿਨ ਪੀਰ ਗਯੋ ਅਪਨੇ ਘਰ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਬਿਨਾ ਤਿਹ ਪਰਤ ਨ ਛਿਨ ਕਰ ॥",
      "s": 14
    },
    {
      "t": "ਰੋਗਨਿ ਤਨ ਅਪਨੇ ਠਹਰਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਵਾ ਪਹਿ ਬੈਠਿ ਸਾਢਨੀ ਆਈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੇ ਰਹਤ ਬਹੁਤ ਦਿਨ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰੌ ਸਹਿਰ ਦਿਲੀ ਮਹਿ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਭਈ ਅਰੋਗਨਿ ਭਾਖਿ ਅਨਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਤ ਭੇਦ ਕੀ ਕਿਨੂੰ ਨ ਪਾਈ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਭ੍ਰਾਤ ਭਏ ਇਹ ਭਾਤਿ ਉਚਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਰੋਗ ਬਡਾ ਪ੍ਰਭੁ ਹਰੀ ਹਮਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਬੈਦਨ ਅਧਿਕ ਇਨਾਮ ਦਿਲਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਨ ਔਰੰਗ ਪਾਯੋ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਅਠਹਤਰਿ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੭੮॥੫੩੫੨॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰੇਮਾਵਤੀ ਨਗਰ ਇਕ ਰਾਜਤ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰੇਮ ਸੈਨ ਜਹ ਨ੍ਰਿਪਤਿ ਬਿਰਾਜਤ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰੇਮ ਮੰਜਰੀ ਤਿਹ ਗ੍ਰਿਹ ਦਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਸਮ ਦਿਤਿ ਨ ਅਦਿਤਿ ਕੁਮਾਰਾ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਤਹਾ ਸਾਹੁ ਕੇ ਪੂਤ ਸੁਘਰ ਅਤਿ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਸਮ ਰਾਜ ਕੁਅਰ ਨ ਕਹੂੰ ਕਤ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੀ ਪ੍ਰਭਾ ਕਹਨ ਨਹਿ ਆਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਹੇਰੈ ਪਲਕ ਨ ਜੋਰੀ ਜਾਵੈ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਰਾਨੀ ਤਿਹ ਕੀ ਦੁਤਿ ਲਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਐਸੀ ਭਾਤਿ ਚਿਤ ਮਹਿ ਕਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਕੈ ਇਹ ਕੇ ਸੰਗ ਭੋਗ ਕਮਾਊ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਤਰ ਹ੍ਵੈ ਜੋਗਨਿ ਬਨ ਜਾਊ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਸਹਚਰੀ ਤਹਾ ਪਠਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਪ੍ਰਬੋਧਿ ਤਹਾ ਲੈ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਨਿ ਠਨਿ ਬੈਠ ਚੰਚਲਾ ਜਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਲੈ ਆਈ ਸਹਚਰਿ ਤਿਹ ਜਹਾ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਆਤੁਰ ਕੁਅਰਿ ਤਾਹਿ ਲਪਟਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁ ਬਿਧਿ ਭਜ੍ਯੋ ਮਿਤ੍ਰ ਸੁਖਦਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਚਤੁਰ ਪਹਰ ਰਜਨੀ ਰਤਿ ਮਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਕਰਤ ਕਾਮ ਕੀ ਕੇਲ ਕਹਾਨੀ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਅਟਕਿ ਗਈ ਅਬਲਾ ਤਿਹ ਸੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਰੰਗਿਤ ਭਈ ਉਹੀ ਕੇ ਰੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕਹ ਐਸ ਪ੍ਰਬੋਧ ਦ੍ਰਿੜਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਆਪੁ ਨ੍ਰਿਪਹਿ ਚਲਿ ਸੀਸ ਝੁਕਾਯੋ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਮੁਹਿ ਭਯੋ ਸੁਪਨ ਸੁਨੁ ਰਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੋਵਤ ਰੁਦ੍ਰ ਜਗਾਇ ਪਠਾਈ ॥",
      "s": 14
    }
  ]
}
