{
  "page": 1223,
  "lines": [
    {
      "t": "ਜੌ ਤਿਹ ਦੈ ਮਿਲਾਇ ਮੁਹਿ ਪ੍ਯਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਤੌ ਜਾਨੌ ਤੂ ਹਿਤੂ ਹਮਾਰੀ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਕਹਿਯੋ ਕੁਅਰਿ ਸਹਚਰਿ ਸੌ ਜਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਨ ਦੂਸਰ ਕਾਨ ਬਖਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਤਛਿਨ ਦੌਰ ਤਵਨ ਪਹਿ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁ ਬਿਧਿ ਤਾਹਿ ਪ੍ਰਬੋਧਤ ਭਈ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਬਹੁ ਬਿਧਿ ਤਾਹਿ ਪ੍ਰਬੋਧ ਜਤਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜ੍ਯੋਂ ਤ੍ਯੋਂ ਤਾਹਿ ਤਹਾ ਲੈ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਰਗ ਕੁਅਰਿ ਬਿਲੋਕ ਜਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਲੈ ਪਹੁਚੀ ਮਿਤਵਾ ਕਹ ਤਹਾ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਲਖਿ ਤਿਹ ਕੁਅਰਿ ਪ੍ਰਫੁਲਿਤ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁਕ ਰਾਕ ਨਵੋ ਨਿਧਿ ਪਈ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਬਿਹਸਿ ਬਿਹਸਿ ਤਿਹ ਕੰਠ ਲਗਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮਨ ਮਾਨਤ ਕੋ ਭੋਗ ਕਮਾਯੋ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੋ ਦੂਰ ਦਰਿਦ੍ਰ ਦਿਯਾ ਕਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਸੀਸ ਰਹੀ ਧਰ ਸਖੀ ਪਗਨ ਪਰ ॥",
      "s": 14
    },
    {
      "t": "ਤਵਪ੍ਰਸਾਦ ਮੈ ਮਿਤ੍ਰਹਿ ਲਹਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਾ ਕਹੋ ਤੁਹਿ ਜਾਤ ਨ ਕਹਿਯੋ ॥੧੦॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਅਬ ਕਛੁ ਐਸ ਚਰਿਤ੍ਰ ਬਨੈਯੇ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਤੇ ਸਦਾ ਮਿਤ੍ਰ ਕਹ ਪੈਯੇ ॥",
      "s": 14
    },
    {
      "t": "ਸੋਵੌ ਸਦਾ ਸੰਗ ਲੈ ਤਾ ਕੌ ॥",
      "s": 14
    },
    {
      "t": "ਚੀਨਿ ਸਕੈ ਕੋਊ ਨਹਿ ਵਾ ਕੌ ॥੧੧॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯ ਚਰਿਤ੍ਰ ਅਸ ਚਿਤ ਬਿਚਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਸੁ ਮੈ ਕਹਤ ਹੋ ਸੁਨਹੁ ਪ੍ਯਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਛਪਾਇ ਸਦਨ ਮਹਿ ਰਾਖਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਸੌ ਐਸੀ ਬਿਧਿ ਭਾਖਾ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਜੋ ਤੁਮ ਪੁਰਖ ਸਰਾਹਾ ॥",
      "v": [
        [
          0,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤਾ ਕਹ ਸ੍ਰੀ ਬਿਸੁਨਾਥਨ ਚਾਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਵਾ ਕੋ ਕਾਲਿ ਕਾਲ ਹ੍ਵੈ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਸਖਿ ਕੇ ਮੁਖ ਤੇ ਸੁਨਿ ਲਯੋ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਹਮ ਸਭਹਿਨ ਜੋ ਤਾਹਿ ਸਰਾਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਤਿਸੁ ਬਿਸੁਨਾਥਨ ਚਾਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਨਿਯਤ ਦ੍ਰਿਸਟਿ ਤ੍ਰਿਯਨ ਕੀ ਲਾਗੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਤਾਹਿ ਮ੍ਰਿਤੁ ਲੈ ਭਾਗੀ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਸੋਕ ਤਵਨ ਕੋ ਕਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਦਿਨ ਅੰਨ ਨ ਪਾਨੀ ਪਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਚ ਮਰਿਯੋ ਜਾਨ੍ਯੋ ਜਿਯ ਤਾ ਕੌ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਨ ਪਾਯੋ ਯਾ ਕੌ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਜਸ ਤੁਮ ਸੁੰਦਰ ਯਾਹਿ ਨਿਹਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭਯੌ ਨ ਹੈ ਹ੍ਵੈਹੈ ਨ ਬਿਚਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਕੀ ਬਹਿਨਿ ਏਕ ਤਿਹ ਘਰ ਮੈ ॥",
      "s": 14
    },
    {
      "t": "ਛਾਡਿ ਅਯੋ ਜਿਹ ਭ੍ਰਾਤ ਨਗਰ ਮੈ ॥੧੬॥",
      "s": 14
    },
    {
      "t": "ਮੁਹਿ ਤੁਮ ਕਹੋ ਤੁ ਤਹ ਮੈ ਜਾਊ ॥",
      "s": 14
    },
    {
      "t": "ਵਾ ਕੀ ਖੋਜਿ ਬਹਿਨਿ ਮੈ ਲਯਾਊ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਅਤਿ ਚਤੁਰਿ ਸਭਨ ਗੁਨ ਆਗਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਆਣਿ ਦਿਖਾਊ ਤੁਹਿ ਨ੍ਰਿਪ ਨਾਗਰਿ ॥੧੭॥",
      "s": 14
    },
    {
      "t": "ਭਲੀ ਭਲੀ ਸਭ ਤ੍ਰਿਯ ਬਖਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਗਤਿ ਕਿਨੂੰ ਨ ਜਾਨੀ ॥",
      "s": 14
    }
  ]
}
