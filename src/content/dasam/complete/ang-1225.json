      "s": 14
    },
    {
      "t": "ਤੋ ਪਰ ਅਟਕਤ ਨ੍ਰਿਪ ਤ੍ਰਿਯ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਛੂਟਹੁ ਕਸਬ ਲਗਨ ਲਗਿ ਗਈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਵਹ ਧਾਮ ਕ੍ਰਿਤਾਰਥ ਕੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਹ੍ਯਾਂ ਤੇ ਚਲਿ ਵਹਿ ਗ੍ਰਿਹ ਪਗੁ ਦੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਉਠਹੁ ਕੁਅਰ ਜੂ ਬਿਲਮ ਨ ਲੈਯੈ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਰਾਜ ਤਰੁਨਿ ਕੇ ਸੇਜ ਸੁਹੈਯੈ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਤਿਹ ਬਿਧ ਤਾ ਕੋ ਮਨ ਲੀਨਾ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਆਨਿ ਮਿਲਾਇ ਕੁਅਰਿ ਕਹ ਦੀਨਾ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਤਿਹ ਤਾਹਿ ਰਿਝਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਚਾਰਿ ਪਹਰ ਨਿਸਿ ਭੋਗ ਕਮਾਯੋ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਕੇਲ ਕਰਤ ਨਿਸਿ ਸਕਲ ਬਿਹਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਕਰਤ ਕਾਮ ਕੀ ਕੋਟਿ ਕਹਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਕੇ ਆਸਨ ਕਰਿ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਤਪਤ ਸਭ ਹੀ ਕਹਿ ਹਰਿ ਕੈ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਭੋਰ ਭਯੋ ਰਜਨੀ ਜਬ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਚਿਰਈ ਚੁਹਚਈ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰਮਿਤ ਭਏ ਦੋਊ ਕੇਲ ਕਮਾਤੇ ॥",
      "s": 14
    },
    {
      "t": "ਏਕਹਿ ਸੇਜ ਸੋਏ ਰਸ ਮਾਤੇ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਸੋਵਤ ਤ੍ਯਾਗ ਨੀਦਿ ਜਬ ਜਗੇ ॥",
      "s": 14
    },
    {
      "t": "ਮਿਲਿ ਕਰਿ ਕੇਲ ਕਰਨ ਤਬ ਲਗੇ ॥",
      "s": 14
    },
    {
      "t": "ਆਸਨ ਕਰਤ ਅਨੇਕ ਪ੍ਰਕਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕੋਕਹੁੰ ਤੇ ਦਸ ਗੁਨ ਬਿਸਤਾਰਾ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਕੇਲ ਕਮਾਤ ਅਧਿਕ ਰਸ ਮਾਤੈ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਲਿ ਗਈ ਘਰ ਕੀ ਸੁਧਿ ਸਾਤੈ ॥",
      "s": 14
    },
    {
      "t": "ਚਿਤ ਅਪਨੋ ਅਸ ਕੀਯਾ ਬਿਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਗਟ ਮਿਤ੍ਰ ਕੇ ਸਾਥ ਉਚਾਰਾ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਹੁ ਬਾਤ ਪ੍ਯਾਰੇ ਤੁਮ ਮੇਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਦਾਸੀ ਭਈ ਆਜ ਮੈ ਤੇਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਮੇਰੇ ਤੋਟ ਦਰਬ ਕੀ ਨਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਹਮ ਤੁਮ ਆਵਹੁ ਕਹੂੰ ਸਿਧਾਹੀ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਐਸੋ ਜਤਨ ਮਿਤ੍ਰ ਕਛੁ ਕਰਿਯੈ ॥",
