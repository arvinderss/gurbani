      "s": 14
    },
    {
      "t": "ਅਤਿਥ ਭੇਸ ਦੋਊ ਧਰਿ ਲੈਹੈਂ ॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਠਾ ਬੈਠ ਖਜਾਨਾ ਖੈਹੈਂ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਜਾਰ ਕਹਿਯੋ ਅਬਲਾ ਸੌ ਐਸੇ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਹਿ ਨਿਕਸੇ ਲੈ ਕਰਿ ਸੰਗਿ ਕੈਸੇ ॥",
      "s": 14
    },
    {
      "t": "ਠਾਢੇ ਈਹਾ ਅਨਿਕ ਰਖਵਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਨਭ ਕੇ ਜਾਤ ਪਖੇਰੂ ਮਾਰੈ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਜੌ ਤੁਹਿ ਮੁਹਿ ਕੌ ਨ੍ਰਿਪਤਿ ਨਿਹਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਹੂੰਅਨ ਠੌਰ ਮਾਰਿ ਕਰ ਡਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਤੁਮ ਅਸ ਕਰਹੁ ਉਪਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਮੁਰ ਤੁਰ ਭੇਦ ਨ ਦੂਸਰ ਪਾਵੈ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਸੂਰ ਸੂਰ ਕਰਿ ਗਿਰੀ ਤਰੁਨਿ ਧਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨੁਕ ਗਈ ਸਾਚੁ ਦੈਕੈ ਮਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਹਾਇ ਹਾਇ ਕਹ ਨਾਥ ਉਚਾਈ ॥",
