{
  "page": 1227,
  "lines": [
    {
      "t": "ਭੁਜ ਤੇ ਪਕਰਿ ਸੇਜ ਪਰ ਦਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਮਾਨਿ ਰੁਚਿ ਗਰੇ ਲਗਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਉਛਰਿ ਉਛਰਿ ਕਰਿ ਭੋਗ ਕਮਾਯੋ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਤਰੁਨ ਦੂਸਰ ਮਦ ਮਾਤੋ ॥",
      "s": 14
    },
    {
      "t": "ਤੀਸਰ ਭੋਗ ਤਰੁਨਿ ਕੇ ਰਾਤੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਹੂੰਅਨ ਮਧ ਹਾਰ ਕੋ ਮਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਚਾਰਹੁ ਬੇਦ ਭੇਦ ਇਹ ਜਾਨੈ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਤ੍ਰਿਯ ਤਰੁਨਿ ਤਰੁਨ ਕਹ ਪਾਵੈ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਛਿਨ ਛਤਿਯਾ ਤੇ ਛੋਰਿ ਨ ਭਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਗਹਿ ਗਹਿ ਤਾ ਕਹ ਗਰੇ ਲਗਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਚਾਰਿ ਪਹਿਰ ਨਿਸਿ ਭੋਗ ਕਮਾਵੈ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਭੋਗ ਕਰਤ ਤਰੁਨੀ ਬਸਿ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਪਰ ਕੀ ਤੇ ਵਾ ਕੀ ਹ੍ਵੈ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਛਿਨ ਇਕ ਛੈਲ ਨ ਛੋਰਿਯੋ ਜਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਛੈਲਿਯਹਿ ਯਾਰ ਛਬੀਲੋ ਭਾਵੈ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਕੋਕਸਾਰ ਕੇ ਮਤਨ ਉਚਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਅਮਲ ਪਾਨ ਕਰਿ ਦ੍ਰਿੜ ਰਤਿ ਧਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਆਨ ਪੁਰਖ ਕੀ ਕਾਨਿ ਨ ਕਰਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਕੇ ਭੋਗਨ ਭਰਹੀ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਪੋਸਤ ਭਾਗ ਅਫੀਮ ਮੰਗਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਖਾਟ ਪਰ ਬੈਠਿ ਚੜਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਹਸਿ ਹਸਿ ਕਰਿ ਦੋਊ ਜਾਘਨ ਲੇਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਤਰੁਨਿ ਕੌ ਬਹੁ ਸੁਖ ਦੇਹੀ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਭੋਗ ਕਰਤ ਨਿਸਿ ਸਕਲ ਬਿਤਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੋਇ ਰਹੈ ਉਠਿ ਕੇਲਿ ਕਮਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਫਿਰਿ ਫਿਰਿ ਤ੍ਰਿਯ ਆਸਨ ਕਹ ਲੈ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਕੈ ਚੁੰਬਨ ਕੈ ਕੈ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਭੋਗ ਕਰਤ ਤਰੁਨਿਯਹਿ ਰਿਝਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਅਨਿਕ ਤਿਨ ਕੇਲ ਮਚਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਹੌ ਹਸਿ ਤਾਹਿ ਉਚਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੌ ਜੁ ਤੁਮ ਸੌ ਸੁਨਹੋ ਪ੍ਯਾਰੋ ॥੧੬॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਤਰੁਨੀ ਸੰਗ ਦ੍ਰਿੜ ਰਤਿ ਕਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਕੇ ਭੋਗਨ ਭਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਰੀਝਿ ਤਰੁਨਿ ਇਹ ਭਾਤਿ ਉਚਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਮਿਤ੍ਰ ਭਈ ਮੈ ਦਾਸ ਤਿਹਾਰੀ ॥੧੭॥",
      "v": [
        [
          0,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਅਬ ਜੌ ਕਹੋ ਨੀਰ ਭਰਿ ਲ੍ਯਾਊ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਰ ਅਨੇਕ ਬਜਾਰ ਬਿਕਾਊ ॥",
      "s": 14
    },
    {
      "t": "ਜੇ ਤੁਮ ਕਹੋ ਵਹੈ ਮੈ ਕਰਿਹੌ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਔਰ ਕਿਸੂ ਤੇ ਨੈਕੁ ਨ ਡਰਿਹੋ ॥੧੮॥",
      "s": 14
    },
    {
      "t": "ਮਿਤ੍ਰ ਬਿਹਸਿ ਇਹ ਭਾਤਿ ਉਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਮੈ ਭਯੋ ਗੁਲਾਮ ਤਿਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤੋ ਸੀ ਤਰੁਨਿ ਭੋਗ ਕਹ ਪਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਪੂਰਨ ਭਈ ਮੋਰਿ ਭਗਤਾਈ ॥੧੯॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਇਹ ਬਾਤ ਚਿਤ ਮੈ ਮੇਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਮੈ ਕਹਤ ਯਾਰ ਸੰਗ ਤੇਰੇ ॥",
      "v": [
        [
          3,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਅਬ ਕਛੁ ਐਸ ਉਪਾਵ ਬਨੈਯੈ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਤੇ ਤੋ ਕਹ ਸਦਾ ਹੰਢੈਯੈ ॥੨੦॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਤੁਮ ਐਸ ਚਰਿਤ੍ਰ ਬਨਾਵਹੁ ॥",
      "s": 14
    }
  ]
}
