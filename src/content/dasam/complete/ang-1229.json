{
  "page": 1229,
  "lines": [
    {
      "t": "ਅਪਨੇ ਜੋਰ ਅੰਗ ਸੋ ਅੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਭਲੀ ਭਲੀ ਇਸਤ੍ਰਿਨ ਸਭ ਭਾਖੀ ॥",
      "s": 14
    },
    {
      "t": "ਜ੍ਯੋਂ ਤ੍ਯੋਂ ਨਾਰਿ ਨਾਹ ਤੇ ਰਾਖੀ ॥੩੩॥",
      "s": 14
    },
    {
      "t": "ਦਿਨ ਦੇਖਤ ਰਾਨੀ ਤਿਹ ਸੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੋਵਤ ਜੋਰ ਅੰਗ ਸੋ ਅੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਮੂਰਖ ਰਾਵ ਭੇਦ ਨਹਿ ਪਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਕੋਰੋ ਅਪਨੋ ਮੂੰਡ ਮੁਡਾਵੈ ॥੩੪॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਨਬੇ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੯੦॥੫੫੩੬॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਪਛਿਮਾਵਤੀ ਨਗਰ ਇਕ ਸੋਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਪਸਚਿਮ ਸੈਨ ਨ੍ਰਿਪਤਿ ਤਹ ਕੋ ਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਪਸਚਿਮ ਦੇ ਰਾਨੀ ਤਾ ਕੇ ਘਰ ॥",
      "s": 14
    },
    {
      "t": "ਰਹਤ ਪੰਡਿਤਾ ਸਕਲ ਲੋਭਿ ਕਰਿ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਰੂਪ ਰਾਨੀ ਕੋ ਰਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਜਗ ਤਿਹ ਦੁਤਿਯ ਚੰਦ੍ਰਮਾ ਕਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਪਰ ਰੀਝਿ ਨ੍ਰਿਪਤਿ ਕੀ ਭਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨਤ ਊਚ ਨੀਚਿ ਪਨਿਹਾਰੀ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਹੁਤੋ ਰਾਇ ਦਿਲਵਾਲੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨਕ ਦੂਸਰਾਸੁ ਹੈ ਮਾਲੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਪਹਿ ਜਾਤ ਨ ਪ੍ਰਭਾ ਬਖਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਉਰਝਿ ਰਹੀ ਦੁਤਿ ਹੇਰਤ ਰਾਨੀ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਸੌ ਅਧਿਕ ਸਨੇਹ ਬਢਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਦਿਵਸ ਗ੍ਰਿਹ ਬੋਲਿ ਪਠਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਤਬ ਹੀ ਸੁਨਿ ਬਚ ਪਹ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਟਤ ਰਾਜ ਕੁਅਰਿ ਕਹ ਭਯੋ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਪੋਸਤ ਭਾਗ ਅਫੀਮ ਮੰਗਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਸੇਜ ਪਰ ਬੈਠਿ ਚੜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਮਦ ਸੋ ਮਤਵਾਰੇ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਹੀ ਸੋਕ ਬਿਸਰਿ ਸਭ ਗਏ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਸੇਜ ਪਰ ਬੈਠਿ ਕਲੋਲਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਰਸ ਕੀ ਕਥਾ ਰਸਿਕ ਮਿਲਿ ਬੋਲਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਚੁੰਬਨ ਔਰ ਅਲਿੰਗਨ ਕਰਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਕੇ ਭੋਗਨ ਭਰਹੀ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਰਮਤ ਅਧਿਕ ਉਰਝਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਭੋਗ ਗਏ ਦਿਲਵਾਲੀ ਰਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਚਿਤ ਅਪਨੈ ਇਹ ਭਾਤਿ ਬਿਚਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੈ ਯਾਹੀ ਕੇ ਸੰਗ ਸਿਧਾਰੋ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਪਾਟ ਮੇਰੇ ਕਿਹ ਕਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਮੋ ਕਹ ਨਹੀ ਸੁਹਾਵਤ ਰਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਮੈ ਸਾਜਨ ਕੇ ਸਾਥ ਸਿਧੈਹੌ ॥",
      "s": 14
    },
    {
      "t": "ਭਲੀ ਬੁਰੀ ਸਿਰ ਮਾਝ ਸਹੈਹੌ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਜਹਾ ਸਿੰਘ ਮਾਰਤ ਬਨ ਮਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਾ ਦੋਹਰਾ ਏਕ ਤਹਾ ਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਚੜਿ ਝੰਪਾਨ ਤਿਹ ਠੌਰ ਸਿਧਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਮਿਤ੍ਰਹਿ ਤਹੀ ਸਹੇਟ ਬਤਾਈ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਗਹਿਰ ਬਨ ਮੈ ਜਬ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਲਘੁ ਇਛਾ ਕਹ ਉਤਰਤ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਤੇ ਗਈ ਮਿਤ੍ਰ ਕੇ ਸੰਗਾ ॥",
      "s": 14
    }
  ]
}
