{
  "page": 1233,
  "lines": [
    {
      "t": "ਹ੍ਰਿਦੈ ਨ੍ਰਿਪਤਿ ਕੀ ਸੰਕ ਨ ਧਰਈ ॥੧੬॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਬੇਸ੍ਵਹਿ ਆਪੁ ਬੁਲਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਰਾਜਾ ਤੇ ਲਿਖਿਵਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਚਾਹੈ ਤਿਹ ਬੋਲਿ ਪਠਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗਿ ਰੁਚਿ ਮਾਨਿ ਕਮਾਵੈ ॥੧੭॥",
      "s": 14
    },
    {
      "t": "ਮੂਰਖ ਭੇਦ ਨ ਰਾਜੈ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਅਪਨੋ ਮੂੰਡ ਮੁਡਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਬਲਾ ਐਸੋ ਚਰਿਤ ਬਨਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪਤਿ ਤੇ ਭੋਗ ਮਾਫ ਕਰਿ ਲਯੋ ॥੧੮॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਤਰਾਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੯੩॥੫੫੮੯॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਨਦਾਵਤੀ ਨਗਰ ਇਕ ਸੁਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਆਨਦ ਸੈਨ ਨ੍ਰਿਪਤਿ ਬਹੁ ਗੁਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਨਦਾਵਤੀ ਸਦਨ ਤਿਹ ਬਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਗਤ ਭਯੋ ਤਾ ਤੇ ਉਜਿਯਾਲਾ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਰੂਪ ਬਿਧਿਨਾ ਤਿਹ ਕੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਸਮ ਰੂਪ ਨ ਦੂਸਰ ਦੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਆਯੋ ਪੁਰਖ ਏਕ ਤਬ ਬਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਤੇ ਸੁੰਦਰਿ ਥੋ ਘਨੋ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਅਬਲਾ ਤਿਹ ਰੂਪ ਨਿਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਦਨ ਬਾਨ ਤਾ ਕੇ ਤਨ ਮਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਰੀਝਿ ਰਹੀ ਸੁੰਦਰਿ ਮਨ ਮਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਘਰ ਬਾਹਰ ਕੀ ਕਛੁ ਸੁਧਿ ਨਾਹੀ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਪਠੈ ਹਿਤੂ ਇਕ ਤਾਹਿ ਬੁਲਾਵਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਤਿਹ ਸਾਥ ਕਮਾਵਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਨ ਮਾਨਤ ਆਸਨ ਤਿਹ ਦਏ ॥",
      "s": 14
    },
    {
      "t": "ਚੁੰਬਨ ਔਰ ਅਲਿੰਗਨ ਲਏ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਮਿਤ੍ਰ ਰਾਨੀ ਕਹ ਭਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਤਾਹਿ ਪ੍ਰਬੋਧ ਜਨਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਾ ਉਜਾਰਿ ਜਹਾ ਬਡ ਅਹੀ ॥",
      "v": [
        [
          0,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਆਸਨ ਲਾਇ ਬੈਠਿਯੋ ਤਹੀ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਹੀ ਅੰਗ ਬਿਭੂਤਿ ਚੜੈਯਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਦ੍ਰੁਮ ਤਰ ਬੈਠੇ ਧ੍ਯਾਨ ਲਗੈਯਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜਾ ਸਹਿਤ ਤਹਾ ਹਮ ਐਹੈਂ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਮੈ ਧਾਮ ਜ੍ਯੋਂ ਤ੍ਯੋਂ ਲੈ ਜੈਹੈਂ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਮਾਨਿ ਜਾਰ ਸੋਈ ਬਚ ਲਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਖ ਅਤਿਥ ਕੋ ਧਾਰਤ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਆਸਨ ਏਕ ਬ੍ਰਿਛ ਤਰ ਮਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਯੌ ਰਾਜਾ ਸੌ ਨਾਰਿ ਉਚਾਰਾ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਸੋਵਤ ਹੁਤੀ ਸੁਪਨ ਮੈ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਰੁਦ੍ਰ ਮੇਰੇ ਗ੍ਰਿਹ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪਾਵ ਸਾਥ ਤਿਨ ਮੋਹਿ ਜਗਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਕ੍ਰਿਪਾ ਕਰਿ ਬਚਨ ਸੁਨਾਯੋ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਤੁਮ ਰਾਜਾ ਜੂ ਸਾਥ ਉਚਰਿਯਹੁ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਏਕ ਬਾਤ ਚਿਤ ਭੀਤਰਿ ਧਰਿਯਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਰਖੀਸੁਰ ਬਨ ਮਹਿ ਸੁਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਸਮ ਭਯੋ ਨ ਹੈ ਕਹੂੰ ਮੁਨਾ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਰਾਜਾ ਸਹਿਤ ਜਾਇ ਤਿਹ ਲ੍ਰਯੈਯਹੁ ॥",
      "s": 14
    }
  ]
}
