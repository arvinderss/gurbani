{
  "page": 1236,
  "lines": [
    {
      "t": "ਮੈਨ ਸੁ ਨਾਰ ਭਰਤ ਜਨੁ ਭਰੀ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੇ ਏਕ ਧਾਮ ਸੁਤ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬੀਸ ਬਰਿਸ ਕੋ ਹ੍ਵੈ ਮਰਿ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰਨਿਯਹਿ ਬਾਢਾ ਸੋਕ ਅਪਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਤੇ ਸਭ ਬਿਸਰਾ ਘਰ ਬਾਰਾ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਇਕ ਪੂਤ ਸਾਹ ਕੋ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤੇਜਵਾਨ ਦੁਤਿ ਕੋ ਜਨੁ ਜਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜੈਸੋ ਤਿਹ ਸੁਤ ਕੋ ਥੋ ਰੂਪਾ ॥",
      "s": 14
    },
    {
      "t": "ਤੈਸੋ ਈ ਤਿਹ ਲਗਤ ਸਰੂਪਾ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਰਾਨੀ ਸੋ ਪੁਰਖ ਨਿਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਲਾਜ ਸਾਜ ਤਜ ਹ੍ਰਿਦੈ ਬਿਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਸੌ ਕਾਮ ਭੋਗ ਅਬ ਕਰਿਯੈ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਤਰ ਮਾਰ ਛੁਰਕਿਆ ਮਰਿਯੈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਵਹੁ ਕੁਅਰ ਰਾਹ ਤਿਹ ਆਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਚੰਚਲ ਦੇਖਨ ਕੌ ਤਿਹ ਜਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਦਿਨ ਤਾ ਕੇ ਨਾਥ ਨਿਹਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਸੌ ਤਿਹ ਬਾਤ ਉਚਾਰੀ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਕਿਹ ਨਿਮਿਤਿ ਇਹ ਠਾ ਤੂ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਹੇਰਿ ਰਹੀ ਕਿਹ ਕਹ ਦ੍ਰਿਗ ਲਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਰਾਨੀ ਇਹ ਭਾਤਿ ਉਚਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਹੁ ਨ੍ਰਿਪਤਿ ਤੁਮ ਬਚਨ ਹਮਾਰੋ ॥੭॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਜਸ ਤਵ ਸੁਤ ਸੁਰ ਲੋਕ ਸਿਧਾਯੋ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸੋ ਧਰਿ ਰੂਪ ਦੁਤਿਯ ਜਨੁ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਤੁਮ ਮੁਰਿ ਢਿਗ ਸੇਜ ਸੁਵਾਵੋ ॥",
      "s": 14
    },
    {
      "t": "ਹਮਰੇ ਚਿਤ ਕੋ ਤਾਪ ਮਿਟਾਵੋ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਮੂਰਖ ਭੇਦ ਅਭੇਦ ਨ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਬੁਲਾਇ ਆਪੁ ਲੈ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਪੁਨਿ ਤਿਹ ਭਰੁਆਪਨ ਕਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭਲੋ ਬੁਰੋ ਨ ਬਿਚਾਰਿ ਬਿਚਰਿਯੋ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਭਰੂਆ ਕੀ ਕ੍ਰਿਆ ਕਹ ਕਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਚਾਰਿ ਬਿਚਾਰ ਕਛੂ ਨ ਬਿਚਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੂਤੀ ਪਠਵਨ ਤੇ ਤ੍ਰਿਯ ਬਚੀ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਪਤਿ ਕੀ ਦੂਤੀ ਕਰਿ ਰਚੀ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਸੇਜ ਕੇ ਨਿਕਟ ਸੁਵਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਭਲੋ ਭਲੋ ਭੋਜਨ ਤਿਹ ਖੁਵਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੈ ਸੁ ਸੁਤ ਮੁਰ ਕੀ ਅਨੁਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਯਾ ਸੰਗ ਹਮਰੋ ਪ੍ਯਾਰਾ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਤ੍ਰਿਯ ਤਾ ਕੌ ਭੋਜ ਖੁਵਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਝਝਕਿ ਤਾਹਿ ਤ੍ਰਿਯ ਡਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਮੋਰੇ ਸੁਤ ਕੀ ਅਨੁਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਭਲੋ ਭਲੋ ਚਹਿਯਤ ਤਿਹ ਖ੍ਵਾਰਾ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਨਿਕਟਿ ਆਪਨੇ ਤਾਹਿ ਸੁਵਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਢਿਗ ਅਪਨੀ ਸੇਜ ਬਿਛਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਤਾ ਸੰਗ ਨ੍ਰਿਪਤਿ ਸ੍ਵੈ ਜਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤ੍ਰਿਯ ਤਾ ਸੰਗ ਭੋਗ ਕਮਾਵੈ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਕਸਿ ਕਸਿ ਰਮੈ ਜਾਰ ਕੇ ਸੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਦਲਿ ਮਲਿ ਤਾਹਿ ਕਰੈ ਸਰਬੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਭੋਗ ਕਮਾਈ ॥",
      "s": 14
    }
  ]
}
