{
  "page": 1239,
  "lines": [
    {
      "t": "ਬਿਸੁਕਰਮਾ ਕੀ ਜਾਨ ਕੁਮਾਰੀ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਚਤੁਰਾ ਅਰੁ ਦੁਤਿਯ ਚਿਤੇਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਤਿਮਾ ਦੁਤਿਯ ਮਦਨ ਜਨ ਕੇਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਗੋਰ ਬਰਨ ਅਰੁ ਖਾਏ ਪਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨੁਕ ਚੜਾ ਚੰਦ ਅਸਮਾਨਾ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੇ ਧਾਮ ਚਿਤੇਰਨਿ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਲਿਖਿ ਲ੍ਯਾਵਤ ਪ੍ਰਤਿਮਾ ਤਿਹ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਲੈ ਕਰਿ ਕਰ ਸਾਹ ਨਿਹਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨੁਕ ਤਾਨਿ ਕਟਾਰੀ ਮਾਰੀ ॥੧੬॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਸੁਧਿ ਗਈ ਮਤ ਹ੍ਵੈ ਝੂੰਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਘਾਇ ਲਗੇ ਘਾਯਲ ਜਨੁ ਘੂੰਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਨ ਕੀ ਰਹੀ ਨ ਤਨਿਕ ਸੰਭਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁ ਡਸਿ ਗਯੋ ਨਾਗ ਕੌਡਿਯਾਰਾ ॥੧੭॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਦਿਨ ਕਰੀ ਸਾਹ ਮਿਜਮਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਪੁਰ ਨਾਰਿ ਧਾਮ ਮਹਿ ਆਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਸਿਧ ਪਾਲ ਕੀ ਸੁਤਾ ਜਬਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਕਲ ਦੀਪ ਜ੍ਯੋਂ ਸਭਾ ਸੁਹਾਈ ॥੧੮॥",
      "s": 14
    },
    {
      "t": "ਛਿਦ੍ਰ ਬੀਚ ਕਰਿ ਤਾਹਿ ਨਿਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਹਜਰਤਿ ਭਯੋ ਤਬੈ ਮਤਵਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਨ ਤਰੁਨੀ ਕੇ ਰੂਪ ਬਿਕਾਨ੍ਰਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮ੍ਰਿਤਕ ਸੋ ਤਨੁ ਰਹਿਯੋ ਪਛਾਨ੍ਯੋ ॥੧੯॥",
      "s": 14
    },
    {
      "t": "ਹਜਰਤਿ ਸਕਲ ਪਠਾਨ ਬੁਲਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਸਿਧ ਪਾਲ ਕੈ ਧਾਮ ਪਠਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਕੈ ਅਪਨੀ ਦੁਹਿਤਾ ਮੁਹਿ ਦੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਤਰ ਮੀਚ ਮੂੰਡ ਪਰ ਲੀਜੈ ॥੨੦॥",
      "s": 14
    },
    {
      "t": "ਸਕਲ ਪਠਾਨ ਤਵਨ ਕੇ ਗਏ ॥",
      "s": 14
    },
    {
      "t": "ਹਜਰਤਿ ਕਹੀ ਸੁ ਭਾਖਤ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਸਿਧ ਪਾਲ ਧੰਨ ਭਾਗ ਤਿਹਾਰੇ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਗ੍ਰਿਹ ਆਵਹਿਗੇ ਸਾਹ ਸਵਾਰੇ ॥੨੧॥",
      "s": 14
    },
    {
      "t": "ਸਿਧ ਪਾਲ ਐਸੋ ਜਬ ਸੁਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਦੁਖਿਤ ਹ੍ਵੈ ਮਸਤਕ ਧੁਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਦੈਵ ਕਵਨ ਗਤਿ ਕਰੀ ਹਮਾਰੀ ॥",
      "v": [
        [
          0,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਗ੍ਰਿਹ ਅਸਿ ਉਪਜੀ ਸੁਤਾ ਦੁਖਾਰੀ ॥੨੨॥",
      "s": 14
    },
    {
      "t": "ਜੌ ਨਹਿ ਦੇਤ ਤੁ ਬਿਗਰਤ ਕਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਤ ਦਏ ਛਤ੍ਰਿਨ ਕੀ ਲਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਮੁਗਲ ਪਠਾਨ ਤੁਰਕ ਘਰ ਮਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਲਗਿ ਗੀ ਛਤ੍ਰਾਨੀ ਨਾਹੀ ॥੨੩॥",
      "s": 14
    },
    {
      "t": "ਛਤ੍ਰਿਨ ਕੇ ਅਬ ਲਗੇ ਨ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਹਿਤਾ ਕਾਢਿ ਤੁਰਕ ਕਹ ਦਈ ॥",
      "s": 14
    },
    {
      "t": "ਰਜਪੂਤਨ ਕੇ ਹੋਤਹ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਪੁਤ੍ਰੀ ਧਾਮ ਮਲੇਛ ਪਠਾਈ ॥੨੪॥",
      "s": 14
    },
    {
      "t": "ਹਾਡਨ ਏਕ ਦੂਸਰਨ ਖਤ੍ਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਰਕਨ ਕਹ ਇਨ ਦਈ ਨ ਪੁਤ੍ਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਛਤ੍ਰੀ ਅਸ ਕਰਮ ਕਮਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਕੁੰਭੀ ਨਰਕ ਦੇਹ ਜੁਤ ਜਾਵੈ ॥੨੫॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਨਰ ਤੁਰਕਹਿ ਦੇਤ ਦੁਲਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਧ੍ਰਿਗ ਧ੍ਰਿਗ ਜਗ ਤਿਹ ਕਰਤ ਉਚਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਲੋਕ ਪ੍ਰਲੋਕ ਤਾਹਿ ਕੋ ਜੈਹੈ ॥",
      "s": 14
    }
  ]
}
