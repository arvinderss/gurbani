{
  "page": 1241,
  "lines": [
    {
      "t": "ਪੀ ਪੀ ਅਮਲ ਹੋਹੁ ਮਤਵਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਾਤ ਮਚਤ ਹੈ ਜੁਧ ਅਪਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਹ੍ਵੈ ਹੈ ਅੰਧ ਧੁੰਧ ਬਿਕਰਾਰਾ ॥੩੮॥",
      "s": 14
    },
    {
      "t": "ਪਾਤਿਸਾਹ ਸੰਗ ਹੈ ਸੰਗ੍ਰਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਹੀ ਕਰਹੁ ਕੇਸਰੀ ਜਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਟਾਕਿ ਆਫੂਐ ਤੁਰੈ ਨਚਾਵੌ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਗ ਝਲਕਤੀ ਹਾਥ ਫਿਰਾਵੌ ॥੩੯॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਥਮ ਤ੍ਯਾਗਿ ਪ੍ਰਾਨਨ ਕੀ ਆਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਹਹੁ ਖੜਗ ਸਕਲ ਤਜਿ ਤ੍ਰਾਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਪੋਸਤ ਭਾਗ ਅਫੀਮ ਚੜਾਵੋ ॥",
      "s": 14
    },
    {
      "t": "ਰੇਤੀ ਮਾਝ ਚਰਿਤ੍ਰ ਦਿਖਾਵੋ ॥੪੦॥",
      "s": 14
    },
    {
      "t": "ਹਜਰਤਿ ਜੋਰਿ ਤਹਾ ਦਲ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਕਲ ਬ੍ਯਾਹ ਕੋ ਸਾਜ ਬਨਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਿਧ ਪਾਲ ਕੇ ਜਬ ਘਰਿ ਆਏ ॥",
      "s": 14
    },
    {
      "t": "ਪੁਨਿ ਕੰਨ੍ਯਾ ਅਸ ਬਚਨ ਸੁਨਾਏ ॥੪੧॥",
      "s": 14
    },
    {
      "t": "ਅੜਿਲ ॥",
      "s": 14
    },
    {
      "t": "ਗ੍ਰਿਹ ਆਵੈ ਜੋ ਸਤ੍ਰੁ ਨ ਤਾਹਿ ਸੰਘਾਰਿਯੈ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਧਾਮ ਗਏ ਇਹੁ ਮਾਰਹੁ ਮੰਤ੍ਰ ਬਿਚਾਰਿਯੈ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਲਛਿਮਨ ਪੁਤ੍ਰਹਿ ਡਾਰਿ ਡੋਰਿ ਦਿਯ ਤ੍ਰਿਯ ਉਚਰਿ ॥",
      "v": [
        [
          2,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਹੋ ਸੰਗ ਸਤ ਸੈ ਖਤਿਰੇਟਾ ਗਯੋ ਤ੍ਰਿਯ ਭੇਸ ਧਰਿ ॥੪੨॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਤੇ ਜਾਤ ਧਾਮ ਤੇ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤਾ ਕੇ ਮੰਦਰ ਮੋ ਅਏ ॥",
      "s": 14
    },
    {
      "t": "ਲੁਬਧਮਾਨ ਹ੍ਵੈ ਹਾਥ ਚਲਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਲਛਿਮਨ ਕਾਢਿ ਕਟਾਰੀ ਘਾਯੋ ॥੪੩॥",
      "s": 14
    },
    {
      "t": "ਤਾਕਹ ਐਸ ਕਟਾਰੀ ਮਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਨ ਹਜਰਤਿ ਬੈਨ ਉਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਕਹ ਮਾਰਿ ਭੇਸ ਨਰ ਧਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਲੋਗਨ ਮਹਿ ਇਹ ਭਾਤਿ ਉਚਾਰੋ ॥੪੪॥",
      "s": 14
    },
    {
      "t": "ਮੋਹਿ ਅਮਲ ਕੇ ਕਾਜ ਪਠਾਵਾ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਮ ਤਨ ਇਹ ਬਿਧਿ ਆਪੁ ਕਹਾਵਾ ॥",
      "s": 14
    },
    {
      "t": "ਧਾਮ ਆਵਨੇ ਕੋਈ ਨ ਪਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਆਵੈ ਸੋ ਜਾਨ ਗਵਾਵੈ ॥੪੫॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਲਾਘਿ ਡਿਵਢੀਯਨ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਚੋਬਦਾਰ ਨਹਿ ਕਿਨੀ ਹਟਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਹੀ ਕੁਮਕ ਆਪਨੀ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਹੀ ਅਮਿਤ ਕੁਲਾਹਲ ਭਯੋ ॥੪੬॥",
      "s": 14
    },
    {
      "t": "ਬਾਜੈ ਲਗੇ ਤਹਾ ਸਦਿਯਾਨੇ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਜਤ ਤਿਹੂੰ ਭਵਨ ਮਹਿ ਜਾਨੇ ॥",
      "s": 14
    },
    {
      "t": "ਢੋਲ ਮ੍ਰਿਦੰਗ ਮੁਚੰਗ ਨਗਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਮੰਦਲ ਤੂਰ ਉਪੰਗ ਅਪਾਰੇ ॥੪੭॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਜੈ ਦਮਾਮਾ ਜਬ ਲਗੇ ਸੁਨਿ ਮਾਰੂ ਧੁਨਿ ਕਾਨ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਖਾਨ ਖਵੀਨ ਜਿਤੇ ਹੁਤੇ ਟੂਟਿ ਪਰੇ ਤਹ ਆਨਿ ॥੪੮॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਐਸੋ ਕਵਨ ਦ੍ਵੈਖਨੀ ਜਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਨੈ ਜੁਝਊਆ ਇਹਾ ਬਜਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਐਸਾ ਭਯੋ ਕਵਨ ਮਤਵਾਲਾ ॥",
      "s": 14
    }
  ]
