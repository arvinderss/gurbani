{
  "page": 1247,
  "lines": [
    {
      "t": "ਅਬ ਤੁਮ ਹਮਰੇ ਸਾਥ ਬਿਹਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਇਸਤ੍ਰੀ ਕਰਿ ਗ੍ਰਿਹ ਮਹਿ ਮੁਹਿ ਬਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਸ ਮੁਰਿ ਲਗਨ ਤੁਮੂ ਪਰ ਲਾਗੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਸ ਤੁਮ ਹੋਹੁ ਮੋਰ ਅਨੁਰਾਗੀ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਆਨੰਦ ਭਯੋ ਕੁਅਰ ਕੇ ਚੀਤਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁ ਕਰਿ ਮਿਲੀ ਰਾਮ ਕਹ ਸੀਤਾ ॥",
      "s": 14
    },
    {
      "t": "ਭੋਜਨ ਜਾਨੁ ਛੁਧਾਤਰੁ ਪਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁ ਨਲ ਮਿਲੀ ਦਮਾਵਤਿ ਆਈ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਉਹੀ ਬ੍ਰਿਛ ਤਰ ਤਾ ਕੌ ਭਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਆਸਨ ਕਹ ਸਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਸਿੰਘ ਕੋ ਚਰਮ ਨਿਕਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਭੋਗ ਕਰੇ ਤਾ ਪਰ ਨਰ ਨਾਰੀ ॥੧੬॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੋ ਨਾਮ ਅਪਛਰਾ ਧਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੀ ਕਿ ਰੀਝਿ ਮੋਹਿ ਇਹ ਬਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਤਾਹਿ ਨਾਰਿ ਕਰਿ ਲ੍ਯਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰੂਪ ਕੇਤੁ ਪਿਤੁ ਭੇਦ ਨ ਪਾਯੋ ॥੧੭॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਤਾ ਕੌ ਬ੍ਯਾਹਿ ਕੈ ਲੈ ਆਯੋ ਨਿਜੁ ਧਾਮ ॥",
      "s": 14
    },
    {
      "t": "ਲੋਕ ਅਪਛਰਾ ਤਿਹ ਲਖੈ ਕੋਊ ਨ ਜਾਨੈ ਬਾਮ ॥੧੮॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਸੁਤ ਬਰਾ ਕਰੌਲ ਹ੍ਵੈ ਭਈ ਅਨਾਥ ਸਨਾਥ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸਭਹੂੰ ਸਿਰ ਰਾਨੀ ਭਈ ਇਹ ਬਿਧਿ ਛਲ ਕੇ ਸਾਥ ॥੧੯॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋ ਸੌ ਅਠਾਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੯੮॥੫੭੬੯॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਚੰਦ੍ਰ ਚੂੜ ਇਕ ਰਹਤ ਭੂਪਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਮਿਤ ਪ੍ਰਭਾ ਜਾ ਕੇ ਗ੍ਰਿਹ ਬਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਸੀ ਦੂਸਰਿ ਜਗ ਮਹਿ ਨਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਨਰੀ ਨਾਗਨੀ ਨਿਰਖਿ ਲਜਾਹੀ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਸਾਹਿਕ ਹੁਤੋ ਅਧਿਕ ਧਨਵਾਨਾ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਜਾ ਸੌ ਧਨੀ ਨ ਜਗ ਮੈ ਆਨਾ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਅਛਲ ਦੇਇ ਦੁਹਿਤਾ ਤਾ ਕੇ ਘਰ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਰਹਤ ਪੰਡਿਤਾ ਸਭ ਮਤਿ ਹਰਿ ਕਰਿ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਚੰਦ੍ਰ ਚੂੜ ਕੋ ਹੁਤੋ ਪੁਤ੍ਰ ਇਕ ॥",
      "s": 14
    },
    {
      "t": "ਪੜਾ ਬ੍ਯਾਕਰਨ ਅਰੁ ਸਾਸਤ੍ਰ ਨਿਕ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੋ ਨਾਮ ਨ ਕਹਬੇ ਆਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਲਿਖਤ ਊਖ ਲਿਖਨੀ ਹ੍ਵੈ ਜਾਵੈ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਦਿਨ ਕੁਅਰ ਅਖੇਟਕ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਹੁ ਸੁਤਾ ਕੋ ਨਿਰਖਤ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਵਾ ਕੀ ਲਗੀ ਲਗਨ ਇਹ ਸੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਗਨ ਭਈ ਤਰੁਨੀ ਸਰਬੰਗਾ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਚਤੁਰਿ ਦੂਤਿ ਇਕ ਤਹਾ ਪਠਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਿਯਹੁ ਐਸ ਕੁਅਰ ਕਹ ਜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਦਿਵਸ ਮੋਰੇ ਘਰ ਆਵਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਥ ਹਮਾਰੇ ਭੋਗ ਮਚਾਵਹੁ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਵਹੁ ਸਖੀ ਕੁਅਰ ਪਹਿ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੀ ਕੁਅਰਿ ਸੋ ਤਾਹਿ ਸੁਨਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਹਸਿ ਸਾਜਨ ਇਹ ਭਾਤਿ ਉਚਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਿਯਹੁ ਜਾਇ ਐਸ ਤੁਮ ਪ੍ਯਾਰੀ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਅਵਧੂਤ ਸੁ ਛਤ੍ਰ ਨ੍ਰਿਪਾਰਾ ॥",
      "s": 14
    }
  ]
