{
  "page": 1248,
  "lines": [
    {
      "t": "ਸੁਨਿਯਤ ਬਸਤ ਸਮੁਦ ਕੇ ਪਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਹੈ ਅਵਧੂਤ ਮਤੀ ਦੁਹਿਤਾ ਤਿਹ ॥",
      "s": 14
    },
    {
      "t": "ਅਵਰ ਨ ਘੜੀ ਬਿਧਾਤਾ ਸਮ ਜਿਹ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਥਮ ਤੂ ਤਿਸੈ ਮੋਹਿ ਮਿਲਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਪਾਛੇ ਮੋ ਸੌ ਪਤਿ ਪਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਯੌ ਜੋ ਕੋਟਿ ਉਪਾਵ ਬਨੈ ਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਤੌ ਮੋ ਸੋ ਨਹਿ ਭੋਗਨ ਪੈ ਹੈ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਯੌ ਹੀ ਸਖੀ ਜਾਇ ਤਿਹ ਕਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਮਨ ਬਚ ਕੁਅਰਿ ਚਕ੍ਰਿਤ ਹ੍ਵੈ ਰਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਚਿਤ ਮੌ ਅਨਿਕ ਚਟਪਟੀ ਲਾਗੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਨੀਂਦ ਭੂਖ ਸਭ ਭਾਗੀ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਸਮੁੰਦਰ ਪਾਰ ਜਾਯੋ ਨਹਿ ਜਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਊ ਕੁਅਰਿ ਕੋ ਸਾਤਿ ਨ ਆਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਜ ਤਹਾ ਚਲਿਬੇ ਕੋ ਕਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤੀਰਥ ਜਾਤ ਹੌ ਪਿਤਹਿ ਉਚਰਾ ॥੧੦॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸਾਜ ਬਾਜ ਸਭ ਕੀਆ ਤ੍ਯਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਹ੍ਵੈ ਚਲੀ ਬਾਜ ਅਸਵਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੇਤਬੰਧ ਰਾਮੇਸ੍ਵਰ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਹ੍ਰਿਦੈ ਬਿਚਾਰਤ ਭਈ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਹ੍ਵੈ ਜਹਾਜ ਅਸਵਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਗਈ ਸਿੰਗਲਾਦੀਪ ਮਝਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਹ ਤਿਹ ਸੁਨਾ ਰਾਜ ਕੋ ਧਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਤ ਭਈ ਤਹ ਹੀ ਕੌ ਬਾਮਾ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਗੀ ਪੁਰਖ ਭੇਸ ਕੋ ਕਰਿ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਕੇ ਭੂਖਨ ਧਰਿ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਅਵਧੂਤ ਮਤੀ ਤਿਹ ਹੇਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਕੁਅਰ ਜਾਨ੍ਯੋ ਕਹੂੰ ਕੇਰਾ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਤ ਕੁਅਰਿ ਮਦਨ ਬਸਿ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਅੰਗ ਅੰਗ ਬਿਹਬਲ ਹ੍ਵੈ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਚਿਤ ਮਹਿ ਕਹਾ ਇਸੀ ਕਹ ਬਰਿ ਹੌ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਤਰ ਘਾਇ ਕਟਾਰੀ ਮਰਿ ਹੌ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਦੇਖੈ ਲਗੀ ਸੀਸ ਨਿਹੁਰਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਤ੍ਰਿਯ ਘਾਤ ਇਹੈ ਕਰ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਰੰਗ ਧਵਾਇ ਜਾਤ ਤਹ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਿੰਘਨਿ ਜਾਨੁ ਮ੍ਰਿਗੀ ਗਹਿ ਲਈ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਝਟਕਿ ਝਰੋਖਾ ਤੇ ਗਹਿ ਲਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਧਤ ਸਾਥ ਪ੍ਰਿਸਟ ਕੇ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਹਾਹਾ ਭਾਖਿ ਲੋਗ ਪਚਿ ਹਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਖਿ ਨ ਸਕੇ ਤਾਹਿ ਰਖਵਾਰੇ ॥੧੬॥",
      "s": 14
    },
    {
      "t": "ਬਾਧਿ ਪ੍ਰਿਸਟਿ ਤਿਹ ਤੁਰੰਗ ਧਵਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਏਕੈ ਬਾਨ ਮਿਲਾ ਸੋ ਘਾਯੋ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤਾ ਕਹ ਜੀਤਿ ਧਾਮ ਲੈ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਖੀ ਕੁਅਰ ਕੇ ਧਾਮ ਪਠਾਈ ॥੧੭॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਤੁਮ ਕਹਾ ਕਾਜ ਮੈ ਕਿਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਪਨੋ ਬੋਲ ਨਿਬਾਹਹੁ ਪਿਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਥਮ ਬ੍ਯਾਹਿ ਮੋ ਕੌ ਲੈ ਜਾਵੌ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਪਾਛੇ ਯਾ ਕਹ ਤੁਮ ਪਾਵੌ ॥੧੮॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਕੁਅਰ ਤਬ ਹੀ ਤਹ ਆਯੋ ॥",
      "s": 14
    }
  ]
}
