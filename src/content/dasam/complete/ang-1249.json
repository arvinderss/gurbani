{
  "page": 1249,
  "lines": [
    {
      "t": "ਤਾ ਸੌ ਪ੍ਰਥਮੈ ਬ੍ਯਾਹ ਕਰਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰੌ ਬ੍ਯਾਹਿ ਤਾਹਿ ਲੈ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਸਿ ਚਰਿਤ੍ਰ ਚੰਚਲਾ ਦਿਖਯੋ ॥੧੯॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਥਮਹਿ ਪਾਰ ਸਮੁੰਦ ਕੈ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਸੁਤਹਿ ਹਰਿ ਲ੍ਯਾਵਤ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰੌ ਮਨ ਭਾਵਤ ਪਤਿ ਕਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰ ਨ ਜਾਤ ਬਿਚਰਿਯੋ ॥੨੦॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋ ਸੌ ਨੰਨ੍ਰਯਾਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੯੯॥੫੭੮੯॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੀਸਸਾਰ ਕੇਤੁ ਇਕ ਰਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਸੋ ਬਿਧਿ ਦੂਸਰ ਨ ਸਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੀਸੈ ਸਾਰ ਦੇਇ ਤਿਹ ਰਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਸਮ ਦੂਸਰ ਹ੍ਵੈ ਨ ਬਖਾਨੀ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਸੌ ਅਧਿਕ ਨ੍ਰਿਪਤਿ ਕੀ ਪ੍ਰੀਤਾ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਸ ਦਿਨ ਰਹੈ ਤਰੁਨਿ ਮੈ ਚੀਤਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਤਕ ਦਿਨਨ ਰਾਨੀ ਮਰਿ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜਾ ਕੀ ਉਦਾਸ ਮਤਿ ਭਈ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਅਵਰ ਨਾਰਿ ਕੀ ਓਰ ਨ ਹੇਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਲ ਨ ਜਾਤ ਕਿਸੀ ਕੇ ਡੇਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਰੀ ਔਰ ਅਧਿਕ ਦੁਖ ਪਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਥ ਮਿਲੇ ਬਿਨੁ ਮੈਨ ਸੰਤਾਵੈ ॥੩॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਮਿਲਿ ਬੈਠੀ ਇਕ ਦਿਨ ਸਭ ਰਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਆਪੁ ਬਿਖੈ ਮਿਲਿ ਕਰਤ ਕਹਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਜੜ ਪਤਿ ਮਤਿ ਕਿਨ ਹਰਿ ਲਈ ॥",
      "v": [
        [
          3,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਕਹਾ ਭਯੋ ਰਾਨੀ ਮਰਿ ਗਈ ॥੪॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਏਤੋ ਸੋਕ ਕਿਯੋ ਜਾ ਕੋ ਇਹ ॥",
      "s": 14
    },
    {
      "t": "ਮਤਿ ਹਰਿ ਲਈ ਕਹਾ ਯਾ ਕੀ ਤਿਹ ॥",
      "s": 14
    },
    {
      "t": "ਹ੍ਵੈ ਹੈ ਤ੍ਰਿਯਾ ਨ੍ਰਿਪਨ ਕੇ ਘਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਸਦਾ ਸਲਾਮਤਿ ਚਹਿਯਤ ਧਨੀ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਸਖੀ ਏਕ ਸ੍ਯਾਨੀ ਤਹ ਅਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਇਹ ਭਾਤਿ ਬਿਹਸਿ ਕਰਿ ਕਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਮੈ ਨ੍ਰਿਪ ਤੇ ਤ੍ਰਿਯ ਸੋਕ ਮਿਟੈਹੌ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਤਿਹਾਰੇ ਸਾਥ ਮਿਲੈਹੌ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਜਾਰਿਕ ਪਕਰਿ ਕੋਠਰੀ ਰਾਖਾ ॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਕੇ ਸੁਨਤ ਐਸ ਬਿਧਿ ਭਾਖਾ ॥",
      "s": 14
    },
    {
      "t": "ਧ੍ਰਿਗ ਇਹ ਮੂੜ ਨ੍ਰਿਪ ਕੋ ਜੀਆ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਅਬਿਬੇਕ ਬਿਬੇਕ ਨ ਕੀਆ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਜੁ ਤ੍ਰਿਯਾ ਔਰ ਸੌ ਭੋਗ ਕਮਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਤਨ ਸਾਥ ਪਤਿਹਿ ਉਰਝਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਜੁ ਕੋਠਰੀ ਛੋਰਿ ਨਿਹਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਚ ਝੂਠ ਤਬ ਆਪੁ ਬਿਚਾਰੈ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਕੇ ਸ੍ਰਵਨਨ ਧੁਨਿ ਇਹ ਪਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਰਤੁ ਕੁਠਰੀਯਾ ਜਾਇ ਉਘਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਹੇਰਾ ਜਬ ਵਹੁ ਮਨੁਛ ਬਨਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਐਸੇ ਤਿਹ ਕਹਾ ਰਿਸਾਈ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਇਤੋ ਸੋਕ ਹਮ ਕੀਯੋ ਨਿਕਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਨ ਲਹਤ ਥੋ ਐਸ ਨਿਲਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਮੈ ਰਨਿਯਨ ਅਵਰ ਬਿਹਾਰੌ ॥",
      "s": 14
    }
  ]
}
