  "page": 1250,
  "lines": [
    {
      "t": "ਰਾਨੀ ਮਰੀ ਨ ਫੇਰਿ ਚਿਤਾਰੌ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਔਰ ਤ੍ਰਿਯਨ ਕੇ ਸਾਥ ਬਿਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਵਾ ਰਾਨੀ ਕਹ ਨ੍ਰਿਪਤਿ ਬਿਸਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਤ੍ਰਿਯਨ ਨਰਿੰਦ੍ਰਹਿ ਛਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯ ਚਰਿਤ੍ਰ ਅਤਿਭੁਤ ਇਹ ਕਰਾ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੦੦॥੫੮੦੦॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਇਛਾਵਤੀ ਨਗਰ ਇਕ ਸੁਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਛ ਸੈਨ ਰਾਜਾ ਬਹੁ ਗੁਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਸਟ ਮਤੀ ਤਾ ਕੇ ਘਰ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਇਸਟ ਦੇਵਕਾ ਰਹਤ ਦੁਲਾਰੀ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਅਜੈ ਸੈਨ ਖਤਰੇਟਾ ਤਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਆਵਤ ਭਯੋ ਧਾਮ ਤ੍ਰਿਯ ਜਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਣੀ ਤਾ ਕੋ ਰੂਪ ਨਿਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਗਿਰੀ ਧਰਨਿ ਜਨੁ ਲਗਿਯੋ ਕਟਾਰਾ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਉੜਦਾ ਬੇਗ ਨਿਪੁੰਸਕ ਬਨੇ ॥",
      "s": 14
    },
    {
      "t": "ਪਠੈ ਦਏ ਰਾਨੀ ਤਹ ਘਨੇ ॥",
      "s": 14
    },
    {
      "t": "ਗਹਿ ਕਰਿ ਤਾਹਿ ਲੈ ਗਏ ਤਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਰਨੀ ਪੰਥ ਬਿਲੋਕਤ ਜਹਾ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਤਾ ਸੌ ਰਾਨੀ ਕਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਪੌਢੇ ਦੋਊ ਜਾਇ ਪਲਘਾ ਪਰ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਲਗਿ ਆਇ ਨ੍ਰਿਪਤਿ ਤਹ ਗਏ ॥",
      "s": 14
    },
    {
      "t": "ਸੋਵਤ ਦੁਹੂੰ ਬਿਲੋਕਤ ਭਏ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਭਰਭਰਾਇ ਤ੍ਰਿਯ ਜਗੀ ਦੁਖਾਤੁਰ ॥",
      "s": 14
    },
    {
      "t": "ਡਾਰਿ ਦਯੋ ਦੁਪਟਾ ਪਤਿ ਮੁਖ ਪਰ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਲੌ ਕਰਤ ਦੂਰਿ ਨ੍ਰਿਪ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਲੌ ਜਾਰਿ ਭਾਜਿ ਕਰਿ ਗਯੋ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਦੁਪਟਾ ਦੂਰਿ ਕਰਾ ਨ੍ਰਿਪ ਜਬੈ ॥",
      "s": 14
    },
    {
      "t": "ਪਕਰ ਲਿਯੋ ਰਾਨੀ ਕਹ ਤਬੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਾ ਗਯੋ ਵਹੁ ਜੁ ਮੈ ਨਿਹਾਰਾ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਬਿਨੁ ਨ ਕਹੈ ਭ੍ਰਮ ਮਿਟੈ ਹਮਾਰਾ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਥਮੈ ਜਾਨ ਮਾਫ ਮੁਰ ਕੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰੌ ਬਾਤ ਸਾਚ ਸੁਨਿ ਲੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਬਚਨੁ ਦੇਹੁ ਮੇਰੇ ਜੌ ਹਾਥਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਲੇਹੁ ਬਿਨਤੀ ਸੁਨਿ ਨਾਥਾ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਭੈਂਗੇ ਨੇਤ੍ਰ ਤੋਰਿ ਬਿਧਿ ਕਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਤੈ ਜਾਤ ਦੋਇ ਲਖ ਪਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਮ ਕਹ ਕਛੂ ਝਾਵਰੋ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੁਹਿ ਕੋ ਦਿਖਿ ਲਖਿ ਕਰਿ ਦ੍ਵੈ ਪਾਯੋ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਸੁਨਿ ਬਚਨ ਚਕ੍ਰਿਤ ਹ੍ਵੈ ਰਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯ ਸੌ ਬਹੁਰਿ ਬਚਨ ਨਹਿ ਕਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਮੁਖ ਮੂੰਦੇ ਘਰ ਕੌ ਫਿਰਿ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਰਮ ਰੇਖ ਕਹ ਦੋਸ ਲਗਾਯੋ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਇਕ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੦੧॥੫੮੦੯॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੋਰਠ ਸੈਨ ਏਕ ਭੂਪਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਤੇਜਵਾਨ ਬਲਵਾਨ ਛਿਤਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੋਰਠ ਦੇ ਤਾ ਕੈ ਘਰ ਰਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੁੰਦਰ ਸਕਲ ਭਵਨ ਮਹਿ ਜਾਨੀ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਛਤ੍ਰਿ ਸੈਨ ਤਹ ਸਾਹ ਭਨਿਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਛਤ੍ਰ ਦੇਇ ਇਕ ਸੁਤਾ ਕਹਿਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਤ ਭਵਾਨ ਭਵਿਖ੍ਯ ਮਝਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਭਈ ਨ ਹੈ ਹ੍ਵੈ ਹੈ ਨ ਕੁਮਾਰੀ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਵਹੁ ਤਰੁਨਿ ਚੰਚਲਾ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਲਰਿਕਾਪਨ ਕੀ ਸੁਧਿ ਬੁਧਿ ਗਈ ॥",
