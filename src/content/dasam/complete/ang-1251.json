{
  "page": 1251,
  "lines": [
    {
      "t": "ਮੁਹਿ ਕਸ ਚਹਤ ਭਲਾਈ ਕਰਿਯੋ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਪਤਿ ਮਾਰਿਯੋ ਜਾ ਕੇ ਹਿਤ ਗਯੋ ॥",
      "v": [
        [
          4,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸੋ ਭੀ ਅੰਤ ਨ ਤਾ ਕੋ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਐਸੋ ਮਿਤ੍ਰ ਕਛੂ ਨਹੀ ਕਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਰਾਖੇ ਤੇ ਭਲੋ ਸੰਘਰਿਯੋ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਕਰ ਮਹਿ ਕਾਢਿ ਭਗੌਤੀ ਲਈ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਹੂੰ ਹਾਥ ਤਾ ਕੋ ਸਿਰ ਦਈ ॥",
      "s": 14
    },
    {
      "t": "ਹਾਇ ਹਾਇ ਜਿਮਿ ਭੂਪ ਪੁਕਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਯੋ ਤ੍ਰਯੋ ਨਾਰਿ ਕ੍ਰਿਪਾਨਨ ਮਾਰੈ ॥੯॥",
      "v": [
        [
          0,
          1
        ],
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਦ੍ਵੈ ਦਿਨ ਭਏ ਨ ਪਤਿ ਕੇ ਮਰੈ ॥",
      "v": [
        [
          3,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਐਸੀ ਲਗੇ ਅਬੈ ਏ ਕਰੈ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਧ੍ਰਿਗ ਜਿਯਬੋ ਪਿਯ ਬਿਨੁ ਜਗ ਮਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਰ ਚੋਰ ਜਿਹ ਹਾਥ ਚਲਾਹੀ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਮਰਿਯੋ ਨਿਰਖਿ ਤਿਹ ਸਭਨ ਉਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਭਲਾ ਕਰਾ ਤੈ ਜਾਰ ਸੰਘਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਚਾਦਰ ਕੀ ਲਜਾ ਤੈ ਰਾਖੀ ॥",
      "s": 14
    },
    {
      "t": "ਧੰਨ੍ਯ ਧੰਨ੍ਯ ਪੁਤ੍ਰੀ ਤੂ ਭਾਖੀ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਦੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੦੨॥੫੮੨੦॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਭਰਨ ਸਿੰਘ ਸੁਨਾ ਇਕ ਨ੍ਰਿਪ ਬਰ ॥",
      "s": 14
    },
    {
      "t": "ਲਜਤ ਹੋਤ ਜਿਹ ਨਿਰਖਿ ਦਿਵਾਕਰ ॥",
      "s": 14
    },
    {
      "t": "ਅਭਰਨ ਦੇਇ ਸਦਨ ਮਹਿ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਮਥਿ ਅਭਰਨ ਜਣੁ ਸਕਲ ਨਿਕਾਰੀ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਹੁਤੀ ਮਿਤ੍ਰ ਸੇਤੀ ਰਤਿ ॥",
      "s": 14
    },
    {
      "t": "ਭੋਗਤ ਹੁਤੀ ਤਵਨ ਕਹ ਨਿਤਿਪ੍ਰਤਿ ॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਦਿਨ ਭੇਦ ਰਾਵ ਲਖਿ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯ ਕੇ ਧਾਮ ਬਿਲੋਕਨ ਆਯੋ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਤੇ ਲਯੋ ਪਕਰਿ ਇਕ ਜਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤੌਨੇ ਠੌਰਿ ਮਾਰਿ ਕਰਿ ਡਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਸਤ੍ਰੀ ਜਾਨਿ ਨ ਇਸਤ੍ਰੀ ਮਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਚਿਤ ਅਪਨੇ ਤੇ ਦਈ ਬਿਸਾਰੀ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਬੀਤਤ ਬਰਖ ਅਧਿਕ ਜਬ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਬਹੁ ਉਪਚਾਰ ਬਨਏ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜਾ ਤਾ ਕੇ ਧਾਮ ਨ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਇਕ ਔਰੁਪਚਾਰ ਬਨਾਯੋ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਭੇਸ ਸੰਨ੍ਯਾਸਿਨਿ ਕੋ ਧਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਤ ਭਈ ਤਜਿ ਧਾਮ ਨਿਕਰਿ ਕਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਖੇਲਤ ਨ੍ਰਿਪਤਿ ਅਖਿਟ ਜਬ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਹਰਿਨ ਲਖਿ ਤੁਰੰਗ ਧਵਾਯੋ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਜੋਜਨ ਕਿਤਕ ਨਗਰ ਤੇ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪਹੁਚਤ ਜਹ ਨ ਮਨੁਛ ਇਕ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਉਤਰਿਯੋ ਬਿਕਲ ਬਾਗ ਮੈ ਜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਇਕਲ ਪਹੂਚੀ ਆਈ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਸੰਨ੍ਯਾਸਿਨਿ ਕੋ ਭੇਸ ਬਨਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਸੀਸ ਜਟਨ ਕੋ ਜੂਟ ਛਕਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਨਰੁ ਤਾ ਕੋ ਰੂਪ ਨਿਹਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਉਰਝਿ ਰਹੈ ਨਹਿ ਸੰਕ ਬਿਚਾਰੈ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਉਤਰਤ ਬਾਗ ਤਿਹੀ ਤ੍ਰਿਯ ਭਈ ॥",
      "s": 14
    }
  ]
}
