{
  "page": 1258,
  "lines": [
    {
      "t": "ਜਬ ਵਹੁ ਬ੍ਯਾਹਿ ਤਾਹਿ ਲੈ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਜੁ ਸਦਨਨ ਲੈ ਪ੍ਰਾਪਤਿ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਪੁਰਖ ਤਿਨ ਨਾਰਿ ਨਿਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੀ ਸਮ ਨਹਿ ਰਾਜ ਕੁਮਾਰਾ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਤ ਤਾਹਿ ਲਗਨ ਤਿਹ ਲਗੀ ॥",
      "s": 14
    },
    {
      "t": "ਨੀਦ ਭੂਖਿ ਤਬ ਹੀ ਤੇ ਭਗੀ ॥",
      "s": 14
    },
    {
      "t": "ਪਠੈ ਸਹਚਰੀ ਤਾਹਿ ਬੁਲਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਰੁਚਿ ਮਾਨ ਕਮਾਵੈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਸੰਗ ਤਾ ਕੇ ਬਹੁ ਬਧਾ ਸਨੇਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਝਨ ਔਰ ਹੀਰ ਕੋ ਜੇਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਬੀਰਜ ਕੇਤ ਕਹ ਯਾਦਿ ਨ ਲ੍ਯਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਧਰਮ ਭ੍ਰਾਤ ਕਹਿ ਤਾਹਿ ਬੁਲਾਵੈ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਸਸੁਰ ਕੇ ਲੋਗ ਨ ਜਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਧਰਮ ਭ੍ਰਾਤ ਤਿਹ ਤ੍ਰਿਯ ਪਹਿਚਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਨ ਮੂਰਖ ਲਹਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਭ੍ਰਾਤਾ ਜਾਨ ਕਛੂ ਨਹਿ ਕਹਹੀ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਦਿਨ ਤ੍ਰਿਯ ਇਹ ਭਾਤਿ ਉਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਜੁ ਪਤਿ ਕੌ ਦੈ ਕੈ ਬਿਖੁ ਮਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਸੌ ਰੋਦਨ ਕਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਲੋਗ ਲਖਤ ਸਿਰ ਕੇਸ ਉਪਰੈ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਮੈ ਧਾਮ ਕਵਨ ਕੇ ਰਹੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੈ ਪਿਯ ਸਬਦ ਕਵਨ ਸੌ ਕਹੋ ॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਯਾਇ ਨਹੀ ਹਰਿ ਕੇ ਘਰਿ ਭੀਤਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਗਤਿ ਕਰੀ ਮੋਰਿ ਅਵਨੀ ਤਰ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਗ੍ਰਿਹ ਕੋ ਦਰਬ ਸੰਗ ਕਰਿ ਲੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਿਤ੍ਰਹਿ ਸੰਗ ਪਯਾਨਾ ਕੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਧਰਮ ਭਾਇ ਜਾ ਕੌ ਕਰਿ ਭਾਖਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਨਾਥ ਧਾਮ ਕਰਿ ਰਾਖਾ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਲੋਗ ਸਭੈ ਇਹ ਭਾਤਿ ਉਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਆਪੁ ਬਿਖੈ ਮਿਲਿ ਕਰਤ ਬਿਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਾ ਕਰੈ ਇਹ ਨਾਰਿ ਬਿਚਾਰੀ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਜਾ ਕੀ ਦੈਵ ਐਸ ਗਤਿ ਧਾਰੀ ॥੧੧॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਲੈ ਸਭ ਹੀ ਧਨ ਧਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਪੁਨੇ ਗਈ ਭਾਇ ਕੇ ਬਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਨ ਸਕਤ ਬਿਚਰਿ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਗਈ ਜਾਰ ਕੇ ਨਾਥ ਸੰਘਰਿ ਕੈ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਨੌ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੦੯॥੫੯੧੨॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਪੁਨਿ ਮੰਤ੍ਰੀ ਇਹ ਭਾਤਿ ਉਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਹੁ ਨ੍ਰਿਪਤਿ ਜੂ ਬਚਨ ਹਮਾਰਾ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਗਾਰਵ ਦੇਸ ਬਸਤ ਹੈ ਜਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਗੌਰ ਸੈਨ ਰਾਜਾ ਥੋ ਤਹਾ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਰਸ ਤਿਲਕ ਦੇਇ ਤਿਹ ਦਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਚੰਦ੍ਰ ਲਿਯੋ ਜਾ ਤੇ ਉਜਿਯਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਮੁੰਦ੍ਰਕ ਲਛਨ ਤਾ ਮੈ ਸਬਿ ॥",
      "s": 14
    },
    {
      "t": "ਛਬਿ ਉਚਾਰ ਤਿਹ ਸਕੈ ਕਵਨ ਕਬਿ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਇਕ ਹੁਤੋ ਸਾਹ ਕੋ ਪੂਤਾ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਤਲ ਕੋ ਜਾਨੁਕ ਪੁਰਹੂਤਾ ॥",
      "s": 14
    }
  ]
}
