{
  "page": 1263,
  "lines": [
    {
      "t": "ਚਹਿਯਤ ਹਨੀ ਕਿ ਤੁਰਤ ਨਿਕਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਭਲੋ ਨ ਗਵਨ ਕਰੋ ਤਾ ਕੇ ਛਿਨ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਰਾਚਾਰ ਤ੍ਰਿਯ ਕਰਤ ਜੁ ਨਿਸ ਦਿਨ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਇਨ ਕੇ ਜੋਗ ਏਕ ਤ੍ਰਿਯ ਅਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਸਾਹ ਕੇ ਜਾਈ ਕਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਜ੍ਯੋਂ ਇਹ ਨ੍ਰਿਪ ਪੁਰਖਨ ਕੋ ਰਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਯੋ ਵਹੁ ਨਾਰਿ ਤ੍ਰਿਯਨ ਸਿਰਤਾਜਾ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਜੌ ਵਾ ਕੌ ਰਾਜਾ ਗ੍ਰਿਹ ਲ੍ਯਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਪਾਟ ਤਬ ਸਕਲ ਸੁਹਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਲਖੇ ਤ੍ਰਿਯ ਸਭ ਦੁਰਿ ਜਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਮਿ ਉਡਗਨ ਰਵਿ ਕੀ ਪਰਛਾਹੀ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਰਾਜੈ ਇਹ ਬਿਧਿ ਸੁਨ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਇਹੈ ਮਤੋ ਜਿਯ ਮਾਝ ਪਕਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਰਾਚਾਰਿ ਇਸਤ੍ਰੀ ਪਰਹਰੌ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਜੁ ਤ੍ਰਿਯ ਸਾਹ ਸੁਤਾ ਲੈ ਕਰੌ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਾਤੈ ਕਾਲ ਧਾਮ ਜਬ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਨੇਗੀ ਮਹਤਨ ਬੋਲਿ ਪਠਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਹ ਸੁਤਾ ਜਿਹ ਤਿਹ ਬਿਧਿ ਲਈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਡਾਰਿ ਹ੍ਰਿਦੈ ਤੇ ਦਈ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਚਰਿਤ੍ਰ ਤਹ ਚੰਚਲਾ ਤਾ ਕੋ ਚਰਿਤ ਦਿਖਾਇ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਨਿਜੁ ਤ੍ਰਿਯ ਸਾਥ ਤੁਰਾਇ ਤਿਹ ਆਪਨ ਭਜ੍ਯੋ ਬਨਾਇ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਚੌਦਹ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੧੪॥੫੯੭੩॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਹਿਰ ਇਟਾਵਾ ਗੰਗ ਤੀਰ ਜਹ ॥",
      "s": 14
    },
    {
      "t": "ਪਾਲ ਸੁ ਪਛਿਮ ਹੁਤੇ ਨ੍ਰਿਪਤਿ ਤਹ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਰਿ ਸੁ ਪਛਿਮ ਦੇ ਤਾ ਕੇ ਘਰ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਰੀ ਨਾਗਨੀ ਨਰੀ ਨ ਸਰਬਰ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਬਾਢੀ ਏਕ ਰਾਨਿਯਹਿ ਹੇਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਦਨ ਦੇਹ ਤਬ ਹੀ ਤਿਹ ਘੇਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਨੇਹ ਤਿਹ ਸਾਥ ਬਢਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜਾ ਕੋ ਚਿਤ ਤੇ ਬਿਸਰਾਯੋ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਐਸੀ ਰਸਿਗੀ ਤਾ ਸੌ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਤੇ ਪਤਿ ਤਨ ਪ੍ਰੀਤਿ ਬਿਸਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਗੇਰੂ ਘੋਰਿ ਪਾਨ ਕਰਿ ਲੀਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੁਖ ਤੇ ਡਾਰਿ ਲਖਤ ਨ੍ਰਿਪ ਦੀਯੋ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਜਾਨਾ ਸ੍ਰੋਣ ਬਦਨ ਤੇ ਬਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਮਨ ਮੈ ਇਹ ਸੂਲ ਨ ਛਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਤਿ ਆਤੁਰ ਹ੍ਵੈ ਬੈਦ ਬੁਲਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਚਿਹਨ ਰੋਗ ਤਿਹ ਨਾਰਿ ਸੁਨਾਏ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤਿਨ ਪੀ ਗੇਰੂ ਪੁਨਿ ਡਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੋਣ ਬਮਾ ਸਭਹੂਨ ਬਿਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਪਤਿ ਸੋ ਇਮ ਨਾਰਿ ਉਚਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਰਾਨੀ ਕਹ ਮਰੀ ਬਿਚਾਰੋ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਕਹਤ ਨ੍ਰਿਪਤਿ ਸੋ ਕਰਿਯਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਮੇਰੋ ਬਹੁਰਿ ਨ ਬਦਨ ਨਿਹਰਿਯਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਔਰ ਸਖੀ ਕਾਹੂ ਨ ਦਿਖੈਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਜਾਇ ਜਾਰ ਘਰਿ ਐਯੋ ॥੬॥",
      "s": 14
    }
  ]
}
