{
  "page": 1265,
  "lines": [
    {
      "t": "ਸਾਸ ਘੂਟਿ ਜਨੁ ਕਰਿ ਮਰਿ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਖਿਯਨ ਲਪਿਟਿ ਬਸਤ੍ਰ ਮਹਿ ਲਈ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਬਕਰੀ ਬਾਧਿ ਸਿਰ੍ਰਹੀ ਮਧਿ ਦੀਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਛੋਰ ਬਸਤ੍ਰ ਪਿਤੁ ਮਾਤ ਨ ਚੀਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਹੂੰ ਸੁਤਾ ਕੋ ਬਚਨ ਸੰਭਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਲ ਕੇ ਮਾਝ ਬਕਰਿਯਹਿ ਜਾਰਾ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਗਈ ਜਾਰ ਸੰਗ ਰਾਜ ਕੁਮਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਕਿਨੀ ਨ ਬਿਚਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਹਿਤਾ ਮਰੀ ਜਾਰਿ ਜਨੁ ਦੀਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯ ਚਰਿਤ੍ਰ ਕੀ ਕ੍ਰਿਯਾ ਨ ਚੀਨੀ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਸੋਲਹ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੧੬॥੫੯੯੩॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਮੰਤ੍ਰੀ ਕਥਾ ਉਚਾਰੀ ਔਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜਾ ਦੇਸ ਬੰਗਲਾ ਗੌਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਸਮਨ ਪ੍ਰਭਾ ਤਾ ਕੀ ਪਟਰਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਸਮ ਸੁਨੀ ਨ ਕਿਨੀ ਬਖਾਨੀ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਪੁਹਪ ਪ੍ਰਭਾ ਇਕ ਰਾਜ ਦੁਲਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਬਿਧਾਤਾ ਤਸਿ ਨ ਸਵਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੀ ਆਭਾ ਜਾਤ ਨ ਕਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁ ਕਰਿ ਫੂਲਿ ਅਬਾਸੀ ਰਹੀ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਭੂਮਿ ਗਿਰੀ ਤਾ ਕੀ ਸੁੰਦ੍ਰਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਅਬਾਸੀ ਲਈ ਲਲਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਗਾਲ੍ਰਹਨ ਤੇ ਜੋ ਰਸ ਚੁਇ ਪਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਭਯੋ ਗੁਲਾਬ ਤਿਸੀ ਤੇ ਹਰਾ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਜੋਬਨ ਜਬ ਆਯੋ ਅੰਗ ਤਾ ਕੇ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਹ ਏਕ ਆਯੌ ਤਬ ਵਾ ਕੇ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਪੁਤ੍ਰ ਸੁੰਦਰਿ ਤਿਹ ਸੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਨ ਮਨਸਾ ਦ੍ਵੈ ਜਏ ਅਨੰਗਾ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਗਾਜੀ ਰਾਇ ਨਾਮ ਤਿਹ ਨਰ ਕੋ ॥",
      "s": 14
    },
    {
      "t": "ਕੰਕਨ ਜਾਨ ਕਾਮ ਕੇ ਕਰ ਕੋ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਖਨ ਕੋ ਭੂਖਨ ਤਿਹ ਮਾਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੂਖਨ ਕੋ ਦੂਖਨ ਪਹਿਚਾਨੋ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਪੁਹਪ ਪ੍ਰਭਾ ਤਾ ਕੋ ਜਬ ਲਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਨ ਬਚ ਕ੍ਰਮ ਐਸੇ ਕਰ ਕਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਐਸਿ ਕਰੌ ਮੈ ਕਵਨ ਉਪਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਮੋਰਿ ਇਹੀ ਸੰਗ ਹੋਇ ਸਗਾਈ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਾਤਹਿ ਕਾਲ ਸੁਯੰਬਰ ਕਿਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਕੁੰਕਮ ਡਾਰਿ ਤਿਸੀ ਪਰ ਦਿਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਰੁ ਪੁਹਪਨ ਤੈ ਡਾਰਿਸਿ ਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਹੇਰਿ ਰਹੇ ਮੁਖ ਭੂਪ ਅਪਾਰਾ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਨ੍ਰਿਪ ਸੁਤ ਸਭਹੂੰ ਕਰਿ ਜਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਹ ਪੁਤ੍ਰ ਕਿਨਹੂੰ ਨ ਪਛਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਤ ਪਿਤਾ ਨਹਿ ਭੇਦ ਬਿਚਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਕੁਅਰਿ ਸਭਨ ਕਹ ਛਰਾ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਸਤ੍ਰਹ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੧੭॥੬੦੦੧॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਮਰਗਜ ਸੈਨ ਹੁਤੋ ਇਕ ਨ੍ਰਿਪ ਬਰ ॥",
      "s": 14
    },
    {
      "t": "ਮਰਗਜ ਦੇਇ ਨਾਰਿ ਜਾ ਕੇ ਘਰ ॥",
      "s": 14
    }
  ]
}
