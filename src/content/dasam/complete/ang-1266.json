    {
      "t": "ਰੂਪਵਾਨ ਧਨਵਾਨ ਬਿਸਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਭਿਛਕ ਕਲਪਤਰੁ ਦ੍ਰੁਜਨਨ ਕਾਲਾ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਮੂੰਗੀ ਪਟਨਾ ਦੇਸ ਤਵਨ ਕੋ ॥",
      "s": 14
    },
    {
      "t": "ਜੀਤਿ ਕਵਨ ਰਿਪੁ ਸਕਤ ਜਵਨ ਕੋ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਅਪ੍ਰਮਾਨ ਤਿਹ ਪ੍ਰਭਾ ਬਿਰਾਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਰ ਨਰ ਨਾਗ ਅਸੁਰ ਮਨ ਲਾਜੈ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਪੁਰਖ ਰਾਨੀ ਲਖਿ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤੇਜਮਾਨ ਗੁਨਮਾਨ ਸਵਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪੁਹਪ ਰਾਜ ਜਨੁ ਮਧਿ ਪੁਹਪਨ ਕੇ ॥",
      "s": 14
    },
    {
      "t": "ਚੋਰਿ ਲੇਤਿ ਜਨੁ ਚਿਤ ਇਸਤ੍ਰਿਨ ਕੇ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਸੋਰਠਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਲਯੋ ਬੁਲਾਇ ਤਵਨ ਪੁਰਖ ਅਪਨੇ ਸਦਨ ॥",
      "v": [
        [
          2,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਅਤਿ ਰੁਚਿ ਅਧਿਕ ਬਢਾਇ ਤਾ ਸੌ ਰਤਿ ਮਾਨਤ ਭਈ ॥੪॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਲਗਿ ਨਾਥ ਧਾਮ ਤਿਹ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮਨਹਾਤਰ ਤ੍ਰਿਯ ਜਾਰ ਛਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁ ਬੁਗਚਾ ਆਗੇ ਦੈ ਡਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੇ ਜਾਤ ਨ ਅੰਗ ਨਿਹਾਰੇ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਬਹੁ ਚਿਰ ਤਹ ਬੈਠਾ ਨ੍ਰਿਪ ਰਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਭਲਾ ਬੁਰਾ ਕਛੁ ਭੇਦ ਨ ਲਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਹੀ ਉਠਿ ਅਪਨੋ ਘਰ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਹੀ ਤ੍ਰਿਯ ਘਰ ਮੀਤ ਪਠਾਯੋ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਅਠਾਰਹ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੧੮॥੬੦੦੭॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨੋ ਨ੍ਰਿਪਤਿ ਮੈ ਭਾਖਤ ਕਥਾ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਜਹ ਮਿਲਿ ਦੇਵ ਸਮੁਦ ਕਹ ਮਥਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਹਾ ਸੁਬ੍ਰਤ ਨਾਮਾ ਮੁਨਿ ਰਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਬ੍ਰਤੀ ਜਾ ਕਹ ਜਗ ਕਹੈ ॥੧॥",
