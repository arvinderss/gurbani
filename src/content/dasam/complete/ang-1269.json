{
  "page": 1269,
  "lines": [
    {
      "t": "ਗੜੇਦਾਰ ਮਾਨੋ ਕਰੀ ਮਤ ਕੀ ਜ੍ਯੋ ॥੨੪॥",
      "s": 14
    },
    {
      "t": "ਤਬੈ ਕੋਪ ਕੈ ਕ੍ਰਿਸਨ ਮਾਰੇ ਚੰਦੇਲੇ ॥",
      "s": 14
    },
    {
      "t": "ਮਘੇਲੇ ਧਧੇਲੇ ਬਘੇਲੇ ਬੁੰਦੇਲੇ ॥",
      "s": 14
    },
    {
      "t": "ਚੰਦੇਰੀਸ ਹੂੰ ਕੌ ਤਬੈ ਬਾਨ ਮਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਗਿਰਿਯੋ ਭੂਮਿ ਪੈ ਨ ਹਥ੍ਯਾਰੈ ਸੰਭਾਰਾ ॥੨੫॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਰਾਸਿੰਧ ਕਹਿ ਪੁਨਿ ਸਰ ਮਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਗਿ ਚਲਿਯੋ ਨ ਹਥ੍ਯਾਰ ਸੰਭਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਭਿਰੇ ਸੁ ਮਰੇ ਬਚੇ ਤੇ ਹਾਰੇ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੰਦੇਰਿਯਹਿ ਚੰਦੇਲ ਸਿਧਾਰੇ ॥੨੬॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਰੁਕਮੀ ਪਹੁਚਤ ਭਯੋ ਜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਕ੍ਰਿਸਨ ਸੌ ਕਰੀ ਲਰਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਬਿਸਿਖ ਪ੍ਰਹਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਹਾਰਿਯੋ ਵਹੈ ਕ੍ਰਿਸਨ ਨਹਿ ਹਾਰੇ ॥੨੭॥",
      "s": 14
    },
    {
      "t": "ਚਿਤ ਮੈ ਅਧਿਕ ਠਾਨਿ ਕੈ ਕ੍ਰੁਧਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਡਤ ਭਯੋ ਕ੍ਰਿਸਨ ਸੌ ਜੁਧਾ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਬਾਨ ਤਬ ਸ੍ਯਾਮ ਪ੍ਰਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਗਿਰਿਯੋ ਪ੍ਰਿਥੀ ਪਰ ਜਾਨੁ ਸੰਘਾਰਾ ॥੨੮॥",
      "s": 14
    },
    {
      "t": "ਸਰ ਸੌ ਮੂੰਡਿ ਪ੍ਰਥਮ ਤਿਹ ਸੀਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਧਿ ਲਯੋ ਰਥ ਸੌ ਜਦੁਈਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਭ੍ਰਾਤ ਜਾਨਿ ਰੁਕਮਿਨੀ ਛਡਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਲਜਤ ਧਾਮ ਸਿਸਪਾਲ ਸਿਧਾਯੋ ॥੨੯॥",
      "s": 14
    },
    {
      "t": "ਕਿਨੂੰ ਚੰਦੇਲਨ ਕੇ ਸਿਰ ਤੂਟੇ ॥",
      "s": 14
    },
    {
      "t": "ਕਈਕ ਗਏ ਮੂੰਡ ਘਰ ਟੂਟੇ ॥",
      "s": 14
    },
    {
      "t": "ਸਕਲ ਚੰਦੇਲੇ ਲਾਜ ਲਜਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਰਿ ਗਵਾਇ ਚੰਦੇਰੀ ਆਏ ॥੩੦॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਗਏ ਚੰਦੇਲ ਚੰਦੇਰਿਯਹਿ ਕਰ ਤੇ ਨਾਰਿ ਗਵਾਇ ॥",
      "v": [
        [
          2,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਹ ਚਰਿਤ੍ਰ ਤਨ ਰੁਕਮਨੀ ਬਰਤ ਭਈ ਜਦੁਰਾਇ ॥੩੧॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਬੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੨੦॥੬੦੪੩॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਕ੍ਰਾਚਾਰਜ ਦਾਨ੍ਵਨ ਕੋ ਗੁਰ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਕ੍ਰਾਵਤੀ ਬਸਤ ਜਾ ਕੋ ਪੁਰ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਰਿ ਦੇਵ ਜਾ ਕੌ ਰਨ ਜਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਪੜਿ ਸੰਜੀਵਨਿ ਤਾਹਿ ਜਿਯਾਵੈ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਦੇਵਜਾਨਿ ਇਕ ਸੁਤਾ ਤਵਨ ਕੀ ॥",
      "s": 14
    },
    {
      "t": "ਅਪ੍ਰਮਾਨ ਛਬਿ ਹੁਤੀ ਜਵਨ ਕੀ ॥",
      "s": 14
    },
    {
      "t": "ਕਚ ਨਾਮਾ ਦੇਵਨ ਕੋ ਦਿਜਬਰ ॥",
      "s": 14
    },
    {
      "t": "ਆਵਤ ਭਯੋ ਸੁਕ੍ਰ ਕੇ ਤਬ ਘਰ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਦੇਵਜਾਨਿ ਸੰਗਿ ਕਿਯਾ ਅਧਿਕ ਹਿਤ ॥",
      "s": 14
    },
    {
      "t": "ਹਰਿ ਲੀਨੋ ਜ੍ਯੋਂ ਤ੍ਯੋਂ ਤ੍ਰਿਯ ਕੋ ਚਿਤ ॥",
      "s": 14
    },
    {
      "t": "ਮੰਤ੍ਰਹਿ ਲੇਨ ਸੰਜੀਵਨ ਕਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਪਠਿਯੋ ਦੇਵਤਨ ਰਾਜਾ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਦੈਤ ਭੇਦ ਪਾਵਤ ਜਬ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੋ ਡਾਰਿ ਨਦੀ ਹਨਿ ਗਏ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਲਮ ਲਗੀ ਵਹ ਧਾਮ ਨ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਵਜਾਨਿ ਅਤਿ ਹੀ ਦੁਖ ਪਾਯੋ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਭਾਖਿ ਪਿਤਾ ਤਨ ਬਹੁਰਿ ਜਿਯਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੈਤਨ ਦੇਖ ਅਧਿਕ ਦੁਖ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਤਿਪ੍ਰਤਿ ਮਾਰਿ ਤਾਹਿ ਉਠਿ ਜਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਪੁਨਿ ਪੁਨਿ ਤਾ ਕੌ ਸੁਕ੍ਰ ਜਿਯਾਵੈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤਿਹ ਮਾਰਿ ਮਦ੍ਰਯ ਮਹਿ ਡਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਚਤ ਭੂੰਜਿ ਨਿਜੁ ਗੁਰਹਿ ਖਵਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਵਜਾਨਿ ਜਬ ਤਾਹਿ ਨ ਲਹਾ ॥",
