    },
    {
      "t": "ਯੌ ਕਚ ਤਨ ਤਜਿ ਲਾਜ ਉਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਮੋ ਸੌ ਤੈ ਕਰੁ ਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਹਮਰੇ ਮਦਨ ਤਾਪ ਕਹ ਹਰੁ ਰੇ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਰਤਿ ਕਰੀ ਨ ਤਾ ਤੇ ਸੰਗਾ ॥",
      "s": 14
