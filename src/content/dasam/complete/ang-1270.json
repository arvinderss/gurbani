{
  "page": 1270,
  "lines": [
    {
      "t": "ਬ੍ਯਾਪਿ ਰਹਿਯੋ ਤਿਹ ਜਦਿਪ ਅਨੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਵਜਾਨਿ ਤਬ ਅਧਿਕ ਰਿਸਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਮੋਹਿ ਨ ਭਜ੍ਯੋ ਯਾਹਿ ਦੁਖਦਾਈ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਸ੍ਰਾਪ ਦੇਤ ਤਿਹ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਕਥਾ ਚਉਪਈ ਸੁ ਮੈ ਬਨਈ ॥",
      "s": 14
    },
    {
      "t": "ਪਾਪੀ ਫੁਰੈ ਮੰਤ੍ਰ ਤਵ ਨਾਹੀ ॥",
      "v": [
        [
          0,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤੋ ਤੇ ਸੁਰ ਨ ਜਿਵਾਏ ਜਾਹੀ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਥਮ ਜਿਯਾਯੋ ਤਾਹਿ ਕਸਟ ਕਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਰਮ੍ਯੋ ਨ ਸੋ ਸ੍ਰਾਪ੍ਰਯੋ ਤਬ ਰਿਸਿ ਭਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਪਿਤਾ ਭਏ ਇਹ ਭਾਤਿ ਸੁਨਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਵਰਾਜ ਇਹ ਕਚਹਿ ਪਠਾਯੋ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਤਾਤ ਬਾਤ ਕਹੋ ਮੈ ਸੋ ਕਰੋ ॥",
      "v": [
        [
          0,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਮੰਤ੍ਰ ਸਜੀਵਨ ਇਹ ਨਨੁਸਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਇਹ ਸੀਖਿ ਮੰਤ੍ਰ ਕਹ ਜੈ ਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਵਰਾਜ ਫਿਰਿ ਹਾਥ ਨ ਐ ਹੈ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਮੰਤ੍ਰ ਨ ਫੁਰੈ ਸ੍ਰਾਪ ਇਹ ਦੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਮੇਰੋ ਬਚਨ ਮਾਨਿ ਪਿਤੁ ਲੀਜੈ ॥",
      "v": [
        [
          3,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਕਛੁ ਸੁਕ੍ਰ ਨ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੰਤ੍ਰ ਨਿਫਲ ਕੋ ਸ੍ਰਾਪੁ ਦਿਵਾਯੋ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਮਰੇ ਬਹੁ ਬਾਰ ਜਿਯਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਸ੍ਰਾਪ੍ਰਯੋ ਜਬ ਭੋਗ ਨ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯ ਚਰਿਤ੍ਰ ਗਤਿ ਕਿਨੂੰ ਨ ਪਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਨਿ ਬਿਧਨੈ ਇਹ ਨਾਰਿ ਬਨਾਈ ॥੧੬॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਇਕੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੨੧॥੬੦੫੯॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨੁ ਪ੍ਰਭੁ ਔਰ ਬਖਾਨੋ ਕਥਾ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਐਹੈ ਚਿਤ ਹਮਾਰੇ ਜਥਾ ॥",
      "s": 14
    },
    {
      "t": "ਛਜਕਰਨਨ ਕੋ ਦੇਸ ਬਸਤ ਜਹ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਛਬਿ ਕੇਤੁ ਇਕ ਹੁਤੋ ਨ੍ਰਿਪਤਿ ਤਹ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਅਚਰਜ ਦੇ ਤਾ ਕੇ ਇਕ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਕਨਕ ਅਵਟਿ ਸਾਚੇ ਜਨੁ ਢਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਮਕਰਾਛ ਮਤੀ ਦੁਹਿਤਾ ਤਿਹ ॥",
      "s": 14
    },
    {
      "t": "ਛੀਨਿ ਕਰੀ ਸਸਿ ਅੰਸ ਸਕਲ ਜਿਹ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਬਰ ਜੋਗ ਭਈ ਵਹੁ ਦਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਹੁ ਪੂਤ ਤਨ ਕਿਯਾ ਪ੍ਯਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਕੇਲ ਤਿਹ ਸਾਥ ਕਮਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਅਨਿਕ ਤਨ ਤਾਹਿ ਰਿਝਾਵੈ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਤਨ ਭੇਦ ਕਿਸੂ ਨਰ ਭਾਖਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤੇ ਤਾਹਿ ਧਾਮ ਅਸਿ ਰਾਖਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਹਾ ਨ ਪੰਛੀ ਕਰੈ ਪ੍ਰਵੇਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਇ ਨ ਜਹਾ ਪਵਨ ਕੋ ਵੇਸਾ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਕੁਅਰਿ ਮਿਤ੍ਰ ਬਿਨੁ ਬਹੁ ਦੁਖੁ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬੀਰ ਹਾਕਿ ਇਕ ਨਿਕਟ ਬੁਲਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਸੌ ਕਹਾ ਤਹਾ ਤੁਮ ਜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਲ੍ਯਾਹੁ ਸਜਨ ਕੀ ਖਾਟਿ ਉਚਾਈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਤ ਬਚਨ ਤਹ ਬੀਰ ਸਿਧਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਖਾਟ ਉਚਾਇ ਲ੍ਯਾਵਤ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਕਰਿ ਕੁਅਰਿ ਕੁਅਰ ਸੰਗ ॥",
      "s": 14
    }
  ]
}
