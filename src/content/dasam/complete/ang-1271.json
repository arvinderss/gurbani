{
  "page": 1271,
  "lines": [
    {
      "t": "ਪਹੁਚਾਯੋ ਗ੍ਰਿਹ ਤਾਹਿ ਤਿਸੀ ਢੰਗ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਦਿਵਸ ਤਾ ਕੌ ਪਿਤਾ ਗਯੋ ਸੁਤਾ ਕੇ ਗ੍ਰੇਹ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸੇਜ ਦੇਖਿ ਕਰਿ ਦਲਮਲੀ ਚਿਤ ਮਹਿ ਬਢਾ ਸੰਦੇਹ ॥੭॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਚਿੰਤਾਤੁਰ ਘਰ ਕੋ ਫਿਰਿ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਹਿਰ ਢੰਢੋਰਾ ਐਸ ਦਿਲਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜੇ ਕੋਈ ਪੁਹਪ ਖਰੀਦਨ ਆਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਮੁਹਿ ਨਿਰਖੇ ਬਿਨੁ ਲੇਨ ਨ ਪਾਵੈ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਪੁਹਪਨ ਸਮੈ ਬਿਕਨ ਜਬ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤਹ ਨ੍ਰਿਪਤਿ ਬਿਲੋਕਨ ਅਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜੋਗੀ ਏਕ ਤਹਾ ਤਬ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪੁਹਪ ਪਾਚ ਮਨ ਮੋਲ ਚੁਕਾਯੋ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਆਇ ਸੁ ਫੂਲ ਮੋਲ ਲੈ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪਾਛੋ ਗਹਤ ਨ੍ਰਿਪਤਿ ਤਿਹ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਤ ਜਾਤ ਦੋਊ ਗਏ ਗਹਿਰ ਬਨ ॥",
      "s": 14
    },
    {
      "t": "ਜਹ ਲਖਿ ਜਾਤ ਤੀਸਰੋ ਮਨੁਖ ਨ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਜੋਗੀ ਸਰ ਜਟਾ ਉਘਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਭੀਤਰ ਤੇ ਨਾਰਿ ਨਿਕਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਤਾ ਸੌ ਰਤਿ ਕਰਿ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੋਯੋ ਤਾਪ ਮਦਨ ਕੌ ਹਰਿ ਕੈ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਹੀ ਸੋਇ ਸੰਨ੍ਯਾਸੀ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜੂਤ ਜਟਨ ਤਿਹ ਨਾਰਿ ਛੁਰਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਤੇ ਪੁਰਖ ਏਕ ਤਿਹ ਕਾਢਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਤਾ ਸੌ ਕਰਿ ਗਾਢਾ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਠਾਢੋ ਤਿਹ ਚਰਿਤ ਨਿਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜੋਰਿ ਹਾਥ ਜੋਗਿਯਹਿ ਉਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਮੋ ਗ੍ਰਿਹ ਕਾਲ ਕ੍ਰਿਪਾ ਕਰਿ ਐਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਥਾ ਸਕਤਿ ਭੋਜਨ ਕਰਿ ਜੈਯੋ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਾਤ ਗਯੋ ਸੰਨ੍ਯਾਸੀ ਤਿਹ ਘਰ ॥",
      "s": 14
    },
    {
      "t": "ਭਗਵਾ ਭੇਸ ਸਕਲ ਤਨ ਮੈ ਧਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਪ੍ਰਭਾ ਬਨਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਧਰਮ ਸੋ ਜਨਿਯੋ ਜਾਈ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਸੰਨ੍ਯਾਸੀ ਕਹ ਨ੍ਰਿਪ ਆਗੇ ਧਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਹਿਤਾ ਕੇ ਰਾਜਾ ਆਯੋ ਘਰ ॥",
      "s": 14
    },
    {
      "t": "ਤੀਨ ਥਾਲ ਭੋਜਨ ਕੇ ਭਰਿ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਆਗੇ ਰਾਖੇ ਬਚਨ ਉਚਰਿ ਕੈ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਬਚਨ ਕਹੇ ਸੰਨ੍ਯਾਸੀ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਾ ਕਰਤ ਹੈ ਮੁਹਿ ਤਨ ਹਾਸੀ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਮਨੁਛ ਹੌ ਇਤਨੌ ਭੋਜਨ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਖਾਯੋ ਜਾਇ ਕਵਨ ਬਿਧਿ ਮੋ ਤਨ ॥੧੬॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਥਾਰ ਭੋਜਨ ਤੁਮ ਕਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਤਿਯ ਜਟਨ ਮੈ ਤਿਹ ਅਨਸਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਤਿਹ ਭਾਤਿ ਜਟਾ ਛੁਰਵਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਤੇ ਨਾਰਿ ਨਿਕਾਸੀ ਰਾਇ ॥੧੭॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਤਿਯ ਥਾਰ ਆਗੇ ਤਿਹ ਰਾਖਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਹਸਿ ਬਚਨ ਤਾ ਸੌ ਨ੍ਰਿਪ ਭਾਖਾ ॥",
      "s": 14
    },
    {
      "t": "ਕੇਸ ਫਾਸ ਤੇ ਪੁਰਖ ਨਿਕਾਰਹੁ ॥",
      "s": 14
    }
  ]
}
