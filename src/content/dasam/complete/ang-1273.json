{
  "page": 1273,
  "lines": [
    {
      "t": "ਕੁਅਰ ਬਿਲੋਕ ਥਕਿਤ ਹ੍ਵੈ ਰਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਹੌਸ ਮਿਲਨ ਕੀ ਹ੍ਰਿਦੈ ਬਢਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਸਹਚਰੀ ਤਹਾ ਪਠਾਈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਸਖੀ ਕੁਅਰ ਤਨ ਬ੍ਰਿਥਾ ਜਨਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਹ ਸੁਤਾ ਤਵ ਹੇਰਿ ਲੁਭਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਕਰਹੁ ਸਜਨ ਤਿਹ ਧਾਮ ਪਯਾਨਾ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਭੋਗ ਕਰੋ ਵਾ ਸੌ ਬਿਧਿ ਨਾਨਾ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਦ੍ਵੈ ਹੈਗੇ ਇਹ ਨਗਰ ਖੁਦਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਦੁਹੂੰਅਨ ਮੌ ਰਾਰਿ ਬਢਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜੌ ਤੂ ਦੁਹੂੰ ਜਿਯਨ ਤੈ ਮਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਹਮਾਰੋ ਸਾਥ ਬਿਹਾਰੈ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਿ ਬਚ ਭੇਸ ਤੁਰਕ ਤ੍ਰਿਯ ਧਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਨਾ ਵਹੈ ਆਪਨੋ ਕਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਗਹਿ ਕ੍ਰਿਪਾਨ ਤਿਹ ਕਿਯੋ ਪਯਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਹਾ ਨਿਮਾਜੀ ਪੜਤ ਦੁਗਾਨਾ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਹੀ ਪੜੀ ਨਿਮਾਜ ਤਿਨੋ ਸਬ ॥",
      "s": 14
    },
    {
      "t": "ਸਿਜਦਾ ਬਿਖੈ ਸੁ ਗਏ ਤੁਰਕ ਜਬ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਇਹ ਘਾਤ ਭਲੀ ਕਰਿ ਪਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਟਿ ਮੂੰਡ ਦੁਹੂੰਅਨ ਕੇ ਆਈ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਦੋਊ ਖੁਦਾਈ ਮਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਰਮੀ ਆਨਿ ਕਰਿ ਸਾਥ ਪ੍ਯਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਨ ਕਿਨੀ ਬਿਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਨਹੀ ਦੁਸਟ ਕਹਿਯੋ ਇਨ ਮਾਰਾ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਰਿ ਖੁਦਾਇਨ ਦੁਹੂੰ ਕਹ ਬਰਿਯੋ ਆਨਿ ਕਰ ਮਿਤ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਦੇਵ ਅਦੇਵ ਨ ਪਾਵਹੀ ਅਬਲਾਨ ਕੇ ਚਰਿਤ ॥੧੧॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਤੇਈਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੨੩॥੬੦੯੫॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਮੰਤ੍ਰੀ ਕਥਾ ਉਚਾਰਨ ਲਾਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੇ ਰਸ ਰਾਜਾ ਅਨੁਰਾਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੂਰਤਿ ਸੈਨ ਨ੍ਰਿਪਤਿ ਇਕ ਸੂਰਤਿ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨੁਕ ਦੁਤਿਯ ਮੈਨ ਕੀ ਮੂਰਤਿ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਅਛ੍ਰਾ ਦੇਇ ਸਦਨ ਤਿਹ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਕਨਕ ਅਵਟਿ ਸਾਚੈ ਜਨ ਢਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਅਪਸਰ ਮਤੀ ਸੁਤਾ ਤਿਹ ਸੋਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਰ ਨਰ ਨਾਗ ਅਸੁਰ ਮਨ ਮੋਹੈ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਸੁਰਿਦ ਸੈਨ ਇਕ ਸਾਹ ਪੁਤ੍ਰ ਤਹ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਸਮ ਦੂਸਰ ਭਯੋ ਨ ਮਹਿ ਮਹ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਸੁਤਾ ਤਿਹ ਊਪਰ ਅਟਕੀ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਸਰਿ ਗਈ ਸਭ ਹੀ ਸੁਧਿ ਘਟ ਕੀ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਚਤੁਰਿ ਸਹਚਰੀ ਤਹਾ ਪਠਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਰਿ ਭੇਸ ਕਰਿ ਤਿਹ ਲੈ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਵਹੁ ਤਰੁਨ ਤਰੁਨਿਯਹਿ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਭਜਿ ਗਰੇ ਲਗਾਯੋ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਕੇ ਆਸਨ ਲੈ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਚੁੰਬਨ ਕੈ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਤਿਹ ਬਿਧਿ ਤਾ ਕੋ ਬਿਰਮਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਗ੍ਰਿਹ ਜੈਬੋ ਤਿਨਹੂੰ ਸੁ ਭੁਲਾਯੋ ॥੫॥",
      "s": 14
    }
  ]
}
