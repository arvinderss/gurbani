{
  "page": 1274,
  "lines": [
    {
      "t": "ਸਖੀ ਭੇਸ ਕਹ ਧਾਰੇ ਰਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੋਈ ਕਰੈ ਜੁ ਅਬਲਾ ਕਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਰੋਜ ਭਜੈ ਆਸਨ ਤਿਹ ਲੈ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਤਾ ਕਹੁ ਸੁਖ ਦੈ ਕੈ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਪਿਤ ਤਿਹ ਨਿਰਖੈ ਭੇਦ ਨ ਜਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਹਿਤਾ ਕੀ ਤਿਹ ਸਖੀ ਪ੍ਰਮਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਜੜ ਕੋਇ ਨ ਲਹਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਵਾ ਕੀ ਤਾਹਿ ਖਵਾਸਿਨਿ ਕਰਹੀ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਦਿਨ ਦੁਹਿਤਾ ਪਿਤਾ ਨਿਹਾਰਤ ॥",
      "s": 14
    },
    {
      "t": "ਭਈ ਖੇਲ ਕੇ ਬੀਚ ਮਹਾ ਰਤ ॥",
      "s": 14
    },
    {
      "t": "ਤਵਨ ਪੁਰਖ ਕਹ ਪੁਰਖ ਉਚਰਿ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਭਰਤਾ ਕਰਾ ਸੁਯੰਬਰ ਕਰਿ ਕੈ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਬੈਠੀ ਬਹੁਰਿ ਸੋਕ ਮਨ ਧਰਿ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਤ ਮਾਤ ਪਿਤ ਬਚਨ ਉਚਰਿ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਹ ਇਹ ਕਰੀ ਲਖਹੁ ਹਮਰੀ ਗਤਿ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਮੁਹਿ ਇਨ ਦੀਨ ਸਹਚਰੀ ਕਰਿ ਪਤਿ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਮੁਹਿ ਭਈ ਇਹੈ ਸਹਚਰਿ ਪਤਿ ॥",
      "s": 14
    },
    {
      "t": "ਖੇਲਤ ਦਈ ਲਰਿਕਵਨ ਸੁਭ ਮਤਿ ॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਜੌ ਹੈ ਮੋਰੈ ਸਤ ਮਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਤੌ ਇਹ ਨਾਰਿ ਪੁਰਖ ਹ੍ਵੈ ਜਾਹੀ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯ ਤੇ ਇਹੈ ਪੁਰਖ ਹ੍ਵੈ ਜਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਜੌ ਕਛੁ ਸਤ ਮੇਰੇ ਮਹਿ ਆਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਯਹ ਅਬ ਜੂਨਿ ਪੁਰਖ ਕੀ ਪਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਮਦਨ ਭੋਗ ਮੁਰਿ ਸੰਗ ਕਮਾਵੈ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਚਕ੍ਰਿਤ ਭਯੋ ਰਾਜਾ ਇਨ ਬਚਨਨ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਸਹਿਤ ਬਿਚਾਰ ਕਿਯੋ ਮਨ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਹਿਤਾ ਕਹਾ ਕਹਤ ਬੈਨਨ ਕਹ ॥",
      "s": 14
    },
    {
      "t": "ਅਚਰਜ ਸੋ ਆਵਤ ਹੈ ਜਿਯ ਮਹ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਤਿਹ ਬਸਤ੍ਰ ਛੋਰਿ ਨ੍ਰਿਪ ਲਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਕਸ੍ਰਯੋ ਵਹੈ ਜੁ ਦੁਹਿਤਾ ਕਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਸਤੀ ਤਾ ਕਹਿ ਕਰਿ ਜਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਭਲਾ ਬੁਰਾ ਨਹਿ ਮੂੜ ਪਛਾਨਾ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਚੌਬੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੨੪॥੬੧੦੮॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਸੁਲਤਾਨ ਸੈਨ ਇਕ ਰਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਸਮ ਦੁਤਿਯ ਨ ਬਿਧਨਾ ਸਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਸੁਲਤਾਨ ਦੇਇ ਤਿਹ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਰੂਪਵਾਨ ਗੁਨਵਾਨ ਉਜਿਯਾਰੀ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੇ ਭਵਨ ਭਈ ਇਕ ਬਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨੁਕ ਸਿਥਰ ਅਗਨਿ ਕੀ ਜ੍ਵਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਸੁਲਤਾਨ ਕੁਅਰਿ ਉਜਿਯਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਕਨਕ ਅਵਟਿ ਸਾਚੇ ਜਨ ਢਾਰੀ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਜੋਬਨੰਗ ਤਾ ਕੇ ਜਬ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਲਾਪਨ ਤਬ ਹੀ ਸਭ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅੰਗ ਅੰਗ ਦਯੋ ਅਨੰਗ ਦਮਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਹਿਰ ਭਈ ਜਗਤ ਮਹਿ ਬਾਮਾ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਿ ਸੁਨਿ ਪ੍ਰਭਾ ਕੁਅਰ ਤਹ ਆਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਦ੍ਵਾਰੈ ਭੀਰ ਬਾਰ ਨਹਿ ਪਾਵੈ ॥",
      "s": 14
    }
  ]
}
