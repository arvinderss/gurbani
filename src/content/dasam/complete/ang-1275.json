{
  "page": 1275,
  "lines": [
    {
      "t": "ਏਕ ਤਰੁਨ ਤਰੁਨੀ ਕੌ ਭਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨੁਕ ਮਦਨ ਰੂਪ ਧਰਿ ਆਯੋ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਸੋਇ ਕੁਅਰ ਤਰੁਨੀ ਕੌ ਭਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪਠੈ ਸਹਚਰੀ ਬੋਲਿ ਪਠਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕ੍ਰੀੜਾ ਕਰੀ ਬਹੁਤ ਬਿਧਿ ਵਾ ਸੋ ॥",
      "s": 14
    },
    {
      "t": "ਕੀਨੋ ਪ੍ਰਾਤ ਸੁਯੰਬਰ ਤਾ ਸੋ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਹੀ ਬ੍ਯਾਹ ਤਵਨ ਸੌ ਕੀਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਤਿਕ ਬਰਿਸ ਨ ਜਾਨੇ ਦੀਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕ੍ਰੀੜਾ ਕਰੈ ਭਾਤਿ ਭਾਤਿਨ ਤਨ ॥",
      "s": 14
    },
    {
      "t": "ਹਰਖ ਬਢਾਇ ਬਢਾਇ ਅਧਿਕ ਮਨ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਭੋਗ ਬਹੁਤ ਦਿਨ ਤਾ ਸੰਗ ਕਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੋ ਬਲ ਸਭ ਹੀ ਹਰਿ ਲਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਬੈ ਨ੍ਰਿਧਾਤ ਕੁਅਰ ਵਹ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਹੀ ਡਾਰਿ ਹ੍ਰਿਦੈ ਤੇ ਦਯੋ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਔਰਨ ਸਾਥ ਕਰੈ ਤਬ ਪ੍ਰੀਤਾ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਸੁ ਦਿਨ ਕਰੈ ਕਾਮ ਕੀ ਰੀਤਾ ॥",
      "s": 14
    },
    {
      "t": "ਪਤਿਹਿ ਤੋਰਿ ਖੋਜਾ ਕਰਿ ਡਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਆਪੁ ਅਵਰ ਸੋ ਕੇਲ ਮਚਾਰਾ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਬਿਰਹ ਰਾਇ ਤਾ ਕੋ ਥੋ ਯਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਸੋ ਬਧਿਯੋ ਕੁਅਰਿ ਕੇ ਪ੍ਯਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਪਰ ਰਹੀ ਹੋਇ ਸੋ ਲਟਕਨ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਹਿਤ ਮਰਤ ਪ੍ਯਾਸ ਅਰੁ ਭੂਖਨ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਦਿਨ ਭਾਗ ਮਿਤ੍ਰ ਤਿਹ ਲਈ ॥",
      "s": 14
    },
    {
      "t": "ਪੋਸਤ ਸਹਿਤ ਅਫੀਮ ਚੜਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁ ਰਤਿ ਕਰੀ ਨ ਬੀਰਜ ਗਿਰਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਆਠ ਪਹਿਰ ਲਗਿ ਕੁਅਰਿ ਬਜਾਈ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਨਿਸਿ ਨਾਰਿ ਭੋਗ ਜਬ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁ ਆਸਨ ਕਰਿ ਹਰਖ ਬਢਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਪਰ ਤਰੁਨਿ ਚਿਤ ਤੇ ਅਟਕੀ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਲਿ ਗਈ ਸਭ ਹੀ ਸੁਧਿ ਘਟ ਕੀ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਦ੍ਵੈ ਘਟਿਕਾ ਜੋ ਭੋਗ ਕਰਤ ਨਰ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਪਰ ਰੀਝਤ ਨਾਰਿ ਬਹੁਤ ਕਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਚਾਰਿ ਪਹਰ ਜੋ ਕੇਲ ਕਮਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਕ੍ਯੋਨ ਨ ਤ੍ਰਿਯ ਕੌ ਚਿਤ ਚੁਰਾਵੈ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਰੈਨਿ ਸਕਲ ਤਿਨ ਤਰੁਨਿ ਬਜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਕੇ ਸਾਥ ਹੰਢਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਆਸਨ ਕਰੇ ਤਰੁਨਿ ਬਹੁ ਬਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਚੁੰਬਨਾਦਿ ਨਖ ਘਾਤ ਅਪਾਰਾ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਕੇ ਚਤੁਰਾਸਨ ਕਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਭਜ੍ਯੋ ਤਾਹਿ ਤਰ ਦਾਬਿ ਭੁਜਨ ਭਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਚੁੰਬਨ ਆਸਨ ਕਰਤ ਬਿਚਛਨ ॥",
      "s": 14
    },
    {
      "t": "ਕੋਕ ਕਲਾ ਕੋਬਿਦ ਸਭ ਲਛਨ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਪੋਸਤ ਸ੍ਰਾਬ ਅਫੀਮ ਬਹੁ ਘੋਟਿ ਚੜਾਵਤ ਭੰਗ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚਾਰਿ ਪਹਰ ਭਾਮਹਿ ਭਜਾ ਤਊ ਨ ਮੁਚਾ ਅਨੰਗ ॥੧੫॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਭੋਗ ਕਰਤ ਸਭ ਰੈਨਿ ਬਿਤਾਵਤ ॥",
      "s": 14
    },
    {
      "t": "ਦਲਿਮਲਿ ਸੇਜ ਮਿਲਿਨ ਹ੍ਵੈ ਜਾਵਤ ॥",
      "s": 14
    },
    {
      "t": "ਹੋਤ ਦਿਵਾਕਰ ਕੀ ਅਨੁਰਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਛੈਲ ਸੇਜ ਮਿਲਿ ਬਹੁਰਿ ਬਿਛਾਈ ॥੧੬॥",
      "s": 14
    },
    {
      "t": "ਪੌਢਿ ਪ੍ਰਜੰਕ ਅੰਕ ਭਰਿ ਸੋਊ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਗ ਅਫੀਮ ਪਿਯਤ ਮਿਲਿ ਦੋਊ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਕਾਮ ਕੀ ਕੇਲ ਮਚਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਕੋਕ ਸਾਰ ਮਤ ਪ੍ਰਗਟ ਦਿਖਾਵੈ ॥੧੭॥",
      "s": 14
    },
    {
      "t": "ਕੈਫਨ ਸਾਥ ਰਸ ਮਸੇ ਹ੍ਵੈ ਕਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰੋਢਿ ਪ੍ਰਜੰਕ ਰਹਤ ਦੋਊ ਸ੍ਵੈ ਕਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਜਗੈ ਰਸ ਰੀਤਿ ਮਚਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਵਿਤ ਉਚਾਰਹਿ ਧੁਰਪਦ ਗਾਵੈ ॥੧੮॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਲਗਿ ਬਿਰਹ ਨਟਾ ਤਾ ਕੋ ਪਤਿ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਕਸਿਯੋ ਆਇ ਤਹਾ ਮੂਰਖ ਮਤਿ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤ੍ਰਿਯ ਚਤੁਰ ਚਰਿਤ੍ਰ ਬਿਚਰਿ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਹਨ੍ਯੋ ਤਾਹਿ ਫਾਸੀ ਗਰ ਡਰਿ ਕੈ ॥੧੯॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਕੋਠਰੀ ਮਿਤ੍ਰ ਛਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪਤਿਹਿ ਮਾਰਿ ਸੁਰ ਊਚ ਉਘਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜਾ ਪ੍ਰਜਾ ਸਬਦ ਸੁਨਿ ਧਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਹਿਤਾ ਕੇ ਮੰਦਰਿ ਚਲਿ ਆਏ ॥੨੦॥",
      "s": 14
    },
    {
      "t": "ਮ੍ਰਿਤਕ ਪਰਿਯੋ ਤਾ ਕੌ ਭਰਤਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਵ ਰੰਕ ਸਭਹੂੰਨ ਨਿਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਪੂਛਤ ਭਯੋ ਤਿਸੀ ਕਹ ਰਾਜਨ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਾ ਭਈ ਯਾ ਕੀ ਗਤਿ ਕਾਮਨਿ ॥੨੧॥",
