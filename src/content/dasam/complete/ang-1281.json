  "lines": [
    {
      "t": "ਭਛ ਭੋਜ ਪਕਵਾਨ ਪਕਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮਦਰਾ ਅਧਿਕ ਤਹਾ ਲੈ ਧਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਤ ਬਾਰ ਜੁ ਚੁਆਇਨਿ ਕਰਾ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਭਲੀ ਭਾਤਿ ਸਭ ਅੰਨ ਬਨਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਬਿਖੁ ਸਾਥ ਮਿਲਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਗਰਧਭਾਨ ਬਹੁ ਦਈ ਅਫੀਮੈ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਧੇ ਆਨਿ ਅਸੁਰ ਕੀ ਸੀਮੈ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਆਧੀ ਰਾਤਿ ਦੈਤ ਤਹ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਗਰਧਭਾਨ ਮਹਿਖਾਨ ਚਬਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭਛ ਭੋਜ ਬਹੁਤੇ ਤਬ ਖਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਭਰਿ ਭਰਿ ਪ੍ਯਾਲੇ ਮਦਹਿ ਚੜਾਏ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਮਦ ਕੀ ਪੀਏ ਬਿਸੁਧ ਹ੍ਵੈ ਰਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਆਨਿ ਅਫੀਮ ਗਰੌ ਤਿਹ ਗਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੋਇ ਰਹਾ ਸੁਧਿ ਕਛੂ ਨ ਪਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਰਿ ਪਛਾਨ ਘਾਤ ਕਹ ਧਾਈ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਅਠ ਹਜ਼ਾਰ ਮਨ ਸਿਕਾ ਲਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਪਰ ਅਵਟਿ ਢਾਰਿ ਕਰਿ ਦਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭਸਮੀ ਭੂਤ ਦੈਤ ਵਹੁ ਕਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਰਹਵਤੀ ਪੁਰ ਕੌ ਸੁਖ ਦਿਯੋ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਅਬਲਾ ਅਸੁਰ ਹਨਿ ਨ੍ਰਿਪਹਿ ਬਰਿਯੋ ਸੁਖ ਪਾਇ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸਕਲ ਪ੍ਰਜਾ ਸੁਖ ਸੌ ਬਸੀ ਹ੍ਰਿਦੈ ਹਰਖ ਉਪਜਾਇ ॥੧੫॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਤੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੩੦॥੬੧੯੩॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਵਲੰਦੇਜ ਕੋ ਏਕ ਨ੍ਰਿਪਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਵਲੰਦੇਜ ਦੇਈ ਘਰ ਬਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਪੁਰ ਕੁਪ੍ਰਯੋ ਫਿਰੰਗ ਰਾਇ ਮਨ ॥",
      "s": 14
    },
    {
      "t": "ਸੈਨ ਚੜਾ ਲੈ ਕਰਿ ਸੰਗ ਅਨਗਨ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਨਾਮੁ ਫਿਰੰਗੀ ਰਾਇ ਨ੍ਰਿਪਤਿ ਤਿਹ ॥",
      "s": 14
    },
    {
      "t": "ਅੰਗਰੇਜਨ ਪਰ ਚੜਤ ਕਰੀ ਜਿਹ ॥",
      "s": 14
    },
    {
      "t": "ਅਨਗਨ ਲਏ ਚਮੂੰ ਚਤੁਰੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁ ਕਰਿ ਉਮਡਿ ਚਲਿਯੋ ਜਲ ਗੰਗਾ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਵਲੰਦੇਜ ਦੇਈ ਕੇ ਨਾਥਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਾਨ ਤਜੇ ਡਰ ਹੀ ਕੇ ਸਾਥਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਭੇਦ ਨ ਕਾਹੂ ਦਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਾਸ ਤ੍ਰਸਤ ਰਾਜਾ ਮਰਿ ਗਯੋ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਮ੍ਰਿਤਕ ਨਾਥ ਤਿਹ ਸਮੈ ਨਿਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਔਰ ਸੰਗ ਬਹੁ ਸੈਨ ਬਿਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹੈ ਘਾਤ ਜਿਯ ਮਾਹਿ ਬਿਚਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਸਟ ਪੁਤ੍ਰਿਕਾ ਲਛ ਸਵਾਰੀ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਲਛ ਹੀ ਹਾਥ ਬੰਦੂਕ ਸਵਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਦਾਰੂ ਗੋਲਿਨ ਭਰੀ ਸੁਧਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਡਿਵਢਾ ਚੁਨਤ ਭਈ ਤੁਪਖਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਤੀਰ ਬੰਦੂਕ ਕਮਾਨ ਅਰੁ ਬਾਨਾ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਅਰਿ ਸੈਨ ਨਿਕਟ ਤਿਹ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਭਹਿਨ ਗਈ ਪਲੀਤਾ ਲਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਬੀਸ ਹਜਾਰ ਤੁਪਕ ਇਕ ਬਾਰ ॥",
      "s": 14
    },
    {
      "t": "ਛੁਟਗੀ ਕਛੁ ਨ ਰਹੀ ਸੰਭਾਰਾ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਜਿਮਿ ਮਖੀਰ ਕੀ ਉਡਤ ਸੁ ਮਾਖੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਮਿ ਹੀ ਚਲੀ ਬੰਦੂਕੈ ਬਾਖੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੇ ਲਗੇ ਅੰਗ ਮੌ ਬਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਤਛਿਨ ਤਿਨ ਭਟ ਤਜੇ ਪਰਾਨਾ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਤਰਫਰਾਹਿ ਗੌਰਿਨ ਕੇ ਮਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਪਛੁ ਸੁਤ ਓਰਨ ਜਨੁਕ ਬਿਦਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਰਥੀ ਸੁ ਨਾਗਪਤੀ ਅਰੁ ਬਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਮ ਪੁਰ ਗਏ ਸਹਿਤ ਨਿਜੁ ਰਾਜਾ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਚਰਿਤ੍ਰ ਤਨ ਚੰਚਲਾ ਕੂਟੋ ਕਟਕ ਹਜਾਰ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਅਰਿ ਮਾਰੇ ਰਾਜਾ ਸਹਿਤ ਗਏ ਗ੍ਰਿਹਨ ਕੌ ਹਾਰਿ ॥੯॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਇਕਤੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੩੧॥੬੨੦੨॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਹਿਰ ਭੇਹਰੇ ਏਕ ਨ੍ਰਿਪਤਿ ਬਰ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਸੈਨ ਤਿਹ ਨਾਮ ਕਹਤ ਨਰ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮਾਵਤੀ ਤਵਨ ਕੀ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਰੂਪਵਾਨ ਦੁਤਿਵਾਨ ਉਜਿਯਾਰੀ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੇ ਬਹੁਤ ਰਹੈ ਗ੍ਰਿਹ ਬਾਜਿਨ ॥",
      "s": 14
    },
    {
      "t": "ਜਯੋ ਕਰਤ ਤਾਜੀ ਅਰੁ ਤਾਜਿਨ ॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਭਵ ਏਕ ਬਛੇਰਾ ਲਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਤ ਭਵਿਖ੍ਯ ਨ ਵੈਸੇ ਭਯੋ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਇਕ ਹੋਤ ਸਾਹ ਬਡਭਾਗੀ ॥",
      "s": 14
    },
    {
      "t": "ਰੂਪ ਕੁਅਰ ਨਾਮਾ ਅਨੁਰਾਗੀ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰੀਤਿ ਕਲਾ ਤਿਹ ਸੁਤਾ ਭਨਿਜੈ ॥",
      "s": 14
    }
  ]
