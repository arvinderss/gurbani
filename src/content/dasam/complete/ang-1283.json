{
  "page": 1283,
  "lines": [
    {
      "t": "ਇਕ ਇਕ ਤੇ ਕਰਿ ਦ੍ਵੈ ਦ੍ਵੈ ਡਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਘੋਰਾ ਸਹਿਤ ਘਾਇ ਜੋ ਘਏ ॥",
      "s": 14
    },
    {
      "t": "ਦ੍ਵੈ ਤੇ ਚਾਰਿ ਟੂਕ ਤੇ ਭਏ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਬੀਰ ਬਿਦਾਰ ਬਹੁ ਨਦੀ ਤੁਰੰਗ ਤਰਾਇ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਜਹਾ ਮਿਤ੍ਰ ਕੋ ਗ੍ਰਿਹ ਹੁਤੋ ਤਹੀ ਨਿਕਾਸ੍ਰਯੋ ਆਇ ॥੧੬॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਤਿਹ ਆਨਿ ਤੁਰੰਗਮ ਦੀਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਤਾ ਸੈ ਦ੍ਰਿੜ ਕੀਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜੌ ਪਾਛੇ ਤਿਨ ਫੌਜ ਨਿਹਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਸੌ ਤਿਹ ਤ੍ਰਿਯਹਿ ਉਚਾਰੀ ॥੧੭॥",
      "s": 14
    },
    {
      "t": "ਅੜਿਲ ॥",
      "s": 14
    },
    {
      "t": "ਬੁਰੋ ਕਰਮ ਹਮ ਕਰਿਯੋ ਤੁਰੰਗ ਨ੍ਰਿਪ ਕੋ ਹਰਿਯੋ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਆਪੁ ਆਪੁਨੇ ਪਗਨ ਕੁਹਾਰਾ ਕੌ ਮਰਿਯੋ ॥",
      "v": [
        [
          2,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਅਬ ਏ ਤੁਰੰਗ ਸਮੇਤ ਪਕਰਿ ਲੈ ਜਾਇ ਹੈ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਹੋ ਫਾਸੀ ਦੈਹੈ ਦੁਹੂੰ ਕਿ ਸੂਰੀ ਦ੍ਰਯਾਇ ਹੈ ॥੧੮॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯ ਭਾਖ੍ਯੋ ਪਿਯ ਸੋਕ ਨ ਕਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਜ ਸਹਿਤ ਦੋਊ ਬਚੇ ਬਿਚਰੋ ॥",
      "v": [
        [
          3,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਐਸੋ ਚਰਿਤ ਅਬੈ ਮੈ ਕਰਿ ਹੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਸਟਨ ਡਾਰਿ ਸਿਰ ਛਾਰਿ ਉਬਰਿ ਹੋ ॥੧੯॥",
      "s": 14
    },
    {
      "t": "ਤਹਾ ਪੁਰਖ ਕੋ ਭੇਸ ਬਨਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਦਲ ਕਹ ਮਿਲੀ ਅਗਮਨੇ ਜਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੀ ਹਮਾਰੋ ਸਤਰ ਉਬਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਔਰ ਗਾਵ ਤੇ ਸਕਲ ਨਿਹਾਰੋ ॥੨੦॥",
      "s": 14
    },
    {
      "t": "ਮਿਲਿ ਦਲ ਧਾਮ ਅਗਮਨੇ ਜਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਜ ਪਾਇ ਝਾਝਰ ਪਹਿਰਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਸਕਲ ਗਾਵ ਤਿਨ ਕਹ ਦਿਖਰਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਫਿਰਿ ਤਿਹ ਠੌਰਿ ਤਿਨੈ ਲੈ ਆਈ ॥੨੧॥",
      "s": 14
    },
    {
      "t": "ਪਰਦਾ ਲੇਤ ਤਾਨਿ ਆਗੇ ਤਿਨ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਖਹੁ ਜਾਇ ਜਨਾਨਾ ਕਹਿ ਜਿਨ ॥",
      "s": 14
    },
    {
      "t": "ਆਗੇ ਕਰਿ ਸਭਹਿਨ ਕੇ ਬਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਬਾਮ ਨਿਕਾਰਿਯੋ ਰਾਜਾ ॥੨੨॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਆਂਗਨ ਲੈ ਤਿਨੈ ਦਿਖਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਆਗੇ ਬਹੁਰਿ ਕਨਾਤ ਤਨਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਆਗੇ ਕਰਿ ਕਰਿ ਬਾਜ ਨਿਕਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਨੇਵਰ ਕੇ ਬਾਜਤ ਝਨਕਾਰੈ ॥੨੩॥",
      "s": 14
    },
    {
      "t": "ਬਹੂ ਬਧੂ ਤਿਨ ਕੀ ਵਹੁ ਜਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਜੀ ਕਹ ਮੂਰਖ ਨ ਪਛਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਨੇਵਰ ਕੈ ਬਾਜਤ ਝਨਕਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਨ ਜਾਤ ਬਿਚਾਰਾ ॥੨੪॥",
      "s": 14
    },
    {
      "t": "ਦੁਹਿਤਾ ਬਹੂ ਤਿਨੈ ਕਰਿ ਜਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਿ ਸੁਨਿ ਧੁਨਿ ਨੇਵਰ ਕੀ ਕਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਕਛੂ ਨ ਬਿਚਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਛਲੈ ਪੁਰਖ ਸਭ ਨਾਰੀ ॥੨੫॥",
      "s": 14
    },
    {
      "t": "ਜਵਨ ਰੁਚਾ ਜ੍ਯੋਂ ਤ੍ਯੋਂ ਤਿਹ ਭਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਯ ਜੁ ਨ ਭਾਯੋ ਤਿਹ ਕੌ ਤਜਾ ॥",
      "v": [
        [
          3,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਨ ਇਸਤ੍ਰੀਨ ਕੇ ਚਰਿਤ ਅਪਾਰਾ ॥",
      "s": 14
    }
  ]
}
