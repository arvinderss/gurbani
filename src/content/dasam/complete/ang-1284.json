{
  "page": 1284,
  "lines": [
    {
      "t": "ਜਿਨੈ ਨ ਬਿਧਨਾ ਸਕਤ ਬਿਚਾਰਾ ॥੨੬॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਬਤੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੩੨॥੬੨੨੮॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਹੋ ਰਾਜ ਕੁਅਰਿ ਇਕ ਬਾਤਾ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯ ਚਰਿਤ੍ਰ ਜੋ ਕਿਯ ਬਿਖ੍ਯਾਤਾ ॥",
      "s": 14
    },
    {
      "t": "ਪਸਚਿਮ ਦਿਸਾ ਹੁਤੀ ਇਕ ਨਗਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਹੰਸ ਮਾਲਨੀ ਨਾਮ ਉਜਗਰੀ ॥੧॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਹੰਸ ਸੈਨ ਜਿਹ ਰਾਜ ਬਿਰਾਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਹੰਸ ਪ੍ਰਭਾ ਜਾ ਕੀ ਤ੍ਰਿਯ ਰਾਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਰੂਪਵਾਨ ਗੁਨਵਾਨੁਜਿਯਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਹਿਰ ਲੋਕ ਚੌਦਹੂੰ ਪ੍ਯਾਰੀ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਇਕ ਸਾਹੁ ਸੁਤਾ ਦੁਤਿਮਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਜਿਯਤ ਜਿਹ ਨਿਰਖਿ ਸਸਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਜੋਬਨ ਭਯੋ ਅਧਿਕ ਤਿਹ ਜਬ ਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਤਨ ਸਾਥ ਬਿਹਾਰਤ ਤਬ ਹੀ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਦਿਨ ਭੇਸ ਪੁਰਖ ਕੋ ਧਾਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਜੁ ਪਤਿ ਸਾਥ ਕਰੀ ਬਹੁ ਰਾਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਲਾਤ ਮੁਸਟ ਕੇ ਕਰਤ ਪ੍ਰਹਾਰ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਤਿਹ ਨਾਰਿ ਨ ਸਕੈ ਬਿਚਾਰਿ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਸੌ ਲਰਿ ਕਾਜੀ ਪਹਿ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਲੈ ਇਲਾਮ ਪ੍ਰਯਾਦਨ ਸੰਗ ਅਈ ॥",
      "s": 14
    },
    {
      "t": "ਐਚ ਪਤਿਹਿ ਲੈ ਤਹਾ ਸਿਧਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਕੋਤਵਾਰ ਕਾਜੀ ਜਿਹ ਠਾਈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਯਾਦਨ ਸਾਥ ਦ੍ਵਾਰ ਪਤਿ ਥਿਰ ਕਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਦਿਨ ਕਹ ਗਈ ਮਿਤ੍ਰ ਅਪਨੇ ਘਰ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਸੰਗ ਕਰਿ ਕ੍ਰੀੜਾ ਕੀ ਗਾਥਾ ॥",
      "s": 14
    },
    {
      "t": "ਲੈ ਆਈ ਸਾਹਿਦ ਕਹਿ ਸਾਥਾ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਅੜਿਲ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਰ ਪ੍ਰਯਾਦਨ ਪਤਿ ਜੁਤਿ ਦ੍ਵਾਰੇ ਠਾਢਿ ਕਰ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਦੁਤਿਯ ਮਿਤ੍ਰ ਕੇ ਗਈ ਦਿਵਸ ਕਹ ਨਾਰਿ ਘਰ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਤਿਹ ਸਾਥਿ ਕੀਯਾ ਰੁਚਿ ਮਾਨਿ ਕਰਿ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਹੋ ਸਾਹਿਦ ਕੈ ਲ੍ਯਾਈ ਅਪਨੇ ਤਿਹ ਸਾਥ ਧਰਿ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਾ ਲਗੇ ਮੈ ਕਹੋ ਉਚਰਿ ਕਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਗਈ ਬਹੁਤਨ ਕੇ ਘਰ ॥",
      "s": 14
    },
    {
      "t": "ਸੰਗ ਸਾਹਿਦ ਸਭ ਹੀ ਕਰਿ ਲੀਨੇ ॥",
      "s": 14
    },
    {
      "t": "ਸਕਲ ਰੁਜੂ ਕਾਜੀ ਕੇ ਕੀਨੇ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਅਪਨੀ ਅਪਨੀ ਤੇ ਮਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਏਕ ਕੋ ਭੇਦ ਨ ਜਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਜੁ ਤ੍ਰਿਯ ਕਹਤ ਸੋ ਪੁਰਖ ਬਖਾਨਤ ॥",
      "s": 14
    },
    {
      "t": "ਆਪੁ ਆਪੁ ਕੀ ਬਾਤ ਨ ਜਾਨਤ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਸਾਹਿਦ ਜਬ ਨਜਰਿ ਗੁਜਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਬਚਨ ਵਹ ਤ੍ਰਿਯਾ ਉਚਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਕਾਜੀ ਸਾਚੀ ਇਹ ਕੀਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਦਰਬ ਬਟਾਇ ਅਰਧ ਤਿਹ ਦੀਨੋ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਕਿਨੂੰ ਨ ਤਾ ਕੋ ਭੇਦ ਬਿਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਸ ਚਰਿਤ੍ਰ ਇਹ ਨਾਰਿ ਦਿਖਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਔਰਨ ਕੀ ਕੋਊ ਕਹਾ ਬਖਾਨੈ ॥",
      "s": 14
    }
  ]
}
