  "lines": [
    {
      "t": "ਲਰਿਯੋ ਆਨਿ ਜੋ ਪੈ ਗਯੋ ਜੂਝਿ ਤੌਨੈ ॥",
      "v": [
        [
          3,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤਹਾ ਜੋਜਨੰ ਪਾਚ ਭਯੋ ਬੀਰ ਖੇਤੰ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਬਿਦਾਰੇ ਪਰੇ ਬੀਰ ਬ੍ਰਿੰਦੇ ਬਿਚੇਤੰ ॥੩੨॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਬੀਰ ਬੈਤਾਲ ਬੀਨਾ ਬਜਾਵੈ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਜੋਗਨੀਯੈਂ ਖਰੀ ਗੀਤ ਗਾਵੈ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਲੈ ਬਰੰਗਨਿ ਬਰੈਂ ਵੈ ਤਿਸੀ ਕੋ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਲਹੈ ਸਾਮੁਹੇ ਜੁਧ ਜੁਝੋ ਜਿਸੀ ਕੋ ॥੩੩॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਹੀ ਸੈਨ ਜੂਝਿ ਸਭ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤ੍ਰਿਯ ਸੁਤਹਿ ਪਠਾਵਤ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੋਊ ਜੂਝਿ ਜਬ ਸ੍ਵਰਗ ਸਿਧਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਤਿਯ ਪੁਤ੍ਰ ਤਹ ਔਰ ਪਠਾਯੋ ॥੩੪॥",
      "s": 14
    },
    {
      "t": "ਸੋਊ ਗਿਰਿਯੋ ਜੂਝਿ ਰਨ ਜਬ ਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਤੀਜੇ ਸੁਤਹਿ ਪਠਾਯੋ ਤਬ ਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੋਊ ਜੂਝਿ ਜਬ ਗਯੋ ਦਿਵਾਲੈ ॥",
      "s": 14
    },
    {
      "t": "ਚੌਥੇ ਪੂਤ ਪਠਾਯੋ ਬਾਲੈ ॥੩੫॥",
      "s": 14
    },
    {
      "t": "ਚਾਰੌ ਗਿਰੇ ਜੂਝਿ ਸੁਤ ਜਬ ਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਅਬਲਾ ਚਲੀ ਜੁਧ ਕੌ ਤਬ ਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੂਰ ਬਚੇ ਤੇ ਸਕਲ ਬੁਲਾਇਸਿ ॥",
      "s": 14
    },
    {
      "t": "ਲਰਨ ਚਲੀ ਦੁੰਦਭੀ ਬਜਾਇਸਿ ॥੩੬॥",
      "s": 14
    },
    {
      "t": "ਐਸਾ ਕਰਾ ਬਾਲ ਤਹ ਜੁਧਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਹੀ ਨ ਭਟ ਕਾਹੂ ਮਹਿ ਸੁਧਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਰੇ ਪਰੇ ਬੀਰ ਬਿਕਰਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਗੋਮੁਖ ਝਾਝਰ ਬਸਤ ਨਗਾਰਾ ॥੩੭॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਪਰ ਸਿਮਟਿ ਸਰੋਹੀ ਮਾਰਤਿ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੋ ਕਾਟਿ ਭੂਮ ਸਿਰ ਡਾਰਤਿ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੇ ਹਨੈ ਤਰੁਨਿ ਤਨ ਬਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਰੈ ਸੁਭਟ ਮ੍ਰਿਤ ਲੋਕ ਪਯਾਨਾ ॥੩੮॥",
      "s": 14
    },
    {
      "t": "ਚੁਨਿ ਚੁਨਿ ਜ੍ਵਾਨ ਪਖਰਿਯਾ ਮਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਇਕ ਤੇ ਦ੍ਵੈ ਦ੍ਵੈ ਕਰਿ ਡਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਉਠੀ ਧੂਰਿ ਲਾਗੀ ਅਸਮਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਸਿ ਚਮਕੈ ਬਿਜੁਰੀ ਪਰਮਾਨਾ ॥੩੯॥",
      "s": 14
    },
    {
      "t": "ਕਾਟੇ ਸੁਭਟ ਸਰੋਹਿਨ ਪਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁ ਮਾਰੁਤ ਬਰ ਬਿਰਛ ਉਪਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਗਜ ਜੂਝੇ ਮਾਰੇ ਬਾਜੀ ਰਨ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁ ਕ੍ਰੀੜਾ ਸਿਵ ਕੋ ਯਹ ਹੈ ਬਨ ॥੪੦॥",
      "s": 14
    },
    {
      "t": "ਰਨ ਐਸੋ ਅਬਲਾ ਤਿਨ ਕੀਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਪਾਛੇ ਭਯੋ ਨ ਆਗੇ ਹੂਆ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਖੰਡ ਖੰਡ ਹ੍ਵੈ ਗਿਰੀ ਧਰਨਿ ਪਰ ॥",
      "s": 14
    },
    {
      "t": "ਰਨ ਜੂਝੀ ਭਵਸਿੰਧੁ ਗਈ ਤਰਿ ॥੪੧॥",
      "s": 14
    },
    {
      "t": "ਖੰਡ ਖੰਡ ਬਾਜੀ ਪਰ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਊ ਨ ਛੋਰਿ ਅਯੋਧਨ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਤ ਪਿਸਾਚ ਗਏ ਭਖਿ ਤਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਗਿ ਮੋਰਿ ਤਊ ਭਜੀ ਨ ਬਾਮਾ ॥੪੨॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਥਮ ਚਾਰਊ ਪੁਤ੍ਰ ਜੁਝਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਆਪੁ ਬੈਰੀ ਬਹੁ ਘਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਥਮ ਬਾਲ ਕੌ ਜਬੈ ਸੰਘਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਪਾਛੇ ਬੀਰਮ ਦੇ ਮਾਰਿਯੋ ॥੪੩॥",
      "s": 14
    }
  ]
