{
  "page": 1289,
  "lines": [
    {
      "t": "ਤਾ ਕੋ ਮਾਰਿ ਕਾਟਿ ਸਿਰ ਲਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਲੈ ਹਾਜਿਰ ਹਜਰਤਿ ਕੇ ਕਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਪਿਤ ਪਠੈ ਸੁਤਾ ਪਹਿ ਦੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਦੁਖਿਤ ਹ੍ਵੈ ਦਹੁਤਾ ਚੀਨਾ ॥੪੪॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਬੇਗਮ ਤਿਹ ਸ੍ਵਾਰ ਕੌ ਦੇਖਾ ਸੀਸ ਉਘਾਰਿ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਪਲਟਿ ਪਰਾ ਤਬ ਮੂੰਡ ਨ੍ਰਿਪ ਤਉ ਨ ਕਬੂਲੀ ਨਾਰਿ ॥੪੫॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਬੇਗਮ ਸੋਕਮਾਨ ਤਬ ਹ੍ਵੈ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਜਮਧਰ ਹਨਾ ਉਦਰ ਕਰ ਲੈ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਾਨ ਮਿਤ੍ਰ ਕੇ ਲੀਨੇ ਦੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਧ੍ਰਿਗ ਮੋ ਕੌ ਜਿਨ ਅਸ ਕ੍ਰਮ ਕੀਨਾ ॥੪੬॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਬੀਰਮ ਦੇ ਰਾਜਾ ਨਿਮਿਤ ਬੇਗਮ ਤਜੇ ਪਰਾਨ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸੁ ਕਬਿ ਸ੍ਯਾਮ ਯਾ ਕਥਾ ਕੋ ਤਬ ਹੀ ਭਯੋ ਨਿਦਾਨ ॥੪੭॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਪੈਤੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੩੫॥੬੨੯੫॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਸੈਨ ਇਕ ਸੁਨਾ ਨ੍ਰਿਪਤਿ ਬਰ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਦੇਇ ਰਾਨੀ ਤਾ ਕੇ ਘਰ ॥",
      "s": 14
    },
    {
      "t": "ਰੰਗਝੜ ਦੇ ਦੁਹਿਤਾ ਤਹ ਸੋਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਰ ਨਰ ਨਾਗ ਅਸੁਰ ਮਨ ਮੋਹੈ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਬਢਤ ਬਢਤ ਅਬਲਾ ਜਬ ਬਢੀ ॥",
      "s": 14
    },
    {
      "t": "ਮਦਨ ਸੁ ਨਾਰ ਆਪੁ ਜਨੁ ਗਢੀ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਤ ਪਿਤਾ ਚਰਚਾ ਭਈ ਜੋਈ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਚੁਰ ਭਈ ਜਗ ਭੀਤਰਿ ਸੋਈ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਮਾਤੈ ਕਹੀ ਸੁਤਾ ਕੇ ਸੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਚੰਚਲਤਾ ਜਿਨ ਕਰੁ ਸੁੰਦ੍ਰੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਾ ਬਿਸੇਸ ਧੁਜਹਿ ਤੂ ਬਰਿ ਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੋ ਜੀਤਿ ਦਾਸ ਲੈ ਕਰਿ ਹੈ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਤ ਬਾਤ ਤਾ ਕਹ ਲਗਿ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਖੀ ਗੂੜ ਨ ਭਾਖਤ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਅਬਲਾ ਨਿਸਿ ਕੌ ਘਰ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਚਲੀ ਤਹਾ ਨਰ ਭੇਸ ਬਨਾਈ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਚਲਤ ਚਲਤ ਬਹੁ ਚਿਰ ਤਹ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਹਾ ਬਿਲਾਸਵਤੀ ਨਗਰਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਵਨ ਨਗਰ ਚਲਿ ਜੂਪ ਮਚਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਊਚ ਨੀਚ ਸਭ ਹੀ ਨਹਰਾਯੋ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਬਡੇ ਬਡੇ ਜੂਪੀ ਜਬ ਹਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਮਿਲਿ ਰਾਜਾ ਕੇ ਤੀਰ ਪੁਕਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਹ੍ਯਾਂ ਐਸ ਜੁਆਰੀ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਸੂ ਪਾਸ ਨਹਿ ਜਾਤ ਹਰਾਯੋ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਸੁਨੇ ਬਚਨ ਜਬ ਰਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਆਪਨ ਸਜਿਯੋ ਜੂਪ ਕੋ ਸਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਿਯੋ ਤਾਹਿ ਹ੍ਯਾਂ ਲੇਹੁ ਬੁਲਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਨ ਜੂਪੀ ਸਭ ਲਏ ਹਰਾਇ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਭ੍ਰਿਤ ਸੁਨਿ ਬਚਨ ਪਹੂੰਚੇ ਤਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਜੂਪਿਨ ਕੁਅਰਿ ਹਰਾਵਤ ਜਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਿਯੋ ਤਾਹਿ ਤੁਹਿ ਰਾਇ ਬੁਲਾਯੋ ॥",
      "s": 14
    }
  ]
}
