{
  "page": 1291,
  "lines": [
    {
      "t": "ਸੋ ਤਰੁਨੀ ਤਿਹ ਰਸ ਰਸਿ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਢਿ ਸਮਿਗ੍ਰੀ ਸਿਗਰੀ ਦਈ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਸਾਥ ਲਹਾ ਮਨ ਭਾਵਨ ॥",
      "s": 14
    },
    {
      "t": "ਸਕਾ ਚੀਨ ਕੋਊ ਪੁਰਖ ਉਪਾਵਨ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਕਾਢਿ ਦਏ ਸਭ ਹੀ ਰਖਵਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਲੋਹ ਕਰਾ ਜਿਨ ਤੇ ਹਨਿ ਡਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਜਮਲੇਸ੍ਵਰ ਨ੍ਰਿਪ ਸੌ ਯੌ ਭਾਖੀ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਮਰੀ ਛੀਨਿ ਸੁਤਾ ਨ੍ਰਿਪ ਰਾਖੀ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਬੇਸਹਰਾ ਪਰ ਕਛੁ ਨ ਬਸਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਤ ਬਾਤ ਨ੍ਰਿਪ ਮੂੰਡ ਢੁਰਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਬਰਾ ਕੁਅਰਿ ਵਹੁ ਰਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਇ ਰਹਾ ਮੁਖ ਸਕਲ ਸਮਾਜਾ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਸੈਤੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੩੭॥੬੩੧੮॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਨਗਰ ਬਿਭਾਸਾਵਤੀ ਮੈ ਕਰਨ ਬਿਭਾਸ ਨਰੇਸ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੇ ਤੇਜ ਰੁ ਤ੍ਰਾਸ ਕੌ ਜਾਨਤ ਸਗਰੋ ਦੇਸ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਮਤੀ ਬਿਵਾਸ ਤਵਨ ਕੀ ਰਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੁੰਦਰਿ ਭਵਨ ਚਤ੍ਰਦਸ ਜਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਤ ਸਵਤਿ ਤਾ ਕੀ ਛਬਿਮਾਨ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨੁਕ ਸਾਤ ਰੂਪ ਕੀ ਖਾਨ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਆਯੋ ਤਹਾ ਏਕ ਬੈਰਾਗੀ ॥",
      "s": 14
    },
    {
      "t": "ਰੂਪਵਾਨ ਗੁਨਵਾਨ ਤਿਆਗੀ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਯਾਮ ਦਾਸ ਤਾ ਕੋ ਭਨਿ ਨਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਸ ਦਿਨ ਨਿਰਖਿ ਰਹਤ ਤਿਹ ਬਾਮਾ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਮਤੀ ਬਿਭਾਸ ਤਵਨ ਰਸ ਰਾਚੀ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਮਿਤਵਾ ਕੇ ਮਾਚੀ ॥",
      "s": 14
    },
    {
      "t": "ਗਵਨ ਕਰੌ ਤਾ ਸੌ ਮਨ ਭਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਸਵਤਿਨ ਸੋਕ ਹ੍ਰਿਦੈ ਮਹਿ ਆਵੈ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਅਹਿਧੁਜ ਦੇ ਝਖਕੇਤੁ ਮਤੀ ਭਨਿ ॥",
      "s": 14
    },
    {
      "t": "ਪੁਹਪ ਮੰਜਰੀ ਫੂਲ ਮਤੀ ਗਨਿ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਗਰਿ ਦੇ ਨਾਗਨਿ ਦੇ ਰਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਤ ਮਤੀ ਸਭ ਹੀ ਜਗ ਜਾਨੀ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਦਿਨ ਏਕ ਕਰੀ ਮਿਜਮਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਵਤਿ ਪਠੀ ਸਭ ਹੀ ਘਰ ਰਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਖੁ ਕੌ ਭੋਜਨ ਸਭਨ ਖਵਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਸਕਲ ਦਈ ਮ੍ਰਿਤ ਲੋਕ ਪਠਾਇ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਬਿਖੁ ਕਹ ਖਾਇ ਮਰੀ ਸਵਤੈ ਸਬ ॥",
      "s": 14
    },
    {
      "t": "ਰੋਵਤ ਭਈ ਬਿਭਾਸ ਮਤੀ ਤਬ ॥",
      "s": 14
    },
    {
      "t": "ਪਾਪ ਕਰਮ ਕੀਨਾ ਮੈ ਭਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਧੋਖੇ ਲਵਨ ਇਨੈ ਬਿਖੁ ਖ੍ਵਾਰੋ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਮੈ ਗਰੌ ਹਿਮਾਚਲ ਜਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਕੈ ਪਾਵਕ ਮਹਿ ਬਰੌ ਬਨਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਸਹਚਰਿ ਸਹਸ ਹਟਕਿ ਤਿਹ ਰਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਨਤ ਭਈ ਨ ਤਿਨ ਕੀ ਕਹੀ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਵਹੈ ਸੰਗ ਬੈਰਾਗੀ ਲੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਸੌ ਕਾਮ ਭੋਗ ਕਹ ਕੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਲੋਗ ਲਖੈ ਤ੍ਰਿਯ ਗਰਬੇ ਗਈ ॥",
      "s": 14
    }
  ]
}
