{
  "page": 1293,
  "lines": [
    {
      "t": "ਸੁਨਹੁ ਬਾਤ ਤੁਮ ਰਾਜ ਕੁਮਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਤਨ ਮਤੀ ਤੁਮਰੀ ਜੋ ਰਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਯਹ ਮੁਰਿ ਅਤਿ ਸੇਵਕੀ ਪ੍ਰਮਾਨੀ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਜੌ ਯਾ ਸੌ ਤੁਮ ਕਰਹੁ ਪ੍ਯਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਹ੍ਵੈ ਹੈ ਤੁਮਰੋ ਤਬੈ ਉਧਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਤ੍ਰ ਹੋਇਗੋ ਨਾਸ ਤਿਹਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਜਾਨੌ ਤੂ ਭਗਤ ਹਮਾਰੋ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਯੌ ਕਹਿ ਲੋਕੰਜਨ ਦ੍ਰਿਗ ਡਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਭਈ ਲੋਪ ਨਹਿ ਜਾਇ ਨਿਹਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਮੂੜ ਰਾਵ ਤਿਹ ਰੁਦ੍ਰ ਪ੍ਰਮਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਕਛੁ ਪਸੂ ਨ ਜਾਨਾ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤੇ ਤਾ ਸੌ ਕੀਆ ਪ੍ਯਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਜਿ ਕਰਿ ਸਕਲ ਸੁੰਦਰੀ ਨਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਛਲਾ ਚੰਚਲਾ ਰਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਆਲੂਰੇ ਗੜ ਕੋ ਸਿਰਤਾਜਾ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਉਨਤਾਲੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੩੯॥੬੩੪੨॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਮਥੁਰਾ ਨਾਮ ਹਮਾਰੇ ਰਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਜਗ ਤਿਹ ਤ੍ਰਿਯਹਿ ਗੁਲਾਬੇ ਕਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਮ ਦਾਸ ਨਾਮਾ ਤਹ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਿ ਨਾਰਿ ਤਿਹ ਮਦਨ ਸਤਾਯੋ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਤ ਬਰਿਸ ਤਾ ਸੌ ਵਹੁ ਰਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਪੁਨਿ ਐਸੇ ਤਿਹ ਤ੍ਰਿਯ ਸੌ ਕਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਆਉ ਹੋਹਿ ਹਮਰੀ ਤੈ ਨਾਰੀ ॥",
      "v": [
        [
          0,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਕਸਿ ਦੈ ਹੈ ਤੁਹਿ ਯਹ ਮੁਰਦਾਰੀ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਭਲੀ ਭਲੀ ਅਬਲਾ ਤਿਨ ਭਾਖੀ ॥",
      "s": 14
    },
    {
      "t": "ਚਿਤ ਮਹਿ ਰਾਖਿ ਨ ਕਾਹੂ ਆਖੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਮਥੁਰਾ ਆਯੋ ਤਿਹ ਧਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਅਸਿ ਬਚਨ ਬਖਾਨ੍ਯੋ ਬਾਮਾ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਹਰੀ ਚੰਦ ਰਾਜਾ ਜਗ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅੰਤ ਕਾਲ ਸੋ ਭੀ ਮਰਿ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਨਧਾਤ ਪ੍ਰਭ ਭੂਪ ਬਢਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅੰਤ ਕਾਲ ਸੋਊ ਕਾਲ ਖਪਾਯੋ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਨਰ ਨਾਰਿ ਭਯੋ ਸੋ ਮਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਜਗ ਮਹਿ ਕੋਊ ਨ ਉਬਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਜਗ ਥਿਰ ਏਕੈ ਕਰਤਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਔਰ ਮ੍ਰਿਤਕ ਇਹ ਸਗਲ ਸੰਸਾਰਾ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਜਗ ਮਹਿ ਸੋਈ ਜਿਯਤ ਪੁੰਨ੍ਯ ਦਾਨ ਜਿਨ ਕੀਨ ॥",
      "s": 14
    },
    {
      "t": "ਸਿਖਿਯਨ ਕੀ ਸੇਵਾ ਕਰੀ ਜੋ ਮਾਗੈ ਸੋ ਦੀਨ ॥੬॥",
      "v": [
        [
