        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਯਹ ਉਪਦੇਸ ਸੁਨਤ ਜੜ ਢਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਨਾਰਿ ਸੌ ਬਚਨ ਉਚਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਉਪਜੈ ਜਿਯ ਭਲੀ ਤਿਹਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਵਹੈ ਕਾਮ ਮੈ ਕਰੌ ਸਵਾਰੈ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯ ਬਾਚ ॥",
      "s": 14
    },
    {
      "t": "ਫਟਾ ਬਸਤ੍ਰ ਜਾ ਕਾ ਲਖਿ ਲੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਬਸਤ੍ਰ ਨਵੀਨ ਤੁਰਤ ਤਿਹ ਦੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੈ ਘਰਿ ਮਹਿ ਹੋਇ ਨ ਦਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕਹ ਦੀਜੈ ਅਪਨੀ ਨਾਰਾ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਰਾਮ ਦਾਸ ਤਬ ਤਾਹਿ ਨਿਹਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਧਨ ਬਿਹੀਨ ਬਿਨੁ ਨਾਰਿ ਬਿਚਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਧਨ ਹੂੰ ਦੀਯਾ ਨਾਰਿ ਹੂੰ ਦੀਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਭਲੀ ਬੁਰੀ ਜੜ ਕਛੂ ਨ ਚੀਨੀ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਗਈ ਜਾਰ ਕੇ ਨਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਸਤ੍ਰ ਦਰਬ ਲੈ ਸਾਥ ਅਪਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਆਪਨ ਅਤਿ ਸਾਧ ਪਛਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਭਲੀ ਬੁਰੀ ਕਾ ਭੇਵ ਨ ਜਾਨਾ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਚਾਲੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੪੦॥੬੩੫੨॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਕ੍ਰਿਤਾਵਤੀ ਨਗਰ ਇਕ ਸੁਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਕ੍ਰਿਤ ਸੈਨ ਰਾਜਾ ਬਹੁ ਗੁਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਭ ਲਛਨਿ ਦੇ ਨਾਰਿ ਬਿਰਾਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਚੰਦ੍ਰ ਸੂਰ ਕੀ ਲਖਿ ਦੁਤਿ ਲਾਜੈ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਅਪਛਰਾ ਦੇਇ ਸੁ ਬਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਨਹੁ ਸਕਲ ਰਾਗ ਕੀ ਮਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੀ ਨ ਜਾਤ ਤਵਨ ਕੀ ਸੋਭਾ ॥",
      "s": 14
    },
    {
      "t": "ਇੰਦ੍ਰ ਚੰਦ੍ਰ ਜਸ ਰਵਿ ਲਖਿ ਲੋਭਾ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਇਕ ਆਇ ਗਯੋ ਸੌਦਾਗਰ ॥",
      "s": 14
    },
    {
      "t": "ਪੂਤ ਸਾਥ ਤਿਹ ਜਾਨੁ ਪ੍ਰਭਾਕਰ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਸੁਤਾ ਤਿਹ ਊਪਰ ਅਟਕੀ ॥",
      "s": 14
    },
    {
      "t": "ਚਟਪਟ ਲਾਜ ਲੋਕ ਕੀ ਸਟਕੀ ॥੩॥",
      "s": 14
