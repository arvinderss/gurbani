{
  "page": 1297,
  "lines": [
    {
      "t": "ਰਤਿ ਅਤਿ ਨਿਤਪ੍ਰਤਿ ਕਰਤ ਬਨਾਈ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਰਸਤ ਰਸਤ ਐਸੀ ਰਸਿ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁ ਕਰ ਨਾਰਿ ਤਵਨ ਕੀ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਬ੍ਰਿਤਾਤ ਕਹਿ ਤਾਹਿ ਸਿਖਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੋਵਤਿ ਸਮੈ ਭੂਪ ਕਹ ਘਾਯੋ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਾਤ ਜਰਨ ਕੇ ਕਾਜ ਸਿਧਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਆਗੇ ਰਾਖਿ ਲਏ ਨਿਜੁ ਰਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਬੈ ਚਿਤਾ ਪਰ ਬੈਠੀ ਜਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਚਹੂੰ ਓਰ ਦਿਯ ਆਗਿ ਲਗਾਇ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਚਾਰੋ ਦਿਸਾ ਅਗਨਿ ਜਬ ਲਾਗੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਹੀ ਉਤਰਿ ਚਿਤਾ ਤੈ ਭਾਗੀ ॥",
      "s": 14
    },
    {
      "t": "ਲੋਗਨ ਚਰਿਤ ਕ੍ਰਿਯਾ ਨਹਿ ਜਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਦੀਨੀ ਤਿਸੀ ਚੰਡਾਰਹਿ ਰਾਨੀ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਯੌ ਛਲਿ ਛੈਲ ਚਿਕਨਿਸਨ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਨੂੰ ਨ ਬਾਤ ਤਾਹਿ ਲਖਿ ਲਈ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਰਿ ਅਧਿਕ ਮਨ ਹਰਖ ਬਢਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਚਾਹਤ ਹੁਤੀ ਸੋਇ ਪਤਿ ਪਾਯੋ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤੇ ਆਜੁ ਲਗੇ ਉਹ ਦੇਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਰਤ ਤ੍ਰਿਯ ਕੌ ਪ੍ਰਥਮ ਨਰੇਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਠ ਤਰੇ ਕਰਿ ਜਾਹਿ ਜਰਾਵਤ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਖਿ ਸਕਤਿ ਨਹਿ ਬਾਤ ਲਜਾਵਤ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਰਾਨੀ ਕੇ ਪੁਤ੍ਰ ਤਬ ਰਾਜ ਕਰਾ ਤਿਹ ਠਾਵ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਆਜੁ ਲਗੇ ਚੰਡਾਲਿਯੈ ਭਾਖਤ ਤਿਨ ਕੋ ਨਾਵ ॥੯॥",
      "v": [
        [
          2,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਚੌਤਾਲੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੪੪॥੬੩੯੬॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਦੌਲਾ ਕੀ ਗੁਜਰਾਤਿ ਬਸਤ ਜਹ ॥",
      "s": 14
    },
    {
      "t": "ਅਮਰ ਸਿੰਘ ਇਕ ਹੁਤਾ ਨ੍ਰਿਪਤਿ ਤਹ ॥",
      "s": 14
    },
    {
      "t": "ਅੰਗਨਾ ਦੇ ਰਾਨੀ ਤਿਹ ਰਾਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਿ ਦਿਵੰਗਨਨ ਕੋ ਮਨ ਲਾਜੈ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਰਾਜਾ ਅਧਿਕ ਪੀਰ ਕਹ ਮਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਭਲੀ ਬੁਰੀ ਜੜ ਬਾਤ ਨ ਜਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਹਾ ਸੁਬਰਨ ਸਿੰਘ ਇਕ ਛਤ੍ਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਰੂਪਵਾਨ ਧਨਵਾਨ ਧਰਤ੍ਰੀ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਸੁੰਦਰ ਅਧਿਕ ਹੁਤੋ ਖਤਿਰੇਟਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁਕ ਰੂਪ ਸੌ ਸਕਲ ਲਪੇਟਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਤੇ ਨਿਰਖਿ ਨਾਰਿ ਤਿਹ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਧਿ ਬੁਧਿ ਛਾਡਿ ਦਿਵਾਨੀ ਭਈ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਸੰਗ ਨੇਹ ਸਜਾ ਰੁਚਿ ਮਾਨ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨਿ ਬੂਝਿ ਹ੍ਵੈ ਗਈ ਅਜਾਨ ॥",
      "s": 14
    },
    {
      "t": "ਦਈ ਸਹਚਰੀ ਤਹਿਕ ਪਠਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਜ੍ਯੋਂ ਤ੍ਯੋਂ ਤਿਹ ਗ੍ਰਿਹ ਲਿਯਾ ਮੰਗਾਇ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਪੋਸਤ ਭਾਗ ਅਫੀਮ ਮੰਗਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਪਾਨਿ ਡਾਰਿ ਕਰਿ ਭਾਗ ਘੁਟਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਪਾਨ ਕਿਯਾ ਦੁਹੂੰ ਬੈਠਿ ਪ੍ਰਜੰਕਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਰਤਿ ਮਾਨੀ ਭਰਿ ਭਰਿ ਦ੍ਰਿੜ ਅੰਕਹਿ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਬੈ ਟਨਾਨੇ ਕੈਫ ਕੇ ਆਏ ਅਖਿਯਨ ਮਾਹਿ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    }
  ]
}
