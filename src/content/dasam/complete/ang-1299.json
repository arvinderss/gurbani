{
  "page": 1299,
  "lines": [
    {
      "t": "ਮਾਰਤ ਰੀਝ ਰੋਝ ਝੰਖਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਸਕਾਵਤੀ ਨਗਰ ਤਰ ਨਿਕਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਭਾ ਬਿਲੋਕਿ ਨਗਰ ਕੀ ਬਿਗਸਾ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਅਸ ਸੁੰਦਰਿ ਜਿਹ ਨ੍ਰਿਪ ਕੀ ਨਗਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਕਸ ਹ੍ਵੈ ਹੈ ਤਿਹ ਨਾਰਿ ਉਜਗਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਕਿਹ ਬਿਧਿ ਤਿਹ ਰੂਪ ਨਿਹਰਿਯੈ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਤਰ ਅਤਿਥ ਇਹੀ ਹ੍ਵੈ ਮਰਿਯੈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਬਸਤ੍ਰ ਉਤਾਰਿ ਮੇਖਲਾ ਡਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਖਨ ਛੋਰਿ ਭਿਭੂਤਿ ਸਵਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਤਨ ਭੇਖ ਅਤਿਥ ਕਾ ਧਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਆਸਨ ਆਨ ਦ੍ਵਾਰ ਤਿਹ ਮਾਰਾ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਕੇਤਕ ਬਰਸ ਤਹਾ ਬਿਤਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਤਰੁਨਿ ਕੇ ਦਰਸ ਨ ਪਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਤਕ ਦਿਨਨ ਪ੍ਰਤਿਬਿੰਬੁ ਨਿਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਚਤੁਰ ਭੇਦ ਸਭ ਗਯੋ ਬਿਚਾਰਾ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਤਰੁਨੀ ਖਰੀ ਸਦਨ ਆਨੰਦ ਭਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਜਲ ਪ੍ਰਤਿਬਿੰਬ ਪਰਾ ਤਿਹ ਸੁੰਦਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਤਹੀ ਸੁਘਰ ਤਿਹ ਠਾਢ ਨਿਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨਿ ਗਯੋ ਸਭ ਭੇਦ ਸੁਧਾਰਾ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯਹੁ ਤਾਹਿ ਪ੍ਰਤਿਬਿੰਬੁ ਲਖਾ ਜਬ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਕਹਾ ਚਿਤ ਭੀਤਰ ਤਬ ॥",
      "s": 14
    },
    {
      "t": "ਇਹੁ ਜਨਿਯਤ ਕੋਈ ਰਾਜ ਕੁਮਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਪਾਰਬਤੀਸ ਅਰਿ ਕੋ ਅਵਤਾਰਾ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਬੋਲਿ ਸੁਰੰਗਿਯਾ ਲੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਤਿ ਹੀ ਦਰਬ ਗੁਪਤ ਤਿਹ ਦੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਜੁ ਗ੍ਰਿਹ ਭੀਤਰਿ ਸੁਰੰਗਿ ਦਿਵਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਢੀ ਤਹੀ ਨ ਕਿਨਹੂੰ ਪਾਈ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਖੀ ਤਿਸੀ ਮਾਰਗ ਪਠੀ ਤਹੀ ਪਹੂੰਚੀ ਜਾਇ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਗਹਿ ਜਾਘਨ ਤੇ ਲੈ ਗਈ ਚਲਾ ਨ ਭੂਪ ਉਪਾਇ ॥੧੧॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਗਹਿ ਨ੍ਰਿਪ ਕੋ ਲੈ ਗਈ ਸਖੀ ਤਹ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਹੁਤੀ ਬਿਲੋਕਤਿ ਮਗ ਜਹ ॥",
      "s": 14
    },
    {
      "t": "ਦਿਯਾ ਮਿਲਾਇ ਮਿਤ੍ਰ ਤਾ ਕੋ ਇਨ ॥",
      "s": 14
    },
    {
      "t": "ਮਨ ਮਾਨਤ ਰਤਿ ਕਰੀ ਦੁਹੂ ਤਿਨ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਚੁੰਬਨ ਦੁਹੂੰ ਲੀਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਨਿਕ ਅਨਿਕ ਆਸਨ ਤ੍ਰਿਯ ਦੀਨੇ ॥",
      "s": 14
    },
    {
      "t": "ਅਸ ਲੁਭਧਾ ਰਾਜਾ ਕੋ ਚਿਤਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਸ ਗੁਨਿ ਜਨ ਸੁਨਿ ਸ੍ਰਵਨ ਕਬਿਤਾ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਕਹਤ ਬਚਨ ਸੁਨੁ ਮੀਤਾ ॥",
      "s": 14
    },
    {
      "t": "ਤੌ ਸੌ ਬਧਾ ਹਮਾਰਾ ਚੀਤਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਤੇ ਤਵ ਪ੍ਰਤਿਬਿੰਬੁ ਨਿਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤੇ ਮਨ ਹਠ ਪਰਿਯੋ ਹਮਾਰਾ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਨਿਤਿਪ੍ਰਤਿ ਚਹੈ ਤੁਮੀ ਸੰਗ ਜਾਊ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਤ ਪਿਤਾ ਕੀ ਕਾਨਿ ਨ ਲ੍ਯਾਊ ॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਕਿਛੁ ਅਸ ਪਿਯ ਚਰਿਤ ਬਨੈਯੈ ॥",
      "v": [
        [
          3,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਲਾਜ ਰਹੈ ਤੋਹਿ ਪਤਿ ਪੈਯੈ ॥੧੫॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਛੋਰਿ ਕਥਾ ਤਿਹ ਭੂਪ ਸੁਨਾਈ ॥",
      "s": 14
    }
  ]
}
