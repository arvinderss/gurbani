{
  "page": 1302,
  "lines": [
    {
      "t": "ਦੇ ਦੋਊ ਬਿਖਿ ਸ੍ਵਰਗ ਪਠਾਏ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਆਪੁ ਸਭਨ ਪ੍ਰਤਿ ਐਸ ਉਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਰ ਦੀਨਾ ਮੁਹਿ ਕਹ ਤ੍ਰਿਪੁਰਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਸਹਿਤ ਨਰਾਧਿਪ ਘਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਮੁਰ ਨਰ ਕੇ ਸਭ ਅੰਗ ਬਨਾਏ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਮਯਾ ਮੋ ਪਰ ਸਿਵ ਕੀਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਸਮਗ੍ਰੀ ਸਭ ਮੁਹਿ ਦੀਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਨ ਕਾਹੂ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੀਸ ਸੁਤਾ ਕੇ ਛਤ੍ਰ ਫਿਰਾਯੋ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਕਿਤਕ ਦਿਵਸ ਇਹ ਭਾਤਿ ਬਿਤਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਰੋਮ ਮਿਤ੍ਰ ਕੇ ਦੂਰ ਕਰਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯ ਕੇ ਬਸਤ੍ਰ ਸਗਲ ਦੈ ਵਾ ਕੌ ॥",
      "s": 14
    },
    {
      "t": "ਬਰ ਆਨ੍ਰਯੋ ਇਸਤ੍ਰੀ ਕਰਿ ਤਾ ਕੌ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਤ ਪਿਤਾ ਹਨਿ ਪੁਰਖ ਬਨ ਬਰਿਯੋ ਮਿਤ੍ਰ ਤ੍ਰਿਯ ਸੋਇ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਰਾਜ ਕਰਾ ਇਹ ਛਲ ਭਏ ਭੇਦ ਨ ਪਾਵਤ ਕੋਇ ॥੯॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਉਨਚਾਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੪੯॥੬੪੫੮॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਜਨਾਵਤੀ ਨਗਰ ਇਕ ਪੂਰਬ ॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਸਹਿਰਨ ਤੇ ਹੁਤੋ ਅਪੂਰਬ ॥",
      "s": 14
    },
    {
      "t": "ਸਿੰਘ ਸੁਜਾਨ ਤਹਾ ਕੋ ਰਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਸਮ ਬਿਧ ਨੈ ਔਰ ਨ ਸਾਜਾ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਨਵਜੋਬਨ ਦੇ ਤਿਹ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਘੜੀ ਨ ਜਿਹ ਸੀ ਬ੍ਰਹਮ ਕੁਮਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਅਬਲਾ ਤਿਹ ਰੂਪ ਨਿਹਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਮਨ ਕ੍ਰਮ ਬਚ ਇਹ ਭਾਤਿ ਉਚਾਰੈ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਇੰਦ੍ਰ ਧਾਮ ਹੈ ਐਸ ਨ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜੈਸੀ ਨ੍ਰਿਪ ਕੀ ਨਾਰਿ ਨਿਹਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਅਸ ਸੁੰਦਰ ਇਕ ਸਾਹ ਸਪੂਤਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਲਖਿ ਪ੍ਰਭਾ ਲਜਤ ਪੁਰਹੂਤਾ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਯਹ ਧੁਨਿ ਪਰੀ ਤਰੁਨਿ ਕੇ ਕਾਨਨ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤੇ ਲਗੀ ਚਟਪਟੀ ਭਾਮਨਿ ॥",
      "s": 14
    },
    {
      "t": "ਜਤਨ ਕਵਨ ਮੈ ਆਜੁ ਸੁ ਧਾਰੂੰ ॥",
      "s": 14
    },
    {
      "t": "ਉਹਿ ਸੁੰਦਰ ਕਹ ਨੈਨ ਨਿਹਾਰੂੰ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਨਗਰ ਢੰਢੋਰਾ ਨਾਰਿ ਫਿਰਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਭਹਿਨ ਕਹ ਇਹ ਭਾਤਿ ਸੁਨਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਊਚ ਨੀਚ ਕੋਈ ਰਹੈ ਨ ਪਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਾਤਕਾਲ ਭੋਜਨ ਸਭ ਖਾਵੈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਰਾਜਹਿ ਬਾਤ ਕਛੂ ਨਹਿ ਜਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਵਤਾ ਦਿਯੋ ਲਖਿਯੋ ਤ੍ਰਿਯ ਮਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਪਕਵਾਨ ਪਕਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਊਚ ਨੀਚ ਸਭ ਨਿਵਤਿ ਬੁਲਾਏ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਭੋਜਨ ਖਾਨ ਜਨਾਵਹਿ ਬਿਗਸਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯ ਕੀ ਦ੍ਰਿਸਟਿ ਤਰੇ ਹ੍ਵੈ ਨਿਕਸਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਐਂਠੀ ਰਾਇ ਜਬਾਯੋ ਤਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਬੈਠਿ ਝਰੋਖੇ ਰਾਨੀ ਜਹਾ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਨਿਰਖਿ ਚੀਨ ਤਿਹ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁ ਬਿਧਿ ਤਾਹਿ ਸਰਾਹਤ ਭਈ ॥",
      "s": 14
    }
  ]
}
