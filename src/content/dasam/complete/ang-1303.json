{
  "page": 1303,
  "lines": [
    {
      "t": "ਧੰਨਿ ਧੰਨਿ ਮੁਖ ਤੇ ਬਹੁਰਿ ਉਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਨ ਕਰਤੈ ਇਹ ਕੁਅਰ ਸਵਾਰਾ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਲੀਨਾ ਸਖੀ ਪਠਾਇ ਤਿਸੈ ਘਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਕਿਯ ਲਪਟਿ ਲਪਟਿ ਕਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਤਰੁਨ ਅਰੁ ਭਾਗ ਚੜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਚਾਰ ਪਹਰਿ ਨਿਸਿ ਨਾਰਿ ਬਜਾਈ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਐਂਠੀ ਸੌ ਬਧਿ ਗਯੋ ਸਨੇਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਮੁਹਿ ਕਹੇ ਨ ਆਵਤ ਨੇਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਸਿਖੈ ਤਿਹ ਧਾਮ ਪਠਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਆਧੀ ਰੈਨਿ ਨਰੇਸਹਿ ਘਾਯੋ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਾਤਿ ਚਲੀ ਜਰਬੇ ਕੇ ਕਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਦਰਬੁ ਲੁਟਾਵਤ ਨਾਰਿ ਨ੍ਰਿਲਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਦ੍ਰਿਸਟ ਬੰਧੁ ਸਭ ਕੀ ਅਸਿ ਕਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਸਭਹੂੰ ਲਖਾ ਅਬਲਾ ਜਰਿ ਮਰੀ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਨਿਕਸਿ ਜਾਰਿ ਸੰਗ ਆਪੁ ਸਿਧਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਨ ਲਖੈ ਪੁਰਖ ਅਰੁ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਦ੍ਰਿਸਟਿ ਬੰਦ ਕਰਤ ਅਸ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਮੂੰਡਿ ਮੂੰਡਿ ਸਭਹਿਨ ਕੋ ਗਈ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਪਚਾਸਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੫੦॥੬੪੭੦॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨੋ ਭੂਪ ਇਕ ਕਹੌ ਕਹਾਨੀ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਕਿਨਹੂੰ ਸੁਨੀ ਨ ਆਗੇ ਜਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਪ ਸੁ ਬਸਤ੍ਰ ਸੈਨ ਇਕ ਸੋਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੇ ਸਮ ਨ ਨਰਾਧਿਪ ਕੋ ਹੈ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਧਾਮ ਸੁ ਬਸਤ੍ਰ ਮਤੀ ਤਿਹ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਬਸਤ੍ਰਾਵਤੀ ਨਗਰ ਉਜਿਯਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਅਵਲ ਚੰਦ ਤਿਹ ਠਾ ਇਕ ਰਾਵਤ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਸੁਨਾ ਏਕ ਦਿਨ ਗਾਵਤ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਬਧਿ ਗਯੋ ਤਾ ਸੌ ਐਸ ਸਨੇਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਸ ਸਾਵਨ ਕੋ ਬਰਸਤ ਮੇਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਜਤਨ ਤਿਨ ਨਾਰਿ ਬਨਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪਠੈ ਸਖੀ ਤਿਹ ਬੋਲਿ ਪਠਾਯੋ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਤਾ ਸੌ ਦ੍ਰਿੜ ਕੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਪਿਯ ਕੋ ਰਸ ਲੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਪਾਟ ਸਭ ਹੀ ਸੁ ਬਿਸਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੇ ਹਾਥ ਬੇਚਿ ਜੀਯ ਡਾਰਿਯੋ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਅਤੀਤ ਗ੍ਰਿਹਿ ਨਿਵਤਿ ਪਠਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਬਸਤ੍ਰ ਭਗੌਹੈ ਤਿਸ ਪਹਿਰਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਆਪਹੁ ਬਸਤ੍ਰ ਭਗੌਹੇ ਧਰਿ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਤ ਭਈ ਤਿਹ ਸਾਥ ਨਿਕਰਿ ਕੈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਚੋਬਦਾਰ ਕਿਨਹੂੰ ਨ ਹਟਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਭਹਿਨ ਕਰਿ ਜੋਗੀ ਠਹਰਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਵਹੁ ਜਾਤ ਕੋਸ ਬਹੁ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਰਾਜੈ ਪਾਛੇ ਸੁਧ ਲਈ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਇਕ੍ਰਯਾਵਨ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੫੧॥੬੪੭੬॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਇਸਕ ਤੰਬੋਲ ਸਹਿਰ ਜਹ ਸੋਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਇਸਕ ਤੰਬੋਲ ਨਰਿਸ ਤਹ ਕੋ ਹੈ ॥",
      "s": 14
    }
  ]
}
