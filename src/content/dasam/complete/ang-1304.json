{
  "page": 1304,
  "lines": [
    {
      "t": "ਇਸਕਪੇਚ ਦੇ ਤਾ ਕੀ ਰਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੁੰਦਰਿ ਦੇਸ ਦੇਸ ਮਹਿ ਜਾਨੀ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਕਾਜੀ ਬਸਤ ਏਕ ਤਹ ਭਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਆਰਫ ਦੀਨ ਨਾਮ ਉਜਿਯਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਤਾ ਜੇਬਤੁਲ ਨਿਸਾ ਤਵਨ ਕੀ ॥",
      "s": 14
    },
    {
      "t": "ਸਸਿ ਕੀ ਸੀ ਦੁਤਿ ਲਗਤ ਜਵਨ ਕੀ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਗੁਲਜਾਰ ਰਾਇ ਇਕ ਨਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਥਕਿਤ ਰਹਤ ਨਿਰਖਤ ਜਿਹ ਬਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਕਾਜੀ ਕੀ ਸੁਤਾ ਨਿਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਦਨ ਬਾਨ ਤਹ ਤਾਹਿ ਪ੍ਰਹਾਰਾ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਹਿਤੂ ਜਾਨਿ ਇਕ ਸਖੀ ਬੁਲਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕਹ ਕਹਾ ਭੇਦ ਸਮਝਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜੌ ਤਾ ਕਹ ਤੈ ਮੋਹਿ ਮਿਲਾਵੈਂ ॥",
      "s": 14
    },
    {
      "t": "ਮੁਖ ਮਾਗੈ ਸੋਈ ਬਰੁ ਪਾਵੈਂ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਸਖੀ ਗਈ ਤਬ ਹੀ ਤਾ ਕੇ ਪ੍ਰਤਿ ॥",
      "s": 14
    },
    {
      "t": "ਆਨਿ ਮਿਲਾਇ ਦਯੌ ਤਿਨ ਸੁਭ ਮਤਿ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਦੁਹੂੰ ਕਰੇ ਬਿਲਾਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਜਿ ਕਰਿ ਮਾਤ ਪਿਤਾ ਕੋ ਤ੍ਰਾਸਾ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਅਸ ਗੀ ਅਟਕਿ ਤਵਨ ਪਰ ਤਰੁਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਜੋਰਿ ਨ ਸਕਤ ਪਲਕ ਸੌ ਬਰਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਰੈਨਿ ਦਿਵਸ ਤਿਹ ਪ੍ਰਭਾ ਨਿਹਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਧੰਨ੍ਯ ਜਨਮ ਕਰਿ ਅਪਨ ਬਿਚਾਰੈ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਧੰਨਿ ਧੰਨਿ ਤਵਨ ਦਿਵਸ ਬਡਭਾਗੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਦਿਨ ਲਗਨ ਤੁਮਾਰੀ ਲਾਗੀ ॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਕਛੁ ਐਸ ਉਪਾਵ ਬਨੈਯੈ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਛਲ ਪਿਯ ਕੇ ਸੰਗ ਸਿਧੈਯੈ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਬੋਲਿ ਭੇਦ ਸਭ ਪਿਯਹਿ ਸਿਖਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰੋਮਨਾਸ ਤਿਹ ਬਦਨ ਲਗਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਹੀ ਕੇਸ ਦੂਰ ਕਰਿ ਡਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਪੁਰਖ ਨਾਰਿ ਨਹਿ ਜਾਤ ਬਿਚਾਰੇ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਤ੍ਰਿਯ ਭੇਸ ਧਰਾ ਪ੍ਰੀਤਮ ਜਬ ॥",
      "s": 14
    },
    {
      "t": "ਠਾਢਾ ਭਯੋ ਅਦਾਲਤਿ ਮੈ ਤਬ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਿ ਮੁਰ ਚਿਤ ਕਾਜੀ ਸੁਤ ਲੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਮੈ ਚਾਹਤ ਤਾ ਕੌ ਪਤਿ ਕੀਨਾ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਕਾਜੀ ਕਾਢਿ ਕਿਤਾਬ ਨਿਹਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਖਿ ਦੇਖਿ ਕਰਿ ਇਹੈ ਉਚਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਆਵੈ ਆਪਨ ਹ੍ਵੈ ਰਾਜੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕਹ ਕਹਿ ਨ ਸਕਤ ਕਛੁ ਕਾਜੀ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਯਹ ਹਮਰੇ ਸੁਤ ਕੀ ਭੀ ਦਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਹਮ ਯਾ ਕੀ ਕਰਿ ਹੈ ਪ੍ਰਤਿਪਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਜੜ ਕਛੂ ਨ ਚੀਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਿਤ ਸਾਹ ਮੁਹਰ ਕਰਿ ਦੀਨੀ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਮੁਹਰ ਕਰਾਇ ਧਾਮ ਵਹ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪੁਰਸ ਭੇਸ ਧਰਿ ਆਵਤ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਦਿਨ ਦੁਤਿਯ ਕਚਹਿਰੀ ਲਾਗੀ ॥",
      "s": 14
    },
    {
      "t": "ਪਾਤਸਾਹ ਬੈਠੇ ਬਡਭਾਗੀ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਕਾਜੀ ਕੋਟਵਾਰ ਥੋ ਜਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਪੁਰਖ ਭੇਸ ਧਰਿ ਆਯੋ ਤਹਾ ॥",
      "s": 14
    }
  ]
}
