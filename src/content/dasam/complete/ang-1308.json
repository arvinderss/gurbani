{
  "page": 1308,
  "lines": [
    {
      "t": "ਦੁਹਿਤਾ ਸਹਿਤ ਰਾਜ ਹਰ ਲਿਯੋ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਥਮ ਸੁਤਾ ਰਾਜਾ ਕੀ ਹਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਨਾਸ ਤਿਹ ਤਨ ਕੀ ਕਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰੌ ਛੀਨਿ ਰਾਜ ਤਿਨ ਲੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਰਿ ਬਿਲਾਸ ਦੇਈ ਕਹ ਕੀਨਾ ॥੧੬॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਪਚਪਨ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੫੫॥੬੫੩੧॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨੁ ਨ੍ਰਿਪ ਕਥਾ ਬਖਾਨੈ ਔਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਭਈ ਏਕ ਰਾਜ ਕੀ ਠੌਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਸਹਿਰ ਸੁ ਨਾਰ ਗਾਵ ਹੈ ਜਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਬਲ ਸਿੰਘ ਰਾਜਾ ਇਕ ਤਹਾ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਦਲ ਥੰਭਨ ਦੇਈ ਤਿਹ ਨਾਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਜੰਤ੍ਰ ਮੰਤ੍ਰ ਜਿਹ ਪੜੇ ਸੁਧਾਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਜੋਗੀ ਇਕ ਸੁੰਦਰ ਤਹ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਸਮ ਸੁੰਦਰ ਬਿਧ ਨ ਬਨਾਯੋ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਨਿਰਖਿ ਰੀਝਿ ਤਿਹ ਰਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਮਨ ਬਚ ਕ੍ਰਮ ਐਸੀ ਬਿਧਿ ਕਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਚਰਿਤ੍ਰ ਜੁਗਿਯਾ ਕਹ ਪੈਯੈ ॥",
      "s": 14
    },
    {
      "t": "ਉਸੀ ਚਰਿਤ੍ਰ ਕੌ ਆਜੁ ਬਨੈਯੈ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਬ੍ਰਿਸਟਿ ਬਿਨਾ ਬਦਰਾ ਗਰਜਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਮੰਤ੍ਰ ਸਕਤਿ ਅੰਗਰਾ ਬਰਖਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੋਨ ਅਸਥਿ ਪ੍ਰਿਥਮੀ ਪਰ ਪਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਿ ਲੋਗ ਸਭ ਹੀ ਜਿਯ ਡਰੈ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਭੂਪ ਮੰਤ੍ਰਿਯਨ ਬੋਲਿ ਪਠਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬੋਲਿ ਬਿਪ੍ਰ ਪੁਸਤਕਨ ਦਿਖਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਇਨ ਬਿਘਨਨ ਕੋ ਕਹ ਉਪਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਮ ਸਭ ਹੀ ਮਿਲਿ ਕਰਹੁ ਬਿਚਾਰਾ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਲਗਿ ਬੀਰ ਹਾਕਿ ਤਿਹ ਰਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਸੌ ਕਹਵਾਈ ਬਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਕਾਜ ਉਬਰੇ ਜੋ ਕਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਤਰ ਪ੍ਰਜਾ ਸਹਿਤ ਨ੍ਰਿਪ ਮਰੈ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਸਭਹਿਨ ਲਖੀ ਗਗਨ ਕੀ ਬਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਬੀਰ ਬਾਕ੍ਰਯ ਕਿਨਹੂੰ ਨ ਪਛਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਬੀਰ ਤਿਨ ਐਸ ਉਚਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੁ ਮੈ ਕਹਤ ਹੌ ਸੁਨਹੁ ਪ੍ਯਾਰੋ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਜੌ ਰਾਜਾ ਅਪਨੀ ਲੈ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜੁਗਿਯਨ ਦੈ ਧਨ ਸਹਿਤ ਸੁਧਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਇਹ ਪ੍ਰਜਾ ਸਹਿਤ ਨਹਿ ਮਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਅਬਿਚਲ ਰਾਜ ਪ੍ਰਿਥੀ ਪਰ ਕਰੈ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਜਾ ਲੋਕ ਸੁਨਿ ਬਚ ਅਕੁਲਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਜ੍ਯੋਂ ਤ੍ਯੋਂ ਤਹਾ ਨ੍ਰਿਪਹਿ ਲੈ ਆਏ ॥",
      "s": 14
    },
    {
      "t": "ਜੁਗਿਯਹਿ ਦੇਹਿ ਦਰਬੁ ਜੁਤ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਕੀ ਗਤਿ ਨ ਬਿਚਾਰੀ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਜਾ ਸਹਿਤ ਰਾਜਾ ਛਲਾ ਗਈ ਮਿਤ੍ਰ ਕੇ ਨਾਰਿ ॥",
