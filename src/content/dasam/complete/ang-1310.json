{
  "page": 1310,
  "lines": [
    {
      "t": "ਨਿਤਪ੍ਰਤਿ ਅਪਨੋ ਮੂੰਡ ਮੁੰਡਾਵੈ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਸਤਾਵਨ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੫੭॥੬੫੫੩॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨੁ ਭੂਪਤਿ ਇਕ ਕਥਾ ਨਵੀਨੀ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਕਿਨਹੂੰ ਲਖੀ ਨ ਆਗੇ ਚੀਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੁੰਦ੍ਰਾਵਤੀ ਨਗਰ ਇਕ ਸੋਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁੰਦਰ ਸਿੰਘ ਰਾਜਾ ਤਹ ਕੋ ਹੈ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਸੁੰਦਰ ਦੇ ਰਾਜਾ ਕੀ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਆਪੁ ਜਨਕੁ ਜਗਦੀਸ ਸਵਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੀ ਜਾਤ ਨ ਪ੍ਰਭਾ ਬਖਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਐਸੀ ਹੁਤੀ ਰਾਇ ਕੀ ਰਾਨੀ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਤਹਿਕ ਸਾਹ ਕੋ ਪੂਤ ਅਪਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਨਕ ਅਵਟਿ ਸਾਚੇ ਜਨੁ ਢਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਿ ਨਾਕ ਜਿਹ ਸੂਆ ਰਿਸਾਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਕੰਜ ਜਾਨਿ ਦ੍ਰਿਗ ਭਵਰ ਭੁਲਾਨੋ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਕਟਿ ਕੇਹਰਿ ਲਖਿ ਅਧਿਕ ਰਿਸਾਵਤ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਫਿਰਤ ਮ੍ਰਿਗਨ ਕਹ ਘਾਵਤ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਿ ਬਾਨੀ ਕੋਕਿਲ ਕੁਕਰਈ ॥",
      "s": 14
    },
    {
      "t": "ਕ੍ਰੋਧ ਜਰਤ ਕਾਰੀ ਹ੍ਵੈ ਗਈ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਨੈਨ ਨਿਰਖਿ ਕਰਿ ਜਲਜ ਲਜਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਜਲ ਮਹਿ ਕਿਯਾ ਪਯਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਲਕ ਹੇਰਿ ਨਾਗਿਨਿ ਰਿਸਿ ਭਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਚਿਤ ਮਹਿ ਲਜਤ ਪਤਾਰਹਿ ਬਰੀ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਆਯੋ ਰਾਜਾ ਕੇ ਪਾਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੌਦਾ ਕੀ ਜਿਯ ਮੈ ਧਰਿ ਆਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੁੰਦਰਿ ਦੇ ਨਿਰਖਤ ਤਿਹ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਧਿ ਬੁਧਿ ਤਜਿ ਬੌਰੀ ਹ੍ਵੈ ਗਈ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਪਠੈ ਸਹਚਰੀ ਤਾਹਿ ਬੁਲਾਵਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਕਿਯ ਜਸ ਮਨ ਭਾਵਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਇਕ ਹੁਤੀ ਨ੍ਰਿਪਤਿ ਕੀ ਚੇਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਹੇਰਿ ਗਈ ਜਸ ਹੇਰਿ ਅਹੇਰੀ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਪਾਵ ਦਾਬਿ ਨ੍ਰਿਪ ਜਾਇ ਜਗਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਧਾਮ ਤੋਰ ਤਸਕਰਿ ਇਕ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਕੇ ਸੰਗ ਕਰਤ ਬਿਲਾਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਚਲਿ ਦੇਖਹੁ ਤਿਹ ਭੂਪ ਤਮਾਸਾ ॥੮॥",
      "v": [
        [
          3,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸੁਨਤ ਬਚਨ ਨ੍ਰਿਪ ਅਧਿਕ ਰਿਸਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਖੜਗ ਹਾਥ ਲੈ ਤਹਾ ਸਿਧਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਅਬਲਾ ਪਤਿ ਕੀ ਸੁਧਿ ਪਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਧੂੰਮ ਤਹ ਦਿਯਾ ਜਗਾਈ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਕੇ ਨੈਨ ਧੂਮ੍ਰ ਸੌ ਭਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਅਸੁਆ ਟੂਟਿ ਬਦਨ ਪਰ ਪਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਰਾਨੀ ਇਹ ਘਾਤ ਪਛਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਮਿਤ੍ਰ ਲੰਘਾਇ ਹਿਯੇ ਹਰਖਾਨੀ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਆਗੇ ਸੌ ਕਰਿ ਕਾਢਾ ਜਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਧੂਮ੍ਰ ਭਰੇ ਦ੍ਰਿਗ ਨ੍ਰਿਪਨ ਨਿਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਪੌਛ ਨੇਤ੍ਰ ਜਬ ਹੀ ਗਯੋ ਤਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਕੋਊ ਨ ਪੁਰਖ ਨਿਹਾਰਾ ਉਹਾ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਉਲਟਿ ਤਿਸੀ ਚੇਰੀ ਕਹ ਘਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਰਾਨੀ ਕਹ ਦੋਸ ਲਗਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੂਰਖ ਭੂਪ ਨ ਭੇਦ ਬਿਚਾਰਾ ॥",
      "s": 14
    }
  ]
}
