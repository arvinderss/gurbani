    {
      "t": "ਹਮਰੋ ਪਾਪ ਪੁਰਾਤਨ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਫਲ ਜਨਮ ਹਮਰੋ ਅਬ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਗੰਨਾਥ ਕੋ ਪਾਯੋ ਦਰਸਨ ॥",
      "s": 14
    },
    {
      "t": "ਔਰ ਕਰਾ ਹਾਥਨ ਪਗ ਪਰਸਨ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਲਗ ਭੂਪ ਸੁਤਾ ਤਹ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਪਿਤਾ ਸੁਨਤ ਅਸ ਕਹਾ ਸੁਨਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਿ ਮੈ ਸੈਨ ਆਜੁ ਹਿਯਾ ਕਰਿ ਹੋ ॥",
      "v": [
        [
          0,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਜਿਹ ਏ ਕਹੈ ਤਿਸੀ ਕਹ ਬਰਿ ਹੋ ॥੫॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਪ੍ਰਾਤ ਉਠੀ ਤਹ ਤੇ ਸੋਈ ਜਬ ॥",
      "s": 14
    },
    {
      "t": "ਬਚਨ ਕਹਾ ਪਿਤ ਸੰਗ ਇਹ ਬਿਧਿ ਤਬ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਘਰ ਸੈਨ ਖਤ੍ਰੀ ਜੋ ਆਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਗੰਨਾਥ ਦੀਨੀ ਮੈ ਤਾਹੀ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਰਾਜੈ ਬਚਨ ਸੁਨਾ ਇਹ ਬਿਧਿ ਜਬ ॥",
      "s": 14
    },
    {
      "t": "ਐਸ ਕਹਾ ਦੁਹਿਤਾ ਕੇ ਸੰਗ ਤਬ ॥",
      "s": 14
    },
    {
      "t": "ਜਗੰਨਾਥ ਜਾ ਕਹ ਤੂ ਦੀਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਹਮ ਸੌ ਜਾਤ ਨ ਤਾ ਸੌ ਲੀਨੀ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਨ ਕਛੁ ਜੜ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਅਪਨਾ ਮੂੰਡ ਮੁੰਡਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਗੰਨਾਥ ਕੋ ਬਚਨ ਪਛਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਸੁਤਾ ਲੈ ਮੀਤ ਸਿਧਾਨਾ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਸਾਠ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੬੦॥੬੫੮੦॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨੁ ਰਾਜਾ ਇਕ ਕਥਾ ਪੁਰਾਤਨ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਜਿਹ ਬਿਧਿ ਪੰਡਿਤ ਕਹਤ ਮਹਾ ਮੁਨਿ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਮਹੇਸ੍ਰ ਸਿੰਘ ਰਾਜਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਡੰਡ ਦੇਤ ਜਾ ਕੋ ਨ੍ਰਿਪ ਨਾਨਾ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਨਗਰ ਮਹੇਸ੍ਰਾਵਤਿ ਤਹ ਰਾਜਤ ॥",
      "s": 14
    },
    {
      "t": "ਅਮਰਾਵਤਿ ਜਹ ਦੁਤਿਯ ਬਿਰਾਜਤ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੀ ਜਾਤ ਨ ਉਪਮਾ ਕਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਅਲਕਾ ਨਿਰਖਿ ਥਕਿਤ ਤਿਹ ਰਹੀ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਗਜ ਗਾਮਿਨਿ ਦੇ ਸੁਤਾ ਭਨਿਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਚੰਦ੍ਰ ਸੂਰ ਪਟਤਰ ਮੁਖ ਦਿਜੈ ॥",
