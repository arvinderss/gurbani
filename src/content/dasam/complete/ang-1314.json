{
  "page": 1314,
  "lines": [
    {
      "t": "ਰਾਜ ਸੁਤਾ ਲਖ ਤਾਹਿ ਲੁਭਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਗਿਰੀ ਧਰਨਿ ਜਨੁ ਨਾਗ ਚਬਾਈ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਸੁਤਾ ਗਿਰੀ ਮਇਯਾ ਤਹ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੀਚਿ ਬਾਰਿ ਬਹੁ ਚਿਰੈ ਜਗਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਤਾ ਕੋ ਬਹੁਰੌ ਸੁਧਿ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਉਲਟਿ ਗਿਰੀ ਜਨ ਲਗੀ ਹਵਾਈ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਪਹਰਿਕ ਬਿਤੇ ਬਹੁਰਿ ਸੁਧਿ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਰੋਇ ਮਾਤ ਸੌ ਬਾਤ ਜਨਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਗਨਿ ਜਾਰਿ ਮੁਹਿ ਅਬੈ ਜਰਾਵੌ ॥",
      "s": 14
    },
    {
      "t": "ਇਹੁ ਕੁਰੂਪ ਕੇ ਧਾਮ ਨ ਦ੍ਰਯਾਵੌ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਮਾਤਹਿ ਹੁਤੀ ਸੁਤਾ ਅਤਿ ਪ੍ਯਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਚਿੰਤਾ ਕਰੀ ਚਿਤ ਮਹਿ ਭਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਨਿ ਇਹ ਰਾਜ ਸੁਤਾ ਮਰਿ ਜਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਾ ਕਰੈ ਤਾ ਕੀ ਤਬ ਮਾਇ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਨ੍ਰਿਪ ਸੁਤਾ ਕਛੂ ਸੁਧਿ ਪਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਰੋਇ ਮਾਤ ਸੌ ਬਾਤ ਸੁਨਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਧ੍ਰਿਗ ਮੁਹਿ ਰਾਜ ਸੁਤਾ ਕ੍ਯੋ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਸੀ ਸਾਹ ਕੇ ਧਾਮ ਨ ਗਈ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਮੋਰੋ ਭਾਗ ਲੋਪ ਹ੍ਵੈ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਜਨਮ ਭੂਪ ਕੋ ਲਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਐਸੇ ਕੁਰੂਪ ਕੇ ਜੈ ਹੌ ॥",
      "s": 14
    },
    {
      "t": "ਰੈਨਿ ਦਿਵਸ ਸਭ ਰੋਤ ਬਿਤੈ ਹੌ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਧ੍ਰਿਗ ਮੁਹਿ ਨਾਰਿ ਜੋਨਿ ਕਸ ਧਰੀ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਕ੍ਯੋਨ ਭੂਪਤਿ ਕੇ ਧਾਮੌਤਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਗੀ ਦੇਤ ਨ ਮ੍ਰਿਤੁ ਬਿਧਾਤਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਹੀ ਕਰੌ ਦੇਹਿ ਕੋ ਘਾਤਾ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਮੁਖ ਮਾਗੇ ਜੋ ਪੁਰਖ ਕੋ ਭਲੋ ਬੁਰੋ ਕੁਛ ਹੋਇ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤੌ ਦੁਖਿਯਾ ਇਹ ਜਗਤ ਮੈ ਜਿਯਤ ਨ ਉਬਰੈ ਕੋਇ ॥੧੫॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਮੈ ਮਾਰਿ ਕਟਾਰੀ ਮਰਿਹੌ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਤਰ ਬਸਤ੍ਰ ਭਗੌਹੇ ਧਰਿਹੌ ॥",
      "s": 14
    },
    {
      "t": "ਬਰੌ ਤ ਪੂਤ ਸਾਹ ਕੋ ਬਰੌ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਤਰ ਆਜੁ ਖਾਇ ਬਿਖੁ ਮਰੌ ॥੧੬॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਕੋ ਦੁਹਿਤਾ ਥੀ ਪ੍ਯਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੋਈ ਕਰੀ ਜੁ ਤਾਹਿ ਉਚਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਚੇਰੀ ਕਾਢਿ ਤਵਨ ਕਹ ਦੀਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਪ ਸੁਤਾ ਕਰਿ ਤਿਨ ਜੜ ਚੀਨੀ ॥੧੭॥",
      "s": 14
    },
    {
      "t": "ਸਾਹ ਪੁਤ੍ਰ ਕਹ ਦਈ ਕੁਮਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਤਿਯ ਪੁਰਖ ਨਹਿ ਕ੍ਰਿਯਾ ਬਿਚਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਲੈ ਚੇਰੀ ਵਹੁ ਭੂਪ ਸਿਧਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨ੍ਯੋ ਰਾਜ ਸੁਤਾ ਬਰਿ ਲ੍ਯਾਯੋ ॥੧੮॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਤ੍ਰੈਸਠਿ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੬੩॥੬੬੧੪॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਗਨਪਤਿ ਸਿੰਘ ਏਕ ਰਾਜਾ ਬਰ ॥",
      "s": 14
    },
    {
      "t": "ਗਨਪਾਵਤੀ ਹੁਤੋ ਜਾ ਕੇ ਘਰ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਮਹਤਾਬ ਪ੍ਰਭਾ ਤਿਹ ਰਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਹਿ ਨਿਰਖਿ ਕਰਿ ਨਾਰਿ ਲਜਾਨੀ ॥੧॥",
      "s": 14
    }
  ]
}
