{
  "page": 1315,
  "lines": [
    {
      "t": "ਮੁਹਕਮ ਸਿੰਘ ਏਕ ਛਤ੍ਰੀ ਜਹ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਸਮ ਉਪਜਾ ਦੁਤਿਯ ਨ ਮਹਿ ਮਹ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਜਬ ਤਾ ਕੋ ਲਖਿ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਗ੍ਰਿਹ ਬੋਲਿ ਕਮਾਯੋ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਲਗਿ ਆਇ ਗਯੋ ਰਾਜਾ ਤਹ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਰ ਹੁਤੋ ਭੋਗਤ ਤਾ ਕੌ ਜਹ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖ ਨਾਥ ਤ੍ਰਿਯ ਚਰਿਤ੍ਰ ਬਿਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਹਾਰ ਤੋਰਿ ਅੰਗਨਾ ਮਹਿ ਡਾਰਾ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਬਿਹਸਿ ਬਚਨ ਨ੍ਰਿਪ ਸੰਗ ਉਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਖੋਜਿ ਹਾਰ ਤੁਮ ਦੇਹੁ ਹਮਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਆਨ ਪੁਰਖ ਜੌ ਹਾਥ ਲਗੈ ਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਤੌ ਹਮਰੇ ਪਹਿਰਨ ਤੇ ਜੈ ਹੈ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਖੋਜਤ ਭਯੋ ਜੜ ਹਾਰ ਅਯਾਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਨੇਤ੍ਰ ਨੀਚ ਕਰਿ ਭੇਦ ਨ ਜਾਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਰਿ ਆਗੇ ਹ੍ਵੈ ਮੀਤ ਨਿਕਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਿਰ ਨੀਚੇ ਪਸੁ ਤਿਹ ਨ ਨਿਹਾਰਾ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਪਹਰਿਕ ਲਗੇ ਖੋਜਿ ਜੜ ਹਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਲੈ ਰਾਨੀ ਕਹ ਦਯੋ ਸੁਧਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਤਿ ਪਤਿਬ੍ਰਤਾ ਤਾਹਿ ਠਹਰਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਤਿਯ ਪੁਰਖ ਜਿਨ ਕਰ ਨ ਛੁਆਯੋ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਚੌਸਠਿ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੬੪॥੬੬੨੦॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪਬਰ ਸਿੰਘ ਏਕ ਰਾਜਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਨਤ ਆਨਿ ਦੇਸ ਜਿਹ ਨਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਕਿਲਕੰਚਿਤ ਦੇ ਤਿਹ ਰਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਹਿ ਨਿਰਖਿ ਪੁਰ ਨਾਰਿ ਰਿਸਾਨੀ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪਬਰਵਤੀ ਨਗਰ ਤਿਹ ਰਾਜਤ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਤਿਯ ਪ੍ਰਿਥੀ ਜਨੁ ਸੁਰਗ ਬਿਰਾਜਤ ॥",
      "s": 14
    },
    {
      "t": "ਨਗਰ ਪ੍ਰਭਾ ਨਹਿ ਜਾਤ ਬਖਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਥਕਿਤ ਰਹਤ ਰਾਜਾ ਅਰੁ ਰਾਨੀ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਚਿਤਚੌਪ ਮਤੀ ਤਿਹ ਕੰਨ੍ਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਸਮ ਨਾਰਿ ਨ ਉਪਜੀ ਅੰਨ੍ਰਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੀ ਜਾਤ ਨ ਉਪਮਾ ਕਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਰੂਪ ਰਾਸ ਜੋਬਨ ਤਨ ਭਰੀ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਕੁਅਰ ਇਕ ਹੁਤੋ ਅਪਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਦਿਨ ਨਿਕਸਾ ਨਿਮਿਤਿ ਸਿਕਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਮ੍ਰਿਗ ਹਿਤ ਧਯੋ ਨ ਪਹੁਚਾ ਕੋਈ ॥",
      "s": 14
    },
    {
      "t": "ਆਵਤ ਭਯੋ ਨਗਰ ਤਿਹ ਸੋਈ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਸੁਤਾ ਤਿਹ ਰੂਪ ਨਿਹਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਮਨ ਕ੍ਰਮ ਬਚ ਅਸ ਕਰਾ ਬਿਚਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਐਸੋ ਛੈਲ ਏਕ ਦਿਨ ਪੈਯੈ ॥",
      "s": 14
    },
    {
      "t": "ਜਨਮ ਜਨਮ ਪਲ ਪਲ ਬਲਿ ਜੈਯੈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਅਟਿਕ ਸਿੰਘ ਲਖਿ ਤੇਜ ਸਵਾਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਥਕਿਤ ਰਹੀ ਰਾਜਾ ਕੀ ਜਾਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਪਠੈ ਸਹਚਰੀ ਲਿਯੋ ਮਗਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਰੁਚਿ ਮਾਨੁਪਜਾਇ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਚਾਰਿ ਪਹਰ ਨਿਸੁ ਕਿਯਾ ਬਿਲਾਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਜਿ ਕਰਿ ਮਾਤ ਪਿਤਾ ਕੋ ਤ੍ਰਾਸਾ ॥",
      "s": 14
    }
  ]
}
