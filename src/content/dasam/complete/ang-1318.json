{
  "page": 1318,
  "lines": [
    {
      "t": "ਜਿਸ ਹਾਥਨ ਲੈ ਪੜੇ ਪ੍ਯਾਰੀ ॥੧੭॥",
      "s": 14
    },
    {
      "t": "ਤੈ ਜਿਹ ਹਾਥ ਨਾਭਿ ਕਹ ਲਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਔਰ ਦੁਹੂੰ ਪਦ ਹਾਥ ਛੁਹਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤੇ ਜਨ ਆਜੁ ਨਗਰ ਮਹਿ ਆਏ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਮ ਸੌ ਚਾਹਤ ਨੈਨ ਮਿਲਾਏ ॥੧੮॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਸੁਤਾ ਪਤਿਯਾ ਜਬ ਚੀਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਛੋਰਿ ਲਈ ਕਰ ਕਿਸੂ ਨ ਦੀਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁ ਧਨ ਦੈ ਮਾਲਿਨੀ ਬੁਲਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਲਿਖਿ ਪਤ੍ਰੀ ਫਿਰਿ ਤਿਨੈ ਪਠਾਈ ॥੧੯॥",
      "s": 14
    },
    {
      "t": "ਸਿਵ ਕੌ ਦਿਪਤ ਦੇਹਰੋ ਜਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਮੈ ਐਹੋ ਆਧੀ ਨਿਸਿ ਤਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਕੁਅਰ ਤਹਾ ਤੁਮਹੂੰ ਚਲਿ ਐਯਹੁ ॥",
      "v": [
        [
          0,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਮਨ ਭਾਵਤ ਕੋ ਭੋਗ ਕਮੈਯਹੁ ॥੨੦॥",
      "s": 14
    },
    {
      "t": "ਕੁਅਰ ਨਿਸਾ ਆਧੀ ਤਹ ਜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਸੁਤਾ ਆਗੇ ਤਹ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਕੀ ਜੇਤਿਕ ਪ੍ਯਾਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਪੂਰਨਿ ਭਈ ਦੁਹੂੰ ਕੀ ਆਸਾ ॥੨੧॥",
      "s": 14
    },
    {
      "t": "ਮਾਲਿਨਿ ਕੀ ਦੁਹਿਤਾ ਕਹਿ ਬਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਕੁਅਰ ਕਹ ਲ੍ਯਾਈ ਧਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਤਿ ਦਿਵਸ ਦੋਊ ਕਰਤ ਬਿਲਾਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਪਤਿ ਕੀ ਤਜਿ ਕਰਿ ਕਰਿ ਤ੍ਰਾਸਾ ॥੨੨॥",
      "s": 14
    },
    {
      "t": "ਕਿਤਕ ਦਿਨਨ ਤਾ ਕੋ ਪਤਿ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਤਿ ਕੁਰੂਪ ਨਹਿ ਜਾਤ ਬਤਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੂਕਰ ਕੇ ਸੇ ਦਾਤਿ ਬਿਰਾਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਤ ਕਰੀ ਰਦਨ ਦ੍ਵੈ ਭਾਜੈ ॥੨੩॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਕੁਅਰ ਤ੍ਰਿਯ ਭੇਸ ਸੁ ਧਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਆਵਤ ਭਯੋ ਤਿਹ ਨਿਕਟ ਸਵਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਸੁਤਾ ਪਹਿ ਨਿਰਖਿ ਲੁਭਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭੋਗ ਕਰਨ ਹਿਤ ਹਾਥ ਚਲਾਯੋ ॥੨੪॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਕੁਅਰ ਤਬ ਛੁਰੀ ਸੰਭਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਕ ਕਾਟਿ ਨ੍ਰਿਪ ਸੁਤ ਕੀ ਡਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਕ ਕਟੈ ਜੜ ਅਧਿਕ ਖਿਸਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਦਨ ਛਾਡਿ ਕਾਨਨਹਿ ਸਿਧਾਯੋ ॥੨੫॥",
      "s": 14
    },
    {
      "t": "ਨਾਕ ਕਟਾਇ ਜਬੈ ਜੜ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਇਨ ਪਥ ਸਿਵ ਦੇਵਲ ਕੋ ਲਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਸੁਤ ਮ੍ਰਿਗਿਕ ਹਿਤੂ ਹਨਿ ਲ੍ਯਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਹੂੰਅਨ ਬੈਠਿ ਤਿਹੀ ਠਾ ਖਾਯੋ ॥੨੬॥",
      "s": 14
    },
    {
      "t": "ਤਹੀ ਬੈਠਿ ਦੁਹੂੰ ਕਰੇ ਬਿਲਾਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯਹਿ ਨ ਰਹੀ ਭੋਗ ਕੀ ਆਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਲੈ ਤਾ ਕੇ ਸੰਗ ਦੇਸ ਸਿਧਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਸਹਚਰਿ ਕਹ ਤਹਾ ਪਠਾਯੋ ॥੨੭॥",
      "s": 14
    },
    {
      "t": "ਡਿਵਢੀ ਸਾਤ ਸਖੀ ਤਿਨ ਨਾਖੀ ॥",
      "s": 14
    },
    {
      "t": "ਇਮਿ ਬਤੀਆ ਭੂਪਤਿ ਸੰਗ ਭਾਖੀ ॥",
      "s": 14
    },
    {
      "t": "ਪਤਿ ਤ੍ਰਿਯ ਗਏ ਦੋਊ ਨਿਸਿ ਕਹ ਤਹ ॥",
      "s": 14
    },
    {
      "t": "ਆਗੇ ਹੁਤੇ ਸਦਾ ਸਿਵ ਜੂ ਜਹ ॥੨੮॥",
      "s": 14
    },
    {
      "t": "ਦੁਹੂੰ ਜਾਇ ਤਹ ਕੀਏ ਪ੍ਰਯੋਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਤੀਸਰ ਕੋਈ ਨ ਜਾਨਤ ਲੋਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਉਲਟਿ ਪਰਾ ਸਿਵ ਜੂ ਰਿਸਿ ਭਰਿਯੌ ॥",
      "s": 14
    },
    {
      "t": "ਭਸਮੀ ਭੂਤ ਦੁਹੂੰ ਕਹ ਕਰਿਯੌ ॥੨੯॥",
      "s": 14
    },
    {
      "t": "ਵਹੈ ਭਸਮ ਲੈ ਤਿਨੈ ਦਿਖਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਮ੍ਰਿਗ ਭਛਨ ਤਿਹ ਤਿਨੈ ਜਗਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਭਸਮ ਲਹੇ ਸਭ ਹੀ ਜਿਯ ਜਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਲੈ ਪ੍ਰੀਤਮ ਘਰ ਨਾਰਿ ਸਿਧਾਨਾ ॥੩੦॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਛਿਆਸਠ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੬੬॥੬੬੬੩॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਅੰਧਾਵਤੀ ਨਗਰ ਇਕ ਸੋਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੈਨ ਬਿਦਾਦ ਭੂਪ ਤਿਹ ਕੋ ਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਮੂਰਖਿ ਮਤਿ ਤਾ ਕੀ ਬਰ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹਸੀ ਮੂੜ ਨ ਕਹੂੰ ਨਿਹਾਰੀ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਜਾ ਲੋਗ ਅਤਿ ਹੀ ਅਕੁਲਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਸ ਛੋਡਿ ਪਰਦੇਸ ਸਿਧਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਔਰ ਭੂਪ ਪਹਿ ਕਰੀ ਪੁਕਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਯਾਇ ਕਰਤ ਤੈਂ ਨਹੀ ਹਮਾਰਾ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਤੁਮ ਕੁਛ ਕਰਹੁ ਉਪਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਤੇ ਦੇਸ ਬਸੈ ਫਿਰਿ ਆਇ ॥",
      "s": 14
    },
    {
      "t": "ਚਾਰਿ ਨਾਰਿ ਤਬ ਕਹਿਯੋ ਪੁਕਾਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਹਮ ਐਹੈ ਜੜ ਨ੍ਰਿਪਹਿ ਸੰਘਾਰਿ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਦ੍ਵੈ ਤ੍ਰਿਯ ਭੇਸ ਪੁਰਖ ਕੇ ਧਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਪੈਠਿ ਗਈ ਤਿਹ ਨਗਰ ਮੰਝਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਦ੍ਵੈ ਤ੍ਰਿਯ ਭੇਸ ਜੋਗ੍ਰਯ ਕੇ ਧਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਾਪਤਿ ਭੀ ਤਿਹ ਨਗਰ ਮਝਾਰੋ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਤ੍ਰਿਯ ਚੋਰੀ ਕਰੀ ਬਨਾਇ ॥",
      "s": 14
    }
  ]
}
