{
  "page": 1320,
  "lines": [
    {
      "t": "ਜਿਹ ਸਮ ਤੁਲ ਨ ਬ੍ਰਹਮ ਸਵਾਰੀ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੋ ਨੇਹ ਏਕ ਸੌ ਲਾਗੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਤੇ ਲਾਜ ਛਾਡ ਤਨ ਭਾਗੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਘਟ ਸਿੰਘ ਤਿਹ ਨਾਮ ਭਨਿਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਕੋ ਦੂਜਾ ਪਟਤਰ ਤਿਹ ਦਿਜੈ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਨਿਤਿਪ੍ਰਤਿ ਤਿਹ ਤ੍ਰਿਯ ਬੋਲਿ ਪਠਾਵਤ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਤਿਹ ਸਾਥ ਕਮਾਵਤ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਲੌ ਤਹਾ ਨਰਾਧਿਪ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯ ਚਰਿਤ੍ਰ ਇਹ ਭਾਤਿ ਬਨਾਯੋ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਤੁਮਰੇ ਕੇਸ ਭੂਪ ਬਿਕਰਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਹੇ ਨ ਮੋ ਤੇ ਜਾਤ ਸੁਧਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਥਮਹਿ ਰੋਮ ਮੂੰਡਿ ਤੁਮ ਆਵਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਹਮਾਰੀ ਸੇਜ ਸੁਹਾਵਹੁ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਨ੍ਰਿਪ ਗਯੋ ਰੋਮ ਮੂੰਡਿਨ ਹਿਤ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਅਧਿਕ ਪ੍ਰਸੰਨ੍ਯ ਭਈ ਚਿਤ ॥",
      "s": 14
    },
    {
      "t": "ਛਿਦ੍ਰ ਤਾਕਿ ਨਿਜੁ ਮੀਤ ਲੁਕਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੂਰਖ ਭੂਪ ਭੇਦ ਨਹਿ ਪਾਯੋ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਅਠਸਠ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੬੮॥੬੬੮੩॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨੁ ਰਾਜਾ ਇਕ ਔਰ ਕਹਾਨੀ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਜਿਹ ਬਿਧਿ ਕਿਯਾ ਰਾਵ ਸੰਗ ਰਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਗਨਪਤਿ ਸਿੰਘ ਏਕ ਰਾਜਾ ਬਰ ॥",
      "s": 14
    },
    {
      "t": "ਸਤ੍ਰੁ ਕੰਪਤ ਤਾ ਕੇ ਡਰ ਘਰ ਘਰ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਚੰਚਲ ਦੇ ਰਾਜਾ ਕੀ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਸੁ ਸਮ ਦੁਤਿਯ ਨ ਕਹੂੰ ਹਮਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਅਵਰ ਰਾਨਿਯਨ ਕੇ ਘਰ ਆਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੌ ਕਬ ਹੀ ਮੁਖ ਨ ਦਿਖਾਵੈ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਇਨ ਬਾਤਨ ਤੇ ਜਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਪਤਿ ਬਧ ਕੀ ਇਛਾ ਜਿਯ ਧਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਔਰ ਨਾਰਿ ਕੋ ਧਰਿ ਕਰਿ ਭੇਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਜੁ ਪਤਿ ਕੇ ਗ੍ਰਿਹ ਕਿਯਾ ਪ੍ਰਵੇਸਾ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਅਪਨੀ ਨਾਰਿ ਨ ਨ੍ਰਿਪਤਿਹ ਜਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਰੂਪ ਲਖਿ ਤਾਹਿ ਲੁਭਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਭਈ ਰੈਨਿ ਤਬ ਲਈ ਬੁਲਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਭੋਗ ਕੀਯਾ ਤਾ ਸੌ ਲਪਟਾਇ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਯੌ ਬਤਿਯਾ ਤਿਹ ਸਾਥ ਉਚਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਹੈ ਛਿਨਾਰ ਨ੍ਰਿਪ ਨਾਰ ਤਿਹਾਰੀ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਏਕ ਪੁਰਖ ਕੋ ਧਾਮ ਬੁਲਾਵਤ ॥",
      "s": 14
    },
    {
      "t": "ਮੁਹਿ ਨਿਰਖਤ ਤਾ ਸੌ ਲਪਟਾਵਤ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਯੌ ਨ੍ਰਿਪ ਸੋ ਤਿਨ ਕਹੀ ਬਨਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਅਤਿ ਨਿਜੁ ਪਤਿ ਕਹ ਰਿਸਿ ਉਪਜਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਲਖਿਨ ਚਲਾ ਭੂਪਤ ਤਿਹ ਧਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਧਾਮ ਆਪਨਾਗਮ ਤ੍ਰਿਯ ਆਈ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਨਿਜੁ ਤਨੁ ਭੇਸ ਪੁਰਖ ਕੋ ਧਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਗਈ ਸਵਤਿ ਕੇ ਧਾਮ ਸੁਧਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਆਗੇ ਪ੍ਰੀਤਿ ਹੁਤੀ ਸੰਗ ਜਾ ਕੇ ॥",
      "s": 14
    },
    {
      "t": "ਬੈਠੀ ਜਾਇ ਸੇਜ ਚੜਿ ਤਾ ਕੇ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਤਬਿ ਲਗਿ ਤਹਾ ਨਰਾਧਿਪ ਆਯੋ ॥",
      "s": 14
    }
  ]
}
