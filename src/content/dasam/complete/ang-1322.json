      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਸਖੀ ਤਾ ਕੌ ਲਖਿ ਪਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਬੈਠਿ ਸਖਿਨ ਮਹਿ ਬਾਤ ਚਲਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਸ ਸੁੰਦਰ ਇਕ ਇਹ ਪੁਰ ਮਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਤੈਸੌ ਚੰਦ੍ਰ ਸੂਰ ਭੀ ਨਾਹੀ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਿ ਬਤਿਯਾ ਰਾਨੀ ਜਿਯ ਰਾਖੀ ॥",
      "s": 14
    },
    {
      "t": "ਔਰ ਨਾਰਿ ਸੌ ਪ੍ਰਗਟ ਨ ਭਾਖੀ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਸਹਚਰਿ ਤਾ ਕੌ ਲਖਿ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਰੈਨਿ ਭਈ ਤਬ ਵਹੈ ਬੁਲਾਈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਦਰਬੁ ਤਾ ਕੌ ਦੈ ਰਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਪੂਛੀ ਤਾਹਿ ਦੀਨ ਹ੍ਵੈ ਬਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੁ ਕਹੁ ਕਹਾ ਮੁਹਿ ਜੁ ਤੈ ਨਿਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਯਾ ਚਾਹਤ ਤਿਹ ਦਰਸ ਅਪਾਰਾ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਚੇਰੀ ਇਮਿ ਬਚਨ ਉਚਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨੁ ਰਾਨੀ ਜੂ ਕਹਾ ਹਮਾਰੋ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਜਸ ਤਿਲਕ ਰਾਇ ਤਿਹ ਜਾਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਹ ਪੂਤ ਤਾ ਕਹ ਪਹਿਚਾਨੋ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਜੁ ਤੁਮ ਕਹੌ ਤਿਹ ਤੁਮੈ ਮਿਲਾਊ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਮਦਨ ਤਾਪ ਸਭ ਤੋਰ ਮਿਟਾਊ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸੁਨਤ ਬਚਨ ਰਾਨੀ ਪਗ ਪਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਪੁਨਿ ਤਾ ਸੌ ਬਿਨਤੀ ਇਮਿ ਕਰੀ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਜੇ ਤਾ ਕੋ ਤੈਂ ਮੁਝੈ ਮਿਲਾਵੈਂ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਧਨ ਮੁਖ ਮਾਗੈ ਸੋ ਪਾਵੈਂ ॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਸਖੀ ਗਈ ਬਾਰ ਨਹਿ ਲਾਗੀ ॥",
      "s": 14
    },
    {
      "t": "ਆਨਿ ਦਿਯੋ ਤਾ ਕੌ ਬਡਭਾਗੀ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਤਾ ਕੌ ਪਾਇ ਤਿਹ ਦਾਰਿਦ ਦਿਯਾ ਮਿਟਾਇ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਕੀ ਆਖ ਬਚਾਇ ਉਹਿ ਲਿਯੇ ਗਰੇ ਸੌ ਲਾਇ ॥੧੦॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਦੋਊ ਧਨੀ ਔ ਜੋਬਨਵੰਤ ॥",
      "s": 14
    },
    {
      "t": "ਕਰਤ ਕਾਮ ਕ੍ਰੀੜਾ ਬਿਗਸੰਤ ॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਕਾਮੀ ਅਰੁ ਕੈਫ ਚੜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਰੈਨਿ ਸਕਲ ਰਤਿ ਕਰਤ ਬਿਤਾਈ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਲਪਟਿ ਲਪਟਿ ਆਸਨ ਵੇ ਲੇਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਆਪੁ ਬੀਚਿ ਸੁਖੁ ਬਹੁ ਬਿਧਿ ਦੇਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਚੁੰਬਨ ਕਰਤ ਨਖਨ ਕੇ ਘਾਤਾ ॥",
      "s": 14
    },
    {
      "t": "ਰੈਨਿ ਬਿਤੀ ਆਯੋ ਹ੍ਵੈ ਪ੍ਰਾਤਾ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਗਈ ਪ੍ਰਾਤ ਪਤਿ ਪਾਸ ॥",
      "s": 14
    },
    {
      "t": "ਲਗੀ ਰਹੀ ਜਾ ਕੀ ਜਿਯ ਆਸ ॥",
      "s": 14
    },
    {
      "t": "ਅਥਵਤ ਦਿਨਨ ਹੋਤ ਅੰਧਯਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਭਜੈ ਮੁਹਿ ਆਨਿ ਪ੍ਯਾਰੋ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਜੌ ਰਹਿ ਹੌ ਰਾਜਾ ਕੈ ਪਾਸ ॥",
      "s": 14
    },
    {
      "t": "ਮੋਹਿ ਰਾਖਿ ਹੈ ਬਿਰਧ ਨਿਰਾਸ ॥",
      "s": 14
    }
  ]
