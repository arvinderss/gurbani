{
  "page": 1323,
  "lines": [
    {
      "t": "ਸੰਗ ਕਹਾ ਯਾ ਕੇ ਸ੍ਵੈ ਲੈਹੌ ॥",
      "s": 14
    },
    {
      "t": "ਮਿਤ੍ਰ ਭੋਗ ਭੋਗਨ ਤੇ ਜੈਹੌ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਕਿਹ ਛਲ ਸੇਜ ਸਜਨ ਕੀ ਜਾਊ ॥",
      "s": 14
    },
    {
      "t": "ਨਖ ਘਾਤਨ ਕਿਹ ਭਾਤਿ ਛਪਾਊ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਰਧ ਭੂਪ ਤਨ ਸੋਤ ਨ ਜੈਯੈ ॥",
      "s": 14
    },
    {
      "t": "ਐਸੋ ਕਵਨ ਚਰਿਤ੍ਰ ਦਿਖੈਯੈ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਜਾਇ ਕਹੀ ਨ੍ਰਿਪ ਸੰਗ ਅਸ ਗਾਥਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਤ ਸੁਨਹੁ ਹਮਰੀ ਤੁਮ ਨਾਥਾ ॥",
      "s": 14
    },
    {
      "t": "ਹਿਯੈ ਬਿਲਾਰਿ ਮੋਰ ਨਖ ਲਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਢਿ ਭੂਪ ਕੌ ਪ੍ਰਗਟ ਦਿਖਾਏ ॥੧੬॥",
      "s": 14
    },
    {
      "t": "ਅੜਿਲ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨੁ ਰਾਜਾ ਮੈ ਆਜੁ ਨ ਤੁਮ ਸੰਗ ਸੋਇ ਹੌ ॥",
      "v": [
        [
          1,
          1
        ],
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਨਿਜੁ ਪਲਕਾ ਪਰ ਪਰੀ ਸਕਲ ਨਿਸੁ ਖੋਇ ਹੌ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਹਾ ਬਿਲਾਰਿ ਮੋਹਿ ਨਖ ਘਾਤ ਲਗਾਤ ਹੈ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਹੋ ਤੁਹਿ ਮੂਰਖ ਰਾਜਾ ਤੇ ਕਛੁ ਨ ਬਸਾਤ ਹੈ ॥੧੭॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਤਜਿ ਸ੍ਵੈਬੋ ਨ੍ਰਿਪ ਪਾਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਯਾ ਮਿਤ੍ਰ ਸੌ ਕਾਮ ਬਿਲਾਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਘਾਤ ਨਖਨ ਕੀ ਨਾਹ ਦਿਖਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਰਧ ਮੂੜ ਨ੍ਰਿਪ ਬਾਤ ਨ ਪਾਈ ॥੧੮॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਸਤਰ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੭੦॥੬੭੧੮॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਛਲ ਸੈਨ ਇਕ ਭੂਪ ਭਨਿਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਚੰਦ੍ਰ ਸੂਰ ਪਟਤਰ ਤਿਹ ਦਿਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਕੰਚਨ ਦੇ ਤਾ ਕੇ ਘਰ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਆਪੁ ਹਾਥ ਲੈ ਈਸ ਸਵਾਰੀ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਕੰਚਨ ਪੁਰ ਕੋ ਰਾਜ ਕਮਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੂਰਬੀਰ ਬਲਵਾਨ ਕਹਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਅਰਿ ਅਨੇਕ ਜੀਤੇ ਬਹੁ ਭਾਤਾ ॥",
      "s": 14
    },
    {
      "t": "ਤੇਜ ਤ੍ਰਸਤ ਜਾ ਕੇ ਪੁਰ ਸਾਤਾ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਤਹਾ ਪ੍ਰਭਾਕਰ ਸੈਨਿਕ ਸਾਹ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖ ਲਜਤ ਜਾ ਕੋ ਮੁਖ ਮਾਹ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਰਾਨੀ ਤਾ ਕਹ ਲਖਿ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਇਹੈ ਚਿਤ ਭੀਤਰ ਠਹਰਾਯੋ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਕਹ ਜਤਨ ਕਵਨ ਕਰਿ ਪਇਯੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਵਨ ਸਹਚਰੀ ਪਠੈ ਮੰਗਇਯੈ ॥",
      "s": 14
    },
    {
      "t": "ਯਾਹਿ ਭਜੈ ਬਿਨੁ ਧਾਮ ਨ ਜੈਹੌ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਤਿਹ ਭਾਤਿ ਯਾਹਿ ਬਸਿ ਕੈਹੌ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਕਨਕ ਪਿੰਜਰੀ ਪਰੀ ਹੁਤੀ ਤਹ ॥",
      "s": 14
    },
    {
      "t": "ਮਰਮ ਕੇਤੁ ਰਾਨੀ ਕੇ ਬਸਿ ਮਹ ॥",
      "s": 14
    },
    {
      "t": "ਬੀਰ ਰਾਧਿ ਤਿਹ ਤਹੀ ਪਠਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੇਜ ਉਠਾਇ ਜਾਇ ਲੈ ਆਈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਤਾ ਸੌ ਜਬ ਮਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਦ੍ਵੈ ਪ੍ਰਾਨਨ ਤੇ ਇਕ ਜਿਯ ਜਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਜੁ ਨਾਇਕ ਸੇਤੀ ਹਿਤ ਛੋਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਸੌ ਚਤੁਰਿ ਚੌਗੁਨੋ ਜੋਰੋ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਜਾਇ ਰਾਵ ਸੌ ਬਾਤ ਜਨਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਮੋਰੋ ਸਾਹ ਪੂਰਬਲੋ ਭਾਈ ॥",
      "s": 14
    }
  ]
}
