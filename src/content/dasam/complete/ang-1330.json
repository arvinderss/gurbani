{
  "page": 1330,
  "lines": [
    {
      "t": "ਤ੍ਰਿੰਬਕ ਮਹਾ ਰੁਦ੍ਰ ਹੈ ਜਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿੰਬਕ ਦਤ ਨਰਾਧਪ ਤਹਾ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਬੰਕ ਪੁਰ ਤਾ ਕੋ ਬਹੁ ਸੋਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਇੰਦ੍ਰ ਚੰਦ੍ਰ ਲੋਕ ਕਹ ਮੋਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਰਸਰੀਤਿ ਮਤੀ ਤਿਹ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਕੰਚਨ ਅਵਟਿ ਸਾਚੇ ਜਨੁ ਢਾਰੀ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਸੁਹਾਸ ਦੇ ਤਾ ਕੀ ਕੰਨ੍ਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਸਮ ਉਪਜੀ ਨਾਰਿ ਨ ਅੰਨ੍ਰਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਚਤੁਰਿ ਅਰੁ ਸੁੰਦਰਿ ਘਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਸਮਾਨ ਕੋਈ ਨਹਿ ਬਨੀ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਦਿਨ ਕੁਅਰਿ ਬਾਗ ਕੋ ਚਲੀ ॥",
      "s": 14
    },
    {
      "t": "ਬੀਸ ਪਚਾਸ ਲਏ ਸੰਗ ਅਲੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਤ ਹੁਤੀ ਮਾਰਗ ਕੇ ਮਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੁੰਦਰ ਨਿਰਖਾ ਏਕ ਤਹਾ ਹੀ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਸੇਰ ਸਿੰਘ ਤਿਹ ਨਾਮ ਬਿਰਾਜਤ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਹਿ ਨਿਰਖਿ ਰਤਿ ਕੋ ਮਨ ਲਾਜਤ ॥",
      "s": 14
    },
    {
      "t": "ਕਹ ਲਗਿ ਤਿਹ ਛਬਿ ਭਾਖਿ ਸੁਨਾਊ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਭਾ ਕੇਰ ਸੁਭ ਗ੍ਰੰਥ ਬਨਾਊ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਅੜਿਲ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਸੁਤਾ ਜਬ ਤੇ ਤਿਹ ਗਈ ਨਿਹਾਰਿ ਕਰਿ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਰਹੀ ਮਤ ਹ੍ਵੈ ਮਨ ਇਹ ਬਾਤ ਬਿਚਾਰਿ ਕਰਿ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਕੋਟਿ ਜਤਨ ਕਰਿ ਕਰਿ ਕਰਿ ਯਾਹਿ ਬੁਲਾਇਯੈ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਹੋ ਕਾਮ ਕੇਲ ਕਰਿ ਯਾ ਸੌ ਹਰਖ ਕਮਾਇਯੈ ॥੬॥",
      "v": [
        [
          5,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਖੀ ਏਕ ਤਹ ਦਈ ਪਠਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਤਿਹ ਬਿਧਿ ਤਿਹ ਲਯੋ ਬੁਲਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਪੜਿ ਪੜਿ ਦੋਹਾ ਛੰਦ ਬਿਹਾਰਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਸਕਲ ਮਦਨ ਕੋ ਤਾਪ ਨਿਵਾਰਹਿ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਆਵਤ ਨੈਨ ਨਿਰਖਿ ਕਰਿ ਰਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਚਰਿਤ ਚੰਚਲਾ ਸਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਰੋਮ ਨਾਸ ਤਿਹ ਬਦਨ ਲਗਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਰਿ ਭੇਸ ਤਾ ਕਹ ਪਹਿਰਾਯੋ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਝਾਰੂ ਏਕ ਹਾਥ ਤਿਹ ਲਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੂਜੇ ਹਾਥ ਟੋਕਰਾ ਦਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੁਹਰਨ ਔਰ ਰਪੈਯਨ ਭਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਚੰਡਾਰੀ ਭਾਖਿਨਿ ਕਰੋ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਆਗੇ ਕਰਿ ਤਾਹਿ ਨਿਕਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੂੜ ਭੂਪ ਨਹਿ ਭੇਦ ਬਿਚਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਢਿ ਖੜਗ ਤਿਹ ਹਨਤ ਨ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨਿ ਚੰਡਾਰ ਤਾਹਿ ਨ੍ਰਿਪ ਗਯੋ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਜਿਨ ਇਹ ਮੋਰ ਅੰਗ ਛੁਹਿ ਜਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਮੁਝੈ ਕਰੈ ਅਪਵਿਤ੍ਰ ਬਨਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਪਛਾਨਿ ਪਕਰਿ ਨਹਿ ਲਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਲੈ ਮੁਹਰੈ ਸੁੰਦਰ ਘਰ ਗਯੋ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਸਤਤਰ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੭੭॥੬੮੦੮॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਪ ਤ੍ਰਿਹਾਟਕ ਸੈਨ ਭਨਿਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਨਗਰ ਤਿਹਾੜੋ ਜਾਹਿ ਕਹਿਜੈ ॥",
      "s": 14
    }
  ]
}
