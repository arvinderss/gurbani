{
  "page": 1331,
  "lines": [
    {
      "t": "ਜਾਹਿ ਤ੍ਰਿਹਾਟਕ ਪੁਰੀ ਬਖਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਦਾਨਵ ਦੇਵ ਜਛ ਸਭ ਜਾਨੈ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਮਹਬੂਬ ਮਤੀ ਤਿਹ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਸਮ ਸੁੰਦਰਿ ਕਹੂੰ ਨ ਕੁਮਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਤਿਯ ਨਾਰਿ ਮ੍ਰਿਦੁਹਾਸ ਮਤੀ ਤਿਹ ॥",
      "s": 14
    },
    {
      "t": "ਨਹਿ ਸਸਿ ਸਮ ਕਹਿਯਤ ਆਨਨ ਜਿਹ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਮਹਬੂਬ ਮਤੀ ਤਨ ਨ੍ਰਿਪ ਰਤਿ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਤਿਯ ਨਾਰਿ ਪਰ ਨਹਿ ਆਨਨ ਮਤਿ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਭੋਗ ਤਿਹ ਸਾਥ ਕਮਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਪੁਤ੍ਰ ਤਾ ਤੇ ਉਪਜਾਯੋ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਦੁਤਿਯ ਨਾਰਿ ਤੇ ਸਾਥ ਨ ਪ੍ਰੀਤਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਨ ਬੀਚ ਲ੍ਯਾਵਤ ਚੀਤਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਤਵੰਤੀ ਇਕ ਪੁਨਿ ਪਤਿ ਪ੍ਰੀਤ ॥",
      "s": 14
    },
    {
      "t": "ਅਵਰ ਤ੍ਰਿਯਹਿ ਲ੍ਯਾਵਤ ਨਹਿ ਚੀਤ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਦੁਤਿਯ ਨਾਰਿ ਤਬ ਅਧਿਕ ਰਿਸਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਘਾਤ ਕੀ ਬਾਤ ਬਨਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਿਸ ਕੀ ਗੁਦਾ ਗੋਖਰੂ ਦਿਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਅਧਿਕ ਦੁਖਿਤ ਤਿਹ ਕਿਯਾ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਬਾਲਕ ਅਧਿਕ ਦੁਖਾਤੁਰ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰੋਵਤ ਧਾਮ ਮਾਤ ਕੇ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਿ ਤਾਤ ਮਾਤਾ ਦੁਖ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭਲੀ ਭਲੀ ਧਾਯਾਨ ਮੰਗਾਯੋ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਚਰਿਤ੍ਰ ਬਾਲਹਿ ਦੁਖ ਦਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਆਪਨ ਭੇਸ ਧਾਇ ਕੋ ਕਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਯਾ ਸਵਤਿ ਕੇ ਧਾਮ ਪਯਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਨਾਰਿ ਕਿਨਹੂੰ ਨ ਪਛਾਨਾ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਔਖਧ ਏਕ ਹਾਥ ਮੈ ਲਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਿਸੁ ਕੀ ਪ੍ਰਥਮ ਮਾਤ ਕੌ ਦਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਰੀ ਖਾਤ ਰਾਨੀ ਮਰਿ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਵਛ ਸੁਘਰਿ ਰਾਨੀ ਫਿਰਿ ਅਈ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਨਿਜੁ ਗ੍ਰਿਹ ਆਇ ਭੇਸ ਨ੍ਰਿਪ ਤ੍ਰਿਯ ਧਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਤਿ ਭਈ ਅਪਨੀ ਸਵਿਤਨ ਘਰ ॥",
      "s": 14
    },
    {
      "t": "ਸਿਸੁ ਕੋ ਕਾਢਿ ਗੋਖਰੂ ਡਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਸੁਘਰਿ ਤਿਹ ਸੁਤ ਕਰਿ ਪਾਰੋ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਸੋ ਸਵਤਿਨ ਕਹ ਮਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਿਸਹੁ ਜਾਨਿ ਸੁਤ ਲਿਯੋ ਉਬਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪਹ ਸੰਗ ਪੁਨਿ ਕਰਿ ਲਿਯ ਪ੍ਯਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਨ ਕਿਨੂੰ ਬਿਚਾਰਾ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਅਠਹਤਰਿ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੭੮॥੬੮੧੮॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨ ਰਾਜਾ ਇਕ ਔਰ ਪ੍ਰਸੰਗਾ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਜਿਹ ਬਿਧਿ ਭਯੋ ਨਰੇਸੁਰ ਸੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਮ੍ਰਿਦੁਲਾ ਦੇ ਤਿਹ ਨਾਰਿ ਭਨਿਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਇੰਦ੍ਰ ਚੰਦ੍ਰ ਪਟਤਰ ਤਿਹ ਦਿਜੈ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਅੜਿਲ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਸੁਪ੍ਰਭਾ ਦੇ ਤਾ ਕੀ ਸੁਤਾ ਬਖਾਨਿਯੈ ॥",
      "v": [
        [
