{
  "page": 1333,
  "lines": [
    {
      "t": "ਭਾਖੀ ਨਾਥ ਮਾਤ ਹੈ ਮੋਰੀ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਹਮ ਪਹਿ ਤੋ ਨਹਿ ਜਾਤ ਜਗਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਮੈ ਕਹਤ ਹੌ ਬਾਧਿ ਢਿਠਾਈ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਦ੍ਵੈਕ ਘਰੀ ਤੁਮ ਅਨਤ ਸਿਧਾਵਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਉਠਿ ਗਏ ਬਹੁਰਿ ਹ੍ਯਾਂ ਆਵਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਜਾਗੈ ਤੇ ਅਧਿਕ ਰਿਸੈਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਹਮ ਤੁਮ ਲਖਿ ਇਕਤ੍ਰ ਚੁਪ ਹ੍ਵੈਹੈ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਤਿਨਿ ਇਹ ਬਾਤ ਸਤ੍ਯ ਕਰਿ ਮਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਤ ਭਯੋ ਉਠਿ ਕ੍ਰਿਯਾ ਨ ਜਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਉਠਿ ਮਾਤ ਗਈ ਲਖਿ ਲੈਯਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਹਮ ਕੌ ਤੁਮ ਬਹੁਰਿ ਬੁਲੈਯਹੁ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਇਮਿ ਕਹਿ ਬਾਤ ਜਾਤ ਜੜ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਚੜਾਇ ਖਾਟ ਪਰ ਲਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਅਨਿਕ ਤਨ ਕਰੈ ਬਿਲਾਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਆਵਤ ਭਯੋ ਤਿਹ ਪਿਤਾ ਨਿਵਾਸਾ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਤਿਸੀ ਭਾਤਿ ਤਨ ਤਾਹਿ ਸੁਵਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਤ ਭਏ ਇਹ ਭਾਤਿ ਜਤਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਹੁ ਪਿਤਾ ਇਹ ਨਾਰਿ ਤਿਹਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਮ ਸੇ ਛਪੀ ਲਾਜ ਕੀ ਮਾਰੀ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਤ ਬਚਨ ਨ੍ਰਿਪ ਧਾਮ ਸਿਧਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਕਛੂ ਨ ਪਛਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੌ ਕਾਢਿ ਸੇਜ ਪਰ ਲੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੀ ਮਾਤ ਗਵਨ ਤਹ ਕੀਨਾ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਵੈਸਹਿ ਤਾ ਕਹ ਦਿਯਾ ਸੁਵਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੀ ਮਾਤ ਸੈ ਬਾਤ ਬਨਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਹੁ ਮਾਤ ਜਾਮਾਤ ਤਿਹਾਰੋ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਮੋ ਕੋ ਅਧਿਕ ਪ੍ਰਾਨ ਤੇ ਪ੍ਯਾਰੋ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਕੋ ਨੈਨ ਨੀਦ ਦੁਖ ਦਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਸੈਨ ਸ੍ਰਮਿਤ ਹ੍ਵੈ ਕਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੈ ਯਾ ਕੋ ਨਹਿ ਸਕਤ ਜਗਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਹੀ ਸੋਇ ਗਯੋ ਸੁਖਦਾਈ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਿ ਬਚ ਮਾਤ ਜਾਤ ਭੀ ਉਠ ਘਰ ॥",
      "s": 14
    },
    {
      "t": "ਲਯੋ ਸੇਜ ਪਰ ਤ੍ਰਿਯ ਪਿਯ ਭੁਜ ਭਰ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਭੋਗ ਕਮਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਧਾਮ ਕੌ ਤਾਹਿ ਪਠਾਏ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਚਰਿਤ੍ਰ ਤਿਹ ਚੰਚਲਾਮ ਪਿਯਹਿ ਦਯੋ ਪਹੁਚਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਤ੍ਰਿਯਾਨ ਕੇ ਸਕਿਯੋ ਨ ਕੋਈ ਪਾਇ ॥੧੫॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਅਸੀ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੮੦॥੬੮੪੭॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਹੁ ਰਾਵ ਇਕ ਕਥਾ ਸ੍ਰਵਨ ਧਰਿ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਜਿਹ ਬਿਧ ਕਿਯਾ ਚਰਿਤ੍ਰ ਤ੍ਰਿਯਾ ਬਰ ॥",
      "s": 14
    },
    {
      "t": "ਪੀਰ ਏਕ ਮੁਲਤਾਨ ਭਨਿਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਰੂਪਵੰਤ ਤਿਹ ਅਧਿਕ ਕਹਿਜੈ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਰੋਸਨ ਕਦਰ ਤਵਨ ਕੋ ਨਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਥਕਿਤ ਰਹਿਤ ਜਿਹ ਨਿਰਖਤ ਬਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਨਿਰਖਤਿ ਤਿਯ ਪਤਿਹਿ ਨਿਹਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੌ ਐਂਚ ਜੂਤਯਨ ਮਾਰੈ ॥੨॥",
      "s": 14
    }
  ]
}
