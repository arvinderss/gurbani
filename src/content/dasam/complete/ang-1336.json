{
  "page": 1336,
  "lines": [
    {
      "t": "ਪਤੀਬ੍ਰਤਾ ਨਾਰੀ ਕਹ ਜਾਨ੍ਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਿਰ ਪਰ ਧਰਿ ਪਲਕਾ ਪਰ ਨਚਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਜਾਰਿ ਨਾਰਿ ਜੁਤ ਬਚਾ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਤਿਰਾਸੀ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੮੩॥੬੮੭੨॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਦਾ ਸਿੰਘ ਇਕ ਭੂਪ ਮਹਾ ਮਨਿ ॥",
      "s": 14
    },
    {
      "t": "ਸਦਾਪੁਰੀ ਜਾ ਕੀ ਪਛਿਮ ਭਨਿ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਸੁਲੰਕ ਦੇ ਤਾ ਕੀ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁਕ ਚੰਦ੍ਰ ਤੇ ਚੀਰਿ ਨਿਕਾਰੀ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਇਕ ਹੋਤ ਸਾਹ ਧਨਵਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਧਨ ਕਰਿ ਡਾਰਿਯੋ ਭਗਵਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਚਤੁਰਿ ਤਾ ਕੀ ਇਕ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਤਾ ਸੌ ਇਹ ਭਾਤਿ ਉਚਾਰੀ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਕਰਿ ਹੌ ਬਹੁਰਿ ਤੁਮੈ ਧਨਵੰਤਾ ॥",
      "s": 14
    },
    {
      "t": "ਕ੍ਰਿਪਾ ਕਰੈ ਜੋ ਸ੍ਰੀ ਭਗਵੰਤਾ ॥",
      "s": 14
    },
    {
      "t": "ਆਪਨ ਭੇਸ ਪੁਰਖ ਕੋ ਧਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਬਾਟ ਪਰ ਹਾਟ ਉਸਾਰੋ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਏਕਨ ਦਰਬ ਉਧਾਰੋ ਦਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਏਕਨ ਤੇ ਰਾਖਨ ਹਿਤ ਲਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਆਪਨੀ ਪਤਿਹਿ ਚਲਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਹ ਤਹ ਸਕਲ ਧਨਿਨ ਸੁਨਿ ਪਾਯੋ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਸੋਫੀ ਸੂਮ ਸਾਹ ਇਕ ਤਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੇ ਘਰ ਸੁਨਿਯਤ ਧਨ ਮਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਤ ਤ੍ਰਿਯ ਕੋ ਨਹਿ ਕਰਤ ਬਿਸ੍ਵਾਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਖਤ ਦਰਬ ਆਪਨੇ ਪਾਸਾ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਸਾਹ ਸੁਈ ਤਿਹ ਨਾਰਿ ਤਕਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਪ੍ਰੀਤ ਕਰਿ ਤਾਹਿ ਬੁਲਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯ ਸੁਤ ਮਾਲ ਕਹਾ ਤਵ ਖੈ ਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਦਾਮ ਫਿਰਿ ਤੁਮੈ ਨ ਦੈ ਹੈ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਸਾਹ ਮਾਲ ਕਹੂੰ ਅਨਤ ਰਖਾਇ ॥",
      "v": [
        [
          0,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸਰਖਤ ਤਾ ਤੇ ਲੇਹੁ ਲਿਖਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਤ ਪੂਤ ਕੋਈ ਭੇਦ ਨ ਪਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਮ ਹੀ ਚਹਹੁ ਤਬੈ ਧਨ ਆਵੈ ॥੭॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਬਚਨ ਬਹੁਰਿ ਤਿਨ ਸਾਹ ਬਖਾਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਮ ਤੇ ਔਰ ਭਲੋ ਨਹਿ ਜਾਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੇਰੋ ਸਕਲ ਦਰਬੁ ਤੈ ਲੇਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਸਰਖਤ ਗੁਪਤ ਮੁਝੈ ਲਿਖਿ ਦੇਹਿ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਬੀਸ ਲਾਖ ਤਾ ਤੇ ਧਨ ਲਿਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਰਖਤ ਏਕ ਤਾਹਿ ਲਿਖਿ ਦਿਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਜੂ ਬੰਦ ਬੀਚ ਇਹ ਰਖਿਯਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਅਵਰ ਪੁਰਖ ਸੌ ਭੇਵ ਨ ਭਖਿਯਹੁ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਦੈ ਧਨ ਸਾਹ ਜਬੈ ਘਰ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਖ ਮਜੂਰਨ ਕੋ ਤਿਨ ਲਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਧਾਮ ਤਿਸੀ ਕੇ ਕਿਯਾ ਪਯਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਤਿਨ ਮੂੜ ਨ ਜਾਨਾ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਕਹੀ ਕਿ ਏਕ ਟੂਕ ਮੁਹਿ ਦੇਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਪਾਨ ਭਰਾਇਸ ਗਰਦਨਿ ਲੇਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਖਰਚ ਜਾਨਿ ਥੋਰੋ ਤਿਨ ਕਰੋ ॥",
      "s": 14
    }
  ]
}
