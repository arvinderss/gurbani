{
  "page": 1339,
  "lines": [
    {
      "t": "ਚੰਦ੍ਰਵਤੀ ਇਹ ਪੁਰੀ ਬਿਰਾਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਗ ਲੋਕ ਜਾ ਕੌ ਲਖਿ ਲਾਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਹੋਡ ਪਰੀ ਇਕ ਦਿਨ ਤਿਨ ਮਾਹ ॥",
      "s": 14
    },
    {
      "t": "ਬਚਨ ਕਹਾ ਤ੍ਰਿਯ ਸੌ ਲਰ ਨਾਹ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਐਸੀ ਕਵਨ ਜਗਤ ਮੈ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਨ ਨ ਸੁਨੀ ਨ ਨੈਨ ਨਿਹਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਪਤਿਹਿ ਢੋਲ ਕੀ ਢਮਕ ਸੁਨਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਜਾਰ ਸੌ ਭੋਗ ਕਮਾਵੈ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਕੇਤਕ ਦਿਨ ਬੀਤਤ ਜਬ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਯ ਕੌ ਬਚ ਸਿਮਰਨ ਹ੍ਵੈ ਗਏ ॥",
      "s": 14
    },
    {
      "t": "ਅਸ ਚਰਿਤ੍ਰ ਕਰਿ ਪਤਿਹਿ ਦਿਖਾਊਾਂ ॥",
      "s": 14
    },
    {
      "t": "ਭਜੌ ਜਾਰ ਅਰ ਢੋਲ ਬਜਾਊਾਂ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤੇ ਇਹੈ ਟੇਵ ਤਿਨ ਡਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਔਰਨ ਤ੍ਰਿਯ ਸੌ ਪ੍ਰਗਟ ਉਚਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਮੈ ਧਰਿ ਸੀਸ ਪਾਨਿ ਕੋ ਸਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਭਰਿ ਲ੍ਯੈਹੌ ਜਲ ਨ੍ਰਿਪ ਕੇ ਕਾਜਾ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਬਚਨ ਸੁਨਤ ਰਾਜਾ ਹਰਖਾਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੌ ਅਤਿ ਪਤਿਬ੍ਰਤਾ ਜਾਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਜੁ ਸਿਰ ਕੈ ਰਾਨੀ ਘਟ ਲ੍ਯਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਆਨਿ ਪਾਨਿ ਪੁਨਿ ਮੁਝੈ ਪਿਲਾਵੈ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਦਿਨ ਤ੍ਰਿਯ ਪਿਯ ਸੋਤ ਜਗਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਲੈ ਘਟ ਕੌ ਕਰ ਚਲੀ ਬਨਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਤੁਮ ਢੋਲ ਢਮਕ ਸੁਨਿ ਲੀਜੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਇਮਿ ਕਾਜ ਰਾਜ ਤੁਮ ਕੀਜੋ ॥੭॥",
      "v": [
        [
          3,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਪ੍ਰਥਮ ਸੁਨ੍ਯੋ ਸਭ ਢੋਲ ਬਜਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਨਿਯਹੁ ਰਾਨੀ ਡੋਲ ਧਸਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਤਿਯ ਢਮਾਕ ਸੁਨੋ ਜਬ ਗਾਢਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਨਿਯਹੁ ਤਰੁਨਿ ਕੂਪ ਤੇ ਕਾਢਾ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਤਹਿਕ ਲਹੌਰੀ ਰਾਇ ਭਨਿਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਸੰਗ ਤ੍ਰਿਯ ਕੋ ਹੇਤੁ ਕਹਿਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਲਯੋ ਤਿਸੀ ਕੋ ਤੁਰਤ ਮੰਗਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਭੋਗ ਕਿਯਾ ਅਤਿ ਰੁਚਿ ਉਪਜਾਇ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਥਮ ਜਾਰ ਜਬ ਧਕਾ ਲਗਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਰਾਨੀ ਲੈ ਢੋਲ ਬਜਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਤਿਹ ਲਿੰਗ ਸੁ ਭਗ ਤੇ ਕਾਢਾ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯ ਦਿਯ ਢੋਲ ਢਮਾਕਾ ਗਾਢਾ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਰਾਜੈ ਇਹ ਭਾਤਿ ਬਿਚਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਡੋਰਿ ਕੂਪ ਤੇ ਨਾਰਿ ਨਿਕਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਤ੍ਰਿਯ ਭੋਗ ਜਾਰ ਸੌ ਕੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜਾ ਸੁਨਤ ਦਮਾਮੋ ਦੀਨਾ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਥਮ ਜਾਰ ਸੌ ਭੋਗ ਕਮਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰੋ ਢੋਲ ਢਮਾਕ ਸੁਨਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਪ ਕ੍ਰਿਯਾ ਕਬਹੂੰ ਨ ਬਿਚਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਾ ਚਰਿਤ੍ਰ ਕਿਯਾ ਇਮ ਨਾਰੀ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਸਤਾਸੀ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੮੭॥੬੯੨੩॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਿੰਘ ਨਰਿੰਦਰ ਭੂਪ ਇਕ ਨ੍ਰਿਪ ਬਰ ॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪਬਰਵਤੀ ਨਗਰ ਜਾ ਕੋ ਘਰ ॥",
      "s": 14
    }
  ]
}
