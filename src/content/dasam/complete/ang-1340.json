{
  "page": 1340,
  "lines": [
    {
      "t": "ਸ੍ਰੀ ਮਦ ਮੋਕਲ ਦੇ ਤਿਹ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਧਿ ਸੁ ਨਾਰ ਸਾਚੇ ਜਨੁ ਢਾਰੀ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਦੇਹ ਕੁਰੂਪ ਭੂਪ ਕੌ ਭਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਜੁ ਤ੍ਰਿਯ ਸਾਥ ਨ ਰਾਖਤ ਪ੍ਯਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਰੈਨਿ ਦਿਵਸ ਜੋਗਿਯਨ ਬੁਲਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਜੋਗ ਸਾਧਨਾ ਚਹੈ ਕਿ ਆਵੈ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਤੇ ਨਾਰਿ ਅਧਿਕ ਰਿਸਿ ਠਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਤ ਜੋਗਿਯਨ ਕੀ ਅਸਿ ਬਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਐਸਾ ਕਛੂ ਉਪਾਇ ਬਨਾਊ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਪਤਿ ਸਹਿਤ ਅਜੁ ਇਨ ਘਾਊ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਦੇਉਾਂ ਆਪਨੋ ਮਿਤ੍ਰਹਿ ਰਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਜੋਗੀ ਹਨੌ ਭੂਪ ਜੁਤ ਆਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਕਲ ਪ੍ਰਜਹਿ ਇਨ ਮਾਰਿ ਦਿਖਾਊਾਂ ॥",
      "s": 14
    },
    {
      "t": "ਮਿਤ੍ਰ ਸੀਸ ਪਰ ਛਤ੍ਰ ਫਿਰਾਊਾਂ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਰਾਜਾ ਨਿਸ ਕੌ ਗ੍ਰਿਹ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਜੋਗਿਯਨ ਬੋਲਿ ਪਠਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਮਿ ਤਿਮਿ ਨਾਰਿ ਫਾਸ ਗਰ ਡਾਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਪ ਸਹਿਤ ਸਭ ਦਏ ਸੰਘਾਰ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਭੂਪਤਿ ਮਾਰਿ ਖਾਟ ਤਰ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਹੂੰ ਅਤੀਤਨ ਤਰੇ ਡਸਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਿੰਘਾਸਨ ਪਰ ਮਿਤ੍ਰਹਿ ਰਾਖਾ ॥",
      "s": 14
    },
    {
      "t": "ਬੋਲਿ ਪ੍ਰਜਾ ਸਭ ਸੋ ਇਮਿ ਭਾਖਾ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਰਾਜਾ ਨਿਸੁ ਕੌ ਗ੍ਰਿਹ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਹੂੰ ਜੋਗਿਯਨ ਨਿਕਟ ਬੁਲਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਤਭੁਤ ਨਾਗਾ ਤਹਾ ਇਕ ਨਿਕਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਵਲ ਹੇਰਿ ਤਵਨ ਕੌ ਬਿਗਸਾ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਸਾਪਹਿ ਮਾਰਿ ਤਬੈ ਤਿਨ ਲਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਫਰੂਆ ਬੀਚ ਡਾਰਿ ਕਰਿ ਦਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਘੋਟਿ ਭਾਗ ਜਿਮਿ ਦੁਹੂੰਅਨ ਪੀਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਤਿ ਅਸਥੂਲ ਦੇਹ ਕਹ ਕੀਯੋ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਅਧਿਕ ਫੂਲਿ ਜਬ ਗਏ ॥",
      "s": 14
    },
    {
      "t": "ਕੁੰਜਰ ਸੋ ਧਾਰਤ ਬਪੁ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਦ੍ਵੈ ਘਟਿਕਾ ਬੀਤੀ ਤਬ ਫੂਟੇ ॥",
      "s": 14
    },
    {
      "t": "ਆਵਨ ਜਾਨ ਜਗਤ ਤੇ ਛੂਟੇ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਬਰਖ ਬਾਰਹਨ ਕੇ ਹ੍ਵੈ ਗਏ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਯਾਗਤ ਦੇਹ ਪੁਰਾਤਨ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਵਰਗ ਲੋਕ ਕਹ ਕਿਯਾ ਪਯਾਨ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਯਾਗਿ ਆਪੁਨੀ ਦੇਹ ਪੁਰਾਨਿ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਭੂਪ ਨਿਰਖਿ ਚਕ੍ਰਿਤ ਚਿਤ ਰਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਮੁਹਿ ਸੇਤੀ ਐਸੀ ਬਿਧਿ ਕਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਹਮ ਤੁਮ ਆਵ ਸਾਪ ਦੋਊ ਖਾਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਹ ਧਰੇ ਸੁਰਪੁਰ ਕੋ ਜਾਹਿ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਯੌ ਕਹਿ ਕੈ ਨ੍ਰਿਪ ਸਾਪ ਚਬਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੈ ਡਰਤੇ ਨਹਿ ਤਾਹਿ ਹਟਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਥੋਰਾ ਭਖ੍ਰਯੋ ਉਡਾ ਨਹਿ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਤਨ ਸੁੰਦਰ ਇਹ ਭਯੋ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਦੇਹ ਪੁਰਾਤਨ ਤ੍ਯਾਗਨ ਕਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਔਖਧ ਬਲ ਨੌਤਨ ਤਨ ਧਰੀ ॥",
      "s": 14
    }
  ]
}
