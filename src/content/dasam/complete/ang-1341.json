  "lines": [
    {
      "t": "ਦੇਹ ਭੂਪ ਕੀ ਠੌਰ ਜਰਾਵਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਕੇ ਸਿਰ ਪਰ ਛਤ੍ਰ ਫਿਰਾਵਹੁ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਸਾਥ ਜੋਗਿਯਨ ਘਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਪਤਿ ਕੋ ਸੁਰ ਲੋਕ ਪਠਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਕਲ ਪ੍ਰਜਾ ਕੋ ਲੋਥਿ ਦਿਖਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਸ ਮਿਤ੍ਰ ਕੀ ਫੇਰਿ ਦੁਹਾਈ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਭੇਵ ਪ੍ਰਜਾ ਕਿਨਹੂੰ ਨ ਪਛਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਹ ਬਿਧਿ ਹਨਾ ਹਮਾਰਾ ਰਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਹ ਛਲ ਸੋ ਜੁਗਿਯਨ ਕੋ ਘਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮਿਤ੍ਰ ਸੀਸ ਪਰ ਛਤ੍ਰ ਫਿਰਾਯੋ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਗਰਬੀ ਰਾਇ ਸੁ ਮਿਤ੍ਰ ਕੋ ਦਿਯਾ ਆਪਨਾ ਰਾਜ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਜੋਗਨ ਜੁਤ ਰਾਜਾ ਹਨਾ ਕਿਯਾ ਆਪਨਾ ਕਾਜ ॥੧੬॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਅਠਾਸੀ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੮੮॥੬੯੩੯॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਪ ਸੁਬਾਹੁ ਸੈਨ ਇਕ ਸੁਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਰੂਪਵਾਨ ਸੁੰਦਰਿ ਬਹੁ ਗੁਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਸੁਬਾਹਪੁਰ ਤਾ ਕੋ ਸੋਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਸਮ ਔਰ ਨਗਰ ਨਹਿ ਕੋ ਹੈ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਮਕਰਧੁਜ ਦੇ ਤਿਹ ਰਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੁੰਦਰਿ ਦੇਸ ਦੇਸ ਮੌ ਜਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਸਮਾਨ ਨਾਰੀ ਨਹਿ ਕੋਊ ॥",
      "s": 14
    },
    {
      "t": "ਪਾਛੇ ਭਈ ਨ ਆਗੈ ਹੋਊ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਦੇਖਾ ਦਿਲੀ ਕੋ ਏਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਤੇ ਲਿਖਿ ਪਠਿਯੋ ਸੰਦੇਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਮ ਇਹ ਠੌਰ ਆਪੁ ਚੜਿ ਆਵਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਪਤਿ ਜੀਤਿ ਮੁਝੈ ਲੈ ਜਾਵਹੁ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਅਕਬਰ ਸੁਨਤ ਬੈਨ ਉਠਿ ਧਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪਵਨ ਹੁਤੇ ਆਗੇ ਬਢਿ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਹ ਸੁਨਾ ਆਯੋ ਨ੍ਰਿਪੁ ਜਬ ਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਪਤਿ ਸੌ ਬਚਨ ਬਖਾਨਾ ਤਬ ਹੀ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਤੁਮ ਹ੍ਯਾਂ ਤੇ ਨ੍ਰਿਪ ਭਾਜਿ ਨ ਜੈਯਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਰਨ ਸਾਮੁਹਿ ਹ੍ਵੈ ਜੁਧ ਮਚੈਯਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਮੈ ਨ ਤਜੌਗੀ ਤੁਮਰਾ ਸਾਥਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਰੇ ਜਰੋਗੀ ਤੁਮ ਸੌ ਨਾਥਾ ॥੫॥",
      "v": [
        [
          0,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤ ਭੂਪਤਿ ਕਹ ਧੀਰ ਬੰਧਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਉਤੈ ਲਿਖਾ ਲਿਖਿ ਤਹਾ ਪਠਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਆਈ ਸੈਨ ਸਾਹ ਕੀ ਜਬ ਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਰਹਾ ਉਪਾਇ ਕਛੂ ਨਹਿ ਤਬ ਹੀ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਰਾਜਾ ਜੂਝਿ ਮਰਤ ਭਯੋ ਜਬੈ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਜ ਚਲਤ ਭੀ ਪਰਜਾ ਤਬੈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਬਾਧਿ ਤਬੈ ਤਿਨ ਲਈ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਧਾਮ ਮਿਤ੍ਰ ਕੇ ਗਈ ॥੭॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਨਿਨਾਨਵੇ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੮੯॥੬੯੪੬॥ਅਫਜੂੰ॥",
