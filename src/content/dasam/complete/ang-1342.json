{
  "page": 1342,
  "lines": [
    {
      "t": "ਜਿਹ ਸਮਾਨ ਨਹਿ ਦੇਵ ਕੁਮਾਰੀ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਇਕ ਹੁਤਾ ਸਾਹ ਕਾ ਬੇਟਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਸਮਾਨ ਕੋ ਭਯੋ ਨ ਭੇਟਾ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਸੁਘਰ ਅਰੁ ਸੁੰਦਰ ਘਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁ ਅਵਤਾਰ ਮਦਨ ਕੋ ਬਨੋ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਭੂਪ ਸੁਤਾ ਤਿਹ ਨਿਰਖਿ ਲੁਭਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਗਿਰੀ ਭੂਮਿ ਜਨੁ ਨਾਗ ਚਬਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਖੀ ਏਕ ਤਿਹ ਤੀਰ ਪਠਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਗਾਜਿ ਰਾਇ ਕਹ ਲਿਯਾ ਬੁਲਾਈ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਤਿਹ ਲਖਾ ਸਜਨ ਘਰ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕੰਠ ਗੌਹਰਾ ਰਾਇ ਲਗਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁ ਬਿਧਿ ਕਰੇ ਤਵਨ ਸੌ ਭੋਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਦੂਰਿ ਕਰਾ ਜਿਯ ਕਾ ਸਭ ਸੋਗਾ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਭੋਗ ਕਰਤ ਭਾਯੋ ਅਤਿ ਪ੍ਯਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਛਿਨ ਨ ਕਰਤ ਆਪਨ ਤੇ ਨ੍ਯਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਕੀ ਕੈਫ ਪਿਲਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਭ੍ਰ ਸੇਜ ਚੜਿ ਭੋਗ ਕਮਾਵੈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤਹ ਤਾਤ ਤਵਨ ਕਾ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਸਤ ਦੇਗ ਮਹਿ ਤਾਹਿ ਛਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰੌਜਨ ਮੂੰਦਿ ਹੌਜ ਮਹਿ ਧਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਬੂੰਦ ਜਲ ਬੀਚ ਨ ਪਰਾ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਪਿਤਹਿ ਤਾਲ ਤਤਕਾਲ ਦਿਖਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬੀਚ ਬੇਰੀਯਨ ਡਾਰਿ ਫਿਰਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੀਏ ਜਰਾਇ ਬੀਚ ਤਿਹ ਡਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁ ਕਰਿ ਚੜੇ ਰੈਨਿ ਕੇ ਤਾਰੇ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਪਿਤਹਿ ਅਚੰਭਵ ਐਸ ਦਿਖਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਮਾਧਾਨ ਕਰਿ ਧਾਮ ਪਠਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮਿਤ੍ਰਹਿ ਕਾਢ ਸੇਜ ਪਰ ਲੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਬਹੁ ਬਿਧਿ ਤਨ ਕੀਨਾ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਨਬੇ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੯੦॥੬੯੫੪॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਰਬਰੀਨ ਕੋ ਦੇਸ ਬਸਤ ਜਹ ॥",
      "s": 14
    },
    {
      "t": "ਬਰਬਰ ਪੁਰ ਇਕ ਨਗਰ ਹੁਤੋ ਤਹ ॥",
      "s": 14
    },
    {
      "t": "ਅਫਕਨ ਸੇਰ ਤਹਾ ਕਾ ਰਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਸਮਾਨ ਬਿਧਿ ਦੁਤਿਯ ਨ ਸਾਜਾ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਪੀਰ ਮੁਹੰਮਦ ਤਹ ਇਕ ਕਾਜੀ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਹ ਕੁਰੂਪ ਨਾਥ ਜਿਹ ਸਾਜੀ ॥",
      "s": 14
    },
    {
      "t": "ਧਾਮ ਖਾਤਿਮਾ ਬਾਨੋ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਸਮਾਨ ਨਹਿ ਰਾਜ ਦੁਲਾਰੀ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਸੋਰਠਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੁੰਦਰ ਤਾ ਕੀ ਨਾਰਿ ਅਤਿ ਕੁਰੂਪ ਕਾਜੀ ਰਹੈ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤਬ ਤਿਨ ਕਿਯਾ ਬਿਚਾਰਿ ਕਿਹ ਬਿਧਿ ਬਧ ਯਾ ਕੌ ਕਰੋ ॥੩॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਹ ਪੁਤ੍ਰ ਤਿਹ ਪੁਰ ਇਕ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਕੇ ਰਾਇ ਸਰੂਪ ਸਵਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਜੀ ਕੀ ਇਸਤ੍ਰੀ ਤਿਹ ਲਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਰੌ ਇਸੀ ਕਹ ਚਿਤ ਯੌ ਕਹਾ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਮੁਸਲਮਾਨ ਬਹੁ ਧਾਮ ਬੁਲਾਵਤ ॥",
      "s": 14
    }
  ]
}
