{
  "page": 1347,
  "lines": [
    {
      "t": "ਮਥਹੁ ਜਾਨਵੀ ਹੋਤ ਸਵਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਤੇ ਜੁ ਨਰ ਨਿਕਸਿ ਹੈ ਕੋਈ ॥",
      "s": 14
    },
    {
      "t": "ਭਰਤਾ ਹੋਇ ਹਮਾਰੋ ਸੋਈ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਬਚਨ ਸੁਨਤ ਰਾਜਾ ਹਰਖਾਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਚੁ ਝੂਠੁ ਜੜ ਕਛੁ ਨ ਪਛਾਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਜੋਰਿ ਪ੍ਰਜਾ ਦੈ ਢੋਲ ਨਗਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਚਲੇ ਸੁਰਸੁਰੀ ਮਥਨ ਸਕਾਰੇ ॥੧੬॥",
      "s": 14
    },
    {
      "t": "ਬਡੇ ਦ੍ਰੁਮਨ ਕੀ ਮਥਨਿ ਸੁਧਾਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਮਥਤ ਭਏ ਸੁਰਸਰਿ ਮੋ ਡਾਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਤਨਿਕ ਬਾਰਿ ਕਹ ਜਬੈ ਡੁਲਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਕਸਿ ਪੁਰਖ ਤਹ ਤੇ ਇਕ ਆਯੋ ॥੧੭॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਿ ਸਜਨ ਕੋ ਰੂਪ ਅਪਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਰਤ ਭਈ ਤਿਹ ਰਾਜ ਕੁਮਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਪਸੁ ਕਛੁ ਨ ਬਿਚਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਨਾਰਿ ਜਾਰ ਕਹ ਬਰਿਯੋ ॥੧੮॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਬਿਧਿ ਤੇ ਮਥਿ ਨੀਰਧਹਿ ਲਛਮੀ ਬਰੀ ਮੁਰਾਰਿ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤਸਹਿ ਮਥਿ ਗੰਗਾ ਬਰਾ ਯਾ ਕਹ ਰਾਜ ਕੁਮਾਰਿ ॥੧੯॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਚੌਰਾਨਵੇ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੯੪॥੭੦੧੫॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਰਬ ਸਿੰਘ ਰਾਜਾ ਇਕ ਸੋਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਸਰਬ ਸਿੰਧੁ ਪੁਰ ਗੜ ਜਿਹ ਕੋ ਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਦਲ ਥੰਭੁ ਸੁਜਾਨ ਪੁਤ੍ਰ ਤਿਹ ॥",
      "s": 14
    },
    {
      "t": "ਸੁੰਦਰ ਅਵਰ ਨ ਭਯੋ ਤੁਲਿ ਜਿਹ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਦੁਸਟ ਸਿੰਘ ਤਾ ਕੌ ਭ੍ਰਾਤਾ ਭਨਿ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਤਿਯ ਚੰਦ੍ਰ ਜਾਨਾ ਸਭ ਲੋਗਨ ॥",
      "s": 14
    },
    {
      "t": "ਰੂਪਵਾਨ ਗੁਨਵਾਨ ਭਨਿਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਵਨ ਸੁਘਰ ਸਮ ਤਾਹਿ ਕਹਿਜੈ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਸੁਜੁਲਫ ਦੇ ਸਾਹ ਦੁਲਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਸਮਾਨ ਨਹਿ ਦੇਵ ਕੁਮਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਕੁਅਰਿ ਨਿਰਖਾ ਤਿਹ ਜਬ ਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਲਗਗੀ ਲਗਨ ਨਿਗੌਡੀ ਤਬ ਹੀ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਹਿਤੂ ਜਾਨਿ ਸਹਚਰੀ ਬੁਲਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਭਾਖਿ ਤਿਹ ਠੌਰ ਪਠਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਕੁਅਰ ਤਿਹ ਹਾਥ ਨ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਉਹਿ ਇਹ ਆਨਿ ਸੁਨਾਯੋ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਸਾਹੁ ਸੁਤਾ ਬਹੁ ਜਤਨ ਥਕੀ ਕਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਗਯੋ ਨ ਮੀਤ ਕੈਸੇਹੂੰ ਤਿਹ ਘਰ ॥",
      "s": 14
    },
    {
      "t": "ਬੀਰ ਹਾਕਿ ਇਕ ਤਹਾ ਪਠਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੋਤ ਸੇਜ ਤੇ ਗਹਿ ਪਟਕਾਯੋ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਟੰਗਰੀ ਭੂਤ ਕਬੈ ਗਹਿ ਲੇਈ ॥",
      "s": 14
    },
    {
      "t": "ਕਬਹੂੰ ਡਾਰਿ ਸੇਜ ਪਰ ਦੇਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਤ੍ਰਾਸ ਦੇ ਤਾਹਿ ਪਛਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਉਹਿ ਡਰਿ ਜਿਯ ਤੇ ਮਾਰਿ ਨ ਡਾਰਾ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਰੈਨਿ ਸਿਗਰ ਤਿਹ ਸੋਨ ਨ ਦਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਸੁਤ ਕਹ ਤ੍ਰਾਸਿਤ ਬਹੁ ਕਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਚਲੀ ਖਬਰਿ ਰਾਜਾ ਪ੍ਰਤਿ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਤ ਨਾਸ ਕਰ ਲਏ ਬੁਲਾਈ ॥੭॥",
      "s": 14
    }
  ]
}
