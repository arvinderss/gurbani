{
  "page": 1348,
  "lines": [
    {
      "t": "ਭੂਤ ਹਤਾ ਇਕ ਮੰਤ੍ਰ ਉਚਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਬੀਸ ਮੰਤ੍ਰ ਪੜਿ ਬੀਰ ਪੁਕਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਸਹੂੰ ਪਕਰਿ ਚੀਰਿ ਕਰਿ ਦੇਈ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਹੂੰ ਪਕਰਿ ਰਾਨ ਤਰ ਲੇਈ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਸਭ ਸਕਲ ਮੰਤ੍ਰ ਕਰਿ ਹਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਇਹ ਬਿਧਿ ਤਨ ਬੀਰ ਪੁਕਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਜੇ ਗੁਰ ਮੋਰ ਇਹਾ ਚਲਿ ਆਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਕੁਅਰ ਤਬ ਹੀ ਸੁਖ ਪਾਵੈ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਤ ਬਚਨ ਰਾਜਾ ਪਗ ਪਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁ ਉਸਤਤਿ ਕਰਿ ਬਚਨ ਉਚਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਾ ਤੋਰ ਗੁਰ ਮੋਹਿ ਬਤੈਯੈ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਜਿਹ ਤਿਹ ਭਾਤਿ ਤਾਹਿ ਹ੍ਯਾਂ ਲ੍ਯੈਯੈ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਜਵਨ ਪੁਰਖ ਕਾ ਨਾਮ ਬਤਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਰਿ ਤਿਸੀ ਕਾ ਭੇਸ ਬਨਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪਹਿ ਠੌਰ ਭਾਖਤ ਭਯੋ ਜਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਬੈਠੀ ਜਾਹਿ ਚੰਚਲਾ ਤਹਾ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਬਚਨ ਸੁਨਤ ਤਹ ਭੂਪ ਸਿਧਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹੀ ਰੂਪ ਤਰ ਪੁਰਖ ਨਿਹਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਤਿਹ ਬਿਧ ਤਾ ਕੌ ਬਿਰਮਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਪੁਨੇ ਧਾਮ ਤਾਹਿ ਲੈ ਆਯੋ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਕੁਅਰ ਤਾ ਕਹ ਦਰਸਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਚਨ ਤਾਹਿ ਇਹ ਭਾਤਿ ਸੁਨਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਯੌ ਇਹ ਤ੍ਰਿਯ ਪਤਿਬ੍ਰਤਾ ਬਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਊ ਬਚੈ ਯਹ ਯੌ ਨ ਉਬਰੈ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਕਰਤ ਕਰਤ ਬਹੁ ਬਚਨ ਬਤਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਹੁ ਸੁਤਾ ਕੇ ਨਾਮੁ ਜਤਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਪਤਿਬ੍ਰਤਾ ਤਾਹਿ ਬਿਵਾਵਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਜੌ ਨ੍ਰਿਪ ਸੁਤਹਿ ਜਿਯਾਯੋ ਚਾਹਹੁ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਜੌ ਯਹ ਤਾਹਿ ਬ੍ਯਾਹਿ ਲ੍ਯਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਰੈਨਿ ਦਿਵਸ ਤਾ ਸੋ ਲਪਟਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਅਵਰ ਨਾਰਿ ਕੇ ਨਿਕਟ ਨ ਜਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਯਹ ਜਿਯੈ ਕੁਅਰ ਸੁਭ ਕਾਇ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਯਹੈ ਕਾਰ ਰਾਜਾ ਤੁਮ ਕੀਜੈ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਅਬ ਹੀ ਹਮਹਿ ਬਿਦਾ ਕਰਿ ਦੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਲੈ ਆਗ੍ਯਾ ਤਿਹ ਆਸ੍ਰਮ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਧਾਰਤ ਭੇਸ ਨਾਰਿ ਕਾ ਭਈ ॥੧੬॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਸਾਜ ਬ੍ਯਾਹ ਕੌ ਬਨਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਹ ਸੁਤਾ ਹਿਤ ਪੂਤ ਪਠਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਹੀ ਬ੍ਯਾਹ ਤਵਨ ਸੌ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਹੀ ਤਾਹਿ ਭੂਤ ਤਜਿ ਗਯੋ ॥੧੭॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਕੁਅਰ ਇਹ ਛਲ ਸੌ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਨ ਕਿਸੀ ਬਤਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਚੰਚਲਾਨ ਕੇ ਚਰਿਤ ਅਪਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਚਕ੍ਰਿਤ ਰਹਾ ਕਰਿ ਕਰਿ ਕਰਤਾਰਾ ॥੧੮॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਪਚਾਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੯੫॥੭੦੩੩॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਿਥੀ ਸਿੰਘ ਇਕ ਭੂਪ ਬਖਨਿਯਤ ॥",
      "s": 14
    },
    {
      "t": "ਪਿਰਥੀ ਪੁਰ ਤਿਹ ਨਗਰ ਪ੍ਰਮਨਿਯਤ ॥",
      "s": 14
    }
  ]
}
