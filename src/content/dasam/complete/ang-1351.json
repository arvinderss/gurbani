      "s": 14
    },
    {
      "t": "ਨਿਜੁ ਪਤਿ ਕੋ ਨਿਜੁ ਕਰ ਬਧ ਕਰਿ ਹੌ ॥",
      "s": 14
    },
    {
      "t": "ਆਪਨ ਸਾਥ ਪ੍ਰਗਟ ਤੁਹਿ ਲਿਐਹੌ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਤ ਪਿਤਾ ਤੁਹਿ ਲਖਤ ਹੰਢੈਹੌ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਨਿਜੁ ਪਤਿ ਲੈ ਸਿਵ ਭਵਨ ਸਿਧਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਟਾ ਮੂੰਡ ਤਹਾ ਤਿਹ ਜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਲੋਗਨ ਕਹਿ ਸਿਵ ਨਾਮ ਸੁਨਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰੂਪ ਹੇਤੁ ਪਤਿ ਸੀਸ ਚੜਾਯੋ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਪੁਨਿ ਸਿਵ ਅਧਿਕ ਕ੍ਰਿਪਾ ਕਹ ਕਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੁੰਦਰ ਮੋਰ ਪਤਿਹਿ ਕਰ ਦਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕੌਤਕ ਲਖਾ ਕਹਾ ਤਿਨ ਕਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਿਵ ਪ੍ਰਤਾਪ ਹਮ ਆਜੁ ਬਿਚਰਾ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਦੇਹ ਮ੍ਰਿਤਕ ਪਤਿ ਦਈ ਦਬਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੌ ਨਾਥ ਭਾਖਿ ਗ੍ਰਿਹ ਲ੍ਯਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਨ ਕਿਨਹੂੰ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਨੁ ਪਾਨੀ ਹੀ ਮੂੰਡ ਮੁੰਡਾਯੋ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਨਿਨ੍ਰਯਾਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੯੯॥੭੦੭੨॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੂਰਜ ਕਿਰਨਿ ਇਕ ਭੂਪ ਭਨਿਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਚੰਦ ਕਿਰਨ ਪੁਰ ਨਗਰ ਕਹਿਜੈ ॥",
      "s": 14
