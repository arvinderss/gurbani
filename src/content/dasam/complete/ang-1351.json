    {
      "t": "ਘਾਟਮ ਪੁਰ ਇਕ ਭੂਪ ਭਨਿਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਰਿ ਅਲੰਕ੍ਰਿਤ ਦੇਇ ਕਹਿਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਤਾ ਸੁ ਭੂਖਨ ਦੇ ਘਰ ਤਾ ਕੇ ॥",
      "s": 14
    },
    {
      "t": "ਨਰੀ ਨਾਗਰੀ ਤੁਲਿ ਨ ਵਾ ਕੇ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਅਤਿ ਕੁਰੂਪ ਤਿਹ ਨਾਥ ਪਛਨਿਯਤ ॥",
      "s": 14
    },
    {
      "t": "ਅਤਿ ਸੁੰਦਰਿ ਜਿਹ ਨਾਰਿ ਬਖਨਿਯਤ ॥",
      "s": 14
    },
    {
      "t": "ਸੁੰਦਰ ਅਵਰ ਹੁਤੋ ਤਹ ਛਤ੍ਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਰੂਪਵਾਨ ਗੁਨਵਾਨ ਧਰਤ੍ਰੀ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਅੜਿਲ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਮੁਲਤਾਨੀ ਰਾਇ ਕੁਅਰਿ ਲਖਿ ਪਾਇਯੋ ॥",
