{
  "page": 1352,
  "lines": [
    {
      "t": "ਮਹਾ ਕੁਅਰਿ ਤਿਹ ਧਾਮ ਦੁਲਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਸਮਾਨ ਬਿਧਿ ਕਹੂੰ ਨ ਸਵਾਰੀ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਤਹਿਕ ਸਾਹ ਕੋ ਪੂਤ ਸੁਜਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਚੰਦ੍ਰ ਸੈਨ ਨਾਮਾ ਬਲਵਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਕੁਅਰਿ ਵਾ ਕੀ ਛਬਿ ਲਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਮਨ ਕ੍ਰਮ ਬਚਨ ਥਕਿਤ ਹ੍ਵੈ ਰਹੀ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਪਠੈ ਸਹਚਰੀ ਲਿਯੋ ਬੁਲਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਪੋਸਤ ਭਾਗ ਅਫੀਮ ਮੰਗਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਤਾਹਿ ਪਿਵਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਮਤ ਕਰਿ ਗਰੈ ਲਗਾਯੋ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਮਤ ਕਿਯਾ ਮਦ ਸਾਥ ਪ੍ਯਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਬਹੂੰ ਕਰਤ ਨ ਉਰ ਸੌ ਨ੍ਯਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਉਰ ਸੌ ਲਪਟਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਚੂੰਬਿ ਕਪੋਲ ਦੋਊ ਬਲਿ ਜਾਵੈ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਰਸਿ ਗਯੋ ਮੀਤ ਨ ਛੋਰਾ ਜਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਭੋਗਤ ਲਪਟਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਚੁੰਬਨ ਔਰ ਅਲਿੰਗਨ ਲੇਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਨਿਕ ਭਾਤਿ ਤਨ ਆਸਨ ਦੇਈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਰਸਿ ਗਈ ਤਾ ਕੌ ਤਜਾ ਨ ਜਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਅਨਿਕ ਲਪਟਤ ਸੁਖ ਪਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਸੰਗ ਕਹਾ ਕਵਨ ਬਿਧਿ ਜਾਊਾਂ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਅਬ ਅਸ ਕਵਨ ਉਪਾਇ ਬਨਾਊਾਂ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਜਾਨਿ ਬੂਝਿ ਇਕ ਦਿਜ ਕਹ ਮਾਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਪ ਭਏ ਇਮਿ ਕਹਾ ਸੁਧਾਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਮੈ ਜਾਇ ਕਰਵਤਹਿ ਲੈ ਹੌ ॥",
      "s": 14
    },
    {
      "t": "ਪਲਟਿ ਦੇਹ ਸੁਰਪੁਰਹਿ ਸਿਧੈ ਹੌ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਹੋਰਿ ਰਹਾ ਪਿਤੁ ਏਕ ਨ ਮਾਨੀ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਰਾਨੀਹੂੰ ਪਾਇਨ ਲਪਟਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਮੰਤ੍ਰ ਸਕਤਿ ਕਰਵਤਿ ਸਿਰ ਧਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਰੋਮ ਤਿਹ ਤਾਹਿ ਨ ਹਰਾ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਸਭਨ ਲਹਾ ਕਰਵਤਿ ਇਹ ਲਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਦ੍ਰਿਸਟਿ ਬੰਦ ਐਸਾ ਤਿਨ ਕਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਆਪਨ ਗਈ ਮਿਤ੍ਰ ਕੇ ਧਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਨ ਲਖਾ ਕਿਸੂ ਕਿਹ ਬਾਮਾ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਛਲਿ ਪਿਤੁ ਮਾਤ ਕਹ ਗਈ ਮਿਤ੍ਰ ਕੇ ਸੰਗ ॥",
      "v": [
        [
          5,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਕਬਿ ਸ੍ਯਾਮ ਪੂਰਨ ਭਯੋ ਤਬ ਹੀ ਕਥਾ ਪ੍ਰਸੰਗ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਚਾਰ ਸੌ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੪੦੦॥੭੦੮੨॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਪਾਤਿਸਾਹ ਕਾਰੂੰ ਇਕ ਸੁਨਿਯਤ ॥",
      "s": 14
    },
    {
      "t": "ਅਮਿਤ ਤੇਜ ਜਾ ਕੋ ਜਗ ਗੁਨਿਯਤ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਧਨ ਭਰੇ ਚਿਹਲ ਭੰਡਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਆਵਤ ਜਿਨ ਕਾ ਪਾਰ ਨ ਵਾਰਾ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਪੁਰ ਸਾਹ ਸੁਤਾ ਇਕ ਸੁਨਿਯਤ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨੁਕ ਚਿਤ੍ਰ ਪੁਤ੍ਰਕਾ ਗੁਨਿਯਤ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖ ਭੂਪ ਕਾ ਰੂਪ ਲੁਭਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਸਹਚਰੀ ਤਹਾ ਪਠਾਈ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਕੁਅਰਿ ਬਸੰਤ ਤਵਨਿ ਕਾ ਨਾਮਾ ॥",
      "s": 14
    }
  ]
}
