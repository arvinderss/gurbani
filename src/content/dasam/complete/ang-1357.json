{
  "page": 1357,
  "lines": [
    {
      "t": "ਨਾਰਦ ਰਿਖਿ ਤਬ ਰਾਇ ਮੰਗਾਯੋ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਦੇਵਨ ਕੋ ਰਾਜਾ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬ੍ਰਹਮਾ ਤਿਲਕ ਆਪੁ ਤਿਹ ਦਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਹਕੰਟਕ ਸੁਰ ਕਟਕ ਕਿਯਾ ਸਬ ॥",
      "s": 14
    },
    {
      "t": "ਦਾਨਵ ਮਾਰ ਨਿਕਾਰ ਦਏ ਜਬ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਰਾਜ ਬਰਖ ਬਹੁ ਕਿਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਦੀਰਘ ਦਾੜ ਦੈਤ ਭਵ ਲਿਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਦਸ ਸਹਸ ਛੂਹਨਿ ਦਲ ਲੈ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਚੜਿ ਆਯੋ ਤਿਹ ਊਪਰ ਤੈ ਕੈ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਦੇਵਨ ਐਸੇ ਸੁਨਿ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੀਰਘ ਦਾੜ ਦੈਤ ਚੜਿ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬੀਸ ਸਹਸ ਛੋਹਨਿ ਦਲ ਲਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਵਾ ਸੌ ਜਾਇ ਸਮਾਗਮ ਕਿਯੋ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਸੂਰਜ ਕਹ ਸੈਨਾਪਤਿ ਕੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਦਹਿਨੇ ਓਰ ਚੰਦ੍ਰ ਕਹ ਦੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਈ ਓਰ ਕਾਰਤਿਕੇ ਧਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਪੌਰਖ ਕਿਨਹੂੰ ਨਹਿ ਹਰਾ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਦਿਸ ਸਕਲ ਦੇਵ ਚੜਿ ਧਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਉਹਿ ਦਿਸਿ ਤੇ ਦਾਨਵ ਮਿਲਿ ਆਏ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਜਨ ਭਾਤਿ ਭਾਤਿ ਤਨ ਬਾਜੇ ॥",
      "s": 14
    },
    {
      "t": "ਦੋਊ ਦਿਸਿਨ ਸੂਰਮਾ ਗਾਜੇ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਦੈ ਦੈ ਢੋਲ ਬਜਾਇ ਨਗਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਪੀ ਪੀ ਭਏ ਕੈਫ ਮਤਵਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਤੀਸ ਸਹਸ ਛੋਹਨਿ ਦਲ ਸਾਥਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਨ ਦਾਰੁਨੁ ਰਾਚਾ ਜਗਨਾਥਾ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਮਾਰੂ ਜਬ ਬਾਜੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੀਰਘ ਦਾੜ ਦੈਤ ਰਨ ਗਾਜੋ ॥",
      "s": 14
    },
    {
      "t": "ਤੀਛਨ ਬਾਨ ਦੋਊ ਦਿਸਿ ਬਹਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਹਿ ਲਗਤ ਤਿਹ ਮਾਝ ਨ ਰਹਹੀ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਧਾਵਤ ਭਏ ਦੇਵਤਾ ਜਬ ਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਦਾਨਵ ਭਰੇ ਰੋਸ ਤਨ ਤਬ ਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਬਾਦਿਤ੍ਰ ਬਜਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਖਤ੍ਰੀ ਉਠੇ ਖਿੰਗ ਖੁਨਸਾਇ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਚਲੇ ਬਾਨ ਦੁਹੂੰ ਓਰ ਅਪਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਛੂਆ ਬਰਛੀ ਬਜ੍ਰ ਹਜਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਗਦਾ ਗਰਿਸਟ ਜਵਨ ਪਰ ਝਰਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਯੰਦਨ ਸਹਿਤ ਚੂਰਨ ਤਿਹ ਕਰਹੀ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੇ ਲਗੇ ਅੰਗ ਮੈ ਬਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਰਾ ਬੀਰ ਤਿਹ ਸ੍ਵਰਗ ਪਯਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਚ੍ਯੋ ਬੀਰ ਖੇਤ ਬਿਕਰਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਚਤ ਭੂਤ ਪ੍ਰੇਤ ਬੇਤਾਲਾ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਝੂਮਿ ਝੂਮਿ ਕਹੀ ਗਿਰੇ ਧਰਿਨ ਭਟ ॥",
      "s": 14
    },
    {
      "t": "ਜੁਦੇ ਜੁਦੇ ਕਹੀ ਅੰਗ ਪਰੇ ਕਟਿ ॥",
      "s": 14
    },
    {
      "t": "ਚਲੀ ਸ੍ਰੋਨ ਕੀ ਨਦੀ ਬਿਰਾਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਬੈਤਰੁਨੀ ਜਿਨ ਕੋ ਲਖਿ ਲਾਜੈ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਦਿਸਿ ਅਧਿਕ ਦੇਵਤਾ ਕੋਪੇ ॥",
      "s": 14
    },
    {
      "t": "ਉਹਿ ਦਿਸਿ ਪਾਵ ਦਾਨਵਨ ਰੋਪੇ ॥",
      "s": 14
    },
    {
      "t": "ਕੁਪਿ ਕੁਪਿ ਅਧਿਕ ਹ੍ਰਿਦਨ ਮੋ ਭਿਰੇ ॥",
      "s": 14
    }
  ]
}
