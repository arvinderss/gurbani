{
  "page": 1360,
  "lines": [
    {
      "t": "ਸਾਜੇ ਸਸਤ੍ਰ ਚੰਚਲਾ ਤਬ ਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਰਨ ਕੌ ਚਲੀ ਸਾਥ ਲੈ ਸਬ ਹੀ ॥੩੬॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਹਾ ਸਤ੍ਰੁ ਕੋ ਪੁਰ ਹੁਤੋ ਤਿਤ ਕਹ ਕਿਯਾ ਪਯਾਨ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਬਿਕਟ ਅਸੁਰ ਕੋ ਬੇੜਿ ਗੜ ਦਹਦਿਸ ਦਿਯੋ ਨਿਸਾਨ ॥੩੭॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਦੁੰਦਭਿ ਸੁਨਾ ਸ੍ਰਵਨ ਮਹਿ ਜਬ ਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਗਾ ਅਸੁਰ ਕੋਪ ਕਰਿ ਤਬ ਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਐਸਾ ਕਵਨ ਜੁ ਹਮ ਪਰ ਆਯੋ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਰਕਤ ਬਿੰਦ ਮੈ ਰਨਹਿ ਹਰਾਯੋ ॥੩੮॥",
      "s": 14
    },
    {
      "t": "ਇੰਦ੍ਰ ਚੰਦ੍ਰ ਸੂਰਜ ਹਮ ਜੀਤਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਵਨ ਜਿਤਾ ਹਰੀ ਜਿਨ ਸੀਤਾ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਏਕ ਦਿਵਸ ਮੋ ਸੌ ਸਿਵ ਲਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਭਜਾਯੋ ਮੈ ਨਹਿ ਟਰਾ ॥੩੯॥",
      "s": 14
    },
    {
      "t": "ਸਸਤ੍ਰ ਸਾਜ ਦਾਨਵ ਰਨ ਆਵਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਮਿਤ ਕੋਪ ਕਰਿ ਸੰਖ ਬਜਾਵਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਪੀ ਭੂਮ ਗਗਨ ਘਹਰਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਤੁਲ ਬੀਰਜ ਕਿਹ ਓਰ ਰਿਸਾਨਾ ॥੪੦॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਦਿਸਿ ਦੂਲਹ ਦੇਈ ਕੁਮਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਸਸਤ੍ਰ ਸਾਜਿ ਰਥਿ ਕਰੀ ਸਵਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਸਸਤ੍ਰਨ ਕਰਿ ਪ੍ਰਨਾਮ ਤਿਹ ਕਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਛਾਡਤ ਭੀ ਰਨ ਬਿਸਿਖ ਕਰਾਲਾ ॥੪੧॥",
      "s": 14
    },
    {
      "t": "ਲਗੇ ਬਿਸਿਖ ਜਬ ਅੰਗ ਕਰਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਦਾਨਵ ਭਰੇ ਕੋਪ ਤਬ ਭਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਮੁਖ ਤੇ ਸ੍ਵਾਸ ਸ੍ਰਮਿਤ ਹ੍ਵੈ ਕਾਢੇ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਤੇ ਅਮਿਤ ਅਸੁਰ ਰਨ ਬਾਢੇ ॥੪੨॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਕਾ ਬਾਲ ਬਹੁਰਿ ਬਧ ਕਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਉਨ ਕਾ ਸ੍ਰੋਨ ਪ੍ਰਿਥੀ ਪਰ ਪਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਗਨਿਤ ਬਢੇ ਤਬੈ ਤਹ ਦਾਨਵ ॥",
      "s": 14
    },
    {
      "t": "ਭਛਤ ਭਏ ਪਕਰਿ ਕਰਿ ਮਾਨਵ ॥੪੩॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਅਬਲਾ ਕੇ ਸੁਭਟ ਚਬਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਦੂਲਹ ਦੇ ਤਿਹ ਬਿਸਿਖ ਲਗਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਬੁੰਦਕਾ ਪਰਤ ਸ੍ਰੋਨ ਭੂਅ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਉਪਜਿ ਅਸੁਰ ਸਾਮਹਿ ਉਠਿ ਧਏ ॥੪੪॥",
      "s": 14
    },
    {
      "t": "ਪੁਨਿ ਅਬਲਾ ਤਿਨ ਬਿਸਿਖ ਪ੍ਰਹਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਚਲੇ ਸ੍ਰੋਨ ਕੇ ਤਹਾ ਪਨਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਅਸੁਰ ਅਨੰਤ ਤਹਾ ਤੇ ਜਾਗੇ ॥",
      "s": 14
    },
    {
      "t": "ਜੂਝਤ ਭਏ ਪੈਗ ਨਹਿ ਭਾਗੇ ॥੪੫॥",
      "s": 14
    },
    {
      "t": "ਭੁਜੰਗ ਛੰਦ ॥",
      "s": 14
    },
    {
      "t": "ਜਬੈ ਓਰ ਚਾਰੌ ਉਠੇ ਦੈਤ ਬਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਕਏ ਕੋਪ ਗਾੜੋ ਲਏ ਧੂਲਿਧਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਤੇ ਮੂੰਡ ਮੁੰਡੇ ਕਿਤੇ ਅਰਧ ਮੁੰਡੇ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਤੇ ਕੇਸ ਧਾਰੀ ਸਿਪਾਹੀ ਪ੍ਰਚੰਡੇ ॥੪੬॥",
      "s": 14
    },
    {
      "t": "ਜਿਤੇ ਦੈਤ ਉਠੇ ਤਿਤੇ ਬਾਲ ਮਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਵੁਠੇ ਆਨਿ ਬਾਨਾਨਿ ਬਾਕੇ ਡਰਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਤੇ ਸ੍ਵਾਸ ਛੋਰੈ ਉਠੈ ਦੈਤ ਭਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਹਠੀ ਮਾਰ ਹੀ ਮਾਰਿ ਕੈ ਕੈ ਪਧਾਰੇ ॥੪੭॥",
      "s": 14
    },
    {
      "t": "ਕਿਤੇ ਕੋਪ ਕੈ ਬੀਰ ਬਾਲਾ ਸੰਘਾਰੇ ॥",
      "s": 14
    }
  ]
}
