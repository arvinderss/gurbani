{
  "page": 1364,
  "lines": [
    {
      "t": "ਇਹ ਬਿਧਿ ਸਭੈ ਪੁਕਾਰਤ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁ ਕਰ ਲੂਟਿ ਬਨਿਕ ਸੇ ਲਏ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਾਹਿ ਤ੍ਰਾਹਿ ਹਮ ਸਰਨ ਤਿਹਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਭੈ ਤੇ ਹਮ ਲੇਹੁ ਉਬਾਰੀ ॥੯੦॥",
      "s": 14
    },
    {
      "t": "ਤੁਮ ਹੋ ਸਕਲ ਲੋਕ ਸਿਰਤਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਗਰਬਨ ਗੰਜ ਗਰੀਬ ਨਿਵਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਆਦਿ ਅਕਾਲ ਅਜੋਨਿ ਬਿਨਾ ਭੈ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਬਿਕਾਰ ਨਿਰਲੰਬ ਜਗਤ ਮੈ ॥੯੧॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਬਿਕਾਰ ਨਿਰਜੁਰ ਅਬਿਨਾਸੀ ॥",
      "s": 14
    },
    {
      "t": "ਪਰਮ ਜੋਗ ਕੇ ਤਤੁ ਪ੍ਰਕਾਸੀ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰੰਕਾਰ ਨਵ ਨਿਤ੍ਯ ਸੁਯੰਭਵ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਤ ਮਾਤ ਜਹ ਜਾਤ ਨ ਬੰਧਵ ॥੯੨॥",
      "s": 14
    },
    {
      "t": "ਸਤ੍ਰੁ ਬਿਹੰਡ ਸੁਰਿਦਿ ਸੁਖਦਾਇਕ ॥",
      "s": 14
    },
    {
      "t": "ਚੰਡ ਮੁੰਡ ਦਾਨਵ ਕੇ ਘਾਇਕ ॥",
      "s": 14
    },
    {
      "t": "ਸਤਿ ਸੰਧਿ ਸਤਿਤਾ ਨਿਵਾਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਤ ਭਵਿਖ ਭਵਾਨ ਨਿਰਾਸਾ ॥੯੩॥",
      "s": 14
    },
    {
      "t": "ਆਦਿ ਅਨੰਤ ਅਰੂਪ ਅਭੇਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਘਟ ਘਟ ਭੀਤਰ ਕੀਯਾ ਪ੍ਰਵੇਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਅੰਤਰ ਬਸਤ ਨਿਰੰਤਰ ਰਹਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਨਕ ਸਨੰਦ ਸਨਾਤਨ ਕਹਈ ॥੯੪॥",
      "s": 14
    },
    {
      "t": "ਆਦਿ ਜੁਗਾਦਿ ਸਦਾ ਪ੍ਰਭੁ ਏਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਧਰਿ ਧਰਿ ਮੂਰਤਿ ਫਿਰਤਿ ਅਨੇਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਜਗ ਕਹ ਇਹ ਬਿਧਿ ਭਰਮਾਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਆਪੇ ਏਕ ਅਨੇਕ ਦਿਖਾਯਾ ॥੯੫॥",
      "s": 14
    },
    {
      "t": "ਘਟ ਘਟ ਮਹਿ ਸੋਇ ਪੁਰਖ ਬ੍ਯਾਪਕ ॥",
      "s": 14
    },
    {
      "t": "ਸਕਲ ਜੀਵ ਜੰਤਨ ਕੇ ਥਾਪਕ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਤੇ ਜੋਤਿ ਕਰਤ ਆਕਰਖਨ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕਹ ਕਹਤ ਮ੍ਰਿਤਕ ਜਗ ਕੇ ਜਨ ॥੯੬॥",
      "s": 14
    },
    {
      "t": "ਤੁਮ ਜਗ ਕੇ ਕਾਰਨ ਕਰਤਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਘਟਿ ਘਟਿ ਕੀ ਮਤਿ ਜਾਨਨਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰੰਕਾਰ ਨਿਰਵੈਰ ਨਿਰਾਲਮ ॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਹੀ ਕੇ ਮਨ ਕੀ ਤੁਹਿ ਮਾਲਮ ॥੯੭॥",
      "s": 14
    },
    {
      "t": "ਤੁਮ ਹੀ ਬ੍ਰਹਮਾ ਬਿਸਨ ਬਨਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਰੁਦ੍ਰ ਤੁਮ ਹੀ ਉਪਜਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਮ ਹੀ ਰਿਖਿ ਕਸਪਹਿ ਬਨਾਵਾ ॥",
      "s": 14
    },
    {
      "t": "ਦਿਤ ਅਦਿਤ ਜਨ ਬੈਰ ਬਢਾਵਾ ॥੯੮॥",
      "s": 14
    },
    {
      "t": "ਜਗ ਕਾਰਨ ਕਰੁਨਾਨਿਧਿ ਸ੍ਵਾਮੀ ॥",
      "s": 14
    },
    {
      "t": "ਕਮਲ ਨੈਨ ਅੰਤਰ ਕੇ ਜਾਮੀ ॥",
      "s": 14
    },
    {
      "t": "ਦਯਾ ਸਿੰਧੁ ਦੀਨਨ ਕੇ ਦਯਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਹੂਜੈ ਕ੍ਰਿਪਾਨਿਧਾਨ ਕ੍ਰਿਪਾਲਾ ॥੯੯॥",
      "s": 14
    },
    {
      "t": "ਚਰਨ ਪਰੇ ਇਹ ਬਿਧਿ ਬਿਨਤੀ ਕਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਾਹਿ ਤ੍ਰਾਹਿ ਰਾਖਹੁ ਹਮ ਧੁਰਧਰ ॥",
      "s": 14
    },
    {
      "t": "ਕਹ ਕਹ ਹਸਾ ਬਚਨ ਸੁਨ ਕਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਭਗਤ ਜਾਨ ਕਰ ਭਯੋ ਕ੍ਰਿਪਾਲਾ ॥੧੦੦॥",
      "s": 14
    },
    {
      "t": "ਰਛ ਰਛ ਕਰਿ ਸਬਦ ਉਚਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਦੇਵਨ ਕਾ ਸੋਕ ਨਿਵਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਜੁ ਭਗਤਨ ਕਹ ਲਿਯੋ ਉਬਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਸਟਨ ਕੇ ਸੰਗ ਕਰਿਯੋ ਅਖਾਰਾ ॥੧੦੧॥",
      "s": 14
    }
  ]
}
