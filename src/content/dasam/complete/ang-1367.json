{
  "page": 1367,
  "lines": [
    {
      "t": "ਮਹਾ ਕਾਲ ਜਬ ਹੀ ਰਿਸਿ ਭਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਘੋਰ ਭਯਾਨਕ ਆਹਵ ਕਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਰਤ ਭਯੋ ਅਸੁਰ ਬਿਕਰਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਿੰਘ ਨਾਦ ਕੀਨਾ ਤਤਕਾਲਾ ॥੧੨੬॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਮਸਾਨ ਕਿਲਕਟੀ ਮਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਭੈਰਵ ਕਹੂੰ ਠਾਢ ਭੁੰਕਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਜੋਗਨਿ ਦੈਤ ਅਧਿਕ ਹਰਖਾਨੇ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਤ ਸਿਵਾ ਬੋਲੈ ਅਭਿਮਾਨੇ ॥੧੨੭॥",
      "s": 14
    },
    {
      "t": "ਝਾਲਰਿ ਝਾਝਰ ਢੋਲ ਮ੍ਰਿਦੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਪਟਹ ਨਗਾਰੇ ਮੁਰਜ ਮੁਚੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਡਵਰੂ ਗੁਡਗੁਡੀ ਕਹੂੰ ਉਪੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਇ ਨਫੀਰੀ ਬਜਤ ਸੁਰੰਗਾ ॥੧੨੮॥",
      "s": 14
    },
    {
      "t": "ਮੁਰਲੀ ਕਹੂੰ ਬਾਸੁਰੀ ਬਾਜਤ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਉਪੰਗ ਮ੍ਰਿਦੰਗ ਬਰਾਜਤ ॥",
      "s": 14
    },
    {
      "t": "ਦੁੰਦਭਿ ਢੋਲ ਕਹੂੰ ਸਹਨਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਜਤ ਭੇ ਲਖਿ ਪਰੀ ਲਰਾਈ ॥੧੨੯॥",
      "s": 14
    },
    {
      "t": "ਮੁਰਜ ਮੁਚੰਗ ਬਜੈ ਤੁਰਹੀ ਰਨ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਰਨ ਕੇ ਭਭਕਾਰ ਕਰਤ ਗਨ ॥",
      "s": 14
    },
    {
      "t": "ਹਾਥੀ ਘੋਰਨ ਕੇ ਦੁੰਦਭਿ ਰਨ ॥",
      "s": 14
    },
    {
      "t": "ਉਸਟਨ ਕੇ ਬਾਜੇ ਰਨ ਮੂਰਧਨ ॥੧੩੦॥",
      "s": 14
    },
    {
      "t": "ਕੇਤਿਕ ਸੁਭਟ ਸਰਨ ਕੇ ਮਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਗਿਰਤ ਭਏ ਰਨ ਡੀਲ ਡਿਲਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਜਦਪਿ ਪ੍ਰਾਨ ਸਮੁਹ ਹ੍ਵੈ ਦਏ ॥",
      "s": 14
    },
    {
      "t": "ਕਰ ਤੇ ਤਜਤ ਕ੍ਰਿਪਾਨਨ ਭਏ ॥੧੩੧॥",
      "s": 14
    },
    {
      "t": "ਚਲਤ ਭਈ ਸਰਿਤਾ ਸ੍ਰੋਨਤ ਤਹ ॥",
      "s": 14
    },
    {
      "t": "ਜੁਧ ਭਯੋ ਕਾਲੀ ਅਸੁਰਨ ਜਹ ॥",
      "s": 14
    },
    {
      "t": "ਸੀਸ ਕੇਸ ਜਹ ਭਏ ਸਿਵਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੋਨ ਪ੍ਰਵਾਹ ਬਹਤ ਹਹਰਾਰਾ ॥੧੩੨॥",
      "s": 14
    },
    {
      "t": "ਬਾਜ ਬ੍ਰਿਛ ਜਹ ਬਹੇ ਅਨੇਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਨ ਬ੍ਰਿਣ ਬੀਰ ਰਹਾ ਨਹਿ ਏਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੋਨ ਭਰੇ ਪਟ ਅਧਿਕ ਸੁਹਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਚਾਚਰਿ ਖੇਲਿ ਮਨੌ ਘਰ ਆਏ ॥੧੩੩॥",
      "s": 14
    },
    {
      "t": "ਸੂਰਨ ਕੇ ਜਹ ਮੂੰਡ ਪਖਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੋਭਿਤ ਰੰਗ ਭੂਮ ਮਹਿ ਨਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੇ ਜਾਤ ਜਹ ਬ੍ਰਿਛ ਤੁਰੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਡੇ ਸੈਲ ਸੇ ਲਸਤ ਮਤੰਗਾ ॥੧੩੪॥",
      "s": 14
    },
    {
      "t": "ਮਛਰੀ ਤਨਕਿ ਅੰਗੁਰਿਯੈ ਸੋਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਭੁਜਾ ਭੁਜੰਗਨ ਸੀ ਮਨ ਮੋਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਗ੍ਰਾਹ ਸੇ ਖੜਗ ਝਮਕਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਭਕ ਭਕ ਕਰ ਕਹੂੰ ਘਾਇ ਭਭਕਹਿ ॥੧੩੫॥",
      "s": 14
    },
    {
      "t": "ਭੁਜੰਗ ਛੰਦ ॥",
      "s": 14
    },
    {
      "t": "ਜਹਾ ਬੀਰ ਬੈਰੀ ਬਡੇ ਘੇਰਿ ਮਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਤਹਾ ਭੂਤ ਔ ਪ੍ਰੇਤ ਨਾਚੇ ਮਤਵਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਡਾਕਨੀ ਝਾਕਨੀ ਹਾਕ ਮਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਉਠੈ ਨਾਦ ਭਾਰੇ ਛੁਟੇ ਚੀਤਕਾਰੈ ॥੧੩੬॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਅੰਗੁਲੈ ਤ੍ਰਾਣ ਕਾਟਾ ਬਿਰਾਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਅੰਗੁਲਾ ਕਾਟਿ ਕੇ ਰਤਨ ਰਾਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਟੀਕ ਟਾਕੇ ਕਟੈ ਟੋਪ ਸੋਹੈ ॥",
      "s": 14
    }
  ]
}
