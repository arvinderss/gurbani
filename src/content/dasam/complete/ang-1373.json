{
  "page": 1373,
  "lines": [
    {
      "t": "ਬੈਰਮ ਖਾਨ ਬਹਾਦੁਰ ਖਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਲਵੰਡ ਖਾਨ ਬਡੋ ਸੁਰ ਗ੍ਯਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਰੁਸਤਮ ਖਾਨ ਕੋਪ ਕਰਿ ਚਲੋ ॥",
      "s": 14
    },
    {
      "t": "ਲੀਨੇ ਅਮਿਤ ਸੈਨ ਸੰਗ ਭਲੋ ॥੨੦੩॥",
      "s": 14
    },
    {
      "t": "ਹਸਨ ਖਾਨ ਹੁਸੈਨ ਖਾਨ ਭਨ ॥",
      "s": 14
    },
    {
      "t": "ਖਾਨ ਮੁਹੰਮਦ ਲੈ ਮਲੇਛ ਗਨ ॥",
      "s": 14
    },
    {
      "t": "ਸਮਸ ਖਾਨ ਸਮਸਰੋ ਖਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਚਲੇ ਪੀਸ ਕਰਿ ਦਾਤ ਜੁਆਨਾ ॥੨੦੪॥",
      "s": 14
    },
    {
      "t": "ਆਵਤ ਹੀ ਕੀਏ ਬਾਨ ਪ੍ਰਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਕਾਲ ਕਰ ਚਹਤ ਸੰਘਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਕਾਲ ਸਰ ਚਲਤ ਨਿਹਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਟੂਕ ਸਹੰਸ੍ਰ ਪ੍ਰਿਥੀ ਕਰਿ ਡਾਰੇ ॥੨੦੫॥",
      "s": 14
    },
    {
      "t": "ਡਾਰੇ ਸਤ ਸਤ ਟੂਕ ਪ੍ਰਿਥੀ ਕਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਕਾਲ ਕਰਿ ਕੋਪ ਅਮਿਤ ਸਰ ॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਇਕ ਸਰ ਤਨ ਬਹੁਰਿ ਪ੍ਰਹਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਗਿਰੇ ਪਠਾਨ ਸੁ ਭੂਮਿ ਮੰਝਾਰੇ ॥੨੦੬॥",
      "s": 14
    },
    {
      "t": "ਕਟਿ ਨਿਹੰਗਕ ਰਾਖਾ ਦ੍ਵੈ ਧਰ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਰੇ ਅਮਿਤ ਝੜਾਝੜ ਖਾ ਸਰ ॥",
      "s": 14
    },
    {
      "t": "ਖਾਨ ਭੜੰਗ ਬਹੁਰਿ ਰਨ ਮਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਖਤ ਚਾਰਣ ਸਿਧ ਹਜਾਰੇ ॥੨੦੭॥",
      "s": 14
    },
    {
      "t": "ਨਾਹਰ ਖਾ ਗੈਰਤ ਖਾ ਮਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਲਵੰਡ ਖਾ ਕਾ ਸੀਸ ਉਤਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੇਰ ਖਾਨ ਕਟਿ ਤੇ ਕਟਿ ਡਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬੈਰਮ ਖਾ ਗਹਿ ਕੇਸ ਪਛਾਰਿਯੋ ॥੨੦੮॥",
      "s": 14
    },
    {
      "t": "ਪੁਨਿ ਕਰਿ ਕੋਪ ਬਹਾਦੁਰ ਖਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਛਾਡੇ ਤਬੈ ਬਿਸਿਖ ਰਿਸਿ ਨਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਕਾਲ ਕੁਪ ਬਾਨ ਪ੍ਰਹਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਗਿਰਿਯੋ ਕਹਾ ਲੌ ਲਰੈ ਬਿਚਾਰੋ ॥੨੦੯॥",
      "v": [
        [
          0,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਹਨੀ ਪਠਾਨੀ ਸੈਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਮੁਗਲਨ ਪਰਾ ਮਧਿ ਕਛੁ ਭੈ ਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਛਿਨਕਿਕ ਮੋ ਬਹੁ ਸੁਭਟ ਗਿਰਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨੁ ਇੰਦ੍ਰ ਪਰਬਤ ਸੇ ਘਾਏ ॥੨੧੦॥",
      "s": 14
    },
    {
      "t": "ਬੈਰਮ ਬੇਗ ਮੁਗਲ ਕੌ ਮਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਯੂਸਫ ਖਾ ਕਟਿ ਤੇ ਕਟਿ ਡਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿਰ ਬੇਗ ਟਿਕਾ ਸੰਗ੍ਰਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਅੰਤ ਗਿਰਿਯੋ ਭਿਰਿ ਕੈ ਦ੍ਵੈ ਜਾਮਾ ॥੨੧੧॥",
      "s": 14
    },
    {
      "t": "ਨੂਰਮ ਬੇਗ ਬਹੁਰਿ ਰਿਸਿ ਮਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਆਦਿਲ ਬੇਗਹਿ ਬਹੁਰਿ ਪ੍ਰਜਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਾਸਿਤ ਭਈ ਮਲੇਛੀ ਸੈਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਆਯੁਧ ਸਕਾ ਹਾਥ ਕੋਈ ਲੈ ਨਾ ॥੨੧੨॥",
      "s": 14
    },
    {
      "t": "ਭਜੇ ਪਠਾਨ ਮੁਗਲ ਹੂੰ ਭਾਜੇ ॥",
      "s": 14
    },
    {
      "t": "ਸੈਯਦ ਆਨਿ ਦਸੌ ਦਿਸਿ ਗਾਜੇ ॥",
      "s": 14
    },
    {
      "t": "ਫਿਰੇ ਪਠਾਨ ਬਿਮਨ ਜੇ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਧਨੁਖ ਟੰਕੋਰਤ ਗਏ ॥੨੧੩॥",
      "s": 14
    },
    {
      "t": "ਆਵਤ ਹੀ ਹੁਸੈਨ ਖਾ ਜੂਝਾ ॥",
      "s": 14
    },
    {
      "t": "ਹਸਨ ਖਾਨ ਸਨਮੁਖ ਹ੍ਵੈ ਲੂਝਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਮੁਹੰਮਦ ਖਾ ਲਰਿ ਮਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨਕ ਸਲਭ ਦੀਪ ਮਹਿ ਪਰਿਯੋ ॥੨੧੪॥",
      "s": 14
    }
  ]
}
