{
  "page": 1376,
  "lines": [
    {
      "t": "ਕੇਤਿਕ ਮਰੇ ਮੂੰਡ ਕੀ ਪੀਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਤਕ ਬਾਇ ਤੇ ਭਏ ਅਧੀਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕੇਤਿਕ ਛਈ ਰੋਗ ਛੈ ਕਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕੇਤਨ ਨਾਸ ਬਾਇ ਤੇ ਥਿਯੋ ॥੨੪੫॥",
      "s": 14
    },
    {
      "t": "ਦਾੜ ਪੀੜ ਕੇਤੇ ਮਰਿ ਗਏ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਇ ਭਏ ਬਵਰੇ ਕਈ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਨ ਕੌ ਆਨਿ ਰੋਗ ਤਨ ਗ੍ਰਾਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕਾ ਪ੍ਰਾਨ ਦੇਹ ਤਜਿ ਨਾਸਾ ॥੨੪੬॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਾ ਲਗੇ ਮੈ ਬਰਨ ਸੁਨਾਊ ॥",
      "s": 14
    },
    {
      "t": "ਗ੍ਰੰਥ ਬਢਨ ਤੇ ਅਤਿ ਡਰਪਾਊ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਭਯੋ ਦਾਨਵਨ ਨਾਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਖੜਗਕੇਤੁ ਅਸੁ ਕਿਯਾ ਤਮਾਸਾ ॥੨੪੭॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਤਨ ਦਾਨਵ ਜਬ ਮਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਪੁਨਿ ਅਸਿਧੁਜ ਅਸ ਮੰਤ੍ਰ ਬਿਚਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਇਨ ਕੋ ਹ੍ਵੈ ਹੈ ਰਨ ਆਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਮੁਝੈ ਦਿਖੈ ਹੈ ਕਵਨ ਤਮਾਸਾ ॥੨੪੮॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਕਹ ਦੀਨ ਐਸ ਬਰਦਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਮਤੇ ਹੋਹਿ ਅਵਖਧੀ ਨਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਕੇ ਤਨ ਕੌ ਰੋਗ ਸੰਤਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਅਵਖਧੀ ਬੇਗ ਜਿਯਾਵੈ ॥੨੪੯॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਦਯੋ ਜਬੈ ਬਰਦਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਿਰਤਕ ਹੁਤੇ ਅਸੁਰ ਜੇ ਨਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਤੇ ਅਧਿਕ ਅਵਖਧੀ ਨਿਕਸੀ ॥",
      "s": 14
    },
    {
      "t": "ਅਪਨੇ ਸਕਲ ਗੁਨਨ ਕਹ ਬਿਗਸੀ ॥੨੫੦॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੇ ਦੇਹ ਪਿਤ੍ਰਯ ਦੁਖ ਦੇਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਭਖਿ ਜਰੀ ਬਾਤ ਕੀ ਲੇਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਦਾਨਵ ਕੌ ਬਾਇ ਸੰਤਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਲੈ ਜਰੀ ਪਿਤ੍ਰਯ ਕੀ ਖਾਵੈ ॥੨੫੧॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੀ ਦੇਹਿਹ ਕਫ ਦੁਖ ਲ੍ਯਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਲੈ ਕਫਨਾਸਨੀ ਚਬਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਅਸੁਰ ਭਏ ਬਿਨੁ ਰੋਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਡਤ ਭਏ ਜੁਧ ਤਜਿ ਸੋਗਾ ॥੨੫੨॥",
      "s": 14
    },
    {
      "t": "ਅਗਨਿ ਅਸਤ੍ਰ ਛਾਡਾ ਤਬ ਦਾਨਵ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਤੇ ਭਏ ਭਸਮ ਬਹੁ ਮਾਨਵ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਰੁਣਾਸਤ੍ਰ ਤਬ ਕਾਲ ਚਲਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਕਲ ਅਗਨਿ ਕੋ ਤੇਜ ਮਿਟਾਯੋ ॥੨੫੩॥",
      "s": 14
    },
    {
      "t": "ਰਾਛਸ ਪਵਨ ਅਸਤ੍ਰ ਸੰਧਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਤੇ ਉਡਤ ਭਏ ਗਨ ਨਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਧਰਾਸਤ੍ਰ ਤਬ ਕਾਲ ਪ੍ਰਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਸਿਵਕਨ ਕੋ ਪ੍ਰਾਨ ਉਬਾਰਾ ॥੨੫੪॥",
      "s": 14
    },
    {
      "t": "ਮੇਘ ਅਸਤ੍ਰ ਛੋਰਾ ਪੁਨਿ ਦਾਨਵ ॥",
      "s": 14
    },
    {
      "t": "ਭੀਜ ਗਏ ਜਿਹ ਤੇ ਸਭ ਮਾਨਵ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਇ ਅਸਤ੍ਰ ਲੈ ਕਾਲ ਚਲਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਮੇਘਨ ਤਤਕਾਲ ਉਡਾਯੋ ॥੨੫੫॥",
      "s": 14
    },
    {
      "t": "ਰਾਛਸਾਸਤ੍ਰ ਰਾਛਸਹਿ ਚਲਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁ ਅਸੁਰਨ ਤਾ ਤੇ ਉਪਜਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਵਤਾਸਤ੍ਰ ਛੋਰਾ ਤਬ ਕਾਲਾ ॥",
      "s": 14
    }
  ]
}
