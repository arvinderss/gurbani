{
  "page": 1377,
  "lines": [
    {
      "t": "ਅਸੁਰ ਸੈਨ ਕੂਟਾ ਦਰਹਾਲਾ ॥੨੫੬॥",
      "s": 14
    },
    {
      "t": "ਜਛ ਅਤਸ੍ਰ ਤਬ ਅਸੁਰ ਚਲਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਗੰਧ੍ਰਬਾਸਤ੍ਰ ਲੈ ਕਾਲ ਬਗਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤੇ ਦੋਊ ਆਪੁ ਬੀਰ ਲਰਿ ਮਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਟੁਕ ਟੁਕ ਹ੍ਵੈ ਭੂ ਪਰ ਪੁਨਿ ਝਰੇ ॥੨੫੭॥",
      "s": 14
    },
    {
      "t": "ਚਾਰਣਾਸਤ੍ਰ ਜਬ ਅਸੁਰ ਸੰਧਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਚਾਰਣ ਉਪਜ ਠਾਢ ਭੈ ਨਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਿਧ ਅਸਤ੍ਰ ਅਸਿਧੁਜ ਤਬ ਛੋਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਮੁਖ ਸਤ੍ਰਨ ਕੋ ਤੋਰਾ ॥੨੫੮॥",
      "s": 14
    },
    {
      "t": "ਉਰਗ ਅਸਤ੍ਰ ਲੈ ਅਸੁਰ ਪ੍ਰਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਉਪਜੇ ਸਰਪ ਅਪਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਖਗਪਤਿ ਅਸਤ੍ਰ ਤਜਾ ਤਬ ਕਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਭਛਿ ਗਏ ਨਾਗਨ ਦਰਹਾਲਾ ॥੨੫੯॥",
      "s": 14
    },
    {
      "t": "ਬਿਛੂ ਅਸਤ੍ਰ ਦਾਨਵਹਿ ਚਲਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁ ਬਿਛੂਯਨ ਤਾ ਤੇ ਉਪਜਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਲਸਿਟਕਾ ਸਤ੍ਰ ਅਸਿਧੁਜ ਤਬ ਛੋਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਹੀ ਡਾਕ ਅਠੂਹਨ ਤੋਰਾ ॥੨੬੦॥",
      "s": 14
    },
    {
      "t": "ਸਸਤ੍ਰ ਅਸਤ੍ਰ ਅਸ ਅਸੁਰ ਚਲਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਖੜਗ ਕੇਤੁ ਪਰ ਕਛੁ ਨ ਬਸਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਅਸਤ੍ਰਨ ਸਾਥ ਅਸਤ੍ਰੁ ਬਹੁ ਛਏ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੌ ਲਗੇ ਲੀਨ ਤੇ ਭਏ ॥੨੬੧॥",
      "s": 14
    },
    {
      "t": "ਲੀਨ ਹ੍ਵੈ ਗਏ ਅਸਤ੍ਰ ਨਿਹਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਹਾਇ ਹਾਇ ਕਰਿ ਅਸੁਰ ਪੁਕਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਮੂਢ ਫਿਰਿ ਕੋਪ ਬਢਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਪੁਨਿ ਅਸਿਧੁਜ ਤਨ ਕਰੀ ਲਰਾਈ ॥੨੬੨॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਭਯੋ ਘੋਰ ਸੰਗ੍ਰਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਤ ਦੇਵ ਦਾਨਵੀ ਬਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਧੰਨ੍ਯ ਧੰਨ੍ਯ ਅਸਿਧੁਜ ਕੌ ਕਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਦਾਨਵ ਹੇਰਿ ਮੋਨ ਹ੍ਵੈ ਰਹੈ ॥੨੬੩॥",
      "s": 14
    },
    {
      "t": "ਭੁਜੰਗ ਛੰਦ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਰੋਸ ਕੈ ਕੈ ਹਠੀ ਫੇਰਿ ਗਾਜੇ ॥",
      "s": 14
    },
    {
      "t": "ਚਹੂੰ ਓਰ ਤੇ ਘੋਰ ਬਾਦਿਤ੍ਰ ਬਾਜੇ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਣੋ ਸੰਖ ਭੇਰੀ ਬਜੇ ਢੋਲ ਐਸੇ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਲੈ ਕਾਲ ਕੇ ਕਾਲ ਕੀ ਰਾਤ੍ਰਿ ਜੈਸੇ ॥੨੬੪॥",
      "s": 14
    },
    {
      "t": "ਬਜੇ ਸੰਖ ਔ ਦਾਨਵੀ ਭੇਰ ਐਸੀ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੈ ਆਸੁਰੀ ਬ੍ਰਿਤ ਕੀ ਕ੍ਰਿਤ ਜੈਸੀ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਬੀਰ ਬਾਜੰਤ ਬਾਕੇ ਬਜਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਮਨੋ ਚਿਤ ਕੋ ਕੋਪ ਭਾਖੇ ਸੁਨਾਵੈ ॥੨੬੫॥",
      "s": 14
    },
    {
      "t": "ਕਿਤੇ ਬੀਰ ਬਜ੍ਰਾਨ ਕੇ ਸਾਥ ਪੇਲੇ ॥",
      "s": 14
    },
    {
      "t": "ਭਰੇ ਬਸਤ੍ਰ ਲੋਹੂ ਮਨੋ ਫਾਗ ਖੇਲੇ ॥",
      "s": 14
    },
    {
      "t": "ਮੂਏ ਖਾਇ ਕੈ ਦੁਸਟ ਕੇਤੇ ਮਰੂਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਸੋਏ ਜਾਨ ਮਾਲੰਗ ਖਾਏ ਧਤੂਰੇ ॥੨੬੬॥",
      "s": 14
    },
    {
      "t": "ਕਿਤੇ ਟੂਕ ਟੂਕੇ ਬਲੀ ਖੇਤ ਹੋਏ ॥",
      "s": 14
    },
    {
      "t": "ਮਨੋ ਖਾਇ ਕੈ ਭੰਗ ਮਾਲੰਗ ਸੋਏ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਰਾਜੈ ਕਟੇ ਅੰਗ ਬਸਤ੍ਰੋ ਲਪੇਟੇ ॥",
      "s": 14
    },
    {
      "t": "ਜੁਮੇ ਕੇ ਮਨੋ ਰੋਜ ਮੈ ਗੌਂਸ ਲੇਟੇ ॥੨੬੭॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਡਾਕਨੀ ਝਾਕਨੀ ਹਾਕ ਮਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਉਠੈ ਨਾਦ ਭਾਰੇ ਛੁਟੈ ਚੀਤਕਾਰੈ ॥",
      "s": 14
    }
  ]
}
