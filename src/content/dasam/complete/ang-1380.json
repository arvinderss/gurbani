{
  "page": 1380,
  "lines": [
    {
      "t": "ਸਤ੍ਰੁ ਅਨੇਕ ਨਿਧਨ ਕਹ ਗਏ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਉਪਜਿ ਬਹੁ ਠਾਢੇ ਭਏ ॥੨੯੧॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਕਾਲ ਕੁਪਿ ਬਾਨ ਪ੍ਰਹਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਬੇਧਿ ਦਾਨਵਨ ਪਾਰ ਪਧਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਦਾਨਵ ਤਬੈ ਅਧਿਕ ਕਰਿ ਕ੍ਰੁਧਾ ॥",
      "s": 14
    },
    {
      "t": "ਮੰਡਾ ਮਹਾ ਕਾਲ ਤਨ ਜੁਧਾ ॥੨੯੨॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਕਾਲ ਤਬ ਬਾਨ ਪ੍ਰਹਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਦਾਨਵ ਏਕ ਏਕ ਕਰਿ ਮਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਤੇ ਬਹੁ ਉਪਜਿਤ ਰਨ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਕਾਲ ਕੇ ਸਾਮੁਹਿ ਸਿਧਏ ॥੨੯੩॥",
      "s": 14
    },
    {
      "t": "ਜੇਤਿਕ ਧਏ ਤਿਤਕ ਕਲਿ ਮਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਰਥੀ ਗਜੀ ਤਿਲ ਤਿਲ ਕਰਿ ਡਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨਤੇ ਉਪਜਿ ਠਾਢ ਭੇ ਘਨੇ ॥",
      "s": 14
    },
    {
      "t": "ਰਥੀ ਗਜੀ ਬਾਜੀ ਸੁਭ ਬਨੇ ॥੨੯੪॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਕਾਲ ਕਰਿ ਕੋਪ ਪ੍ਰਹਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਦੈਤ ਅਨਿਕ ਮ੍ਰਿਤੁ ਲੋਕ ਪਧਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਕਾਲ ਬਹੁਰੌ ਧਨੁ ਧਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੌ ਸੌ ਬਾਨ ਏਕ ਇਕ ਹਰਾ ॥੨੯੫॥",
      "s": 14
    },
    {
      "t": "ਸੌ ਸੌ ਏਕ ਏਕ ਸਰ ਮਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੌ ਸੌ ਗਿਰੀ ਸ੍ਰੋਨ ਕੀ ਧਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਤ ਸਤ ਅਸੁਰ ਉਪਜਿ ਭੇ ਠਾਢੇ ॥",
      "s": 14
    },
    {
      "t": "ਅਸੀ ਗਜੀ ਕੌਚੀ ਬਲ ਗਾਢੇ ॥੨੯੬॥",
      "s": 14
    },
    {
      "t": "ਰੂਪ ਹਜਾਰ ਹਜਾਰ ਧਾਰਿ ਕਲਿ ॥",
      "s": 14
    },
    {
      "t": "ਗਰਜਤ ਭਯੋ ਅਤੁਲ ਕਰਿ ਕੈ ਬਲ ॥",
      "s": 14
    },
    {
      "t": "ਕਹ ਕਹ ਹਸਾ ਕਾਲ ਬਿਕਰਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਢੇ ਦਾਤ ਤਜਤ ਮੁਖ ਜ੍ਵਾਲਾ ॥੨੯੭॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਏਕ ਰਨ ਬਾਨ ਚਲਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਹਸ ਸਹਸ ਦਾਨਵ ਕਹ ਘਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕੇਤਿਕ ਸੁਭਟ ਦਾੜ ਗਹਿ ਚਾਬੇ ॥",
      "s": 14
    },
    {
      "t": "ਕੇਤਿਕ ਸੁਭਟ ਪਾਵ ਤਰ ਦਾਬੇ ॥੨੯੮॥",
      "s": 14
    },
    {
      "t": "ਕੇਤਕ ਪਕਰਿ ਭਛ ਕਰਿ ਲਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਤੇ ਏਕ ਨ ਉਪਜਤ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਤਕਨ ਦ੍ਰਿਸਟਾਕਰਖਨ ਕੀਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਭਹਿਨ ਕੋ ਸ੍ਰੋਨਿਤ ਹਰਿ ਲੀਯੋ ॥੨੯੯॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੋਨ ਰਹਿਤ ਦਾਨਵ ਜਬ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੈਤ ਉਪਰਾਜਨ ਤੇ ਰਹਿ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰਮਿਤ ਅਧਿਕ ਹ੍ਵੈ ਛਾਡਤ ਸ੍ਵਾਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਕਰਤ ਦੈਤ ਪਰਗਾਸਾ ॥੩੦੦॥",
      "s": 14
    },
    {
      "t": "ਪਵਨਾਕਰਖ ਕਰਾ ਤਬ ਕਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਘਟੇ ਬਢਨ ਤੇ ਅਰਿ ਬਿਕਰਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਜਬ ਆਕਰਖਨ ਕੀਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਬਲ ਹਰਿ ਅਸੁਰਨ ਕਾ ਲੀਯਾ ॥੩੦੧॥",
      "s": 14
    },
    {
      "t": "ਮਾਰਿ ਮਾਰਿ ਜੋ ਅਸੁਰ ਪੁਕਾਰਤ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਤੇ ਅਮਿਤ ਦੈਤ ਤਨ ਧਾਰਤ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਚਾਕਰਖ ਕਾਲ ਤਬ ਕਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬੋਲਨ ਤੇ ਦਾਨਵ ਰਹਿ ਗਯੋ ॥੩੦੨॥",
      "s": 14
    },
    {
      "t": "ਦਾਨਵ ਜਬ ਬੋਲਹਿ ਰਹਿ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਚਿੰਤਾ ਕਰਤ ਚਿਤ ਮੋ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹੀ ਤੇ ਦਾਨਵ ਬਹੁ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਸਨਮੁਖ ਮਹਾ ਕਾਲ ਕੇ ਧਏ ॥੩੦੩॥",
      "s": 14
    },
    {
      "t": "ਸਸਤ੍ਰ ਅਸਤ੍ਰ ਕਰਿ ਕੋਪ ਪ੍ਰਹਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾਬੀਰ ਬਰਿਯਾਰ ਡਰਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਕਾਲ ਤਬ ਗੁਰਜ ਸੰਭਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਤਨ ਕੀ ਮੇਧਾ ਕਢਿ ਡਾਰੀ ॥੩੦੪॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਕੀ ਭੂਅ ਮੇਜਾ ਜੋ ਪਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਸੈਨ ਦੇਹ ਬਹੁ ਧਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਰਿ ਮਾਰਿ ਕਰਿ ਕੋਪ ਅਪਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਗਤ ਭਏ ਅਸੁਰ ਬਿਕਰਾਰਾ ॥੩੦੫॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਕੇ ਫੋਰਿ ਮੂੰਡਿ ਕਲਿ ਡਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਮੇਧਾ ਜੋ ਭੂਅ ਪਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਰਿ ਮਾਰਿ ਕਹਿ ਅਸੁਰ ਜਗੇ ਰਨ ॥",
      "s": 14
    },
    {
      "t": "ਸੂਰਬੀਰ ਬਰਿਯਾਰ ਮਹਾਮਨ ॥੩੦੬॥",
      "s": 14
    },
    {
      "t": "ਪੁਨਿ ਕਰਿ ਕਾਲ ਗਦਾ ਰਿਸਿ ਧਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਸਤ੍ਰੁ ਖੋਪਰੀ ਤਿਲ ਤਿਲ ਕਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜੇਤੇ ਟੂਕ ਖੋਪ੍ਰਿਯਨ ਪਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਤੇਤਿਕ ਰੂਪ ਦਾਨਵਨ ਧਰੇ ॥੩੦੭॥",
      "s": 14
    },
    {
      "t": "ਕੇਤਿਕ ਗਦਾ ਪਾਨ ਗਹਿ ਧਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਕੇਤਿਕ ਖੜਗ ਹਾਥ ਲੈ ਆਏ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਰਿ ਮਾਰਿ ਕੈ ਕੋਪਹਿ ਸਰਜੇ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਨਹੁ ਮਹਾਕਾਲ ਘਨ ਗਰਜੇ ॥੩੦੮॥",
      "s": 14
    },
    {
      "t": "ਆਨਿ ਕਾਲ ਕਹ ਕਰਤ ਪ੍ਰਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਇਕ ਸੂਰ ਸਹਸ ਹਥਿਯਾਰਾ ॥",
      "s": 14
    }
  ]
}
