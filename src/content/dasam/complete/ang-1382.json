{
  "page": 1382,
  "lines": [
    {
      "t": "ਮਹਾ ਕਾਲ ਕੁਪਿ ਸਸਤ੍ਰ ਪ੍ਰਹਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਧ ਉਬਾਰਿ ਦੁਸਟ ਸਭ ਮਾਰੇ ॥੩੨੧॥",
      "s": 14
    },
    {
      "t": "ਭੁਜੰਗ ਛੰਦ ॥",
      "s": 14
    },
    {
      "t": "ਮਚੇ ਆਨਿ ਮੈਦਾਨ ਮੈ ਬੀਰ ਭਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਦਿਖੈ ਕੌਨ ਜੀਤੈ ਦਿਖੈ ਕੌਨ ਹਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਲਏ ਸੂਲ ਔ ਸੇਲ ਕਾਤੀ ਕਟਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਚਹੂੰ ਓਰ ਗਾਜੇ ਹਠੀ ਬੀਰ ਭਾਰੀ ॥੩੨੨॥",
      "s": 14
    },
    {
      "t": "ਬਜੇ ਘੋਰ ਸੰਗ੍ਰਾਮ ਮੋ ਘੋਰ ਬਾਜੇ ॥",
      "s": 14
    },
    {
      "t": "ਚਹੂੰ ਓਰ ਬਾਕੇ ਰਥੀ ਬੀਰ ਗਾਜੇ ॥",
      "s": 14
    },
    {
      "t": "ਲਏ ਸੂਲ ਔ ਸੇਲ ਕਾਤੀ ਕਟਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਮਚੇ ਕੋਪ ਕੈ ਕੈ ਹਠੀਲੇ ਰਜ੍ਰਯਾਰੇ ॥੩੨੩॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਧੂਲਧਾਨੀ ਛੁਟੈ ਫੀਲ ਨਾਲੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਬਾਜ ਨਾਲੈ ਮਹਾ ਘੋਰ ਜ੍ਵਾਲੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਸੰਖ ਭੇਰੀ ਪ੍ਰਣੋ ਢੋਲ ਬਾਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਸੂਰ ਠੋਕੈ ਭੁਜਾ ਭੂਪ ਗਾਜੈ ॥੩੨੪॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਘੋਰ ਬਾਦਿਤ੍ਰ ਬਾਜੈ ਨਗਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਬੀਰ ਬਾਜੀ ਗਿਰੇ ਖੇਤ ਮਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਖੇਤ ਨਾਚੈ ਪਠੇ ਪਖਰਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਸੂਰ ਸੰਗ੍ਰਾਮ ਸੋਹੈ ਡਰਾਰੇ ॥੩੨੫॥",
      "s": 14
    },
    {
      "t": "ਕਹੂ ਬਾਜ ਮਾਰੇ ਕਹੂੰ ਝੂਮ ਹਾਥੀ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਫੈਟ ਭਾਥੀ ਜੁਝੇ ਬਾਧਿ ਸਾਥੀ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਗਰਜਿ ਠੋਕੈ ਭੁਜਾ ਭੂਪ ਭਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਬਮੈ ਸ੍ਰੋਨ ਕੇਤੇ ਗਿਰੇ ਖੇਤ ਮਾਰੇ ॥੩੨੬॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਅਸੁਰ ਜਬੈ ਚੁਨਿ ਮਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਅਮਿਤ ਰੋਸ ਕਰਿ ਔਰ ਸਿਧਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਧੇ ਫੈਟ ਬਿਰਾਜੈ ਭਾਥੀ ॥",
      "s": 14
    },
    {
      "t": "ਆਗੇ ਚਲੇ ਅਮਿਤ ਧਰਿ ਹਾਥੀ ॥੩੨੭॥",
      "s": 14
    },
    {
      "t": "ਸਾਥ ਲਏ ਅਨਗਨ ਪਖਰਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਉਮਡਿ ਚਲੇ ਦੈ ਢੋਲ ਨਗਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਸੰਖ ਝਾਝ ਅਰੁ ਢੋਲ ਬਜਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਚਮਕਿ ਚਲੇ ਚੌਗੁਨ ਕਰਿ ਚਾਇ ॥੩੨੮॥",
      "s": 14
    },
    {
      "t": "ਡਵਰੂ ਕਹੂੰ ਗੁੜਗੁੜੀ ਬਾਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਠੋਕਿ ਭੁਜਾ ਰਨ ਮੋ ਭਟ ਗਾਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਮੁਰਜ ਉਪੰਗ ਮੁਰਲਿਯੈ ਘਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਰ ਝਾਜ ਬਾਜੈ ਰੁਨਝੁਨੀ ॥੩੨੯॥",
      "s": 14
    },
    {
      "t": "ਕਹੀ ਤੂੰਬਰੇ ਬਜੈ ਅਪਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਬੇਨ ਬਾਸੁਰੀ ਕਹੂੰ ਹਜਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਤਰੀ ਫੀਲ ਨਗਾਰੇ ਘਨੇ ॥",
      "s": 14
    },
    {
      "t": "ਅਮਿਤ ਕਾਨ੍ਰਹਰੇ ਜਾਤ ਨ ਗਨੇ ॥੩੩੦॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਭਯੋ ਜਬੈ ਸੰਗ੍ਰਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਕਸੀ ਦਿਨ ਦੂਲਹ ਹ੍ਵੈ ਬਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਿੰਘ ਬਾਹਨੀ ਧੁਜਾ ਬਿਰਾਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਹਿ ਬਿਲੋਕ ਦੈਤ ਦਲ ਭਾਜੈ ॥੩੩੧॥",
      "s": 14
    },
    {
      "t": "ਆਵਤ ਹੀ ਬਹੁ ਅਸੁਰ ਸੰਘਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਲ ਤਿਲ ਪ੍ਰਾਇ ਰਥੀ ਕਰਿ ਡਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਟਿ ਦਈ ਕੇਤਿਨ ਕੀ ਧੁਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਜੰਘਾ ਪਾਵ ਸੀਸ ਅਰੁ ਭੁਜਾ ॥੩੩੨॥",
      "s": 14
    }
  ]
}
