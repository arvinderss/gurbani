{
  "page": 1383,
  "lines": [
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਸੁਭਟ ਪ੍ਰਹਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਟੂਕ ਟੂਕ ਕਰਿ ਪ੍ਰਿਥੀ ਪਛਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਕੇਸਨ ਤੇ ਗਹਿ ਕਿਤਨ ਪਛਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਤ੍ਰੁ ਸੈਨ ਤਿਲ ਤਿਲ ਕਰਿ ਡਾਰਾ ॥੩੩੩॥",
      "s": 14
    },
    {
      "t": "ਝਮਕਤ ਕਹੀ ਅਸਿਨ ਕੀ ਧਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਭਭਕਤ ਰੁੰਡ ਮੁੰਡ ਬਿਕਰਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕੇਤਿਕ ਗਰਜਿ ਸਸਤ੍ਰ ਕਟਿ ਸਜਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਅਸਤ੍ਰ ਛੋਰਿ ਕੇਤੇ ਭਟ ਭਜਹੀ ॥੩੩੪॥",
      "s": 14
    },
    {
      "t": "ਮਾਰੇ ਪਰੇ ਪ੍ਰਿਥੀ ਪਰ ਕੇਤੇ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਬੀਰ ਬਿਕਰਾਰ ਬਿਚੇਤੇ ॥",
      "s": 14
    },
    {
      "t": "ਝਿਮਿ ਝਿਮਿ ਗਿਰੈ ਸ੍ਰੋਨ ਜਿਮਿ ਝਰਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਭਯੋ ਘੋਰ ਰਨ ਜਾਤ ਨ ਬਰਨਾ ॥੩੩੫॥",
      "s": 14
    },
    {
      "t": "ਅਚਿ ਅਚਿ ਰੁਧਰ ਡਾਕਨੀ ਡਹਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਭਖਿ ਭਖਿ ਮਾਸ ਕਾਕ ਕਹੂੰ ਕਹਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਦਾਰੁਨ ਹੋਤ ਭਯੋ ਤਹ ਜੁਧਾ ॥",
      "s": 14
    },
    {
      "t": "ਹਮਰੇ ਬੀਚ ਨ ਆਵਤ ਬੁਧਾ ॥੩੩੬॥",
      "s": 14
    },
    {
      "t": "ਮਾਰੇ ਪਰੇ ਦੈਤ ਕਹੀ ਭਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਗਿਰੇ ਕਾਢਿ ਕਰਿ ਦਾਤ ਡਰਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੋਨਤ ਬਮਤ ਬਦਨ ਤੇ ਏਕਾ ॥",
      "s": 14
    },
    {
      "t": "ਬੀਰ ਖੇਤ ਬਲਵਾਨ ਅਨੇਕਾ ॥੩੩੭॥",
      "s": 14
    },
    {
      "t": "ਬਡੇ ਬਡੇ ਜਿਨ ਕੇ ਸਿਰ ਸੀਂਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਚੋਂਚੈ ਬਡੀ ਭਾਤਿ ਜਿਨ ਢੀਂਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੋਨਤ ਸੇ ਸਰ ਨੈਨ ਅਪਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖ ਜਿਨੈ ਉਪਜਤ ਭ੍ਰਮ ਭਾਰਾ ॥੩੩੮॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਬੀਰ ਤ੍ਰੈ ਲੋਕ ਅਤੁਲ ਬਲ ॥",
      "s": 14
    },
    {
      "t": "ਅਰਿ ਅਨੇਕ ਜੀਤੇ ਜਿਨ ਜਲ ਥਲ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਬੀਰ ਬਲਵਾਨ ਡਰਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਚੁਨਿ ਚੁਨਿ ਬਾਲ ਬਰਛਿਯਨ ਮਾਰੇ ॥੩੩੯॥",
      "s": 14
    },
    {
      "t": "ਕੇਤਿਕ ਸੁਭਟ ਅਬਿਕਟੇ ਮਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਕੇਤਿਕ ਕਰਨ ਕੇਹਰੀ ਫਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਕੇਤਿਕ ਮਹਾ ਕਾਲ ਅਰਿ ਕੂਟੇ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਦਲ ਸੇ ਸਭ ਹੀ ਦਲ ਫੂਟੇ ॥੩੪੦॥",
      "s": 14
    },
    {
      "t": "ਕੇਤੇ ਬੀਰ ਬਰਛਿਯਨ ਮਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਟੂਕ ਟੂਕ ਕੇਤਿਕ ਕਰਿ ਡਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਕੇਤੇ ਹਨੇ ਖੜਗ ਕੀ ਧਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਲੋਹ ਕਟੀਲੇ ਸੂਰ ਅਪਾਰਾ ॥੩੪੧॥",
      "s": 14
    },
    {
      "t": "ਕੇਤਿਕ ਸੂਲ ਸੈਹਥੀ ਹਨੇ ॥",
      "s": 14
    },
    {
      "t": "ਸੁੰਦਰ ਸੁਘਰ ਸਿਪਾਹੀ ਬਨੇ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਪਰੇ ਸੁ ਬੀਰ ਪ੍ਰਹਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਮਿ ਚਾਲ ਮਨੋ ਗਿਰੇ ਮੁਨਾਰੇ ॥੩੪੨॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਗਿਰੇ ਬੀਰ ਰਨ ਭਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁ ਨਗ ਇੰਦ੍ਰ ਬਜ੍ਰ ਭੇ ਮਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਟੂਕ ਟੂਕ ਜੂਝੇ ਹ੍ਵੈ ਘਨੇ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨੁਕ ਗੌਸ ਕੁਤਬ ਸੇ ਬਨੇ ॥੩੪੩॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੋਨ ਪੁਲਿਤ ਹ੍ਵੈ ਕਿਤੇ ਪਰਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਚਾਚਰਿ ਖੇਲਿ ਮਨੋ ਘਰ ਆਏ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਜਤ ਭਏ ਬਿਮਨ ਹ੍ਵੈ ਐਸੇ ॥",
      "s": 14
    },
    {
      "t": "ਦਰਬ ਹਰਾਇ ਜੁਆਰੀ ਜੈਸੇ ॥੩੪੪॥",
      "s": 14
    }
  ]
}
