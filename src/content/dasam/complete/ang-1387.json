        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਜਬ ਆਕਰਖ ਕਰਤ ਹੋ ਕਬਹੂੰ ॥",
      "v": [
        [
          0,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤੁਮ ਮੈ ਮਿਲਤ ਦੇਹ ਧਰ ਸਭਹੂੰ ॥੩੮੯॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਜੇਤੇ ਬਦਨ ਸ੍ਰਿਸਟਿ ਸਭ ਧਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਆਪੁ ਆਪਨੀ ਬੂਝ ਉਚਾਰੈ ॥",
