{
  "page": 1390,
  "lines": [
    {
      "t": "ਕਿ ਹੁਸਨੁਲ ਜਮਾਲਸਤੁ ਰਾਜ਼ਕ ਰਹੀਮ ॥੭॥",
      "s": 15
    },
    {
      "t": "ਕਿ ਸਾਹਿਬਿ ਸ਼ਊਰਸਤੁ ਆਜਿਜ਼ ਨਿਵਾਜ਼ ॥",
      "s": 15
    },
    {
      "t": "ਗ਼੍ਰੀਬੁਲ ਪ੍ਰਸਤੋ ਗ਼ਨੀਮੁਲ ਗੁਦਾਜ਼ ॥੮॥",
      "s": 15
    },
    {
      "t": "ਸ਼ਰੀਅਤ ਪ੍ਰਸਤੋ ਫ਼ਜ਼ੀਲਤ ਮੁਆਬ ॥",
      "s": 15
    },
    {
      "t": "ਹਕੀਕਤ ਸ਼ਨਾਸੋ ਨਬੀਉਲ ਕਿਤਾਬ ॥੯॥",
      "s": 15
    },
    {
      "t": "ਕਿ ਦਾਨਸ਼ ਪਜ਼ੂਹਸਤ ਸਾਹਿਬਿ ਸ਼ਊਰ ॥",
      "s": 15
    },
    {
      "t": "ਹਕੀਕਤ ਸ਼ਨਾਸਸਤੋ ਜ਼ਾਹਿਰ ਜ਼ਹੂਰ ॥੧੦॥",
      "s": 15
    },
    {
      "t": "ਸ਼ਨਾਸਿੰਦਏ ਇਲਮਿ ਆਲਮ ਖ਼ੁਦਾਇ ॥",
      "s": 15
    },
    {
      "t": "ਕੁਸ਼ਾਇੰਦਏ ਕਾਰਿ ਆਲਮ ਕੁਸ਼ਾਇ ॥੧੧॥",
      "s": 15
    },
    {
      "t": "ਗੁਜ਼ਾਰਿੰਦਏ ਕਾਰਿ ਆਲਮ ਕਬੀਰ ॥",
      "s": 15
    },
    {
      "t": "ਸ਼ਨਾਸਿੰਦਏ ਇਲਮਿ ਆਲਮ ਅਮੀਰ ॥੧੨॥",
      "s": 15
    },
    {
      "t": "ਮਰਾ ਏਅਤਬਾਰੇ ਬਰੀਂ ਕਸਮ ਨੇਸਤ ॥",
      "s": 15
    },
    {
      "t": "ਕਿ ਏਜ਼ਦ ਗਵਾਹਸਤੁ ਯਜ਼ਦਾਂ ਯਕੇਸਤ ॥੧੩॥",
      "s": 15
    },
    {
      "t": "ਨ ਕਤਰਹ ਮਰਾ ਏਤਬਾਰੇ ਬਰੋਸਤ ॥",
      "s": 15
    },
    {
      "t": "ਕਿ ਬਖ਼ਸ਼ੀ ਵ ਦੀਵਾਂ ਹਮਾ ਕਿਜ਼ਬ ਗੋਸ਼ਤ ॥੧੪॥",
      "s": 15
    },
    {
      "t": "ਕਸੇ ਕਉਲਿ ਕੁਰਆਂ ਕੁਨਦ ਏਤਬਾਰ ॥",
      "s": 15
    },
    {
      "t": "ਹਮਾ ਰੋਜ਼ਿ ਆਖ਼ਰ ਸ਼ਵਦ ਮਰਦ ਖ਼੍ਵਾਰ ॥੧੫॥",
      "s": 15
    },
    {
      "t": "ਹੁਮਾ ਰਾ ਕਸੇ ਸਾਯਹ ਆਯਦ ਬਜ਼ੇਰ ॥",
      "s": 15
    },
    {
      "t": "ਬਰੋ ਦਸਤ ਦਾਰਦ ਨ ਜ਼ਾਗ਼ੋ ਦਲੇਰ ॥੧੬॥",
      "s": 15
    },
    {
      "t": "ਕਸੇ ਪੁਸ਼ਤ ਉਫ਼ਤਦ ਪਸੇ ਸ਼ੇਰਿ ਨਰ ॥",
      "s": 15
    },
    {
      "t": "ਨ ਗੀਰਦ ਬੁਜ਼ੋ ਮੇਸ਼ੋ ਆਹੂ ਗੁਜ਼ਰ ॥੧੭॥",
      "s": 15
    },
    {
      "t": "ਕਸਮ ਮੁਸਹਫ਼ੇ ਖ਼ੁਦ ਅਗਰ ਈਂ ਖ਼ੁਰਮ ॥",
      "s": 15
    },
    {
      "t": "ਨ ਫ਼ੌਜੇ ਅਜ਼ੀਂ ਜ਼ੇਰਿ ਸੁਮ ਅਫ਼ਗਨਮ ॥੧੮॥",
      "s": 15
    },
    {
      "t": "ਗਰਸਨਹ ਚਿ ਕਾਰਿ ਕੁਨਦ ਚਿਹਲ ਨਰ ॥",
      "s": 15
    },
    {
      "t": "ਕਿ ਦਹ ਲਖ ਬਰਾਯਦ ਬਰੋ ਬੇਖ਼ਬਰ ॥੧੯॥",
      "s": 15
    },
    {
      "t": "ਕਿ ਪੈਮਾਂਸ਼ਿਕਨ ਬੇਦਰੰਗ ਆਮਦੰਦ ॥",
      "s": 15
    },
    {
      "t": "ਮਯਾਂ ਤੇਗ਼ੁ ਤੀਰੋ ਤੁਫ਼ੰਗ ਆਮਦੰਦ ॥੨੦॥",
      "s": 15
    },
    {
      "t": "ਬ ਲਾਚਾਰਗੀ ਦਰਮਯਾਂ ਆਮਦੰਦ ॥",
      "s": 15
    },
    {
      "t": "ਬ ਤਦਬੀਰਿ ਤੀਰੋ ਤੁਫ਼ੰਗ ਆਮਦੰਦ ॥੨੧॥",
      "s": 15
    },
    {
      "t": "ਚੁਂ ਕਾਰ ਅਜ਼ ਹਮਾ ਹੀਲਤੇ ਦਰ ਗੁਜ਼ਸ਼ਤ ॥",
      "s": 15
    },
    {
      "t": "ਹਲਾਲ ਅਸਤ ਬੁਰਦਨ ਬ ਸ਼ਮਸ਼ੀਰ ਦਸਤ ॥੨੨॥",
      "s": 15
    },
    {
      "t": "ਚਿ ਕਸਮਿ ਕੁਰਆ ਮਨ ਕੁਨਮ ਏਤਬਾਰ ॥",
      "s": 15
    },
    {
      "t": "ਵਗਰਨਹ ਤੁ ਗੋਈ ਮਨ ਈਂ ਰਹ ਚਿ ਕਾਰ ॥੨੩॥",
      "s": 15
    },
    {
      "t": "ਨ ਦਾਨਮ ਕਿ ਈਂ ਮਰਦਿ ਰੋਬਾਹਿ ਪੇਚ ॥",
      "s": 15
    },
    {
      "t": "ਵਗਰ ਹਰਗਿਜ਼ੀਂ ਰਾਹ ਨਿਯਾਰਦ ਬਹੇਚ ॥੨੪॥",
      "s": 15
    },
    {
      "t": "ਹਰਾਂ ਕਸ ਕਿ ਕਉਲੇ ਕੁਰਾਂ ਆਯਦਸ਼ ॥",
      "s": 15
    },
    {
      "t": "ਨਜ਼ੋ ਬਸਤਨੋ ਕੁਸ਼ਤਨੋ ਆਯਦਸ਼ ॥੨੫॥",
      "s": 15
    },
    {
      "t": "ਬਰੰਗੇ ਮਗਸ ਸਯਾਹਪੋਸ਼ ਆਮਦੰਦ ॥",
      "s": 15
    },
    {
      "t": "ਬ ਯਕ ਬਾਰਗੀ ਦਰ ਖ਼ਰੋਸ਼ ਆਮਦੰਦ ॥੨੬॥",
      "s": 15
    },
    {
      "t": "ਹਰਾਂ ਕਸ ਜ਼ਿ ਦੀਵਾਰ ਆਮਦ ਬਿਰੂੰ ॥",
      "s": 15
    },
    {
      "t": "ਬਖ਼ੁਰਦਨ ਯਕੇ ਤੀਰ ਸ਼ੁਦ ਗ਼ਰਕਿ ਖ਼ੂੰ ॥੨੭॥",
      "s": 15
    },
    {
      "t": "ਕਿ ਬੇਰੂੰ ਨਿਆਮਦ ਕਸੇ ਜ਼ਾ ਦੀਵਾਰ ॥",
      "s": 15
    },
    {
      "t": "ਨ ਖ਼ੁਰਦੰਦ ਤੀਰੋ ਨ ਗ਼ਸ਼ਤੰਦ ਖ਼੍ਵਾਰ ॥੨੮॥",
      "s": 15
    },
    {
      "t": "ਚੁ ਦੀਦਮ ਕਿ ਨਾਹਰ ਬਿਆਮਦ ਬ ਜੰਗ ॥",
      "s": 15
    },
    {
      "t": "ਚਸ਼ੀਦਹ ਯਕੇ ਤੀਰ ਮਨ ਬੇਦਰੰਗ ॥੨੯॥",
      "s": 15
    },
    {
      "t": "ਹਮਾਖ਼ਰ ਗੁਰੇਜ਼ੰਦ ਬਜਾਏ ਮਸਾਫ਼ ॥",
      "s": 15
    },
    {
      "t": "ਬਸੇ ਖ਼ਾਨ ਗਰਦੰਦ ਬੇਰੂੰ ਗੁਜ਼ਾਫ਼ ॥੩੦॥",
      "s": 15
    },
    {
      "t": "ਕਿ ਅਫ਼ਗ਼ਾਨਿ ਦੀਗਰ ਬਿਆਮਦ ਬ ਜੰਗ ॥",
      "s": 15
    }
  ]
}
