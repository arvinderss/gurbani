{
  "page": 1391,
  "lines": [
    {
      "t": "ਚੁ ਸੈਲੇ ਰਵਾਂ ਹਮਚੂੰ ਤੀਰੋ ਤੁਫ਼ੰਗ ॥੩੧॥",
      "s": 15
    },
    {
      "t": "ਬਸੇ ਹਮਲਾ ਕਰਦੰਦ ਬ ਮਰਦਾਨਗੀ ॥",
      "s": 15
    },
    {
      "t": "ਹਮ ਅਜ਼ ਹੋਸ਼ਗੀ ਹਮਅਜ਼ ਦੀਵਾਨਗੀ ॥੩੨॥",
      "s": 15
    },
    {
      "t": "ਬਸੇ ਹਮਲਾ ਕਰਦੰਦ ਬਸੇ ਜ਼ਖ਼ਮ ਖ਼ੁਰਦ ॥",
      "s": 15
    },
    {
      "t": "ਦੁ ਕਸ ਰਾ ਬਜ਼ਾਂ ਕੁਸ਼ਤ ਹਮ ਜਾਂ ਸਪੁਰਦ ॥੩੩॥",
      "s": 15
    },
    {
      "t": "ਕਿ ਆਂ ਖ਼੍ਵਾਜਾ ਮਰਦੂਦ ਸਾਯਹ ਦੀਵਾਰ ॥",
      "s": 15
    },
    {
      "t": "ਬਮੈਦਾਂ ਨਿਆਮਦ ਬਮਰਦਾਨਹ ਵਾਰ ॥੩੪॥",
      "s": 15
    },
    {
      "t": "ਦਰੇਗ਼ਾ ਅਗਰ ਰੂਇ ਓ ਦੀਦਮੇ ॥",
      "v": [
        [
          0,
          1
        ]
      ],
      "s": 15
    },
    {
      "t": "ਬਯਕ ਤੀਰ ਲਾਚਾਰ ਬਖ਼ਸ਼ੀਦਮੇ ॥੩੫॥",
      "s": 15
    },
    {
      "t": "ਹਮਾਖ਼ਰ ਬਸੇ ਜ਼ਖ਼ਮਿ ਤੀਰੋ ਤੁਫ਼ੰਗ ॥",
      "s": 15
    },
    {
      "t": "ਦੁਸੂਏ ਬਸੇ ਕੁਸ਼ਤਹ ਸ਼ੁਦ ਬੇਦਰੰਗ ॥੩੬॥",
      "s": 15
    },
    {
      "t": "ਬਸੇ ਬਾਰ ਬਾਰੀਦ ਤੀਰੋ ਤੁਫ਼ੰਗ ॥",
      "s": 15
    },
    {
      "t": "ਜ਼ਿਮੀਂ ਗਸ਼ਤ ਹਮਚੂੰ ਗੁਲੇ ਲਾਲਹ ਰੰਗ ॥੩੭॥",
      "s": 15
    },
    {
      "t": "ਸਰੋ ਪਾਇ ਅੰਬੋਹੁ ਚੰਦਾਂ ਸ਼ੁਦਹ ॥",
      "s": 15
    },
    {
      "t": "ਕਿ ਮੈਦਾਂ ਪੁਰਜ਼ ਗੋਇ ਚੌਗਾਂ ਸ਼ੁਦਹ ॥੩੮॥",
      "s": 15
    },
    {
      "t": "ਤਰੰਕਾਰਿ ਤੀਰੋ ਤੁਫ਼ੰਗੋ ਕਮਾਂ ॥",
      "s": 15
    },
    {
      "t": "ਬਰਾਮਦ ਯਕੇ ਹਾ ਓ ਹੂ ਅਜ਼ ਜਹਾਂ ॥੩੯॥",
      "s": 15
    },
    {
      "t": "ਦਿਗਰ ਸ਼ੋਰਸ਼ੇ ਕੈਬਰੇ ਕੀਨਹ ਕੋਸ਼ ॥",
      "s": 15
    },
    {
      "t": "ਜ਼ਿ ਮਰਦਾਨਿ ਮਰਦਾਂ ਬਰੂੰ ਰਫ਼ਤ ਹੋਸ਼ ॥੪੦॥",
      "s": 15
    },
    {
      "t": "ਹਮਾਖ਼ਰ ਚਿ ਮਰਦੀ ਕੁਨਦ ਕਾਰਜ਼ਾਰ ॥",
      "s": 15
    },
    {
      "t": "ਕਿ ਬਰ ਚਿਹਲ ਤਨ ਆਯਦਸ਼ ਬੇਸ਼ੁਮਾਰ ॥੪੧॥",
      "s": 15
    },
    {
      "t": "ਚਰਾਗ਼ੇ ਜਹਾਂ ਚੂੰ ਸ਼ੁਦਹ ਬੁਰਕਾ ਪੋਸ਼ ॥",
      "s": 15
    },
    {
      "t": "ਸ਼ਹੇ ਸ਼ਬ ਬਰਾਮਦ ਹਮਹ ਜਲਵਾ ਜੋਸ਼ ॥੪੨॥",
      "s": 15
    },
    {
      "t": "ਹਰਾਂ ਕਸ ਕਿ ਕਉਲੇ ਕੁਰਆਂ ਆਯਦਸ਼ ॥",
      "s": 15
    },
    {
      "t": "ਕਿ ਯਜ਼ਦਾਂ ਬਰੋ ਰਹਿਨੁਮਾ ਆਯਦਸ਼ ॥੪੩॥",
      "s": 15
    },
    {
      "t": "ਨ ਪੇਚੀਦਾ ਮੂਇ ਨ ਰੰਜੀਦਹ ਤਨ ॥",
      "s": 15
    },
    {
      "t": "ਕਿ ਬੇਰੂੰ ਖ਼ੁਦਾਵਰਦ ਦੁਸ਼ਮਨ ਸ਼ਿਕਨ ॥੪੪॥",
      "s": 15
    },
    {
      "t": "ਨ ਦਾਨਮ ਕਿ ਈਂ ਮਰਦਿ ਪੈਮਾਂ ਸ਼ਿਕਨ ॥",
      "s": 15
    },
    {
      "t": "ਕਿ ਦੌਲਤ ਪ੍ਰਸਤਸਤੁ ਈਮਾਂ ਫ਼ਿਗਨ ॥੪੫॥",
      "s": 15
    },
    {
      "t": "ਨ ਈਮਾਂ ਪ੍ਰਸਤੀ ਨ ਅਉਜ਼ਾਇ ਦੀਂ ॥",
      "s": 15
    },
    {
      "t": "ਨ ਸਾਹਿਬ ਸ਼ਨਾਸੀ ਨ ਮੁਹੰਮਦ ਯਕੀਂ ॥੪੬॥",
      "s": 15
    },
    {
      "t": "ਹਰਾਂ ਕਸ ਕਿ ਈਮਾਂ ਪ੍ਰਸਤੀ ਕੁਨਦ ॥",
      "s": 15
    },
    {
      "t": "ਨ ਪੈਮਾਂ ਖ਼ੁਦਸ਼ ਪੇਸ਼ੋ ਪਸਤੀ ਕੁਨਦ ॥੪੭॥",
      "s": 15
    },
    {
      "t": "ਈਂ ਮਰਦ ਰਾ ਜ਼ੱਰਹ ਏਤਬਾਰ ਨੇਸਤ ॥",
      "s": 15
    },
    {
      "t": "ਚਿ ਕਸਮੇ ਕੁਰਾਨਸਤ ਯਜ਼ਦਾਂ ਯਕੇਸਤ ॥੪੮॥",
      "s": 15
    },
    {
      "t": "ਚੁ ਕਸਮਿ ਕੁਰਾਂ ਸਦ ਕੁਨਦ ਇਖ਼ਤਯਾਰ ॥",
      "s": 15
    },
    {
      "t": "ਮਰਾ ਕਤਰਹ ਨਆਯਦ ਅਜ਼ੋ ਏਤਬਾਰ ॥੪੯॥",
      "s": 15
    },
    {
      "t": "ਅਗਰਚਿ ਤੁਰਾ ਏਅਤਬਾਰ ਆਮਦੇ ॥",
      "s": 15
    },
    {
      "t": "ਕਮਰ ਬਸਤਏ ਪੇਸ਼ਵਾ ਆਮਦੇ ॥੫੦॥",
      "s": 15
    },
    {
      "t": "ਕਿ ਫ਼ਰਜ਼ਸਤ ਬਰਸਰਿ ਤੁਰਾ ਈਂ ਸੁਖ਼ਨ ॥",
      "s": 15
    },
    {
      "t": "ਕਿ ਕਉਲੇ ਖ਼ੁਦਾ ਅਸਤ ਕਸਮਸਤ ਮਨ ॥੫੧॥",
      "s": 15
    },
    {
      "t": "ਅਗਰ ਹਜ਼ਰਤਿ ਖ਼ੁਦ ਸਿਤਾਦਾ ਸ਼ਵਦ ॥",
      "s": 15
    },
    {
      "t": "ਬਜਾਨਿ ਦਿਲੇ ਕਾਰ ਵਾਜ਼ੇਹ ਸ਼ਵਦ ॥੫੨॥",
      "s": 15
    },
    {
      "t": "ਸ਼ੁਮਾ ਰਾ ਚੁ ਫ਼ਰਜ਼ਸਤੁ ਕਾਰੇ ਕੁਨੀ ॥",
      "s": 15
    },
    {
      "t": "ਬਮੂਜਬ ਨਵਿਸ਼ਤਾ ਸ਼ੁਮਾਰੇ ਕੁਨੀ ॥੫੩॥",
      "s": 15
    },
    {
      "t": "ਨਵਿਸ਼ਤਾ ਰਸੀਦੋ ਬਿਗੁਫ਼ਤਹ ਜ਼ੁਬਾਂ ॥",
      "s": 15
    },
    {
      "t": "ਬਬਾਯਦ ਕਿ ਕਾਰੀਂ ਬਰਾਹਤ ਰਸਾਂ ॥੫੪॥",
      "s": 15
    },
    {
      "t": "ਹਮੂੰ ਮਰਦ ਬਾਯਦ ਸ਼ਵਦ ਸੁਖ਼ਨਵਰ ॥",
      "s": 15
    }
  ]
}
