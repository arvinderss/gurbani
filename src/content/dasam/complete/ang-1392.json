{
  "page": 1392,
  "lines": [
    {
      "t": "ਨ ਸ਼ਿਕਮੇ ਦਿਗਰ ਦਰ ਦਹਾਨੇ ਦਿਗਰ ॥੫੫॥",
      "s": 15
    },
    {
      "t": "ਕਿ ਕਾਜ਼ੀ ਮਰਾ ਗੁਫ਼ਤਹ ਬੇਰੂੰ ਨਯਮ ॥",
      "s": 15
    },
    {
      "t": "ਅਗਰ ਰਾਸਤੀ ਖ਼ੁਦ ਬਿਯਾਰੀ ਕਦਮ ॥੫੬॥",
      "s": 15
    },
    {
      "t": "ਤੁਰਾ ਗਰ ਬਬਾਯਦ ੳਾਂ ਕਉਲੇ ਕੁਰਾਂ ॥",
      "s": 15
    },
    {
      "t": "ਬਨਿਜ਼ਦੇ ਸ਼ੁਮਾ ਰਾ ਰਸਾਨਮ ਹਮਾ ॥੫੭॥",
      "s": 15
    },
    {
      "t": "ਕਿ ਤਸ਼ਰੀਫ ਦਰ ਕਸਬਹ ਕਾਂਗੜ ਕੁਨਦ ॥",
      "s": 15
    },
    {
      "t": "ਵਜ਼ਾਂ ਪਸ ਮੁਲਾਕਾਤ ਬਾਹਮ ਸ਼ਵਦ ॥੫੮॥",
      "s": 15
    },
    {
      "t": "ਨ ਜ਼ੱਰਹ ਦਰੀਂ ਰਾਹਿ ਖ਼ਤਰਾ ਤੁਰਾਸਤ ॥",
      "s": 15
    },
    {
      "t": "ਹਮਹ ਕੌਮਿ ਬੈਰਾੜ ਹੁਕਮੇ ਮਰਾਸਤ ॥੫੯॥",
      "s": 15
    },
    {
      "t": "ਬਯਾ ਤਾ ਸੁਖ਼ਨ ਖ਼ੁਦ ਜ਼ੁਬਾਨੀ ਕੁਨੇਮ ॥",
      "s": 15
    },
    {
      "t": "ਬਰੂਇ ਸ਼ੁਮਾ ਮਿਹਰਬਾਨੀ ਕੁਨੇਮ ॥੬੦॥",
      "s": 15
    },
    {
      "t": "ਯਕੇ ਅਸਪ ਸ਼ਾਇਸਤਏ ਯਕ ਹਜ਼ਾਰ ॥",
      "s": 15
    },
    {
      "t": "ਬਯਾ ਤਾ ਬਗੀਰੀ ਬ ਮਨ ਈਂ ਦਯਾਰ ॥੬੧॥",
      "s": 15
    },
    {
      "t": "ਸ਼ਹਿਨਸ਼ਾਹ ਰਾ ਬੰਦਹਏ ਚਾਕਰੇਮ ॥",
      "s": 15
    },
    {
      "t": "ਅਗਰ ਹੁਕਮ ਆਯਦ ਬਜਾਂ ਹਾਜ਼ਰੇਮ ॥੬੨॥",
      "s": 15
    },
    {
      "t": "ਗਰਚਿ ਬਿਆਯਦ ਬ ਫ਼ੁਰਮਾਨਿ ਮਨ ॥",
      "s": 15
    },
    {
      "t": "ਹਜ਼ੂਰਤੁ ਬਿਆਯਮ ਹਮਹ ਜਾਨੋ ਤਨ ॥੬੩॥",
      "s": 15
    },
    {
      "t": "ਅਗਰ ਤੂ ਬਯਜ਼ਦਾਂ ਪ੍ਰਸਤੀ ਕੁਨੀ ॥",
      "s": 15
    },
    {
      "t": "ਬ ਕਾਰੇ ਮਰਾ ਈਂ ਨ ਸੁਸਤੀ ਕੁਨੀ ॥੬੪॥",
      "s": 15
    },
    {
      "t": "ਬਬਾਯਦ ਕਿ ਯਜ਼ਦਾਂ ਸ਼ਨਾਸੀ ਕੁਨੀ ॥",
      "s": 15
    },
    {
      "t": "ਨ ਗ਼ੁਫ਼ਤਹ ਕਸੇ ਕਸ ਖ਼ਰਾਸ਼ੀ ਕੁਨੀ ॥੬੫॥",
      "s": 15
    },
    {
      "t": "ਤੂ ਮਸਨਦ ਨਸ਼ੀਂ ਸਰਵਰਿ ਕਾਯਨਾਤ ॥",
      "s": 15
    },
    {
      "t": "ਕਿ ਅਜਬਸਤ ਇਨਸਾਫ਼ ਈਂ ਹਮ ਸਿਫ਼ਾਤ ॥੬੬॥",
      "s": 15
    },
    {
      "t": "ਕਿ ਅਜਬਸਤੁ ਇਨਸਾਫ਼ੋ ਦੀਂ ਪਰਵਰੀ ॥",
      "s": 15
    }
  ]
}
