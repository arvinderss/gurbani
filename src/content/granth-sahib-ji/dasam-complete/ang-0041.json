{
  "page": 41,
  "lines": [
    {
      "t": "ਕਰੰ ਬਾਮ ਚਾਪਿਯੰ ਕ੍ਰਿਪਾਣੰ ਕਰਾਲੰ ॥",
      "s": 2
    },
    {
      "t": "ਮਹਾ ਤੇਜ ਤੇਜੰ ਬਿਰਾਜੈ ਬਿਸਾਲੰ ॥",
      "s": 2
    },
    {
      "t": "ਮਹਾਂ ਦਾੜ੍ਹ ਦਾੜ੍ਹੰ ਸੁ ਸੋਹੰ ਅਪਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਨੈ ਚਰਬੀਯੰ ਜੀਵ ਜੱਗ੍ਯੰ ਹਜਾਰੰ ॥੧੮॥",
      "s": 2
    },
    {
      "t": "ਡਮਾਡੱਮ ਡਉਰੂ ਸਿਤਾ ਸੇਤ ਛਤ੍ਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਹਾਹਾ ਹੂਹੂ ਹਾਸੰ ਝਮਾਝੱਮ ਅਤ੍ਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਮਹਾ ਘੋਰ ਸਬਦੰ ਬਜੇ ਸੰਖ ਐਸੇ ॥",
      "s": 2
    },
    {
      "t": "ਪ੍ਰਲੈ ਕਾਲ ਕੇ ਕਾਲ ਕੀ ਜ੍ਵਾਲ ਜੈਸੇ ॥੧੯॥",
      "s": 2
    },
    {
      "t": "ਰਸਾਵਲ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਘਣੰ ਘੰਟ ਬਾਜੰ ॥",
      "s": 2
    },
    {
      "t": "ਧੁਣੰ ਮੇਘ ਲਾਜੰ ॥",
      "s": 2
    },
    {
      "t": "ਭਯੋ ਸੱਦ ਏਵੰ ॥",
      "s": 2
    },
    {
      "t": "ਹੜਿਓ ਨੀਰਧੇਵੰ ॥੨੦॥",
      "s": 2
    },
    {
      "t": "ਘੁਰੰ ਘੁੰਘਰੇਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਧੁਣੰ ਨੇਵਰੇਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਮਹਾ ਨਾਦ ਨਾਦੰ ॥",
      "s": 2
    },
    {
      "t": "ਸੁਰੰ ਨਿਰਬਿਖਾਦੰ ॥੨੧॥",
      "s": 2
    },
    {
      "t": "ਸਿਰੰ ਮਾਲ ਰਾਜੰ ॥",
      "s": 2
    },
    {
      "t": "ਲਖੇ ਰੁਦ੍ਰ ਲਾਜੰ ॥",
      "s": 2
    },
    {
      "t": "ਸੁਭੰ ਚਾਰ ਚਿੱਤ੍ਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਪਰਮੰ ਪਵਿਤ੍ਰੰ ॥੨੨॥",
      "s": 2
    },
    {
      "t": "ਮਹਾ ਗਰਜ ਗਰਜੰ ॥",
      "s": 2
    },
    {
      "t": "ਸੁਨੈ ਦੂਤ ਲਰਜੰ ॥",
      "s": 2
    },
    {
      "t": "ਸ੍ਰਵੰ ਸ੍ਰੌਣ ਸੋਹੰ ॥",
      "s": 2
    },
    {
      "t": "ਮਹਾ ਮਾਨ ਮੋਹੰ ॥੨੩॥",
      "s": 2
    },
    {
      "t": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਸ੍ਰਿਜੇ ਸੇਤਜੰ ਜੇਰਜੰ ਉਤਭੁਜੇਵੰ ॥",
      "s": 2
    },
    {
      "t": "ਰਚੇ ਅੰਡਜੰ ਖੰਡ ਬ੍ਰਹਮੰਡ ਏਵੰ ॥",
      "s": 2
    },
    {
      "t": "ਦਿਸਾ ਬਿਦਿਸਾਯੰ ਜਿਮੀ ਆਸਮਾਣੰ ॥",
      "s": 2
    },
    {
      "t": "ਚਤੁਰ ਬੇਦ ਕਥਿਅੰ ਕੁਰਾਣੰ ਪੁਰਾਣੰ ॥੨੪॥",
      "s": 2
    },
    {
      "t": "ਰਚੇ ਰੈਣ ਦਿਵਸੰ ਥਪੇ ਸੂਰ ਚੰਦੰ ॥",
      "s": 2
    },
    {
      "t": "ਠਟੇ ਦਈਵ ਦਾਨੋ ਰਚੇ ਬੀਰ ਬ੍ਰਿੰਦੰ ॥",
      "s": 2
    },
    {
      "t": "ਕਰੀ ਲੋਹ ਕਲਮੰ ਲਿਖਿਓ ਲੇਖ ਮਾਥੰ ॥",
      "s": 2
    },
    {
      "t": "ਸਬੈ ਜੇਰ ਕੀਨੇ ਬਲੀ ਕਾਲ ਹਾਥੰ ॥੨੫॥",
      "s": 2
    },
    {
      "t": "ਕਈ ਮੇਟ ਡਾਰੇ ਉਸਾਰੇ ਬਨਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਉਪਾਰੇ ਗੜੇ ਫੇਰ ਮੇਟੇ ਉਪਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਕ੍ਰਿਯਾ ਕਾਲ ਜੂ ਕੀ ਕਿਨੂ ਨ ਪਛਾਨੀ ॥",
      "s": 2
    },
    {
      "t": "ਘਨਿਯੋ ਪੈ ਬਿਹੈਹੈ ਘਨਿਯੋ ਪੈ ਬਿਹਾਨੀ ॥੨੬॥",
      "s": 2
    },
    {
      "t": "ਕਿਤੇ ਕ੍ਰਿਸਨ ਸੇ ਕੀਟ ਕੋਟੈ ਬਨਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਕਿਤੇ ਰਾਮ ਸੇ ਮੇਟਿ ਡਾਰੇ ਉਪਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਮਹਾਦੀਨ ਕੇਤੇ ਪ੍ਰਿਥੀ ਮਾਂਝ ਹੂਏ ॥",
      "s": 2
    },
    {
      "t": "ਸਮੈ ਆਪਨੀ ਆਪਨੀ ਅੰਤ ਮੂਏ ॥੨੭॥",
      "s": 2
    },
    {
      "t": "ਜਿਤੇ ਅਉਲੀਆ ਅੰਬੀਆ ਹੋਇ ਬੀਤੇ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਤਿਓ ਕਾਲ ਜੀਤਾ ਨ ਤੇ ਕਾਲ ਜੀਤੇ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਤੇ ਰਾਮ ਸੇ ਕ੍ਰਿਸਨ ਹੁਇ ਬਿਸਨ ਆਏ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਤਿਓ ਕਾਲ ਖਾਪਿਓ ਨ ਤੇ ਕਾਲ ਘਾਏ ॥੨੮॥",
      "s": 2
    },
    {
      "t": "ਜਿਤੇ ਇੰਦ੍ਰ ਸੇ ਚੰਦ੍ਰ ਸੇ ਹੋਤ ਆਏ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਤਿਓ ਕਾਲ ਖਾਪਾ ਨ ਤੇ ਕਾਲ ਘਾਏ ॥",
      "s": 2
    }
  ]
}
