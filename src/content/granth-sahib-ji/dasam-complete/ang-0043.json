{
  "page": 43,
  "lines": [
    {
      "t": "ਸੁ ਸੋਭ ਨਾਗ ਭੂਖਣੰ ॥",
      "s": 2
    },
    {
      "t": "ਅਨੇਕ ਦੁਸਟ ਦੂਖਣੰ ॥੪੬॥",
      "s": 2
    },
    {
      "t": "ਕ੍ਰਿਪਾਣ ਪਾਣ ਧਾਰੀਅੰ ॥",
      "s": 2
    },
    {
      "t": "ਕਰੋਰ ਪਾਪ ਟਾਰੀਅੰ ॥",
      "s": 2
    },
    {
      "t": "ਗਦਾ ਗ੍ਰਿਸਟ ਪਾਣਿਅੰ ॥",
      "s": 2
    },
    {
      "t": "ਕਮਾਣ ਬਾਣ ਤਾਣਿਅੰ ॥੪੭॥",
      "s": 2
    },
    {
      "t": "ਸਬਦ ਸੰਖ ਬੱਜਿਅੰ ॥",
      "s": 2
    },
    {
      "t": "ਘਣੰਕਿ ਘੁੰਘਰ ਗੱਜਿਅੰ ॥",
      "s": 2
    },
    {
      "t": "ਸਰਨ ਨਾਥ ਤੋਰੀਅੰ ॥",
      "s": 2
    },
    {
      "t": "ਉਬਾਰ ਲਾਜ ਮੋਰੀਅੰ ॥੪੮॥",
      "s": 2
    },
    {
      "t": "ਅਨੇਕ ਰੂਪ ਸੋਹੀਅੰ ॥",
      "s": 2
    },
    {
      "t": "ਬਿਸੇਖ ਦੇਵ ਮੋਹੀਅੰ ॥",
      "s": 2
    },
    {
      "t": "ਅਦੇਵ ਦੇਵ ਦੇਵਲੰ ॥",
      "s": 2
    },
    {
      "t": "ਕ੍ਰਿਪਾ ਨਿਧਾਨ ਕੇਵਲੰ ॥੪੯॥",
      "s": 2
    },
    {
      "t": "ਸੁ ਆਦਿ ਅੰਤ ਏਕਿਅੰ ॥",
      "s": 2
    },
    {
      "t": "ਧਰੇ ਸੁ ਰੂਪ ਅਨੇਕਿਅੰ ॥",
      "s": 2
    },
    {
      "t": "ਕ੍ਰਿਪਾਣ ਪਾਣ ਰਾਜਈ ॥",
      "s": 2
    },
    {
      "t": "ਬਿਲੋਕ ਪਾਪ ਭਾਜਈ ॥੫੦॥",
      "s": 2
    },
    {
      "t": "ਅਲੰਕ੍ਰਿਤੰ ਸੁ ਦੇਹਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਤਨੋ ਮਨੋ ਕਿ ਮੋਹਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਕਮਾਣ ਬਾਣ ਧਾਰਹੀ ॥",
      "s": 2
    },
    {
      "t": "ਅਨੇਕ ਸੱਤ੍ਰੁ ਟਾਰਹੀ ॥੫੧॥",
      "s": 2
    },
    {
      "t": "ਘਮੱਕਿ ਘੁੰਘਰੰ ਸੁਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਨਵੰ ਨਿਨਾਦ ਨੂਪਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਪ੍ਰਜ੍ਵਾਲ ਬਿੱਜੁਲੰ ਜ੍ਵਲੰ ॥",
      "s": 2
    },
    {
      "t": "ਪਵਿਤ੍ਰ ਪਰਮ ਨਿਰਮਲੰ ॥੫੨॥",
      "s": 2
    },
    {
      "t": "ਤੋਟਕ ਛੰਦ ॥ ਤ੍ਵ ਪ੍ਰਸਾਦਿ ॥",
      "s": 2
    },
    {
      "t": "ਨਵ ਨੇਵਰ ਨਾਦ ਸੁਰੰ ਨ੍ਰਿਮਲੰ ॥",
      "s": 2
    },
    {
      "t": "ਮੁਖ ਬਿੱਜੁਲ ਜ੍ਵਾਲ ਘਣੰ ਪ੍ਰਜੁਲੰ ॥",
      "s": 2
    },
    {
      "t": "ਮਦਰਾ ਕਰ ਮੱਤ ਮਹਾ ਭਭਕੰ ॥",
      "s": 2
    },
    {
      "t": "ਬਨ ਮੈ ਮਨੋ ਬਾਘ ਬਚਾ ਬਬਕੰ ॥੫੩॥",
      "s": 2
    },
    {
      "t": "ਭਵ ਭੂਤ ਭਵਿੱਖ ਭਵਾਨ ਭਵੰ ॥",
      "s": 2
    },
    {
      "t": "ਕਲ ਕਾਰਣ ਉਬਾਰਨ ਏਕ ਤੁਵੰ ॥",
      "s": 2
    },
    {
      "t": "ਸਭ ਠੌਰ ਨਿਰੰਤਰ ਨਿੱਤ ਨਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਮ੍ਰਿਦੁ ਮੰਗਲ ਰੂਪ ਤੁਯੰ ਸੁ ਭਯੰ ॥੫੪॥",
      "s": 2
    },
    {
      "t": "ਦਿੜ ਦਾੜ੍ਹ ਕਰਾਲ ਦ੍ਵੈ ਸੇਤ ਉਧੰ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਹ ਭਾਜਤ ਦੁਸਟ ਬਿਲੋਕ ਜੁਧੰ ॥",
      "s": 2
    },
    {
      "t": "ਮਦ ਮਤ ਕ੍ਰਿਪਾਣ ਕਰਾਲ ਧਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਜਯ ਸੱਦ ਸੁਰਾਸੁਰਯੰ ਉਚਰੰ ॥੫੫॥",
      "s": 2
    },
    {
      "t": "ਨਵ ਕਿੰਕਣ ਨੇਵਰ ਨਾਦ ਹੂਅੰ ॥",
      "s": 2
    },
    {
      "t": "ਚਲ ਚਾਲ ਸਭਾਚਲ ਕੰਪ ਭੂਅੰ ॥",
      "s": 2
    },
    {
      "t": "ਘਣ ਘੁੰਘਰ ਘੰਟਣ ਘੋਰ ਸੁਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਚਰ ਚਾਰ ਚਰਾਚਰਯੰ ਹੁਹਰੰ ॥੫੬॥",
      "s": 2
    },
    {
      "t": "ਚਲ ਚੌਦਹੂੰ ਚੱਕ੍ਰਨ ਚੱਕ੍ਰ ਫਿਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਬਢਵੰ ਘਟਵੰ ਹਰੀਅੰ ਸੁਭਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਜਗ ਜੀਵ ਜਿਤੇ ਜਲਯੰ ਥਲਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਅਸ ਕੋ ਜੁ ਤਵਾਇਸੁਅੰ ਮਲਯੰ ॥੫੭॥",
      "s": 2
    },
    {
      "t": "ਘਟ ਭਾਦਵ ਮਾਸ ਕੀ ਜਾਣ ਸੁਭੰ ॥",
      "s": 2
    }
  ]
}
