{
  "page": 47,
  "lines": [
    {
      "t": "ਬ੍ਰਹਮ ਜਪਿਓ ਅਰੁ ਸੰਭੁ ਥਪਿਓ ਤਿਹ ਤੇ ਤੁਹਿ ਕੋ ਕਿਨਹੂੰ ਨ ਬਚਾਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਕੋਟ ਕਰੀ ਤਪਸਾ ਦਿਨ ਕੋਟਿਕ ਕਾਹੂੰ ਨ ਕੌਡੀ ਕੋ ਕਾਮ ਕਢਾਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਕਾਮਕੁ ਮੰਤ੍ਰ ਕਸੀਰੇ ਕੇ ਕਾਮ ਨ ਕਾਲ ਕੋ ਘਾਉ ਕਿਨਹੂੰ ਨ ਬਚਾਯੋ ॥੯੭॥",
      "s": 2
    },
    {
      "t": "ਕਾਹੇ ਕੋ ਕੂਰ ਕਰੈ ਤਪਸਾ ਇਨ ਕੀ ਕੋਊ ਕੌਡੀ ਕੇ ਕਾਮ ਨ ਐਹੈ ॥",
      "s": 2
    },
    {
      "t": "ਤੋਹਿ ਬਚਾਇ ਸਕੈ ਕਹੁ ਕੈਸੇ ਕੈ ਆਪਨ ਘਾਵ ਬਚਾਇ ਨ ਐਹੈ ॥",
      "s": 2
    },
    {
      "t": "ਕੋਪ ਕਰਾਲ ਕੀ ਪਾਵਕ ਕੁੰਡ ਮੈ ਆਪ ਟੰਗਿਓ ਤਿਮ ਤੋਹਿ ਟੰਗੈਹੈ ॥",
      "s": 2
    },
    {
      "t": "ਚੇਤ ਰੇ ਚੇਤ ਅਜੋ ਜੀਅ ਮੈਂ ਜੜ ਕਾਲ ਕ੍ਰਿਪਾ ਬਿਨੁ ਕਾਮ ਨ ਐਹੈ ॥੯੮॥",
      "s": 2
    },
    {
      "t": "ਤਾਹਿ ਪਛਾਨਤ ਹੈ ਨ ਮਹਾ ਪਸੁ ਜਾ ਕੋ ਪ੍ਰਤਾਪੁ ਤਿਹੂੰ ਪੁਰ ਮਾਹੀ ॥",
      "s": 2
    },
    {
      "t": "ਪੂਜਤ ਹੈ ਪਰਮੇਸਰ ਕੈ ਜਿਹ ਕੇ ਪਰਸੈ ਪਰਲੋਕ ਪਰਾਹੀ ॥",
      "s": 2
    },
    {
      "t": "ਪਾਪ ਕਰੋ ਪਰਮਾਰਥ ਕੈ ਜਿਹ ਪਾਪਨ ਤੇ ਅਤਿ ਪਾਪ ਲਜਾਹੀ ॥",
      "s": 2
    },
    {
      "t": "ਪਾਇ ਪਰੋ ਪਰਮੇਸਰ ਕੇ ਜੜ ਪਾਹਨ ਮੈਂ ਪਰਮੇਸਰ ਨਾਹੀ ॥੯੯॥",
      "s": 2
    },
    {
      "t": "ਮੋਨ ਭਜੇ ਨਹੀ ਮਾਨ ਤਜੇ ਨਹੀ ਭੇਖ ਸਜੇ ਨਹੀ ਮੂੰਡ ਮੁੰਡਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਕੰਠ ਨ ਕੰਠੀ ਕਠੋਰ ਧਰੇ ਨਹੀ ਸੀਸ ਜਟਾਨ ਕੇ ਜੂਟ ਸੁਹਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਸਾਚੁ ਕਹੋਂ ਸੁਨ ਲੈ ਚਿਤ ਦੈ ਬਿਨੁ ਦੀਨ ਦਿਆਲ ਕੀ ਸਾਮ ਸਿਧਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਪ੍ਰੀਤਿ ਕਰੇ ਪ੍ਰਭੁ ਪਾਯਤ ਹੈ ਕ੍ਰਿਪਾਲ ਨ ਭੀਜਤ ਲਾਂਡ ਕਟਾਏ ॥੧੦੦॥",
      "s": 2
    },
    {
      "t": "ਕਾਗਦ ਦੀਪ ਸਭੈ ਕਰਿ ਕੈ ਅਰੁ ਸਾਤ ਸਮੁੰਦ੍ਰਨ ਕੀ ਮਸੁ ਕੈ ਹੋਂ ॥",
      "s": 2
    },
    {
      "t": "ਕਾਟ ਬਨਾਸਪਤੀ ਸਗਰੀ ਲਿਖਬੇ ਹੂੰ ਕੇ ਲੇਖਨ ਕਾਜ ਬਨੈ ਹੋਂ ॥",
      "s": 2
    },
    {
      "t": "ਸਾਰਸੁਤੀ ਬਕਤਾ ਕਰਿ ਕੈ ਜੁਗਿ ਕੋਟਿ ਗਨੇਸ ਕੈ ਹਾਥ ਲਿਖੈ ਹੋਂ ॥",
      "s": 2
    },
    {
      "t": "ਕਾਲ ਕ੍ਰਿਪਾਨ ਬਿਨਾ ਬਿਨਤੀ ਨ ਤਊ ਤੁਮ ਕੌ ਪ੍ਰਭੁ ਨੈਕ ਰਿਝੈ ਹੋਂ ॥੧੦੧॥",
      "s": 2
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਸ੍ਰੀ ਕਾਲ ਜੀ ਕੀ ਉਸਤਤਿ ਪ੍ਰਿਥਮ ਧਿਆਏ ਸੰਪੂਰਨ ਸੁਭਮ ਸਤੁ ॥੧॥ ਅਫਜੂ ॥",
      "s": 2
    },
    {
      "t": "ਕਵਿ ਬੰਸ ਵਰਣਨ ॥",
      "s": 2
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 2
    },
    {
      "t": "ਤੁਮਰੀ ਮਹਿਮਾ ਅਪਰ ਅਪਾਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਜਾ ਕਾ ਲਹਿਓ ਨ ਕਿਨਹੂੰ ਪਾਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਦੇਵ ਦੇਵ ਰਾਜਨ ਕੇ ਰਾਜਾ ॥",
      "s": 2
    },
    {
      "t": "ਦੀਨ ਦਇਆਲ ਗਰੀਬ ਨਿਵਾਜਾ ॥੧॥",
      "s": 2
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਮੂਕ ਉਚਰੈ ਸਾਸਤ੍ਰ ਖਟ ਪਿੰਗੁ ਗਿਰਨ ਚੜਿ ਜਾਇ ॥",
      "s": 2
    },
    {
      "t": "ਅੰਧ ਲਖੈ ਬਧਰੋ ਸੁਨੈ ਜੌ ਕਾਲ ਕ੍ਰਿਪਾ ਕਰਾਇ ॥੨॥",
      "s": 2
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 2
    },
    {
      "t": "ਕਹਾ ਬੁੱਧਿ ਪ੍ਰਭ ਤੁੱਛ ਹਮਾਰੀ ॥",
      "s": 2
    },
    {
      "t": "ਬਰਨ ਸਕੈ ਮਹਿਮਾ ਜੁ ਤਿਹਾਰੀ ॥",
      "s": 2
    },
    {
      "t": "ਹਮ ਨ ਸਕਤ ਕਰ ਸਿਫਤ ਤੁਮਾਰੀ ॥",
      "s": 2
    },
    {
      "t": "ਆਪ ਲੇਹੁ ਤੁਮ ਕਥਾ ਸੁਧਾਰੀ ॥੩॥",
      "s": 2
    },
    {
      "t": "ਕਹਾ ਲਗੈ ਇਹ ਕੀਟ ਬਖਾਨੈ ॥",
      "s": 2
    },
    {
      "t": "ਮਹਿਮਾ ਤੋਰ ਤੁਹੀ ਪ੍ਰਭ ਜਾਨੈ ॥",
      "s": 2
    },
    {
      "t": "ਪਿਤਾ ਜਨਮ ਜਿਮ ਪੂਤ ਨ ਪਾਵੈ ॥",
      "s": 2
    },
    {
      "t": "ਕਹਾ ਤਵਨ ਕਾ ਭੇਦ ਬਤਾਵੈ ॥੪॥",
      "s": 2
    },
    {
      "t": "ਤੁਮਰੀ ਪ੍ਰਭਾ ਤੁਮੈ ਬਨਿ ਆਈ ॥",
      "s": 2
    },
    {
      "t": "ਅਉਰਨ ਤੇ ਨਹੀ ਜਾਤ ਬਤਾਈ ॥",
      "s": 2
    },
    {
      "t": "ਤੁਮਰੀ ਕ੍ਰਿਪਾ ਤੁਮ ਹੂੰ ਪ੍ਰਭ ਜਾਨੋ ॥",
      "s": 2
    },
    {
      "t": "ਊਚ ਨੀਚ ਕਸ ਸਕਤ ਬਖਾਨੋ ॥੫॥",
      "s": 2
    },
    {
      "t": "ਸੇਸਨਾਗ ਸਿਰ ਸਹਸ ਬਨਾਈ ॥",
      "s": 2
    },
    {
      "t": "ਦ੍ਵੈ ਸਹੰਸ ਰਸਨਾਹੁ ਸੁਹਾਈ ॥",
      "s": 2
    },
    {
      "t": "ਰਟਤ ਅਬ ਲਗੇ ਨਾਮ ਅਪਾਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਤੁਮਰੋ ਤਊ ਨ ਪਾਵਤ ਪਾਰਾ ॥੬॥",
      "s": 2
    },
    {
      "t": "ਤੁਮਰੀ ਕ੍ਰਿਆ ਕਹਾਂ ਕੋਊ ਕਹੈ ॥",
      "s": 2
    },
    {
      "t": "ਸਮਝਤ ਬਾਤ ਉਰਝ ਮਤਿ ਰਹੈ ॥",
      "s": 2
    },
    {
      "t": "ਸੂਛਮ ਰੂਪ ਨ ਬਰਨਾ ਜਾਈ ॥",
      "s": 2
    },
    {
      "t": "ਬਿਰਧ ਸਰੂਪਹਿ ਕਹੋ ਬਨਾਈ ॥੭॥",
      "s": 2
    },
    {
      "t": "ਤੁਮਰੀ ਪ੍ਰੇਮ ਭਗਤਿ ਜਬ ਗਹਿਹੌ ॥",
      "s": 2
    },
    {
      "t": "ਛੋਰ ਕਥਾ ਸਭ ਹੀ ਤਬ ਕਹਿਹੌ ॥",
      "s": 2
    },
    {
      "t": "ਅਬ ਮੈ ਕਹੋ ਸੁ ਅਪਨੀ ਕਥਾ ॥",
      "s": 2
    },
    {
      "t": "ਸੋਢੀ ਬੰਸ ਉਪਜਿਯਾ ਜਥਾ ॥੮॥",
      "s": 2
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਪ੍ਰਿਥਮ ਕਥਾ ਸੰਛੇਪ ਤੇ ਕਹੋ ਸੁ ਹਿਤੁ ਚਿਤੁ ਲਾਇ ॥",
      "s": 2
    },
    {
      "t": "ਬਹੁਰ ਬਡੋ ਬਿਸਥਾਰ ਕੈ ਕਹਿਹੌ ਸਭੋ ਸੁਨਾਇ ॥੯॥",
      "s": 2
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 2
    },
    {
      "t": "ਪ੍ਰਿਥਮ ਕਾਲ ਜਬ ਕਰਾ ਪਸਾਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਓਅੰਕਾਰ ਤੇ ਸ੍ਰਿਸਟ ਉਪਾਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਕਾਲਸੈਣ ਪ੍ਰਿਥਮੈ ਭਇਓ ਭੂਪਾ ॥",
      "s": 2
    },
    {
      "t": "ਅਧਿਕ ਅਤੁਲ ਬਲਿ ਰੂਪ ਅਨੂਪਾ ॥੧੦॥",
      "s": 2
    },
    {
      "t": "ਕਾਲਕੇਤ ਦੂਸਰ ਭੂਅ ਭਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਕ੍ਰੂਰ ਬਰਸ ਤੀਸਰ ਜਗ ਠਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਕਾਲਧੁਜ ਚਤੁਰਥ ਨ੍ਰਿਪ ਸੋਹੈ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਹ ਤੇ ਭਇਓ ਜਗਤ ਸਭ ਕੋ ਹੈ ॥੧੧॥",
      "s": 2
    },
    {
      "t": "ਸਹਸਰਾਛ ਜਾ ਕੇ ਸੁਭ ਸੋਹੈਂ ॥",
      "s": 2
    },
    {
      "t": "ਸਹਸ ਪਾਦ ਜਾ ਕੇ ਤਨ ਮੋ ਹੈਂ ॥",
      "s": 2
    },
    {
      "t": "ਸੇਖਨਾਗ ਪਰ ਸੋਇਬੋ ਕਰੈ ॥",
      "s": 2
    },
    {
      "t": "ਜਗ ਤਹਿ ਸੇਖਸਾਇ ਉਚਰੈ ॥੧੨॥",
      "s": 2
    },
    {
      "t": "ਏਕ ਸ੍ਰਵਣ ਤੇ ਮੈਲ ਨਿਕਾਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਤਾ ਤੇ ਮਧੁ ਕੀਟਭ ਤਨ ਧਾਰਾ ॥",
      "s": 2
    }
  ]
}
