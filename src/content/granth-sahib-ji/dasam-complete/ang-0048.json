{
  "page": 48,
  "lines": [
    {
      "t": "ਦੁਤੀਯ ਕਾਨ ਤੇ ਮੈਲੁ ਨਿਕਾਰੀ ॥",
      "s": 2
    },
    {
      "t": "ਤਾ ਤੇ ਭਈ ਸ੍ਰਿਸਟਿ ਇਹ ਸਾਰੀ ॥੧੩॥",
      "s": 2
    },
    {
      "t": "ਤਿਨ ਕੋ ਕਾਲ ਬਹੁਰ ਬਧ ਕਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਨ ਕੋ ਮੇਦ ਸਮੁੰਦ ਮੋ ਪਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਚਿਕਨ ਤਾਸ ਜਲ ਪਰ ਤਿਰ ਰਹੀ ॥",
      "s": 2
    },
    {
      "t": "ਮੇਧਾ ਨਾਮ ਤਬਹਿ ਤੇ ਕਹੀ ॥੧੪॥",
      "s": 2
    },
    {
      "t": "ਸਾਧ ਕਰਮ ਜੇ ਪੁਰਖ ਕਮਾਵੈ ॥",
      "s": 2
    },
    {
      "t": "ਨਾਮ ਦੇਵਤਾ ਜਗਤ ਕਹਾਵੈ ॥",
      "s": 2
    },
    {
      "t": "ਕੁਕ੍ਰਿਤ ਕਰਮ ਜੇ ਜਗ ਮੈ ਕਰਹੀਂ ॥",
      "s": 2
    },
    {
      "t": "ਨਾਮ ਅਸੁਰ ਤਿਨ ਕੋ ਸਭ ਧਰਹੀਂ ॥੧੫॥",
      "s": 2
    },
    {
      "t": "ਬਹੁ ਬਿਥਾਰ ਕਹਾ ਲਗੈ ਬਖਾਨੀਅਤ ॥",
      "s": 2
    },
    {
      "t": "ਗ੍ਰੰਥ ਬਢਨ ਤੇ ਅਤਿ ਡਰੁ ਮਾਨੀਅਤ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਨ ਤੇ ਹੋਤ ਬਹੁਤ ਨ੍ਰਿਪ ਆਏ ॥",
      "s": 2
    },
    {
      "t": "ਦੱਛ ਪ੍ਰਜਾਪਤਿ ਜਿਨ ਉਪਜਾਏ ॥੧੬॥",
      "s": 2
    },
    {
      "t": "ਦਸ ਸਹੰਸ੍ਰ ਤਿਹਿ ਗ੍ਰਿਹ ਭਈ ਕੰਨਿਆ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਹ ਸਮਾਨ ਕਹ ਲਗੈ ਨ ਅੰਨਿਆ ॥",
      "s": 2
    },
    {
      "t": "ਕਾਲ ਕ੍ਰਿਆ ਐਸੀ ਤਹ ਭਈ ॥",
      "s": 2
    },
    {
      "t": "ਤੇ ਸਭ ਬਿਆਹਿ ਨਰੇਸਨ ਦਈ ॥੧੭॥",
      "s": 2
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਬਨਤਾ ਕਦਰੂ ਦਿਤਿ ਅਦਿਤਿ ਏ ਰਿਖ ਬਰੀ ਬਨਾਇ ॥",
      "s": 2
    },
    {
      "t": "ਨਾਗ ਨਾਗਰਿਪੁ ਦੇਵ ਸਭ ਦਈਤ ਲਏ ਉਪਜਾਇ ॥੧੮॥",
      "s": 2
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 2
    },
    {
      "t": "ਤਾ ਤੇ ਸੂਰਜ ਰੂਪ ਕੋ ਧਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਜਾ ਤੇ ਬੰਸ ਪ੍ਰਚੁਰ ਰਵਿ ਕਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਜੋ ਤਿਨ ਕੇ ਕਹਿ ਨਾਮ ਸੁਨਾਊ ॥",
      "s": 2
    },
    {
      "t": "ਕਥਾ ਬਢਨ ਤੇ ਅਧਿਕ ਡਰਾਊ ॥੧੯॥",
      "s": 2
    },
    {
      "t": "ਤਿਨ ਕੇ ਬੰਸ ਬਿਖੈ ਰਘੁ ਭਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਰਘੁਬੰਸਹਿ ਜਿਹ ਜਗਹਿ ਚਲਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਤਾ ਤੇ ਪੁਤ੍ਰ ਹੋਤ ਭਯੋ ਅਜ ਬਰ ॥",
      "s": 2
    },
    {
      "t": "ਮਹਾ ਰਥੀ ਅਰ ਮਹਾ ਧਨੁਰ ਧਰ ॥੨੦॥",
      "s": 2
    },
    {
      "t": "ਜਬ ਤਿਨ ਭੇਸ ਜੋਗ ਕੋ ਲਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਰਾਜ ਪਾਟ ਦਸਰਥ ਕੋ ਦਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਹੋਤ ਭਯੋ ਵਹ ਮਹਾ ਧਨੁਰ ਧਰ ॥",
      "s": 2
    },
    {
      "t": "ਤੀਨ ਤ੍ਰਿਆਨ ਬਰਾ ਜਿਹ ਰੁਚਿ ਕਰ ॥੨੧॥",
      "s": 2
    },
    {
      "t": "ਪ੍ਰਿਥਮ ਜਯੋ ਤਿਹ ਰਾਮ ਕੁਮਾਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਭਰਥ ਲੱਛਮਨ ਸਤ੍ਰੁਬਿਦਾਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਬਹੁਤ ਕਾਲ ਤਿਨ ਰਾਜ ਕਮਾਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਕਾਲ ਪਾਇ ਸੁਰਪੁਰਹਿ ਸਿਧਾਯੋ ॥੨੨॥",
      "s": 2
    },
    {
      "t": "ਸੀਅ ਸੁਤ ਬਹੁਰ ਭਏ ਦੁਇ ਰਾਜਾ ॥",
      "s": 2
    },
    {
      "t": "ਰਾਜ ਪਾਟ ਉਨਹੀ ਕਉ ਛਾਜਾ ॥",
      "s": 2
    },
    {
      "t": "ਮੱਦ੍ਰ ਦੇਸ ਏਸ੍ਵਰਜਾ ਬਰੀ ਜਬ ॥",
      "s": 2
    },
    {
      "t": "ਭਾਂਤਿ ਭਾਂਤਿ ਕੇ ਜੱਗ ਕੀਏ ਤਬ ॥੨੩॥",
      "s": 2
    },
    {
      "t": "ਤਹੀ ਤਿਨੇ ਬਾਧੇ ਦੁਇ ਪੁਰਵਾ ॥",
      "s": 2
    },
    {
      "t": "ਏਕ ਕਸੂਰ ਦੁਤੀਯ ਲਹੁਰਵਾ ॥",
      "s": 2
    },
    {
      "t": "ਅਧਿਕ ਪੁਰੀ ਤੇ ਦੋਊ ਬਿਰਾਜੀ ॥",
      "s": 2
    },
    {
      "t": "ਨਿਰਖ ਲੰਕ ਅਮਰਾਵਤਿ ਲਾਜੀ ॥੨੪॥",
      "s": 2
    },
    {
      "t": "ਬਹੁਤ ਕਾਲ ਤਿਨ ਰਾਜ ਕਮਾਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਜਾਲ ਕਾਲ ਤੇ ਅੰਤ ਫਸਾਯੋ ॥",
      "s": 2
    }
  ]
}
