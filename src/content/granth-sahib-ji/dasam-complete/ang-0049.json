{
  "page": 49,
  "lines": [
    {
      "t": "ਤਿਨ ਤੇ ਪੁੱਤ੍ਰ ਪੌਤ੍ਰ ਜੇ ਵਏ ॥",
      "s": 2
    },
    {
      "t": "ਰਾਜ ਕਰਤ ਇਹ ਜਗ ਕੋ ਭਏ ॥੨੫॥",
      "s": 2
    },
    {
      "t": "ਕਹਾ ਲਗੇ ਤੇ ਬਰਨ ਸੁਨਾਊਂ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਨ ਕੇ ਨਾਮ ਨ ਸੰਖ੍ਯਾ ਪਾਊਂ ॥",
      "s": 2
    },
    {
      "t": "ਹੋਤ ਚਹੂੰ ਜੁਗ ਮੈਂ ਜੇ ਆਏ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਨ ਕੇ ਨਾਮ ਨ ਜਾਤ ਗਨਾਏ ॥੨੬॥",
      "s": 2
    },
    {
      "t": "ਜੌ ਅਬ ਤਉ ਕਿਰਪਾ ਬਲ ਪਾਊਂ ॥",
      "s": 2
    },
    {
      "t": "ਨਾਮ ਜਥਾ ਮਤਿ ਭਾਖ ਸੁਨਾਊਂ ॥",
      "s": 2
    },
    {
      "t": "ਕਾਲਕੇਤੁ ਅਰ ਕਾਲਰਾਇ ਭਨ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਨ ਤੇ ਭਏ ਪੁਤ੍ਰ ਘਰ ਅਨਗਨ ॥੨੭॥",
      "s": 2
    },
    {
      "t": "ਕਾਲਕੇਤੁ ਭਯੋ ਬਲੀ ਅਪਾਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਕਾਲਰਾਇ ਜਿਨਿ ਨਗਰ ਨਿਕਾਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਭਾਜ ਸਨੌਢ ਦੇਸ ਤੇ ਗਏ ॥",
      "s": 2
    },
    {
      "t": "ਤਹੀ ਭੂਪਜਾ ਬਿਆਹਤ ਭਏ ॥੨੮॥",
      "s": 2
    },
    {
      "t": "ਤਿਹ ਤੇ ਪੁਤ੍ਰ ਭਯੋ ਜੋ ਧਾਮਾ ॥",
      "s": 2
    },
    {
      "t": "ਸੋਢੀਰਾਇ ਧਰਾ ਤਿਹਿ ਨਾਮਾ ॥",
      "s": 2
    },
    {
      "t": "ਵੰਸ ਸਨੌਢ ਤਾ ਦਿਨ ਤੇ ਥੀਆ ॥",
      "s": 2
    },
    {
      "t": "ਪਰਮ ਪਵਿਤ੍ਰ ਪੁਰਖ ਜੂ ਕੀਆ ॥੨੯॥",
      "s": 2
    },
    {
      "t": "ਤਾਂ ਤੇ ਪੁਤ੍ਰ ਪੌਤ੍ਰ ਹੋਇ ਆਏ ॥",
      "s": 2
    },
    {
      "t": "ਤੇ ਸੋਢੀ ਸਭ ਜਗਤ ਕਹਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਜਗ ਮੈ ਅਧਿਕ ਸੁ ਭਏ ਪ੍ਰਸਿੱਧਾ ॥",
      "s": 2
    },
    {
      "t": "ਦਿਨ ਦਿਨ ਤਿਨ ਕੇ ਧਨ ਕੀ ਬ੍ਰਿੱਧਾ ॥੩੦॥",
      "s": 2
    },
    {
      "t": "ਰਾਜ ਕਰਤ ਭਏ ਬਿਬਿਧ ਪ੍ਰਕਾਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਦੇਸ ਦੇਸ ਕੇ ਜੀਤ ਨ੍ਰਿਪਾਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਜਹਾਂ ਤਹਾਂ ਤਿਹ ਧਰਮ ਚਲਾਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਅੱਤ੍ਰ ਪੱਤ੍ਰ ਕਹ ਸੀਸ ਢੁਰਾਯੋ ॥੩੧॥",
      "s": 2
    },
    {
      "t": "ਰਾਜਸੂਅ ਬਹੁ ਬਾਰਨ ਕੀਏ ॥",
      "s": 2
    },
    {
      "t": "ਜੀਤ ਜੀਤ ਦੇਸੇਸ੍ਵਰ ਲੀਏ ॥",
      "s": 2
    },
    {
      "t": "ਬਾਜਮੇਧ ਬਹੁ ਬਾਰਨ ਕਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਸਕਲ ਕਲੂਖ ਨਿਜ ਕੁਲ ਕੇ ਹਰੇ ॥੩੨॥",
      "s": 2
    },
    {
      "t": "ਬਹੁਰ ਬੰਸ ਮੈ ਬਢੋ ਬਿਖਾਧਾ ॥",
      "s": 2
    },
    {
      "t": "ਮੇਟ ਨ ਸਕਾ ਕੋਊ ਤਿਂਹ ਸਾਧਾ ॥",
      "s": 2
    },
    {
      "t": "ਬਿਚਰੇ ਬੀਰ ਬਨੈਤ ਅਖੰਡਲ ॥",
      "s": 2
    },
    {
      "t": "ਗਹਿ ਗਹਿ ਚਲੇ ਭਿਰਨ ਰਨ ਮੰਡਲ ॥੩੩॥",
      "s": 2
    },
    {
      "t": "ਧਨ ਅਰ ਭੂਮਿ ਪੁਰਾਤਨ ਬੈਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਨ ਕਾ ਮੂਆ ਕਰਤ ਜਗ ਘੇਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਮੋਹ ਬਾਦ ਅਹੰਕਾਰ ਪਸਾਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਕਾਮ ਕ੍ਰੋਧ ਜੀਤਾ ਜਗ ਸਾਰਾ ॥੩੪॥",
      "s": 2
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਧੰਨਿ ਧੰਨਿ ਧਨ ਕੋ ਭਾਖੀਐ ਜਾ ਕਾ ਜਗਤੁ ਗੁਲਾਮੁ ॥",
      "s": 2
    },
    {
      "t": "ਸਭ ਨਿਰਖਤ ਯਾ ਕੌ ਫਿਰੈ ਸਭ ਚਲ ਕਰਤ ਸਲਾਮ ॥੩੫॥",
      "s": 2
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 2
    },
    {
      "t": "ਕਾਲ ਨ ਕੋਊ ਕਰਨ ਸੁਮਾਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਬੈਰ ਬਾਦ ਅਹੰਕਾਰ ਪਸਾਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਲੋਭ ਮੂਲ ਇਹਿ ਜਗ ਕੋ ਹੂਆ ॥",
      "s": 2
    },
    {
      "t": "ਜਾ ਸੋ ਚਾਹਤ ਸਭੈ ਕੋ ਮੂਆ ॥੩੬॥",
      "s": 2
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਸੁਭ ਬੰਸ ਬਰਨਨੰ ਨਾਮ ਦੁਤੀਆ ਧਿਆਇ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨॥ ਅਫਜੂ ॥੧੩੭॥",
      "s": 2
    },
    {
      "t": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 2
    }
  ]
}
