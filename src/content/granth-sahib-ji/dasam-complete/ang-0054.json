{
  "page": 54,
  "lines": [
    {
      "t": "ਮਹਾਂ ਪਾਪ ਨਾਸੰ ॥",
      "s": 2
    },
    {
      "t": "ਰਿਖੰ ਭੇਸ ਕੀਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਸੈ ਰਾਜ ਦੀਯੰ ॥੫॥",
      "s": 2
    },
    {
      "t": "ਰਹੇ ਹੋਰ ਲੋਗੰ ॥",
      "s": 2
    },
    {
      "t": "ਤਜੇ ਸਰਬ ਸੋਗੰ ॥",
      "s": 2
    },
    {
      "t": "ਧਨੰ ਧਾਮ ਤਿਆਗੇ ॥",
      "s": 2
    },
    {
      "t": "ਪ੍ਰਭੰ ਪ੍ਰੇਮ ਪਾਗੇ ॥੬॥",
      "s": 2
    },
    {
      "t": "ਅੜਿਲ ॥",
      "s": 2
    },
    {
      "t": "ਬੇਦੀ ਭਏ ਪ੍ਰਸੰਨ ਰਾਜ ਕਹ ਪਾਇ ਕੈ ॥",
      "s": 2
    },
    {
      "t": "ਦੇਤ ਭਯੋ ਬਰਦਾਨ ਹੀਐ ਹੁਲਸਾਇ ਕੈ ॥",
      "s": 2
    },
    {
      "t": "ਜਬ ਨਾਨਕ ਕਲਿ ਮੈ ਹਮ ਆਨ ਕਹਾਇਹੈਂ ॥",
      "s": 2
    },
    {
      "t": "ਹੋ ਜਗਤ ਪੂਜ ਕਰਿ ਤੋਹਿ ਪਰਮ ਪਦ ਪਾਇਹੈਂ ॥੭॥",
      "s": 2
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਲਵੀ ਰਾਜ ਦੇ ਬਨ ਗਏ ਬੇਦੀਅਨ ਕੀਨੋ ਰਾਜ ॥",
      "s": 2
    },
    {
      "t": "ਭਾਂਤਿ ਭਾਂਤਿ ਤਿਨਿ ਭੋਗੀਯੰ ਭੂਅ ਕਾ ਸਕਲ ਸਮਾਜ ॥੮॥",
      "s": 2
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 2
    },
    {
      "t": "ਤ੍ਰਿਤੀਅ ਬੇਦ ਸੁਨਬੋ ਤੁਮ ਕੀਆ ॥",
      "s": 2
    },
    {
      "t": "ਚਤੁਰ ਬੇਦ ਸੁਨਿ ਭੂਅ ਕੋ ਦੀਆ ॥",
      "s": 2
    },
    {
      "t": "ਤੀਨ ਜਨਮ ਹਮਹੂੰ ਜਬ ਧਰਿਹੈਂ ॥",
      "s": 2
    },
    {
      "t": "ਚਉਥੇ ਜਨਮ ਗੁਰੂ ਤੁਹਿ ਕਰਿਹੈਂ ॥੯॥",
      "s": 2
    },
    {
      "t": "ਉਤ ਰਾਜਾ ਕਾਨਨਹਿ ਸਿਧਾਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਇਤ ਇਨ ਰਾਜ ਕਰਤ ਸੁਖ ਪਾਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਕਹਾ ਲਗੇ ਕਰਿ ਕਥਾ ਸੁਨਾਊਂ ॥",
      "s": 2
    },
    {
      "t": "ਗ੍ਰੰਥ ਬਢਨ ਤੇ ਅਧਿਕ ਡਰਾਊਂ ॥੧੦॥",
      "s": 2
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਬੇਦ ਪਾਠ ਭੇਟ ਰਾਜ ਚਤੁਰਥ ਧਿਆਇ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੪॥ ਅਫਜੂ ॥੧੯੯॥",
      "s": 2
    },
    {
      "t": "ਨਰਾਜ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਬਹੁਰ ਬਿਖਾਦ ਬਾਧਿਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਕਿਨੀ ਨ ਤਾਹਿ ਸਾਧਿਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਕਰੰਮ ਕਾਲ ਯੌਂ ਭਈ ॥",
      "s": 2
    },
    {
      "t": "ਸੁ ਭੂਮਿ ਬੰਸ ਤੇ ਗਈ ॥੧॥",
      "s": 2
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਬਿਪ੍ਰ ਕਰਤ ਭਏ ਸੂਦ੍ਰ ਬ੍ਰਿਤਿ ਛਤ੍ਰੀ ਬੈਸਨ ਕਰਮ ॥",
      "s": 2
    },
    {
      "t": "ਬੈਸ ਕਰਤ ਭਏ ਛਤ੍ਰਿ ਬ੍ਰਿਤਿ ਸੂਦ੍ਰ ਸੁ ਦਿਜ ਕੋ ਧਰਮ ॥੨॥",
      "s": 2
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 2
    },
    {
      "t": "ਬੀਸ ਗਾਵ ਤਿਨ ਕੇ ਰਹਿ ਗਏ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਨ ਮੋ ਕਰਤ ਕ੍ਰਿਸਾਨੀ ਭਏ ॥",
      "s": 2
    },
    {
      "t": "ਬਹੁਤ ਕਾਲ ਇਹ ਭਾਂਤਿ ਬਿਤਾਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਜਨਮ ਸਮੈ ਨਾਨਕ ਕੋ ਆਯੋ ॥੩॥",
      "s": 2
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਨ ਬੇਦੀਅਨ ਕੀ ਕੁਲ ਬਿਖੈ ਪ੍ਰਗਟੇ ਨਾਨਕ ਰਾਇ ॥",
      "s": 2
    },
    {
      "t": "ਸਭ ਸਿੱਖਨ ਕੋ ਸੁਖ ਦਏ ਜਹ ਤਹ ਭਏ ਸਹਾਇ ॥੪॥",
      "s": 2
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਨ ਇਹ ਕਲ ਮੋ ਧਰਮੁ ਚਲਾਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਸਭ ਸਾਧਨ ਕੋ ਰਾਹੁ ਬਤਾਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਜੋ ਤਾਂ ਕੇ ਮਾਰਗ ਮਹਿ ਆਏ ॥",
      "s": 2
    },
    {
      "t": "ਤੇ ਕਬਹੂੰ ਨਹੀ ਪਾਪ ਸੰਤਾਏ ॥੫॥",
      "s": 2
    },
    {
      "t": "ਜੇ ਜੇ ਪੰਥ ਤਵਨ ਕੇ ਪਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਪਾਪ ਤਾਪ ਤਿਨ ਕੇ ਪ੍ਰਭ ਹਰੇ ॥",
      "s": 2
    }
  ]
}
