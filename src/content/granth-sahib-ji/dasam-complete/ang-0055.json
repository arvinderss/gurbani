{
  "page": 55,
  "lines": [
    {
      "t": "ਦੂਖ ਭੂਖ ਕਬਹੂੰ ਨ ਸੰਤਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਜਾਲ ਕਾਲ ਕੇ ਬੀਚ ਨ ਆਏ ॥੬॥",
      "s": 2
    },
    {
      "t": "ਨਾਨਕ ਅੰਗਦ ਕੋ ਬਪੁ ਧਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਧਰਮ ਪ੍ਰਚੁਰ ਇਹ ਜਗ ਮੋ ਕਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਅਮਰਦਾਸ ਪੁਨਿ ਨਾਮੁ ਕਹਾਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਜਨ ਦੀਪਕ ਤੇ ਦੀਪ ਜਗਾਯੋ ॥੭॥",
      "s": 2
    },
    {
      "t": "ਜਬ ਬਰਦਾਨ ਸਮੈ ਵਹੁ ਆਵਾ ॥",
      "s": 2
    },
    {
      "t": "ਰਾਮਦਾਸ ਤਬ ਗੁਰੂ ਕਹਾਵਾ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਹ ਬਰਦਾਨ ਪੁਰਾਤਨ ਦੀਆ ॥",
      "s": 2
    },
    {
      "t": "ਅਮਰਦਾਸ ਸੁਰਪੁਰਿ ਮਗੁ ਲੀਆ ॥੮॥",
      "s": 2
    },
    {
      "t": "ਸ੍ਰੀ ਨਾਨਕ ਅੰਗਦਿ ਕਰਿ ਮਾਨਾ ॥",
      "s": 2
    },
    {
      "t": "ਅਮਰਦਾਸ ਅੰਗਦ ਪਹਿਚਾਨਾ ॥",
      "s": 2
    },
    {
      "t": "ਅਮਰਦਾਸ ਰਾਮਦਾਸ ਕਹਾਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਸਾਧਨਿ ਲਖਾ ਮੂੜ੍ਹ ਨਹਿ ਪਾਯੋ ॥੯॥",
      "s": 2
    },
    {
      "t": "ਭਿੰਨ ਭਿੰਨ ਸਭਹੂੰ ਕਰ ਜਾਨਾ ॥",
      "s": 2
    },
    {
      "t": "ਏਕ ਰੂਪ ਕਿਨਹੂੰ ਪਹਿਚਾਨਾ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਨ ਜਾਨਾ ਤਿਨ ਹੀ ਸਿਧ ਪਾਈ ॥",
      "s": 2
    },
    {
      "t": "ਬਿਨ ਸਮਝੇ ਸਿਧ ਹਾਥਿ ਨ ਆਈ ॥੧੦॥",
      "s": 2
    },
    {
      "t": "ਰਾਮਦਾਸ ਹਰਿ ਸੋ ਮਿਲ ਗਏ ॥",
      "s": 2
    },
    {
      "t": "ਗੁਰਤਾ ਦੇਤ ਅਰਜਨਹਿ ਭਏ ॥",
      "s": 2
    },
    {
      "t": "ਜਬ ਅਰਜਨ ਪ੍ਰਭੁ ਲੋਕ ਸਿਧਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਹਰਿਗੋਬਿੰਦ ਤਿਹ ਠਾਂ ਠਹਿਰਾਏ ॥੧੧॥",
      "s": 2
    },
    {
      "t": "ਹਰਿਗੋਬਿੰਦ ਪ੍ਰਭ ਲੋਕ ਸਿਧਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਹਰੀਰਾਇ ਤਿਹ ਠਾਂ ਬੈਠਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਹਰੀਕ੍ਰਿਸਨ ਤਿਨ ਕੇ ਸੁਤ ਵਏ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਨ ਤੇ ਤੇਗ ਬਹਾਦਰ ਭਏ ॥੧੨॥",
      "s": 2
    },
    {
      "t": "ਤਿਲਕ ਜੰਞੂ ਰਾਖਾ ਪ੍ਰਭ ਤਾ ਕਾ ॥",
      "s": 2
    },
    {
      "t": "ਕੀਨੋ ਬਡੋ ਕਲੂ ਮਹਿ ਸਾਕਾ ॥",
      "s": 2
    },
    {
      "t": "ਸਾਧਨ ਹੇਤਿ ਇਤੀ ਜਿਨਿ ਕਰੀ ॥",
      "s": 2
    },
    {
      "t": "ਸੀਸੁ ਦੀਆ ਪਰ ਸੀ ਨ ਉਚਰੀ ॥੧੩॥",
      "s": 2
    },
    {
      "t": "ਧਰਮ ਹੇਤ ਸਾਕਾ ਜਿਨਿ ਕੀਆ ॥",
      "s": 2
    },
    {
      "t": "ਸੀਸੁ ਦੀਆ ਪਰ ਸਿਰਰੁ ਨ ਦੀਆ ॥",
      "s": 2
    },
    {
      "t": "ਨਾਟਕ ਚੇਟਕ ਕੀਏ ਕੁਕਾਜਾ ॥",
      "s": 2
    },
    {
      "t": "ਪ੍ਰਭ ਲੋਗਨ ਕਹ ਆਵਤ ਲਾਜਾ ॥੧੪॥",
      "s": 2
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਠੀਕਰਿ ਫੋਰਿ ਦਿਲੀਸਿ ਸਿਰਿ ਪ੍ਰਭ ਪੁਰ ਕੀਯਾ ਪਯਾਨ ॥",
      "s": 2
    },
    {
      "t": "ਤੇਗ ਬਹਾਦਰ ਸੀ ਕ੍ਰਿਆ ਕਰੀ ਨ ਕਿਨਹੂੰ ਆਨ ॥੧੫॥",
      "s": 2
    },
    {
      "t": "ਤੇਗ ਬਹਾਦਰ ਕੇ ਚਲਤ ਭਯੋ ਜਗਤ ਕੋ ਸੋਕ ॥",
      "s": 2
    },
    {
      "t": "ਹੈ ਹੈ ਹੈ ਸਭ ਜਗ ਭਯੋ ਜੈ ਜੈ ਜੈ ਸੁਰ ਲੋਕ ॥੧੬॥",
      "s": 2
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਪਾਤਸ਼ਾਹੀ ਬਰਨਨੰ ਨਾਮ ਪੰਚਮੋ ਧਿਆਇ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੫॥ ਅਫਜੂ ॥੨੧੫॥",
      "s": 2
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 2
    },
    {
      "t": "ਅਬ ਮੈ ਅਪਨੀ ਕਥਾ ਬਖਾਨੋ ॥",
      "s": 2
    },
    {
      "t": "ਤਪ ਸਾਧਤ ਜਿਹ ਬਿਧਿ ਮੁਹਿ ਆਨੋ ॥",
      "s": 2
    },
    {
      "t": "ਹੇਮ ਕੁੰਟ ਪਰਬਤ ਹੈ ਜਹਾਂ ॥",
      "s": 2
    },
    {
      "t": "ਸਪਤ ਸ੍ਰਿੰਗ ਸੋਭਿਤ ਹੈ ਤਹਾਂ ॥੧॥",
      "s": 2
    },
    {
      "t": "ਸਪਤ ਸ੍ਰਿੰਗ ਤਿਹ ਨਾਮੁ ਕਹਾਵਾ ॥",
      "s": 2
    },
    {
      "t": "ਪੰਡੁ ਰਾਜ ਜਹ ਜੋਗੁ ਕਮਾਵਾ ॥",
      "s": 2
    },
    {
      "t": "ਤਹ ਹਮ ਅਧਿਕ ਤਪੱਸਿਆ ਸਾਧੀ ॥",
      "s": 2
    },
    {
      "t": "ਮਹਾਕਾਲ ਕਾਲਿਕਾ ਅਰਾਧੀ ॥੨॥",
      "s": 2
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਕਰਤ ਤਪਸਿਆ ਭਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਦ੍ਵੈ ਤੇ ਏਕ ਰੂਪ ਹ੍ਵੈ ਗਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਤਾਤ ਮਾਤ ਮੁਰ ਅਲਖ ਅਰਾਧਾ ॥",
      "s": 2
    },
    {
      "t": "ਬਹੁ ਬਿਧਿ ਜੋਗ ਸਾਧਨਾ ਸਾਧਾ ॥੩॥",
      "s": 2
    },
    {
      "t": "ਤਿਨ ਜੋ ਕਰੀ ਅਲਖ ਕੀ ਸੇਵਾ ॥",
      "s": 2
    },
    {
      "t": "ਤਾ ਤੇ ਭਏ ਪ੍ਰਸੰਨ ਗੁਰਦੇਵਾ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਨ ਪ੍ਰਭ ਜਬ ਆਇਸ ਮੁਹਿ ਦੀਆ ॥",
      "s": 2
    },
    {
      "t": "ਤਬ ਹਮ ਜਨਮ ਕਲੂ ਮਹਿ ਲੀਆ ॥੪॥",
      "s": 2
    },
    {
      "t": "ਚਿਤ ਨ ਭਯੋ ਹਮਰੋ ਆਵਨ ਕਹ ॥",
      "s": 2
    },
    {
      "t": "ਚੁਭੀ ਰਹੀ ਸ੍ਰੁਤਿ ਪ੍ਰਭੁ ਚਰਨਨ ਮਹ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਉ ਤਿਉ ਪ੍ਰਭ ਹਮ ਕੋ ਸਮਝਾਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਇਮ ਕਹਿ ਕੈ ਇਹ ਲੋਕ ਪਠਾਯੋ ॥੫॥",
      "s": 2
    },
    {
      "t": "ਅਕਾਲ ਪੁਰਖ ਬਾਚ ਇਸ ਕੀਟ ਪ੍ਰਤਿ ॥",
      "s": 2
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 2
    },
    {
      "t": "ਜਬ ਪਹਿਲੇ ਹਮ ਸ੍ਰਿਸਟਿ ਬਨਾਈ ॥",
      "s": 2
    },
    {
      "t": "ਦਈਤ ਰਚੇ ਦੁਸਟ ਦੁਖਦਾਈ ॥",
      "s": 2
    },
    {
      "t": "ਤੇ ਭੁਜ ਬਲ ਬਵਰੇ ਹ੍ਵੈ ਗਏ ॥",
      "s": 2
    },
    {
      "t": "ਪੂਜਤ ਪਰਮ ਪੁਰਖ ਰਹਿ ਗਏ ॥੬॥",
      "s": 2
    },
    {
      "t": "ਤੇ ਹਮ ਤਮਕਿ ਤਨਕ ਮੋ ਖਾਪੇ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਨ ਕੀ ਠਉਰ ਦੇਵਤਾ ਥਾਪੇ ॥",
      "s": 2
    },
    {
      "t": "ਤੇ ਭੀ ਬਲਿ ਪੂਜਾ ਉਰਝਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਆਪਨ ਹੀ ਪਰਮੇਸਰ ਕਹਾਏ ॥੭॥",
      "s": 2
    },
    {
      "t": "ਮਹਾਦੇਵ ਅਚੁੱਤ ਕਹਾਯੋ ॥",
      "s": 2
    }
  ]
}
