{
  "page": 56,
  "lines": [
    {
      "t": "ਬਿਸਨ ਆਪ ਹੀ ਕੋ ਠਹਿਰਾਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਬ੍ਰਹਮਾ ਆਪ ਪਾਰਬ੍ਰਹਮ ਬਖਾਨਾ ॥",
      "s": 2
    },
    {
      "t": "ਪ੍ਰਭ ਕੋ ਪ੍ਰਭੂ ਨ ਕਿਨਹੂੰ ਜਾਨਾ ॥੮॥",
      "s": 2
    },
    {
      "t": "ਤਬ ਸਾਖੀ ਪ੍ਰਭ ਅਸਟ ਬਨਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਸਾਖ ਨਮਿਤ ਦੇਬੇ ਠਹਿਰਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਤੇ ਕਹੈ ਕਰੋ ਹਮਾਰੀ ਪੂਜਾ ॥",
      "s": 2
    },
    {
      "t": "ਹਮ ਬਿਨ ਅਵਰੁ ਨ ਠਾਕੁਰੁ ਦੂਜਾ ॥੯॥",
      "s": 2
    },
    {
      "t": "ਪਰਮ ਤੱਤ ਕੋ ਜਿਨ ਨ ਪਛਾਨਾ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਨ ਕਰਿ ਈਸਰ ਤਿਨ ਕਹੁ ਮਾਨਾ ॥",
      "s": 2
    },
    {
      "t": "ਕੇਤੇ ਸੂਰ ਚੰਦ ਕਹੁ ਮਾਨੈ ॥",
      "s": 2
    },
    {
      "t": "ਅਗਨਿ ਹੋਤ੍ਰ ਕਈ ਪਵਨ ਪ੍ਰਮਾਨੈ ॥੧੦॥",
      "s": 2
    },
    {
      "t": "ਕਿਨਹੂੰ ਪ੍ਰਭੁ ਪਾਹਨ ਪਹਿਚਾਨਾ ॥",
      "s": 2
    },
    {
      "t": "ਨ੍ਹਾਤ ਕਿਤੇ ਜਲ ਕਰਤ ਬਿਧਾਨਾ ॥",
      "s": 2
    },
    {
      "t": "ਕੇਤਕ ਕਰਮ ਕਰਤ ਡਰਪਾਨਾ ॥",
      "s": 2
    },
    {
      "t": "ਧਰਮ ਰਾਜ ਕੋ ਧਰਮ ਪਛਾਨਾ ॥੧੧॥",
      "s": 2
    },
    {
      "t": "ਜੋ ਪ੍ਰਭ ਸਾਖ ਨਮਿਤ ਠਹਿਰਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਤੇ ਹਿਆਂ ਆਇ ਪ੍ਰਭੂ ਕਹਵਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਤਾ ਕੀ ਬਾਤ ਬਿਸਰ ਜਾਤੀ ਭੀ ॥",
      "s": 2
    },
    {
      "t": "ਅਪਨੀ ਅਪਨੀ ਪਰਤ ਸੋਭ ਭੀ ॥੧੨॥",
      "s": 2
    },
    {
      "t": "ਜਬ ਪ੍ਰਭ ਕੋ ਨ ਤਿਨੈ ਪਹਿਚਾਨਾ ॥",
      "s": 2
    },
    {
      "t": "ਤਬ ਹਰਿ ਇਨ ਮਨੁਛਨ ਠਹਿਰਾਨਾ ॥",
      "s": 2
    },
    {
      "t": "ਤੇ ਭੀ ਬਸਿ ਮਮਤਾ ਹੁਇ ਗਏ ॥",
      "s": 2
    },
    {
      "t": "ਪਰਮੇਸਰ ਪਾਹਨ ਠਹਿਰਏ ॥੧੩॥",
      "s": 2
    },
    {
      "t": "ਤਬ ਹਰਿ ਸਿੱਧ ਸਾਧ ਠਹਿਰਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਨ ਭੀ ਪਰਮ ਪੁਰਖ ਨਹੀ ਪਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਜੇ ਕੋਈ ਹੋਤ ਭਯੋ ਜਗਿ ਸਿਆਨਾ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਨ ਤਿਨ ਅਪਨੋ ਪੰਥੁ ਚਲਾਨਾ ॥੧੪॥",
      "s": 2
    },
    {
      "t": "ਪਰਮ ਪੁਰਖ ਕਿਨਹੂੰ ਨਹ ਪਾਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਬੈਰ ਬਾਦ ਅਹੰਕਾਰ ਬਢਾਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਪੇਡ ਪਾਤ ਆਪਨ ਤੇ ਜਲੈ ॥",
      "s": 2
    },
    {
      "t": "ਪ੍ਰਭ ਕੈ ਪੰਥ ਨ ਕੋਊ ਚਲੈ ॥੧੫॥",
      "s": 2
    },
    {
      "t": "ਜਿਨਿ ਜਿਨਿ ਤਨਿਕ ਸਿੱਧ ਕੋ ਪਾਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਨ ਤਿਨ ਅਪਨਾ ਰਾਹੁ ਚਲਾਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਪਰਮੇਸਰ ਨ ਕਿਨਹੂੰ ਪਹਿਚਾਨਾ ॥",
      "s": 2
    },
    {
      "t": "ਮਮ ਉਚਾਰਤੇ ਭਯੋ ਦਿਵਾਨਾ ॥੧੬॥",
      "s": 2
    },
    {
      "t": "ਪਰਮ ਤੱਤ ਕਿਨਹੂੰ ਨ ਪਛਾਨਾ ॥",
      "s": 2
    },
    {
      "t": "ਆਪ ਆਪ ਭੀਤਰਿ ਉਰਝਾਨਾ ॥",
      "s": 2
    },
    {
      "t": "ਤਬ ਜੇ ਜੇ ਰਿਖਰਾਜ ਬਨਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਨ ਆਪਨ ਪੁਨ ਸਿੰਮ੍ਰਿਤ ਚਲਾਏ ॥੧੭॥",
      "s": 2
    },
    {
      "t": "ਜੇ ਸਿੰਮ੍ਰਿਤਨ ਕੇ ਭਏ ਅਨੁਰਾਗੀ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਨਿ ਤਿਨਿ ਕ੍ਰਿਆ ਬ੍ਰਹਮ ਕੀ ਤਿਆਗੀ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਨ ਮਨ ਹਰਿ ਚਰਨਨ ਠਹਿਰਾਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਸੋ ਸਿੰਮ੍ਰਿਤਨ ਕੇ ਰਾਹ ਨ ਆਯੋ ॥੧੮॥",
      "s": 2
    },
    {
      "t": "ਬ੍ਰਹਮਾ ਚਾਰ ਹੀ ਬੇਦ ਬਨਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਸਰਬ ਲੋਕ ਤਿਹ ਕਰਮ ਚਲਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਨ ਕੀ ਲਿਵ ਹਰਿ ਚਰਨਨ ਲਾਗੀ ॥",
      "s": 2
    },
    {
      "t": "ਤੇ ਬੇਦਨ ਤੇ ਭਏ ਤਿਆਗੀ ॥੧੯॥",
      "s": 2
    },
    {
      "t": "ਜਿਨ ਮਤ ਬੇਦ ਕਤੇਬਨ ਤਿਆਗੀ ॥",
      "s": 2
    }
  ]
}
