{
  "page": 59,
  "lines": [
    {
      "t": "ਅੰਤ ਕਾਲ ਜੋ ਹੋਇ ਸਹਾਈ ॥",
      "s": 2
    },
    {
      "t": "ਫੋਕਟ ਧਰਮ ਲਖੋ ਕਰ ਭਰਮਾ ॥",
      "s": 2
    },
    {
      "t": "ਇਨ ਤੇ ਸਰਤ ਨ ਕੋਈ ਕਰਮਾ ॥੪੯॥",
      "s": 2
    },
    {
      "t": "ਇਹ ਕਾਰਨ ਪ੍ਰਭੁ ਹਮੈ ਬਨਾਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਭੇਦੁ ਭਾਖਿ ਇਹੁ ਲੋਕ ਪਠਾਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਜੋ ਤਿਨ ਕਹਾ ਸੁ ਸਭਨ ਉਚਰੋਂ ॥",
      "s": 2
    },
    {
      "t": "ਡਿੰਭ ਵਿੰਭ ਕਛੁ ਨੈਕ ਨ ਕਰੋਂ ॥੫੦॥",
      "s": 2
    },
    {
      "t": "ਰਸਾਵਲ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਨ ਜਟਾ ਮੂੰਡ ਧਾਰੋਂ ॥",
      "s": 2
    },
    {
      "t": "ਨ ਮੁੰਦ੍ਰਕਾ ਸਵਾਰੋਂ ॥",
      "s": 2
    },
    {
      "t": "ਜਪੋ ਤਾਸ ਨਾਮੰ ॥",
      "s": 2
    },
    {
      "t": "ਸਰੈ ਸਰਬ ਕਾਮੰ ॥੫੧॥",
      "s": 2
    },
    {
      "t": "ਨ ਨੈਨੰ ਮਿਚਾਊਂ ॥",
      "s": 2
    },
    {
      "t": "ਨ ਡਿੰਭੰ ਦਿਖਾਊਂ ॥",
      "s": 2
    },
    {
      "t": "ਨ ਕੁਕਰਮੰ ਕਮਾਊਂ ॥",
      "s": 2
    },
    {
      "t": "ਨ ਭੇਖੀ ਕਹਾਊਂ ॥੫੨॥",
      "s": 2
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 2
    },
    {
      "t": "ਜੇ ਜੇ ਭੇਖ ਸੁ ਤਨ ਮੈਂ ਧਾਰੈ ॥",
      "s": 2
    },
    {
      "t": "ਤੇ ਪ੍ਰਭੁ ਜਨ ਕਛੁ ਕੈ ਨ ਬਿਚਾਰੈ ॥",
      "s": 2
    },
    {
      "t": "ਸਮਝ ਲੇਹੁ ਸਭ ਜਨ ਮਨ ਮਾਹੀ ॥",
      "s": 2
    },
    {
      "t": "ਡਿੰਭਨ ਮੈ ਪਰਮੇਸੁਰ ਨਾਹੀ ॥੫੩॥",
      "s": 2
    },
    {
      "t": "ਜੇ ਜੇ ਕਰਮ ਕਰਿ ਡਿੰਭ ਦਿਖਾਹੀਂ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਨ ਪਰ ਲੋਗਨ ਮੋ ਗਤਿ ਨਾਹੀਂ ॥",
      "s": 2
    },
    {
      "t": "ਜੀਵਤ ਚਲਤ ਜਗਤ ਕੇ ਕਾਜਾ ॥",
      "s": 2
    },
    {
      "t": "ਸ੍ਵਾਂਗ ਦੇਖਿ ਕਰਿ ਪੂਜਤ ਰਾਜਾ ॥੫੪॥",
      "s": 2
    },
    {
      "t": "ਸੁਆਂਗਨ ਮੈ ਪਰਮੇਸੁਰ ਨਾਹੀ ॥",
      "s": 2
    },
    {
      "t": "ਖੋਜ ਫਿਰੈ ਸਭ ਹੀ ਕੋ ਕਾਹੀ ॥",
      "s": 2
    },
    {
      "t": "ਅਪਨੋ ਮਨੁ ਕਰ ਮੋ ਜਿਹ ਆਨਾ ॥",
      "s": 2
    },
    {
      "t": "ਪਾਰਬ੍ਰਹਮ ਕੋ ਤਿਨੀ ਪਛਾਨਾ ॥੫੫॥",
      "s": 2
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਭੇਖ ਦਿਖਾਇ ਜਗਤ ਕੋ ਲੋਗਨ ਕੋ ਬਸਿ ਕੀਨ ॥",
      "s": 2
    },
    {
      "t": "ਅੰਤ ਕਾਲ ਕਾਤੀ ਕਟਿਓ ਬਾਸੁ ਨਰਕ ਮੋ ਲੀਨ ॥੫੬॥",
      "s": 2
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 2
    },
    {
      "t": "ਜੇ ਜੇ ਜਗ ਕੋ ਡਿੰਭ ਦਿਖਾਵੈ ॥",
      "s": 2
    },
    {
      "t": "ਲੋਗਨ ਮੂੰਡ ਅਧਿਕ ਸੁਖੁ ਪਾਵੈ ॥",
      "s": 2
    },
    {
      "t": "ਨਾਸਾਂ ਮੂੰਦ ਕਰੇ ਪ੍ਰਣਾਮੰ ॥",
      "s": 2
    },
    {
      "t": "ਫੋਕਟ ਧਰਮ ਨ ਕਉਡੀ ਕਾਮੰ ॥੫੭॥",
      "s": 2
    },
    {
      "t": "ਫੋਕਟ ਧਰਮ ਜਿਤੇ ਜਗ ਕਰਹੀਂ ॥",
      "s": 2
    },
    {
      "t": "ਨਰਕ ਕੁੰਡ ਭੀਤਰ ਤੇ ਪਰਹੀਂ ॥",
      "s": 2
    },
    {
      "t": "ਹਾਥ ਹਲਾਏ ਸੁਰਗ ਨ ਜਾਹੂ ॥",
      "s": 2
    },
    {
      "t": "ਜੋ ਮਨੁ ਜੀਤ ਸਕਾ ਨਹੀਂ ਕਾਹੂ ॥੫੮॥",
      "s": 2
    },
    {
      "t": "ਕਬਿਬਾਚ ॥ ਦੋਹਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਜੋ ਨਿਜ ਪ੍ਰਭ ਮੋ ਸੋ ਕਹਾ ਸੋ ਕਹਿਹੋਂ ਜਗ ਮਾਹਿ ॥",
      "s": 2
    },
    {
      "t": "ਜੋ ਤਿਹ ਪ੍ਰਭ ਕੋ ਧਿਆਇ ਹੈ ਅੰਤ ਸੁਰਗ ਕੋ ਜਾਹਿ ॥੫੯॥",
      "s": 2
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਹਰਿ ਹਰਿ ਜਨ ਦੁਇ ਏਕ ਹੈ ਬਿਬ ਬਿਚਾਰ ਕਛੁ ਨਾਹਿ ॥",
      "s": 2
    },
    {
      "t": "ਜਲ ਤੇ ਉਪਜ ਤਰੰਗ ਜਿਉ ਜਲ ਹੀ ਬਿਖੈ ਸਮਾਹਿ ॥੬੦॥",
      "s": 2
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 2
    }
  ]
}
