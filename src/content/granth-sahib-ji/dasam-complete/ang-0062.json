{
  "page": 62,
  "lines": [
    {
      "t": "ਤਹਾ ਖਾਨ ਨੈਜਾਬਤੋ ਆਨ ਕੈ ਕੈ ॥",
      "s": 2
    },
    {
      "t": "ਹਨਿਓ ਸਾਹ ਸੰਗ੍ਰਾਮ ਕੌ ਸਸਤ੍ਰ ਲੈ ਕੈ ॥",
      "s": 2
    },
    {
      "t": "ਕਿਤੈ ਖਾਨ ਬਾਨੀਨ ਹੂੰ ਅਸਤ੍ਰ ਝਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਸਹੀ ਸਾਹ ਸੰਗ੍ਰਾਮ ਸੁਰਗੰ ਸਿਧਾਰੇ ॥੨੨॥",
      "s": 2
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਮਾਰਿ ਨਜਾਬਤ ਖਾਨ ਕੋ ਸੰਗੋ ਜੁਝੈ ਜੁਝਾਰ ॥",
      "s": 2
    },
    {
      "t": "ਹਾ ਹਾ ਇਹ ਲੋਕੈ ਭਇਓ ਸੁਰਗ ਲੋਕ ਜੈਕਾਰ ॥੨੩॥",
      "s": 2
    },
    {
      "t": "ਭੁਜੰਗ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਲਖੇ ਸਾਹ ਸੰਗ੍ਰਾਮ ਜੁੱਝੇ ਜੁਝਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਤਵੰ ਕੀਟ ਬਾਣੰ ਕਮਾਣੰ ਸੰਭਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਹਨਿਯੋ ਏਕ ਖਾਨੰ ਖਿਆਲੰ ਖਤੰਗੰ ॥",
      "s": 2
    },
    {
      "t": "ਡਸਿਯੋ ਸਤ੍ਰੁ ਕੋ ਜਾਨੁ ਸ੍ਯਾਮੰ ਭੁਜੰਗੰ ॥੨੪॥",
      "s": 2
    },
    {
      "t": "ਗਿਰਿਯੋ ਭੂਮ ਸੋ ਬਾਣ ਦੂਜੋ ਸੰਭਾਰਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਮੁਖੰ ਭੀਖਨੰ ਖਾਨ ਕੇ ਤਾਨ ਮਾਰਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਭਜਿਯੋ ਖਾਨ ਖੂਨੀ ਰਹਿਯੋ ਖੇਤ ਤਾਜੀ ॥",
      "s": 2
    },
    {
      "t": "ਤਜੇ ਪ੍ਰਾਣ ਤੀਜੇ ਲਗੇ ਬਾਣ ਬਾਜੀ ॥੨੫॥",
      "s": 2
    },
    {
      "t": "ਛੁਟੀ ਮੂਰਛਨਾ ਹਰੀਚੰਦੰ ਸੰਭਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਗਹੇ ਬਾਣ ਕਾਮਾਨ ਭੇ ਐਂਚ ਮਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਲਗੇ ਅੰਗ ਜਾ ਕੇ ਰਹੇ ਨਾ ਸੰਭਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਤਨੰ ਤਿਆਗ ਤੇ ਦੇਵਲੋਕੰ ਪਧਾਰੰ ॥੨੬॥",
      "s": 2
    },
    {
      "t": "ਦੁਯੰ ਬਾਨ ਖੈਂਚੇ ਇਕੰ ਬਾਰ ਮਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਬਲੀ ਬੀਰ ਬਾਜੀਨ ਤਾਜੀ ਬਿਦਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਸੈ ਬਾਨ ਲਾਗੈ ਰਹੈ ਨ ਸੰਭਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਤਨੰ ਬੇਧਿ ਕੈ ਤਾਹਿ ਪਾਰੰ ਸਿਧਾਰੰ ॥੨੭॥",
      "s": 2
    },
    {
      "t": "ਸਭੈ ਸ੍ਵਾਮਿ ਧਰਮੰ ਸੁ ਬੀਰੰ ਸੰਭਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਡਕੀ ਡਾਕਣੀ ਭੂਤ ਪ੍ਰੇਤੰ ਬਕਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਹਸੇ ਬੀਰ ਬੈਤਾਲ ਔ ਸੁੱਧ ਸਿੱਧੰ ॥",
      "s": 2
    },
    {
      "t": "ਚਵੀ ਚਾਵਡੀਯੰ ਉਡੀ ਗ੍ਰਿੱਧ ਬ੍ਰਿੱਧੰ ॥੨੮॥",
      "s": 2
    },
    {
      "t": "ਹਰੀਚੰਦ ਕੋਪੇ ਕਮਾਣੰ ਸੰਭਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਪ੍ਰਥਮ ਬਾਜੀਯੰ ਤਾਣ ਬਾਣੰ ਪ੍ਰਹਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਦੁਤੀਯ ਤਾਕ ਕੈ ਤੀਰ ਮੋ ਕੌ ਚਲਾਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਰਖਿਓ ਦਈਵ ਮੈ ਕਾਨ ਛ੍ਵੈ ਕੈ ਸਿਧਾਯੰ ॥੨੯॥",
      "s": 2
    },
    {
      "t": "ਤ੍ਰਿਤੀਯ ਬਾਣ ਮਾਰਿਯੋ ਸੁ ਪੇਟੀ ਮਝਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਬਿਧਿਅੰ ਚਿਲਕਤੰ ਦੁਆਲ ਪਾਰੰ ਪਧਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਚੁਭੀ ਚਿੰਚ ਚਰਮੰ ਕਛੂ ਘਾਇ ਨ ਆਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਕਲੰ ਕੇਵਲੰ ਜਾਨ ਦਾਸੰ ਬਚਾਯੰ ॥੩੦॥",
      "s": 2
    },
    {
      "t": "ਰਸਾਵਲ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਜਬੈ ਬਾਣ ਲਾਗ੍ਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਤਬੈ ਰੋਸ ਜਾਗ੍ਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਕਰੰ ਲੈ ਕਮਾਣੰ ॥",
      "s": 2
    },
    {
      "t": "ਹਨੰ ਬਾਣ ਤਾਣੰ ॥੩੧॥",
      "s": 2
    },
    {
      "t": "ਸਬੈ ਬੀਰ ਧਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਸਰੋਘੰ ਚਲਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਤਬੈ ਤਾਕਿ ਬਾਣੰ ॥",
      "s": 2
    },
    {
      "t": "ਹਨ੍ਯੋ ਏਕ ਜੁਆਣੰ ॥੩੨॥",
      "s": 2
    },
    {
      "t": "ਹਰੀਚੰਦ ਮਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਸੁ ਜੋਧਾ ਲਤਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਸੁ ਕਾਰੋੜਰਾਯੰ ॥",
      "s": 2
    }
  ]
}
