{
  "page": 63,
  "lines": [
    {
      "t": "ਵਹੈ ਕਾਲ ਘਾਯੰ ॥੩੩॥",
      "s": 2
    },
    {
      "t": "ਰਣੰ ਤਿਆਗਿ ਭਾਗੇ ॥",
      "s": 2
    },
    {
      "t": "ਸਬੈ ਤ੍ਰਾਸ ਪਾਗੇ ॥",
      "s": 2
    },
    {
      "t": "ਭਈ ਜੀਤ ਮੇਰੀ ॥",
      "s": 2
    },
    {
      "t": "ਕ੍ਰਿਪਾ ਕਾਲ ਕੇਰੀ ॥੩੪॥",
      "s": 2
    },
    {
      "t": "ਰਣੰ ਜੀਤਿ ਆਏ ॥",
      "s": 2
    },
    {
      "t": "ਜਯੰ ਗੀਤ ਗਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਧਨੰ ਧਾਰ ਬਰਖੇ ॥",
      "s": 2
    },
    {
      "t": "ਸਬੈ ਸੂਰ ਹਰਖੇ ॥੩੫॥",
      "s": 2
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਜੁਧ ਜੀਤ ਆਏ ਜਬੈ ਟਿਕੈ ਨ ਤਿਨ ਪੁਰ ਪਾਂਵ ॥",
      "s": 2
    },
    {
      "t": "ਕਾਹਲੂਰ ਮੈਂ ਬਾਂਧਿਯੋ ਆਨ ਆਨੰਦਪੁਰ ਗਾਂਵ ॥੩੬॥",
      "s": 2
    },
    {
      "t": "ਜੇ ਜੇ ਨਰ ਤਹ ਨ ਭਿਰੇ ਦੀਨੇ ਨਗਰ ਨਿਕਾਰ ॥",
      "s": 2
    },
    {
      "t": "ਜੇ ਤਿਹ ਠਉਰ ਭਲੇ ਭਿਰੇ ਤਿਨੈ ਕਰੀ ਪ੍ਰਤਿਪਾਰ ॥੩੭॥",
      "s": 2
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 2
    },
    {
      "t": "ਬਹੁਤ ਦਿਵਸ ਇਹ ਭਾਂਤਿ ਬਿਤਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਸੰਤ ਉਬਾਰ ਦੁਸਟ ਸਭ ਘਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਟਾਂਗ ਟਾਂਗ ਕਰਿ ਹਨੇ ਨਿਦਾਨਾ ॥",
      "s": 2
    },
    {
      "t": "ਕੂਕਰ ਜਿਮਿ ਤਿਨ ਤਜੇ ਪਰਾਨਾ ॥੩੮॥",
      "s": 2
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਭੰਗਾਣੀ ਜੁੱਧ ਬਰਨਨੰ ਨਾਮ ਅਸਟਮੋ ਧਿਆਇ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੮॥ ਅਫਜੂ ॥੩੨੦॥",
      "s": 2
    },
    {
      "t": "ਅਥ ਨਦਉਣ ਕਾ ਜੁੱਧ ਬਰਨਨੰ ॥",
      "s": 2
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 2
    },
    {
      "t": "ਬਹੁਤ ਕਾਲ ਇਹ ਭਾਂਤਿ ਬਿਤਾਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਮੀਆਂ ਖਾਨ ਜੰਮੂ ਕਹ ਆਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਅਲਫ ਖਾਨ ਨਾਦੌਣ ਪਠਾਵਾ ॥",
      "s": 2
    },
    {
      "t": "ਭੀਮਚੰਦ ਤਨ ਬੈਰ ਬਢਾਵਾ ॥੧॥",
      "s": 2
    },
    {
      "t": "ਜੁੱਧ ਕਾਜ ਨ੍ਰਿਪ ਹਮੈ ਬੁਲਾਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਆਪਿ ਤਵਨ ਕੀ ਓਰ ਸਿਧਾਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਨ ਕਠ ਗੜ ਨਵਰਸ ਪਰ ਬਾਂਧਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਤੀਰ ਤੁਫੰਗ ਨਰੇਸਨ ਸਾਧਯੋ ॥੨॥",
      "s": 2
    },
    {
      "t": "ਭੁਜੰਗ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਤਹਾ ਰਾਜ ਸਿੰਘੰ ਬਲੀ ਭੀਮਚੰਦੰ ॥",
      "s": 2
    },
    {
      "t": "ਚੜਿਓ ਰਾਮ ਸਿੰਘੰ ਮਹਾ ਤੇਜ ਵੰਦੰ ॥",
      "s": 2
    },
    {
      "t": "ਸੁਖੰ ਦੇਵ ਗਾਜੀ ਜਸਾਰੋਟ ਰਾਜੰ ॥",
      "s": 2
    },
    {
      "t": "ਚੜੇ ਕ੍ਰੁੱਧ ਕੀਨੇ ਕਰੇ ਸਰਬ ਕਾਜੰ ॥੩॥",
      "s": 2
    },
    {
      "t": "ਪ੍ਰਿਥੀਚੰਦ ਚਢਿਓ ਡਢੇ ਡਢਵਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਚਲੇ ਸਿੱਧ ਹੁਐ ਕਾਜ ਰਾਜੰ ਸੁਧਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਕਰੀ ਢੂਕ ਢੋਅੰ ਕਿਰਪਾਲਚੰਦੰ ॥",
      "s": 2
    },
    {
      "t": "ਹਟਾਏ ਸਬੈ ਮਾਰਿ ਕੈ ਬੀਰ ਬ੍ਰਿੰਦੰ ॥੪॥",
      "s": 2
    },
    {
      "t": "ਦੁਤੀਯ ਢੋਅ ਢੂਕੈ ਵਹੈ ਮਾਰਿ ਉਤਾਰੀ ॥",
      "s": 2
    },
    {
      "t": "ਖਰੇ ਦਾਂਤ ਪੀਸੈ ਛੁਭੈ ਛੱਤ੍ਰਧਾਰੀ ॥",
      "s": 2
    },
    {
      "t": "ਉਤੈ ਵੈ ਖਰੇ ਬੀਰ ਬੰਬੈ ਬਜਾਵੈਂ ॥",
      "s": 2
    },
    {
      "t": "ਤਰੇ ਭੂਪ ਠਾਂਢੇ ਬਡੋ ਸੋਕੁ ਪਾਵੈਂ ॥੫॥",
      "s": 2
    },
    {
      "t": "ਤਬੈ ਭੀਮਚੰਦੰ ਕੀਯੋ ਕੋਪ ਆਪੰ ॥",
      "s": 2
    },
    {
      "t": "ਹਨੂਮਾਨ ਕੇ ਮੰਤ੍ਰ ਕੋ ਮੁਖ ਜਾਪੰ ॥",
      "s": 2
    },
    {
      "t": "ਸਬੈ ਬੀਰ ਬੋਲੇ ਹਮੈ ਭੀ ਬੁਲਾਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਤਬੈ ਢੋਅ ਕੈ ਕੈ ਸੁ ਨੀਕੇ ਸਿਧਾਯੰ ॥੬॥",
      "s": 2
    },
    {
      "t": "ਸਬੈ ਕੋਪ ਕੈ ਕੈ ਮਹਾ ਬੀਰ ਢੂਕੇ ॥",
      "s": 2
    },
    {
      "t": "ਚਲੇ ਬਾਰਿਬੇ ਬਾਰ ਕੋ ਜਿਉ ਭਭੂਕੇ ॥",
      "s": 2
    },
    {
      "t": "ਤਹਾ ਬਿਝੁੜਿਆਲੰ ਹਠਿਓ ਬੀਰ ਦਿਆਲੰ ॥",
      "s": 2
    },
    {
      "t": "ਉਠਿਓ ਸੈਨ ਲੈ ਸੰਗਿ ਸਾਰੀ ਕ੍ਰਿਪਾਲੰ ॥੭॥",
      "s": 2
    },
    {
      "t": "ਮਧੁਭਾਰ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਕੁੱਪਿਓ ਕ੍ਰਿਪਾਲ ॥",
      "s": 2
    },
    {
      "t": "ਨੱਚੇ ਮਰਾਲ ॥",
      "s": 2
    },
    {
      "t": "ਬੱਜੇ ਬਜੰਤ ॥",
      "s": 2
    },
    {
      "t": "ਕ੍ਰੂਰੰ ਅਨੰਤ ॥੮॥",
      "s": 2
    },
    {
      "t": "ਜੁੱਝੰਤ ਜੁਆਣ ॥",
      "s": 2
    },
    {
      "t": "ਬਾਹੈ ਕ੍ਰਿਪਾਣ ॥",
      "s": 2
    },
    {
      "t": "ਜੀਅ ਧਾਰ ਕ੍ਰੋਧ ॥",
      "s": 2
    },
    {
      "t": "ਛੱਡੇ ਸਰੋਘ ॥੯॥",
      "s": 2
    },
    {
      "t": "ਲੁੱਝੈ ਨਿਦਾਨ ॥",
      "s": 2
    },
    {
      "t": "ਤੱਜੰਤ ਪ੍ਰਾਣ ॥",
      "s": 2
    },
    {
      "t": "ਗਿਰ ਪਰਤ ਭੂਮਿ ॥",
      "s": 2
    },
    {
      "t": "ਜਣੁ ਮੇਘ ਝੂਮ ॥੧੦॥",
      "s": 2
    },
    {
      "t": "ਰਸਾਵਲ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਕਿਰਪਾਲ ਕੋਪਿਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਹਠੀ ਪਾਵ ਰੋਪਿਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਸਰੋਘੰ ਚਲਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਬਡੇ ਬੀਰ ਘਾਏ ॥੧੧॥",
      "s": 2
    },
    {
      "t": "ਹਣੇ ਛੱਤ੍ਰਧਾਰੀ ॥",
      "s": 2
    },
    {
      "t": "ਲਿਟੇ ਭੂਪ ਭਾਰੀ ॥",
      "s": 2
    },
    {
      "t": "ਮਹਾਂ ਨਾਦ ਬਾਜੇ ॥",
      "s": 2
    }
  ]
}
