{
  "page": 66,
  "lines": [
    {
      "t": "ਸਬੈ ਸੂਰ ਲੈ ਕੇ ਸਿਲਾ ਸਾਜ ਸੱਜਿਯੰ ॥੧॥",
      "s": 2
    },
    {
      "t": "ਕਰਿਯੋ ਜੋਰ ਸੈਨੰ ਹੁਸੈਨੀ ਪਯਾਨੰ ॥",
      "s": 2
    },
    {
      "t": "ਪ੍ਰਥਮ ਕੂਟਿ ਕੈ ਲੂਟ ਲੀਨੇ ਅਵਾਨੰ ॥",
      "s": 2
    },
    {
      "t": "ਪੁਨਰ ਡਢਵਾਲੰ ਕੀਯੋ ਜੀਤਿ ਜੇਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਕਰੇ ਬੰਦਿ ਕੈ ਰਾਜ ਪੁਤ੍ਰਾਨ ਚੇਰੰ ॥੨॥",
      "s": 2
    },
    {
      "t": "ਪੁਨਰਿ ਦੂਨਿ ਕੋ ਲੂਟ ਲੀਨੋ ਸੁਧਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਕੋਈ ਸਾਮੁਹੇ ਹ੍ਵੈ ਸਕਿਯੋ ਨ ਗਵਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਲੀਯੋ ਛੀਨ ਅੰਨੰ ਦਲੰ ਬਾਂਟਿ ਦੀਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਮਹਾ ਮੂੜਿਯੰ ਕੁਤਸਤੰ ਕਾਜ ਕੀਯੰ ॥੩॥",
      "s": 2
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਕਿਤਕ ਦਿਵਸ ਬੀਤਤ ਭਏ ਕਰਤ ਉਸੈ ਉਤਪਾਤ ॥",
      "s": 2
    },
    {
      "t": "ਗੁਆਲੇਰੀਅਨ ਕੀ ਪਰਤ ਭੀ ਆਨ ਮਿਲਨ ਕੀ ਬਾਤ ॥੪॥",
      "s": 2
    },
    {
      "t": "ਜੌ ਦਿਨ ਦੁਇਕ ਨ ਵੇ ਮਿਲਤ ਤਬ ਆਵਤ ਅਰਰਾਇ ॥",
      "s": 2
    },
    {
      "t": "ਕਾਲਿ ਤਿਨੂ ਕੇ ਘਰ ਬਿਖੈ ਡਾਰੀ ਕਲਹ ਬਨਾਇ ॥੫॥",
      "s": 2
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 2
    },
    {
      "t": "ਗੁਆਲੇਰੀਆ ਮਿਲਨ ਕਹੁ ਆਏ ॥",
      "s": 2
    },
    {
      "t": "ਰਾਮ ਸਿੰਘ ਭੀ ਸੰਗਿ ਸਿਧਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਚਤਰਥ ਆਨ ਮਿਲਤ ਭਏ ਜਾਮੰ ॥",
      "s": 2
    },
    {
      "t": "ਫੂਟਿ ਗਈ ਲਖਿ ਨਜਰਿ ਗੁਲਾਮੰ ॥੬॥",
      "s": 2
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਜੈਸੇ ਰਵਿ ਕੇ ਤੇਜ ਤੇ ਰੇਤ ਅਧਿਕ ਤਪਤਾਇ ॥",
      "s": 2
    },
    {
      "t": "ਰਵਿ ਬਲਿ ਛੁਦ੍ਰ ਨ ਜਾਨਈ ਆਪਨ ਹੀ ਗਰਬਾਇ ॥੭॥",
      "s": 2
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 2
    },
    {
      "t": "ਤੈਸੇ ਹੀ ਫੂਲ ਗੁਲਾਮ ਜਾਤ ਭਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਨੈ ਨ ਦ੍ਰਿਸਟ ਤਰੇ ਆਨਤ ਭਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਕਾਹਲੂਰੀਆ ਕਟੋਚ ਸੰਗ ਲਹਿ ॥",
      "s": 2
    },
    {
      "t": "ਜਾਨਾ ਆਨ ਨ ਮੋ ਸਰ ਮਹਿ ਮਹਿ ॥੮॥",
      "s": 2
    },
    {
      "t": "ਤਿਨ ਜੋ ਧਨ ਆਨੋ ਸੋ ਸਾਥਾ ॥",
      "s": 2
    },
    {
      "t": "ਤੇ ਦੇ ਰਹੇ ਹੁਸੈਨੀ ਹਾਥਾ ॥",
      "s": 2
    },
    {
      "t": "ਦੇਤ ਲੇਤ ਆਪਨ ਕੁਰਰਾਨੇ ॥",
      "s": 2
    },
    {
      "t": "ਤੇ ਧਨਿ ਲੈ ਨਿਜਿ ਧਾਮ ਸਿਧਾਨੇ ॥੯॥",
      "s": 2
    },
    {
      "t": "ਚੇਰੋ ਤਬੈ ਤੇਜ ਤਨ ਤਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਭਲਾ ਬੁਰਾ ਕਛੁ ਲਖਤ ਨ ਭਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਛੰਦ ਬੰਦ ਨਹ ਨੈਕੁ ਬਿਚਾਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਜਾਤ ਭਯੋ ਦੇ ਤਬਹਿ ਨਗਾਰਾ ॥੧੦॥",
      "s": 2
    },
    {
      "t": "ਦਾਵ ਘਾਵ ਤਿਨ ਨੈਕੁ ਨ ਕਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਸਿੰਘਹਿ ਘੇਰਿ ਸਸਾ ਕਹੁ ਡਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਪੰਦ੍ਰਹ ਪਹਿਰ ਗਿਰਦ ਤਿਨ ਕੀਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਖਾਨ ਪਾਨ ਤਿਨ ਜਾਨ ਨ ਦੀਯੋ ॥੧੧॥",
      "s": 2
    },
    {
      "t": "ਖਾਨ ਪਾਨ ਬਿਨ ਸੂਰਿ ਰਿਸਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਸਾਮ ਕਰਨ ਹਿਤ ਦੂਤ ਪਠਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਦਾਸ ਨਿਰਖ ਸੰਗਿ ਸੈਨ ਪਠਾਨੀ ॥",
      "s": 2
    },
    {
      "t": "ਫੂਲਿ ਗਯੋ ਤਿਨ ਕੀ ਨਹੀਂ ਮਾਨੀ ॥੧੨॥",
      "s": 2
    },
    {
      "t": "ਦਸ ਸਹੰਸ੍ਰ ਅਬ ਹੀ ਕੈ ਦੈਹੂ ॥",
      "s": 2
    },
    {
      "t": "ਨਾ ਤਰ ਮੀਚ ਮੂੰਡ ਪਰ ਲੈਹੂ ॥",
      "s": 2
    },
    {
      "t": "ਸਿੰਘ ਸੰਗਤੀਆ ਤਹਾ ਪਠਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਗੋਪਾਲੈ ਸੁ ਧਰਮੁ ਦੇ ਲਿਆਏ ॥੧੩॥",
      "s": 2
    },
    {
      "t": "ਤਿਨ ਕੈ ਸੰਗਿ ਨ ਉਨ ਕੀ ਬਨੀ ॥",
      "s": 2
    },
    {
      "t": "ਤਬ ਕ੍ਰਿਪਾਲ ਚਿਤ ਮੋ ਇਹ ਗਨੀ ॥",
      "s": 2
    },
    {
      "t": "ਐਸਿ ਘਾਤਿ ਫਿਰ ਹਾਥ ਨ ਐਹੈ ॥",
      "s": 2
    },
    {
      "t": "ਸਬਹੂੰ ਫੇਰ ਸਮੋ ਛਲਿ ਜੈਹੈ ॥੧੪॥",
      "s": 2
    },
    {
      "t": "ਗੋਪਾਲੈ ਸੁ ਅਬੈ ਗਹਿ ਲੀਜੈ ॥",
      "s": 2
    },
    {
      "t": "ਕੈਦ ਕੀਜੀਐ ਕੈ ਬਧ ਕੀਜੈ ॥",
      "s": 2
    },
    {
      "t": "ਤਨਕ ਭਨਕ ਜਬ ਤਿਨ ਸੁਨ ਪਾਈ ॥",
      "s": 2
    },
    {
      "t": "ਨਿਜ ਦਲ ਜਾਤ ਭਯੋ ਭਟਰਾਈ ॥੧੫॥",
      "s": 2
    },
    {
      "t": "ਮਧੁਭਾਰ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਜਬ ਗਯੋ ਗੁਪਾਲ ॥",
      "s": 2
    },
    {
      "t": "ਕੁੱਪਿਯੋ ਕ੍ਰਿਪਾਲ ॥",
      "s": 2
    },
    {
      "t": "ਹਿੰਮਤ ਹੁਸੈਨ ॥",
      "s": 2
    },
    {
      "t": "ਜੁੰਮੈ ਲੁਝੈਨ ॥੧੬॥",
      "s": 2
    },
    {
      "t": "ਕਰਿ ਕੇ ਗੁਮਾਨ ॥",
      "s": 2
    },
    {
      "t": "ਜੁੰਮੈ ਜੁਆਨ ॥",
      "s": 2
    },
    {
      "t": "ਬੱਜੇ ਤੱਬਲ ॥",
      "s": 2
    },
    {
      "t": "ਦੁੰਦਭਿ ਦੱਬਲ ॥੧੭॥",
      "s": 2
    },
    {
      "t": "ਬੱਜੇ ਨਿਸਾਣ ॥",
      "s": 2
    },
    {
      "t": "ਨੱਚੇ ਕਿਕਾਣ ॥",
      "s": 2
    },
    {
      "t": "ਬਾਹੈ ਤੜਾਕ ॥",
      "s": 2
    },
    {
      "t": "ਉੱਠੈ ਕੜਾਕ ॥੧੮॥",
      "s": 2
    },
    {
      "t": "ਬੱਜੇ ਨਿਸੰਗ ॥",
      "s": 2
    },
    {
      "t": "ਗੱਜੇ ਨਿਹੰਗ ॥",
      "s": 2
    },
    {
      "t": "ਛੁੱਟੈ ਕ੍ਰਿਪਾਨ ॥",
      "s": 2
    },
    {
      "t": "ਲਿੱਟੈ ਜੁਆਨ ॥੧੯॥",
      "s": 2
    }
  ]
}
