{
  "page": 67,
  "lines": [
    {
      "t": "ਤੁੱਪਕ ਤੜਾਕ ॥",
      "s": 2
    },
    {
      "t": "ਕੈਬਰ ਕੜਾਕ ॥",
      "s": 2
    },
    {
      "t": "ਸੈਹਥੀ ਸੜਾਕ ॥",
      "s": 2
    },
    {
      "t": "ਛੌਹੀ ਛੜਾਕ ॥੨੦॥",
      "s": 2
    },
    {
      "t": "ਗੱਜੇ ਸੁ ਬੀਰ ॥",
      "s": 2
    },
    {
      "t": "ਬੱਜੇ ਗਹੀਰ ॥",
      "s": 2
    },
    {
      "t": "ਬਿਚਰੇ ਨਿਹੰਗ ॥",
      "s": 2
    },
    {
      "t": "ਜੈਸੇ ਪਿਲੰਗ ॥੨੧॥",
      "s": 2
    },
    {
      "t": "ਹੁੰਕੇ ਕਿਕਾਣ ॥",
      "s": 2
    },
    {
      "t": "ਧੁੰਕੇ ਨਿਸਾਣ ॥",
      "s": 2
    },
    {
      "t": "ਬਾਹੈ ਤੜਾਕ ॥",
      "s": 2
    },
    {
      "t": "ਝੱਲੈ ਝੜਾਕ ॥੨੨॥",
      "s": 2
    },
    {
      "t": "ਜੁੱਝੇ ਨਿਹੰਗ ॥",
      "s": 2
    },
    {
      "t": "ਲਿੱਟੇ ਮਲੰਗ ॥",
      "s": 2
    },
    {
      "t": "ਖੁਲ੍ਹੇ ਕਿਸਾਰ ॥",
      "s": 2
    },
    {
      "t": "ਜਨੁ ਜਟਾਧਾਰ ॥੨੩॥",
      "s": 2
    },
    {
      "t": "ਸਜੇ ਗਜਿੰਦ੍ਰ ॥",
      "s": 2
    },
    {
      "t": "ਗਜੇ ਗਜਿੰਦ੍ਰ ॥",
      "s": 2
    },
    {
      "t": "ਉੱਤਰੇ ਖਾਨ ॥",
      "s": 2
    },
    {
      "t": "ਲੈ ਲੈ ਕਮਾਨ ॥੨੪॥",
      "s": 2
    },
    {
      "t": "ਤ੍ਰਿਭੰਗੀ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਕੁਪਿਯੋ ਕ੍ਰਿਪਾਲੰ ਸੱਜਿ ਮਰਾਲੰ ਬਾਹ ਬਿਸਾਲੰ ਧਰਿ ਢਾਲੰ ॥",
      "s": 2
    },
    {
      "t": "ਧਾਏ ਸਭ ਸੂਰੰ ਰੂਪ ਕਰੂਰੰ ਚਮਕਤ ਨੂਰੰ ਮੁਖ ਲਾਲੰ ॥",
      "s": 2
    },
    {
      "t": "ਲੈ ਲੈ ਸੁ ਕ੍ਰਿਪਾਨੰ ਬਾਣ ਕਮਾਣੰ ਸਜੇ ਜੁਆਨੰ ਤਨ ਤੱਤੰ ॥",
      "s": 2
    },
    {
      "t": "ਰਣਿ ਰੰਗ ਕਲੋਲੰ ਮਾਰਹੀ ਬੋਲੰ ਜਨ ਗਜ ਡੋਲੰ ਬਨ ਮਤੰ ॥੨੫॥",
      "s": 2
    },
    {
      "t": "ਭੁਯੰਗ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਤਬੈ ਕੋਪੀਯੰ ਕਾਂਗੜੇਸੰ ਕਟੋਚੰ ॥",
      "s": 2
    },
    {
      "t": "ਮੁਖੰ ਰਕਤ ਨੈਨੰ ਤਜੇ ਸਰਬ ਸੋਚੰ ॥",
      "s": 2
    },
    {
      "t": "ਉਤੇ ਉੱਠੀਯੰ ਖਾਨ ਖੇਤੰ ਖਤੰਗੰ ॥",
      "s": 2
    },
    {
      "t": "ਮਨੋ ਬਿਹਚਰੈ ਮਾਸ ਹੇਤੰ ਪਿਲੰਗੰ ॥੨੬॥",
      "s": 2
    },
    {
      "t": "ਬਜੀ ਭੇਰ ਭੁੰਕਾਰ ਤੀਰੰ ਤੱੜਕੇ ॥",
      "s": 2
    },
    {
      "t": "ਮਿਲੇ ਹੱਥਿ ਬੱਖੰ ਕ੍ਰਿਪਾਣੰ ਕੱੜਕੇ ॥",
      "s": 2
    },
    {
      "t": "ਬਜੇ ਜੰਗ ਨੀਸਾਣ ਕੱਥੇ ਕਥੀਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਫਿਰੈ ਰੁੰਡ ਮੁੰਡੰ ਤਨੰ ਤੱਛ ਤੀਰੰ ॥੨੭॥",
      "s": 2
    },
    {
      "t": "ਉਠੈ ਟੋਪ ਟੂਕੰ ਗੁਰਜੈ ਪ੍ਰਹਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਰੁਲੇ ਲੁੱਥ ਜੁੱਥੰ ਗਿਰੇ ਬੀਰ ਮਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਪਰੈ ਕੱਤੀਯੰ ਘਾਤ ਨਿਰਘਾਤ ਬੀਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਫਿਰੈ ਰੁੰਡ ਮੁੰਡੰ ਤਨੰ ਤੱਛ ਤੀਰੰ ॥੨੮॥",
      "s": 2
    },
    {
      "t": "ਬਹੀ ਬਾਹੁ ਆਘਾਤ ਨਿਰਘਾਤ ਬਾਣੰ ॥",
      "s": 2
    },
    {
      "t": "ਉਠੇ ਨੱਦ ਨਾਦੰ ਕੱੜਕੇ ਕ੍ਰਿਪਾਣੰ ॥",
      "s": 2
    },
    {
      "t": "ਛਕੇ ਛੋਭ ਛਤ੍ਰੀ ਤਜੈ ਬਾਣ ਰਾਜੀ ॥",
      "s": 2
    },
    {
      "t": "ਬਹੇ ਜਾਹਿ ਖਾਲੀ ਫਿਰੈ ਛੂਛ ਤਾਜੀ ॥੨੯॥",
      "s": 2
    },
    {
      "t": "ਜੁਟੇ ਆਪ ਮੈ ਬੀਰ ਬੀਰੰ ਜੁਝਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਮਨੋ ਗੱਜ ਜੁੱਟੇ ਦੰਤਾਰੇ ਦੰਤਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਕਿਧੋ ਸਿੰਘ ਸੋ ਸਾਰਦੂਲੰ ਅਰੁੱਝੇ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਸੀ ਭਾਂਤਿ ਕਿਰਪਾਲ ਗੋੁਪਾਲ ਜੁੱਝੇ ॥੩੦॥",
      "s": 2
    },
    {
      "t": "ਹਰੀ ਸਿੰਘ ਧਾਯੋ ਤਹਾਂ ਏਕ ਬੀਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਸਹੇ ਦੇਹ ਆਪੰ ਭਲੀ ਭਾਂਤਿ ਤੀਰੰ ॥",
      "s": 2
    }
  ]
}
