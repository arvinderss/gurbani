{
  "page": 68,
  "lines": [
    {
      "t": "ਮਹਾਂ ਕੋਪ ਕੈ ਬੀਰ ਬ੍ਰਿੰਦੰ ਸੰਘਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਬਡੋ ਜੁਧ ਕੈ ਦੇਵ ਲੋਕੰ ਪਧਾਰੇ ॥੩੧॥",
      "s": 2
    },
    {
      "t": "ਹਠਿਯੋ ਹਿੰਮਤੰ ਕਿੰਮਤੰ ਲੈ ਕ੍ਰਿਪਾਨੰ ॥",
      "s": 2
    },
    {
      "t": "ਲਏ ਗੁਰਜ ਚੱਲੰ ਸੁ ਜਲਾਲਖਾਨੰ ॥",
      "s": 2
    },
    {
      "t": "ਹਠੇ ਸੂਰਮਾ ਮੱਤ ਜੋਧਾ ਜੁਝਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਪਰੀ ਕੁੱਟ ਕੁੱਟੰ ਉਠੀ ਸਸਤ੍ਰ ਝਾਰੰ ॥੩੨॥",
      "s": 2
    },
    {
      "t": "ਰਸਾਵਲ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਜਸੰਵਾਲ ਧਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਤੁਰੰਗੰ ਨਚਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਲਯੋ ਘੇਰ ਹੁਸੈਨੀ ॥",
      "s": 2
    },
    {
      "t": "ਹਨਿਯੋ ਸਾਂਗ ਪੈਨੀ ॥੩੩॥",
      "s": 2
    },
    {
      "t": "ਤਿਨੂ ਬਾਣ ਬਾਹੇ ॥",
      "s": 2
    },
    {
      "t": "ਬਡੇ ਸੈਨ ਗਾਹੇ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਸੈ ਅੰਗਿ ਲਾਗਿਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਸੈ ਪ੍ਰਾਣ ਤਯਾਗਯੋ ॥੩੪॥",
      "s": 2
    },
    {
      "t": "ਜਬੈ ਘਾਵ ਲਾਗਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਤਬੈ ਕੋਪ ਜਾਗਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਸੰਭਾਰੀ ਕਮਾਣੰ ॥",
      "s": 2
    },
    {
      "t": "ਹਨੇ ਬੀਰ ਬਾਣੰ ॥੩੫॥",
      "s": 2
    },
    {
      "t": "ਚਹੂੰ ਓਰ ਢੂਕੇ ॥",
      "s": 2
    },
    {
      "t": "ਮੁਖੰ ਮਾਰ ਕੂਕੇ ॥",
      "s": 2
    },
    {
      "t": "ਨ੍ਰਿਭੈ ਸਸਤ੍ਰ ਬਾਹੈਂ ॥",
      "s": 2
    },
    {
      "t": "ਦੋਊ ਜੀਤ ਚਾਹੈਂ ॥੩੬॥",
      "s": 2
    },
    {
      "t": "ਰਿਸੇ ਖਾਨਜਾਦੇ ॥",
      "s": 2
    },
    {
      "t": "ਮਹਾ ਮੱਦ ਮਾਦੇ ॥",
      "s": 2
    },
    {
      "t": "ਮਹਾ ਬਾਣ ਬਰਖੇ ॥",
      "s": 2
    },
    {
      "t": "ਸਭੈ ਸੂਰ ਹਰਖੇ ॥੩੭॥",
      "s": 2
    },
    {
      "t": "ਕਰੈ ਬਾਣ ਅਰਚਾ ॥",
      "s": 2
    },
    {
      "t": "ਧਨੁਰ ਬੇਦ ਚਰਚਾ ॥",
      "s": 2
    },
    {
      "t": "ਸੁ ਸਾਗੰ ਸਮ੍ਹਾਲੰ ॥",
      "s": 2
    },
    {
      "t": "ਕਰੈ ਤਉਨ ਠਾਮੰ ॥੩੮॥",
      "s": 2
    },
    {
      "t": "ਬਲੀ ਬੀਰ ਰੁੱਝੇ ॥",
      "s": 2
    },
    {
      "t": "ਸਮੂਹ ਸਸਤ੍ਰ ਜੁੱਝੇ ॥",
      "s": 2
    },
    {
      "t": "ਲਗੈ ਧੀਰ ਧੱਕੇ ॥",
      "s": 2
    },
    {
      "t": "ਕ੍ਰਿਪਾਣੰ ਝਨੱਕੇ ॥੩੯॥",
      "s": 2
    },
    {
      "t": "ਕੱੜਕੈ ਕਮਾਣੰ ॥",
      "s": 2
    },
    {
      "t": "ਝਣੱਕੈ ਕ੍ਰਿਪਾਣੰ ॥",
      "s": 2
    },
    {
      "t": "ਕੜੰਕਾਰ ਛੁੱਟੈ ॥",
      "s": 2
    },
    {
      "t": "ਝਣੰਕਾਰ ਉੱਠੈ ॥੪੦॥",
      "s": 2
    },
    {
      "t": "ਹਠੀ ਸਸਤ੍ਰ ਝਾਰੈ ॥",
      "s": 2
    },
    {
      "t": "ਨ ਸੰਕਾ ਬਿਚਾਰੈ ॥",
      "s": 2
    },
    {
      "t": "ਕਰੈ ਤੀਰ ਮਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਫਿਰੈ ਲੋਹ ਧਾਰੰ ॥੪੧॥",
      "s": 2
    },
    {
      "t": "ਨਦੀ ਸ੍ਰੌਣ ਪੂਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਫਿਰੈ ਗੈਣ ਹੂਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਉਭੇ ਖੇਤ ਪਾਲੰ ॥",
      "s": 2
    },
    {
      "t": "ਬਕੇ ਬਿੱਕਰਾਲੰ ॥੪੨॥",
      "s": 2
    },
    {
      "t": "ਪਾਧੜੀ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਤਹ ਹੜ ਹੜਾਇ ਹੱਸੇ ਮਸਾਣ ॥",
      "s": 2
    },
    {
      "t": "ਲਿੱਟੇ ਗਜਿੰਦ੍ਰ ਛੁੱਟੇ ਕਿਕਾਣ ॥",
      "s": 2
    },
    {
      "t": "ਜੁੱਟੇ ਸੁ ਬੀਰ ਤਹ ਕੜਕ ਜੰਗ ॥",
      "s": 2
    },
    {
      "t": "ਛੁੱਟੀ ਕ੍ਰਿਪਾਣ ਵੁਠੇ ਖਤੰਗ ॥੪੩॥",
      "s": 2
    },
    {
      "t": "ਡਾਕਨਿ ਡਹਿਕ ਚਾਵਡਿ ਚਿਕਾਰ ॥",
      "s": 2
    },
    {
      "t": "ਕਾਕੰ ਕਹੱਕਿ ਬੱਜੇ ਦੁਧਾਰ ॥",
      "s": 2
    },
    {
      "t": "ਖੋਲੰ ਖੜੱਕਿ ਤੁਪਕਿ ਤੜਾਕਿ ॥",
      "s": 2
    },
    {
      "t": "ਸੈਥੰ ਸੜੱਕ ਧੱਕੰ ਧਹਾਕਿ ॥੪੪॥",
      "s": 2
    },
    {
      "t": "ਭੁਜੰਗ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਤਹਾ ਆਪ ਕੀਨੋ ਹੁਸੈਨੀ ਉਤਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਸਭੂ ਹਾਥ ਬਾਣੰ ਕਮਾਣੰ ਸੰਭਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਰੁਪੇ ਖਾਨਿ ਖੂਨੀ ਕਰੈ ਲਾਗ ਜੁੱਧੰ ॥",
      "s": 2
    },
    {
      "t": "ਮੁਖੰ ਰਕਤ ਨੈਣੰ ਭਰੇ ਸੂਰ ਕ੍ਰੁੱਧੰ ॥੪੫॥",
      "s": 2
    },
    {
      "t": "ਜਗਿਯੋ ਜੰਗ ਜਾਲਮ ਸੁ ਜੋਧੰ ਜੁਝਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਬਹੇ ਬਾਣ ਬਾਂਕੇ ਬਰੱਛੀ ਦੁਧਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਮਿਲੇ ਬੀਰ ਬੀਰੰ ਮਹਾਂ ਧੀਰ ਬੰਕੇ ॥",
      "s": 2
    },
    {
      "t": "ਧਕਾ ਧਕਿ ਸੈਥੰ ਕ੍ਰਿਪਾਨੰ ਝਨੰਕੇ ॥੪੬॥",
      "s": 2
    },
    {
      "t": "ਭਏ ਢੋਲ ਢੰਕਾਰ ਨਾਦੰ ਨਫੀਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਉਠੈ ਬਾਹੁ ਆਘਾਤ ਗੱਜੈ ਸੁ ਬੀਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਨਵੰ ਨੱਦ ਨੀਸਾਨ ਬੱਜੇ ਅਪਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਰੁਲੇ ਤੱਛ ਮੁੱਛੰ ਉਠੀ ਸਸਤ੍ਰ ਝਾਰੰ ॥੪੭॥",
      "s": 2
    },
    {
      "t": "ਟਕਾ ਟੁੱਕ ਟੋਪੰ ਢਕਾ ਢੁੱਕ ਢਾਲੰ ॥",
      "s": 2
    },
    {
      "t": "ਮਹਾਂ ਬੀਰ ਬਾਨੈਤ ਬੰਕੇ ਬਿਕ੍ਰਾਲੰ ॥",
      "s": 2
    },
    {
      "t": "ਨਚੇ ਬੀਰ ਬੈਤਾਲਯੰ ਭੂਤ ਪ੍ਰੇਤੰ ॥",
      "s": 2
    }
  ]
}
