{
  "page": 69,
  "lines": [
    {
      "t": "ਨਚੀ ਡਾਕਿਣੀ ਜੋਗਣੀ ਉਰਧ ਹੇਤੰ ॥੪੮॥",
      "s": 2
    },
    {
      "t": "ਛੁਟੀ ਜੋਗ ਤਾਰੀ ਮਹਾਂ ਰੁਦ੍ਰ ਜਾਗੇ ॥",
      "s": 2
    },
    {
      "t": "ਡਗਿਯੋ ਧਿਆਨ ਬ੍ਰਹਮੰ ਸਭੈ ਸਿੱਧ ਭਾਗੇ ॥",
      "s": 2
    },
    {
      "t": "ਹਸੇ ਕਿੰਨਰੰ ਜੱਛ ਬਿੱਦਿਆ ਧਰੇਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਨਚੀ ਅੱਛਰਾ ਪੱਛਰਾ ਚਾਰਣੇਯੰ ॥੪੯॥",
      "s": 2
    },
    {
      "t": "ਪਰਿਓ ਘੋਰ ਜੁੱਧੰ ਸੁ ਸੈਨਾ ਪਰਾਨੀ ॥",
      "s": 2
    },
    {
      "t": "ਤਹਾਂ ਖਾਂ ਹੁਸੈਨੀ ਮੰਡਿਓ ਬੀਰ ਬਾਨੀ ॥",
      "s": 2
    },
    {
      "t": "ਉਤੈ ਬੀਰ ਧਾਏ ਸੁ ਬੀਰੰ ਜਸ੍ਵਾਰੰ ॥",
      "s": 2
    },
    {
      "t": "ਸਬੈ ਬਿਉਤ ਡਾਰੇ ਬਗਾ ਸੇ ਅਸ੍ਵਾਰੰ ॥੫੦॥",
      "s": 2
    },
    {
      "t": "ਤਹਾਂ ਖਾਂ ਹੁਸੈਨੀ ਰਹਿਓ ਏਕ ਠਾਢੰ ॥",
      "s": 2
    },
    {
      "t": "ਮਨੋ ਜੁੱਧ ਖੰਭੰ ਰਣੰ ਭੂਮ ਗਾਡੰ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਸੈ ਕੋਪ ਕੈ ਕੈ ਹਠੀ ਬਾਣ ਮਾਰਿਓ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਸੈ ਛੇਦ ਕੈ ਪੈਲ ਪਾਰੇ ਪਧਾਰਿਓ ॥੫੧॥",
      "s": 2
    },
    {
      "t": "ਸਹੇ ਬਾਣ ਸੂਰੰ ਸਭੈ ਆਣ ਢੂਕੈ ॥",
      "s": 2
    },
    {
      "t": "ਚਹੂੰ ਓਰ ਤੇ ਮਾਰ ਹੀ ਮਾਰ ਕੂਕੈ ॥",
      "s": 2
    },
    {
      "t": "ਭਲੀ ਭਾਂਤਿ ਸੋ ਅਸਤ੍ਰ ਅਉ ਸਸਤ੍ਰ ਝਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਗਿਰੇ ਭਿਸਤ ਕੋ ਖਾਂ ਹੁਸੈਨੀ ਸਿਧਾਰੇ ॥੫੨॥",
      "s": 2
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਜਬੈ ਹੁਸੈਨੀ ਜੂਝਿਓ ਭਯੋ ਸੂਰ ਮਨ ਰੋਸੁ ॥",
      "s": 2
    },
    {
      "t": "ਭਾਜਿ ਚਲੇ ਅਵਰੇ ਸਭੈ ਉਠਿਓ ਕਟੋਚਨ ਜੋਸੁ ॥੫੩॥",
      "s": 2
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 2
    },
    {
      "t": "ਕੋਪਿ ਕਟੋਚਿ ਸਬੈ ਮਿਲਿ ਧਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਹਿੰਮਤਿ ਕਿੰਮਤਿ ਸਹਿਤ ਰਿਸਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਹਰੀ ਸਿੰਘ ਤਬ ਕੀਯਾ ਉਠਾਨਾ ॥",
      "s": 2
    },
    {
      "t": "ਚੁਨਿ ਚੁਨਿ ਹਨੇ ਪਖਰੀਯਾ ਜੁਆਨਾ ॥੫੪॥",
      "s": 2
    },
    {
      "t": "ਨਰਾਜ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਤਬੈ ਕਟੋਚ ਕੋਪੀਅੰ ॥",
      "s": 2
    },
    {
      "t": "ਸੰਭਾਰ ਪਾਵ ਰੋਪੀਅੰ ॥",
      "s": 2
    },
    {
      "t": "ਸਰੱਕ ਸਸਤ੍ਰ ਝਾਰਹੀ ॥",
      "s": 2
    },
    {
      "t": "ਸੁ ਮਾਰਿ ਮਾਰਿ ਉਚਾਰਹੀ ॥੫੫॥",
      "s": 2
    },
    {
      "t": "ਚੰਦੇਲ ਚੌਪੀਯੰ ਤਬੈ ॥",
      "s": 2
    },
    {
      "t": "ਰਿਸਾਤ ਧਾਤ ਭੇ ਸਬੈ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਤੇ ਗਏ ਸੁ ਮਾਰੀਯੰ ॥",
      "s": 2
    },
    {
      "t": "ਬਚੇ ਤਿਤੇ ਸਿਧਾਰੀਯੰ ॥੫੬॥",
      "s": 2
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਸਾਤ ਸਵਾਰਨ ਕੇ ਸਹਿਤ ਜੂਝੇ ਸੰਗਤ ਰਾਇ ॥",
      "s": 2
    },
    {
      "t": "ਦਰਸੋ ਸੁਨਿ ਜੂਝੈ ਤਿਨੈ ਬਹੁਤ ਜੁਝਤ ਭਯੋ ਆਇ ॥੫੭॥",
      "s": 2
    },
    {
      "t": "ਹਿੰਮਤ ਹੂੰ ਉਤਰਿਯੋ ਤਹਾ ਬੀਰ ਖੇਤ ਮੰਝਾਰ ॥",
      "s": 2
    },
    {
      "t": "ਕੇਤਨ ਕੇ ਤਨਿ ਘਾਇ ਸਹਿ ਕੇਤਨਿ ਕੈ ਤਨਿ ਝਾਰ ॥੫੮॥",
      "s": 2
    },
    {
      "t": "ਬਾਜ ਤਹਾਂ ਜੂਝਤ ਭਯੋ ਹਿੰਮਤ ਗਯੋ ਪਰਾਇ ॥",
      "s": 2
    },
    {
      "t": "ਲੋਥ ਕ੍ਰਿਪਾਲਹਿ ਕੀ ਨਮਿਤ ਕੋਪਿ ਪਰੇ ਅਰਰਾਇ ॥੫੯॥",
      "s": 2
    },
    {
      "t": "ਰਸਾਵਲ ਛੰਦ ॥",
      "s": 2
    },
    {
      "t": "ਬਲੀ ਬੈਰ ਰੁੱਝੇ ॥",
      "s": 2
    },
    {
      "t": "ਸਮੁਹਿ ਸਾਰ ਜੁੱਝੇ ॥",
      "s": 2
    },
    {
      "t": "ਕ੍ਰਿਪਾ ਰਾਮ ਗਾਜੀ ॥",
      "s": 2
    },
    {
      "t": "ਲਰਿਓ ਸੈਨ ਭਾਜੀ ॥੬੦॥",
      "s": 2
    },
    {
      "t": "ਮਹਾ ਸੈਨ ਗਾਹੈਂ ॥",
      "s": 2
    },
    {
      "t": "ਨ੍ਰਿਭੈ ਸਸਤ੍ਰ ਬਾਹੈਂ ॥",
      "s": 2
    }
  ]
}
