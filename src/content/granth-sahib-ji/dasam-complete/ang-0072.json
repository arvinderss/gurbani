{
  "page": 72,
  "lines": [
    {
      "t": "ਦੀਨ ਸਾਹ ਇਨ ਕੋ ਪਹਿਚਾਨੋ ॥",
      "s": 2
    },
    {
      "t": "ਦੁਨੀ ਪੱਤਿ ਉਨ ਕੌ ਅਨੁਮਾਨੋ ॥੯॥",
      "s": 2
    },
    {
      "t": "ਜੋ ਬਾਬੇ ਕੇ ਦਾਮ ਨ ਦੈਹੈਂ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਨ ਤੇ ਗਹਿ ਬਾਬਰ ਕੇ ਲੈਹੈਂ ॥",
      "s": 2
    },
    {
      "t": "ਦੈ ਦੈ ਤਿਨ ਕੌ ਬਡੀ ਸਜਾਇ ॥",
      "s": 2
    },
    {
      "t": "ਪੁਨਿ ਲੈਹੈਂ ਗ੍ਰਿਹ ਲੂਟ ਬਨਾਇ ॥੧੦॥",
      "s": 2
    },
    {
      "t": "ਜਬ ਹ੍ਵੈਹੈਂ ਬੇਮੁਖ ਬਿਨਾ ਧਨ ॥",
      "s": 2
    },
    {
      "t": "ਤਬ ਚੜਿਹੈਂ ਸਿਖਨ ਕਹ ਮਾਂਗਨ ॥",
      "s": 2
    },
    {
      "t": "ਜੇ ਜੇ ਸਿਖ ਤਿਨੈ ਧਨ ਦੈਹੈਂ ॥",
      "s": 2
    },
    {
      "t": "ਲੂਟ ਮਲੇਛ ਤਿਨੂ ਕੌ ਲੈਹੈਂ ॥੧੧॥",
      "s": 2
    },
    {
      "t": "ਜਬ ਹੁਇ ਹੈ ਤਿਨ ਦਰਬ ਬਿਨਾਸਾ ॥",
      "s": 2
    },
    {
      "t": "ਤਬ ਧਰਿਹੈ ਨਿਜ ਗੁਰ ਕੀ ਆਸਾ ॥",
      "s": 2
    },
    {
      "t": "ਜਬ ਤੇ ਗੁਰ ਦਰਸਨ ਕੌ ਐਹੈਂ ॥",
      "s": 2
    },
    {
      "t": "ਤਬ ਤਿਨ ਕੋ ਗੁਰ ਮੁਖ ਨ ਲਗੈਹੈਂ ॥੧੨॥",
      "s": 2
    },
    {
      "t": "ਬਿਦਾ ਬਿਨਾ ਜੈਹੈਂ ਤਬ ਧਾਮੰ ॥",
      "s": 2
    },
    {
      "t": "ਸਰਿਹੈ ਕੋਈ ਨ ਤਿਨ ਕੋ ਕਾਮੰ ॥",
      "s": 2
    },
    {
      "t": "ਗੁਰ ਦਰ ਢੋਈ ਨ ਪ੍ਰਭ ਪੁਰ ਵਾਸਾ ॥",
      "s": 2
    },
    {
      "t": "ਦੁਹੂੰ ਠਉਰ ਤੇ ਰਹੇ ਨਿਰਾਸਾ ॥੧੩॥",
      "s": 2
    },
    {
      "t": "ਜੇ ਜੇ ਗੁਰ ਚਰਨਨ ਰਤ ਹ੍ਵੈਹੈਂ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਨ ਕੋ ਕਸਟ ਨ ਦੇਖਨ ਪੈਹੈਂ ॥",
      "s": 2
    },
    {
      "t": "ਰਿਧ ਸਿਧ ਤਿਨ ਕੇ ਗ੍ਰਿਹ ਮਾਹੀਂ ॥",
      "s": 2
    },
    {
      "t": "ਪਾਪ ਤਾਪ ਛ੍ਵੈ ਸਕੈ ਨ ਛਾਹੀਂ ॥੧੪॥",
      "s": 2
    },
    {
      "t": "ਤਿਹ ਮਲੇਛ ਛ੍ਵੈਹੈ ਨਹੀਂ ਛਾਹਾਂ ॥",
      "s": 2
    },
    {
      "t": "ਅਸਟ ਸਿਧ ਹ੍ਵੈ ਹੈ ਘਰਿ ਮਾਹਾਂ ॥",
      "s": 2
    },
    {
      "t": "ਹਾਸ ਕਰਤ ਜੋ ਉਦਮ ਉਠੈਹੈਂ ॥",
      "s": 2
    },
    {
      "t": "ਨਵੋ ਨਿਧਿ ਤਿਨ ਕੇ ਘਰਿ ਐਹੈਂ ॥੧੫॥",
      "s": 2
    },
    {
      "t": "ਮਿਰਜਾ ਬੇਗ ਹੁਤੋ ਤਿਹ ਨਾਮੰ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਨ ਢਾਹੇ ਬੇਮੁਖਨ ਕੇ ਧਾਮੰ ॥",
      "s": 2
    },
    {
      "t": "ਸਬ ਸਨਮੁਖ ਗੁਰ ਆਪ ਬਚਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਨ ਕੇ ਬਾਰ ਨ ਬਾਂਕਨ ਪਾਏ ॥੧੬॥",
      "s": 2
    },
    {
      "t": "ਉਤ ਅਉਰੰਗ ਜੀਅ ਅਧਿਕ ਰਿਸਾਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਚਾਰ ਅਹਦੀਯਨ ਅਉਰ ਪਠਾਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਜੇ ਬੇਮੁਖ ਤਾਂ ਤੇ ਬਚਿ ਆਏ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਨ ਕੇ ਗ੍ਰਿਹ ਪੁਨਿ ਇਨੈ ਗਿਰਾਏ ॥੧੭॥",
      "s": 2
    },
    {
      "t": "ਜੇ ਤਜਿ ਭਜੇ ਹੁਤੇ ਗੁਰ ਆਨਾ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਨ ਪੁਨਿ ਗੁਰੂ ਅਹਦੀਅਹਿ ਜਾਨਾ ॥",
      "s": 2
    },
    {
      "t": "ਮੂਤ੍ਰ ਡਾਰ ਤਿਨ ਸੀਸ ਮੁੰਡਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਪਾਹੁਰਿ ਜਾਨਿ ਗ੍ਰਿਹਹਿ ਲੈ ਆਏ ॥੧੮॥",
      "s": 2
    },
    {
      "t": "ਜੇ ਜੇ ਭਾਜ ਹੁਤੇ ਬਿਨੁ ਆਇਸੁ ॥",
      "s": 2
    },
    {
      "t": "ਕਹੋ ਅਹਦੀਅਹਿ ਕਿਨੈ ਬਤਾਇਸੁ ॥",
      "s": 2
    },
    {
      "t": "ਮੂੰਡ ਮੂੰਡਿ ਕਰਿ ਸਹਿਰ ਫਿਰਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਕਾਰ ਭੇਟ ਜਨੁ ਲੈਨ ਸਿਧਾਏ ॥੧੯॥",
      "s": 2
    },
    {
      "t": "ਪਾਛੇ ਲਾਗਿ ਲਰਿਕਵਾ ਚਲੇ ॥",
      "s": 2
    },
    {
      "t": "ਜਾਨੁਕ ਸਿੱਖ ਸਖਾ ਹੈਂ ਭਲੇ ॥",
      "s": 2
    },
    {
      "t": "ਛਿੱਕੇ ਤੋਬਰਾ ਬਦਨ ਚੜਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਜਨੁ ਗ੍ਰਿਹ ਖਾਨ ਮਲੀਦਾ ਆਏ ॥੨੦॥",
      "s": 2
    },
    {
      "t": "ਮਸਤਕ ਸੁਭੇ ਪਨਹੀਯਨ ਘਾਇ ॥",
      "s": 2
    },
    {
      "t": "ਜਨੁ ਕਰਿ ਟੀਕਾ ਦਏ ਬਨਾਇ ॥",
      "s": 2
    }
  ]
}
