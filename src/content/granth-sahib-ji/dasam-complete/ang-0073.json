{
  "page": 73,
  "lines": [
    {
      "t": "ਸੀਸ ਈਟ ਕੇ ਘਾਇ ਕਰੇਹੀ ॥",
      "s": 2
    },
    {
      "t": "ਜਨੁ ਤਿਨੁ ਭੇਟ ਪੁਰਾਤਨ ਦੇਹੀ ॥੨੧॥",
      "s": 2
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਕਬਹੂੰ ਰਣ ਜੂਝਿਓ ਨਹੀ ਕਛੁ ਦੈ ਜਸੁ ਨਹਿ ਲੀਨ ॥",
      "s": 2
    },
    {
      "t": "ਗਾਂਵ ਬਸਤ ਜਾਨਿਯੋ ਨਹੀ ਜਮ ਸੋ ਕਿਨ ਕਹਿ ਦੀਨ ॥੨੨॥",
      "s": 2
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 2
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਤਿਨੋ ਭਯੋ ਉਪਹਾਸਾ ॥",
      "s": 2
    },
    {
      "t": "ਸਭ ਸੰਤਨ ਮਿਲਿ ਲਖਿਓ ਤਮਾਸਾ ॥",
      "s": 2
    },
    {
      "t": "ਸੰਤਨ ਕਸਟ ਨ ਦੇਖਨ ਪਾਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਆਪ ਹਾਥ ਦੈ ਨਾਥ ਬਚਾਯੋ ॥੨੩॥",
      "s": 2
    },
    {
      "t": "ਚਾਰਣੀ ॥ ਦੋਹਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਸ ਨੋ ਸਾਜਨ ਰਾਖਸੀ ਦੁਸਮਨ ਕਵਨ ਬਿਚਾਰ ॥",
      "s": 2
    },
    {
      "t": "ਛ੍ਵੈ ਨ ਸਕੈ ਤਿਹ ਛਾਹਿ ਕੌ ਨਿਹਫਲ ਜਾਇ ਗਵਾਰ ॥੨੪॥",
      "s": 2
    },
    {
      "t": "ਜੋ ਸਾਧੂ ਸਰਣੀ ਪਰੇ ਤਿਨ ਕੇ ਕਵਨ ਬਿਚਾਰ ॥",
      "s": 2
    },
    {
      "t": "ਦੰਤ ਜੀਭ ਜਿਮ ਰਾਖਿ ਹੈ ਦੁਸਟ ਅਰਿਸਟ ਸੰਘਾਰ ॥੨੫॥",
      "s": 2
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਸ਼ਾਹਜ਼ਾਦੇ ਵ ਅਹਿਦੀਆ ਗਮਨ ਬਰਨਨੰ ਨਾਮ ਤ੍ਰੌਦਸਮੋ ਧਿਆਇ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੩॥ ਅਫਜੂ ॥੪੬੦॥",
      "s": 2
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 2
    },
    {
      "t": "ਸਰਬ ਕਾਲ ਸਭ ਸਾਧ ਉਬਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਦੁਖੁ ਦੈ ਕੈ ਦੋਖੀ ਸਭ ਮਾਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਅਦਭੁਤਿ ਗਤਿ ਭਗਤਨ ਦਿਖਰਾਈ ॥",
      "s": 2
    },
    {
      "t": "ਸਭ ਸੰਕਟ ਤੇ ਲਏ ਬਚਾਈ ॥੧॥",
      "s": 2
    },
    {
      "t": "ਸਭ ਸੰਕਟ ਤੇ ਸੰਤ ਬਚਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਸਭ ਕੰਟਕ ਕੰਟਕ ਜਿਮ ਘਾਏ ॥",
      "s": 2
    },
    {
      "t": "ਦਾਸ ਜਾਨ ਮੁਹਿ ਕਰੀ ਸਹਾਇ ॥",
      "s": 2
    },
    {
      "t": "ਆਪ ਹਾਥ ਦੈ ਲਯੋ ਬਚਾਇ ॥੨॥",
      "s": 2
    },
    {
      "t": "ਅਬ ਜੋ ਜੋ ਮੈਂ ਲਖੇ ਤਮਾਸਾ ॥",
      "s": 2
    },
    {
      "t": "ਸੋ ਸੋ ਕਰੋ ਤੁਮੈ ਅਰਦਾਸਾ ॥",
      "s": 2
    },
    {
      "t": "ਜੋ ਪ੍ਰਭ ਕਿਰਪਾ ਕਟਾਛ ਦਿਖੈਹੈ ॥",
      "s": 2
    },
    {
      "t": "ਸੋ ਤਵ ਦਾਸ ਉਚਾਰਤ ਜੈਹੈ ॥੩॥",
      "s": 2
    },
    {
      "t": "ਜਿਹ ਜਿਹ ਬਿਧ ਮੈ ਲਖੇ ਤਮਾਸਾ ॥",
      "s": 2
    },
    {
      "t": "ਚਾਹਤ ਤਿਨ ਕੋ ਕੀਯੋ ਪ੍ਰਕਾਸਾ ॥",
      "s": 2
    },
    {
      "t": "ਜੋ ਜੋ ਜਨਮ ਪੂਰਬਲੇ ਹੇਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਕਹਿਹੋ ਸੁ ਪ੍ਰਭੁ ਪਰਾਕ੍ਰਮ ਤੇਰੇ ॥੪॥",
      "s": 2
    },
    {
      "t": "ਸਰਬ ਕਾਲ ਹੈ ਪਿਤਾ ਅਪਾਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਦੇਬਿ ਕਾਲਿਕਾ ਮਾਤ ਹਮਾਰਾ ॥",
      "s": 2
    },
    {
      "t": "ਮਨੂਆ ਗੁਰ ਮੁਰਿ ਮਨਸਾ ਮਾਈ ॥",
      "s": 2
    },
    {
      "t": "ਜਿਨ ਮੋ ਕੋ ਸੁਭ ਕ੍ਰਿਆ ਪੜ੍ਹਾਈ ॥੫॥",
      "s": 2
    },
    {
      "t": "ਜਬ ਮਨਸਾ ਮਨ ਮਯਾ ਬਿਚਾਰੀ ॥",
      "s": 2
    },
    {
      "t": "ਗੁਰ ਮਨੂਆ ਕਹ ਕਹਿਯੋ ਸੁਧਾਰੀ ॥",
      "s": 2
    },
    {
      "t": "ਜੇ ਜੇ ਚਰਿਤ ਪੁਰਾਤਨ ਲਹੇ ॥",
      "s": 2
    },
    {
      "t": "ਤੇ ਤੇ ਅਬ ਚਹੀਅਤ ਹੈ ਕਹੇ ॥੬॥",
      "s": 2
    },
    {
      "t": "ਸਰਬ ਕਾਲ ਕਰਣਾ ਤਬ ਭਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਸੇਵਕ ਜਾਨ ਦਯਾ ਰਸ ਢਰੇ ॥",
      "s": 2
    },
    {
      "t": "ਜੋ ਜੋ ਜਨਮ ਪੁਰਬਲੋ ਭਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਸੋ ਸੋ ਸਭ ਸਿਮਰਣ ਕਰ ਦਯੋ ॥੭॥",
      "s": 2
    },
    {
      "t": "ਮੋ ਕੌ ਇਤੀ ਹੁਤੀ ਕਹ ਸੁੱਧੰ ॥",
      "s": 2
    },
    {
      "t": "ਜਸ ਪ੍ਰਭ ਦਈ ਕ੍ਰਿਪਾ ਕਰਿ ਬੁੱਧੰ ॥",
      "s": 2
    },
    {
      "t": "ਸਰਬ ਕਾਲ ਤਬ ਭਏ ਦਇਆਲਾ ॥",
      "s": 2
    },
    {
      "t": "ਲੋਹ ਰਛ ਹਮ ਕੋ ਸਬ ਕਾਲਾ ॥੮॥",
      "s": 2
    },
    {
      "t": "ਸਰਬ ਕਾਲ ਰੱਛਾ ਸਬ ਕਾਲ ॥",
      "s": 2
    },
    {
      "t": "ਲੋਹ ਰੱਛ ਸਰਬਦਾ ਬਿਸਾਲ ॥",
      "s": 2
    },
    {
      "t": "ਢੀਠ ਭਯੋ ਤਵ ਕ੍ਰਿਪਾ ਲਖਾਈ ॥",
      "s": 2
    },
    {
      "t": "ਐਂਡੋ ਫਿਰੋ ਸਭਨ ਭਯੋ ਰਾਈ ॥੯॥",
      "s": 2
    },
    {
      "t": "ਜਿਹ ਜਿਹ ਬਿਧ ਜਨਮਨ ਸੁਧਿ ਆਈ ॥",
      "s": 2
    },
    {
      "t": "ਤਿਮ ਤਿਮ ਕਹੇ ਗਿਰੰਥ ਬਨਾਈ ॥",
      "s": 2
    },
    {
      "t": "ਪ੍ਰਥਮੇ ਸਤਿਜੁਗ ਜਿਹ ਬਿਧਿ ਲਹਾ ॥",
      "s": 2
    },
    {
      "t": "ਪ੍ਰਥਮੇ ਦੇਬਿ ਚਰਿਤ੍ਰ ਕੋ ਕਹਾ ॥੧੦॥",
      "s": 2
    },
    {
      "t": "ਪਹਿਲੇ ਚੰਡੀ ਚਰਿਤ੍ਰ ਬਨਾਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਨਖ ਸਿਖ ਤੇ ਕ੍ਰਮ ਭਾਖ ਸੁਨਾਯੋ ॥",
      "s": 2
    },
    {
      "t": "ਛੋਰ ਕਥਾ ਤਬ ਪ੍ਰਥਮ ਸੁਨਾਈ ॥",
      "s": 2
    },
    {
      "t": "ਅਬ ਚਾਹਤ ਫਿਰਿ ਕਰੋਂ ਬਡਾਈ ॥੧੧॥",
      "s": 2
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਸਰਬ ਕਾਲ ਕੀ ਬੇਨਤੀ ਬਰਨਨੰ ਨਾਮ ਚੌਦਸਮੋ ਧਿਆਇ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੪॥ ਅਫਜੂ ॥੪੭੧॥",
      "s": 2
    }
  ]
}
