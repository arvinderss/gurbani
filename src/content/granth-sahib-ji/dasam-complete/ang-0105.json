{
  "page": 105,
  "lines": [
    {
      "t": "ਲਯੋ ਬੇੜਿ ਪਬੰ ਕੀਯੋ ਨਾਦ ਉਚੰ ॥",
      "s": 4
    },
    {
      "t": "ਸੁਣੇ ਗਰਭਣੀਆਨਿ ਕੇ ਗਰਭ ਮੁਚੰ ॥੧੮॥੫੬॥",
      "s": 4
    },
    {
      "t": "ਸੁਣਿਯੋ ਨਾਦ ਸ੍ਰਵਣੰ ਕੀਯੋ ਦੇਵਿ ਕੋਪੰ ॥",
      "s": 4
    },
    {
      "t": "ਸਜੇ ਚਰਮ ਬਰਮੰ ਧਰੇ ਸੀਸਿ ਟੋਪੰ ॥",
      "s": 4
    },
    {
      "t": "ਭਈ ਸਿੰਘ ਸੁਆਰੰ ਕੀਯੋ ਨਾਦ ਉਚੰ ॥",
      "s": 4
    },
    {
      "t": "ਸੁਨੇ ਦੀਹ ਦਾਨਵਾਨ ਕੇ ਮਾਨ ਮੁਚੰ ॥੧੯॥੫੭॥",
      "s": 4
    },
    {
      "t": "ਮਹਾ ਕੋਪਿ ਦੇਵੀ ਧਸੀ ਸੈਨ ਮਧੰ ॥",
      "s": 4
    },
    {
      "t": "ਕਰੇ ਬੀਰ ਬੰਕੇ ਤਹਾ ਅਧੁ ਅਧੰ ॥",
      "s": 4
    },
    {
      "t": "ਜਿਸੈ ਧਾਇ ਕੈ ਸੂਲ ਸੈਥੀ ਪ੍ਰਹਾਰਿਯੋ ॥",
      "s": 4
    },
    {
      "t": "ਤਿਨੇ ਫੇਰਿ ਪਾਣੰ ਨ ਬਾਣੰ ਸੰਭਾਰਿਯੋ ॥੨੦॥੫੮॥",
      "s": 4
    },
    {
      "t": "ਰਸਾਵਲ ਛੰਦ ॥",
      "s": 4
    },
    {
      "t": "ਜਿਸੈ ਬਾਣ ਮਾਰ੍ਯੋ ॥",
      "s": 4
    },
    {
      "t": "ਤਿਸੈ ਮਾਰਿ ਡਾਰ੍ਯੋ ॥",
      "s": 4
    },
    {
      "t": "ਜਿਤੈ ਸਿੰਘ ਧਾਯੋ ॥",
      "s": 4
    },
    {
      "t": "ਤਿਤੈ ਸੈਨ ਘਾਯੋ ॥੨੧॥੫੯॥",
      "s": 4
    },
    {
      "t": "ਜਿਤੈ ਘਾਇ ਡਾਲੇ ॥",
      "s": 4
    },
    {
      "t": "ਤਿਤੈ ਘਾਰਿ ਘਾਲੇ ॥",
      "s": 4
    },
    {
      "t": "ਸਮੁਹਿ ਸਤ੍ਰੁ ਆਯੋ ॥",
      "s": 4
    },
    {
      "t": "ਸੁ ਜਾਨੇ ਨ ਪਾਯੋ ॥੨੨॥੬੦॥",
      "s": 4
    },
    {
      "t": "ਜਿਤੇ ਜੁਝ ਰੁਝੇ ॥",
      "s": 4
    },
    {
      "t": "ਤਿਤੇ ਅੰਤ ਜੁਝੇ ॥",
      "s": 4
    },
    {
      "t": "ਜਿਨੈ ਸਸਤ੍ਰ ਘਾਲੇ ॥",
      "s": 4
    },
    {
      "t": "ਤਿਤੇ ਮਾਰ ਡਾਲੇ ॥੨੩॥੬੧॥",
      "s": 4
    },
    {
      "t": "ਤਬੈ ਮਾਤ ਕਾਲੀ ॥",
      "s": 4
    },
    {
      "t": "ਤਪੀ ਤੇਜ ਜੁਵਾਲੀ ॥",
      "s": 4
    },
    {
      "t": "ਜਿਸੈ ਘਾਵ ਡਾਰਿਯੋ ॥",
      "s": 4
    },
    {
      "t": "ਸੁ ਸੁਰਗੰ ਸਿਧਾਰਿਯੋ ॥੨੪॥੬੨॥",
      "s": 4
    },
    {
      "t": "ਘਰੀ ਅਧ ਮਧੰ ॥",
      "s": 4
    },
    {
      "t": "ਹਨਿਯੋ ਸੈਨ ਸੁਧੰ ॥",
      "s": 4
    },
    {
      "t": "ਹਨਿਯੋ ਧੂਮ੍ਰ ਨੈਣੰ ॥",
      "s": 4
    },
    {
      "t": "ਸੁਨਿਯੋ ਦੇਵ ਗੈਣੰ ॥੨੫॥੬੩॥",
      "s": 4
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 4
    },
    {
      "t": "ਭਜੀ ਬਿਰੂਥਨਿ ਦਾਨਵੀ ਗਈ ਭੂਪ ਕੇ ਪਾਸ ॥",
      "v": [
        [
          2,
          2
        ]
      ],
      "s": 4
    },
    {
      "t": "ਧੂਮ੍ਰਨੈਣ ਕਾਲੀ ਹਨਿਯੋ ਭਜੀਯੋ ਸੈਨ ਨਿਰਾਸ ॥੨੬॥੬੪॥",
      "v": [
        [
          2,
          2
        ]
      ],
      "s": 4
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕੇ ਚੰਡੀ ਚਰਿਤ੍ਰ ਧੂਮ੍ਰਨੈਨ ਬਧਤ ਦੁਤੀਆ ਧਿਆਇ ਸੰਪੂਰਨਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨॥",
      "s": 4
    },
    {
      "t": "ਅਥ ਚੰਡ ਮੁੰਡ ਜੁਧ ਕਥਨੰ ॥",
      "s": 4
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 4
    },
    {
      "t": "ਇਹ ਬਿਧ ਦੈਤ ਸੰਘਾਰ ਕਰ ਧਵਲਾ ਚਲੀ ਅਵਾਸ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 4
    },
    {
      "t": "ਜੋ ਯਹ ਕਥਾ ਪੜੈ ਸੁਨੈ ਰਿਧਿ ਸਿਧਿ ਗ੍ਰਿਹਿ ਤਾਸ ॥੧॥੬੫॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 4
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 4
    },
    {
      "t": "ਧੂਮ੍ਰਨੈਣ ਜਬ ਸੁਣੇ ਸੰਘਾਰੇ ॥",
      "s": 4
    },
    {
      "t": "ਚੰਡ ਮੁੰਡ ਤਬ ਭੂਪਿ ਹਕਾਰੇ ॥",
      "s": 4
    },
    {
      "t": "ਬਹੁ ਬਿਧਿ ਕਰ ਪਠਏ ਸਨਮਾਨਾ ॥",
      "s": 4
    },
    {
      "t": "ਹੈ ਗੈ ਪਤਿ ਦੀਏ ਰਥ ਨਾਨਾ ॥੨॥੬੬॥",
      "s": 4
    },
    {
      "t": "ਪ੍ਰਿਥਮ ਨਿਰਖਿ ਦੇਬੀਅਹਿ ਜੇ ਆਏ ॥",
      "s": 4
    },
    {
      "t": "ਤੇ ਧਵਲਾ ਗਿਰਿ ਓਰਿ ਪਠਾਏ ॥",
      "s": 4
    },
    {
      "t": "ਤਿਨ ਕੀ ਤਨਿਕ ਭਨਕ ਸੁਨਿ ਪਾਈ ॥",
      "s": 4
    },
    {
      "t": "ਨਿਸਿਰੀ ਸਸਤ੍ਰ ਅਸਤ੍ਰ ਲੈ ਮਾਈ ॥੩॥੬੭॥",
      "s": 4
    }
  ]
}
