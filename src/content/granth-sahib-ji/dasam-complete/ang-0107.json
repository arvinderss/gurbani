{
  "page": 107,
  "lines": [
    {
      "t": "ਪਰੀ ਕੁਟ ਕੁਟੰ ਲਗੇ ਧੀਰ ਧਕੇ ॥",
      "s": 4
    },
    {
      "t": "ਚਵੀ ਚਾਵਡੀਯੰ ਨਫੀਰੰ ਰਣੰਕੰ ॥",
      "s": 4
    },
    {
      "t": "ਮਨੋ ਬਿਚਰੰ ਬਾਘ ਬੰਕੇ ਬਬਕੰ ॥੮॥੮੫॥",
      "s": 4
    },
    {
      "t": "ਉਤੇ ਕੋਪੀਯੰ ਸ੍ਰੋਣਬਿੰਦੰ ਸੁ ਬੀਰੰ ॥",
      "s": 4
    },
    {
      "t": "ਪ੍ਰਹਾਰੇ ਭਲੀ ਭਾਤਿ ਸੋ ਆਨਿ ਤੀਰੰ ॥",
      "s": 4
    },
    {
      "t": "ਉਤੇ ਦਉਰ ਦੇਵੀ ਕਰਿਯੋ ਖਗ ਪਾਤੰ ॥",
      "s": 4
    },
    {
      "t": "ਗਰਿਯੋ ਮੂਰਛਾ ਹੁਐ ਭਯੋ ਜਾਨੁ ਘਾਤੰ ॥੯॥੮੬॥",
      "s": 4
    },
    {
      "t": "ਛੁਟੀ ਮੂਰਛਨਾਯੰ ਮਹਾਬੀਰ ਗਜਿਯੋ ॥",
      "s": 4
    },
    {
      "t": "ਘਰੀ ਚਾਰ ਲਉ ਸਾਰ ਸੋ ਸਾਰ ਬਜਿਯੋ ॥",
      "s": 4
    },
    {
      "t": "ਲਗੇ ਬਾਣ ਸ੍ਰੋਣੰ ਗਿਰਿਯੋ ਭੂਮਿ ਜੁਧੇ ॥",
      "s": 4
    },
    {
      "t": "ਉਠੇ ਬੀਰ ਤੇਤੇ ਕੀਏ ਨਾਦ ਕ੍ਰੁਧੰ ॥੧੦॥੮੭॥",
      "s": 4
    },
    {
      "t": "ਉਠੇ ਬੀਰ ਜੇਤੇ ਤਿਤੇ ਕਾਲ ਕੂਟੇ ॥",
      "s": 4
    },
    {
      "t": "ਪਰੇ ਚਰਮ ਬਰਮੰ ਕਹੂੰ ਗਾਤ ਟੂਟੇ ॥",
      "s": 4
    },
    {
      "t": "ਜਿਤੀ ਭੂਮਿ ਮਧੰ ਪਰੀ ਸ੍ਰੋਣ ਧਾਰੰ ॥",
      "s": 4
    },
    {
      "t": "ਜਗੇ ਸੂਰ ਤੇਤੇ ਕੀਏ ਮਾਰ ਮਾਰੰ ॥੧੧॥੮੮॥",
      "s": 4
    },
    {
      "t": "ਪਰੀ ਕੁਟ ਕੁਟੰ ਰੁਲੇ ਤਛ ਮੁਛੰ ॥",
      "s": 4
    },
    {
      "t": "ਕਹੂੰ ਮੁੰਡ ਤੁੰਡੰ ਕਹੂੰ ਮਾਸੁ ਮੁਛੰ ॥",
      "s": 4
    },
    {
      "t": "ਭਯੋ ਚਾਰ ਸੈ ਕੋਸ ਲਉ ਬੀਰ ਖੇਤੰ ॥",
      "s": 4
    },
    {
      "t": "ਬਿਦਾਰੇ ਪਰੇ ਬੀਰ ਬ੍ਰਿੰਦ੍ਰੰ ਬਿਚੇਤੰ ॥੧੨॥੮੯॥",
      "s": 4
    },
    {
      "t": "ਰਸਾਵਲ ਛੰਦ ॥",
      "s": 4
    },
    {
      "t": "ਚਹੂੰ ਓਰ ਢੂਕੇ ॥",
      "s": 4
    },
    {
      "t": "ਮੁਖੰ ਮਾਰੁ ਕੂਕੇ ॥",
      "s": 4
    },
    {
      "t": "ਝੰਡਾ ਗਡ ਗਾਢੇ ॥",
      "s": 4
    },
    {
      "t": "ਮਚੇ ਰੋਸ ਬਾਢੇ ॥੧੩॥੯੦॥",
      "s": 4
    },
    {
      "t": "ਭਰੇ ਬੀਰ ਹਰਖੰ ॥",
      "s": 4
    },
    {
      "t": "ਕਰੀ ਬਾਣ ਬਰਖੰ ॥",
      "s": 4
    },
    {
      "t": "ਚਵੰ ਚਾਰ ਢੁਕੇ ॥",
      "s": 4
    },
    {
      "t": "ਪਛੇ ਆਹੁ ਰੁਕੇ ॥੧੪॥੯੧॥",
      "s": 4
    },
    {
      "t": "ਪਰੀ ਸਸਤ੍ਰ ਝਾਰੰ ॥",
      "s": 4
    },
    {
      "t": "ਚਲੀ ਸ੍ਰੋਣ ਧਾਰੰ ॥",
      "s": 4
    },
    {
      "t": "ਉਠੇ ਬੀਰ ਮਾਨੀ ॥",
      "s": 4
    },
    {
      "t": "ਧਰੇ ਬਾਨ ਹਾਨੀ ॥੧੫॥੯੨॥",
      "s": 4
    },
    {
      "t": "ਮਹਾ ਰੋਸਿ ਗਜੇ ॥",
      "s": 4
    },
    {
      "t": "ਤੁਰੀ ਨਾਦ ਬਜੇ ॥",
      "s": 4
    },
    {
      "t": "ਭਏ ਰੋਸ ਭਾਰੀ ॥",
      "s": 4
    },
    {
      "t": "ਮਚੇ ਛਤ੍ਰਧਾਰੀ ॥੧੬॥੯੩॥",
      "s": 4
    },
    {
      "t": "ਹਕੰ ਹਾਕ ਬਜੀ ॥",
      "s": 4
    },
    {
      "t": "ਫਿਰੈ ਸੈਣ ਭਜੀ ॥",
      "s": 4
    },
    {
      "t": "ਪਰਿਯੋ ਲੋਹ ਕ੍ਰੋਹੰ ॥",
      "s": 4
    },
    {
      "t": "ਛਕੇ ਸੂਰ ਸੋਹੰ ॥੧੭॥੯੪॥",
      "s": 4
    },
    {
      "t": "ਗਿਰੇ ਅੰਗ ਭੰਗੰ ॥",
      "s": 4
    },
    {
      "t": "ਦਵੰ ਜਾਨੁ ਦੰਗੰ ॥",
      "s": 4
    },
    {
      "t": "ਕੜੰਕਾਰ ਛੁਟੇ ॥",
      "s": 4
    },
    {
      "t": "ਝਣੰਕਾਰ ਉਠੇ ॥੧੮॥੯੫॥",
      "s": 4
    },
    {
      "t": "ਕਟਾ ਕਟ ਬਾਹੇ ॥",
      "s": 4
    },
    {
      "t": "ਉਭੈ ਜੀਤ ਚਾਹੈ ॥",
      "s": 4
    },
    {
      "t": "ਮਹਾ ਮਦ ਮਾਤੇ ॥",
      "s": 4
    },
    {
      "t": "ਤਪੇ ਤੇਜ ਤਾਤੇ ॥੧੯॥੯੬॥",
      "s": 4
    }
  ]
}
