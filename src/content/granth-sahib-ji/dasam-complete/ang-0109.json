    {
      "t": "ਬਿਜੈ ਛੰਦ",
      "s": 4
    },
    {
      "t": "ਜੇਤਕ ਬਾਣ ਚਲੇ ਅਰਿ ਓਰ ਤੇ ਫੂਲ ਕੀ ਮਾਲ ਹੁਐ ਕੰਠਿ ਬਿਰਾਜੇ ॥",
      "v": [
        [
          5,
          2
        ]
      ],
      "s": 4
    },
    {
      "t": "ਦਾਨਵ ਪੁੰਗਵ ਪੇਖਿ ਅਚੰਭਵ ਛੋਡਿ ਭਜੇ ਰਣ ਏਕ ਨ ਗਾਜੇ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 4
    },
    {
      "t": "ਕੁੰਜਰ ਪੁੰਜ ਗਿਰੇ ਤਿਹ ਠਉਰ ਭਰੇ ਸਭ ਸ੍ਰੋਣਤ ਪੈ ਗਨ ਤਾਜੇ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 4
    },
    {
      "t": "ਜਾਨੁਕ ਨੀਰਧ ਮਧਿ ਛਪੇ ਭ੍ਰਮਿ ਭੂਧਰ ਕੇ ਭਯ ਤੇ ਨਗ ਭਾਜੇ ॥੩੨॥੧੦੯॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 4
    },
    {
      "t": "ਮਨੋਹਰ ਛੰਦ",
      "s": 4
    },
    {
      "t": "ਸ੍ਰੀ ਜਗਮਾਤ ਕਮਾਨ ਲੈ ਹਾਥਿ ਪ੍ਰਮਾਥਨਿ ਸੰਖ ਪ੍ਰਜ੍ਰਯੋ ਜਬ ਜੁਧੰ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 4
    },
    {
      "t": "ਗਾਤਹ ਸੈਣ ਸੰਘਾਰਤ ਸੂਰ ਬਬਕਤਿ ਸਿੰਘ ਭ੍ਰਮ੍ਯੋ ਰਣਿ ਕ੍ਰੁਧੰ ॥",
      "s": 4
    },
    {
      "t": "ਕਉਚਹਿ ਭੇਦਿ ਅਭੇਦਿਤ ਅੰਗ ਸੁਰੰਗ ਉਤੰਗ ਸੋ ਸੋਭਿਤ ਸੁਧੰ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 4
    },
    {
      "t": "ਮਾਨੋ ਬਿਸਾਲ ਬੜਵਾਨਲ ਜੁਆਲ ਸਮੁਦ੍ਰ ਕੇ ਮਧਿ ਬਿਰਾਜਤ ਉਧੰ ॥੩੩॥੧੧੦॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 4
    },
    {
      "t": "ਪੂਰ ਰਹੀ ਭਵਿ ਭੂਰ ਧਨੁਰ ਧੁਨਿ ਧੂਰ ਉਡੀ ਨਭ ਮੰਡਲ ਛਾਯੋ ॥",
      "v": [
        [
          5,
          2
        ]
      ],
      "s": 4
    },
    {
      "t": "ਨੂਰ ਭਰੇ ਮੁਖ ਮਾਰਿ ਗਿਰੇ ਰਣਿ ਹੂਰਨ ਹੇਰਿ ਹੀਯੋ ਹੁਲਸਾਯੋ ॥",
      "v": [
        [
          5,
          2
        ]
      ],
      "s": 4
    },
    {
      "t": "ਪੂਰਣ ਰੋਸ ਭਰੇ ਅਰਿ ਤੂਰਣ ਪੂਰਿ ਪਰੇ ਰਣ ਭੂਮਿ ਸੁਹਾਯੋ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 4
    },
    {
      "t": "ਚੂਰ ਭਏ ਅਰਿ ਰੂਰੇ ਗਿਰੇ ਭਟ ਚੂਰਣ ਜਾਨੁਕ ਬੈਦ ਬਨਾਯੋ ॥੩੪॥੧੧੧॥",
      "v": [
        [
          5,
          2
        ]
      ],
      "s": 4
    },
    {
      "t": "ਸੰਗੀਤ ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ",
      "s": 4
    },
    {
      "t": "ਕਾਗੜਦੰ ਕਾਤੀ ਕਟਾਰੀ ਕੜਾਕੰ ॥",
      "s": 4
    },
    {
      "t": "ਤਾਗੜਦੰ ਤੀਰੰ ਤੁਪਕੰ ਤੜਾਕੰ ॥",
      "s": 4
    },
    {
      "t": "ਝਾਗੜਦੰ ਨਾਗੜਦੰ ਬਾਗੜਦੰ ਬਾਜੇ ॥",
      "s": 4
    },
    {
      "t": "ਗਾਗੜਦੰ ਗਾਜੀ ਮਹਾ ਗਜ ਗਾਜੇ ॥੩੫॥੧੧੨॥",
      "s": 4
    },
    {
      "t": "ਸਾਗੜਦੰ ਸੂਰੰ ਕਾਗੜਦੰ ਕੋਪੰ ॥",
      "s": 4
    },
    {
      "t": "ਪਾਗੜਦੰ ਪਰਮੰ ਰਣੰ ਪਾਵ ਰੋਪੰ ॥",
      "s": 4
