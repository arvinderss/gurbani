    },
    {
      "t": "ਇਤੈ ਸਿੰਘ ਗਾਜੇ ॥੩੩॥੧੫੫॥",
      "s": 4
    },
    {
      "t": "ਭਈ ਪੁਹਪ ਬਰਖਾ ॥",
      "s": 4
    },
    {
      "t": "ਗਾਏ ਜੀਤ ਕਰਖਾ ॥",
      "s": 4
    },
    {
      "t": "ਜਯੰ ਸੰਤ ਜੰਪੇ ॥",
      "s": 4
    },
    {
      "t": "ਤ੍ਰਸੇ ਦੈਤ ਕੰਪੇ ॥੩੪॥੧੫੬॥",
      "s": 4
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕੇ ਚੰਡੀ ਚਰਿਤ੍ਰੇ ਨਿਸੁੰਭ ਬਧਹ ਪੰਚਮੋ ਧਿਆਇ ਸੰਪੂਰਨਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੫॥",
      "s": 4
    },
    {
      "t": "ਅਥ ਸੁੰਭ ਜੁਧ ਕਥਨੰ ॥",
      "s": 4
    },
    {
      "t": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 4
    },
    {
      "t": "ਲਘੁੰ ਭ੍ਰਾਤ ਜੁਝਿਯੋ ਸੁਨਿਯੋ ਸੁੰਭ ਰਾਯੰ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 4
    },
    {
      "t": "ਸਜੈ ਸਸਤ੍ਰ ਅਸਤ੍ਰੰ ਚੜਿਯੋ ਚਉਪ ਚਾਯੰ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 4
    },
    {
      "t": "ਭਯੋ ਨਾਦ ਉਚੰ ਰਹਿਯੋ ਪੂਰ ਗੈਣੰ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 4
    },
    {
      "t": "ਤ੍ਰਸੰ ਦੇਵਤਾ ਦੈਤ ਕੰਪਿਯੋ ਤ੍ਰਿਨੈਣੰ ॥੧॥੧੫੭॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 4
    },
    {
      "t": "ਡਰਿਯੋ ਚਾਰ ਬਕਤ੍ਰੰ ਟਰਿਯੋ ਦੇਵ ਰਾਜੰ ॥",
      "v": [
