    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 4
    },
    {
      "t": "ਸਿਵ ਦੂਤੀ ਇਤਿ ਦ੍ਰੁਗਾ ਬੁਲਾਈ ॥",
      "s": 4
    },
    {
      "t": "ਕਾਨ ਲਾਗਿ ਨੀਕੈ ਸਮੁਝਾਈ ॥",
      "s": 4
    },
    {
      "t": "ਸਿਵ ਕੋ ਭੇਜ ਦੀਜੀਐ ਤਹਾ ॥",
      "s": 4
    },
    {
      "t": "ਦੈਤ ਰਾਜ ਇਸਥਿਤ ਹੈ ਜਹਾ ॥੩੯॥੧੯੫॥",
      "s": 4
    },
    {
      "t": "ਸਿਵ ਦੂਤੀ ਜਬ ਇਮ ਸੁਨ ਪਾਵਾ ॥",
      "s": 4
    },
    {
      "t": "ਸਿਵਹਿੰ ਦੂਤ ਕਰਿ ਉਤੈ ਪਠਾਵਾ ॥",
      "s": 4
    },
    {
      "t": "ਸਿਵ ਦੂਤੀ ਤਾ ਤੇ ਭਯੋ ਨਾਮਾ ॥",
      "s": 4
    },
    {
      "t": "ਜਾਨਤ ਸਕਲ ਪੁਰਖ ਅਰੁ ਬਾਮਾ ॥੪੦॥੧੯੬॥",
      "s": 4
    },
    {
      "t": "ਸਿਵ ਕਹੀ ਦੈਤ ਰਾਜ ਸੁਨਿ ਬਾਤਾ ॥",
      "v": [
        [
          1,
          1
        ],
        [
          3,
          1
        ]
      ],
      "s": 4
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਕਹਿਯੋ ਤੁਮਹੁ ਜਗਮਾਤਾ ॥",
      "s": 4
    },
    {
      "t": "ਦੇਵਨ ਕੇ ਦੈ ਕੈ ਠਕੁਰਾਈ ॥",
      "s": 4
    },
    {
      "t": "ਕੈ ਮਾਡਹੁ ਹਮ ਸੰਗ ਲਰਾਈ ॥੪੧॥੧੯੭॥",
      "s": 4
    },
    {
      "t": "ਦੈਤ ਰਾਜ ਇਹ ਬਾਤ ਨ ਮਾਨੀ ॥",
      "s": 4
    },
    {
      "t": "ਆਪ ਚਲੇ ਜੂਝਨ ਅਭਿਮਾਨੀ ॥",
      "s": 4
    },
    {
      "t": "ਗਰਜਤ ਕਾਲਿ ਕਾਲ ਜ੍ਯੋ ਜਹਾ ॥",
      "s": 4
    },
    {
      "t": "ਪ੍ਰਾਪਤਿ ਭਯੋ ਅਸੁਰ ਪਤਿ ਤਹਾ ॥੪੨॥੧੯੮॥",
      "s": 4
    },
    {
      "t": "ਚਮਕੀ ਤਹਾ ਅਸਨ ਕੀ ਧਾਰਾ ॥",
      "s": 4
    },
    {
      "t": "ਨਾਚੇ ਭੂਤ ਪ੍ਰੇਤ ਬੈਤਾਰਾ ॥",
      "s": 4
    },
    {
      "t": "ਫਰਕੇ ਅੰਧ ਕਬੰਧ ਅਚੇਤਾ ॥",
      "s": 4
    },
    {
      "t": "ਭਿਭਰੇ ਭਈਰਵ ਭੀਮ ਅਨੇਕਾ ॥੪੩॥੧੯੯॥",
      "s": 4
    },
    {
      "t": "ਤੁਰਹੀ ਢੋਲ ਨਗਾਰੇ ਬਾਜੇ ॥",
      "s": 4
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਜੋਧਾ ਰਣਿ ਗਾਜੈ ॥",
      "s": 4
    },
    {
      "t": "ਢਡਿ ਡਫ ਡਮਰੁ ਡੁਗਡੁਗੀ ਘਨੀ ॥",
      "s": 4
    },
    {
      "t": "ਨਾਇ ਨਫੀਰੀ ਜਾਤ ਨ ਗਨੀ ॥੪੪॥੨੦੦॥",
      "s": 4
    },
    {
      "t": "ਮਧੁਭਾਰ ਛੰਦ ॥",
      "s": 4
    },
    {
      "t": "ਹੁੰਕੇ ਕਿਕਾਣ ॥",
      "s": 4
    },
    {
      "t": "ਧੁੰਕੇ ਨਿਸਾਣ ॥",
      "s": 4
    },
    {
      "t": "ਸਜੇ ਸੁ ਬੀਰ ॥",
      "s": 4
    },
    {
      "t": "ਗਜੇ ਗਹੀਰ ॥੪੫॥੨੦੧॥",
      "s": 4
    },
    {
      "t": "ਝੁਕੇ ਨਿਝਕ ॥",
