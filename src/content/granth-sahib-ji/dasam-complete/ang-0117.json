{
  "page": 117,
  "lines": [
    {
      "t": "ਜੈ ਸਬਦ ਦੇਵਨ ਉਚਾਰਿਯੋ ॥੬੦॥੨੧੬॥",
      "s": 4
    },
    {
      "t": "ਨਭਿ ਮਧਿ ਬਾਜਨ ਬਾਜਹੀ ॥",
      "s": 4
    },
    {
      "t": "ਅਵਿਲੋਕਿ ਦੇਵਾ ਗਾਜਹੀ ॥",
      "s": 4
    },
    {
      "t": "ਲਖਿ ਦੇਵ ਬਾਰੰ ਬਾਰਹੀ ॥",
      "s": 4
    },
    {
      "t": "ਜੈ ਸਬਦ ਸਰਬ ਪੁਕਾਰਹੀ ॥੬੧॥੨੧੭॥",
      "s": 4
    },
    {
      "t": "ਰਣਿ ਕੋਪਿ ਕਾਲ ਕਰਾਲੀਯੰ ॥",
      "s": 4
    },
    {
      "t": "ਖਟ ਅੰਗ ਪਾਣਿ ਉਛਾਲੀਯੰ ॥",
      "s": 4
    },
    {
      "t": "ਸਿਰਿ ਸੁੰਭ ਹਥ ਦੁਛੰਡੀਯੰ ॥",
      "s": 4
    },
    {
      "t": "ਇਕ ਚੋਟਿ ਦੁਸਟ ਬਿਹੰਡੀਯੰ ॥੬੨॥੨੧੮॥",
      "s": 4
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 4
    },
    {
      "t": "ਜਿਮ ਸੁੰਭਾਸੁਰ ਕੋ ਹਨਾ ਅਧਿਕ ਕੋਪ ਕੈ ਕਾਲਿ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 4
    },
    {
      "t": "ਤ੍ਰਯੋ ਸਾਧਨ ਕੇ ਸਤ੍ਰੁ ਸਭ ਚਾਬਤ ਜਾਹ ਕਰਾਲ ॥੬੩॥੨੧੯॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 4
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕੇ ਚੰਡੀ ਚਰਿਤ੍ਰੇ ਸੁੰਭ ਬਧਹ ਖਸਟਮੋ ਧਿਆਯ ਸੰਪੂਰਨਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੬॥",
      "s": 4
    },
    {
      "t": "ਅਥ ਜੈਕਾਰ ਸਬਦ ਕਥਨੰ ॥",
      "s": 4
    },
    {
      "t": "ਬੇਲੀ ਬਿਦ੍ਰਮ ਛੰਦ ॥",
      "s": 4
    },
    {
      "t": "ਜੈ ਸਬਦ ਦੇਵ ਪੁਕਾਰ ਹੀ ॥",
      "s": 4
    },
    {
      "t": "ਸਬ ਫੂਲਿ ਫੂਲਨ ਡਾਰ ਹੀ ॥",
      "s": 4
    },
    {
      "t": "ਘਨਸਾਰ ਕੁੰਕਮ ਲਿਆਇ ਕੈ ॥",
      "s": 4
    },
    {
      "t": "ਟੀਕਾ ਦੀਯ ਹਰਖਾਇ ਕੈ ॥੧॥੨੨੦॥",
      "s": 4
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 4
    },
    {
      "t": "ਉਸਤਤਿ ਸਬ ਹੂੰ ਕਰੀ ਅਪਾਰਾ ॥",
      "s": 4
    },
    {
      "t": "ਬ੍ਰਹਮ ਕਵਚ ਕੋ ਜਾਪ ਉਚਾਰਾ ॥",
      "s": 4
    },
    {
      "t": "ਸੰਤ ਸੰਬੂਹ ਪ੍ਰਫੁਲਤ ਭਏ ॥",
      "s": 4
    },
    {
      "t": "ਦੁਸਟ ਅਰਿਸਟ ਨਾਸ ਹੁਐ ਗਏ ॥੨॥੨੨੧॥",
      "s": 4
    },
    {
      "t": "ਸਾਧਨ ਕੋ ਸੁਖ ਬਢੇ ਅਨੇਕਾ ॥",
      "s": 4
    },
    {
      "t": "ਦਾਨਵ ਦੁਸਟ ਨ ਬਾਚਾ ਏਕਾ ॥",
      "s": 4
    },
    {
      "t": "ਸੰਤ ਸਹਾਇ ਸਦਾ ਜਗ ਮਾਈ ॥",
      "s": 4
    },
    {
      "t": "ਜਹ ਤਹ ਸਾਧਨ ਹੋਇ ਸਹਾਈ ॥੩॥੨੨੨॥",
      "s": 4
    },
    {
      "t": "ਦੇਵੀ ਜੂ ਕੀ ਉਸਤਤਿ ॥",
      "s": 4
    },
    {
      "t": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਜੋਗ ਜ੍ਵਾਲੰ ਧਰੀਯੰ ਜੁਆਲੰ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਸੁੰਭ ਹੰਤੀ ਨਮੋ ਕਰੂਰ ਕਾਲੰ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਸ੍ਰੋਣ ਬੀਰਜਾਰਦਨੀ ਧੂਮ੍ਰ ਹੰਤੀ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਕਾਲਿਕਾ ਰੂਪ ਜੁਆਲਾ ਜਯੰਤੀ ॥੪॥੨੨੩॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਅੰਬਿਕਾ ਜੰਭਹਾ ਜੋਤਿ ਰੂਪਾ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਚੰਡ ਮੁੰਡਾਰਦਨੀ ਭੂਪਿ ਭੂਪਾ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਚਾਮਰੰ ਚੀਰਣੀ ਚਿਤ੍ਰ ਰੂਪੰ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਪਰਮ ਪ੍ਰਗਿਯਾ ਬਿਰਾਜੈ ਅਨੂਪੰ ॥੫॥੨੨੪॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਪਰਮ ਰੂਪਾ ਨਮੋ ਕ੍ਰੂਰ ਕਰਮਾ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਰਾਜਸਾ ਸਾਤਕਾ ਪਰਮ ਬਰਮਾ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਮਹਿਖ ਦਈਤ ਕੋ ਅੰਤ ਕਰਣੀ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਤੋਖਣੀ ਸੋਖਣੀ ਸਰਬ ਇਰਣੀ ॥੬॥੨੨੫॥",
      "s": 4
    },
    {
      "t": "ਬਿੜਾਲਾਛ ਹੰਤੀ ਕਰੂਰਾਛ ਘਾਯਾ ॥",
      "s": 4
    },
    {
      "t": "ਦਿਜਗਿ ਦਯਾਰਦਨੀਅੰ ਨਮੋ ਜੋਗ ਮਾਯਾ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਭਈਰਵੀ ਭਾਰਗਵੀਅੰ ਭਵਾਨੀ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਜੋਗ ਜ੍ਵਾਲੰ ਧਰੀ ਸਰਬ ਮਾਨੀ ॥੭॥੨੨੬॥",
      "s": 4
    },
    {
      "t": "ਅਧੀ ਉਰਧਵੀ ਆਪ ਰੂਪਾ ਅਪਾਰੀ ॥",
      "s": 4
    },
    {
      "t": "ਰਮਾ ਰਸਟਰੀ ਕਾਮ ਰੂਪਾ ਕੁਮਾਰੀ ॥",
      "s": 4
    },
    {
      "t": "ਭਵੀ ਭਾਵਨੀ ਭਈਰਵੀ ਭੀਮ ਰੂਪਾ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਹਿੰਗੁਲਾ ਪਿੰਗੁਲਾਯੰ ਅਨੂਪਾ ॥੮॥੨੨੭॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਜੁਧਨੀ ਕ੍ਰੁਧਨੀ ਕ੍ਰੂਰ ਕਰਮਾ ॥",
      "s": 4
    },
    {
      "t": "ਮਹਾ ਬੁਧਿਨੀ ਸਿਧਿਨੀ ਸੁਧ ਕਰਮਾ ॥",
      "s": 4
    },
    {
      "t": "ਪਰੀ ਪਦਮਿਨੀ ਪਾਰਬਤੀ ਪਰਮ ਰੂਪਾ ॥",
      "s": 4
    },
    {
      "t": "ਸਿਵੀ ਬਾਸਵੀ ਬ੍ਰਾਹਮੀ ਰਿਧ ਕੂਪਾ ॥੯॥੨੨੮॥",
      "s": 4
    },
    {
      "t": "ਮਿੜਾ ਮਾਰਜਨੀ ਸੂਰਤਵੀ ਮੋਹ ਕਰਤਾ ॥",
      "s": 4
    },
    {
      "t": "ਪਰਾ ਪਸਟਣੀ ਪਾਰਬਤੀ ਦੁਸਟ ਹਰਤਾ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਹਿੰਗੁਲਾ ਪਿੰਗੁਲਾ ਤੋਤਲਾਯੰ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਕਾਰਤਿਕ੍ਰਯਾਨੀ ਸਿਵਾ ਸੀਤਲਾਯੰ ॥੧੦॥੨੨੯॥",
      "s": 4
    },
    {
      "t": "ਭਵੀ ਭਾਰਗਵੀਯੰ ਨਮੋ ਸਸਤ੍ਰ ਪਾਣੰ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਅਸਤ੍ਰ ਧਰਤਾ ਨਮੋ ਤੇਜ ਮਾਣੰ ॥",
      "s": 4
    },
    {
      "t": "ਜਯਾ ਅਜਯਾ ਚਰਮਣੀ ਚਾਵਡਾਯੰ ॥",
      "s": 4
    },
    {
      "t": "ਕ੍ਰਿਪਾ ਕਾਲਿਕਾਯੰ ਨਯੰ ਨਿਤਿ ਨਿਆਯੰ ॥੧੧॥੨੩੦॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਚਾਪਣੀ ਚਰਮਣੀ ਖੜਗ ਪਾਣੰ ॥",
      "s": 4
    },
    {
      "t": "ਗਦਾ ਪਾਣਿਣੀ ਚਕ੍ਰਣੀ ਚਿਤ੍ਰ ਮਾਣੰ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਸੂਲਣੀ ਸਹਥੀ ਪਾਣਿ ਮਾਤਾ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਗਿਆਨ ਬਿਗਿਆਨ ਕੀ ਗਿਆਨ ਗਿਆਤਾ ॥੧੨॥੨੩੧॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਪੋਖਣੀ ਸੋਖਣੀਅੰ ਮ੍ਰਿੜਾਲੀ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਦੁਸਟ ਦੋਖਾਰਦਨੀ ਰੂਪ ਕਾਲੀ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਜੋਗ ਜੁਆਲਾ ਨਮੋ ਕਾਰਤਿਕ੍ਰਯਾਨੀ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਅੰਬਿਕਾ ਤੋਤਲਾ ਸ੍ਰੀ ਭਵਾਨੀ ॥੧੩॥੨੩੨॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਦੋਖ ਦਾਹੀ ਨਮੋ ਦੁਖ੍ਯ ਹਰਤਾ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਸਸਤ੍ਰਣੀ ਅਸਤ੍ਰਣੀ ਕਰਮ ਕਰਤਾ ॥",
      "s": 4
    }
  ]
}
