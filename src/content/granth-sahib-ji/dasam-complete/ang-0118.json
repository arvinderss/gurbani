{
  "page": 118,
  "lines": [
    {
      "t": "ਨਮੋ ਰਿਸਟਣੀ ਪੁਸਟਣੀ ਪਰਮ ਜੁਆਲਾ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਤਾਰੁਣੀਅੰ ਨਮੋ ਬ੍ਰਿਧ ਬਾਲਾ ॥੧੪॥੨੩੩॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਸਿੰਘ ਬਾਹੀ ਨਮੋਦਾੜ ਗਾੜੰ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਖਗ ਦਗੰ ਝਮਾ ਝਮ ਬਾੜੰ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਰੂੜਿ ਗੂੜੰ ਨਮੋ ਸਰਬ ਬਿਆਪੀ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਨਿਤ ਨਾਰਾਇਣੀ ਦੁਸਟ ਖਾਪੀ ॥੧੫॥੨੩੪॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਰਿਧਿ ਰੂਪੰ ਨਮੋ ਸਿਧ ਕਰਣੀ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਪੋਖਣੀ ਸੋਖਣੀ ਸਰਬ ਭਰਣੀ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਆਰਜਨੀ ਮਾਰਜਨੀ ਕਾਲ ਰਾਤ੍ਰੀ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਜੋਗ ਜ੍ਵਾਲੰ ਧਰੀ ਸਰਬ ਦਾਤ੍ਰੀ ॥੧੬॥੨੩੫॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਪਰਮ ਪਰਮੇਸ੍ਵਰੀ ਧਰਮ ਕਰਣੀ ॥",
      "s": 4
    },
    {
      "t": "ਨਈ ਨਿਤ ਨਾਰਾਇਣੀ ਦੁਸਟ ਦਰਣੀ ॥",
      "s": 4
    },
    {
      "t": "ਛਲਾ ਆਛਲਾ ਈਸੁਰੀ ਜੋਗ ਜੁਆਲੀ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਬਰਮਣੀ ਚਰਮਣੀ ਕ੍ਰੂਰ ਕਾਲੀ ॥੧੭॥੨੩੬॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਰੇਚਕਾ ਪੂਰਕਾ ਪ੍ਰਾਤ ਸੰਧਿਆ ॥",
      "s": 4
    },
    {
      "t": "ਜਿਨੈ ਮੋਹ ਕੈ ਚਉਦਹੂੰ ਲੋਗ ਬੰਧਿਆ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਅੰਜਨੀ ਗੰਜਨੀ ਸਰਬ ਅਸਤ੍ਰਾ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਧਾਰਣੀ ਬਾਰਣੀ ਸਰਬ ਸਸਤ੍ਰਾ ॥੧੮॥੨੩੭॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਅੰਜਨੀ ਗੰਜਨੀ ਦੁਸਟ ਗਰਬਾ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਤੋਖਣੀ ਪੋਖਣੀ ਸੰਤ ਸਰਬਾ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਸਕਤਣੀ ਸੂਲਣੀ ਖੜਗ ਪਾਣੀ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਤਾਰਣੀ ਕਾਰਣੀਅੰ ਕ੍ਰਿਪਾਣੀ ॥੧੯॥੨੩੮॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਰੂਪ ਕਾਲੀ ਕਪਾਲੀ ਅਨੰਦੀ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਚੰਦ੍ਰਣੀ ਭਾਨੁਵੀਅੰ ਗੁਬਿੰਦੀ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਛੈਲ ਰੂਪਾ ਨਮੋ ਦੁਸਟ ਦਰਣੀ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਕਾਰਣੀ ਤਾਰਣੀ ਸ੍ਰਿਸਟ ਭਰਣੀ ॥੨੦॥੨੩੯॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਹਰਖਣੀ ਬਰਖਣੀ ਸਸਤ੍ਰ ਧਾਰਾ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਤਾਰਣੀ ਕਾਰਣੀਯੰ ਅਪਾਰਾ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਜੋਗਣੀ ਭੋਗਣੀ ਪ੍ਰਮ ਪ੍ਰਗਿਯਾ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਦੇਵ ਦਈਤਯਾਇਣੀ ਦੇਵਿ ਦੁਰਗਿਯਾ ॥੨੧॥੨੪੦॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਘੋਰਿ ਰੂਪਾ ਨਮੋ ਚਾਰੁ ਨੈਣਾ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਸੂਲਣੀ ਸੈਥਣੀ ਬਕ੍ਰ ਬੈਣਾ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਬ੍ਰਿਧ ਬੁਧੰ ਕਰੀ ਜੋਗ ਜੁਆਲਾ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਚੰਡ ਮੁੰਡੀ ਮ੍ਰਿੜਾ ਕ੍ਰੂਰ ਕਾਲਾ ॥੨੨॥੨੪੧॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਦੁਸਟ ਪੁਸਟਾਰਦਨੀ ਛੇਮ ਕਰਣੀ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਦਾੜ ਗਾੜਾ ਧਰੀ ਦੁਖ੍ਯ ਹਰਣੀ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਸਾਸਤ੍ਰ ਬੇਤਾ ਨਮੋ ਸਸਤ੍ਰ ਗਾਮੀ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਜਛ ਬਿਦਿਆ ਧਰੀ ਪੂਰਣ ਕਾਮੀ ॥੨੩॥੨੪੨॥",
      "s": 4
    },
    {
      "t": "ਰਿਪੰ ਤਾਪਣੀ ਜਾਪਣੀ ਸਰਬ ਲੋਗਾ ॥",
      "s": 4
    },
    {
      "t": "ਥਪੇ ਖਾਪਣੀ ਥਾਪਣੀ ਸਰਬ ਸੋਗਾ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਲੰਕੁੜੇਸੀ ਨਮੋ ਸਕਤਿ ਪਾਣੀ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਕਾਲਿਕਾ ਖੜਗ ਪਾਣੀ ਕ੍ਰਿਪਾਣੀ ॥੨੪॥੨੪੩॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਲੰਕੁੜੈਸਾ ਨਮੋ ਨਾਗ੍ਰ ਕੋਟੀ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਕਾਮ ਰੂਪਾ ਕਮਿਛਿਆ ਕਰੋਟੀ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਕਾਲ ਰਾਤ੍ਰੀ ਕਪਰਦੀ ਕਲਿਆਣੀ ॥",
      "s": 4
    },
    {
      "t": "ਮਹਾ ਰਿਧਣੀ ਸਿਧ ਦਾਤੀ ਕ੍ਰਿਪਾਣੀ ॥੨੫॥੨੪੪॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਚਤੁਰ ਬਾਹੀ ਨਮੋ ਅਸਟ ਬਾਹਾ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਪੋਖਣੀ ਸਰਬ ਆਲਮ ਪਨਾਹਾ ॥",
      "s": 4
    }
  ]
}
