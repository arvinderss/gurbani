{
  "page": 119,
  "lines": [
    {
      "t": "ਨਮੋ ਅੰਬਿਕਾ ਜੰਭਹਾ ਕਾਰਤਕ੍ਰਯਾਨੀ ॥",
      "s": 4
    },
    {
      "t": "ਮ੍ਰਿੜਾਲੀ ਕਪਰਦੀ ਨਮੋ ਸ੍ਰੀ ਭਵਾਨੀ ॥੨੬॥੨੪੫॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਦੇਵ ਅਰਦ੍ਰਯਾਰਦਨੀ ਦੁਸਟ ਹੰਤੀ ॥",
      "s": 4
    },
    {
      "t": "ਸਿਤਾ ਅਸਿਤਾ ਰਾਜ ਕ੍ਰਾਤੀ ਅਨੰਤੀ ॥",
      "s": 4
    },
    {
      "t": "ਜੁਆਲਾ ਜਯੰਤੀ ਅਲਾਸੀ ਅਨੰਦੀ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਪਾਰਬ੍ਰਹਮੀ ਹਰੀ ਸੀ ਮੁਕੰਦੀ ॥੨੭॥੨੪੬॥",
      "s": 4
    },
    {
      "t": "ਜਯੰਤੀ ਨਮੋ ਮੰਗਲਾ ਕਾਲਕਾਯੰ ॥",
      "s": 4
    },
    {
      "t": "ਕਪਾਲੀ ਨਮੋ ਭਦ੍ਰਕਾਲੀ ਸਿਵਾਯੰ ॥",
      "s": 4
    },
    {
      "t": "ਦੁਗਾਯੰ ਛਿਮਾਯੰ ਨਮੋ ਧਾਤ੍ਰੀਏਯੰ ॥",
      "s": 4
    },
    {
      "t": "ਸੁਆਹਾ ਸੁਧਾਯੰ ਨਮੋ ਸੀਤਲੇਯੰ ॥੨੮॥੨੪੭॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਚਰਬਣੀ ਸਰਬ ਧਰਮੰ ਧੁਜਾਯੰ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਹਿੰਗੁਲਾ ਪਿੰਗੁਲਾ ਅੰਬਿਕਾਯੰ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਦੀਰਘ ਦਾੜਾ ਨਮੋ ਸਿਆਮ ਬਰਣੀ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਅੰਜਨੀ ਗੰਜਨੀ ਦੈਤ ਦਰਣੀ ॥੨੯॥੨੪੮॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਅਰਧ ਚੰਦ੍ਰਾਇਣੀ ਚੰਦ੍ਰਚੂੜੰ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਇੰਦ੍ਰ ਊਰਧਾ ਨਮੋ ਦਾੜ ਗੂੜੰ ॥",
      "s": 4
    },
    {
      "t": "ਸਸੰ ਸੇਖਰੀ ਚੰਦ੍ਰਭਾਲਾ ਭਵਾਨੀ ॥",
      "s": 4
    },
    {
      "t": "ਭਵੀ ਭੈਹਰੀ ਭੂਤਰਾਟੀ ਕ੍ਰਿਪਾਨੀ ॥੩੦॥੨੪੯॥",
      "s": 4
    },
    {
      "t": "ਕਲੀ ਕਾਰਣੀ ਕਰਮ ਕਰਤਾ ਕਮਛ੍ਰਯਾ ॥",
      "s": 4
    },
    {
      "t": "ਪਰੀ ਪਦਮਿਨੀ ਪੂਰਣੀ ਸਰਬ ਇਛ੍ਯਾ ॥",
      "s": 4
    },
    {
      "t": "ਜਯਾ ਜੋਗਣੀ ਜਗ ਕਰਤਾ ਜਯੰਤੀ ॥",
      "s": 4
    },
    {
      "t": "ਸੁਭਾ ਸੁਆਮਣੀ ਸ੍ਰਿਸਟਜਾ ਸਤ੍ਰੂਹੰਤੀ ॥੩੧॥੨੫੦॥",
      "s": 4
    },
    {
      "t": "ਪਵਿਤ੍ਰੀ ਪੁਨੀਤਾ ਪੁਰਾਣੀ ਪਰੇਯੰ ॥",
      "s": 4
    },
    {
      "t": "ਪ੍ਰਭੀ ਪੂਰਣੀ ਪਾਰਬ੍ਰਹਮੀ ਅਜੈਯੰ ॥",
      "s": 4
    },
    {
      "t": "ਅਰੂਪੰ ਅਨੂਪੰ ਅਨਾਮੰ ਅਠਾਮੰ ॥",
      "s": 4
    },
    {
      "t": "ਅਭੀਅੰ ਅਜੀਤੰ ਮਹਾ ਧਰਮ ਧਾਮੰ ॥੩੨॥੨੫੧॥",
      "s": 4
    },
    {
      "t": "ਅਛੇਦੰ ਅਭੇਦੰ ਅਕਰਮੰ ਸੁ ਧਰਮੰ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਬਾਣ ਪਾਣੀ ਧਰੇ ਚਰਮ ਬਰਮੰ ॥",
      "s": 4
    },
    {
      "t": "ਅਜੇਯੰ ਅਭੇਯੰ ਨਿਰੰਕਾਰ ਨਿਤ੍ਰਯੰ ॥",
      "s": 4
    },
    {
      "t": "ਨਿਰੂਪੰ ਨਿਰਬਾਣੰ ਨਮਿਤ੍ਰਯੰ ਅਕ੍ਰਿਤ੍ਰਯੰ ॥੩੩॥੨੫੨॥",
      "s": 4
    },
    {
      "t": "ਗੁਰੀ ਗਉਰਜਾ ਕਾਮਗਾਮੀ ਗੁਪਾਲੀ ॥",
      "s": 4
    },
    {
      "t": "ਬਲੀ ਬੀਰਣੀ ਬਾਵਨਾ ਜਗ੍ਰਯਾ ਜੁਆਲੀ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਸਤ੍ਰੁ ਚਰਬਾਇਣੀ ਗਰਬ ਹਰਣੀ ॥",
      "s": 4
    },
    {
      "t": "ਨਮੋ ਤੋਖਣੀ ਸੋਖਣੀ ਸਰਬ ਭਰਣੀ ॥੩੪॥੨੫੩॥",
      "s": 4
    },
    {
      "t": "ਪਿਲੰਗੀ ਪਵੰਗੀ ਨਮੋ ਚਰਚਿਤੰਗੀ ॥",
      "s": 4
    },
    {
