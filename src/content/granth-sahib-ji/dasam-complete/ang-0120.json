        ]
      ],
      "s": 5
    },
    {
      "t": "ਅਭਿਮਾਨੁ ਉਤਾਰਨ ਦੇਵਤਿਆਂ ਮਹਿਖਾਸੁਰ ਸੁੰਭ ਉਪਾਇਆ ॥",
      "s": 5
    },
    {
      "t": "ਜੀਤਿ ਲਏ ਤਿਨ ਦੇਵਤੇ ਤਿਹ ਲੋਕੀ ਰਾਜੁ ਕਮਾਇਆ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 5
    },
    {
      "t": "ਵਡਾ ਬੀਰੁ ਅਖਾਇ ਕੈ ਸਿਰ ਉਪਰ ਛਤ੍ਰੁ ਫਿਰਾਇਆ ॥",
      "s": 5
    },
    {
      "t": "ਦਿਤਾ ਇੰਦ੍ਰੁ ਨਿਕਾਲ ਕੈ ਤਿਨ ਗਿਰ ਕੈਲਾਸੁ ਤਕਾਇਆ ॥",
      "s": 5
    },
    {
      "t": "ਡਰਿ ਕੈ ਹਥੋ ਦਾਨਵੀ ਦਿਲ ਅੰਦਰਿ ਤ੍ਰਾਸੁ ਵਧਾਇਆ ॥",
      "s": 5
    },
    {
      "t": "ਪਾਸ ਦੁਰਗਾ ਦੇ ਇੰਦ੍ਰੁ ਆਇਆ ॥੩॥",
      "s": 5
    },
    {
      "t": "ਪਉੜੀ ॥",
      "s": 5
    },
    {
      "t": "ਇਕ ਦਿਹਾੜੇ ਨਾਵਣ ਆਈ ਦੁਰਗਸਾਹ ॥",
      "s": 5
    },
    {
      "t": "ਇੰਦ੍ਰ ਬਿਰਥਾ ਸੁਣਾਈ ਅਪਣੇ ਹਾਲ ਦੀ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 5
    },
    {
      "t": "ਛੀਨ ਲਈ ਠਕੁਰਾਈ ਸਾਤੇ ਦਾਨਵੀ ॥",
