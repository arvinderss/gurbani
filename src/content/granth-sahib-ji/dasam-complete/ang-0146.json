{
  "page": 146,
  "lines": [
    {
      "t": "ਭਏ ਸੈਣਪਾਲੰ ਬਲੀ ਸੂਲ ਸਲ੍ਰਯੰ ॥",
      "s": 6
    },
    {
      "t": "ਭਲੀ ਭਾਤਿ ਕੁਟਿਓ ਬਲੀ ਪੰਚ ਦਲ੍ਰਯੰ ॥",
      "s": 6
    },
    {
      "t": "ਪੁਨਰ ਹਸਤ ਯੁਧਿਸਟਰੰ ਸਕਤ ਬੇਧੰ ॥",
      "s": 6
    },
    {
      "t": "ਗਿਰਿਯੋ ਜੁਧ ਭੂਪੰ ਬਲੀ ਭੂਪ ਬੇਧੰ ॥੪੭॥੨੧੫॥",
      "s": 6
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 6
    },
    {
      "t": "ਸਲ ਰਾਜਾ ਜਉਨੈ ਦਿਨ ਜੂਝਾ ॥",
      "s": 6
    },
    {
      "t": "ਕਉਰਉ ਹਾਰ ਤਵਨ ਤੇ ਸੂਝਾ ॥",
      "s": 6
    },
    {
      "t": "ਜੂਝਤ ਸਲ ਭਇਓ ਅਸਤਾਮਾ ॥",
      "s": 6
    },
    {
      "t": "ਕੂਟਿਓ ਕੋਟ ਕਟਕੁ ਇਕ ਜਾਮਾ ॥੧॥੨੧੬॥",
      "s": 6
    },
    {
      "t": "ਧ੍ਰਿਸਟ ਦੋਨੁ ਮਾਰਿਓ ਅਤਿਰਥੀ ॥",
      "s": 6
    },
    {
      "t": "ਪਾਡਵ ਸੈਨ ਭਲੇ ਕਰਿ ਮਥੀ ॥",
      "s": 6
    },
    {
      "t": "ਪਾਡਵ ਕੇ ਪਾਚੋ ਸੁਤ ਮਾਰੇ ॥",
      "s": 6
    },
    {
      "t": "ਦੁਆਪੁਰ ਮੈ ਬਡ ਕੀਨ ਅਖਾਰੇ ॥੨॥੨੧੭॥",
      "s": 6
    },
    {
      "t": "ਕਉਰਉ ਰਾਜ ਕੀਓ ਤਬ ਜੁਧਾ ॥",
      "s": 6
    },
    {
      "t": "ਭੀਮ ਸੰਗਿ ਹੁਇ ਕੈ ਅਤਿ ਕ੍ਰੁਧਾ ॥",
      "s": 6
    },
    {
      "t": "ਜੁਧ ਕਰਤ ਕਬਹੂ ਨਹੀ ਹਾਰਾ ॥",
      "s": 6
    },
    {
      "t": "ਕਾਲ ਬਲੀ ਤਿਹ ਆਨ ਸੰਘਾਰਾ ॥੩॥੨੧੮॥",
      "s": 6
    },
    {
      "t": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 6
    },
    {
      "t": "ਤਹਾ ਭੀਮ ਕੁਰਰਾਜ ਸਿਉ ਜੁਧ ਮਚਿਓ ॥",
      "s": 6
    },
    {
      "t": "ਛੁਟੀ ਬ੍ਰਹਮ ਤਾਰੀ ਮਹਾ ਰੁਦ੍ਰ ਨਚਿਓ ॥",
      "s": 6
    },
    {
      "t": "ਉਠੈ ਸਬਦ ਨਿਰਘਾਤ ਆਘਾਤ ਬੀਰੰ ॥",
      "s": 6
    },
    {
      "t": "ਭਏ ਰੁੰਡ ਮੁੰਡੰ ਤਣੰ ਤਛ ਤੀਰੰ ॥੧॥੨੧੯॥",
      "s": 6
    },
    {
      "t": "ਗਿਰੇ ਬੀਰ ਏਕੰ ਅਨੇਕੰ ਪ੍ਰਕਾਰੰ ॥",
      "s": 6
    },
    {
      "t": "ਗਿਰੇ ਅਧ ਅਧੰ ਛੁਧੰ ਸਸਤ੍ਰ ਧਾਰੰ ॥",
      "s": 6
    },
    {
      "t": "ਕਟੇ ਕਉਰਵੰ ਦੁਰ ਸਿੰਦੂਰ ਖੇਤੰ ॥",
      "s": 6
    },
    {
      "t": "ਨਚੇ ਗਿਧ ਆਵਧ ਸਾਵੰਤ ਖੇਤੰ ॥੨॥੨੨੦॥",
      "s": 6
    },
    {
      "t": "ਬਲੀ ਮੰਡਲਾਕਾਰ ਜੂਝੈ ਬਿਰਾਜੈ ॥",
      "s": 6
    },
    {
      "t": "ਹਸੈ ਗਰਜ ਠੋਕੈ ਭੁਜਾ ਹਰ ਦੁ ਗਾਜੈ ॥",
      "s": 6
    },
    {
      "t": "ਦਿਖਾਵੇ ਬਲੀ ਮੰਡਲਾਕਾਰ ਥਾਨੈ ॥",
      "s": 6
    },
    {
      "t": "ਉਭਾਰੈ ਭੁਜਾ ਅਉ ਫਟਾਕੈ ਗਜਾਨੈ ॥੩॥੨੨੧॥",
      "s": 6
    },
    {
      "t": "ਸੁਭੇ ਸਵਰਨ ਕੇ ਪਤ੍ਰ ਬਾਧੇ ਗਜਾ ਮੈ ॥",
      "s": 6
    },
    {
      "t": "ਭਈ ਅਗਨਿ ਸੋਭਾ ਲਖੀ ਕੈ ਧੁਜਾ ਮੈ ॥",
      "s": 6
    },
    {
      "t": "ਭਿੜਾ ਮੈ ਭ੍ਰਮੈ ਮੰਡਲਾਕਾਰ ਬਾਹੈ ॥",
      "s": 6
    },
    {
      "t": "ਅਪੋ ਆਪ ਸੈ ਨੇਕਿ ਘਾਇੰ ਸਰਾਹੈ ॥੪॥੨੨੨॥",
      "s": 6
    },
    {
      "t": "ਤਹਾ ਭੀਮ ਭਾਰੀ ਭੁਜਾ ਸਸਤ੍ਰ ਬਾਹੈ ॥",
      "s": 6
    },
    {
      "t": "ਭਲੀ ਭਾਤਿ ਕੈ ਕੈ ਭਲੇ ਸੈਨ ਗਾਹੈ ॥",
      "s": 6
    },
    {
      "t": "ਉਤੈ ਕਉਰਪਾਲੰ ਧਰੈ ਛਤ੍ਰ ਧਰਮੰ ॥",
      "s": 6
    },
    {
      "t": "ਕਰੈ ਚਿਤ ਪਾਵਿਤ੍ਰ ਬਾਚਿਤ੍ਰ ਕਰਮੰ ॥੫॥੨੨੩॥",
      "s": 6
    },
    {
      "t": "ਸਭੈ ਬਾਜੁਵੰਦੰ ਛਕੈ ਭੂਪਨਾਣੰ ॥",
      "s": 6
    },
    {
      "t": "ਲਸੈ ਮੁਤਕਾ ਚਾਰ ਦੁਮਲਿਅੰ ਹਾਣੰ ॥",
      "s": 6
    },
    {
      "t": "ਦੋਊ ਮੀਰ ਧੀਰੰ ਦੋਊ ਪਰਮ ਓਜੰ ॥",
      "s": 6
    },
    {
      "t": "ਦੋਊ ਮਾਨਧਾਤਾ ਮਹੀਪੰ ਕਿ ਭੋਜੰ ॥੬॥੨੨੪॥",
      "s": 6
    },
    {
      "t": "ਦੋਊ ਬੀਰ ਬਾਨਾ ਬਧੈ ਅਧ ਅਧੰ ॥",
      "s": 6
    },
    {
      "t": "ਦੋਊ ਸਸਤ੍ਰ ਧਾਰੀ ਮਹਾ ਜੁਧ ਕ੍ਰੁਧੰ ॥",
      "s": 6
    },
    {
      "t": "ਦੋਊ ਕ੍ਰੂਰ ਕਰਮੰ ਦੋਊ ਜਾਨ ਬਾਹੰ ॥",
      "s": 6
    },
    {
      "t": "ਦੋਊ ਹਦਿ ਹਿੰਦੂਨ ਸਾਹਾਨ ਸਾਹੰ ॥੭॥੨੨੫॥",
      "s": 6
    },
    {
      "t": "ਦੋਊ ਸਸਤ੍ਰ ਧਾਰੰ ਦੋਊ ਪਰਮ ਦਾਨੰ ॥",
      "s": 6
    },
    {
      "t": "ਦੋਊ ਢਾਲ ਢੀਚਾਲ ਹਿੰਦੂ ਹਿੰਦਾਨੰ ॥",
      "s": 6
    }
  ]
}
