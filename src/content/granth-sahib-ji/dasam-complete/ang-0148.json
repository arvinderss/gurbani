{
  "page": 148,
  "lines": [
    {
      "t": "ਚੌਪਈ ॥",
      "s": 6
    },
    {
      "t": "ਅਸੁਮੇਧ ਅਰੁ ਅਸਮੇਦਹਾਰਾ ॥",
      "s": 6
    },
    {
      "t": "ਮਹਾ ਸੂਰ ਸਤਵਾਨ ਅਪਾਰਾ ॥",
      "s": 6
    },
    {
      "t": "ਮਹਾ ਬੀਰ ਬਰਿਆਰ ਧਨੁਖ ਧਰ ॥",
      "s": 6
    },
    {
      "t": "ਗਾਵਤ ਕੀਰਤ ਦੇਸ ਸਭ ਘਰ ਘਰ ॥੧॥੨੩੮॥",
      "s": 6
    },
    {
      "t": "ਮਹਾ ਬੀਰ ਅਰੁ ਮਹਾ ਧਨੁਖ ਧਰ ॥",
      "s": 6
    },
    {
      "t": "ਕਾਪਤ ਤੀਨ ਲੋਕ ਜਾ ਕੇ ਡਰ ॥",
      "s": 6
    },
    {
      "t": "ਬਡ ਮਹੀਪ ਅਰੁ ਅਖੰਡ ਪ੍ਰਤਾਪਾ ॥",
      "s": 6
    },
    {
      "t": "ਅਮਿਤ ਤੇਜ ਜਾਪਤ ਜਗ ਜਾਪਾ ॥੨॥੨੩੯॥",
      "s": 6
    },
    {
      "t": "ਅਜੈ ਸਿੰਘ ਉਤ ਸੂਰ ਮਹਾਨਾ ॥",
      "s": 6
    },
    {
      "t": "ਬਡ ਮਹੀਪ ਦਸ ਚਾਰ ਨਿਧਾਨਾ ॥",
      "s": 6
    },
    {
      "t": "ਅਨਬਿਕਾਰ ਅਨਤੋਲ ਅਤੁਲ ਬਲ ॥",
      "s": 6
    },
    {
      "t": "ਅਰ ਅਨੇਕ ਜੀਤੇ ਜਿਨ ਦਲਮਲ ॥੩॥੨੪੦॥",
      "s": 6
    },
    {
      "t": "ਜਿਨ ਜੀਤੇ ਸੰਗ੍ਰਾਮ ਅਨੇਕਾ ॥",
      "s": 6
    },
    {
      "t": "ਸਸਤ੍ਰ ਅਸਤ੍ਰ ਧਰਿ ਛਾਡਨ ਏਕਾ ॥",
      "s": 6
    },
    {
      "t": "ਮਹਾ ਸੂਰ ਗੁਨਵਾਨ ਮਹਾਨਾ ॥",
      "s": 6
    },
    {
      "t": "ਮਾਨਤ ਲੋਕ ਸਗਲ ਜਿਹ ਆਨਾ ॥੪॥੨੪੧॥",
      "s": 6
    },
    {
      "t": "ਮਰਨ ਕਾਲ ਜਨਮੇਜੇ ਰਾਜਾ ॥",
      "s": 6
    },
    {
      "t": "ਮੰਤ੍ਰ ਕੀਓ ਮੰਤ੍ਰੀਨ ਸਮਾਜਾ ॥",
      "s": 6
    },
    {
      "t": "ਰਾਜ ਤਿਲਕ ਭੂਪਤ ਅਭਖੇਖਾ ॥",
      "s": 6
    },
    {
      "t": "ਨਿਰਖਤ ਭਏ ਨ੍ਰਿਪਤ ਕੀ ਰੇਖਾ ॥੫॥੨੪੨॥",
      "s": 6
    },
    {
      "t": "ਇਨ ਮਹਿ ਰਾਜ ਕਵਨ ਕਉ ਦੀਜੈ ॥",
      "s": 6
    },
    {
      "t": "ਕਉਨ ਨ੍ਰਿਪਤ ਸੁਤ ਕਉ ਨ੍ਰਿਪੁ ਕੀਜੈ ॥",
      "s": 6
    },
    {
      "t": "ਰਜੀਆ ਪੂਤ ਨ ਰਾਜ ਕੀ ਜੋਗਾ ॥",
      "s": 6
    },
    {
      "t": "ਯਾਹਿ ਕੇ ਜੋਗ ਨ ਰਾਜ ਕੇ ਭੋਗਾ ॥੬॥੨੪੩॥",
      "s": 6
    },
    {
      "t": "ਅਸ੍ਵਮੇਦ ਕਹੁ ਦੀਨੋ ਰਾਜਾ ॥",
      "s": 6
    },
    {
      "t": "ਜੈ ਪਤਿ ਭਾਖ੍ਯੋ ਸਕਲ ਸਮਾਜਾ ॥",
      "s": 6
    },
    {
      "t": "ਜਨਮੇਜਾ ਕੀ ਸੁਗਤਿ ਕਰਾਈ ॥",
      "s": 6
    },
    {
      "t": "ਅਸ੍ਵਮੇਦ ਕੈ ਵਜੀ ਵਧਾਈ ॥੭॥੨੪੪॥",
      "s": 6
    },
    {
      "t": "ਦੂਸਰ ਭਾਇ ਹੁਤੋ ਜੋ ਏਕਾ ॥",
      "s": 6
    },
    {
      "t": "ਰਤਨ ਦੀਏ ਤਿਹ ਦਰਬ ਅਨੇਕਾ ॥",
      "s": 6
    },
    {
      "t": "ਮੰਤ੍ਰੀ ਕੈ ਅਪਨਾ ਠਹਰਾਇਓ ॥",
      "s": 6
    },
    {
      "t": "ਦੂਸਰ ਠਉਰ ਤਿਸਹਿ ਬੈਠਾਇਓ ॥੮॥੨੪੫॥",
      "s": 6
    },
    {
      "t": "ਤੀਸਰ ਜੋ ਰਜੀਆ ਸੁਤ ਰਹਾ ॥",
      "s": 6
    },
    {
      "t": "ਸੈਨਪਾਲ ਤਾ ਕੋ ਪੁਨ ਕਹਾ ॥",
      "s": 6
    },
    {
      "t": "ਬਖਸੀ ਕਰਿ ਤਾਕੌ ਠਹਰਾਇਓ ॥",
      "s": 6
    },
    {
      "t": "ਸਬ ਦਲ ਕੋ ਤਿਹ ਕਾਮੁ ਚਲਾਇਓ ॥੯॥੨੪੬॥",
      "s": 6
    },
    {
      "t": "ਰਾਜੁ ਪਾਇ ਸਭਹੂ ਸੁਖ ਪਾਇਓ ॥",
      "s": 6
    },
    {
      "t": "ਭੂਪਤ ਕਉ ਨਾਚਬ ਸੁਖ ਆਇਓ ॥",
      "s": 6
    },
    {
      "t": "ਤੇਰਹ ਸੈ ਚੌਸਠ ਮਰਦੰਗਾ ॥",
      "s": 6
    },
    {
      "t": "ਬਾਜਤ ਹੈ ਕਈ ਕੋਟ ਉਪੰਗਾ ॥੧੦॥੨੪੭॥",
      "s": 6
    },
    {
      "t": "ਦੂਸਰ ਭਾਇ ਭਏ ਮਦ ਅੰਧਾ ॥",
      "s": 6
    },
    {
      "t": "ਦੇਖਤ ਨਾਚਤ ਲਾਇ ਸੁਗੰਧਾ ॥",
      "s": 6
    },
    {
      "t": "ਰਾਜ ਸਾਜ ਦੁਹਹੂੰ ਤੇ ਭੂਲਾ ॥",
      "s": 6
    },
    {
      "t": "ਵਾਹੀ ਕੈ ਜਾਇ ਛਤ੍ਰ ਸਿਰ ਝੂਲਾ ॥੧੧॥੨੪੮॥",
      "s": 6
    },
    {
      "t": "ਕਰਤ ਕਰਤ ਬਹੁ ਦਿਨ ਅਸ ਰਾਜਾ ॥",
      "s": 6
    },
    {
      "t": "ਉਨ ਦੁਹੂੰ ਭੂਲਿਓ ਰਾਜ ਸਮਾਜਾ ॥",
      "s": 6
    },
    {
      "t": "ਮਦ ਕਰਿ ਅੰਧ ਭਏ ਦੋਊ ਭ੍ਰਾਤਾ ॥",
      "s": 6
    }
  ]
}
