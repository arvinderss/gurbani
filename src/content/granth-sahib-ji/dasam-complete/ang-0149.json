          2
        ]
      ],
      "s": 6
    },
    {
      "t": "ਜਿਹ ਰਾਖੈ ਸੋਈ ਰਹੈ ਜਿਹ ਜਾਨੈ ਤਿਹ ਦੇਇ ॥੧੩॥੨੫੦॥",
      "v": [
        [
          1,
          1
        ],
        [
          3,
          2
        ]
      ],
      "s": 6
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 6
    },
    {
      "t": "ਐਸੀ ਭਾਤ ਕੀਨੋ ਇਹ ਜਬ ਹੀ ॥",
      "s": 6
    },
    {
      "t": "ਪ੍ਰਜਾ ਲੋਕ ਸਭ ਬਸ ਭਏ ਤਬ ਹੀ ॥",
      "s": 6
    },
    {
      "t": "ਅਉ ਬਸਿ ਹੋਇ ਗਏ ਨੇਬ ਖਵਾਸਾ ॥",
      "s": 6
    },
    {
      "t": "ਜੋ ਰਾਖਤ ਥੇ ਨ੍ਰਿਪ ਕੀ ਆਸਾ ॥੧॥੨੫੧॥",
      "s": 6
    },
    {
      "t": "ਏਕ ਦਿਵਸ ਤਿਹੂੰ ਭ੍ਰਾਤ ਸੁਜਾਨਾ ॥",
      "s": 6
    },
    {
      "t": "ਮੰਡਸ ਚੌਪਰ ਖੇਲ ਖਿਲਾਨਾ ॥",
      "s": 6
    },
    {
      "t": "ਦਾਉ ਸਮੈ ਕਛੁ ਰਿਸਕ ਬਿਚਾਰਿਓ ॥",
      "s": 6
    },
    {
      "t": "ਅਜੈ ਸੁਨਤ ਇਹ ਭਾਤ ਉਚਾਰਿਓ ॥੨॥੨੫੨॥",
      "s": 6
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 6
    },
    {
      "t": "ਕਹਾ ਕਰੈ ਦਾ ਕਹ ਪਰੈ ਕਹ ਯਹ ਬਾਧੈ ਸੂਤ ॥",
      "v": [
        [
          1,
          1
        ],
        [
          4,
          2
        ]
      ],
      "s": 6
    },
    {
      "t": "ਕਹਾ ਸਤ੍ਰੁ ਯਾ ਤੇ ਮਰੈ ਜੋ ਰਜੀਆ ਕਾ ਪੂਤ ॥੩॥੨੫੩॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 6
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 6
    },
    {
      "t": "ਯਹੈ ਆਜ ਹਮ ਖੇਲ ਬਿਚਾਰੀ ॥",
      "s": 6
    },
    {
      "t": "ਸੋ ਭਾਖਤ ਹੈ ਪ੍ਰਗਟ ਪੁਕਾਰੀ ॥",
      "s": 6
    },
    {
      "t": "ਏਕਹਿ ਰਤਨ ਰਾਜ ਧਨੁ ਲੀਨਾ ॥",
      "s": 6
    },
    {
      "t": "ਦੁਤੀਐ ਅਸ੍ਵ ਉਸਟ ਗਜ ਲੀਨਾ ॥੧॥੨੫੪॥",
      "s": 6
    },
    {
      "t": "ਕੁਅਰੈ ਬਾਟ ਸੈਨ ਸਭ ਲੀਆ ॥",
      "s": 6
    },
    {
      "t": "ਤੀਨਹੁ ਬਾਟ ਤੀਨ ਕਰ ਕੀਆ ॥",
      "s": 6
    },
    {
      "t": "ਪਾਸਾ ਢਾਰ ਧਰੈ ਕਸ ਦਾਵਾ ॥",
      "s": 6
    },
    {
      "t": "ਕਹਾ ਖੇਲ ਧੌ ਕਰੈ ਕਰਾਵਾ ॥੨॥੨੫੫॥",
      "s": 6
    },
    {
      "t": "ਚਉਪਰ ਖੇਲ ਪਰੀ ਤਿਹ ਮਾਹਾ ॥",
      "s": 6
    },
    {
      "t": "ਦੇਖਤ ਊਚ ਨੀਚ ਨਰ ਨਾਹਾ ॥",
      "s": 6
    },
    {
      "t": "ਜ੍ਵਾਲਾ ਰੂਪ ਸੁਪਰਧਾ ਬਾਢੀ ॥",
      "s": 6
    },
    {
      "t": "ਭੂਪਨ ਫਿਰਤ ਸੰਘਾਰਤ ਕਾਢੀ ॥੩॥੨੫੬॥",
      "s": 6
    },
    {
      "t": "ਤਿਨ ਕੈ ਬੀਚ ਪਰੀ ਅਸ ਖੇਲਾ ॥",
      "s": 6
    },
    {
      "t": "ਕਟਨ ਸੁ ਹਿਤ ਭਇਉ ਮਿਟਨ ਦੁਹੇਲਾ ॥",
      "s": 6
    },
    {
      "t": "ਪ੍ਰਿਥਮੈ ਰਤਨ ਦ੍ਰਿਬ ਬਹੁ ਲਾਯੋ ॥",
      "s": 6
    },
    {
      "t": "ਬਸਤ੍ਰ ਬਾਜ ਗਜ ਬਹੁਤ ਹਰਾਯੋ ॥੪॥੨੫੭॥",
      "s": 6
    },
    {
      "t": "ਦੁਹੂੰਅਨ ਬੀਚ ਸੁਪਰਧਾ ਬਾਢਾ ॥",
      "s": 6
    },
    {
      "t": "ਦੁਹ ਦਿਸ ਉਠੇ ਸੁਭਟ ਅਸ ਕਾਢਾ ॥",
      "s": 6
    },
    {
      "t": "ਚਮਕਹਿ ਕਹੂੰ ਅਸਨ ਕੀ ਧਾਰਾ ॥",
      "s": 6
    },
    {
      "t": "ਬਿਛ ਗਈ ਲੋਥ ਅਨੇਕ ਅਪਾਰਾ ॥੫॥੨੫੮॥",
      "s": 6
    },
    {
      "t": "ਜੁਗਨ ਦੈਤ ਫਿਰਹਿ ਹਰਿਖਾਨੇ ॥",
      "s": 6
    },
    {
      "t": "ਗੀਧ ਸਿਵਾ ਬੋਲਹਿ ਅਭਿਮਾਨੇ ॥",
      "s": 6
    },
    {
      "t": "ਭੂਤ ਪ੍ਰੇਤ ਨਾਚਹਿ ਅਰੁ ਗਾਵਹਿ ॥",
      "s": 6
    },
    {
      "t": "ਕਹੂੰ ਕਹੂੰ ਸਬਦ ਬੈਤਾਲ ਸੁਨਾਵਹਿ ॥੬॥੨੫੯॥",
      "s": 6
    },
    {
      "t": "ਚਮਕਤ ਕਹੂੰ ਖਗਨ ਕੀ ਧਾਰਾ ॥",
      "s": 6
    },
    {
      "t": "ਬਿਥ ਗਏ ਰੁੰਡ ਭਸੁੰਡ ਅਪਾਰਾ ॥",
      "s": 6
    },
    {
      "t": "ਚਿੰਸਤ ਕਹੂੰ ਗਿਰੇ ਗਜ ਮਾਤੇ ॥",
      "s": 6
    },
    {
      "t": "ਸੋਵਤ ਕਹੂੰ ਸੁਭਟ ਰਣ ਤਾਤੇ ॥੭॥੨੬੦॥",
      "s": 6
    },
    {
      "t": "ਹਿੰਸਤ ਕਹੂੰ ਗਿਰੇ ਹੈ ਘਾਏ ॥",
      "s": 6
    },
    {
      "t": "ਸੋਵਤ ਕ੍ਰੂਰ ਸਲੋਕ ਪਠਾਏ ॥",
      "s": 6
    },
    {
      "t": "ਕਟਿ ਗਏ ਕਹੂੰ ਕਉਚ ਅਰੁ ਚਰਮਾ ॥",
      "s": 6
    }
  ]
}
