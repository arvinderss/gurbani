{
  "page": 150,
  "lines": [
    {
      "t": "ਕਟਿ ਗਏ ਗਜ ਬਾਜਨ ਕੇ ਬਰਮਾ ॥੮॥੨੬੧॥",
      "s": 6
    },
    {
      "t": "ਜੁਗਨ ਦੇਤ ਕਹੂੰ ਕਿਲਕਾਰੀ ॥",
      "s": 6
    },
    {
      "t": "ਨਾਚਤ ਭੂਤ ਬਜਾਵਤ ਤਾਰੀ ॥",
      "s": 6
    },
    {
      "t": "ਬਾਵਨ ਬੀਰ ਫਿਰੈ ਚਹੂੰ ਓਰਾ ॥",
      "s": 6
    },
    {
      "t": "ਬਾਜਤ ਮਾਰੂ ਰਾਗ ਸਿਦਉਰਾ ॥੯॥੨੬੨॥",
      "s": 6
    },
    {
      "t": "ਰਣ ਅਸ ਕਾਲ ਜਲਧ ਜਿਮ ਗਾਜਾ ॥",
      "s": 6
    },
    {
      "t": "ਭੂਤ ਪਿਸਾਚ ਭੀਰ ਭੈ ਭਾਜਾ ॥",
      "s": 6
    },
    {
      "t": "ਰਣ ਮਾਰੂ ਇਹ ਦਿਸ ਤੇ ਬਾਜ੍ਯੋ ॥",
      "s": 6
    },
    {
      "t": "ਕਾਇਰੁ ਹੁਤੋ ਸੋ ਭੀ ਨਹਿ ਭਾਜ੍ਯੋ ॥੧੦॥੨੬੩॥",
      "s": 6
    },
    {
      "t": "ਰਹਿ ਗਈ ਸੂਰਨ ਖਗ ਕੀ ਟੇਕਾ ॥",
      "s": 6
    },
    {
      "t": "ਕਟਿ ਗਏ ਸੁੰਡ ਭਸੁੰਡ ਅਨੇਕਾ ॥",
      "s": 6
    },
    {
      "t": "ਨਾਚਤ ਜੋਗਨ ਕਹੂੰ ਬਿਤਾਰਾ ॥",
      "s": 6
    },
    {
      "t": "ਧਾਵਤ ਭੂਤ ਪ੍ਰੇਤ ਬਿਕਰਾਰਾ ॥੧੧॥੨੬੪॥",
      "s": 6
    },
    {
      "t": "ਧਾਵਤ ਅਧ ਕਮਧ ਅਨੇਕਾ ॥",
      "s": 6
    },
    {
      "t": "ਮੰਡਿ ਰਹੇ ਰਾਵਤ ਗਡਿ ਟੇਕਾ ॥",
      "s": 6
    },
    {
      "t": "ਅਨਹਦ ਰਾਗ ਅਨਾਹਦ ਬਾਜਾ ॥",
      "s": 6
    },
    {
      "t": "ਕਾਇਰੁ ਹੁਤਾ ਵਹੈ ਨਹੀ ਭਾਜਾ ॥੧੨॥੨੬੫॥",
      "s": 6
    },
    {
      "t": "ਮੰਦਰ ਤੂਰ ਕਰੂਰ ਕਰੋਰਾ ॥",
      "s": 6
    },
    {
      "t": "ਗਾਜ ਸਰਾਵਤ ਰਾਗ ਸੰਦੋਰਾ ॥",
      "s": 6
    },
    {
      "t": "ਝਮਕਸਿ ਦਾਮਨ ਜਿਮ ਕਰਵਾਰਾ ॥",
      "s": 6
    },
    {
      "t": "ਬਰਸਤ ਬਾਨਨ ਮੇਘ ਅਪਾਰਾ ॥੧੩॥੨੬੬॥",
      "s": 6
    },
    {
      "t": "ਘੂਮਹਿ ਘਾਇਲ ਲੋਹ ਚੁਚਾਤੇ ॥",
      "s": 6
    },
    {
      "t": "ਖੇਲ ਬਸੰਤ ਮਨੋ ਮਦ ਮਾਤੇ ॥",
      "s": 6
    },
    {
      "t": "ਗਿਰ ਗਏ ਕਹੂੰ ਜਿਰਹ ਅਰੁ ਜੁਆਨਾ ॥",
      "s": 6
    },
    {
      "t": "ਗਰਜਨ ਗਿਧ ਪੁਕਾਰਤ ਸੁਆਨਾ ॥੧੪॥੨੬੭॥",
      "s": 6
    },
    {
      "t": "ਉਨ ਦਲ ਦੁਹੂੰ ਭਾਇਨ ਕੋ ਭਾਜਾ ॥",
      "s": 6
    },
    {
      "t": "ਠਾਢ ਨ ਸਕਿਯੋ ਰੰਕੁ ਅਰੁ ਰਾਜਾ ॥",
      "s": 6
    },
    {
      "t": "ਤਕਿਓ ਓਡਛਾ ਦੇਸੁ ਬਿਚਛਨ ॥",
      "s": 6
    },
    {
      "t": "ਰਾਜਾ ਨ੍ਰਿਪਤਿ ਤਿਲਕ ਸੁਭ ਲਛਨ ॥੧੫॥੨੬੮॥",
      "s": 6
    },
    {
      "t": "ਮਦ ਕਰਿ ਮਤ ਭਏ ਜੇ ਰਾਜਾ ॥",
      "s": 6
    },
    {
      "t": "ਤਿਨ ਕੇ ਗਏ ਐਸ ਹੀ ਕਾਜਾ ॥",
      "s": 6
    },
    {
      "t": "ਛੀਨ ਛਾਨ ਛਿਤ ਛਤ੍ਰ ਫਿਰਾਯੋ ॥",
      "s": 6
    },
    {
      "t": "ਮਹਾਰਾਜ ਆਪਹੀ ਕਹਾਯੋ ॥੧੬॥੨੬੯॥",
      "s": 6
    },
    {
      "t": "ਆਗੇ ਚਲੇ ਅਸ੍ਵਮੇਧ ਹਾਰਾ ॥",
      "s": 6
    },
    {
      "t": "ਧਵਹਿ ਪਾਛੇ ਫਉਜ ਅਪਾਰਾ ॥",
      "s": 6
    },
    {
      "t": "ਗੇ ਜਹਿ ਨ੍ਰਿਪਤ ਤਿਲਕ ਮਹਾਰਾਜਾ ॥",
      "s": 6
    },
    {
      "t": "ਰਾਜ ਪਾਟ ਵਾਹੂ ਕਉ ਛਾਜਾ ॥੧੭॥੨੭੦॥",
      "s": 6
    },
    {
      "t": "ਤਹਾ ਇਕ ਆਹਿ ਸਨਉਢੀ ਬ੍ਰਹਮਨ ॥",
      "s": 6
    },
    {
      "t": "ਪੰਡਤ ਬਡੇ ਮਹਾ ਬਡ ਗੁਨ ਜਨ ॥",
      "s": 6
    },
    {
      "t": "ਭੂਪਹਿ ਕੋ ਗੁਰ ਸਭਹੁ ਕੀ ਪੂਜਾ ॥",
      "s": 6
    },
    {
      "t": "ਤਿਹ ਬਿਨੁ ਅਵਰੁ ਨ ਮਾਨਹਿ ਦੂਜਾ ॥੧੮॥੨੭੧॥",
      "s": 6
    },
    {
      "t": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 6
    },
    {
      "t": "ਕਹੂੰ ਬ੍ਰਹਮ ਬਾਨੀ ਕਰਹਿ ਬੇਦ ਚਰਚਾ ॥",
      "s": 6
    },
    {
      "t": "ਕਹੂੰ ਬਿਪ੍ਰ ਬੈਠੇ ਕਰਹਿ ਬ੍ਰਹਮ ਅਰਚਾ ॥",
      "s": 6
    },
    {
      "t": "ਤਹਾ ਬਿਪ੍ਰ ਸਨੌਢ ਤੇ ਏਕ ਲਛਨ ॥",
      "s": 6
    },
    {
      "t": "ਕਰੈ ਬਕਲ ਬਸਤ੍ਰੰ ਫਿਰੈ ਬਾਇ ਭਛਨ ॥੧॥੨੭੨॥",
      "s": 6
    },
    {
      "t": "ਕਹੂੰ ਬੇਦ ਸਿਯਾਮੰ ਸੁਰੰ ਸਾਥ ਗਾਵੈ ॥",
      "s": 6
    },
    {
      "t": "ਕਹੂੰ ਜੁਜਰ ਬੇਦੰ ਪੜੇ ਮਾਨ ਪਾਵੈ ॥",
      "s": 6
    }
  ]
}
