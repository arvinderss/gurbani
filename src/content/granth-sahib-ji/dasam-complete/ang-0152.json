{
  "page": 152,
  "lines": [
    {
      "t": "ਤਹਾ ਗਯੋ ਅਜੈ ਸਿੰਘ ਸੂਰਾ ਸੁਕ੍ਰੁਧੰ ॥",
      "s": 6
    },
    {
      "t": "ਹਨਿਯੋ ਅਸਮੇਧੰ ਕਰਿਓ ਪਰਮ ਜੁਧੰ ॥੧੪॥੨੮੫॥",
      "s": 6
    },
    {
      "t": "ਰਜੀਆ ਪੁਤ੍ਰ ਦਿਖਿਯੋ ਡਰੇ ਦੋਇ ਭ੍ਰਾਤੰ ॥",
      "s": 6
    },
    {
      "t": "ਗਹੀ ਸਰਣ ਬਿਪ੍ਰੰ ਬੁਲਿਯੋ ਏਵ ਬਾਤੰ ॥",
      "s": 6
    },
    {
      "t": "ਗੁਵਾ ਹੇਮ ਸਰਬੰ ਮਿਲੇ ਪ੍ਰਾਨ ਦਾਨੰ ॥",
      "s": 6
    },
    {
      "t": "ਸਰਨੰ ਸਰਨੰ ਸਰਨੰ ਗੁਰਾਨੰ ॥੧੫॥੨੮੬॥",
      "s": 6
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 6
    },
    {
      "t": "ਤਬ ਭੂਪਤ ਤਹ ਦੂਤ ਪਠਾਏ ॥",
      "s": 6
    },
    {
      "t": "ਤ੍ਰਿਪਤ ਸਕਲ ਦਿਜ ਕੀਏ ਰਿਝਾਏ ॥",
      "s": 6
    },
    {
      "t": "ਅਸਮੇਧ ਅਰੁ ਅਸੁਮੇਦ ਹਾਰਾ ॥",
      "s": 6
    },
    {
      "t": "ਭਾਜ ਪਰੇ ਘਰ ਤਾਕ ਤਿਹਾਰਾ ॥੧॥੨੮੭॥",
      "s": 6
    },
    {
      "t": "ਕੈ ਦਿਜ ਬਾਧ ਦੇਹੁ ਦੁਐ ਮੋਹੂ ॥",
      "s": 6
    },
    {
      "t": "ਨਾਤਰ ਧਰੋ ਦੁਜਨਵਾ ਤੋਹੂ ॥",
      "s": 6
    },
    {
      "t": "ਕਰਿਓ ਨ ਪੂਜਾ ਦੇਉ ਨ ਦਾਨਾ ॥",
      "s": 6
    },
    {
      "t": "ਤੋ ਕੋ ਦੁਖ ਦੇਵੋ ਦਿਜ ਨਾਨਾ ॥੨॥੨੮੮॥",
      "s": 6
    },
    {
      "t": "ਕਹਾ ਮ੍ਰਿਤਕ ਦੁਇ ਕੰਠ ਲਗਾਏ ॥",
      "s": 6
    },
    {
      "t": "ਦੇਹੁ ਹਮੈ ਤੁਮ ਕਹਾ ਲਜਾਏ ॥",
      "s": 6
    },
    {
      "t": "ਜਉ ਦੁਐ ਏ ਤੁਮ ਦੇਹੁ ਨ ਮੋਹੂ ॥",
      "s": 6
    },
    {
      "t": "ਤਉ ਹਮ ਸਿਖ ਨ ਹੋਇ ਹੈ ਤੋਹੂ ॥੩॥੨੮੯॥",
      "s": 6
    },
    {
      "t": "ਤਬ ਦਿਜ ਪ੍ਰਾਤ ਕੀਓ ਇਸਨਾਨਾ ॥",
      "s": 6
    },
    {
      "t": "ਦੇਵ ਪਿਤ੍ਰ ਤੋਖੇ ਬਿਧ ਨਾਨਾ ॥",
      "s": 6
    },
    {
      "t": "ਚੰਦਨ ਕੁੰਕਮ ਖੋਰ ਲਗਾਏ ॥",
      "s": 6
    },
    {
      "t": "ਚਲ ਕਰ ਰਾਜ ਸਭਾ ਮੈ ਆਏ ॥੪॥੨੯੦॥",
      "s": 6
    },
    {
      "t": "ਦਿਜੋ ਬਾਚ ॥",
      "s": 6
    },
    {
      "t": "ਹਮਰੀ ਵੈ ਨ ਪਰੈ ਦੁਐ ਡੀਠਾ ॥",
      "s": 6
    },
    {
      "t": "ਹਮਰੀ ਆਇ ਪਰੈ ਨਹੀ ਪੀਠਾ ॥",
      "s": 6
    },
    {
      "t": "ਝੂਠ ਕਹਿਯੋ ਜਿਨ ਤੋਹਿ ਸੁਨਾਈ ॥",
      "s": 6
    },
    {
      "t": "ਮਹਾਰਾਜ ਰਾਜਨ ਕੇ ਰਾਈ ॥੧॥੨੯੧॥",
      "v": [
        [
          0,
          1
        ]
      ],
      "s": 6
    },
    {
      "t": "ਮਹਾਰਾਜ ਰਾਜਨ ਕੇ ਰਾਜਾ ॥",
      "s": 6
    },
    {
      "t": "ਨਾਇਕ ਅਖਲ ਧਰਣ ਸਿਰ ਤਾਜਾ ॥",
      "s": 6
    },
    {
      "t": "ਹਮ ਬੈਠੇ ਤੁਮ ਦੇਹੁ ਅਸੀਸਾ ॥",
      "s": 6
    },
    {
      "t": "ਤੁਮ ਰਾਜਾ ਰਾਜਨ ਕੇ ਈਸਾ ॥੨॥੨੯੨॥",
      "s": 6
    },
    {
      "t": "ਰਾਜਾ ਬਾਚ ॥",
      "s": 6
    },
    {
      "t": "ਭਲਾ ਚਹੋ ਆਪਨ ਜੋ ਸਬਹੀ ॥",
      "s": 6
    },
    {
      "t": "ਵੈ ਦੁਇ ਬਾਧ ਦੇਹੁ ਮੁਹਿ ਅਬਹੀ ॥",
      "s": 6
    },
    {
      "t": "ਸਬਹੀ ਕਰੋ ਅਗਨ ਕਾ ਭੂਜਾ ॥",
      "s": 6
    },
    {
      "t": "ਤੁਮਰੀ ਕਰਉ ਪਿਤਾ ਜਿਉ ਪੂਜਾ ॥੩॥੨੯੩॥",
      "s": 6
    },
    {
      "t": "ਜੋ ਨ ਪਰੈ ਵੈ ਭਾਜ ਤਿਹਾਰੇ ॥",
      "s": 6
    },
    {
      "t": "ਕਹੇ ਲਗੋ ਤੁਮ ਆਜ ਹਮਾਰੇ ॥",
      "s": 6
    },
    {
      "t": "ਹਮ ਤੁਮ ਕੋ ਬ੍ਰਿੰਜਨਾਦ ਬਨਾਵੈ ॥",
      "s": 6
    },
    {
      "t": "ਹਮ ਤੁਮ ਵੈ ਤੀਨੋ ਮਿਲ ਖਾਵੈ ॥੪॥੨੯੪॥",
      "s": 6
    },
    {
      "t": "ਦਿਜ ਸੁਨ ਬਾਤ ਚਲੇ ਸਭ ਧਾਮਾ ॥",
      "s": 6
    },
    {
      "t": "ਪੂਛੇ ਭ੍ਰਾਤ ਸੁਪੂਤ ਪਿਤਾਮਾ ॥",
      "s": 6
    },
    {
      "t": "ਬਾਧ ਦੇਹੁ ਤਉ ਛੂਟੇ ਧਰਮਾ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 6
    },
    {
      "t": "ਭੋਜ ਭੁਜੇ ਤਉ ਛੂਟੇ ਕਰਮਾ ॥੫॥੨੯੫॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 6
    },
    {
      "t": "ਯਹਿ ਰਜੀਆ ਕਾ ਪੁਤ ਮਹਾਬਲ ॥",
      "s": 6
    },
    {
      "t": "ਜਿਨ ਜੀਤੇ ਛਤ੍ਰੀ ਗਨ ਦਲਮਲ ॥",
      "s": 6
    },
    {
      "t": "ਛਤ੍ਰਾਪਨ ਆਪਨ ਬਲ ਲੀਨਾ ॥",
      "s": 6
    }
  ]
