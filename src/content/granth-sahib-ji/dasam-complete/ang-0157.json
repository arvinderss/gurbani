{
  "page": 157,
  "lines": [
    {
      "t": "ਦੁਖ ਦਾਹਤ ਸੰਤਨ ਕੇ ਆਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਦੁਖ ਦਾਹਨ ਪ੍ਰਭ ਤਦਿਨ ਕਹਾਯੋ ॥੧੧॥",
      "s": 7
    },
    {
      "t": "ਚਉਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਰਹਾ ਅਨੰਤ ਅੰਤ ਨਹੀ ਪਾਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਯਾ ਤੇ ਨਾਮੁ ਬਿਅੰਤ ਕਹਾਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਜਗ ਮੋ ਰੂਪ ਸਭਨ ਕੇ ਧਰਤਾ ॥",
      "s": 7
    },
    {
      "t": "ਯਾ ਤੇ ਨਾਮੁ ਬਖਾਨੀਯਤ ਕਰਤਾ ॥੧੨॥",
      "s": 7
    },
    {
      "t": "ਚਉਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਕਿਨਹੂੰ ਕਹੂੰ ਨ ਤਾਹਿ ਲਖਾਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਇਹ ਕਰ ਨਾਮੁ ਅਲਖ ਕਹਾਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਜੋਨ ਜਗਤ ਮੈ ਕਬਹੂੰ ਨ ਆਯਾ ॥",
      "s": 7
    },
    {
      "t": "ਯਾ ਤੇ ਸਭੌ ਅਜੋਨ ਬਤਾਯਾ ॥੧੩॥",
      "s": 7
    },
    {
      "t": "ਚਉਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਬ੍ਰਹਮਾਦਕ ਸਬ ਹੀ ਪਚਹਾਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਬਿਸਨ ਮਹੇਸ੍ਵੁਰ ਕਉਨ ਬਿਚਾਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਚੰਦ ਸੂਰ ਜਿਨ ਕਰੇ ਬਿਚਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਤਾ ਤੇ ਜਾਨੀਯਤ ਹੈ ਕਰਤਾਰਾ ॥੧੪॥",
      "s": 7
    },
    {
      "t": "ਚਉਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਸਦਾ ਅਭੇਖ ਅਭੇਖੀ ਰਹਈ ॥",
      "s": 7
    },
    {
      "t": "ਤਾ ਤੇ ਜਗਤ ਅਭੇਖੀ ਕਹਈ ॥",
      "s": 7
    },
    {
      "t": "ਅਲਖ ਰੂਪ ਕਿਨਹੂੰ ਨਹਿ ਜਾਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਹ ਕਰ ਜਾਤ ਅਲੇਖ ਬਖਾਨਾ ॥੧੫॥",
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਰੂਪ ਅਨੂਪ ਸਰੂਪ ਅਪਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਭੇਖ ਅਭੇਖ ਸਭਨ ਤੇ ਨਿਆਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਦਾਇਕ ਸਭੋ ਅਜਾਚੀ ਸਭ ਤੇ ॥",
      "s": 7
    },
    {
      "t": "ਜਾਨ ਲਯੋ ਕਰਤਾ ਹਮ ਤਬ ਤੇ ॥੧੬॥",
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਲਗਨ ਸਗਨ ਤੇ ਰਹਤ ਨਿਰਾਲਮ ॥",
      "s": 7
    },
    {
      "t": "ਹੈ ਯਹ ਕਥਾ ਜਗਤ ਮੈ ਮਾਲਮ ॥",
      "s": 7
    },
    {
      "t": "ਜੰਤ੍ਰ ਮੰਤ੍ਰ ਤੰਤ੍ਰ ਨ ਰਿਝਾਯਾ ॥",
      "s": 7
    },
    {
      "t": "ਭੇਖ ਕਰਤ ਕਿਨਹੂੰ ਨਹਿ ਪਾਯਾ ॥੧੭॥",
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਜਗ ਆਪਨ ਆਪਨ ਉਰਝਾਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਪਾਰਬ੍ਰਹਮ ਕਾਹੂ ਨ ਪਛਾਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਇਕ ਮੜੀਅਨ ਕਬਰਨ ਵੇ ਜਾਂਹੀ ॥",
      "s": 7
    },
    {
      "t": "ਦੁਹੂੰਅਨ ਮੈ ਪਰਮੇਸ੍ਵਰ ਨਾਹੀ ॥੧੮॥",
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਏ ਦੋਊ ਮੋਹ ਬਾਦ ਮੋ ਪਚੇ ॥",
      "s": 7
    },
    {
      "t": "ਇਨ ਤੇ ਨਾਥ ਨਿਰਾਲੇ ਬਚੇ ॥",
      "s": 7
    },
    {
      "t": "ਜਾ ਤੇ ਛੂਟਿ ਗਯੋ ਭ੍ਰਮ ਉਰ ਕਾ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਹੱ ਆਗੈ ਹਿੰਦੂ ਕਿਆ ਤੁਰਕਾ ॥੧੯॥",
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਇਕ ਤਸਬੀ ਇਕ ਮਾਲਾ ਧਰਹੀ ॥",
      "s": 7
    },
    {
      "t": "ਏਕ ਕੁਰਾਨ ਪੁਰਾਨ ਉਚਰਹੀ ॥",
      "s": 7
    },
    {
      "t": "ਕਰਤ ਬਿਰੁੱਧ ਗਏ ਮਰ ਮੂੜਾ ॥",
      "s": 7
    },
    {
      "t": "ਪ੍ਰਭ ਕੋ ਰੰਗੁ ਨ ਲਾਗਾ ਗੂੜਾ ॥੨੦॥",
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਜੋ ਜੋ ਰੰਗ ਏਕ ਕੇ ਰਾਚੇ ॥",
      "s": 7
    },
    {
      "t": "ਤੇ ਤੇ ਲੋਕ ਲਾਜ ਤਜਿ ਨਾਚੇ ॥",
      "s": 7
    },
    {
      "t": "ਆਦਿ ਪੁਰਖ ਜਿਨ ਏਕੁ ਪਛਾਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਦੁਤੀਆ ਭਾਵ ਨ ਮਨ ਮਹਿ ਆਨਾ ॥੨੧॥",
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਜੋ ਜੋ ਭਾਵ ਦੁਤੀਅ ਮਹਿ ਰਾਚੇ ॥",
      "s": 7
    },
    {
      "t": "ਤੇ ਤੇ ਮੀਤ ਮਿਲਨ ਤੇ ਬਾਚੇ ॥",
      "s": 7
    },
    {
      "t": "ਏਕ ਪੁਰਖ ਜਿਨ ਨੈਕ ਪਛਾਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਨਹੀ ਪਰਮ ਤਤ ਕੱਹ ਜਾਨਾ ॥੨੨॥",
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਜੋਗੀ ਸੰਨਿਆਸੀ ਹੈ ਜੇਤੇ ॥",
      "s": 7
    },
    {
      "t": "ਮੁੰਡੀਆ ਮੁਸਲਮਾਨ ਗਨ ਕੇਤੇ ॥",
      "s": 7
    }
  ]
}
