{
  "page": 158,
  "lines": [
    {
      "t": "ਭੇਖ ਧਰੇ ਲੂਟਤ ਸੰਸਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਛਪਤ ਸਾਧ ਜਿਹੱ ਨਾਮੁ ਅਧਾਰਾ ॥੨੩॥",
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਪੇਟ ਹੇਤ ਨਰ ਡਿੰਭੁ ਦਿਖਾਹੀਂ ॥",
      "s": 7
    },
    {
      "t": "ਡਿੰਭ ਕਰੇ ਬਿਨੁ ਪਈਯਤ ਨਾਹੀਂ ॥",
      "s": 7
    },
    {
      "t": "ਜਿਨ ਨਰ ਏਕ ਪੁਰਖ ਕਹੱ ਧਿਆਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਨ ਕਰ ਡਿੰਭ ਨ ਕਿਸੀ ਦਿਖਾਯੋ ॥੨੪॥",
      "s": 7
    },
    {
      "t": "ਡਿੰਭ ਕਰੇ ਬਿਨੁ ਹਾਥਿ ਨ ਆਵੈ ॥",
      "s": 7
    },
    {
      "t": "ਕੋਊ ਨ ਕਾਹੂ ਸੀਸ ਨਿਵਾਵੈ ॥",
      "s": 7
    },
    {
      "t": "ਜੋ ਇਹੁ ਪੇਟ ਨ ਕਾਹੂ ਹੋਤਾ ॥",
      "s": 7
    },
    {
      "t": "ਰਾਵ ਰੰਕ ਕਾਹੂ ਕੋ ਕਹਤਾ ॥੨੫॥",
      "s": 7
    },
    {
      "t": "ਜਿਨ ਪ੍ਰਭ ਏਕ ਵਹੈ ਠਹਰਾਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਨ ਕਰ ਡਿੰਭ ਨ ਕਿਸੂ ਦਿਖਾਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਸੀਸ ਦੀਯੋ ਉਨ ਸਿਰਰ ਨ ਦੀਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਰੰਚ ਸਮਾਨ ਦੇਹ ਕਰਿ ਚੀਨਾ ॥੨੬॥",
      "s": 7
    },
    {
      "t": "ਕਾਨ ਛੇਦ ਜੋਗੀ ਕਹਵਾਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਅਤਿ ਪ੍ਰਪੰਚ ਕਰ ਬਨਹਿ ਸਿਧਾਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਏਕ ਨਾਮੁ ਕੋ ਤੱਤੁ ਨ ਲਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਬਨ ਕੋ ਭਯੋ ਨ ਗ੍ਰਿਹ ਕੋ ਭਯੋ ॥੨੭॥",
      "s": 7
    },
    {
      "t": "ਕਹਾ ਲਗੈ ਕਬ ਕਥੈ ਬਿਚਾਰਾ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਰਸਨਾ ਏਕ ਨ ਪਇਯਤ ਪਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਜਿਹਬਾ ਕੋਟਿ ਕੋਟਿ ਕੋਊ ਧਰੈ ॥",
      "s": 7
    },
    {
      "t": "ਗੁਣ ਸਮੁੰਦ੍ਰ ਤ੍ਵ ਪਾਰ ਨ ਪਰੈ ॥੨੮॥",
      "s": 7
    },
    {
      "t": "ਪ੍ਰਥਮ ਕਾਲ ਸਭ ਜਗ ਕੋ ਤਾਤਾ ॥",
      "s": 7
    },
    {
      "t": "ਤਾ ਤੇ ਭਯੋ ਤੇਜ ਬਿਖਯਾਤਾ ॥",
      "s": 7
    },
    {
      "t": "ਸੋਈ ਭਵਾਨੀ ਨਾਮੁ ਕਹਾਈ ॥",
      "s": 7
    },
    {
      "t": "ਜਿਨ ਸਿਗਰੀ ਯਹ ਸ੍ਰਿਸਟਿ ਉਪਾਈ ॥੨੯॥",
      "s": 7
    },
    {
      "t": "ਪ੍ਰਿਥਮੇ ਓਅੰਕਾਰ ਤਿਨਿ ਕਹਾ ॥",
      "s": 7
    },
    {
      "t": "ਸੋ ਧੁਨਿ ਪੂਰ ਜਗਤ ਮੋ ਰਹਾ ॥",
      "s": 7
    },
    {
      "t": "ਤਾ ਤੇ ਜਗਤ ਭਯੋ ਬਿਸਥਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਪੁਰਖ ਪ੍ਰਕ੍ਰਿਤਿ ਜਬ ਦੁਹੂੱ ਬਿਚਾਰਾ ॥੩੦॥",
      "s": 7
    },
    {
      "t": "ਜਗਤ ਭਯੋ ਤਾ ਤੇ ਸਭ ਜਨੀਯਤ ॥",
      "s": 7
    },
    {
      "t": "ਚਾਰ ਖਾਨ ਕਰ ਪ੍ਰਗਟ ਬਖਨੀਯਤ ॥",
      "s": 7
    },
    {
      "t": "ਸਕਤ ਇਤੀ ਨਹੀ ਬਰਨ ਸੁਨਾਊਂ ॥",
      "s": 7
    },
    {
      "t": "ਭਿੰਨ ਭਿੰਨ ਕਰ ਨਾਮ ਬਤਾਉਂ ॥੩੧॥",
      "s": 7
    },
    {
      "t": "ਬਲੀ ਅਬਲੀ ਦੋਊ ਉਪਜਾਏ ॥",
      "s": 7
    },
    {
      "t": "ਊਚ ਨੀਚ ਕਰ ਭਿੰਨ ਦਿਖਾਏ ॥",
      "s": 7
    },
    {
      "t": "ਬਪੁ ਧਰਿ ਕਾਲ ਬਲੀ ਬਲਵਾਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਆਪਹ ਰੂਪ ਧਰਤ ਭਯੋ ਨਾਨਾ ॥੩੨॥",
      "s": 7
    },
    {
      "t": "ਭਿੰਨ ਭਿੰਨ ਜਿਮੁ ਦੇਹ ਧਰਾਏ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਮੁ ਤਿਮੁ ਕਰ ਅਵਤਾਰ ਕਹਾਏ ॥",
      "s": 7
    },
    {
      "t": "ਪਰਮ ਰੂਪ ਜੋ ਏਕ ਕਹਾਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਅੰਤ ਸਭੋ ਤਿਹ ਮੱਧਿ ਮਿਲਾਯੋ ॥੩੩॥",
      "s": 7
    },
    {
      "t": "ਜਿਤਿਕ ਜਗਤਿ ਕੇ ਜੀਵ ਬਖਾਨੋ ॥",
      "s": 7
    },
    {
      "t": "ਏਕ ਜੋਤ ਸਭ ਹੀ ਮਹਿ ਜਾਨੋ ॥",
      "s": 7
    },
    {
      "t": "ਕਾਲ ਰੂਪ ਭਗਵਾਨ ਭਨੈਬੋ ॥",
      "s": 7
    },
    {
      "t": "ਤਾ ਮੈ ਲੀਨ ਜਗਤਿ ਸਭ ਹ੍ਵੁੈਬੋ ॥੩੪॥",
      "s": 7
    },
    {
      "t": "ਜੋ ਕਿਛੁ ਦਿਸਟਿ ਅਗੋਚਰ ਆਵਤ ॥",
      "s": 7
    },
    {
      "t": "ਤਾ ਕਹੁ ਮਨ ਮਾਯਾ ਠਹਰਾਵਤ ॥",
      "s": 7
    }
  ]
}
