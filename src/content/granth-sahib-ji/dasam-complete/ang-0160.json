{
  "page": 160,
  "lines": [
    {
      "t": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਤਬੈ ਕੋਪ ਗਰਜਿਯੋ ਬਲੀ ਸੰਖ ਬੀਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਧਰੇ ਸਸਤ੍ਰ ਅਸਤ੍ਰੰ ਸਜੇ ਲੋਹ ਚੀਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਚਤੁਰ ਬੇਦ ਪਾਤੰ ਕੀਯੋ ਸਿੰਧ ਮੱਧੰ ॥",
      "s": 7
    },
    {
      "t": "ਤ੍ਰਸ੍ਯੋ ਅਸਟ ਨੈਣੰ ਕਰਿਯੋ ਜਾਪੁ ਸੁਧੰ ॥੪੧॥",
      "s": 7
    },
    {
      "t": "ਤਬੈ ਸੰਭਰੇ ਦੀਨ ਹੇਤੰ ਦਿਆਲੰ ॥",
      "s": 7
    },
    {
      "t": "ਧਰੇ ਲੋਹ ਕ੍ਰੋਹੰ ਕ੍ਰਿਪਾ ਕੈ ਕ੍ਰਿਪਾਲੰ ॥",
      "s": 7
    },
    {
      "t": "ਮਹਾਂ ਅਸਤੁ੍ਰ ਪਾਤੰ ਕਰੇ ਸਸਤ੍ਰ ਘਾਤੰ ॥",
      "s": 7
    },
    {
      "t": "ਟਰੇ ਦੇਵ ਸਰਬੰ ਗਿਰੇ ਲੋਕ ਸਾਤੰ ॥੪੨॥",
      "s": 7
    },
    {
      "t": "ਭਏ ਅਤ੍ਰੁ ਘਾਤੰ ਗਿਰੇ ਚਉਰ ਚੀਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਰੁਲੇ ਤੱਛ ਮੁੱਛੰ ਉਠੇ ਤਿੱਛ ਤੀਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਗਿਰੇ ਸੁੰਡ ਮੁੰਡੰ ਰਣੰ ਭੀਮ ਰੂਪੰ ॥",
      "s": 7
    },
    {
      "t": "ਮਨੋ ਖੇਲ ਪਉਢੇ ਹਠੀ ਫਾਗ ਜੂਪੰ ॥੪੩॥",
      "s": 7
    },
    {
      "t": "ਬਹੇ ਖੱਗਯੰ ਖੇਤ ਖਿੰਗੰ ਸੁ ਧੀਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਸੁਭੈ ਸਸਤ੍ਰ ਸੰਜਾਨ ਸੋ ਸੂਰਬੀਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਗਿਰੇ ਗਉਰ ਗਾਜੀ ਖੁਲੇ ਹੱਥਿ ਬੱਥੰ ॥",
      "s": 7
    },
    {
      "t": "ਨਚਿਯੋ ਰੁਦ੍ਰ ਰੁਦ੍ਰੰ ਨਚੇ ਮੱਛ ਮੱਥੰ ॥੪੪॥",
      "s": 7
    },
    {
      "t": "ਰਸਾਵਲ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਮਹਾ ਬੀਰ ਗੱਜੇ ॥",
      "s": 7
    },
    {
      "t": "ਸਭੰ ਸਸਤ੍ਰ ਸੱਜੇ ॥",
      "s": 7
    },
    {
      "t": "ਬੱਧੇ ਗੱਜਗਾਹੰ ॥",
      "s": 7
    },
    {
      "t": "ਸੁ ਹੂਰੰ ਉਛਾਹੰ ॥੪੫॥",
      "s": 7
    },
    {
      "t": "ਢਲਾ ਢੁੱਕ ਢਾਲੰ ॥",
      "s": 7
    },
    {
      "t": "ਝਮੀ ਤੇਗ ਕਾਲੰ ॥",
      "s": 7
    },
    {
      "t": "ਕਟਾ ਕਾਟ ਬਾਹੈਂ ॥",
      "s": 7
    },
    {
      "t": "ਉਭੈ ਜੀਤ ਚਾਹੈਂ ॥੪੬॥",
      "s": 7
    },
    {
      "t": "ਮੁਖੰ ਮੁੱਛ ਬੰਕੀ ॥",
      "s": 7
    },
    {
      "t": "ਤਮੰ ਤੇਗ ਅਤੰਕੀ ॥",
      "s": 7
    },
    {
      "t": "ਫਿਰੈਂ ਗਉਰ ਗਾਜੀ ॥",
      "s": 7
    },
    {
      "t": "ਨਚੈਂ ਤੁੰਦ ਤਾਜੀ ॥੪੭॥",
      "s": 7
    },
    {
      "t": "ਭੁਜੰਗ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਭਰਯੋ ਰੋਸ ਸੰਖਾਸੁਰੰ ਦੇਖ ਸੈਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਤਪੇ ਬੀਰ ਬਕਤ੍ਰੰ ਕੀਏ ਰਕਤ ਨੈਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਭੁਜਾ ਠੋਕ ਭੂਪੰ ਕਰਯੋ ਨਾਦ ਉੱਚੰ ॥",
      "s": 7
    },
    {
      "t": "ਸੁਣੇ ਗਰਭਣੀਆਨ ਕੇ ਗਰਭ ਮੁੱਚੰ ॥੪੮॥",
      "s": 7
    },
    {
      "t": "ਲਗੇ ਠਾਮ ਠਾਮੰ ਦਮਾਮੰ ਦਮੰਕੇ ॥",
      "s": 7
    },
    {
      "t": "ਖੁਲੇ ਖੇਤ ਮੋ ਖੱਗ ਖੂਨੀ ਖਿਮੰਕੇ ॥",
      "s": 7
    },
    {
      "t": "ਭਏ ਕ੍ਰੂਰ ਭਾਂਤੰ ਕਮਾਣੰ ਕੜੱਕੇ ॥",
      "s": 7
    },
    {
      "t": "ਨਚੇ ਬੀਰ ਬੈਤਾਲ ਭੂਤੰ ਭੁੜੱਕੇ ॥੪੯॥",
      "s": 7
    },
    {
      "t": "ਗਿਰਯੋ ਆਯੁਧੰ ਸਾਯੁਧੰ ਬੀਰ ਖੇਤੰ ॥",
      "s": 7
    },
    {
      "t": "ਨਚੇ ਕੰਧ ਹੀਣੰ ਕਮੱਧੰ ਅਚੇਤੰ ॥",
      "s": 7
    },
    {
      "t": "ਖੁਲੇ ਖੱਗ ਖੂਨੀ ਖਿਆਲੰ ਖਤੰਗੰ ॥",
      "s": 7
    },
    {
      "t": "ਭਜੇ ਕਾਤਰੰ ਸੂਰ ਬੱਜੇ ਨਿਹੰਗੰ ॥੫੦॥",
      "s": 7
    },
    {
      "t": "ਕਟੇ ਚਰਮ ਬਰਮੰ ਗਿਰਿਯੋ ਸਤ੍ਰੁ ਸਸਤ੍ਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਭਕੈ ਭੈ ਭਰੇ ਭੂਤ ਭੂਮੰ ਨ੍ਰਿਸਤ੍ਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਰਣੰ ਰੰਗ ਰੱਤੇ ਸਭੀ ਰੰਗ ਭੂਮੰ ॥",
      "s": 7
    },
    {
      "t": "ਗਿਰੇ ਜੁੱਧ ਮੱਧੰ ਬਲੀ ਝੂਮ ਝੂਮੰ ॥੫੧॥",
      "s": 7
    },
    {
      "t": "ਭਯੋ ਦੁੰਦ ਜੁੱਧੰ ਰਣੰ ਸੰਖ ਮੱਛੰ ॥",
      "s": 7
    }
  ]
}
