{
  "page": 183,
  "lines": [
    {
      "t": "ਕੇਤਕ ਬ੍ਯਾਹ ਚੰਦ੍ਰਮਾ ਲੀਨੀ ॥",
      "s": 7
    },
    {
      "t": "ਕੇਤਕ ਗਈ ਅਉਰ ਦੇਸਨ ਮਹਿ ॥",
      "s": 7
    },
    {
      "t": "ਬਰਿਯੋ ਗਉਰਜਾ ਏਕ ਰੁਦ੍ਰ ਕਹਿ ॥੧੧॥",
      "s": 7
    },
    {
      "t": "ਜਬ ਹੀ ਬ੍ਯਾਹ ਰੁਦ੍ਰ ਗ੍ਰਿਹਿ ਆਨੀ ॥",
      "s": 7
    },
    {
      "t": "ਚਲੀ ਜਗ ਕੀ ਬਹੁਰਿ ਕਹਾਨੀ ॥",
      "s": 7
    },
    {
      "t": "ਸਬ ਦੁਹਿਤਾ ਤਿਹ ਬੋਲਿ ਪਠਾਈ ॥",
      "s": 7
    },
    {
      "t": "ਲੀਨੋ ਸੰਗਿ ਭਤਾਰਨ ਆਈ ॥੧੨॥",
      "s": 7
    },
    {
      "t": "ਜੇ ਜੇ ਹੁਤੇ ਦੇਸ ਪਰਦੇਸਾ ॥",
      "s": 7
    },
    {
      "t": "ਜਾਤ ਭਏ ਸਸੁਰਾਰਿ ਨਰੇਸਾ ॥",
      "s": 7
    },
    {
      "t": "ਨਿਰਖਿ ਰੁਦ੍ਰ ਕੋ ਅਉਰ ਪ੍ਰਕਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਕਿਨਹੂੰ ਨ ਭੂਪਤਿ ਤਾਹਿ ਚਿਤਾਰਾ ॥੧੩॥",
      "s": 7
    },
    {
      "t": "ਨਹਨ ਗਉਰਜਾ ਦਛ ਬੁਲਾਈ ॥",
      "s": 7
    },
    {
      "t": "ਸੁਨਿ ਨਾਰਦ ਤੇ ਹ੍ਰਿਦੈ ਰਿਸਾਈ ॥",
      "s": 7
    },
    {
      "t": "ਬਿਨ ਬੋਲੇ ਪਿਤ ਕੇ ਗ੍ਰਿਹ ਗਈ ॥",
      "s": 7
    },
    {
      "t": "ਅਨਿਕ ਪ੍ਰਕਾਰ ਤੇਜ ਤਨ ਤਈ ॥੧੪॥",
      "s": 7
    },
    {
      "t": "ਜਗ ਕੁੰਡ ਮਹਿ ਪਰੀ ਉਛਰ ਕਰਿ ॥",
      "s": 7
    },
    {
      "t": "ਸਤ ਪ੍ਰਤਾਪਿ ਪਾਵਕ ਭਈ ਸੀਤਰਿ ॥",
      "s": 7
    },
    {
      "t": "ਜੋਗ ਅਗਨਿ ਕਹੁ ਬਹੁਰਿ ਪ੍ਰਕਾਸਾ ॥",
      "s": 7
    },
    {
      "t": "ਤਾ ਤਨ ਕੀਯੋ ਪ੍ਰਾਨ ਕੋ ਨਾਸਾ ॥੧੫॥",
      "s": 7
    },
    {
      "t": "ਆਇ ਨਾਰਦ ਇਮ ਸਿਵਹਿ ਜਤਾਈ ॥",
      "s": 7
    },
    {
      "t": "ਕਹਾ ਬੈਠਿ ਹੋ ਭਾਗ ਚੜਾਈ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਛੂਟਿਯੋ ਧਿਆਨ ਕੋਪੁ ਜੀਯ ਜਾਗਾ ॥",
      "s": 7
    },
    {
      "t": "ਗਹਿ ਤ੍ਰਿਸੂਲ ਤਹ ਕੋ ਉਠ ਭਾਗਾ ॥੧੬॥",
      "s": 7
    },
    {
      "t": "ਜਬ ਹੀ ਜਾਤ ਭਯੋ ਤਿਹ ਥਲੈ ॥",
      "s": 7
    }
  ]
}
