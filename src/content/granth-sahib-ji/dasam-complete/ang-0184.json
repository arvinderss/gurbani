{
  "page": 184,
  "lines": [
    {
      "t": "ਲਯੋ ਉਠਾਇ ਸੂਲ ਕਰਿ ਬਲੈ ॥",
      "s": 7
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਤਿਨ ਕਰੇ ਪ੍ਰਹਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਸਕਲ ਬਿਧੁੰਸ ਜਗ ਕਰ ਡਾਰਾ ॥੧੭॥",
      "s": 7
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਭੂਪ ਸੰਘਾਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਇਕ ਇਕ ਤੇ ਕਰ ਦੁਇ ਦੁਇ ਡਾਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਜਾ ਕਹੁ ਪਹੁੰਚਿ ਤ੍ਰਿਸੂਲ ਪ੍ਰਹਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਤਾ ਕਹੁ ਮਾਰ ਠਉਰ ਹੀ ਡਾਰਾ ॥੧੮॥",
      "s": 7
    },
    {
      "t": "ਜਗ ਕੁੰਡ ਨਿਰਖਤ ਭਯੋ ਜਬ ਹੀ ॥",
      "s": 7
    },
    {
      "t": "ਜੂਟ ਜਟਾਨ ਉਖਾਰਸ ਤਬ ਹੀ ॥",
      "s": 7
    },
    {
      "t": "ਬੀਰਭਦ੍ਰ ਤਬ ਕੀਆ ਪ੍ਰਕਾਸਾ ॥",
      "s": 7
    },
    {
      "t": "ਉਪਜਤ ਕਰੋ ਨਰੇਸਨ ਨਾਸਾ ॥੧੯॥",
      "s": 7
    },
    {
      "t": "ਕੇਤਕ ਕਰੇ ਖੰਡ ਨ੍ਰਿਪਤਿ ਬਰ ॥",
      "s": 7
    },
    {
      "t": "ਕੇਤਕ ਪਠੈ ਦਏ ਜਮ ਕੇ ਘਰਿ ॥",
      "s": 7
    },
    {
      "t": "ਕੇਤਕ ਗਿਰੇ ਧਰਣਿ ਬਿਕਰਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਜਨੁ ਸਰਤਾ ਕੇ ਗਿਰੇ ਕਰਾਰਾ ॥੨੦॥",
      "s": 7
    },
    {
      "t": "ਤਬ ਲਉ ਸਿਵਹ ਚੇਤਨਾ ਆਈ ॥",
      "s": 7
    },
    {
      "t": "ਗਹਿ ਪਿਨਾਕ ਕਹੁ ਪਰੋ ਰਿਸਾਈ ॥",
      "s": 7
    },
    {
      "t": "ਜਾ ਕੈ ਤਾਣਿ ਬਾਣ ਤਨ ਮਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਪ੍ਰਾਨ ਤਜੇ ਤਿਨ ਪਾਨਿ ਨੁਚਾਰਾ ॥੨੧॥",
      "s": 7
    },
    {
      "t": "ਡਮਾ ਡਮ ਡਉਰੂ ਬਹੁ ਬਾਜੇ ॥",
      "s": 7
    },
    {
      "t": "ਭੂਤ ਪ੍ਰੇਤ ਦਸਊ ਦਿਸਿ ਗਾਜੈ ॥",
      "s": 7
    },
    {
      "t": "ਝਿਮ ਝਿਮ ਕਰਤ ਅਸਿਨ ਕੀ ਧਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਨਾਚੇ ਰੁੰਡ ਮੁੰਡ ਬਿਕਰਾਰਾ ॥੨੨॥",
      "s": 7
    },
    {
      "t": "ਬਜੇ ਢੋਲ ਸਨਾਇ ਨਗਾਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਜੁਟੈ ਜੰਗ ਕੋ ਜੋਧ ਜੁਝਾਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਖਹਿ ਖਹਿ ਮਰੇ ਅਪਰ ਰਿਸ ਬਢੇ ॥",
      "s": 7
    },
    {
      "t": "ਬਹੁਰਿ ਨ ਦੇਖੀਯਤ ਤਾਜੀਅਨ ਚਢੇ ॥੨੩॥",
      "s": 7
    },
    {
      "t": "ਜਾ ਪਰ ਮੁਸਟ ਤ੍ਰਿਸੂਲ ਪ੍ਰਹਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਤਾਕਹੁ ਠਉਰ ਮਾਰ ਹੀ ਡਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਐਸੋ ਭਯੋ ਬੀਰ ਘਮਸਾਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਭਕ ਭਕਾਇ ਤਹ ਜਗੇ ਮਸਾਨਾ ॥੨੪॥",
      "s": 7
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਤੀਰ ਤਬਰ ਬਰਛੀ ਬਿਛੂਅ ਬਰਸੇ ਬਿਸਖ ਅਨੇਕ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਸਬ ਸੂਰਾ ਜੂਝਤ ਭਏ ਸਾਬਤ ਬਚਾ ਨ ਏਕ ॥੨੫॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਕਟਿ ਕਟਿ ਮਰੇ ਨਰੇਸ ਦੁਖੰਡਾ ॥",
      "s": 7
    },
    {
      "t": "ਬਾਇ ਹਨੇ ਗਿਰਿ ਗੇ ਜਨੁ ਝੰਡਾ ॥",
      "s": 7
    },
    {
      "t": "ਸੂਲ ਸੰਭਾਰਿ ਰੁਦ੍ਰ ਜਬ ਪਰਿਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਚਿਤ੍ਰ ਬਚਿਤ੍ਰ ਅਯੋਧਨ ਕਰਿਯੋ ॥੨੬॥",
      "s": 7
    },
    {
      "t": "ਭਾਜ ਭਾਜ ਤਬ ਚਲੇ ਨਰੇਸਾ ॥",
      "s": 7
    },
    {
      "t": "ਜਗ ਬਿਸਾਰ ਸੰਭਾਰਿਯੋ ਦੇਸਾ ॥",
      "s": 7
    },
    {
      "t": "ਜਬ ਰਣ ਰੁਦ੍ਰ ਰੁਦ੍ਰ ਹੁਐ ਧਾਏ ॥",
      "s": 7
    },
    {
      "t": "ਭਾਜਤ ਭੂਪ ਨ ਬਾਚਨ ਪਾਏ ॥੨੭॥",
      "s": 7
    },
    {
      "t": "ਤਬ ਸਬ ਭਰੇ ਤੇਜ ਤਨੁ ਰਾਜਾ ॥",
      "s": 7
    },
    {
      "t": "ਬਾਜਨ ਲਗੇ ਅਨੰਤਨ ਬਾਜਾ ॥",
      "s": 7
    },
    {
      "t": "ਮਚਿਯੋ ਬਹੁਰਿ ਘੋਰਿ ਸੰਗ੍ਰਾਮਾ ॥",
      "s": 7
    },
    {
      "t": "ਜਮ ਕੋ ਭਰਾ ਛਿਨਕ ਮਹਿ ਧਾਮਾ ॥੨੮॥",
      "s": 7
    },
    {
      "t": "ਭੂਪਤ ਫਿਰੇ ਜੁਧ ਕੇ ਕਾਰਨ ॥",
      "s": 7
    }
  ]
}
