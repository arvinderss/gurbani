{
  "page": 186,
  "lines": [
    {
      "t": "ਜੁਆਨ ਆਨ ਕੇ ਪਰੇ ਸੁ ਰੁਦ੍ਰ ਠਾਢਿਬੋ ਜਹਾ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਬਿਅੰਤ ਬਾਣ ਸੈਹਥੀ ਪ੍ਰਹਾਰ ਆਨ ਕੇ ਕਰੈ ॥",
      "v": [
        [
          2,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਧਕੇਲਿ ਰੇਲਿ ਲੈ ਚਲੈ ਪਛੇਲ ਪਾਵ ਨ ਟਰੈ ॥੪੦॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਸੜਕ ਸੂਲ ਸੈਹਥੀ ਤੜਕ ਤੇਗ ਤੀਰਯੰ ॥",
      "v": [
        [
          2,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਬਬਕ ਬਾਘ ਜਿਯੋ ਬਲੀ ਭਭਕ ਘਾਇ ਬੀਰਯੰ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਅਘਾਇ ਘਾਇ ਕੇ ਗਿਰੇ ਪਛੇਲ ਪਾਵ ਨ ਟਰੇ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਸੁ ਬੀਨ ਬੀਨ ਅਛਰੈ ਪ੍ਰਬੀਨ ਦੀਨ ਹੁਐ ਬਰੇ ॥੪੧॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਜੂਝਿ ਗਿਰਿਯੋ ਸਭ ਸਾਥਾ ॥",
      "s": 7
    },
    {
      "t": "ਰਹਿ ਗਯੋ ਦਛ ਅਕੇਲ ਅਨਾਥਾ ॥",
      "s": 7
    },
    {
      "t": "ਬਚੇ ਬੀਰ ਤੇ ਬਹੁਰਿ ਬੁਲਾਇਸੁ ॥",
      "s": 7
    },
    {
      "t": "ਪਹਰਿ ਕਵਚ ਦੁੰਦਭੀ ਬਜਾਇਸੁ ॥੪੨॥",
      "s": 7
    },
    {
      "t": "ਆਪਨ ਚਲਾ ਜੁਧ ਕਹੁ ਰਾਜਾ ॥",
      "s": 7
    },
    {
      "t": "ਜੋਰ ਕਰੋਰ ਅਯੋਧਨ ਸਾਜਾ ॥",
      "s": 7
    },
    {
      "t": "ਛੂਟਤ ਬਾਣ ਕਮਾਣ ਅਪਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਜਨੁ ਦਿਨ ਤੇ ਹੁਐ ਗਯੋ ਅੰਧਾਰਾ ॥੪੩॥",
      "s": 7
    },
    {
      "t": "ਭੂਤ ਪਰੇਤ ਮਸਾਣ ਹਕਾਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਦੁਹੂੰ ਓਰ ਡਉਰੂ ਡਮਕਾਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਮਹਾ ਘੋਰ ਮਚਿਯੋ ਸੰਗ੍ਰਾਮਾ ॥",
      "s": 7
    },
    {
      "t": "ਜੈਸਕ ਲੰਕਿ ਰਾਵਣ ਅਰੁ ਰਾਮਾ ॥੪੪॥",
      "s": 7
    },
    {
      "t": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਭਯੋ ਰੁਦ੍ਰ ਕੋਪੰ ਧਰਿਯੋ ਸੂਲ ਪਾਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਕਰੇ ਸੂਰਮਾ ਸਰਬ ਖਾਲੀ ਪਲਾਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਉਤੇ ਏਕ ਦਛੰ ਇਤੈ ਰੁਦ੍ਰ ਏਕੰ ॥",
      "s": 7
    }
  ]
}
