{
  "page": 188,
  "lines": [
    {
      "t": "ਬਿਸਨ ਨਾਰਿ ਕੇ ਧਾਮਿ ਛੁਧਾਤੁਰ ॥",
      "s": 7
    },
    {
      "t": "ਬੈਗਨ ਨਿਰਖਿ ਅਧਿਕ ਲਲਚਾਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਮਾਗ ਰਹਿਯੋ ਪਰ ਹਾਥਿ ਨ ਆਯੋ ॥੬॥",
      "v": [
        [
          1,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਨਾਥ ਹੇਤੁ ਮੈ ਭੋਜ ਪਕਾਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਮਨੁਛ ਪਠੈ ਕਰ ਬਿਸਨੁ ਬੁਲਾਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਨਾਰਦ ਖਾਇ ਜੂਠ ਹੋਇ ਜੈ ਹੈ ॥",
      "v": [
        [
          0,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਪੀਅ ਕੋਪਿਤ ਹਮਰੇ ਪਰ ਹੁਐ ਹੈ ॥੭॥",
      "s": 7
    },
    {
      "t": "ਨਾਰਦ ਬਾਚ ॥",
      "s": 7
    },
    {
      "t": "ਮਾਗ ਥਕਿਯੋ ਮੁਨਿ ਭੋਜ ਨ ਦੀਆ ॥",
      "s": 7
    },
    {
      "t": "ਅਧਿਕ ਰੋਸੁ ਮੁਨਿ ਬਰਿ ਤਬ ਕੀਆ ॥",
      "s": 7
    },
    {
      "t": "ਬ੍ਰਿੰਦਾ ਨਾਮ ਰਾਛਸੀ ਬਪੁ ਧਰਿ ॥",
      "s": 7
    },
    {
      "t": "ਤ੍ਰੀਆ ਹੁਐ ਬਸੋ ਜਲੰਧਰ ਕੇ ਘਰਿ ॥੮॥",
      "s": 7
    },
    {
      "t": "ਦੇ ਕਰ ਸ੍ਰਾਪ ਜਾਤ ਭਯੋ ਰਿਖਿ ਬਰ ॥",
      "s": 7
    },
    {
      "t": "ਆਵਤ ਭਯੋ ਬਿਸਨ ਤਾ ਕੇ ਘਰਿ ॥",
      "s": 7
    },
    {
      "t": "ਸੁਨਤ ਸ੍ਰਾਪ ਅਤਿ ਹੀ ਦੁਖ ਪਾਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਬਿਹਸ ਬਚਨ ਤ੍ਰੀਯ ਸੰਗਿ ਸੁਨਾਯੋ ॥੯॥",
      "s": 7
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਤ੍ਰੀਯ ਕੀ ਛਾਯਾ ਲੈ ਤਬੈ ਬ੍ਰਿਦਾ ਰਚੀ ਬਨਾਇ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਧੂਮ੍ਰਕੇਸ ਦਾਨਵ ਸਦਨਿ ਜਨਮ ਧਰਤ ਭਈ ਜਾਇ ॥੧੦॥",
      "v": [
        [
          2,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਜੈਸਕ ਰਹਤ ਕਮਲ ਜਲ ਭੀਤਰ ॥",
      "s": 7
    },
    {
      "t": "ਪੁਨਿ ਨ੍ਰਿਪ ਬਸੀ ਜਲੰਧਰ ਕੇ ਘਰਿ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਹ ਨਿਮਿਤ ਜਲੰਧਰ ਅਵਤਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਧਰ ਹੈ ਰੂਪ ਅਨੂਪ ਮੁਰਾਰਾ ॥੧੧॥",
      "s": 7
    },
    {
      "t": "ਕਥਾ ਐਸ ਇਹ ਦਿਸ ਮੋ ਭਈ ॥",
      "s": 7
    },
    {
      "t": "ਅਬ ਚਲਿ ਬਾਤ ਰੁਦ੍ਰ ਪਰ ਗਈ ॥",
      "s": 7
    },
    {
      "t": "ਮਾਗੀ ਨਾਰਿ ਨ ਦੀਨੀ ਰੁਦ੍ਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਤਾ ਤੇ ਕੋਪ ਅਸੁਰ ਪਤਿ ਛੁਦ੍ਰਾ ॥੧੨॥",
      "s": 7
    },
    {
      "t": "ਬਜੇ ਢੋਲ ਨਫੀਰਿ ਨਗਾਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਦੁਹੂੰ ਦਿਸਾ ਡਮਰੂ ਡਮਕਾਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਮਾਚਤ ਭਯੋ ਲੋਹ ਬਿਕਰਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਝਮਕਤ ਖਗ ਅਦਗ ਅਪਾਰਾ ॥੧੩॥",
      "s": 7
    },
    {
      "t": "ਗਿਰਿ ਗਿਰਿ ਪਰਤ ਸੁਭਟ ਰਣ ਮਾਹੀ ॥",
      "s": 7
    },
    {
      "t": "ਧੁਕ ਧੁਕ ਉਠਤ ਮਸਾਣ ਤਹਾਹੀ ॥",
      "s": 7
    },
    {
      "t": "ਗਜੀ ਰਥੀ ਬਾਜੀ ਪੈਦਲ ਰਣਿ ॥",
      "s": 7
    },
    {
      "t": "ਜੂਝਿ ਗਿਰੇ ਰਣ ਕੀ ਛਿਤਿ ਅਨਗਣ ॥੧੪॥",
      "s": 7
    },
    {
      "t": "ਤੋਟਕ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਬਿਰਚੇ ਰਣਬੀਰ ਸੁਧੀਰ ਕ੍ਰੁਧੰ ॥",
      "s": 7
    },
    {
      "t": "ਮਚਿਯੋ ਤਿਹ ਦਾਰੁਣ ਭੂਮਿ ਜੁਧੰ ॥",
      "s": 7
    },
    {
      "t": "ਹਹਰੰਤ ਹਯੰ ਗਰਜੰਤ ਗਜੰ ॥",
      "s": 7
    },
    {
      "t": "ਸੁਣਿ ਕੈ ਧੁਨਿ ਸਾਵਣ ਮੇਘ ਲਜੰ ॥੧੫॥",
      "s": 7
    },
    {
      "t": "ਬਰਖੈ ਰਣਿ ਬਾਣ ਕਮਾਣ ਖਗੰ ॥",
      "s": 7
    },
    {
      "t": "ਤਹ ਘੋਰ ਭਯਾਨਕ ਜੁਧ ਜਗੰ ॥",
      "s": 7
    },
    {
      "t": "ਗਿਰ ਜਾਤ ਭਟੰ ਹਹਰੰਤ ਹਠੀ ॥",
      "s": 7
    },
    {
      "t": "ਉਮਗੀ ਰਿਪੁ ਸੈਨ ਕੀਏ ਇਕਠੀ ॥੧੬॥",
      "s": 7
    },
    {
      "t": "ਚਹੂੰ ਓਰ ਘਿਰਿਯੋ ਸਰ ਸੋਧਿ ਸਿਵੰ ॥",
      "s": 7
    },
    {
      "t": "ਕਰਿ ਕੋਪ ਘਨੋ ਅਸੁਰਾਰ ਇਵੰ ॥",
      "s": 7
    },
    {
      "t": "ਦੁਹੂੰ ਓਰਨ ਤੇ ਇਮ ਬਾਣ ਬਹੇ ॥",
      "s": 7
    }
  ]
}
