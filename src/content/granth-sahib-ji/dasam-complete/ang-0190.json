{
  "page": 190,
  "lines": [
    {
      "t": "ਪੁਨਰ ਜੁਧ ਸਜਿਯੋ ਹਠੇ ਤੇਜ ਹੀਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਭਜੇ ਛਾਡ ਕੈ ਸੰਗ ਸਾਥੀ ਅਧੀਣੰ ॥੨੩॥",
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਦੁਹੂੰ ਜੁਧੁ ਕੀਨਾ ਰਣ ਮਾਹੀ ॥",
      "s": 7
    },
    {
      "t": "ਤੀਸਰ ਅਵਰੁ ਤਹਾ ਕੋ ਨਾਹੀ ॥",
      "s": 7
    },
    {
      "t": "ਕੇਤਕ ਮਾਸ ਮਚਿਯੋ ਤਹ ਜੁਧਾ ॥",
      "s": 7
    },
    {
      "t": "ਜਾਲੰਧਰ ਹੁਐ ਸਿਵ ਪੁਰ ਕ੍ਰੁਧਾ ॥੨੪॥",
      "s": 7
    },
    {
      "t": "ਤਬ ਸਿਵ ਧਿਆਨ ਸਕਤਿ ਕੌ ਧਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਤਾ ਤੇ ਸਕਤਿ ਕ੍ਰਿਪਾ ਕਰ ਕਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਤਾ ਤੇ ਭਯੋ ਰੁਦ੍ਰ ਬਲਵਾਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਮੰਡਿਯੋ ਜੁਧੁ ਬਹੁਰਿ ਬਿਧਿ ਨਾਨਾ ॥੨੫॥",
      "s": 7
    },
    {
      "t": "ਉਤ ਹਰਿ ਲਯੋ ਨਾਰਿ ਰਿਪ ਸਤ ਹਰਿ ॥",
      "s": 7
    },
    {
      "t": "ਇਤ ਸਿਵ ਭਯੋ ਤੇਜ ਦੇਬੀ ਕਰਿ ॥",
      "s": 7
    },
    {
      "t": "ਛਿਨ ਮੋ ਕੀਯੋ ਅਸੁਰ ਕੋ ਨਾਸਾ ॥",
      "s": 7
    },
    {
      "t": "ਨਿਰਖਿ ਰੀਝ ਭਟ ਰਹੇ ਤਮਾਸਾ ॥੨੬॥",
      "s": 7
    },
    {
      "t": "ਜਲੰਧਰੀ ਤਾ ਦਿਨ ਤੇ ਨਾਮਾ ॥",
      "s": 7
    },
    {
      "t": "ਜਪਹੁ ਚੰਡਿਕਾ ਕੋ ਸਬ ਜਾਮਾ ॥",
      "s": 7
    },
    {
      "t": "ਤਾ ਤੇ ਹੋਤ ਪਵਿਤ੍ਰ ਸਰੀਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਜਿਮ ਨ੍ਰਹਾਏ ਜਲ ਗੰਗ ਗਹੀਰਾ ॥੨੭॥",
      "s": 7
    },
    {
      "t": "ਤਾ ਤੇ ਕਹੀ ਨ ਰੁਦ੍ਰ ਕਹਾਨੀ ॥",
      "s": 7
    },
    {
      "t": "ਗ੍ਰੰਥ ਬਢਨ ਕੀ ਚਿੰਤ ਪਛਾਨੀ ॥",
      "s": 7
    },
    {
      "t": "ਤਾ ਤੇ ਕਥਾ ਥੋਰਿ ਹੀ ਭਾਸੀ ॥",
      "s": 7
    },
    {
      "t": "ਨਿਰਖਿ ਭੂਲਿ ਕਬਿ ਕਰੋ ਨ ਹਾਸੀ ॥੨੮॥",
      "s": 7
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਜਲੰਧਰ ਅਵਤਾਰ ਬਾਰ੍ਰਹਵਾ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੨॥",
      "s": 7
    },
    {
      "t": "ਅਥ ਬਿਸਨੁ ਅਵਤਾਰ ਕਥਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਸ੍ਰੀ ਭਗਉਤੀ ਜੀ ਸਹਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਅਬ ਮੈ ਗਨੋ ਬਿਸਨੁ ਅਵਤਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਜੈਸਿਕ ਧਰਿਯੋ ਸਰੂਪ ਮੁਰਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਬਿਆਕੁਲ ਹੋਤ ਧਰਨਿ ਜਬ ਭਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਕਾਲ ਪੁਰਖੁ ਪਹਿ ਕਰਤ ਪੁਕਾਰਾ ॥੧॥",
      "s": 7
    },
    {
      "t": "ਅਸੁਰ ਦੇਵਤਨ ਦੇਤਿ ਭਜਾਈ ॥",
      "s": 7
    },
    {
      "t": "ਛੀਨ ਲੇਤ ਭੂਅ ਕੀ ਠਕੁਰਾਈ ॥",
      "s": 7
    },
    {
      "t": "ਕਰਤ ਪੁਕਾਰ ਧਰਣਿ ਭਰਿ ਭਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਕਾਲ ਪੁਰਖ ਤਬ ਹੋਤ ਕ੍ਰਿਪਾਰਾ ॥੨॥",
      "s": 7
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਸਬ ਦੇਵਨ ਕੋ ਅੰਸ ਲੈ ਤਤੁ ਆਪਨ ਠਹਰਾਇ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਬਿਸਨੁ ਰੂਪ ਧਾਰ ਤਤ ਦਿਨ ਗ੍ਰਿਹਿ ਅਦਿਤ ਕੈ ਆਇ ॥੩॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਆਨ ਹਰਤ ਪ੍ਰਿਥਵੀ ਕੋ ਭਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਬਹੁ ਬਿਧਿ ਅਸੁਰਨ ਕਰਤ ਸੰਘਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਭੂਮਿ ਭਾਰ ਹਰਿ ਸੁਰ ਪੁਰਿ ਜਾਈ ॥",
      "s": 7
    },
    {
      "t": "ਕਾਲ ਪੁਰਖ ਮੋ ਰਹਤ ਸਮਾਈ ॥੪॥",
      "s": 7
    },
    {
      "t": "ਸਕਲ ਕਥਾ ਜਉ ਛੋਰਿ ਸੁਨਾਊ ॥",
      "s": 7
    },
    {
      "t": "ਬਿਸਨ ਪ੍ਰਬੰਧ ਕਹਤ ਸ੍ਰਮ ਪਾਊ ॥",
      "s": 7
    },
    {
      "t": "ਤਾ ਤੇ ਥੋਰੀਐ ਕਥਾ ਪ੍ਰਕਾਸੀ ॥",
      "s": 7
    },
    {
      "t": "ਰੋਗ ਸੋਗ ਤੇ ਰਾਖੁ ਅਬਿਨਾਸੀ ॥੫॥",
      "s": 7
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਤੇਰ੍ਰਹਵਾ ਬਿਸਨੁ ਅਵਤਾਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤ ॥੧੩॥",
      "s": 7
    }
  ]
