{
  "page": 192,
  "lines": [
    {
      "t": "ਬਚਨ ਸੁਨਤ ਸੁਰਪੁਰਿ ਥਰਹਰਾ ॥੪॥",
      "s": 7
    },
    {
      "t": "ਬਿਸਨੁ ਬੋਲ ਕਰਿ ਕਰੋ ਬਿਚਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਅਬ ਕਛੁ ਕਰੋ ਮੰਤ੍ਰ ਅਸੁਰਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਬਿਸਨੁ ਨਵੀਨ ਕਹਿਯੋ ਬਪੁ ਧਰਿਹੋ ॥",
      "s": 7
    },
    {
      "t": "ਜਗ ਬਿਘਨ ਅਸੁਰਨ ਕੋ ਕਰਿਹੋ ॥੫॥",
      "s": 7
    },
    {
      "t": "ਬਿਸਨੁ ਅਧਿਕ ਕੀਨੋ ਇਸਨਾਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਦੀਨੇ ਅਮਿਤ ਦਿਜਨ ਕਹੁ ਦਾਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਮਨ ਮੋ ਕਵਲਾ ਸ੍ਰਿਜੋ ਗ੍ਯਾਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਕਾਲ ਪੁਰਖ ਕੋ ਧਰ੍ਯੋ ਧ੍ਯਾਨਾ ॥੬॥",
      "s": 7
    },
    {
      "t": "ਕਾਲ ਪੁਰਖ ਤਬ ਭਏ ਦਇਆਲਾ ॥",
      "s": 7
    },
    {
      "t": "ਦਾਸ ਜਾਨ ਕਹ ਬਚਨ ਰਿਸਾਲਾ ॥",
      "s": 7
    },
    {
      "t": "ਧਰੁ ਅਰਹੰਤ ਦੇਵ ਕੋ ਰੂਪਾ ॥",
      "s": 7
    },
    {
      "t": "ਨਾਸ ਕਰੋ ਅਸੁਰਨ ਕੇ ਭੂਪਾ ॥੭॥",
      "s": 7
    },
    {
      "t": "ਬਿਸਨੁ ਦੇਵ ਆਗਿਆ ਜਬ ਪਾਈ ॥",
      "s": 7
    },
    {
      "t": "ਕਾਲ ਪੁਰਖ ਕੀ ਕਰੀ ਬਡਾਈ ॥",
      "s": 7
    },
    {
      "t": "ਭੂ ਅਰਹੰਤ ਦੇਵ ਬਨਿ ਆਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਆਨਿ ਅਉਰ ਹੀ ਪੰਥ ਚਲਾਯੋ ॥੮॥",
      "s": 7
    },
    {
      "t": "ਜਬ ਅਸੁਰਨ ਕੋ ਭਯੋ ਗੁਰੁ ਆਈ ॥",
      "s": 7
    },
    {
      "t": "ਬਹੁਤ ਭਾਤਿ ਨਿਜ ਮਤਹਿ ਚਲਾਈ ॥",
      "s": 7
    },
    {
      "t": "ਸ੍ਰਾਵਗ ਮਤ ਉਪਰਾਜਨ ਕੀਆ ॥",
      "s": 7
    },
    {
      "t": "ਸੰਤ ਸਬੂਹਨ ਕੋ ਸੁਖ ਦੀਆ ॥੯॥",
      "s": 7
    },
    {
      "t": "ਸਬਹੂੰ ਹਾਥਿ ਮੋਚਨਾ ਦੀਏ ॥",
      "s": 7
    },
    {
      "t": "ਸਿਖਾ ਹੀਣ ਦਾਨਵ ਬਹੁ ਕੀਏ ॥",
      "s": 7
    },
    {
      "t": "ਸਿਖਾ ਹੀਣ ਕੋਈ ਮੰਤ੍ਰ ਨ ਫੁਰੈ ॥",
      "s": 7
    },
    {
      "t": "ਜੋ ਕੋਈ ਜਪੈ ਉਲਟ ਤਿਹ ਪਰੈ ॥੧੦॥",
      "s": 7
    },
    {
      "t": "ਬਹੁਰਿ ਜਗ ਕੋ ਕਰਬ ਮਿਟਾਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਜੀਅ ਹਿੰਸਾ ਤੇ ਸਬਹੂੰ ਹਟਾਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਬਿਨੁ ਹਿੰਸਾ ਕੀਅ ਜਗ ਨ ਹੋਈ ॥",
      "s": 7
    },
    {
      "t": "ਤਾ ਤੇ ਜਗ ਕਰੇ ਨ ਕੋਈ ॥੧੧॥",
      "s": 7
    },
    {
      "t": "ਯਾ ਤੇ ਭਯੋ ਜਗਨ ਕੋ ਨਾਸਾ ॥",
      "s": 7
    },
    {
      "t": "ਜੋ ਜੀਯ ਹਨੈ ਹੋਇ ਉਪਹਾਸਾ ॥",
      "s": 7
    },
    {
      "t": "ਜੀਅ ਮਰੇ ਬਿਨੁ ਜਗ ਨ ਹੋਈ ॥",
      "s": 7
    },
    {
      "t": "ਜਗ ਕਰੈ ਪਾਵੈ ਨਹੀ ਕੋਈ ॥੧੨॥",
      "s": 7
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਦੀਯੋ ਸਭਨ ਉਪਦੇਸਾ ॥",
      "s": 7
    },
    {
      "t": "ਜਗ ਸਕੈ ਕੋ ਕਰ ਨ ਨਰੇਸਾ ॥",
      "s": 7
    },
    {
      "t": "ਅਪੰਥ ਪੰਥ ਸਭ ਲੋਗਨ ਲਾਯਾ ॥",
      "s": 7
    },
    {
      "t": "ਧਰਮ ਕਰਮ ਕੋਊ ਕਰਨ ਨ ਪਾਯਾ ॥੧੩॥",
      "s": 7
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਅੰਨਿ ਅੰਨਿ ਤੇ ਹੋਤੁ ਜਿਯੋ ਘਾਸਿ ਘਾਸਿ ਤੇ ਹੋਇ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਤੈਸੇ ਮਨੁਛ ਮਨੁਛ ਤੇ ਅਵਰੁ ਨ ਕਰਤਾ ਕੋਇ ॥੧੪॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਐਸ ਗਿਆਨ ਸਬਹੂਨ ਦ੍ਰਿੜਾਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਧਰਮ ਕਰਮ ਕੋਊ ਕਰਨ ਨ ਪਾਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਇਹ ਬ੍ਰਿਤ ਬੀਚ ਸਭੋ ਚਿਤ ਦੀਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਅਸੁਰ ਬੰਸ ਤਾ ਤੇ ਭਯੋ ਛੀਨਾ ॥੧੫॥",
      "s": 7
    },
    {
      "t": "ਨ੍ਰਹਾਵਨ ਦੈਤ ਨ ਪਾਵੈ ਕੋਈ ॥",
      "s": 7
    },
    {
      "t": "ਬਿਨੁ ਇਸਨਾਨ ਪਵਿਤ੍ਰ ਨ ਹੋਈ ॥",
      "s": 7
    },
    {
      "t": "ਬਿਨੁ ਪਵਿਤ੍ਰ ਕੋਈ ਫੁਰੇ ਨ ਮੰਤ੍ਰਾ ॥",
      "s": 7
    }
  ]
}
