{
  "page": 194,
  "lines": [
    {
      "t": "ਕਾਲ ਪੁਰਖ ਆਗ੍ਯਾ ਤਬ ਦੀਨੀ ॥",
      "s": 7
    },
    {
      "t": "ਬਿਸਨੁ ਚੰਦ ਸੋਈ ਬਿਧਿ ਕੀਨੀ ॥੨॥",
      "s": 7
    },
    {
      "t": "ਮਨੁ ਹ੍ਵੈ ਰਾਜ ਵਤਾਰ ਅਵਤਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਮਨੁ ਸਿਮਿਰਿਤਹਿ ਪ੍ਰਚੁਰ ਜਗਿ ਕਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਸਕਲ ਕੁਪੰਥੀ ਪੰਥਿ ਚਲਾਏ ॥",
      "s": 7
    },
    {
      "t": "ਪਾਪ ਕਰਮ ਤੇ ਲੋਗ ਹਟਾਏ ॥੩॥",
      "s": 7
    },
    {
      "t": "ਰਾਜ ਅਵਤਾਰ ਭਯੋ ਮਨੁ ਰਾਜਾ ॥",
      "s": 7
    },
    {
      "t": "ਸਰਬ ਹੀ ਸਿਰਜੇ ਧਰਮ ਕੇ ਸਾਜਾ ॥",
      "s": 7
    },
    {
      "t": "ਪਾਪ ਕਰਾ ਤਾ ਕੋ ਗਹਿ ਮਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਸਕਲ ਪ੍ਰਜਾ ਕਹੁ ਮਾਰਗਿ ਡਾਰਾ ॥੪॥",
      "s": 7
    },
    {
      "t": "ਪਾਪ ਕਰਾ ਜਾ ਹੀ ਤਹ ਮਾਰਸ ॥",
      "s": 7
    },
    {
      "t": "ਸਕਲ ਪ੍ਰਜਾ ਕਹੁ ਧਰਮ ਸਿਖਾਰਸ ॥",
      "s": 7
    },
    {
      "t": "ਨਾਮ ਦਾਨ ਸਬਹੂਨ ਸਿਖਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਸ੍ਰਾਵਗ ਪੰਥ ਦੂਰ ਕਰਿ ਡਾਰਾ ॥੫॥",
      "s": 7
    },
    {
      "t": "ਜੇ ਜੇ ਭਾਜਿ ਦੂਰ ਕਹੁ ਗਏ ॥",
      "s": 7
    },
    {
      "t": "ਸ੍ਰਾਵਗ ਧਰਮਿ ਸੋਊ ਰਹਿ ਗਏ ॥",
      "s": 7
    },
    {
      "t": "ਅਉਰ ਪ੍ਰਜਾ ਸਬ ਮਾਰਗਿ ਲਾਈ ॥",
      "s": 7
    },
    {
      "t": "ਕੁਪੰਥ ਪੰਥ ਤੇ ਸੁਪੰਥ ਚਲਾਈ ॥੬॥",
      "s": 7
    },
    {
      "t": "ਰਾਜ ਅਵਤਾਰ ਭਯੋ ਮਨੁ ਰਾਜਾ ॥",
      "s": 7
    },
    {
      "t": "ਕਰਮ ਧਰਮ ਜਗ ਮੋ ਭਲੁ ਸਾਜਾ ॥",
      "s": 7
    },
    {
      "t": "ਸਕਲ ਕੁਪੰਥੀ ਪੰਥ ਚਲਾਏ ॥",
      "s": 7
    },
    {
      "t": "ਪਾਪ ਕਰਮ ਤੇ ਧਰਮ ਲਗਾਏ ॥੭॥",
      "s": 7
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਪੰਥ ਕੁਪੰਥੀ ਸਬ ਲਗੇ ਸ੍ਰਾਵਗ ਮਤ ਭਯੋ ਦੂਰ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਮਨੁ ਰਾਜਾ ਕੋ ਜਗਤ ਮੋ ਰਹਿਯੋ ਸੁਜਸੁ ਭਰਪੂਰ ॥੮॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕੇ ਗ੍ਰੰਥੇ ਮਨੁ ਰਾਜਾ ਅਵਤਾਰ ਸੋਲ੍ਰਹਵਾ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੬॥",
      "s": 7
    },
    {
      "t": "ਅਥ ਧਨੰਤਰ ਬੈਦ ਅਵਤਾਰ ਕਥਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਸ੍ਰੀ ਭਗਉਤੀ ਜੀ ਸਹਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਸਭ ਧਨਵੰਤ ਭਏ ਜਗ ਲੋਗਾ ॥",
      "s": 7
    },
    {
      "t": "ਏਕ ਨ ਰਹਾ ਤਿਨੋ ਤਨ ਸੋਗਾ ॥",
      "s": 7
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਭਛਤ ਪਕਵਾਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਉਪਜਤ ਰੋਗ ਦੇਹ ਤਿਨ ਨਾਨਾ ॥੧॥",
      "s": 7
    },
    {
      "t": "ਰੋਗਾਕੁਲ ਸਭ ਹੀ ਭਏ ਲੋਗਾ ॥",
      "s": 7
    },
    {
      "t": "ਉਪਜਾ ਅਧਿਕ ਪ੍ਰਜਾ ਕੋ ਸੋਗਾ ॥",
      "s": 7
    },
    {
      "t": "ਪਰਮ ਪੁਰਖ ਕੀ ਕਰੀ ਬਡਾਈ ॥",
      "s": 7
    },
    {
      "t": "ਕ੍ਰਿਪਾ ਕਰੀ ਤਿਨ ਪਰ ਹਰਿ ਰਾਈ ॥੨॥",
      "s": 7
    },
    {
      "t": "ਬਿਸਨ ਚੰਦ ਕੋ ਕਹਾ ਬੁਲਾਈ ॥",
      "s": 7
    },
    {
      "t": "ਧਰ ਅਵਤਾਰ ਧਨੰਤਰ ਜਾਈ ॥",
      "s": 7
    },
    {
      "t": "ਆਯੁਰਬੇਦ ਕੋ ਕਰੋ ਪ੍ਰਕਾਸਾ ॥",
      "s": 7
    },
    {
      "t": "ਰੋਗ ਪ੍ਰਜਾ ਕੋ ਕਰਿਯਹੁ ਨਾਸਾ ॥੩॥",
      "s": 7
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਤਾ ਤੇ ਦੇਵ ਇਕਤ੍ਰ ਹੁਐ ਮਥਯੋ ਸਮੁੰਦ੍ਰਹਿ ਜਾਇ ॥",
