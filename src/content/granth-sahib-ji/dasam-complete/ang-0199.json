{
  "page": 199,
  "lines": [
    {
      "t": "ਲਾਗੀ ਕਰਨ ਪਤਿ ਸੇਵ ॥",
      "s": 7
    },
    {
      "t": "ਯਾ ਤੇ ਪ੍ਰਸੰਨਿ ਭਏ ਦੇਵ ॥੧੦॥",
      "s": 7
    },
    {
      "t": "ਬਹੁ ਕ੍ਰਿਸਾ ਲਾਗੀ ਹੋਨ ॥",
      "s": 7
    },
    {
      "t": "ਲਖ ਚੰਦ੍ਰਮਾ ਕੀ ਜੌਨ ॥",
      "s": 7
    },
    {
      "t": "ਸਭ ਭਏ ਸਿਧ ਬਿਚਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਇਮ ਭਯੋ ਚੰਦ੍ਰ ਅਵਤਾਰ ॥੧੧॥",
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਇਮ ਹਰਿ ਧਰਾ ਚੰਦ੍ਰ ਅਵਤਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਬਢਿਯੋ ਗਰਬ ਲਹਿ ਰੂਪ ਅਪਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਆਨ ਕਿਸੂ ਕਹੁ ਚਿਤ ਨ ਲਿਆਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਤਾ ਤੇ ਤਾਹਿ ਕਲੰਕ ਲਗਾਯੋ ॥੧੨॥",
      "s": 7
    },
    {
      "t": "ਭਜਤ ਭਯੋ ਅੰਬਰ ਕੀ ਦਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਤਾ ਤੇ ਕੀਯ ਮੁਨ ਰੋਸ ਅਪਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਕਿਸਨਾਰਜੁਨ ਮ੍ਰਿਗ ਚਰਮ ਚਲਾਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਹ ਕਰਿ ਤਾਹਿ ਕਲੰਕ ਲਗਾਯੋ ॥੧੩॥",
      "s": 7
    },
    {
      "t": "ਸ੍ਰਾਪ ਲਗਯੋ ਤਾ ਕੋ ਮੁਨਿ ਸੰਦਾ ॥",
      "s": 7
    },
    {
      "t": "ਘਟਤ ਬਢਤ ਤਾ ਦਿਨ ਤੇ ਚੰਦਾ ॥",
      "s": 7
    },
    {
      "t": "ਲਜਿਤ ਅਧਿਕ ਹਿਰਦੇ ਮੋ ਭਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਗਰਬ ਅਖਰਬ ਦੂਰ ਹੁਐ ਗਯੋ ॥੧੪॥",
      "s": 7
    },
    {
      "t": "ਤਪਸਾ ਕਰੀ ਬਹੁਰੁ ਤਿਹ ਕਾਲਾ ॥",
      "s": 7
    },
    {
      "t": "ਕਾਲ ਪੁਰਖ ਪੁਨ ਭਯੋ ਦਿਆਲਾ ॥",
      "s": 7
    },
    {
      "t": "ਛਈ ਰੋਗ ਤਿਹ ਸਕਲ ਬਿਨਾਸਾ ॥",
      "s": 7
    },
    {
      "t": "ਭਯੋ ਸੂਰ ਤੇ ਊਚ ਨਿਵਾਸਾ ॥੧੫॥",
      "s": 7
    },
    {
      "t": "ਇਤਿ ਚੰਦ੍ਰ ਅਵਤਾਰ ਉਨੀਸਵੋਂ ॥੧੯॥ ਸੁਭਮ ਸਤੁ ॥",
      "s": 7
    }
  ]
}
