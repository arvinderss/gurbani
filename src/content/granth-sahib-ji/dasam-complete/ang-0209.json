  "page": 209,
  "lines": [
    {
      "t": "ਭਰਯੋ ਰਾਮ ਕ੍ਰੁਧੰ ॥",
      "s": 7
    },
    {
      "t": "ਕਟੀ ਦੁਸਟ ਬਾਹੰ ॥",
      "s": 7
    },
    {
      "t": "ਸੰਘਾਰਯੋ ਸੁਬਾਹੰ ॥੯੨॥",
      "s": 7
    },
    {
      "t": "ਤ੍ਰਸੈ ਦੈਤ ਭਾਜੇ ॥",
      "s": 7
    },
    {
      "t": "ਰਣੰ ਰਾਮ ਗਾਜੇ ॥",
      "s": 7
    },
    {
      "t": "ਭੁਅੰ ਭਾਰ ਉਤਾਰਿਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਰਿਖੀਸੰ ਉਬਾਰਿਯੋ ॥੯੩॥",
      "s": 7
    },
    {
      "t": "ਸਭੈ ਸਾਧ ਹਰਖੇ ॥",
      "s": 7
    },
    {
      "t": "ਭਏ ਜੀਤ ਕਰਖੇ ॥",
      "s": 7
    },
    {
      "t": "ਕਰੈ ਦੇਵ ਅਰਚਾ ॥",
      "s": 7
    },
    {
      "t": "ਰਰੈ ਬੇਦ ਚਰਚਾ ॥੯੪॥",
      "s": 7
    },
    {
      "t": "ਭਯੋ ਜਗ ਪੂਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਗਏ ਪਾਪ ਦੂਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਸੁਰੰ ਸਰਬ ਹਰਖੇ ॥",
      "s": 7
    },
    {
      "t": "ਧਨੰਧਾਰ ਬਰਖੇ ॥੯੫॥",
      "s": 7
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਰਾਮਾਵਤਾਰੇ ਕਥਾ ਸੁਬਾਹ ਮਰੀਚ ਬਧਹ ਜਗਯ ਸੰਪੂਰਨ ਕਰਨੰ ਸਮਾਪਤਮ ॥",
      "s": 7
    },
    {
      "t": "ਅਥ ਸੀਤਾ ਸੁਯੰਬਰ ਕਥਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਰਸਾਵਲ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਰਚਯੋ ਸੁਯੰਬਰ ਸੀਤਾ ॥",
      "s": 7
    },
    {
      "t": "ਮਹਾ ਸੁਧ ਗੀਤਾ ॥",
      "s": 7
    },
    {
      "t": "ਬਿਧੰ ਚਾਰ ਬੈਣੀ ॥",
      "s": 7
    },
    {
      "t": "ਮ੍ਰਿਗੀ ਰਾਜ ਨੈਣੀ ॥੯੬॥",
      "s": 7
    },
    {
      "t": "ਸੁਣਯੋ ਮੋਨਨੇਸੰ ॥",
      "s": 7
    },
    {
      "t": "ਚਤੁਰ ਚਾਰ ਦੇਸੰ ॥",
      "s": 7
    },
    {
      "t": "ਲਯੋ ਸੰਗ ਰਾਮੰ ॥",
      "s": 7
    },
    {
      "t": "ਚਲਯੋ ਧਰਮ ਧਾਮੰ ॥੯੭॥",
      "s": 7
    },
    {
      "t": "ਸੁਨੋ ਰਾਮ ਪਿਆਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਚਲੋ ਸਾਥ ਹਮਾਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਸੀਆ ਸੁਯੰਬਰ ਕੀਨੋ ॥",
      "s": 7
    },
    {
      "t": "ਨ੍ਰਿਪੰ ਬੋਲ ਲੀਨੋ ॥੯੮॥",
      "s": 7
    },
    {
      "t": "ਤਹਾ ਪ੍ਰਾਤ ਜਈਐ ॥",
      "s": 7
    },
    {
      "t": "ਸੀਆ ਜੀਤ ਲਈਐ ॥",
      "s": 7
    },
    {
      "t": "ਕਹੀ ਮਾਨ ਮੇਰੀ ॥",
      "s": 7
    },
    {
      "t": "ਬਨੀ ਬਾਤ ਤੇਰੀ ॥੯੯॥",
      "s": 7
    },
    {
      "t": "ਬਲੀ ਪਾਨ ਬਾਕੇ ॥",
      "s": 7
    },
    {
      "t": "ਨਿਪਾਤੋ ਪਿਨਾਕੇ ॥",
      "s": 7
    },
    {
      "t": "ਸੀਆ ਜੀਤ ਆਨੋ ॥",
      "s": 7
    },
    {
      "t": "ਹਨੋ ਸਰਬ ਦਾਨੋ ॥੧੦੦॥",
      "s": 7
    },
    {
      "t": "ਚਲੇ ਰਾਮ ਸੰਗੰ ॥",
      "s": 7
    },
    {
      "t": "ਸੁਹਾਏ ਨਿਖੰਗੰ ॥",
      "s": 7
    },
    {
      "t": "ਭਏ ਜਾਇ ਠਾਢੇ ॥",
      "s": 7
    },
    {
      "t": "ਮਹਾ ਮੋਦ ਬਾਢੇ ॥੧੦੧॥",
      "s": 7
    },
    {
      "t": "ਪੁਰੰ ਨਾਰ ਦੇਖੈ ॥",
      "s": 7
    },
    {
      "t": "ਸਹੀ ਕਾਮ ਲੇਖੈ ॥",
      "s": 7
    },
    {
      "t": "ਰਿਪੰ ਸਤ੍ਰੁ ਜਾਨੈ ॥",
      "s": 7
    },
    {
      "t": "ਸਿਧੰ ਸਾਧ ਮਾਨੈ ॥੧੦੨॥",
      "s": 7
    },
    {
      "t": "ਸਿਸੰ ਬਾਲ ਰੂਪੰ ॥",
      "s": 7
    },
    {
      "t": "ਲਹਯੋ ਭੂਪ ਭੂਪੰ ॥",
      "s": 7
