{
  "page": 223,
  "lines": [
    {
      "t": "ਅਭਿੰਨ ਭਿੰਨੇ ਅਡੰਡ ਡਾਡੇ ॥",
      "s": 7
    },
    {
      "t": "ਅਕਿਤ ਕਿਤੇ ਅਮੁੰਡ ਮਾਡੇ ॥੨੨੭॥",
      "s": 7
    },
    {
      "t": "ਅਛਿਦ ਛਿਦੇ ਅਦਗ ਦਾਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਅਚੋਰ ਚੋਰੇ ਅਠਗ ਠਾਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਅਭਿਦ ਭਿਦੇ ਅਫੋੜ ਫੋੜੇ ॥",
      "s": 7
    },
    {
      "t": "ਅਕਜ ਕਜੇ ਅਜੋੜ ਜੋੜੇ ॥੨੨੮॥",
      "s": 7
    },
    {
      "t": "ਅਦਗ ਦਗੇ ਅਮੋੜ ਮੋੜੇ ॥",
      "s": 7
    },
    {
      "t": "ਅਖਿਚ ਖਿਚੇ ਅਜੋੜ ਜੋੜੇ ॥",
      "s": 7
    },
    {
      "t": "ਅਕਢ ਕਢੇ ਅਸਾਧ ਸਾਧੇ ॥",
      "s": 7
    },
    {
      "t": "ਅਫਟ ਫਟੇ ਅਫਾਧ ਫਾਧੇ ॥੨੨੯॥",
      "s": 7
    },
    {
      "t": "ਅਧੰਧ ਧੰਧੇ ਅਕਜ ਕਜੇ ॥",
      "s": 7
    },
    {
      "t": "ਅਭਿੰਨ ਭਿੰਨੇ ਅਭਜ ਭਜੇ ॥",
      "s": 7
    },
    {
      "t": "ਅਛੇੜ ਛੇੜੇ ਅਲਧ ਲਧੇ ॥",
      "s": 7
    },
    {
      "t": "ਅਜਿਤ ਜਿਤੇ ਅਬਧ ਬਧੇ ॥੨੩੦॥",
      "s": 7
    },
    {
      "t": "ਅਚੀਰ ਚੀਰ ਅਤੋੜ ਤਾੜੇ ॥",
      "s": 7
    },
    {
      "t": "ਅਠਟ ਠਟੇ ਅਪਾੜ ਪਾੜੇ ॥",
      "s": 7
    },
    {
      "t": "ਅਧਕ ਧਕੇ ਅਪੰਗ ਪੰਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਅਜੁਧ ਜੁਧੇ ਅਜੰਗ ਜੰਗੇ ॥੨੩੧॥",
      "s": 7
    },
    {
      "t": "ਅਕੁਟ ਕੁਟੇ ਅਘੁਟ ਘਾਏ ॥",
      "s": 7
    },
    {
      "t": "ਅਚੂਰ ਚੂਰੇ ਅਦਾਵ ਦਾਏ ॥",
      "s": 7
    },
    {
      "t": "ਅਭੀਰ ਭੀਰੇ ਅਭੰਗ ਭੰਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਅਟੁਕ ਟੁਕੇ ਅਕੰਗ ਕੰਗੇ ॥੨੩੨॥",
      "s": 7
    },
    {
      "t": "ਅਖਿਦ ਖੇਦੇ ਅਢਾਹ ਢਾਹੇ ॥",
      "s": 7
    },
    {
      "t": "ਅਗੰਜ ਗੰਜੇ ਅਬਾਹ ਬਾਹੇ ॥",
      "s": 7
    }
  ]
}
