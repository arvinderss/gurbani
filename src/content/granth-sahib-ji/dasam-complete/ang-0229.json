          2,
          1
        ],
        [
          3,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਮੈ ਅਤਿ ਦੀਨ ਮਲੀਨ ਬਿਨਾ ਗਤ ॥",
      "s": 7
    },
    {
      "t": "ਰਾਖ ਲੈ ਰਾਜ ਬਿਖੈ ਚਰਨਾਮ੍ਰਿਤ ॥੨੮੭॥",
      "s": 7
    },
    {
      "t": "ਚਛ ਬਿਹੀਨ ਸੁਪਛ ਜਿਮੰ ਕਰ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਉ ਪ੍ਰਭ ਤੀਰ ਗਿਰਯੋ ਪਗ ਭਰਥਰ ॥",
      "s": 7
    },
    {
      "t": "ਅੰਕ ਰਹੇ ਗਹ ਰਾਮ ਤਿਸੈ ਤਬ ॥",
      "s": 7
    },
    {
      "t": "ਰੋਇ ਮਿਲੇ ਲਛਨਾਦਿ ਭਯਾ ਸਭ ॥੨੮੮॥",
      "s": 7
    },
    {
      "t": "ਪਾਨਿ ਪੀਆਇ ਜਗਾਇ ਸੁ ਬੀਰਹ ॥",
      "s": 7
    },
    {
      "t": "ਫੇਰਿ ਕਹਯੋ ਹਸ ਸ੍ਰੀ ਰਘੁਬੀਰਹ ॥",
      "s": 7
    },
    {
      "t": "ਤ੍ਰਿਯੋਦਸ ਬਰਖ ਗਏ ਫਿਰਿ ਐਹੈ ॥",
      "s": 7
    },
    {
      "t": "ਜਾਹੁ ਹਮੈ ਕਛੁ ਕਾਜ ਕਿਵੈਹੈ ॥੨੮੯॥",
      "s": 7
    },
    {
