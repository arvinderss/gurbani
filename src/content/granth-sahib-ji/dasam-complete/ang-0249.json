{
  "page": 249,
  "lines": [
    {
      "t": "ਵਜੇ ਸੰਗਲੀਆਲੇ ਹਾਠਾ ਜੁਟੀਆਂ ॥",
      "s": 7
    },
    {
      "t": "ਖੇਤ ਬਹੇ ਮੁਛਾਲੇ ਕਹਰ ਤਤਾਰਚੇ ॥",
      "s": 7
    },
    {
      "t": "ਡਿਗੇ ਵੀਰ ਜੁਝਾਰੇ ਹੂੰਗਾ ਫੁਟੀਆਂ ॥",
      "s": 7
    },
    {
      "t": "ਬਕੇ ਜਾਣ ਮਤਵਾਲੇ ਭੰਗਾ ਖਾਇ ਕੈ ॥੪੬੮॥",
      "s": 7
    },
    {
      "t": "ਓਰੜਏ ਹੰਕਾਰੀ ਧਗਾ ਵਾਇ ਕੈ ॥",
      "s": 7
    },
    {
      "t": "ਵਾਹਿ ਫਿਰੇ ਤਰਵਾਰੀ ਸੂਰੇ ਸੂਰਿਆਂ ॥",
      "s": 7
    },
    {
      "t": "ਵਗੈ ਰਤੁ ਝੁਲਾਰੀ ਝਾੜੀ ਕੈਬਰੀ ॥",
      "s": 7
    },
    {
      "t": "ਪਾਈ ਧੂੰਮ ਲੁਝਾਰੀ ਰਾਵਣ ਰਾਮ ਦੀ ॥੪੬੯॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਚੋਬੀ ਧਉਸ ਵਜਾਈ ਸੰਘੁਰ ਮਚਿਆ ॥",
      "s": 7
    },
    {
      "t": "ਬਾਹਿ ਫਿਰੈ ਵੈਰਾਈ ਤੁਰੇ ਤਤਾਰਚੇ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਹੂਰਾ ਚਿਤ ਵਧਾਈ ਅੰਬਰ ਪੂਰਿਆ ॥",
      "s": 7
    },
    {
      "t": "ਜੋਧਿਯਾ ਦੇਖਣ ਤਾਈ ਹੂਲੇ ਹੋਈਆਂ ॥੪੭੦॥",
      "s": 7
    },
    {
      "t": "ਪਾਧੜੀ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਇੰਦ੍ਰਾਰ ਵੀਰ ਕੁਪਯੋ ਕਰਾਲ ॥",
      "s": 7
    },
    {
      "t": "ਮੁਕਤੰਤ ਬਾਣ ਗਹਿ ਧਨੁ ਬਿਸਾਲ ॥",
      "s": 7
    },
    {
      "t": "ਥਰਕੰਤ ਲੁਥ ਫਰਕੰਤ ਬਾਹ ॥",
      "s": 7
    },
    {
      "t": "ਜੁਝੰਤ ਸੂਰ ਅਛਰੈ ਉਛਾਹ ॥੪੭੧॥",
      "s": 7
    },
    {
      "t": "ਚਮਕੰਤ ਚਕ੍ਰ ਸਰਖੰਤ ਸੇਲ ॥",
      "s": 7
    },
    {
      "t": "ਜੁਮੇ ਜਟਾਲ ਜਣ ਗੰਗ ਮੇਲ ॥",
      "s": 7
    },
    {
      "t": "ਸੰਘਰੇ ਸੂਰ ਆਘਾਇ ਘਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਬਰਖੰਤ ਬਾਣ ਚੜ ਚਉਪ ਚਾਇ ॥੪੭੨॥",
      "s": 7
    },
    {
      "t": "ਸਮੁਲੇ ਸੂਰ ਆਰੁਹੇ ਜੰਗ ॥",
      "s": 7
    },
    {
      "t": "ਬਰਖੰਤ ਬਾਣ ਬਿਖ ਧਰ ਸੁਰੰਗ ॥",
      "s": 7
    },
    {
      "t": "ਨਭਿ ਹ੍ਵੈ ਅਲੋਪ ਸਰ ਬਰਖ ਧਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਸਭ ਊਚ ਨੀਚ ਕਿੰਨੇ ਸੁਮਾਰ ॥੪੭੩॥",
      "s": 7
    },
    {
      "t": "ਸਭ ਸਸਤ੍ਰ ਅਸਤ੍ਰ ਬਿਦਿਆ ਪ੍ਰਬੀਨ ॥",
      "s": 7
    },
    {
      "t": "ਸਰ ਧਾਰ ਬਰਖ ਸਰਦਾਰ ਚੀਨ ॥",
      "s": 7
    },
    {
      "t": "ਰਘੁਰਾਜ ਆਦਿ ਮੋਹੇ ਸੁ ਬੀਰ ॥",
      "s": 7
    },
    {
      "t": "ਦਲ ਸਹਿਤ ਭੂਮ ਡਿਗੇ ਅਧੀਰ ॥੪੭੪॥",
      "s": 7
    },
    {
      "t": "ਤਬ ਕਹੀ ਦੂਤ ਰਾਵਣਹਿ ਜਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਕਪਿ ਕਟਕ ਆਜੁ ਜੀਤਯੋ ਬਨਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਸੀਅ ਭਜਹੁ ਆਜੁ ਹੁਐ ਕੈ ਨਿਚੀਤ ॥",
      "s": 7
    },
    {
      "t": "ਸੰਘਰੇ ਰਾਮ ਰਣ ਇੰਦ੍ਰਜੀਤ ॥੪੭੫॥",
      "s": 7
    },
    {
      "t": "ਤਬ ਕਹੇ ਬੈਣ ਤ੍ਰਿਜਟੀ ਬੁਲਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਰਣ ਮ੍ਰਿਤਕ ਰਾਮ ਸੀਤਹਿ ਦਿਖਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਲੈ ਗਈ ਨਾਥ ਜਹਿ ਗਿਰੇ ਖੇਤ ॥",
      "s": 7
    },
    {
      "t": "ਮ੍ਰਿਗ ਮਾਰ ਸਿੰਘ ਜਯੋ ਸੁਪਤ ਅਚੇਤ ॥੪੭੬॥",
      "s": 7
    },
    {
      "t": "ਸੀਅ ਨਿਰਖ ਨਾਥ ਮਨ ਮਹਿ ਰਿਸਾਨ ॥",
      "s": 7
    },
    {
      "t": "ਦਸ ਅਉਰ ਚਾਰ ਬਿਦਿਆ ਨਿਧਾਨ ॥",
      "s": 7
    },
    {
      "t": "ਪੜ ਨਾਗ ਮੰਤ੍ਰ ਸੰਘਰੀ ਪਾਸ ॥",
      "s": 7
    },
    {
      "t": "ਪਤਿ ਭ੍ਰਾਤ ਜਯਾਇ ਚਿਤ ਭਯੋ ਹੁਲਾਸ ॥੪੭੭॥",
      "s": 7
    },
    {
      "t": "ਸੀਅ ਗਈ ਜਗੇ ਅੰਗਰਾਇ ਰਾਮ ॥",
      "s": 7
    },
    {
      "t": "ਦਲ ਸਹਿਤ ਭ੍ਰਾਤ ਜੁਤ ਧਰਮ ਧਾਮ ॥",
      "s": 7
    },
    {
      "t": "ਬਜੇ ਸੁ ਨਾਦਿ ਗਜੇ ਸੁ ਬੀਰ ॥",
      "s": 7
    },
    {
      "t": "ਸਜੇ ਹਥਿਯਾਰ ਭਜੇ ਅਧੀਰ ॥੪੭੮॥",
      "s": 7
    },
    {
      "t": "ਸੰਮੁਲੇ ਸੂਰ ਸਰ ਬਰਖ ਜੁਧ ॥",
      "s": 7
    },
    {
      "t": "ਹਨ ਸਾਲ ਤਾਲ ਬਿਕ੍ਰਾਲ ਕ੍ਰੂਧ ॥",
      "s": 7
    },
    {
      "t": "ਤਜਿ ਜੁਧ ਸੁਧ ਸੁਰ ਮੇਘ ਧਰਣ ॥",
      "s": 7
    }
  ]
}
