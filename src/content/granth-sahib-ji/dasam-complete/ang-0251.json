{
  "page": 251,
  "lines": [
    {
      "t": "ਰਾਗੜਦੰਗ ਰਾਮ ਸੈਨਾ ਸੁ ਕ੍ਰੁਧ ॥",
      "s": 7
    },
    {
      "t": "ਜਾਗੜਦੰਗ ਜ੍ਵਾਨ ਜੁਝੰਤ ਜੁਧ ॥",
      "s": 7
    },
    {
      "t": "ਨਾਗੜਦੰਗ ਨਿਸਾਣ ਨਵ ਸੈਨ ਸਾਜ ॥",
      "s": 7
    },
    {
      "t": "ਮਾਗੜਦੰਗ ਮੂੜ ਮਕਰਾਛ ਗਾਜ ॥੪੮੫॥",
      "s": 7
    },
    {
      "t": "ਆਗੜਦੰਗ ਏਕ ਅਤਕਾਇ ਵੀਰ ॥",
      "s": 7
    },
    {
      "t": "ਰਾਗੜਦੰਗ ਰੋਸ ਕੀਨੇ ਗਹੀਰ ॥",
      "s": 7
    },
    {
      "t": "ਆਗੜਦੰਗ ਏਕ ਹੁਕੇ ਅਨੇਕ ॥",
      "s": 7
    },
    {
      "t": "ਸਾਗੜਦੰਗ ਸਿੰਧ ਬੇਲਾ ਬਿਬੇਕ ॥੪੮੬॥",
      "s": 7
    },
    {
      "t": "ਤਾਗੜਦੰਗ ਤੀਰ ਛੁਟੈ ਅਪਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਬਾਗੜਦੰਗ ਬੂੰਦ ਬਨ ਦਲ ਅਨੁਚਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਆਗੜਦੰਗ ਅਰਬ ਟੀਡੀ ਪ੍ਰਮਾਨ ॥",
      "s": 7
    },
    {
      "t": "ਚਾਗੜਦੰਗ ਚਾਰ ਚੀਟੀ ਸਮਾਨ ॥੪੮੭॥",
      "s": 7
    },
    {
      "t": "ਬਾਗੜਦੰਗ ਬੀਰ ਬਾਹੁੜੇ ਨੇਖ ॥",
      "s": 7
    },
    {
      "t": "ਜਾਗੜਦੰਗ ਜੁਧ ਅਤਕਾਇ ਦੇਖ ॥",
      "s": 7
    },
    {
      "t": "ਦਾਗੜਦੰਗ ਦੇਵ ਜੈ ਜੈ ਕਹੰਤ ॥",
      "s": 7
    },
    {
      "t": "ਭਾਗੜਦੰਗ ਭੂਪ ਧਨ ਧਨ ਭਨੰਤ ॥੪੮੮॥",
      "s": 7
    },
    {
      "t": "ਕਾਗੜਦੰਗ ਕਹਕ ਕਾਲੀ ਕਰਾਲ ॥",
      "s": 7
    },
    {
      "t": "ਜਾਗੜਦੰਗ ਜੂਹ ਜੁਗਣ ਬਿਸਾਲ ॥",
      "s": 7
    },
    {
      "t": "ਭਾਗੜਦੰਗ ਭੂਤ ਭੈਰੋ ਅਨੰਤ ॥",
      "s": 7
    },
    {
      "t": "ਸਾਗੜਦੰਗ ਸ੍ਰੋਣ ਪਾਣੰ ਕਰੰਤ ॥੪੮੯॥",
      "s": 7
    },
    {
      "t": "ਡਾਗੜਦੰਗ ਡਉਰ ਡਾਕਣ ਡਹਕ ॥",
      "s": 7
    },
    {
      "t": "ਕਾਗੜਦੰਗ ਕ੍ਰੂਰ ਕਾਕੰ ਕਹਕ ॥",
      "s": 7
    },
    {
      "t": "ਚਾਗੜਦੰਗ ਚਤ੍ਰ ਚਾਵਡੀ ਚਿਕਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਭਾਗੜਦੰਗ ਭੂਤ ਡਾਰਤ ਧਮਾਰ ॥੪੯੦॥",
      "s": 7
    },
