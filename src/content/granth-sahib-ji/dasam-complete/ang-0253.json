  "lines": [
    {
      "t": "ਛਿਦੇ ਚਰਮੰ ॥",
      "s": 7
    },
    {
      "t": "ਤੁਟੈ ਖਗੰ ॥",
      "s": 7
    },
    {
      "t": "ਉਠੈ ਅੰਗੰ ॥੫੦੭॥",
      "s": 7
    },
    {
      "t": "ਨਚੇ ਤਾਜੀ ॥",
      "s": 7
    },
    {
      "t": "ਗਜੇ ਗਾਜੀ ॥",
      "s": 7
    },
    {
      "t": "ਡਿਗੇ ਵੀਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਤਜੇ ਤੀਰੰ ॥੫੦੮॥",
      "s": 7
    },
    {
      "t": "ਝੁਮੇਾਂ ਸੂਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਘੁਮੀ ਹੂਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਕਛੇ ਬਾਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਮਤੇ ਮਾਣੰ ॥੫੦੯॥",
      "s": 7
    },
    {
      "t": "ਪਾਧਰੀ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਤਹ ਭਯੋ ਘੋਰ ਆਹਵ ਅਪਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਰਣ ਭੂੰਮਿ ਝੂਮਿ ਜੁਝੇ ਜੁਝਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਇਤ ਰਾਮ ਭ੍ਰਾਤ ਅਤਕਾਇ ਉਤ ॥",
      "s": 7
    },
    {
      "t": "ਰਿਸ ਜੁਝ ਉਝਰੇ ਰਾਜ ਪੁਤ ॥੫੧੦॥",
      "s": 7
    },
    {
      "t": "ਤਬ ਰਾਮ ਭ੍ਰਾਤ ਅਤਿ ਕੀਨ ਰੋਸ ॥",
      "s": 7
    },
    {
      "t": "ਜਿਮ ਪਰਤ ਅਗਨ ਘ੍ਰਿਤ ਕਰਤ ਜੋਸ ॥",
      "s": 7
    },
    {
      "t": "ਗਹਿ ਬਾਣ ਪਾਣ ਤਜੇ ਅਨੰਤ ॥",
      "s": 7
    },
    {
      "t": "ਜਿਮ ਜੇਠ ਸੂਰ ਕਿਰਣੈ ਦੁਰੰਤ ॥੫੧੧॥",
      "s": 7
    },
    {
      "t": "ਬ੍ਰਣ ਆਪ ਮਧ ਬਾਹਤ ਅਨੇਕ ॥",
      "s": 7
    },
    {
      "t": "ਬਰਣੈ ਨ ਜਾਹਿ ਕਹਿ ਏਕ ਏਕ ॥",
      "s": 7
    },
    {
      "t": "ਉਝਰੇ ਵੀਰ ਜੁਝਣ ਜੁਝਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਜੈ ਸਬਦ ਦੇਵ ਭਾਖਤ ਪੁਕਾਰ ॥੫੧੨॥",
      "s": 7
    }
  ]
}
