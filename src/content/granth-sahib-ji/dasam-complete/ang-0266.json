{
  "page": 266,
  "lines": [
    {
      "t": "ਚਟਪਟ ਲਾਗੀ ਅਟਪਟ ਪਾਯੰ ॥",
      "s": 7
    },
    {
      "t": "ਨਰਬਰ ਨਿਰਖੇ ਰਘੁਬਰ ਰਾਯੰ ॥੬੨੭॥",
      "s": 7
    },
    {
      "t": "ਚਟਪਟ ਲੋਟੈਂ ਅਟਪਟ ਧਰਣੀ ॥",
      "s": 7
    },
    {
      "t": "ਕਸਿ ਕਸਿ ਰੋਵੈਂ ਬਰਨਰ ਬਰਣੀ ॥",
      "s": 7
    },
    {
      "t": "ਪਟਪਟ ਡਾਰੈਂ ਅਟਪਟ ਕੇਸੰ ॥",
      "s": 7
    },
    {
      "t": "ਬਟ ਹਰਿ ਕੂਕੈਂ ਨਟ ਵਰ ਭੇਸੰ ॥੬੨੮॥",
      "s": 7
    },
    {
      "t": "ਚਟਪਟ ਚੀਰੰ ਅਟਪਟ ਪਾਰੈਂ ॥",
      "s": 7
    },
    {
      "t": "ਧਰ ਕਰ ਧੂਮੰ ਸਰਬਰ ਡਾਰੈਂ ॥",
      "s": 7
    },
    {
      "t": "ਸਟਪਟ ਲੋਟੈਂ ਖਟਪਟ ਭੂਮੰ ॥",
      "s": 7
    },
    {
      "t": "ਝਟਪਟ ਝੂਰੈਂ ਘਰਹਰ ਘੂਮੰ ॥੬੨੯॥",
      "s": 7
    },
    {
      "t": "ਰਸਾਵਲ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਜਬੈ ਰਾਮ ਦੇਖੈ ॥",
      "s": 7
    },
    {
      "t": "ਮਹਾ ਰੂਪ ਲੇਖੈ ॥",
      "s": 7
    },
    {
      "t": "ਰਹੀ ਨਯਾਇ ਸੀਸੰ ॥",
      "s": 7
    },
    {
      "t": "ਸਭੈ ਨਾਰ ਈਸੰ ॥੬੩੦॥",
      "s": 7
    },
    {
      "t": "ਲਖੈਂ ਰੂਪ ਮੋਹੀ ॥",
      "s": 7
    },
    {
      "t": "ਫਿਰੀ ਰਾਮ ਦੇਹੀ ॥",
      "s": 7
    },
    {
      "t": "ਦਈ ਤਾਹਿ ਲੰਕਾ ॥",
      "s": 7
    },
    {
      "t": "ਜਿਮੰ ਰਾਜ ਟੰਕਾ ॥੬੩੧॥",
      "s": 7
    },
    {
      "t": "ਕ੍ਰਿਪਾ ਦ੍ਰਿਸਟ ਭੀਨੇ ॥",
      "s": 7
    },
    {
      "t": "ਤਰੇ ਨੇਤ੍ਰ ਕੀਨੇ ॥",
      "s": 7
    },
    {
      "t": "ਝਰੈ ਬਾਰ ਐਸੇ ॥",
      "s": 7
    },
    {
      "t": "ਮਹਾ ਮੇਘ ਜੈਸੇ ॥੬੩੨॥",
      "s": 7
    },
    {
      "t": "ਛਕੀ ਪੇਖ ਨਾਰੀ ॥",
      "s": 7
    },
    {
      "t": "ਸਰੰ ਕਾਮ ਮਾਰੀ ॥",
      "s": 7
    },
    {
      "t": "ਬਿਧੀ ਰੂਪ ਰਾਮੰ ॥",
      "s": 7
    },
    {
      "t": "ਮਹਾ ਧਰਮ ਧਾਮੰ ॥੬੩੩॥",
      "s": 7
    },
    {
      "t": "ਤਜੀ ਨਾਥ ਪ੍ਰੀਤੰ ॥",
      "s": 7
    },
    {
      "t": "ਚੁਭੇ ਰਾਮ ਚੀਤੰ ॥",
      "s": 7
    },
    {
      "t": "ਰਹੀ ਜੋਰ ਨੈਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਕਹੈਂ ਮਦ ਬੈਣੰ ॥੬੩੪॥",
      "s": 7
    },
    {
      "t": "ਸੀਆ ਨਾਥ ਨੀਕੇ ॥",
      "s": 7
    },
    {
      "t": "ਹਰੈਂ ਹਾਰ ਜੀਕੇ ॥",
      "s": 7
    },
    {
      "t": "ਲਏ ਜਾਤ ਚਿਤੰ ॥",
      "s": 7
    },
    {
      "t": "ਮਨੋ ਚੋਰ ਬਿਤੰ ॥੬੩੫॥",
      "s": 7
    },
    {
      "t": "ਸਭੈ ਪਾਇ ਲਾਗੋ ॥",
      "s": 7
    },
    {
      "t": "ਪਤੰ ਦ੍ਰੋਹ ਤਯਾਗੋ ॥",
      "s": 7
    },
    {
      "t": "ਲਗੀ ਧਾਇ ਪਾਯੰ ॥",
      "s": 7
    },
    {
      "t": "ਸਭੈ ਨਾਰਿ ਆਯੰ ॥੬੩੬॥",
      "s": 7
    },
    {
      "t": "ਮਹਾ ਰੂਪ ਜਾਨੇ ॥",
      "s": 7
    },
    {
      "t": "ਚਿਤੰ ਚੋਰ ਮਾਨੇ ॥",
      "s": 7
    },
    {
      "t": "ਚੁਭੇ ਚਿਤ੍ਰ ਐਸੇ ॥",
      "s": 7
    },
    {
      "t": "ਸਿਤੰ ਸਾਇ ਕੈਸੇ ॥੬੩੭॥",
      "s": 7
    },
    {
      "t": "ਲਗੋ ਹੇਮ ਰੂਪੰ ॥",
      "s": 7
    },
    {
      "t": "ਸਭੈ ਭੂਪ ਭੂਪੰ ॥",
      "s": 7
    },
    {
      "t": "ਰੰਗੇ ਰੰਗ ਨੈਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਛਕੇ ਦੇਵ ਗੈਣੰ ॥੬੩੮॥",
      "s": 7
    },
    {
      "t": "ਜਿਨੈ ਏਕ ਬਾਰੰ ॥",
      "s": 7
    }
  ]
