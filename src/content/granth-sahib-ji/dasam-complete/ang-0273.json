{
  "page": 273,
  "lines": [
    {
      "t": "ਭ੍ਰਿਗੰ ਅੰਗੁਰਾ ਬਿਆਸ ਤੇ ਲੈ ਬਿਸਿਸਟੰ ॥",
      "s": 7
    },
    {
      "t": "ਬਿਸ੍ਵਾਮਿਤ੍ਰ ਅਉ ਬਾਲਮੀਕੰ ਸੁ ਅਤ੍ਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਦੁਰਬਾਸਾ ਸਭੈ ਕਸਪ ਤੇ ਆਦ ਲੈ ਕੈ ॥੬੯੬॥",
      "s": 7
    },
    {
      "t": "ਜਭੈ ਰਾਮ ਦੇਖੈ ਸਭੈ ਬਿਪ ਆਏ ॥",
      "s": 7
    },
    {
      "t": "ਪਰਯੋ ਧਾਇ ਪਾਯੰ ਸੀਆ ਨਾਥ ਜਗਤੰ ॥",
      "s": 7
    },
    {
      "t": "ਦਯੋ ਆਸਨੰ ਅਰਘੁ ਪਾਦ ਰਘੁ ਤੇਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਦਈ ਆਸਿਖੰ ਮੌਨਨੇਸੰ ਪ੍ਰਸਿੰਨਯੰ ॥੬੯੭॥",
      "s": 7
    },
    {
      "t": "ਭਈ ਰਿਖ ਰਾਮੰ ਬਡੀ ਗਿਆਨ ਚਰਚਾ ॥",
      "s": 7
    },
    {
      "t": "ਕਹੋ ਸਰਬ ਜੌਪੈ ਬਢੈ ਏਕ ਗ੍ਰੰਥਾ ॥",
      "s": 7
    },
    {
      "t": "ਬਿਦਾ ਬਿਪ੍ਰ ਕੀਨੇ ਘਨੀ ਦਛਨਾ ਦੈ ॥",
      "s": 7
    },
    {
      "t": "ਚਲੇ ਦੇਸ ਦੇਸੰ ਮਹਾ ਚਿਤ ਹਰਖੰ ॥੬੯੮॥",
      "s": 7
    },
    {
      "t": "ਇਹੀ ਬੀਚ ਆਯੋ ਮ੍ਰਿਤੰ ਸੂਨ ਬਿਪੰ ॥",
      "s": 7
    },
    {
      "t": "ਜੀਐ ਬਾਲ ਆਜੈ ਨਹੀ ਤੋਹਿ ਸ੍ਰਾਪੰ ॥",
      "s": 7
    },
    {
      "t": "ਸਭੈ ਰਾਮ ਜਾਨੀ ਚਿਤੰ ਤਾਹਿ ਬਾਤਾ ॥",
      "s": 7
    },
    {
      "t": "ਦਿਸੰ ਬਾਰਣੀ ਤੇ ਬਿਬਾਣੰ ਹਕਾਰਯੋ ॥੬੯੯॥",
      "s": 7
    },
    {
      "t": "ਹੁਤੋ ਏਕ ਸੂਦ੍ਰੰ ਦਿਸਾ ਉਤ੍ਰ ਮਧੰ ॥",
      "s": 7
    },
    {
      "t": "ਝੁਲੈ ਕੂਪ ਮਧੰ ਪਰਯੋ ਔਧ ਮੁਖੰ ॥",
      "s": 7
    },
    {
      "t": "ਮਹਾ ਉਗ੍ਰ ਤੇ ਜਾਪ ਪਸਯਾਤ ਉਗ੍ਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਹਨਯੋ ਤਾਹਿ ਰਾਮੰ ਅਸੰ ਆਪ ਹਥੰ ॥੭੦੦॥",
      "s": 7
    },
    {
      "t": "ਜੀਯੋ ਬ੍ਰਹਮ ਪੁਤ੍ਰੰ ਹਰਯੋ ਬ੍ਰਹਮ ਸੋਗੰ ॥",
      "s": 7
    },
    {
      "t": "ਬਢੀ ਕੀਰਤ ਰਾਮੰ ਚਤੁਰ ਕੁੰਟ ਮਧੰ ॥",
      "s": 7
    },
    {
      "t": "ਕਰਯੋ ਦਸ ਸਹੰਸ੍ਰ ਲਉ ਰਾਜ ਅਉਧੰ ॥",
      "s": 7
    },
    {
      "t": "ਫਿਰੀ ਚਕ੍ਰ ਚਾਰੋ ਬਿਖੈ ਰਾਮ ਦੋਹੀ ॥੭੦੧॥",
      "s": 7
    },
    {
      "t": "ਜਿਣੇ ਦੇਸ ਦੇਸੰ ਨਰੇਸੰ ਤ ਰਾਮੰ ॥",
      "s": 7
    },
    {
      "t": "ਮਹਾ ਜੁਧ ਜੇਤਾ ਤਿਹੂੰ ਲੋਕ ਜਾਨਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਦਯੋ ਮੰਤ੍ਰੀ ਅਤ੍ਰੰ ਮਹਾਭ੍ਰਾਤ ਭਰਥੰ ॥",
      "s": 7
    },
    {
      "t": "ਕੀਯੋ ਸੈਨ ਨਾਥੰ ਸੁਮਿਤ੍ਰਾ ਕੁਮਾਰੰ ॥੭੦੨॥",
      "s": 7
    },
    {
      "t": "ਮ੍ਰਿਤਗਤ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਸੁਮਤਿ ਮਹਾ ਰਿਖ ਰਘੁਬਰ ॥",
      "s": 7
    },
    {
      "t": "ਦੁੰਦਭ ਬਾਜਤਿ ਦਰ ਦਰ ॥",
      "s": 7
    },
    {
      "t": "ਜਗ ਕੀਅਸ ਧੁਨ ਘਰ ਘਰ ॥",
      "s": 7
    },
    {
      "t": "ਪੂਰ ਰਹੀ ਧੁਨ ਸੁਰਪੁਰ ॥੭੦੩॥",
      "s": 7
    },
    {
      "t": "ਸੁਢਰ ਮਹਾ ਰਘੁਨੰਦਨ ॥",
      "s": 7
    },
    {
      "t": "ਜਗਪਤ ਮੁਨ ਗਨ ਬੰਦਨ ॥",
      "s": 7
    },
    {
      "t": "ਧਰਧਰ ਲੌ ਨਰ ਚੀਨੇ ॥",
      "s": 7
    },
    {
      "t": "ਸੁਖ ਦੈ ਦੁਖ ਬਿਨ ਕੀਨੇ ॥੭੦੪॥",
      "s": 7
    },
    {
      "t": "ਅਰ ਹਰ ਨਰ ਕਰ ਜਾਨੇ ॥",
      "s": 7
    },
    {
      "t": "ਦੁਖ ਹਰ ਸੁਖ ਕਰ ਮਾਨੇ ॥",
      "s": 7
    },
    {
      "t": "ਪੁਰ ਧਰ ਨਰ ਬਰਸੇ ਹੈ ॥",
      "s": 7
    },
    {
      "t": "ਰੂਪ ਅਨੂਪ ਅਭੈ ਹੈ ॥੭੦੫॥",
      "s": 7
    },
    {
      "t": "ਅਨਕਾ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਪ੍ਰਭੂ ਹੈ ॥",
      "s": 7
    },
    {
      "t": "ਅਜੂ ਹੈ ॥",
      "s": 7
    },
    {
      "t": "ਅਜੈ ਹੈ ॥",
      "s": 7
    },
    {
      "t": "ਅਭੈ ਹੈ ॥੭੦੬॥",
      "s": 7
    },
    {
      "t": "ਅਜਾ ਹੈ ॥",
      "s": 7
    },
    {
      "t": "ਅਤਾ ਹੈ ॥",
      "s": 7
    },
    {
      "t": "ਅਲੈ ਹੈ ॥",
      "s": 7
    }
  ]
}
