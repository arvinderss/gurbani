    {
      "t": "ਰਿਪੰ ਤਾਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਹਣਯੋ ਭਾਲੰ ॥",
      "s": 7
    },
    {
      "t": "ਗਿਰਯੋ ਤਾਲੰ ॥੭੭੦॥",
      "s": 7
    },
    {
      "t": "ਇਤਿ ਲਛਮਨ ਬਧਹਿ ਸਮਾਪਤੰ ॥",
      "s": 7
    },
    {
      "t": "ਅਥ ਭਰਥ ਜੁਧ ਕਥਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਅੜੂਹਾ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਭਾਗ ਗਯੋ ਦਲ ਤ੍ਰਾਮ ਕੈ ਕੈ ॥",
      "s": 7
    },
    {
      "t": "ਲਛਮਣੰ ਰਣ ਭੂਮ ਦੈ ਕੈ ॥",
      "s": 7
    },
    {
      "t": "ਖਲੇ ਰਾਮਚੰਦ ਹੁਤੇ ਜਹਾ ॥",
      "s": 7
    },
    {
      "t": "ਭਟ ਭਾਜ ਭਗ ਲਗੇ ਤਹਾ ॥੭੭੧॥",
      "s": 7
    },
    {
      "t": "ਜਬ ਜਾਇ ਬਾਤ ਕਹੀ ਉਨੈ ॥",
      "s": 7
    },
    {
      "t": "ਬਹੁ ਭਾਤ ਸੋਕ ਦਯੋ ਤਿਨੈ ॥",
      "s": 7
    },
    {
      "t": "ਸੁਨਿ ਬੈਨ ਮੋਨ ਰਹੈ ਬਲੀ ॥",
      "s": 7
    },
    {
      "t": "ਜਨ ਚਿਤ੍ਰ ਪਾਹਨ ਕੀ ਖਲੀ ॥੭੭੨॥",
      "s": 7
    },
    {
      "t": "ਪੁਨ ਬੈਠ ਮੰਤ੍ਰ ਬਿਚਾਰਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਤੁਮ ਜਾਹੁ ਭਰਥ ਉਚਾਰਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਮੁਨ ਬਾਲ ਦ੍ਵੈ ਜਿਨ ਮਾਰੀਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਧਰਿ ਆਨ ਮੋਹਿ ਦਿਖਾਰੀਯੋ ॥੭੭੩॥",
      "s": 7
    },
    {
      "t": "ਸਜ ਸੈਨ ਭਰਥ ਚਲੇ ਤਹਾ ॥",
      "s": 7
    },
    {
      "t": "ਰਣ ਬਾਲ ਬੀਰ ਮੰਡੇ ਜਹਾ ॥",
      "s": 7
    },
    {
      "t": "ਬਹੁ ਭਾਤ ਬੀਰ ਸੰਘਾਰਹੀ ॥",
      "s": 7
    },
    {
      "t": "ਸਰ ਓਘ ਪ੍ਰਓਘ ਪ੍ਰਹਾਰਹੀ ॥੭੭੪॥",
      "s": 7
    },
    {
      "t": "ਸੁਗ੍ਰੀਵ ਔਰ ਭਭੀਛਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਹਨਵੰਤ ਅੰਗਦ ਰੀਛਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਬਹੁ ਭਾਤਿ ਸੈਨ ਬਨਾਇ ਕੈ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਨ ਪੈ ਚਲਯੋ ਸਮੁਹਾਇ ਕੈ ॥੭੭੫॥",
      "s": 7
    },
    {
      "t": "ਰਣ ਭੂਮਿ ਭਰਥ ਗਏ ਜਬੈ ॥",
      "s": 7
    },
    {
      "t": "ਮੁਨ ਬਾਲ ਦੋਇ ਲਖੇ ਤਬੈ ॥",
      "s": 7
    },
    {
      "t": "ਦੁਇ ਕਾਕ ਪਛਾ ਸੋਭਹੀ ॥",
      "s": 7
    },
    {
      "t": "ਲਖਿ ਦੇਵ ਦਾਨੋ ਲੋਭਹੀ ॥੭੭੬॥",
      "s": 7
    },
    {
      "t": "ਭਰਥ ਬਾਚ ਲਵ ਸੋ ॥",
      "s": 7
    },
    {
      "t": "ਅਕੜਾ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਮੁਨਿ ਬਾਲ ਛਾਡਹੁ ਗਰਬ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਮਿਲਿ ਆਨ ਮੋਹੂ ਸਰਬ ॥",
      "s": 7
    },
    {
      "t": "ਲੈ ਜਾਹਿ ਰਾਘਵ ਤੀਰ ॥",
      "s": 7
    },
    {
      "t": "ਤੁਹਿ ਨੈਕ ਦੈ ਕੈ ਚੀਰ ॥੭੭੭॥",
      "s": 7
    },
    {
      "t": "ਸੁਨਤੇ ਭਰੇ ਸਿਸ ਮਾਨ ॥",
      "s": 7
    },
    {
      "t": "ਕਰ ਕੋਪ ਤਾਨ ਕਮਾਨ ॥",
      "s": 7
    },
    {
      "t": "ਬਹੁ ਭਾਤਿ ਸਾਇਕ ਛੋਰਿ ॥",
      "s": 7
    },
    {
      "t": "ਜਨ ਅਭ੍ਰ ਸਾਵਣ ਓਰ ॥੭੭੮॥",
      "s": 7
    },
    {
