{
  "page": 287,
  "lines": [
    {
      "t": "ਭੂਮਿ ਮਧ ਕਰਮ ਕੀਏ ਅਨੇਕਾ ॥੮੩੨॥",
      "s": 7
    },
    {
      "t": "ਨਾਗਮੇਧ ਖਟ ਜਗ ਕਰਾਏ ॥",
      "s": 7
    },
    {
      "t": "ਜਉਨ ਕਰੇ ਜਨਮੇ ਜਯ ਪਾਏ ॥",
      "s": 7
    },
    {
      "t": "ਅਉਰੈ ਗਨਤ ਕਹਾ ਲਗ ਜਾਊਾਂ ॥",
      "s": 7
    },
    {
      "t": "ਗ੍ਰੰਥ ਬਢਨ ਤੇ ਹੀਏ ਡਰਾਊਾਂ ॥੮੩੩॥",
      "s": 7
    },
    {
      "t": "ਦਸ ਸਹੰਸ੍ਰ ਦਸ ਬਰਖ ਪ੍ਰਮਾਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਰਾਜ ਕਰਾ ਪੁਰ ਅਉਧ ਨਿਧਾਨਾ ॥",
      "s": 7
    },
    {
      "t": "ਤਬ ਲਉ ਕਾਲ ਦਸਾ ਨੀਅਰਾਈ ॥",
      "s": 7
    },
    {
      "t": "ਰਘੁਬਰ ਸਿਰਿ ਮ੍ਰਿਤ ਡੰਕ ਬਜਾਈ ॥੮੩੪॥",
      "s": 7
    },
    {
      "t": "ਨਮਸਕਾਰ ਤਿਹ ਬਿਬਿਧਿ ਪ੍ਰਕਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਜਿਨ ਜਗ ਜੀਤ ਕਰਯੋ ਬਸ ਸਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਸਭਹਨ ਸੀਸ ਡੰਕ ਤਿਹ ਬਾਜਾ ॥",
      "s": 7
    },
    {
      "t": "ਜੀਤ ਨ ਸਕਾ ਰੰਕ ਅਰੁ ਰਾਜਾ ॥੮੩੫॥",
      "s": 7
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਜੇ ਤਿਨ ਕੀ ਸਰਨੀ ਪਰੇ ਕਰ ਦੈ ਲਏ ਬਚਾਇ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਜੌ ਨਹੀ ਕੋਊ ਬਾਚਿਆ ਕਿਸਨ ਬਿਸਨ ਰਘੁਰਾਇ ॥੮੩੬॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਬਹੁ ਬਿਧਿ ਕਰੋ ਰਾਜ ਕੋ ਸਾਜਾ ॥",
      "s": 7
    },
    {
      "t": "ਦੇਸ ਦੇਸ ਕੇ ਜੀਤੇ ਰਾਜਾ ॥",
      "s": 7
    },
    {
      "t": "ਸਾਮ ਦਾਮ ਅਰੁ ਦੰਡ ਸਭੇਦਾ ॥",
      "s": 7
    },
    {
      "t": "ਜਿਹ ਬਿਧਿ ਹੁਤੀ ਸਾਸਨਾ ਬੇਦਾ ॥੮੩੭॥",
      "s": 7
    },
    {
      "t": "ਬਰਨ ਬਰਨ ਅਪਨੀ ਕ੍ਰਿਤ ਲਾਏ ॥",
      "s": 7
    },
    {
      "t": "ਚਾਰ ਚਾਰ ਹੀ ਬਰਨ ਚਲਾਏ ॥",
      "s": 7
    },
    {
      "t": "ਛਤ੍ਰੀ ਕਰੈਂ ਬਿਪ੍ਰ ਕੀ ਸੇਵਾ ॥",
      "s": 7
    }
  ]
}
