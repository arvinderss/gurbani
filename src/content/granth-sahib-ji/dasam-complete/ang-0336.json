{
  "page": 336,
  "lines": [
    {
      "t": "ਤੁਹੀ ਰਿਸਟਣੀ ਪੁਸਟਣੀ ਸਸਤ੍ਰਣੀ ਹੈ ॥",
      "s": 7
    },
    {
      "t": "ਤੁਹੀ ਕਸਟਣੀ ਹਰਤਨੀ ਅਸਤ੍ਰਣੀ ਹੈ ॥",
      "s": 7
    },
    {
      "t": "ਤੁਹੀ ਜੋਗ ਮਾਇਆ ਤੁਹੀ ਬਾਕ ਬਾਨੀ ॥",
      "s": 7
    },
    {
      "t": "ਤੁਹੀ ਅੰਬਿਕਾ ਜੰਭਹਾ ਰਾਜਧਾਨੀ ॥੪੨੪॥",
      "s": 7
    },
    {
      "t": "ਮਹਾ ਜੋਗ ਮਾਇਆ ਮਹਾ ਰਾਜਧਾਨੀ ॥",
      "s": 7
    },
    {
      "t": "ਭਵੀ ਭਾਵਨੀ ਭੂਤ ਭਬਿਅੰ ਭਵਾਨੀ ॥",
      "s": 7
    },
    {
      "t": "ਚਰੀ ਆਚਰਣੀ ਖੇਚਰਣੀ ਭੂਪਣੀ ਹੈ ॥",
      "s": 7
    },
    {
      "t": "ਮਹਾ ਬਾਹਣੀ ਆਪਨੀ ਰੂਪਣੀ ਹੈ ॥੪੨੫॥",
      "s": 7
    },
    {
      "t": "ਮਹਾ ਭੈਰਵੀ ਭੂਤਨੇਸਵਰੀ ਭਵਾਨੀ ॥",
      "s": 7
    },
    {
      "t": "ਭਵੀ ਭਾਵਨੀ ਭਬਿਯੰ ਕਾਲੀ ਕ੍ਰਿਪਾਨੀ ॥",
      "s": 7
    },
    {
      "t": "ਜਯਾ ਆਜਯਾ ਹਿੰਗੁਲਾ ਪਿੰਗੁਲਾ ਹੈ ॥",
      "s": 7
    },
    {
      "t": "ਸਿਵਾ ਸੀਤਲਾ ਮੰਗਲਾ ਤੋਤਲਾ ਹੈ ॥੪੨੬॥",
      "s": 7
    },
    {
      "t": "ਤੁਹੀ ਅਛਰਾ ਪਛਰਾ ਬੁਧਿ ਬ੍ਰਿਧਿਆ ॥",
      "s": 7
    },
    {
      "t": "ਤੁਹੀ ਭੈਰਵੀ ਭੂਪਣੀ ਸੁਧ ਸਿਧਿਆ ॥",
      "s": 7
    },
    {
      "t": "ਮਹਾ ਬਾਹਣੀ ਅਸਤ੍ਰਣੀ ਸਸਤ੍ਰ ਧਾਰੀ ॥",
      "s": 7
    },
    {
      "t": "ਤੁਹੀ ਤੀਰ ਤਰਵਾਰ ਕਾਤੀ ਕਟਾਰੀ ॥੪੨੭॥",
      "s": 7
    },
    {
      "t": "ਤੁਹੀ ਰਾਜਸੀ ਸਾਤਕੀ ਤਾਮਸੀ ਹੈ ॥",
      "s": 7
    },
    {
      "t": "ਤੁਹੀ ਬਾਲਕਾ ਬ੍ਰਿਧਣੀ ਅਉ ਜੁਆ ਹੈ ॥",
      "s": 7
    },
    {
      "t": "ਤੁਹੀ ਦਾਨਵੀ ਦੇਵਣੀ ਜਛਣੀ ਹੈ ॥",
      "s": 7
    },
    {
      "t": "ਤੁਹੀ ਕਿੰਨ੍ਰਣੀ ਮਛਣੀ ਕਛਣੀ ਹੈ ॥੪੨੮॥",
      "s": 7
    },
    {
      "t": "ਤੁਹੀ ਦੇਵਤੇ ਸੇਸਣੀ ਦਾਨੁ ਵੇਸਾ ॥",
      "s": 7
    },
    {
      "t": "ਸਰਹਿ ਬ੍ਰਿਸਟਣੀ ਹੈ ਤੁਹੀ ਅਸਤ੍ਰ ਭੇਸਾ ॥",
      "s": 7
    },
    {
      "t": "ਤੁਹੀ ਰਾਜ ਰਾਜੇਸਵਰੀ ਜੋਗ ਮਾਯਾ ॥",
      "s": 7
    },
    {
      "t": "ਮਹਾ ਮੋਹ ਸੋ ਚਉਦਹੂੰ ਲੋਕ ਛਾਯਾ ॥੪੨੯॥",
      "s": 7
    },
    {
      "t": "ਤੁਹੀ ਬ੍ਰਾਹਮੀ ਬੈਸਨਵੀ ਸ੍ਰੀ ਭਵਾਨੀ ॥",
      "s": 7
    },
    {
      "t": "ਤੁਹੀ ਬਾਸਵੀ ਈਸਵਰੀ ਕਾਰਤਿਕਿਆਨੀ ॥",
      "s": 7
    },
    {
      "t": "ਤੁਹੀ ਅੰਬਿਕਾ ਦੁਸਟਹਾ ਮੁੰਡਮਾਲੀ ॥",
      "s": 7
    },
    {
      "t": "ਤੁਹੀ ਕਸਟ ਹੰਤੀ ਕ੍ਰਿਪਾ ਕੈ ਕ੍ਰਿਪਾਨੀ ॥੪੩੦॥",
      "s": 7
    },
    {
      "t": "ਤੁਮੀ ਬਰਾਹਣੀ ਹ੍ਵੈ ਹਿਰਨਾਛ ਮਾਰਿਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਹਰੰਨਾਕਸੰ ਸਿੰਘਣੀ ਹ੍ਵੈ ਪਛਾਰਿਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਤੁਮੀ ਬਾਵਨੀ ਹ੍ਵੈ ਤਿਨੋ ਲੋਗ ਮਾਪੇ ॥",
      "s": 7
    },
    {
      "t": "ਤੁਮੀ ਦੇਵ ਦਾਨੋ ਕੀਏ ਜਛ ਥਾਪੇ ॥੪੩੧॥",
      "s": 7
    },
    {
      "t": "ਤੁਮੀ ਰਾਮ ਹ੍ਵੈ ਕੈ ਦਸਾਗ੍ਰੀਵ ਖੰਡਿਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਤੁਮੀ ਕ੍ਰਿਸਨ ਹ੍ਵੈ ਕੰਸ ਕੇਸੀ ਬਿਹੰਡਿਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਤੁਮੀ ਜਾਲਪਾ ਹੈ ਬਿੜਾਲਾਛ ਘਾਯੋ ॥",
      "s": 7
    },
    {
      "t": "ਤੁਮੀ ਸੁੰਭ ਨੈਸੁੰਭ ਦਾਨੋ ਖਪਾਯੋ ॥੪੩੨॥",
      "s": 7
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਦਾਸ ਜਾਨ ਕਰਿ ਦਾਸ ਪਰਿ ਕੀਜੈ ਕ੍ਰਿਪਾ ਅਪਾਰ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਆਪ ਹਾਥ ਦੈ ਰਾਖ ਮੁਹਿ ਮਨ ਕ੍ਰਮ ਬਚਨ ਬਿਚਾਰਿ ॥੪੩੩॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 7
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 7
    },
    {
      "t": "ਮੈ ਨ ਗਨੇਸਹਿ ਪ੍ਰਿਥਮ ਮਨਾਊ ॥",
      "s": 7
    },
    {
      "t": "ਕਿਸਨ ਬਿਸਨ ਕਬਹੂੰ ਨ ਧਿਆਊ ॥",
      "s": 7
    },
    {
      "t": "ਕਾਨਿ ਸੁਨੇ ਪਹਿਚਾਨ ਨ ਤਿਨ ਸੋ ॥",
