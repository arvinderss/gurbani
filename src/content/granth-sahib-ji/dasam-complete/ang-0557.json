    {
      "t": "ਸੁਕ੍ਰਿਤੰ ਤਜਿਹੈ ॥",
      "s": 7
    },
    {
      "t": "ਕੁਕ੍ਰਿਤੰ ਭਜਿ ਹੈ ॥੫੨॥",
      "s": 7
    },
    {
      "t": "ਭ੍ਰਮਣੰ ਭਰਿ ਹੈ ॥",
      "s": 7
    },
    {
      "t": "ਜਸ ਤੇ ਟਰਿ ਹੈ ॥੫੩॥",
      "s": 7
    },
    {
      "t": "ਕਰਿ ਹੈ ਕੁਕ੍ਰਿਤੰ ॥",
      "s": 7
    },
    {
      "t": "ਰਰਿ ਹੈ ਅਨ੍ਰਿਥੰ ॥੫੪॥",
      "s": 7
    },
    {
      "t": "ਜਪ ਹੈ ਅਜਪੰ ॥",
      "s": 7
    },
    {
      "t": "ਕੁਥਪੇਣ ਥਪੰ ॥੫੫॥",
      "s": 7
    },
    {
      "t": "ਸੋਮਰਾਜੀ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਸੁਨੈ ਦੇਸਿ ਦੇਸੰ ਮੁਨੰ ਪਾਪ ਕਰਮਾ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਚੁਨੈ ਜੂਠ ਕੂਠੰ ਸ੍ਰੁਤੰ ਛੋਰ ਧਰਮਾ ॥੫੬॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਤਜੈ ਧਰਮ ਨਾਰੀ ਤਕੈ ਪਾਪ ਨਾਰੰ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਮਹਾ ਰੂਪ ਪਾਪੀ ਕੁਵਿਤ੍ਰਾਧਿਕਾਰੰ ॥੫੭॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਕਰੈ ਨਿਤ ਅਨਰਥੰ ਸਮਰਥੰ ਨ ਏਤੀ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਕਰੈ ਪਾਪ ਤੇਤੋ ਪਰਾਲਬਧ ਜੇਤੀ ॥੫੮॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਨਏ ਨਿਤ ਮਤੰ ਉਠੈ ਏਕ ਏਕੰ ॥",
      "s": 7
    },
    {
      "t": "ਕਰੈ ਨਿੰਤ ਅਨਰਥੰ ਅਨੇਕੰ ਅਨੇਕੰ ॥੫੯॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 7
    },
    {
      "t": "ਪ੍ਰਿਯਾ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਦੁਖ ਦੰਦ ਹੈ ਸੁਖਕੰਦ ਜੀ ॥",
      "s": 7
    },
    {
      "t": "ਨਹੀ ਬੰਧ ਹੈ ਜਗਬੰਦ ਜੀ ॥੬੦॥",
      "s": 7
    },
    {
      "t": "ਨਹੀ ਬੇਦ ਬਾਕ ਪ੍ਰਮਾਨ ਹੈ ॥",
      "s": 7
    },
    {
      "t": "ਮਤ ਭਿੰਨ ਭਿੰਨ ਬਖਾਨ ਹੈ ॥੬੧॥",
      "s": 7
    },
    {
      "t": "ਨ ਕੁਰਾਨ ਕੋ ਮਤੁ ਲੇਹਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਨ ਪੁਰਾਨ ਦੇਖਨ ਦੇਹਗੇ ॥੬੨॥",
      "s": 7
    }
  ]
