{
  "page": 581,
  "lines": [
    {
      "t": "ਭਈਰਵ ਕਰਤ ਕਹੂੰ ਭਭਕਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਉਡਤ ਕਾਕ ਕੰਕੈ ਬਿਕਰਾਰਾ ॥੩੦੦॥",
      "s": 7
    },
    {
      "t": "ਬਾਜਤ ਢੋਲ ਮ੍ਰਿਦੰਗ ਨਗਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਤਾਲ ਉਪੰਗ ਬੇਣ ਬੰਕਾਰਾ ॥",
      "s": 7
    },
    {
      "t": "ਮੁਰਲੀ ਨਾਦ ਨਫੀਰੀ ਬਾਜੇ ॥",
      "s": 7
    },
    {
      "t": "ਭੀਰ ਭਯਾਨਕ ਹੁਐ ਤਜਿ ਭਾਜੇ ॥੩੦੧॥",
      "s": 7
    },
    {
      "t": "ਮਹਾ ਸੁਭਟ ਜੂਝੇ ਤਿਹ ਠਾਮਾ ॥",
      "s": 7
    },
    {
      "t": "ਖਰਭਰ ਪਰੀ ਇੰਦ੍ਰ ਕੇ ਧਾਮਾ ॥",
      "s": 7
    },
    {
      "t": "ਬੈਰਕ ਬਾਣ ਗਗਨ ਗਇਓ ਛਾਈ ॥",
      "s": 7
    },
    {
      "t": "ਉਠੈ ਘਟਾ ਸਾਵਣ ਜਨੁ ਆਈ ॥੩੦੨॥",
      "s": 7
    },
    {
      "t": "ਤੋਮਰ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਬਹੁ ਭਾਤਿ ਕੋਪੇ ਸਬੀਰ ॥",
      "s": 7
    },
    {
      "t": "ਧਨੁ ਤਾਨਿ ਤਿਆਗਤ ਤੀਰ ॥",
      "s": 7
    },
    {
      "t": "ਸਰ ਅੰਗਿ ਜਾਸੁ ਲਗੰਤ ॥",
      "s": 7
    },
    {
      "t": "ਭਟ ਸੁਰਗਿ ਬਾਸ ਕਰੰਤ ॥੩੦੩॥",
      "s": 7
    },
    {
      "t": "ਕਹੂੰ ਅੰਗ ਭੰਗ ਉਤੰਗ ॥",
      "s": 7
    },
    {
      "t": "ਕਹੂੰ ਤੀਰ ਤੇਗ ਸੁਰੰਗ ॥",
      "s": 7
    },
    {
      "t": "ਕਹੂੰ ਚਉਰ ਚੀਰ ਸੁਬਾਹ ॥",
      "s": 7
    },
    {
      "t": "ਕਹੂੰ ਸੁਧ ਸੇਲ ਸਨਾਹ ॥੩੦੪॥",
      "s": 7
    },
    {
      "t": "ਰਣਿ ਅੰਗ ਰੰਗਤ ਐਸ ॥",
      "s": 7
    },
    {
      "t": "ਜਨੁ ਫੁਲ ਕਿੰਸਕ ਜੈਸ ॥",
      "s": 7
    },
    {
      "t": "ਇਕ ਐਸ ਜੂਝ ਮਰੰਤ ॥",
      "s": 7
    },
    {
      "t": "ਜਨੁ ਖੇਲਿ ਫਾਗੁ ਬਸੰਤ ॥੩੦੫॥",
      "s": 7
    },
    {
      "t": "ਇਕ ਧਾਇ ਆਇ ਪਰੰਤ ॥",
      "s": 7
    }
  ]
}
