{
  "page": 582,
  "lines": [
    {
      "t": "ਪਗ ਦ੍ਵੈ ਨ ਭਾਗਿ ਚਲੰਤ ॥",
      "s": 7
    },
    {
      "t": "ਤਜਿ ਤ੍ਰਾਸ ਕਰਤ ਪ੍ਰਹਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਜਨੁ ਖੇਲ ਫਾਗਿ ਧਮਾਰ ॥੩੦੬॥",
      "s": 7
    },
    {
      "t": "ਤਾਰਕ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਕਲਕੀ ਅਵਤਾਰ ਰਿਸਾਵਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਭਟ ਓਘ ਪ੍ਰਓਘ ਗਿਰਾਵਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਬਹੁ ਭਾਤਨ ਸਸਤ੍ਰ ਪ੍ਰਹਾਰਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਅਰਿ ਓਘ ਪ੍ਰਓਘ ਸੰਘਾਰਹਿਗੇ ॥੩੦੭॥",
      "s": 7
    },
    {
      "t": "ਸਰ ਸੇਲ ਸਨਾਹਰਿ ਛੂਟਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਰਣ ਰੰਗਿ ਸੁਰਾਸੁਰ ਜੂਟਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਸਰ ਸੇਲ ਸਨਾਹਰਿ ਝਾਰਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਮੁਖ ਮਾਰ ਪਚਾਰ ਪ੍ਰਹਾਰਹਿਗੇ ॥੩੦੮॥",
      "s": 7
    },
    {
      "t": "ਜਮਡਢ ਕ੍ਰਿਪਾਣ ਨਿਕਾਰਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਕਰਿ ਕੋਪ ਸੁਰਾਸੁਰ ਝਾਰਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਰਣਿ ਲੁਥ ਪੈ ਲੁਥ ਗਿਰਾਵਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਲਖਿ ਪ੍ਰੇਤ ਪਰੀ ਰਹਸਾਵਹਿਗੇ ॥੩੦੯॥",
      "s": 7
    },
    {
      "t": "ਰਣਿ ਗੂੜ ਅਗੂੜਣਿ ਗਜਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਲਖਿ ਭੀਰ ਭਯਾਹਵ ਭਜਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਸਰ ਬਿੰਦ ਪ੍ਰਬਿੰਦ ਪ੍ਰਹਾਰਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਰਣਰੰਗਿ ਅਭੀਤ ਬਿਹਾਰਹਿਗੇ ॥੩੧੦॥",
      "s": 7
    },
    {
      "t": "ਖਗ ਉਧ ਅਧੋ ਅਧ ਬਜਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਲਖਿ ਜੋਧ ਮਹਾ ਜੁਧ ਗਜਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਅਣਿਣੇਸ ਦੁਹੂੰ ਦਿਸ ਢੂਕਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਮੁਖ ਮਾਰ ਮਹਾ ਸੁਰ ਕੂਕਹਿਗੇ ॥੩੧੧॥",
      "s": 7
    },
    {
      "t": "ਗਣ ਗੰਧ੍ਰਵ ਦੇਵ ਨਿਹਾਰਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਜੈ ਸਦ ਨਿਨਦ ਪੁਕਾਰਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਜਮਦਾੜਿ ਕ੍ਰਿਪਾਣਣਿ ਬਾਹਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਅਧਅੰਗ ਅਧੋਅਧ ਲਾਹਹਿਗੇ ॥੩੧੨॥",
      "s": 7
    },
    {
      "t": "ਰਣਰੰਗਿ ਤੁਰੰਗੈ ਬਾਜਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਡਫ ਝਾਝ ਨਫੀਰੀ ਗਾਜਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਅਣਿਣੇਸ ਦੁਹੂੰ ਦਿਸ ਧਾਵਹਿਗੈ ॥",
      "s": 7
    },
    {
      "t": "ਕਰਿ ਕਾਢਿ ਕ੍ਰਿਪਾਣ ਕੰਪਾਵਹਿਗੇ ॥੩੧੩॥",
      "s": 7
    },
    {
      "t": "ਰਣਿ ਕੁੰਜਰ ਪੁੰਜ ਗਰਜਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਲਖਿ ਮੇਘ ਮਹਾ ਦੁਤਿ ਲਜਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਰਿਸ ਮੰਡਿ ਮਹਾ ਰਣ ਜੂਟਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਛੁਟਿ ਛਤ੍ਰ ਛਟਾਛਟ ਛੂਟਹਿਗੇ ॥੩੧੪॥",
      "s": 7
    },
    {
      "t": "ਰਣਣੰਕ ਨਿਸਾਣ ਦਿਸਾਣ ਘੁਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਗੜਗਜ ਹਠੀ ਰਣ ਰੰਗਿ ਫਿਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਕਰਿ ਕੋਪ ਕ੍ਰਿਪਾਣ ਪ੍ਰਹਾਰਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਭਟ ਘਾਇ ਝਟਾਝਟ ਝਾਰਹਿਗੇ ॥੩੧੫॥",
      "s": 7
    },
    {
      "t": "ਕਰਿ ਕਾਢਿ ਕ੍ਰਿਪਾਣ ਕੰਪਾਵਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਕਲਿਕੀ ਕਲਿ ਕ੍ਰਿਤ ਬਢਾਵਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਰਣਿ ਲੁਥ ਪਲੁਥ ਬਿਥਾਰਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਤਕਿ ਤੀਰ ਸੁ ਬੀਰਨ ਮਾਰਹਿਗੇ ॥੩੧੬॥",
      "s": 7
    },
    {
      "t": "ਘਣ ਘੁੰਘਰ ਘੋਰ ਘਮਕਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਰਣ ਮੋ ਰਣਧੀਰ ਪਲਕਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਗਹਿ ਤੇਗ ਝੜਾਝੜ ਝਾੜਹਿਗੇ ॥",
      "s": 7
    },
    {
      "t": "ਤਕਿ ਤੀਰ ਤੜਾਤੜ ਤਾੜਹਿਗੇ ॥੩੧੭॥",
      "s": 7
    }
  ]
}
