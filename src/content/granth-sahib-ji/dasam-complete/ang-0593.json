    },
    {
      "t": "ਉਠੰਤ ਨਾਦ ਭਜੰਤ ਭੀਰ ॥੪੨੦॥",
      "s": 7
    },
    {
      "t": "ਧਾਏ ਸਬਾਹ ਜੋਧਾ ਸਕੋਪ ॥",
      "s": 7
    },
    {
      "t": "ਕਢਤ ਕ੍ਰਿਪਾਣ ਬਾਹੰਤ ਧੋਪ ॥",
      "s": 7
    },
    {
      "t": "ਲੁਝੰਤ ਸੂਰ ਜੁਝੰਤ ਅਪਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਜਣ ਸੇਤਬੰਧ ਦਿਖੀਅਤ ਪਹਾਰ ॥੪੨੧॥",
      "s": 7
    },
    {
      "t": "ਕਟੰਤ ਅੰਗ ਭਭਕੰਤ ਘਾਵ ॥",
      "s": 7
    },
    {
      "t": "ਸਿਝੰਤ ਸੂਰ ਜੁਝੰਤ ਚਾਵ ॥",
      "s": 7
    },
    {
      "t": "ਨਿਰਖੰਤ ਸਿਧ ਚਾਰਣ ਅਨੰਤ ॥",
      "s": 7
    },
    {
      "t": "ਉਚਰੰਤ ਕ੍ਰਿਤ ਜੋਧਨ ਬਿਅੰਤ ॥੪੨੨॥",
      "s": 7
    },
    {
      "t": "ਨਾਚੰਤ ਆਪ ਈਸਰ ਕਰਾਲ ॥",
      "s": 7
    },
    {
      "t": "ਬਾਜੰਤ ਡਉਰੁ ਭੈਕਰਿ ਬਿਸਾਲ ॥",
      "s": 7
    },
    {
      "t": "ਪੋਅੰਤ ਮਾਲ ਕਾਲੀ ਕਪਾਲ ॥",
      "s": 7
    },
    {
      "t": "ਚਲ ਚਿਤ ਚਖ ਛਾਡੰਤ ਜ੍ਵਾਲ ॥੪੨੩॥",
      "s": 7
    },
    {
      "t": "ਰਸਾਵਲ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਬਜੇ ਘੋਰ ਬਾਜੇ ॥",
      "s": 7
    },
    {
      "t": "ਧੁਣੰ ਮੇਘ ਲਾਜੇ ॥",
      "s": 7
    },
    {
      "t": "ਖਹੇ ਖੇਤ ਖਤ੍ਰੀ ॥",
      "s": 7
    },
    {
      "t": "ਤਜੇ ਤਾਣਿ ਪਤ੍ਰੀ ॥੪੨੪॥",
      "s": 7
    },
    {
      "t": "ਗਿਰੈ ਅੰਗ ਭੰਗੰ ॥",
      "s": 7
    },
    {
      "t": "ਨਚੇ ਜੰਗ ਰੰਗੰ ॥",
      "s": 7
    },
    {
      "t": "ਖੁਲੇ ਖਗ ਖੂਨੀ ॥",
      "s": 7
    },
    {
      "t": "ਚੜੇ ਚਉਪ ਦੂਨੀ ॥੪੨੫॥",
      "s": 7
    },
    {
      "t": "ਭਯੋ ਘੋਰ ਜੁਧੰ ॥",
      "s": 7
    },
    {
      "t": "ਇਤੀ ਕਾਹਿ ਸੁਧੰ ॥",
      "s": 7
    },
    {
      "t": "ਜਿਣਿਓ ਕਾਲ ਰੂਪੰ ॥",
      "s": 7
    },
    {
