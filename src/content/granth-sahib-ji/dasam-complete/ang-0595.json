{
  "page": 595,
  "lines": [
    {
      "t": "ਅਬੂਝ ਓਰਿ ਧਾਵਹੀ ਬਨਾਇ ਸੈਨ ਏਕਠੀਂ ॥੪੪੦॥",
      "s": 7
    },
    {
      "t": "ਸੰਗੀਤ ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਕਾਗੜਦੰ ਕੋਪਾ ਰਾਗੜਦੰ ਰਾਜਾ ॥",
      "s": 7
    },
    {
      "t": "ਘਾਗੜਦੰ ਘੋਰੇ ਬਾਗੜਦੰ ਬਾਜਾ ॥",
      "s": 7
    },
    {
      "t": "ਫਾਗੜਦੰ ਫੀਲੰ ਛਾਗੜਦੰ ਛੂਟੇ ॥",
      "s": 7
    },
    {
      "t": "ਸਾਗੜਦੰ ਸੂਰੰ ਜਾਗੜਦੰ ਜੂਟੇ ॥੪੪੧॥",
      "s": 7
    },
    {
      "t": "ਬਾਗੜਦੰ ਬਾਜੇ ਨਾਗੜਦੰ ਨਗਾਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਜਾਗੜਦੰ ਜੋਧਾ ਮਾਗੜਦੰ ਮਾਰੇ ॥",
      "s": 7
    },
    {
      "t": "ਡਾਗੜਦੰ ਡਿਗੇ ਖਾਗੜਦੰ ਖੂਨੀ ॥",
      "s": 7
    },
    {
      "t": "ਚਾਗੜਦੰ ਚਉਪੈ ਦਾਗੜਦੰ ਦੂਨੀ ॥੪੪੨॥",
      "s": 7
    },
    {
      "t": "ਹਾਗੜਦੰ ਹਸੇ ਸਾਗੜਦੰ ਸਿਧੰ ॥",
      "s": 7
    },
    {
      "t": "ਭਾਗੜਦੰ ਭਾਜੇ ਬਾਗੜਦੰ ਬ੍ਰਿਧੰ ॥",
      "s": 7
    },
    {
      "t": "ਛਾਗੜਦੰ ਛੁਟੇ ਤਾਗੜਦੰ ਤੀਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਜਾਗੜਦੰ ਜੁਟੇ ਬਾਗੜਦੰ ਬੀਰੰ ॥੪੪੩॥",
      "s": 7
    },
    {
      "t": "ਕਾਗੜਦੰ ਕੁਹਕੇ ਬਾਗੜਦੰ ਬਾਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਫਾਗੜਦੰ ਫਰਕੇ ਨਾਗੜਦੰ ਨਿਸਾਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਬਾਗੜਦੰ ਬਾਜੀ ਭਾਗੜਦੰ ਭੇਰੀ ॥",
      "s": 7
    },
    {
      "t": "ਸਾਗੜਦੰ ਸੈਣੰ ਫਾਗੜਦੰ ਫੇਰੀ ॥੪੪੪॥",
      "s": 7
    },
    {
      "t": "ਭਾਗੜਦੰ ਭੀਰੰ ਕਾਗੜਦੰ ਕੰਪੈ ॥",
      "s": 7
    },
    {
      "t": "ਮਾਗੜਦੰ ਮਾਰੇ ਜਾਗੜਦੰ ਜੰਪੈ ॥",
      "s": 7
    },
    {
      "t": "ਛਾਗੜਦੰ ਛਪ੍ਰੰ ਭਾਗੜਦੰ ਭਾਜੇ ॥",
      "s": 7
    },
    {
      "t": "ਚਾਗੜਦੰ ਚਿਤੰ ਲਾਗੜਦੰ ਲਾਜੇ ॥੪੪੫॥",
      "s": 7
    },
    {
      "t": "ਛਾਗੜਦੰ ਛੋਰਿਓ ਰਾਗੜਦੰ ਰਾਜੰ ॥",
      "s": 7
    },
    {
      "t": "ਸਾਗੜਦੰ ਸੈਣੰ ਭਾਗੜਦੰ ਭਾਜਾ ॥",
      "s": 7
    }
  ]
}
