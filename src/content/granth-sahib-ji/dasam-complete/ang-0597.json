{
  "page": 597,
  "lines": [
    {
      "t": "ਚਮੂੰ ਚਉਪਿ ਚਾਲੀ ॥",
      "s": 7
    },
    {
      "t": "ਥਿਰਾ ਸਰਬ ਹਾਲੀ ॥੪੫੭॥",
      "s": 7
    },
    {
      "t": "ਉਠੀ ਕੰਪਿ ਐਸੇ ॥",
      "s": 7
    },
    {
      "t": "ਨਦੰ ਨਾਵ ਜੈਸੇ ॥",
      "s": 7
    },
    {
      "t": "ਚੜੇ ਚਉਪ ਸੂਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਰਹਿਓ ਧੂਰ ਪੂਰੰ ॥੪੫੮॥",
      "s": 7
    },
    {
      "t": "ਛੁਭੇ ਛਤ੍ਰਧਾਰੀ ॥",
      "s": 7
    },
    {
      "t": "ਅਣੀ ਜੋੜਿ ਭਾਰੀ ॥",
      "s": 7
    },
    {
      "t": "ਚਲੇ ਕੋਪਿ ਐਸੇ ॥",
      "s": 7
    },
    {
      "t": "ਬ੍ਰਿਤੰ ਇੰਦ੍ਰ ਜੈਸੇ ॥੪੫੯॥",
      "s": 7
    },
    {
      "t": "ਸੁਭੈ ਸਰਬ ਸੈਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਕਥੈ ਕੌਣ ਬੈਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਚਲੀ ਸਾਜਿ ਸਾਜਾ ॥",
      "s": 7
    },
    {
      "t": "ਬਜੈ ਜੀਤ ਬਾਜਾ ॥੪੬੦॥",
      "s": 7
    },
    {
      "t": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਜਿਣੇ ਗਖਰੀ ਪਖਰੀ ਖਗਧਾਰੀ ॥",
      "s": 7
    },
    {
      "t": "ਹਣੇ ਪਖਰੀ ਭਖਰੀ ਔ ਕੰਧਾਰੀ ॥",
      "s": 7
    },
    {
      "t": "ਗੁਰਜਿਸਤਾਨ ਗਾਜੀ ਰਜੀ ਰੋਹਿ ਰੂਮੀ ॥",
      "s": 7
    },
    {
      "t": "ਹਣੇ ਸੂਰ ਬੰਕੇ ਗਿਰੇ ਝੂਮਿ ਭੂਮੀ ॥੪੬੧॥",
      "s": 7
    },
    {
      "t": "ਹਣੇ ਕਾਬੁਲੀ ਬਾਬਲੀ ਬੀਰ ਬਾਕੇ ॥",
      "s": 7
    },
    {
      "t": "ਕੰਧਾਰੀ ਹਰੇਵੀ ਇਰਾਕੀ ਨਿਸਾਕੇ ॥",
      "s": 7
    },
    {
      "t": "ਬਲੀ ਬਾਲਖੀ ਰੋਹਿ ਰੂਮੀ ਰਜੀਲੇ ॥",
      "s": 7
    },
    {
      "t": "ਭਜੇ ਤ੍ਰਾਸ ਕੈ ਕੈ ਭਏ ਬੰਦ ਢੀਲੇ ॥੪੬੨॥",
      "s": 7
    },
    {
      "t": "ਤਜੇ ਅਸਤ੍ਰ ਸਸਤ੍ਰੰ ਸਜੇ ਨਾਰਿ ਭੇਸੰ ॥",
      "s": 7
    },
    {
      "t": "ਲਜੈ ਬੀਰ ਧੀਰੰ ਚਲੇ ਛਾਡਿ ਦੇਸੰ ॥",
      "s": 7
    },
    {
      "t": "ਗਜੀ ਬਾਜਿ ਗਾਜੀ ਰਥੀ ਰਾਜ ਹੀਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਤਜੈ ਬੀਰ ਧੀਰੰ ਭਏ ਅੰਗ ਛੀਣੰ ॥੪੬੩॥",
      "s": 7
    },
    {
      "t": "ਭਜੇ ਹਾਬਸੀ ਹਾਲਬੀ ਕਉਕ ਬੰਦ੍ਰੀ ॥",
      "s": 7
    },
    {
      "t": "ਚਲੇ ਬਰਬਰੀ ਅਰਮਨੀ ਛਾਡਿ ਤੰਦ੍ਰੀ ॥",
      "s": 7
    },
    {
      "t": "ਖੁਲਿਓ ਖਗ ਖੂਨੀ ਤਹਾ ਏਕ ਗਾਜੀ ॥",
      "s": 7
    },
    {
      "t": "ਦੁਹੂੰ ਸੈਣ ਮਧੰ ਨਚਿਓ ਜਾਇ ਤਾਜੀ ॥੪੬੪॥",
      "s": 7
    },
    {
      "t": "ਲਖਿਓ ਜੁਧ ਜੰਗੀ ਮਹਾ ਜੰਗ ਕਰਤਾ ॥",
      "s": 7
    },
    {
      "t": "ਛੁਭਿਓ ਛਤ੍ਰਧਾਰੀ ਰਣੰ ਛਤ੍ਰਿ ਹਰਤਾ ॥",
      "s": 7
    },
    {
      "t": "ਦੁਰੰ ਦੁਰਦਗਾਮੀ ਦਲੰ ਜੁਧ ਜੇਤਾ ॥",
      "s": 7
    },
    {
      "t": "ਛੁਭੇ ਛਤ੍ਰਿ ਹੰਤਾ ਜਯੰ ਜੁਧ ਹੇਤਾ ॥੪੬੫॥",
      "s": 7
    },
    {
      "t": "ਮਹਾ ਕ੍ਰੋਧ ਕੈ ਬਾਣ ਛਡੇ ਅਪਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਕਟੇ ਟਟਰੰ ਫਉਜ ਫੁਟੀ ਨ੍ਰਿਪਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਗਿਰੀ ਲੁਥ ਜੁਥੰ ਮਿਲੇ ਹਥ ਬਥੰ ॥",
      "s": 7
    },
    {
      "t": "ਗਿਰੇ ਅੰਗ ਭੰਗੰ ਰਣੰ ਮੁਖ ਜੁਥੰ ॥੪੬੬॥",
      "s": 7
    },
    {
      "t": "ਕਰੈ ਕੇਲ ਕੰਕੀ ਕਿਲਕੈਤ ਕਾਲੀ ॥",
      "s": 7
    },
    {
      "t": "ਤਜੈ ਜ੍ਵਾਲ ਮਾਲਾ ਮਹਾ ਜੋਤਿ ਜ੍ਵਾਲੀ ॥",
      "s": 7
    },
    {
      "t": "ਹਸੈ ਭੂਤ ਪ੍ਰੇਤੰ ਤੁਟੈ ਤਥਿ ਤਾਲੰ ॥",
      "s": 7
    },
    {
      "t": "ਫਿਰੈ ਗਉਰ ਦੌਰੀ ਪੁਐ ਰੁੰਡ ਮਾਲੰ ॥੪੬੭॥",
      "s": 7
    },
    {
      "t": "ਰਸਾਵਲ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਕਰੈ ਜੁਧ ਕ੍ਰੁਧੰ ॥",
      "s": 7
    },
    {
      "t": "ਤਜੈ ਬਾਣ ਸੁਧੰ ॥",
      "s": 7
    },
    {
      "t": "ਬਕੈ ਮਾਰੁ ਮਾਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਤਜੈ ਬਾਣ ਧਾਰੰ ॥੪੬੮॥",
      "s": 7
    }
  ]
}
