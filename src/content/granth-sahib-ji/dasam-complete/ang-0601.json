{
  "page": 601,
  "lines": [
    {
      "t": "ਡਲ ਡੋਲਸ ਸੰਕਤ ਸੇਸ ਥਿਰਾ ॥੪੯੭॥",
      "s": 7
    },
    {
      "t": "ਦਿਵ ਦੇਖਤ ਲੇਖਤ ਧਨਿ ਧਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਕਿਲਕੰਤ ਕਪਾਲਯਿ ਕ੍ਰੂਰ ਪ੍ਰਭੰ ॥",
      "s": 7
    },
    {
      "t": "ਬ੍ਰਿਣ ਬਰਖਤ ਪਰਖਤ ਬੀਰ ਰਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਹਯ ਘਲਤ ਝਲਤ ਜੋਧ ਜੁਧੰ ॥੪੯੮॥",
      "s": 7
    },
    {
      "t": "ਕਿਲਕੰਤ ਕਪਾਲਿਨ ਸਿੰਘ ਚੜੀ ॥",
      "s": 7
    },
    {
      "t": "ਚਮਕੰਤ ਕ੍ਰਿਪਾਣ ਪ੍ਰਭਾਨਿ ਮੜੀ ॥",
      "s": 7
    },
    {
      "t": "ਗਣਿ ਹੂਰ ਸੁ ਪੂਰਤ ਧੂਰਿ ਰਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਅਵਿਲੋਕਤ ਦੇਵ ਅਦੇਵ ਗਣੰ ॥੪੯੯॥",
      "s": 7
    },
    {
      "t": "ਰਣਿ ਭਰਮਤ ਕ੍ਰੂਰ ਕਬੰਧ ਪ੍ਰਭਾ ॥",
      "s": 7
    },
    {
      "t": "ਅਵਿਲੋਕਤ ਰੀਝਤ ਦੇਵ ਸਭਾ ॥",
      "s": 7
    },
    {
      "t": "ਗਣਿ ਹੂਰਨ ਬ੍ਰਯਾਹਤ ਪੂਰ ਰਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਰਥ ਥੰਭਤ ਭਾਨੁ ਬਿਲੋਕ ਭਟੰ ॥੫੦੦॥",
      "s": 7
    },
    {
      "t": "ਢਢਿ ਢੋਲਕ ਝਾਝ ਮ੍ਰਿਦੰਗ ਮੁਖੰ ॥",
      "s": 7
    },
    {
      "t": "ਡਫ ਤਾਲ ਪਖਾਵਜ ਨਾਇ ਸੁਰੰ ॥",
      "s": 7
    },
    {
      "t": "ਸੁਰ ਸੰਖ ਨਫੀਰੀਯ ਭੇਰਿ ਭਕੰ ॥",
      "s": 7
    },
    {
      "t": "ਉਠਿ ਨਿਰਤਤ ਭੂਤ ਪਰੇਤ ਗਣੰ ॥੫੦੧॥",
      "s": 7
    },
    {
      "t": "ਦਿਸ ਪਛਮ ਜੀਤਿ ਅਭੀਤ ਨ੍ਰਿਪੰ ॥",
      "s": 7
    },
    {
      "t": "ਕੁਪਿ ਕੀਨ ਪਯਾਨ ਸੁ ਦਛਣਿਣੰ ॥",
      "s": 7
    },
    {
      "t": "ਅਰਿ ਭਜੀਯ ਤਜੀਯ ਦੇਸ ਦਿਸੰ ॥",
      "s": 7
    },
    {
      "t": "ਰਣ ਗਜੀਅ ਕੇਤਕ ਏਸੁਰਿਣੰ ॥੫੦੨॥",
      "s": 7
    },
    {
      "t": "ਨ੍ਰਿਤ ਨ੍ਰਿਤਤ ਭੂਤ ਬਿਤਾਲ ਬਲੀ ॥",
      "s": 7
    },
    {
      "t": "ਗਜ ਗਜਤ ਬਜਤ ਦੀਹ ਦਲੀ ॥",
      "s": 7
    },
    {
      "t": "ਹਯ ਹਿੰਸਤ ਚਿੰਸਤ ਗੂੜ ਗਜੀ ॥",
      "s": 7
    }
  ]
}
