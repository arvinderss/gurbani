{
  "page": 604,
  "lines": [
    {
      "t": "ਤਮੰਕੇ ਰਾਜਧਾਰੀ ਕੈ ॥",
      "s": 7
    },
    {
      "t": "ਰਜੀਲੇ ਰੋਹਵਾਰੀ ਕੈ ॥",
      "s": 7
    },
    {
      "t": "ਕਾਟੀਲੇ ਕਾਮ ਰੂਪਾ ਕੈ ॥",
      "s": 7
    },
    {
      "t": "ਕੰਬੋਜੇ ਕਾਸਕਾਰੀ ਕੈ ॥੫੨੬॥",
      "s": 7
    },
    {
      "t": "ਢਮੰਕੇ ਢੋਲ ਢਾਲੋ ਕੈ ॥",
      "s": 7
    },
    {
      "t": "ਡਮੰਕੇ ਡੰਕ ਵਾਰੋ ਕੈ ॥",
      "s": 7
    },
    {
      "t": "ਘਮੰਕੇ ਨੇਜ ਬਾਜਾ ਦੇ ॥",
      "s": 7
    },
    {
      "t": "ਤਮੰਕੇ ਤੀਰ ਤਾਜਾ ਦੇ ॥੫੨੭॥",
      "s": 7
    },
    {
      "t": "ਪਾਧਰੀ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਜੀਤੇ ਅਜੀਤ ਮੰਡੇ ਅਮੰਡ ॥",
      "s": 7
    },
    {
      "t": "ਤੋਰੇ ਅਤੋਰ ਖੰਡੇ ਅਖੰਡ ॥",
      "s": 7
    },
    {
      "t": "ਭੰਨੇ ਅਭੰਨ ਭਜੇ ਅਭਜਿ ॥",
      "s": 7
    },
    {
      "t": "ਖਾਨੇ ਖਵਾਸ ਮਾਵਾਸ ਤਜਿ ॥੫੨੮॥",
      "s": 7
    },
    {
      "t": "ਸੰਕੜੇ ਸੂਰ ਭੰਭਰੇ ਭੀਰ ॥",
      "s": 7
    },
    {
      "t": "ਨਿਰਖੰਤ ਜੋਧ ਰੀਝੰਤ ਹੂਰ ॥",
      "s": 7
    },
    {
      "t": "ਡਾਰੰਤ ਸੀਸ ਕੇਸਰ ਕਟੋਰਿ ॥",
      "s": 7
    },
    {
      "t": "ਮ੍ਰਿਗ ਮਦ ਗੁਲਾਬ ਕਰਪੂਰ ਘੋਰਿ ॥੫੨੯॥",
      "s": 7
    },
    {
      "t": "ਇਹ ਭਾਤਿ ਜੀਤ ਤੀਨੰ ਦਿਸਾਣ ॥",
      "s": 7
    },
    {
      "t": "ਬਜਿਓ ਸੁਕੋਪ ਉਤਰ ਨਿਸਾਣ ॥",
      "s": 7
    },
    {
      "t": "ਚਲੇ ਸੁ ਚੀਨ ਮਾਚੀਨ ਦੇਸਿ ॥",
      "s": 7
    },
    {
      "t": "ਸਾਮੰਤ ਸੁਧ ਰਾਵਲੀ ਭੇਖ ॥੫੩੦॥",
      "s": 7
    },
    {
      "t": "ਬਜੇ ਬਜੰਤ੍ਰ ਗਜੇ ਸੁਬਾਹ ॥",
      "s": 7
    },
    {
      "t": "ਸਾਵੰਤ ਦੇਖਿ ਅਛ੍ਰੀ ਉਛਾਹ ॥",
      "s": 7
    },
    {
      "t": "ਰੀਝੰਤ ਦੇਵ ਅਦੇਵ ਸਰਬ ॥",
      "s": 7
    },
    {
      "t": "ਗਾਵੰਤ ਗੀਤ ਤਜ ਦੀਨ ਗਰਬ ॥੫੩੧॥",
      "s": 7
    },
    {
      "t": "ਸਜਿਓ ਸੁ ਸੈਣ ਸੁਣਿ ਚੀਨ ਰਾਜ ॥",
      "s": 7
    },
    {
      "t": "ਬਜੇ ਬਜੰਤ੍ਰ ਸਰਬੰ ਸਮਾਜ ॥",
      "s": 7
    },
    {
      "t": "ਚਲੇ ਅਚਲ ਸਾਵੰਤ ਜੁਧ ॥",
      "s": 7
    },
    {
      "t": "ਬਰਖੰਤ ਬਾਣ ਭਰ ਲੋਹ ਕ੍ਰੁਧ ॥੫੩੨॥",
      "s": 7
    },
    {
      "t": "ਖੁਲੇ ਖਤੰਗ ਖੂਨੀ ਖਤ੍ਰਿਹਾਣ ॥",
      "s": 7
    },
    {
      "t": "ਉਝਰੇ ਜੁਧ ਜੋਧਾ ਮਹਾਣ ॥",
      "s": 7
    },
    {
      "t": "ਧੁਕੰਤ ਢੋਲ ਘੁੰਮੰਤ ਘਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਚਿਕੰਤ ਚਾਵਡੀ ਮਾਸੁ ਚਾਇ ॥੫੩੩॥",
      "s": 7
    },
    {
      "t": "ਹਸੰਤ ਹਾਸ ਕਾਲੀ ਕਰਾਲ ॥",
      "s": 7
    },
    {
      "t": "ਭਭਕੰਤ ਭੂਤ ਭੈਰੋ ਬਿਸਾਲ ॥",
      "s": 7
    },
    {
      "t": "ਲਾਗੰਤ ਬਾਣ ਭਾਖੰਤ ਮਾਸ ॥",
      "s": 7
    },
    {
      "t": "ਭਾਜੰਤ ਭੀਰ ਹੁਇ ਹੁਇ ਉਦਾਸ ॥੫੩੪॥",
      "s": 7
    },
    {
      "t": "ਰਸਾਵਲ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਚੜਿਓ ਚੀਨ ਰਾਜੰ ॥",
      "s": 7
    },
    {
      "t": "ਸਜੇ ਸਰਬ ਸਾਜੰ ॥",
      "s": 7
    },
    {
      "t": "ਖੁਲੇ ਖੇਤਿ ਖੂਨੀ ॥",
      "s": 7
    },
    {
      "t": "ਚੜੇ ਚੌਪ ਦੂਨੀ ॥੫੩੫॥",
      "s": 7
    },
    {
      "t": "ਜੁਟੇ ਜੋਧ ਜੋਧੰ ॥",
      "s": 7
    },
    {
      "t": "ਤਜੈ ਬਾਣ ਕ੍ਰੋਧੰ ॥",
      "s": 7
    },
    {
      "t": "ਤੁਟੈ ਅੰਗ ਭੰਗੰ ॥",
      "s": 7
    },
    {
      "t": "ਭ੍ਰਮੇ ਰੰਗ ਜੰਗੰ ॥੫੩੬॥",
      "s": 7
    },
    {
      "t": "ਨਚੇ ਈਸ ਭੀਸੰ ॥",
      "s": 7
    },
    {
      "t": "ਪੁਐ ਮਾਲ ਸੀਸੰ ॥",
      "s": 7
    }
  ]
}
