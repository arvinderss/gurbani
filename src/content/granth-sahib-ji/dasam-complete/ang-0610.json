{
  "page": 610,
  "lines": [
    {
      "t": "ਅਮਿਤ ਅਰਿ ਘਾਵਹੀਂ ॥",
      "s": 7
    },
    {
      "t": "ਜਗਤ ਜਸੁ ਪਾਵਹੀਂ ॥੫੮੧॥",
      "s": 7
    },
    {
      "t": "ਅਖੰਡ ਬਾਹੁ ਹੈ ਬਲੀ ॥",
      "s": 7
    },
    {
      "t": "ਸੁਭੰਤ ਜੋਤਿ ਨਿਰਮਲੀ ॥",
      "s": 7
    },
    {
      "t": "ਸੁ ਹੋਮ ਜਗ ਕੋ ਕਰੈਂ ॥",
      "s": 7
    },
    {
      "t": "ਪਰਮ ਪਾਪ ਕੋ ਹਰੈਂ ॥੫੮੨॥",
      "s": 7
    },
    {
      "t": "ਤੋਮਰ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਜਗ ਜੀਤਿਓ ਜਬ ਸਰਬ ॥",
      "s": 7
    },
    {
      "t": "ਤਬ ਬਾਢਿਓ ਅਤਿ ਗਰਬ ॥",
      "s": 7
    },
    {
      "t": "ਦੀਅ ਕਾਲ ਪੁਰਖ ਬਿਸਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਇਹ ਭਾਤਿ ਕੀਨ ਬਿਚਾਰ ॥੫੮੩॥",
      "s": 7
    },
    {
      "t": "ਬਿਨੁ ਮੋਹਿ ਦੂਸਰ ਨ ਔਰ ॥",
      "s": 7
    },
    {
      "t": "ਅਸਿ ਮਾਨ੍ਯੋ ਸਬ ਠਉਰ ॥",
      "s": 7
    },
    {
      "t": "ਜਗੁ ਜੀਤਿ ਕੀਨ ਗੁਲਾਮ ॥",
      "s": 7
    },
    {
      "t": "ਆਪਨ ਜਪਾਯੋ ਨਾਮ ॥੫੮੪॥",
      "s": 7
    },
    {
      "t": "ਜਗਿ ਐਸ ਰੀਤਿ ਚਲਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਸਿਰ ਅਤ੍ਰ ਪਤ੍ਰ ਫਿਰਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਸਬ ਲੋਗ ਆਪਨ ਮਾਨ ॥",
      "s": 7
    },
    {
      "t": "ਤਰਿ ਆਂਖਿ ਅਉਰ ਨ ਆਨਿ ॥੫੮੫॥",
      "s": 7
    },
    {
      "t": "ਨਹੀ ਕਾਲ ਪੁਰਖ ਜਪੰਤ ॥",
      "s": 7
    },
    {
      "t": "ਨਹਿ ਦੇਵਿ ਜਾਪੁ ਭਣੰਤ ॥",
      "s": 7
    },
    {
      "t": "ਤਬ ਕਾਲ ਦੇਵ ਰਿਸਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਇਕ ਅਉਰ ਪੁਰਖ ਬਨਾਇ ॥੫੮੬॥",
      "s": 7
    },
    {
      "t": "ਰਚਿਅਸੁ ਮਹਿਦੀ ਮੀਰ ॥",
      "s": 7
    },
    {
      "t": "ਰਿਸਵੰਤ ਹਾਠ ਹਮੀਰ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਹ ਤਉਨ ਕੋ ਬਧੁ ਕੀਨ ॥",
      "s": 7
    },
    {
      "t": "ਪੁਨਿ ਆਪ ਮੋ ਕੀਅ ਲੀਨ ॥੫੮੭॥",
      "s": 7
    },
    {
      "t": "ਜਗ ਜੀਤਿ ਆਪਨ ਕੀਨ ॥",
      "s": 7
    },
    {
      "t": "ਸਬ ਅੰਤਿ ਕਾਲ ਅਧੀਨ ॥",
      "s": 7
    },
    {
      "t": "ਇਹ ਭਾਤਿ ਪੂਰਨ ਸੁ ਧਾਰਿ ॥",
      "s": 7
    },
    {
      "t": "ਭਏ ਚੌਬਿਸੇ ਅਵਤਾਰ ॥੫੮੮॥",
      "s": 7
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਚਤੁਰ ਬਿਸਤਿ ਕਲਕੀ ਅਵਤਾਰ ਬਰਨਨੰ ਸਮਾਪਤੰ ॥",
      "s": 7
    },
    {
      "t": "ਅਥ ਮਹਿਦੀ ਅਵਤਾਰ ਕਥਨੰ ॥",
      "s": 7
    },
    {
      "t": "ਤੋਮਰ ਛੰਦ ॥",
      "s": 7
    },
    {
      "t": "ਇਹ ਭਾਤਿ ਕੈ ਤਿੰਹ ਨਾਸਿ ॥",
      "s": 7
    },
    {
      "t": "ਕੀਅ ਸਤਿਜੁਗ ਪ੍ਰਕਾਸ ॥",
      "s": 7
    },
    {
      "t": "ਕਲਿਜੁਗ ਸਰਬ ਬਿਹਾਨ ॥",
      "s": 7
    },
    {
      "t": "ਨਿਜੁ ਜੋਤਿ ਜੋਤਿ ਸਮਾਨ ॥੧॥",
      "s": 7
    },
    {
      "t": "ਮਹਿਦੀ ਭਰ੍ਯੋ ਤਬ ਗਰਬ ॥",
      "s": 7
    },
    {
      "t": "ਜਗ ਜੀਤਯੋ ਜਬ ਸਰਬ ॥",
      "s": 7
    },
    {
      "t": "ਸਿਰਿ ਅਤ੍ਰ ਪਤ੍ਰ ਫਿਰਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਜਗ ਜੇਰ ਕੀਨ ਬਨਾਇ ॥੨॥",
      "s": 7
    },
    {
      "t": "ਬਿਨੁ ਆਪੁ ਜਾਨਿ ਨ ਔਰ ॥",
      "s": 7
    },
    {
      "t": "ਸਬ ਰੂਪ ਅਉ ਸਬ ਠਉਰ ॥",
      "s": 7
    },
    {
      "t": "ਜਿਨਿ ਏਕ ਦਿਸਟਿ ਨ ਆਨ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਸੁ ਲੀਨ ਕਾਲ ਨਿਦਾਨ ॥੩॥",
      "s": 7
    },
    {
      "t": "ਬਿਨੁ ਏਕ ਦੂਸਰ ਨਾਹਿ ॥",
      "s": 7
    },
    {
      "t": "ਸਬ ਰੰਗ ਰੂਪਨ ਮਾਹਿ ॥",
      "s": 7
    }
  ]
}
