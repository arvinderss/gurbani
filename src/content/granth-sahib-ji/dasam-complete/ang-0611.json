  "lines": [
    {
      "t": "ਜਿਨਿ ਏਕ ਕੋ ਨ ਪਛਾਨ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਹ ਬ੍ਰਿਥਾ ਜਨਮ ਬਿਤਾਨ ॥੪॥",
      "s": 7
    },
    {
      "t": "ਬਿਨੁ ਏਕ ਦੂਜ ਨ ਔਰ ॥",
      "s": 7
    },
    {
      "t": "ਜਲ ਬਾ ਥਲੇ ਸਬ ਠਉਰ ॥",
      "s": 7
    },
    {
      "t": "ਜਿਨਿ ਏਕ ਸਤਿ ਨ ਜਾਨ ॥",
      "s": 7
    },
    {
      "t": "ਸੋ ਜੂਨਿ ਜੂਨਿ ਭ੍ਰਮਾਨ ॥੫॥",
      "s": 7
    },
    {
      "t": "ਤਜਿ ਏਕ ਜਾਨਾ ਦੂਜ ॥",
      "s": 7
    },
    {
      "t": "ਮਮ ਜਾਨਿ ਤਾਸੁ ਨ ਸੂਝ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਹ ਦੂਖ ਭੂਖ ਪਿਆਸ ॥",
      "s": 7
    },
    {
      "t": "ਦਿਨ ਰੈਨਿ ਸਰਬ ਉਦਾਸ ॥੬॥",
      "s": 7
    },
    {
      "t": "ਨਹਿੰ ਚੈਨ ਐਨ ਸੁ ਵਾਹਿ ॥",
      "s": 7
    },
    {
      "t": "ਨਿਤ ਰੋਗ ਹੋਵਤ ਤਾਹਿ ॥",
      "s": 7
    },
    {
      "t": "ਅਤਿ ਦੂਖ ਭੂਖ ਮਰੰਤ ॥",
      "s": 7
    },
    {
      "t": "ਨਹੀ ਚੈਨ ਦਿਵਸ ਬਿਤੰਤ ॥੭॥",
      "s": 7
    },
    {
      "t": "ਤਨ ਪਾਦ ਕੁਸਟ ਚਲੰਤ ॥",
      "s": 7
    },
    {
      "t": "ਬਪੁ ਗਲਤ ਨਿਤ ਗਲੰਤ ॥",
      "s": 7
    },
    {
      "t": "ਨਹਿੰ ਨਿਤ ਦੇਹ ਅਰੋਗ ॥",
      "s": 7
    },
    {
      "t": "ਨਿਤਿ ਪੁਤ੍ਰ ਪੌਤ੍ਰਨ ਸੋਗ ॥੮॥",
      "s": 7
    },
    {
      "t": "ਨਿਤ ਨਾਸ ਤਿਹ ਪਰਿਵਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਨਹਿ ਅੰਤ ਦੇਹ ਉਧਾਰ ॥",
      "s": 7
    },
    {
      "t": "ਨਿਤ ਰੋਗ ਸੋਗ ਗ੍ਰਸੰਤ ॥",
      "s": 7
    },
    {
      "t": "ਮ੍ਰਿਤ ਸ੍ਵਾਨ ਅੰਤ ਮਰੰਤ ॥੯॥",
      "s": 7
    },
    {
      "t": "ਤਬ ਜਾਨਿ ਕਾਲ ਪ੍ਰਬੀਨ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਹ ਮਾਰਿਓ ਕਰਿ ਦੀਨ ॥",
      "s": 7
    },
    {
      "t": "ਇਕੁ ਕੀਟ ਦੀਨ ਉਪਾਇ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਸ ਕਾਨਿ ਪੈਠੋ ਜਾਇ ॥੧੦॥",
      "s": 7
    },
    {
      "t": "ਧਸਿ ਕੀਟ ਕਾਨਨ ਬੀਚ ॥",
      "s": 7
    },
    {
      "t": "ਤਿਸੁ ਜੀਤਯੋ ਜਿਮਿ ਨੀਚ ॥",
      "s": 7
    },
    {
      "t": "ਬਹੁ ਭਾਤਿ ਦੇਇ ਦੁਖ ਤਾਹਿ ॥",
      "s": 7
    },
    {
      "t": "ਇਹ ਭਾਤਿ ਮਾਰਿਓ ਵਾਹਿ ॥੧੧॥",
      "s": 7
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਮਹਿਦੀ ਮੀਰ ਬਧ ॥",
      "s": 7
    },
    {
      "t": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "s": 8
    },
    {
      "t": "ਅਥ ਬ੍ਰਹਮਾ ਅਵਤਾਰ ਕਥਨੰ ॥",
      "s": 8
    },
    {
      "t": "ਪਾਤਿਸਾਹੀ ੧੦ ॥",
      "s": 8
    },
    {
      "t": "ਤੋਮਰ ਛੰਦ ॥",
      "s": 8
    },
    {
      "t": "ਸਤਿਜੁਗਿ ਫਿਰਿ ਉਪਰਾਜਿ ॥",
      "s": 8
    },
    {
      "t": "ਸਬ ਨਉਤਨੈ ਕਰਿ ਸਾਜ ॥",
      "s": 8
    },
    {
      "t": "ਸਬ ਦੇਸ ਅਉਰ ਬਿਦੇਸ ॥",
      "s": 8
    },
    {
      "t": "ਉਠਿ ਧਰਮ ਲਾਗਿ ਨਰੇਸ ॥੧॥",
      "s": 8
    },
    {
      "t": "ਕਲਿ ਕਾਲ ਕੋਪਿ ਕਰਾਲ ॥",
      "s": 8
    },
    {
      "t": "ਜਗੁ ਜਾਰਿਆ ਤਿਹ ਜ੍ਵਾਲ ॥",
      "s": 8
    },
    {
      "t": "ਬਿਨੁ ਤਾਸੁ ਔਰ ਨ ਕੋਈ ॥",
      "s": 8
    },
    {
      "t": "ਸਬ ਜਾਪ ਜਾਪੋ ਸੋਇ ॥੨॥",
      "s": 8
    },
    {
