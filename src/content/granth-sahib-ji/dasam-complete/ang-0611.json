      "s": 8
    },
    {
      "t": "ਜਿਨ ਜਾਪਿਆ ਤਿਹਿ ਜਾਪੁ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 8
    },
    {
      "t": "ਤਿਨ ਕੇ ਸਹਾਈ ਆਪ ॥੪॥",
      "s": 8
    },
    {
      "t": "ਜੇ ਤਾਸੁ ਨਾਮ ਜਪੰਤ ॥",
      "s": 8
    },
    {
      "t": "ਕਬਹੂੰ ਨ ਭਾਜਿ ਚਲੰਤ ॥",
      "s": 8
    },
    {
      "t": "ਨਹਿ ਤ੍ਰਾਸੁ ਤਾ ਕੋ ਸਤ੍ਰ ॥",
      "s": 8
    },
    {
      "t": "ਦਿਸਿ ਜੀਤਿ ਹੈ ਗਹਿ ਅਤ੍ਰ ॥੫॥",
