      "s": 8
    },
    {
      "t": "ਕਈ ਰਾਮ ਕ੍ਰਿਸਨ ਰਸੂਲ ॥",
      "s": 8
    },
    {
      "t": "ਬਿਨੁ ਨਾਮ ਕੋ ਨ ਕਬੂਲ ॥੧੨॥",
      "s": 8
    },
    {
      "t": "ਬਿਨੁ ਏਕੁ ਆਸ੍ਰੈ ਨਾਮ ॥",
      "s": 8
    },
    {
      "t": "ਨਹੀ ਔਰ ਕੌਨੈ ਕਾਮ ॥",
      "s": 8
    },
    {
      "t": "ਜੇ ਮਾਨਿ ਹੈ ਗੁਰਦੇਵ ॥",
      "s": 8
    },
    {
      "t": "ਤੇ ਜਾਨਿ ਹੈ ਅਨਭੇਵ ॥੧੩॥",
      "s": 8
    },
    {
      "t": "ਬਿਨੁ ਤਾਸੁ ਔਰ ਨ ਜਾਨੁ ॥",
      "s": 8
    },
    {
      "t": "ਚਿਤ ਆਨ ਭਾਵ ਨ ਆਨੁ ॥",
      "s": 8
    },
    {
      "t": "ਇਕ ਮਾਨਿ ਜੈ ਕਰਤਾਰ ॥",
      "s": 8
    },
    {
      "t": "ਜਿਤੁ ਹੋਇ ਅੰਤਿ ਉਧਾਰੁ ॥੧੪॥",
      "s": 8
    },
    {
      "t": "ਬਿਨੁ ਤਾਸ ਯੌ ਨ ਉਧਾਰੁ ॥",
      "s": 8
    },
    {
      "t": "ਜੀਅ ਦੇਖਿ ਯਾਰ ਬਿਚਾਰਿ ॥",
      "s": 8
    },
    {
      "t": "ਜੋ ਜਾਪਿ ਹੈ ਕੋਈ ਔਰ ॥",
      "s": 8
    },
    {
      "t": "ਤਬ ਛੂਟਿ ਹੈ ਵਹ ਠੌਰ ॥੧੫॥",
      "s": 8
    },
    {
      "t": "ਜਿਹ ਰਾਗ ਰੰਗ ਨ ਰੂਪ ॥",
      "s": 8
    },
    {
      "t": "ਸੋ ਮਾਨੀਐ ਸਮ ਰੂਪ ॥",
      "s": 8
    },
    {
      "t": "ਬਿਨੁ ਏਕ ਤਾ ਕਰ ਨਾਮ ॥",
      "s": 8
    },
    {
      "t": "ਨਹਿ ਜਾਨ ਦੂਸਰ ਧਾਮ ॥੧੬॥",
      "s": 8
    },
    {
      "t": "ਜੋ ਲੋਕ ਅਲੋਕ ਬਨਾਇ ॥",
      "s": 8
    },
    {
      "t": "ਫਿਰ ਲੇਤ ਆਪਿ ਮਿਲਾਇ ॥",
      "s": 8
    },
    {
      "t": "ਜੋ ਚਹੈ ਦੇਹ ਉਧਾਰੁ ॥",
      "s": 8
    },
    {
      "t": "ਸੋ ਭਜਨ ਏਕੰਕਾਰ ॥੧੭॥",
      "s": 8
    },
    {
      "t": "ਜਿਨਿ ਰਾਚਿਯੋ ਬ੍ਰਹਮੰਡ ॥",
      "s": 8
    },
    {
      "t": "ਸਬ ਲੋਕ ਔ ਨਵ ਖੰਡ ॥",
      "s": 8
    },
    {
      "t": "ਤਿਹ ਕਿਉ ਨ ਜਾਪ ਜਪੰਤ ॥",
      "s": 8
    },
    {
      "t": "ਕਿਮ ਜਾਨ ਕੂਪਿ ਪਰੰਤ ॥੧੮॥",
      "s": 8
    },
    {
      "t": "ਜੜ ਜਾਪ ਤਾ ਕਰ ਜਾਪ ॥",
