{
  "page": 615,
  "lines": [
    {
      "t": "ਅਬ ਕਹੋ ਤੋਹਿ ਤੀਸ੍ਰ ਬਿਚਾਰ ॥",
      "s": 8
    },
    {
      "t": "ਜਿਹ ਭਾਤਿ ਧਰ੍ਯੋ ਬਪੁ ਬ੍ਰਹਮ ਰਾਇ ॥",
      "s": 8
    },
    {
      "t": "ਸਭ ਕਹ੍ਯੋ ਤਾਹਿ ਨੀਕੇ ਸੁਭਾਇ ॥੯॥",
      "s": 8
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਦੁਤੀਯ ਅਵਤਾਰੇ ਬ੍ਰਹਮਾ ਕਸਪ ਸਮਾਪਤੰ ॥੨॥",
      "s": 8
    },
    {
      "t": "ਅਥ ਤ੍ਰਿਤੀਆ ਅਵਤਾਰ ਸੁਕ੍ਰ ਕਥਨੰ ॥",
      "s": 8
    },
    {
      "t": "ਪਾਧੜੀ ਛੰਦ ॥",
      "s": 8
    },
    {
      "t": "ਪੁਨਿ ਧਰਾ ਤੀਸਰ ਇਹ ਭਾਤਿ ਰੂਪ ॥",
      "s": 8
    },
    {
      "t": "ਜਗਿ ਭਯੋ ਆਨ ਕਰਿ ਦੈਤ ਭੂਪ ॥",
      "s": 8
    },
    {
      "t": "ਤਬ ਦੇਬ ਬੰਸ ਪ੍ਰਚੁਰ੍ਯੋ ਅਪਾਰ ॥",
      "s": 8
    },
    {
      "t": "ਕੀਨੇ ਸੁ ਰਾਜ ਪ੍ਰਿਥਮੀ ਸੁਧਾਰਿ ॥੧॥",
      "s": 8
    },
    {
      "t": "ਬਡ ਪੁਤ੍ਰ ਜਾਨਿ ਕਿਨੀ ਸਹਾਇ ॥",
      "s": 8
    },
    {
      "t": "ਤੀਸਰ ਅਵਤਾਰ ਭਇਓ ਸੁਕ੍ਰ ਰਾਇ ॥",
      "s": 8
    },
    {
      "t": "ਨਿੰਦਾ ਬ੍ਰਯਾਜ ਉਸਤਤੀ ਕੀਨ ॥",
      "s": 8
    },
    {
      "t": "ਲਖਿ ਤਾਸੁ ਦੇਵਤਾ ਭਏ ਛੀਨ ॥੨॥",
      "s": 8
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗੰਥੇ ਤ੍ਰਿਤੀਆ ਅਵਤਾਰ ਬ੍ਰਹਮਾ ਸੁਕ੍ਰ ਸਮਾਪਤੰ ॥੩॥",
      "s": 8
    },
    {
      "t": "ਅਥ ਚਤੁਰਥ ਬ੍ਰਹਮਾ ਬਚੇਸ ਕਥਨੰ ॥",
      "s": 8
    },
    {
      "t": "ਪਾਧੜੀ ਛੰਦ ॥",
      "s": 8
    },
    {
      "t": "ਮਿਲਿ ਦੀਨ ਦੇਵਤਾ ਲਗੇ ਸੇਵ ॥",
      "s": 8
    },
    {
      "t": "ਬੀਤੇ ਸੌ ਬਰਖ ਰੀਝੇ ਗੁਰਦੇਵ ॥",
      "s": 8
    },
    {
      "t": "ਤਬ ਧਰਾ ਰੂਪ ਬਾਚੇਸ ਆਨਿ ॥",
      "s": 8
    },
    {
      "t": "ਜੀਤਾ ਸੁਰੇਸ ਭਈ ਅਸੁਰ ਹਾਨਿ ॥੩॥",
      "s": 8
    },
    {
      "t": "ਇਹ ਭਾਤਿ ਧਰਾ ਚਤੁਰਥ ਵਤਾਰ ॥",
      "s": 8
    },
    {
      "t": "ਜੀਤਾ ਸੁਰੇਸ ਹਾਰੇ ਦਿਵਾਰ ॥",
      "s": 8
    },
    {
      "t": "ਉਠਿ ਦੇਵ ਸੇਵ ਲਾਗੇ ਸੁ ਸਰਬ ॥",
      "s": 8
    },
    {
      "t": "ਧਰਿ ਨੀਚ ਨੈਨ ਕਰਿ ਦੂਰ ਗਰਬ ॥੪॥",
      "s": 8
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਚਤੁਰਥ ਅਵਤਾਰ ਬ੍ਰਹਮਾ ਬਚੇਸ ਸਮਾਪਤੰ ॥੪॥",
      "s": 8
    },
    {
      "t": "ਅਥ ਪੰਚਮੋ ਅਵਤਾਰ ਬ੍ਰਹਮਾ ਬਿਆਸ ਮਨੁ ਰਾਜਾ ਕੋ ਰਾਜ ਕਥਨੰ ॥",
      "s": 8
    },
    {
      "t": "ਪਾਧੜੀ ਛੰਦ ॥",
      "s": 8
    },
    {
      "t": "ਤ੍ਰੇਤਾ ਬਿਤੀਤ ਜੁਗ ਦੁਆਪੁਰਾਨ ॥",
      "s": 8
    },
    {
      "t": "ਬਹੁ ਭਾਤਿ ਦੇਖ ਖੇਲੇ ਖਿਲਾਨ ॥",
      "s": 8
    },
    {
      "t": "ਜਬ ਭਯੋ ਆਨਿ ਕ੍ਰਿਸਨਾਵਤਾਰ ॥",
      "s": 8
    },
    {
      "t": "ਤਬ ਭਏ ਬ੍ਯਾਸ ਮੁਖ ਆਨਿ ਚਾਰ ॥੫॥",
      "s": 8
    },
    {
      "t": "ਜੇ ਜੇ ਚਰਿਤ੍ਰ ਕੀਅ ਕ੍ਰਿਸਨ ਦੇਵ ॥",
      "s": 8
    },
    {
      "t": "ਤੇ ਤੇ ਭਨੇ ਸੁ ਸਾਰਦਾ ਤੇਵ ॥",
      "s": 8
    },
    {
      "t": "ਅਬ ਕਹੋ ਤਉਨ ਸੰਛੇਪ ਠਾਨਿ ॥",
      "s": 8
    },
    {
      "t": "ਜਿਹ ਭਾਤਿ ਕੀਨ ਸ੍ਰੀ ਅਭਿਰਾਮ ॥੬॥",
      "s": 8
    },
    {
      "t": "ਜਿਹ ਭਾਤਿ ਕਥਿ ਕੀਨੋ ਪਸਾਰ ॥",
      "s": 8
    },
    {
      "t": "ਤਿਹ ਭਾਤਿ ਕਾਬਿ ਕਥਿ ਹੈ ਬਿਚਾਰ ॥",
      "s": 8
    },
    {
      "t": "ਕਹੋ ਜੈਸ ਕਾਬ੍ਰਯ ਕਹਿਯੋ ਬ੍ਯਾਸ ॥",
      "s": 8
    },
    {
      "t": "ਤਉਨੇ ਕਥਾਨ ਕਥੋ ਪ੍ਰਭਾਸ ॥੭॥",
      "s": 8
    },
    {
      "t": "ਜੇ ਭਏ ਭੂਪ ਭੂਅ ਮੋ ਮਹਾਨ ॥",
      "s": 8
    },
    {
      "t": "ਤਿਨ ਕੋ ਸੁਜਾਨ ਕਥਤ ਕਹਾਨ ॥",
      "s": 8
    },
    {
      "t": "ਕਹ ਲਗੇ ਤਾਸਿ ਕਿਜੈ ਬਿਚਾਰੁ ॥",
      "s": 8
    },
    {
      "t": "ਸੁਣਿ ਲੇਹੁ ਬੈਣ ਸੰਛੇਪ ਯਾਰ ॥੮॥",
      "s": 8
    },
    {
      "t": "ਜੇ ਭਏ ਭੂਪ ਤੇ ਕਹੇ ਬ੍ਯਾਸ ॥",
      "s": 8
    },
    {
      "t": "ਹੋਵਤ ਪੁਰਾਣ ਤੇ ਨਾਮ ਭਾਸ ॥",
      "s": 8
    },
    {
      "t": "ਮਨੁ ਭਯੋ ਰਾਜ ਮਹਿ ਕੋ ਭੂਆਰ ॥",
      "s": 8
    },
    {
      "t": "ਖੜਗਨ ਸੁ ਪਾਨਿ ਮਹਿਮਾ ਅਪਾਰ ॥੯॥",
      "s": 8
    },
    {
      "t": "ਮਾਨਵੀ ਸ੍ਰਿਸਟਿ ਕਿਨੀ ਪ੍ਰਕਾਸ ॥",
      "s": 8
    },
    {
      "t": "ਦਸ ਚਾਰ ਲੋਕ ਆਭਾ ਅਭਾਸ ॥",
      "s": 8
    },
    {
      "t": "ਮਹਿਮਾ ਅਪਾਰ ਬਰਨੇ ਸੁ ਕਉਨ ॥",
      "s": 8
    },
    {
      "t": "ਸੁਣਿ ਸ੍ਰਵਣ ਕ੍ਰਿਤ ਹੁਇ ਰਹੈ ਮਉਨ ॥੧੦॥",
      "s": 8
    },
    {
      "t": "ਦਸ ਚਾਰ ਚਾਰਿ ਬਿਦਿਆ ਨਿਧਾਨ ॥",
      "s": 8
    },
    {
      "t": "ਅਰਿ ਜੀਤਿ ਜੀਤਿ ਦਿਨੋ ਨਿਸਾਨ ॥",
      "s": 8
    },
    {
      "t": "ਮੰਡੇ ਮਹੀਪ ਮਾਵਾਸ ਖੇਤਿ ॥",
      "s": 8
    },
    {
      "t": "ਗਜੇ ਮਸਾਣ ਨਚੇ ਪਰੇਤ ॥੧੧॥",
      "s": 8
    },
    {
      "t": "ਜਿਤੇ ਸੁ ਦੇਸ ਏਸੁਰ ਮਵਾਸ ॥",
      "s": 8
    },
    {
      "t": "ਕਿਨੇ ਖਰਾਬ ਖਾਨੇ ਖ੍ਵਾਸ ॥",
      "s": 8
    },
    {
      "t": "ਭੰਡੇ ਅਭੰਡ ਮੰਡੇ ਮਹੀਪ ॥",
      "s": 8
    },
    {
      "t": "ਦਿਨੇ ਨਿਕਾਰ ਛਿਨੇ ਸੁ ਦੀਪ ॥੧੨॥",
      "s": 8
    },
    {
      "t": "ਖੰਡੇ ਸੁ ਖੇਤਿ ਖੂਨੀ ਖਤ੍ਰੀਯਾਣ ॥",
      "s": 8
    },
    {
      "t": "ਮੋਰੇ ਅਮੋਰ ਜੋਧਾ ਦੁਰਾਣ ॥",
      "s": 8
    },
    {
      "t": "ਚਲੇ ਅਚਲ ਮੰਡੇ ਅਮੰਡ ॥",
      "s": 8
    },
    {
      "t": "ਕਿਨੇ ਘਮੰਡ ਖੰਡੇ ਪ੍ਰਚੰਡ ॥੧੩॥",
      "s": 8
    },
    {
      "t": "ਕਿਨੇ ਸੁ ਜੇਰ ਖੂਨੀ ਖਤ੍ਰੇਸ ॥",
      "s": 8
    },
    {
      "t": "ਮੰਡੇ ਮਹੀਪ ਮਾਵਾਸ ਦੇਸ ॥",
      "s": 8
    },
    {
      "t": "ਇਹ ਭਾਤਿ ਦੀਹ ਦੋਹੀ ਫਿਰਾਇ ॥",
      "s": 8
    },
    {
      "t": "ਮਾਨੀ ਸੁ ਮਾਨਿ ਮਨੁ ਰਾਜ ਰਾਇ ॥੧੪॥",
      "s": 8
    },
    {
      "t": "ਇਹ ਭਾਤਿ ਦੀਹ ਕਰਿ ਦੇਸ ਰਾਜ ॥",
      "s": 8
    },
    {
      "t": "ਬਹੁ ਕਰੇ ਜਗਿ ਅਰੁ ਹੋਮ ਸਾਜ ॥",
      "s": 8
    },
    {
      "t": "ਬਹੁ ਭਾਤਿ ਸ੍ਵਰਣ ਕਰਿ ਕੈ ਸੁ ਦਾਨ ॥",
      "s": 8
    },
    {
      "t": "ਗੋਦਾਨ ਆਦਿ ਬਿਧਵਤ ਸਨਾਨ ॥੧੫॥",
      "s": 8
    }
  ]
}
