{
  "page": 616,
  "lines": [
    {
      "t": "ਜੋ ਹੁਤੀ ਜਗ ਅਰੁ ਬੇਦ ਰੀਤਿ ॥",
      "s": 8
    },
    {
      "t": "ਸੋ ਕਰੀ ਸਰਬ ਨ੍ਰਿਪ ਲਾਇ ਪ੍ਰੀਤਿ ॥",
      "s": 8
    },
    {
      "t": "ਭੂਆ ਦਾਨ ਦਾਨ ਰਤਨਾਦਿ ਆਦਿ ॥",
      "s": 8
    },
    {
      "t": "ਤਿਨ ਭਾਤਿ ਭਾਤਿ ਲਿਨੇ ਸੁਵਾਦ ॥੧੬॥",
      "s": 8
    },
    {
      "t": "ਕਰਿ ਦੇਸ ਦੇਸ ਇਮਿ ਨੀਤਿ ਰਾਜ ॥",
      "s": 8
    },
    {
      "t": "ਬਹੁ ਭਾਤਿ ਦਾਨ ਦੇ ਸਰਬ ਸਾਜ ॥",
      "s": 8
    },
    {
      "t": "ਹਸਤਾਦਿ ਦਤ ਬਾਜਾਦਿ ਮੇਧ ॥",
      "s": 8
    },
    {
      "t": "ਤੇ ਭਾਤਿ ਭਾਤਿ ਕਿਨੇ ਨ੍ਰਿਪੇਧ ॥੧੭॥",
      "s": 8
    },
    {
      "t": "ਬਹੁ ਸਾਜ ਬਾਜ ਦਿਨੇ ਦਿਜਾਨ ॥",
      "s": 8
    },
    {
      "t": "ਦਸ ਚਾਰੁ ਚਾਰੁ ਬਿਦਿਆ ਸੁਜਾਨ ॥",
      "s": 8
    },
    {
      "t": "ਖਟ ਚਾਰ ਸਾਸਤ੍ਰ ਸਿੰਮ੍ਰਿਤ ਰਟੰਤ ॥",
      "s": 8
    },
    {
      "t": "ਕੋਕਾਦਿ ਭੇਦ ਬੀਨਾ ਬਜੰਤ ॥੧੮॥",
      "s": 8
    },
    {
      "t": "ਘਨਸਾਰ ਘੋਰਿ ਘਸੀਅਤ ਗੁਲਾਬ ॥",
      "s": 8
    },
    {
      "t": "ਮ੍ਰਿਗ ਮਦਿਤ ਡਾਰਿ ਚੂਵਤ ਸਰਾਬ ॥",
      "s": 8
    },
    {
      "t": "ਕਸਮੀਰ ਘਾਸ ਘੋਰਤ ਸੁਬਾਸ ॥",
      "s": 8
    },
    {
      "t": "ਉਘਟਤ ਸੁਗੰਧ ਮਹਕੰਤ ਅਵਾਸ ॥੧੯॥",
      "s": 8
    },
    {
      "t": "ਸੰਗੀਤ ਪਾਧਰੀ ਛੰਦ ॥",
      "s": 8
    },
    {
      "t": "ਤਾਗੜਦੰ ਤਾਲ ਬਾਜਤ ਮੁਚੰਗ ॥",
      "s": 8
    },
    {
      "t": "ਬੀਨਾ ਸੁ ਬੈਣ ਬੰਸੀ ਮ੍ਰਿਦੰਗ ॥",
      "s": 8
    },
    {
      "t": "ਡਫ ਤਾਲ ਤੁਰੀ ਸਹਿਨਾਇ ਰਾਗ ॥",
      "s": 8
    },
    {
      "t": "ਬਾਜੰਤ ਜਾਨ ਉਪਨਤ ਸੁਹਾਗ ॥੨੦॥",
      "s": 8
    },
    {
      "t": "ਕਹੂੰ ਤਾਲ ਤੂਰ ਬੀਨਾ ਮ੍ਰਿਦੰਗ ॥",
      "s": 8
    },
    {
      "t": "ਡਫ ਝਾਝ ਢੋਲ ਜਲਤਰ ਉਪੰਗ ॥",
      "s": 8
    },
    {
      "t": "ਜਹ ਜਹ ਬਿਲੋਕ ਤਹ ਤਹ ਸੁਬਾਸ ॥",
      "s": 8
    },
    {
      "t": "ਉਠਤ ਸੁਗੰਧ ਮਹਕੰਤ ਅਵਾਸ ॥੨੧॥",
      "s": 8
    },
    {
      "t": "ਹਰਿ ਬੋਲ ਮਨਾ ਛੰਦ ॥",
      "s": 8
    },
    {
      "t": "ਮਨੁ ਰਾਜ ਕਰ੍ਯੋ ॥",
      "s": 8
    },
    {
      "t": "ਦੁਖ ਦੇਸ ਹਰ੍ਯੋ ॥",
      "s": 8
    },
    {
      "t": "ਬਹੁ ਸਾਜ ਸਜੇ ॥",
      "s": 8
    },
    {
      "t": "ਸੁਨਿ ਦੇਵ ਲਜੇ ॥੨੨॥",
      "s": 8
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕੇ ਮਨੁ ਰਾਜਾ ਕੋ ਰਾਜ ਸਮਾਪਤੰ ॥੧॥੫॥",
      "s": 8
    },
    {
      "t": "ਅਥ ਪ੍ਰਿਥੁ ਰਾਜਾ ਕੋ ਰਾਜ ਕਥਨੰ ॥",
      "s": 8
    },
    {
      "t": "ਤੋਟਕ ਛੰਦ ॥",
      "s": 8
    },
    {
      "t": "ਕਹੰ ਲਾਗ ਗਨੋ ਨ੍ਰਿਪ ਜੌਨ ਭਏ ॥",
      "s": 8
    },
    {
      "t": "ਪ੍ਰਭੁ ਜੋਤਹਿ ਜੋਤਿ ਮਿਲਾਇ ਲਏ ॥",
      "s": 8
    },
    {
      "t": "ਪੁਨਿ ਸ੍ਰੀ ਪ੍ਰਿਥਰਾਜ ਪ੍ਰਿਥੀਸ ਭਯੋ ॥",
      "s": 8
    },
    {
      "t": "ਜਿਨਿ ਬਿਪਨ ਦਾਨ ਦੁਰੰਤ ਦਯੋ ॥੨੩॥",
      "s": 8
    },
    {
      "t": "ਦਲੁ ਲੈ ਦਿਨ ਏਕ ਸਿਕਾਰ ਚੜੇ ॥",
      "s": 8
    },
    {
      "t": "ਬਨਿ ਨਿਰਜਨ ਮੋ ਲਖਿ ਬਾਘ ਬੜੇ ॥",
      "s": 8
    },
    {
      "t": "ਤਹ ਨਾਰਿ ਸੁਕੁੰਤਲ ਤੇਜ ਧਰੇ ॥",
      "s": 8
    },
    {
      "t": "ਸਸਿ ਸੂਰਜ ਕੀ ਲਖਿ ਕ੍ਰਾਤਿ ਹਰੇ ॥੨੪॥",
      "s": 8
    },
    {
      "t": "ਹਰਿ ਬੋਲ ਮਨਾ ਛੰਦ ॥",
      "s": 8
    },
    {
      "t": "ਤਹ ਜਾਤ ਭਏ ॥",
      "s": 8
    },
    {
      "t": "ਮ੍ਰਿਗ ਘਾਤ ਕਏ ॥",
      "s": 8
    },
    {
      "t": "ਇਕ ਦੇਖਿ ਕੁਟੀ ॥",
      "s": 8
    },
    {
      "t": "ਜਨੁ ਜੋਗ ਜੁਟੀ ॥੨੫॥",
      "s": 8
    },
    {
      "t": "ਤਹ ਜਾਤ ਭਯੋ ॥",
      "s": 8
    },
    {
      "t": "ਸੰਗ ਕੋ ਨ ਲਯੋ ॥",
      "s": 8
    }
  ]
}
