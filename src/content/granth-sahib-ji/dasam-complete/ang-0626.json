{
  "page": 626,
  "lines": [
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਤਿਨਿ ਕੀਨੋ ਰਾਜਾ ॥",
      "s": 8
    },
    {
      "t": "ਦੇਸ ਦੇਸ ਕੇ ਜੀਤਿ ਸਮਾਜਾ ॥",
      "s": 8
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਕੇ ਦੇਸ ਛਿਨਾਏ ॥",
      "s": 8
    },
    {
      "t": "ਪੈਗ ਪੈਗ ਪਰ ਜਗਿ ਕਰਾਏ ॥੧੫੭॥",
      "s": 8
    },
    {
      "t": "ਪਗ ਪਗ ਜਗਿ ਖੰਭ ਕਹੁ ਗਾਡਾ ॥",
      "s": 8
    },
    {
      "t": "ਡਗ ਡਗ ਹੋਮ ਮੰਤ੍ਰ ਕਰਿ ਛਾਡਾ ॥",
      "s": 8
    },
    {
      "t": "ਐਸੀ ਧਰਾ ਨ ਦਿਖੀਅਤ ਕੋਈ ॥",
      "s": 8
    },
    {
      "t": "ਜਗਿ ਖੰਭ ਜਿਹ ਠਉਰ ਨ ਹੋਈ ॥੧੫੮॥",
      "s": 8
    },
    {
      "t": "ਗਵਾਲੰਭ ਬਹੁ ਜਗ ਕਰੇ ਬਰ ॥",
      "s": 8
    },
    {
      "t": "ਬ੍ਰਹਮਣ ਬੋਲਿ ਬਿਸੇਖ ਧਰਮਧਰ ॥",
      "s": 8
    },
    {
      "t": "ਬਾਜਮੇਧ ਬਹੁ ਬਾਰਨ ਕੀਨੇ ॥",
      "s": 8
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਭੂਯ ਕੇ ਰਸ ਲੀਨੇ ॥੧੫੯॥",
      "s": 8
    },
    {
      "t": "ਗਜਾ ਮੇਧ ਬਹੁ ਕਰੇ ਜਗਿ ਤਿਹ ॥",
      "s": 8
    },
    {
      "t": "ਅਜਾ ਮੇਧ ਤੇ ਸਕੈ ਨ ਗਨ ਕਿਹ ॥",
      "s": 8
    },
    {
      "t": "ਗਵਾਲੰਭ ਕਰਿ ਬਿਧਿ ਪ੍ਰਕਾਰੰ ॥",
      "s": 8
    },
    {
      "t": "ਪਸੁ ਅਨੇਕ ਮਾਰੇ ਤਿਹ ਬਾਰੰ ॥੧੬੦॥",
      "s": 8
    },
    {
      "t": "ਰਾਜਸੂਅ ਕਰਿ ਬਿਬਿਧ ਪ੍ਰਕਾਰੰ ॥",
      "s": 8
    },
    {
      "t": "ਦੁਤੀਆ ਇੰਦ੍ਰ ਰਘੁ ਰਾਜ ਅਪਾਰੰ ॥",
      "s": 8
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਕੇ ਬਿਧਵਤ ਦਾਨਾ ॥",
      "s": 8
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਕਰ ਤੀਰਥ ਨਾਨਾ ॥੧੬੧॥",
      "s": 8
    },
    {
      "t": "ਸਰਬ ਤੀਰਥ ਪਰਿ ਪਾਵਰ ਬਾਧਾ ॥",
      "s": 8
    },
    {
      "t": "ਅੰਨ ਛੇਤ੍ਰ ਘਰਿ ਘਰਿ ਮੈ ਸਾਧਾ ॥",
      "s": 8
    },
    {
      "t": "ਆਸਾਵੰਤ ਕਹੂੰ ਕੋਈ ਆਵੈ ॥",
      "s": 8
    },
    {
      "t": "ਤਤਛਿਨ ਮੁਖ ਮੰਗੈ ਸੋ ਪਾਵੈ ॥੧੬੨॥",
      "s": 8
    },
    {
      "t": "ਭੂਖ ਨਾਗ ਕੋਈ ਰਹਨ ਨ ਪਾਵੈ ॥",
      "s": 8
    },
    {
      "t": "ਭੂਪਤਿ ਹੁਐ ਕਰਿ ਰੰਕ ਸਿਧਾਵੈ ॥",
      "s": 8
    },
    {
      "t": "ਬਹੁਰ ਦਾਨ ਕਹ ਕਰ ਨ ਪਸਾਰਾ ॥",
      "s": 8
    },
    {
      "t": "ਏਕ ਬਾਰਿ ਰਘੁ ਰਾਜ ਨਿਹਾਰਾ ॥੧੬੩॥",
      "s": 8
    },
    {
      "t": "ਸ੍ਵਰਣ ਦਾਨ ਦੇ ਬਿਬਿਧ ਪ੍ਰਕਾਰਾ ॥",
      "s": 8
    },
    {
      "t": "ਰੁਕਮ ਦਾਨ ਨਹੀ ਪਾਯਤ ਪਾਰਾ ॥",
      "s": 8
    },
    {
      "t": "ਸਾਜਿ ਸਾਜਿ ਬਹੁ ਦੀਨੇ ਬਾਜਾ ॥",
      "s": 8
    },
    {
      "t": "ਜਨ ਸਭ ਕਰੇ ਰੰਕ ਰਘੁ ਰਾਜਾ ॥੧੬੪॥",
      "s": 8
    },
    {
      "t": "ਹਸਤ ਦਾਨ ਅਰ ਉਸਟਨ ਦਾਨਾ ॥",
      "s": 8
    },
    {
      "t": "ਗਊ ਦਾਨ ਬਿਧਿਵਤ ਇਸਨਾਨਾ ॥",
      "s": 8
    },
    {
      "t": "ਹੀਰ ਚੀਰ ਦੇ ਦਾਨ ਅਪਾਰਾ ॥",
      "s": 8
    },
    {
      "t": "ਮੋਹ ਸਬੈ ਮਹਿ ਮੰਡਲ ਡਾਰਾ ॥੧੬੫॥",
      "s": 8
    },
    {
      "t": "ਬਾਜੀ ਦੇਤ ਗਜਨ ਕੇ ਦਾਨਾ ॥",
      "s": 8
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਦੀਨਨ ਸਨਮਾਨਾ ॥",
      "s": 8
    },
    {
      "t": "ਦੂਖ ਭੂਖ ਕਾਹੂੰ ਨ ਸੰਤਾਵੈ ॥",
      "s": 8
    },
    {
      "t": "ਜੋ ਮੁਖ ਮਾਗੈ ਵਹ ਬਰੁ ਪਾਵੈ ॥੧੬੬॥",
      "s": 8
    },
    {
      "t": "ਦਾਨ ਸੀਲ ਕੋ ਜਾਨ ਪਹਾਰਾ ॥",
      "s": 8
    },
    {
      "t": "ਦਇਆ ਸਿੰਧ ਰਘੁ ਰਾਜ ਭੁਆਰਾ ॥",
      "s": 8
    },
    {
      "t": "ਸੁੰਦਰ ਮਹਾ ਧਨੁਖ ਧਰ ਆਛਾ ॥",
      "s": 8
    },
    {
      "t": "ਜਨੁ ਅਲਿਪਨਚ ਕਾਛ ਤਨ ਕਾਛਾ ॥੧੬੭॥",
      "s": 8
    },
    {
      "t": "ਨਿਤਿ ਉਠਿ ਕਰਤ ਦੇਵ ਕੀ ਪੂਜਾ ॥",
      "s": 8
    },
    {
      "t": "ਫੂਲ ਗੁਲਾਬ ਕੇਵੜਾ ਕੂਜਾ ॥",
      "s": 8
    },
    {
      "t": "ਚਰਨ ਕਮਲ ਨਿਤਿ ਸੀਸ ਲਗਾਵੈ ॥",
      "s": 8
    },
    {
      "t": "ਪੂਜਨ ਨਿਤ ਚੰਡਿਕਾ ਆਵੈ ॥੧੬੮॥",
      "s": 8
    },
    {
      "t": "ਧਰਮ ਰੀਤਿ ਸਬ ਠੌਰ ਚਲਾਈ ॥",
      "s": 8
    },
    {
      "t": "ਜਤ੍ਰ ਤਤ੍ਰ ਸੁਖ ਬਸੀ ਲੁਗਾਈ ॥",
      "s": 8
    },
    {
      "t": "ਭੂਖ ਨਾਗ ਕੋਈ ਕਹੂੰ ਨ ਦੇਖਾ ॥",
      "s": 8
    },
    {
      "t": "ਊਚ ਨੀਚ ਸਬ ਧਨੀ ਬਿਸੇਖਾ ॥੧੬੯॥",
      "s": 8
    },
    {
      "t": "ਜਹ ਤਹ ਧਰਮ ਧੁਜਾ ਫਹਰਾਈ ॥",
      "s": 8
    },
    {
      "t": "ਚੋਰ ਜਾਰ ਨਹ ਦੇਤ ਦਿਖਾਈ ॥",
      "s": 8
    },
    {
      "t": "ਜਹ ਤਹ ਯਾਰ ਚੋਰ ਚੁਨਿ ਮਾਰਾ ॥",
      "s": 8
    },
    {
      "t": "ਏਕ ਦੇਸਿ ਕਹੂੰ ਰਹੈ ਨ ਪਾਰਾ ॥੧੭੦॥",
      "s": 8
    },
    {
      "t": "ਸਾਧ ਓਰਿ ਕੋਈ ਦਿਸਟਿ ਨ ਪੇਖਾ ॥",
      "s": 8
    },
    {
      "t": "ਐਸ ਰਾਜ ਰਘੁ ਰਾਜ ਬਿਸੇਖਵਾ ॥",
      "s": 8
    },
    {
      "t": "ਚਾਰੋ ਦਿਸਾ ਚਕ੍ਰ ਫਹਰਾਵੈ ॥",
      "s": 8
    },
    {
      "t": "ਪਾਪਿਨ ਕਾਟਿ ਮੂੰਡ ਫਿਰਿ ਆਵੈ ॥੧੭੧॥",
      "s": 8
    },
    {
      "t": "ਗਾਇ ਸਿੰਘ ਕਹੁ ਦੂਧ ਪਿਲਾਵੈ ॥",
      "s": 8
    },
    {
      "t": "ਸਿੰਘ ਗਊ ਕਹ ਘਾਸੁ ਚੁਗਾਵੈ ॥",
      "s": 8
    },
    {
      "t": "ਚੋਰ ਕਰਤ ਧਨ ਕੀ ਰਖਵਾਰਾ ॥",
      "s": 8
    },
    {
      "t": "ਤ੍ਰਾਸ ਮਾਰਿ ਕੋਈ ਹਾਥੁ ਨ ਡਾਰਾ ॥੧੭੨॥",
      "s": 8
    },
    {
      "t": "ਨਾਰਿ ਪੁਰਖ ਸੋਵਤ ਇਕ ਸੇਜਾ ॥",
      "s": 8
    },
    {
      "t": "ਹਾਥ ਪਸਾਰ ਨ ਸਾਕਤ ਰੇਜਾ ॥",
      "s": 8
    },
    {
      "t": "ਪਾਵਕ ਘ੍ਰਿਤ ਇਕ ਠਉਰ ਰਖਾਏ ॥",
      "s": 8
    },
    {
      "t": "ਰਾਜ ਤ੍ਰਾਸ ਤੇ ਢਰੈ ਨ ਪਾਏ ॥੧੭੩॥",
      "s": 8
    },
    {
      "t": "ਚੋਰ ਸਾਧ ਮਗ ਏਕ ਸਿਧਾਰੈ ॥",
      "s": 8
    },
    {
      "t": "ਤ੍ਰਾਸ ਤ੍ਰਸਤ ਕਰੁ ਕੋਈ ਨ ਡਾਰੈ ॥",
      "s": 8
    },
    {
      "t": "ਗਾਇ ਸਿੰਘ ਇਕ ਖੇਤ ਫਿਰਾਹੀ ॥",
      "s": 8
    },
    {
      "t": "ਹਾਥ ਚਲਾਇ ਸਕਤ ਕੋਈ ਨਾਹੀ ॥੧੭੪॥",
      "s": 8
    }
  ]
}
