{
  "page": 629,
  "lines": [
    {
      "t": "ਪੇਖਤ ਰੀਝਤ ਬੀਰ ਰਸਾਲੀਯ ॥",
      "s": 8
    },
    {
      "t": "ਨਾਚਤ ਭਾਵ ਅਨੇਕ ਤ੍ਰੀਆ ਕਰਿ ॥",
      "s": 8
    },
    {
      "t": "ਦੇਖਤ ਸੋਭਾ ਰੀਝਤ ਸੁਰ ਨਰ ॥੨੬॥",
      "s": 8
    },
    {
      "t": "ਹਿੰਸਤ ਹੈਵਰ ਚਿੰਸਤ ਹਾਥੀ ॥",
      "s": 8
    },
    {
      "t": "ਨਾਚਤ ਨਾਗਰਿ ਗਾਵਤ ਗਾਥੀ ॥",
      "s": 8
    },
    {
      "t": "ਰੀਝਤ ਸੁਰ ਨਰ ਮੋਹਤ ਰਾਜਾ ॥",
      "s": 8
    },
    {
      "t": "ਦੇਵਤ ਦਾਨ ਤੁਰੰਤ ਸਮਾਜਾ ॥੨੭॥",
      "s": 8
    },
    {
      "t": "ਗਾਵਤ ਗੀਤਨ ਨਾਚਤ ਅਪਛਰਾ ॥",
      "s": 8
    },
    {
      "t": "ਰੀਝਤ ਰਾਜਾ ਖੀਝਤ ਅਛਰਾ ॥",
      "s": 8
    },
    {
      "t": "ਬਾਜਤ ਨਾਰਦ ਬੀਨ ਰਸਾਲੀ ॥",
      "s": 8
    },
    {
      "t": "ਦੇਖਤ ਦੇਵ ਪ੍ਰਭਾਸਤ ਜ੍ਵਾਲੀ ॥੨੮॥",
      "s": 8
    },
    {
      "t": "ਆਂਜਤ ਅੰਜਨ ਸਾਜਤ ਅੰਗਾ ॥",
      "s": 8
    },
    {
      "t": "ਸੋਭਤ ਬਸਤ੍ਰ ਸੁ ਅੰਗ ਸੁਰੰਗਾ ॥",
      "s": 8
    },
    {
      "t": "ਨਾਚਤ ਅਛ੍ਰੀ ਰੀਝਤ ਰਾਊ ॥",
      "s": 8
    },
    {
      "t": "ਚਾਹਤ ਬਰਬੋ ਕਰਤ ਉਪਾਊ ॥੨੯॥",
      "s": 8
    },
    {
      "t": "ਤਤਥਈ ਨਾਚੈ ਸੁਰ ਪੁਰ ਬਾਲਾ ॥",
      "s": 8
    },
    {
      "t": "ਰੁਣ ਝੁਣ ਬਾਜੈ ਰੰਗ ਅੰਗ ਮਾਲਾ ॥",
      "s": 8
    },
    {
      "t": "ਬਨਿ ਬਨਿ ਬੈਠੇ ਜਹ ਤਹ ਰਾਜਾ ॥",
      "s": 8
    },
    {
      "t": "ਦੈ ਦੈ ਡਾਰੈ ਤਨ ਮਨ ਸਾਜਾ ॥੩੦॥",
      "s": 8
    },
    {
      "t": "ਜਿਹ ਜਿਹ ਦੇਖਾ ਸੋ ਸੋ ਰੀਝਾ ॥",
      "s": 8
    },
    {
      "t": "ਜਿਨ ਨਹੀ ਦੇਖਾ ਤਿਹ ਮਨ ਖੀਝਾ ॥",
      "s": 8
    },
    {
      "t": "ਕਰਿ ਕਰਿ ਭਾਯੰ ਤ੍ਰੀਅ ਬਰ ਨਾਚੈ ॥",
      "s": 8
    },
    {
      "t": "ਅਤਿਭੁਤਿ ਭਾਯੰ ਅੰਗ ਅੰਗ ਰਾਚੈ ॥੩੧॥",
      "s": 8
    },
    {
      "t": "ਤਿਨ ਅਤਿਭੁਤਿ ਗਤਿ ਤਹ ਜਹ ਠਾਨੀ ॥",
      "s": 8
    },
    {
      "t": "ਜਹ ਤਹ ਸੋਹੈ ਮੁਨਿ ਮਨਿ ਮਾਨੀ ॥",
      "s": 8
    },
    {
      "t": "ਤਜਿ ਤਜਿ ਜੋਗੰ ਭਜਿ ਭਜਿ ਆਵੈ ॥",
      "s": 8
    },
    {
      "t": "ਲਖਿ ਅਤਿ ਆਭਾ ਜੀਅ ਸੁਖ ਪਾਵੈ ॥੩੨॥",
      "s": 8
    },
    {
      "t": "ਬਨਿ ਬਨਿ ਬੈਠੇ ਜਹ ਤਹ ਰਾਜਾ ॥",
      "s": 8
    },
    {
      "t": "ਜਹ ਤਹ ਸੋਭੈ ਸਭ ਸੁਭ ਸਾਜਾ ॥",
      "s": 8
    },
    {
      "t": "ਜਹ ਤਹ ਦੇਖੈ ਗੁਨਿ ਗਨ ਫੂਲੇ ॥",
      "s": 8
    },
    {
      "t": "ਮੁਨਿ ਮਨਿ ਛਬਿ ਲਖਿ ਤਨ ਮਨ ਭੂਲੇ ॥੩੩॥",
      "s": 8
    },
    {
      "t": "ਤਤ ਬਿਤ ਘਨ ਮੁਖਰਸ ਸਬ ਬਾਜੈ ॥",
      "s": 8
    },
    {
      "t": "ਸੁਨਿ ਮਨ ਰਾਗੰ ਗੁਨਿ ਗਨ ਲਾਜੈ ॥",
      "s": 8
    },
    {
      "t": "ਜਹ ਤਹ ਗਿਰ ਗੇ ਰਿਝਿ ਰਿਝਿ ਐਸੇ ॥",
      "s": 8
    },
    {
      "t": "ਜਨੁ ਭਟ ਜੂਝੇ ਰਣ ਬ੍ਰਿਣ ਕੈਸੇ ॥੩੪॥",
      "s": 8
    },
    {
      "t": "ਬਨਿ ਬਨਿ ਫੂਲੇ ਜਨੁ ਬਰ ਫੂਲੰ ॥",
      "s": 8
    },
    {
      "t": "ਤਨੁ ਬਰੁ ਸੋਭੇ ਜਨੁ ਧਰ ਮੂਲੰ ॥",
      "s": 8
    },
    {
      "t": "ਜਹੰ ਤਹੰ ਝੂਲੇ ਮਦ ਮਤ ਰਾਜਾ ॥",
      "s": 8
    },
    {
      "t": "ਜਨੁ ਮੁਰਿ ਬੋਲੈ ਸੁਨ ਘਨ ਗਾਜਾ ॥੩੫॥",
      "s": 8
    },
    {
      "t": "ਪਾਧਰੀ ਛੰਦ ॥",
      "s": 8
    },
    {
      "t": "ਜਹ ਤਹ ਬਿਲੋਕਿ ਸੋਭਾ ਅਪਾਰ ॥",
      "s": 8
    },
    {
      "t": "ਬਨਿ ਬੈਠਿ ਸਰਬ ਰਾਜਾਧਿਕਾਰ ॥",
      "s": 8
    },
    {
      "t": "ਇਹ ਭਾਤਿ ਕਹੈ ਨਹੀ ਪਰਤ ਬੈਨ ॥",
      "s": 8
    },
    {
      "t": "ਲਖਿ ਨੈਨ ਰੂਪਿ ਰੀਝੰਤ ਨੈਨ ॥੩੬॥",
      "s": 8
    },
    {
      "t": "ਅਵਿਲੋਕਿ ਨਾਚਿ ਐਸੋ ਸੁਰੰਗ ॥",
      "s": 8
    },
    {
      "t": "ਸਰ ਤਾਨਿ ਨ੍ਰਿਪਨ ਮਾਰਤ ਅਨੰਗ ॥",
      "s": 8
    },
    {
      "t": "ਸੋਭਾ ਅਪਾਰ ਬਰਣੀ ਨ ਜਾਇ ॥",
      "s": 8
    },
    {
      "t": "ਰੀਝੇ ਅਵਿਲੋਕਿ ਰਾਨਾ ਰੁ ਰਾਇ ॥੩੭॥",
      "s": 8
    }
  ]
}
