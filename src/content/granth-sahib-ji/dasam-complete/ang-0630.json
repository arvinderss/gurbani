{
  "page": 630,
  "lines": [
    {
      "t": "ਆਗਮ ਬਸੰਤ ਜਨੁ ਭਇਓ ਆਜ ॥",
      "s": 8
    },
    {
      "t": "ਇਹ ਭਾਤਿ ਸਰਬ ਦੇਖੈ ਸਮਾਜ ॥",
      "s": 8
    },
    {
      "t": "ਰਾਜਾਧਿਰਾਜ ਬਨਿ ਬੈਠ ਐਸ ॥",
      "s": 8
    },
    {
      "t": "ਤਿਨ ਕੇ ਸਮਾਨ ਨਹੀ ਇੰਦ੍ਰ ਹੈਸ ॥੩੮॥",
      "s": 8
    },
    {
      "t": "ਇਕ ਮਾਸ ਲਾਗ ਤਹ ਭਇਓ ਨਾਚ ॥",
      "s": 8
    },
    {
      "t": "ਬਿਨ ਪੀਐ ਕੈਫ ਕੋਊ ਨ ਬਾਚ ॥",
      "s": 8
    },
    {
      "t": "ਜਹ ਜਹ ਬਿਲੋਕਿ ਆਭਾ ਅਪਾਰ ॥",
      "s": 8
    },
    {
      "t": "ਤਹ ਤਹ ਸੁ ਰਾਜ ਰਾਜਨ ਕੁਮਾਰ ॥੩੯॥",
      "s": 8
    },
    {
      "t": "ਲੈ ਸੰਗ ਤਾਸ ਸਾਰਸ੍ਵਤਿ ਆਪ ॥",
      "s": 8
    },
    {
      "t": "ਜਿਹ ਕੋ ਜਪੰਤ ਸਭ ਜਗਤ ਜਾਪ ॥",
      "s": 8
    },
    {
      "t": "ਨਿਰਖੋ ਕੁਮਾਰ ਇਹ ਸਿੰਧ ਰਾਜ ॥",
      "s": 8
    },
    {
      "t": "ਜਾ ਕੀ ਸਮਾਨ ਨਹੀ ਇੰਦ੍ਰ ਸਾਜ ॥੪੦॥",
      "s": 8
    },
    {
      "t": "ਅਵਿਲੋਕ ਸਿੰਧ ਰਾਜਾ ਕੁਮਾਰ ॥",
      "s": 8
    },
    {
      "t": "ਨਹੀ ਤਾਸ ਚਿਤ ਕਿਨੋ ਸੁਮਾਰ ॥",
      "s": 8
    },
    {
      "t": "ਤਿਹ ਛਾਡਿ ਪਾਛ ਆਗੈ ਚਲੀਸੁ ॥",
      "s": 8
    },
    {
      "t": "ਜਨੁ ਸਰਬ ਸੋਭ ਕਹੁ ਲੀਲ ਲੀਸੁ ॥੪੧॥",
      "s": 8
    },
    {
      "t": "ਪੁਨਿ ਕਹੈ ਤਾਸ ਸਾਰਸ੍ਵਤੀ ਬੈਨ ॥",
      "s": 8
    },
    {
      "t": "ਇਹ ਪਸਚਮੇਸ ਅਬ ਦੇਖ ਨੈਨਿ ॥",
      "s": 8
    },
    {
      "t": "ਅਵਿਲੋਕਿ ਰੂਪ ਤਾ ਕੋ ਅਪਾਰ ॥",
      "s": 8
    },
    {
      "t": "ਨਹੀ ਮਧਿ ਚਿਤਿ ਆਨਿਓ ਕੁਮਾਰ ॥੪੨॥",
      "s": 8
    },
    {
      "t": "ਮਧੁਭਾਰ ਛੰਦ ॥",
      "s": 8
    },
    {
      "t": "ਦੇਖੋ ਕੁਮਾਰ ॥",
      "s": 8
    },
    {
      "t": "ਰਾਜਾ ਜੁਝਾਰ ॥",
      "s": 8
    },
    {
      "t": "ਸੁਭ ਵਾਰ ਦੇਸ ॥",
      "s": 8
    },
    {
      "t": "ਸੁੰਦਰ ਸੁਬੇਸ ॥੪੩॥",
      "s": 8
    },
    {
      "t": "ਦੇਖਿਓ ਬਿਚਾਰ ॥",
      "s": 8
    },
    {
      "t": "ਰਾਜਾ ਅਪਾਰ ॥",
      "s": 8
    },
    {
      "t": "ਆਨਾ ਨ ਚਿਤ ॥",
      "s": 8
    },
    {
      "t": "ਪਰਮੰ ਪਵਿਤ ॥੪੪॥",
      "s": 8
    },
    {
      "t": "ਤਬ ਆਗਿ ਚਾਲ ॥",
      "s": 8
    },
    {
      "t": "ਸੁੰਦਰ ਸੁ ਬਾਲ ॥",
      "s": 8
    },
    {
      "t": "ਮੁਸਕਿਆਤ ਐਸ ॥",
      "s": 8
    },
    {
      "t": "ਘਨਿ ਬੀਜ ਜੈਸ ॥੪੫॥",
      "s": 8
    },
    {
      "t": "ਨ੍ਰਿਪ ਪੇਖਿ ਰੀਝ ॥",
      "s": 8
    },
    {
      "t": "ਸੁਰ ਨਾਰ ਖੀਝ ॥",
      "s": 8
    },
    {
      "t": "ਬਢਿ ਤਾਸ ਜਾਨ ॥",
      "s": 8
    },
    {
      "t": "ਘਟ ਆਪ ਮਾਨ ॥੪੬॥",
      "s": 8
    },
    {
      "t": "ਸੁੰਦਰ ਸਰੂਪ ॥",
      "s": 8
    },
    {
      "t": "ਸੌਂਦਰਜੁ ਭੂਪ ॥",
      "s": 8
    },
    {
      "t": "ਸੋਭਾ ਅਪਾਰ ॥",
      "s": 8
    },
    {
      "t": "ਸੋਭੈ ਸੁ ਧਾਰ ॥੪੭॥",
      "s": 8
    },
    {
      "t": "ਦੇਖੋ ਨਰੇਾਂਦ੍ਰ ॥",
      "s": 8
    },
    {
      "t": "ਡਾਢੇ ਮਹੇਾਂਦ੍ਰ ॥",
      "s": 8
    },
    {
      "t": "ਮੁਲਤਾਨ ਰਾਜ ॥",
      "s": 8
    },
    {
      "t": "ਰਾਜਾਨ ਰਾਜ ॥੪੮॥",
      "s": 8
    },
    {
      "t": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 8
    },
    {
      "t": "ਚਲੀ ਛੋਡਿ ਤਾ ਕੌ ਤ੍ਰੀਆ ਰਾਜ ਐਸੇ ॥",
      "s": 8
    },
    {
      "t": "ਮਨੋ ਪਾਡੁ ਪੁਤ੍ਰੰ ਸਿਰੀ ਰਾਜ ਜੈਸੇ ॥",
      "s": 8
    },
    {
      "t": "ਖਰੀ ਮਧਿ ਰਾਜਿਸਥਲੀ ਐਸ ਸੋਹੈ ॥",
      "s": 8
    },
    {
      "t": "ਮਨੋ ਜ੍ਵਾਲ ਮਾਲਾ ਮਹਾ ਮੋਨਿ ਮੋਹੈ ॥੪੯॥",
      "s": 8
    },
    {
      "t": "ਸੁਭੇ ਰਾਜਿਸਥਲੀ ਠਾਢਿ ਐਸੇ ॥",
      "s": 8
    },
    {
      "t": "ਮਨੋ ਚਿਤ੍ਰਕਾਰੀ ਲਿਖੀ ਚਿਤ੍ਰ ਜੈਸੇ ॥",
      "s": 8
    },
    {
      "t": "ਬਧੇ ਸ੍ਵਰਣ ਕੀ ਕਿੰਕਣੀ ਲਾਲ ਮਾਲੰ ॥",
      "s": 8
    },
    {
      "t": "ਸਿਖਾ ਜਾਨ ਸੋਭੇ ਨ੍ਰਿਪੰ ਜਗਿ ਜ੍ਵਾਲੰ ॥੫੦॥",
      "s": 8
    },
    {
      "t": "ਕਹੇ ਬੈਨ ਸਾਰਸ੍ਵਤੀ ਪੇਖਿ ਬਾਲਾ ॥",
      "s": 8
    },
    {
      "t": "ਲਖੋ ਨੈਨਿ ਠਾਢੇ ਸਭੈ ਭੂਪ ਆਲਾ ॥",
      "s": 8
    },
    {
      "t": "ਰੁਚੈ ਚਿਤ ਜਉਨੈ ਸੁਈ ਨਾਥ ਕੀਜੈ ॥",
      "s": 8
    },
    {
      "t": "ਸੁਨੋ ਪ੍ਰਾਨ ਪਿਆਰੀ ਇਹੈ ਮਾਨਿ ਲੀਜੈ ॥੫੧॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 8
    },
    {
      "t": "ਬਡੀ ਬਾਹਨੀ ਸੰਗਿ ਜਾ ਕੇ ਬਿਰਾਜੈ ॥",
      "s": 8
    },
    {
      "t": "ਘੁਰੈ ਸੰਗ ਭੇਰੀ ਮਹਾ ਨਾਦ ਬਾਜੈ ॥",
      "s": 8
    },
    {
      "t": "ਲਖੋ ਰੂਪ ਬੇਸੰ ਨਰੇਸੰ ਮਹਾਨੰ ॥",
      "s": 8
    },
    {
      "t": "ਦਿਨੰ ਰੈਣ ਜਾਪੈ ਸਹੰਸ੍ਰ ਭੁਜਾਨੰ ॥੫੨॥",
      "s": 8
    },
    {
      "t": "ਧੁਜਾ ਮਧਿ ਜਾ ਕੇ ਬਡੋ ਸਿੰਘ ਰਾਜੈ ॥",
      "s": 8
    },
    {
      "t": "ਸੁਨੇ ਨਾਦ ਤਾ ਕੋ ਮਹਾ ਪਾਪ ਭਾਜੈ ॥",
      "s": 8
    },
    {
      "t": "ਲਖੋ ਪੂਰਬੀਸੰ ਛਿਤੀਸੰ ਮਹਾਨੰ ॥",
      "s": 8
    },
    {
      "t": "ਸੁਨੋ ਬੈਨ ਬਾਲਾ ਸੁਰੂਪੰ ਸੁ ਭਾਨੰ ॥੫੩॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 8
    },
    {
      "t": "ਘੁਰੈ ਦੁੰਦਭੀ ਸੰਖ ਭੇਰੀ ਅਪਾਰੰ ॥",
      "s": 8
    },
    {
      "t": "ਬਜੈ ਦਛਨੀ ਸਰਬ ਬਾਜੰਤ੍ਰ ਸਾਰੰ ॥",
      "s": 8
    },
    {
      "t": "ਤੁਰੀ ਕਾਨਰੇ ਤੂਰ ਤਾਨੰ ਤਰੰਗੰ ॥",
      "s": 8
    },
    {
      "t": "ਮੁਚੰ ਝਾਝਰੰ ਨਾਇ ਨਾਦੰ ਮ੍ਰਿਦੰਗੰ ॥੫੪॥",
      "s": 8
    },
    {
      "t": "ਬਧੇ ਹੀਰ ਚੀਰੰ ਸੁ ਬੀਰੰ ਸੁਬਾਹੰ ॥",
      "s": 8
    },
    {
      "t": "ਬਡੋ ਛਤ੍ਰਧਾਰੀ ਸੋ ਸੋਭਿਓ ਸਿਪਾਹੰ ॥",
      "s": 8
    }
  ]
}
