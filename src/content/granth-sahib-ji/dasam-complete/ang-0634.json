      "s": 8
    },
    {
      "t": "ਤੇ ਕਹੇ ਸਰਬ ਨਰੇਸ ॥",
      "s": 8
    },
    {
      "t": "ਜੇ ਆ ਗਏ ਇਹ ਦੇਸਿ ॥",
      "s": 8
    },
    {
      "t": "ਕਰਿ ਅਸਟ ਦਸ੍ਰਯ ਪੁਰਾਨਿ ॥",
      "s": 8
    },
    {
      "t": "ਦਿਜ ਬਿਆਸ ਬੇਦ ਨਿਧਾਨ ॥੧੦੭॥",
      "s": 8
    },
    {
      "t": "ਕੀਨੇ ਅਠਾਰਹ ਪਰਬ ॥",
      "s": 8
    },
    {
      "t": "ਜਗ ਰੀਝੀਆ ਸੁਨਿ ਸਰਬ ॥",
      "s": 8
    },
    {
      "t": "ਇਹ ਬਿਆਸ ਬ੍ਰਹਮ ਵਤਾਰ ॥",
      "s": 8
    },
    {
      "t": "ਭਏ ਪੰਚਮੋ ਮੁਖ ਚਾਰ ॥੧੦੮॥",
      "s": 8
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਪੰਚਮੋਵਤਾਰ ਬ੍ਰਹਮਾ ਬਿਆਸ ਰਾਜਾ ਅਜ ਕੋ ਰਾਜ ਸਮਾਪਤੰ ॥੧੦॥੫॥",
      "s": 8
    },
    {
      "t": "ਅਥ ਬ੍ਰਹਮਾਵਤਾਰ ਖਟ ਰਿਖਿ ਕਥਨੰ ॥",
      "s": 8
    },
    {
      "t": "ਤੋਮਰ ਛੰਦ ॥",
      "s": 8
    },
    {
      "t": "ਜੁਗ ਆਗਲੇ ਇਹ ਬਿਆਸ ॥",
      "s": 8
    },
    {
      "t": "ਜਗਿ ਕੀਅ ਪੁਰਾਣ ਪ੍ਰਕਾਸ ॥",
      "s": 8
    },
    {
      "t": "ਤਬ ਬਾਢਿਆ ਤਿਹ ਗਰਬ ॥",
      "s": 8
    },
    {
      "t": "ਸਰ ਆਪ ਜਾਨਿ ਨ ਸਰਬ ॥੧॥",
      "s": 8
    },
    {
      "t": "ਤਬ ਕੋਪਿ ਕਾਲ ਕ੍ਰਵਾਲ ॥",
      "s": 8
    },
    {
      "t": "ਜਿਹ ਜਾਲ ਜ੍ਵਾਲ ਬਿਸਾਲ ॥",
      "s": 8
    },
    {
      "t": "ਖਟ ਟੂਕ ਤਾ ਕਹ ਕੀਨ ॥",
      "s": 8
    },
    {
      "t": "ਪੁਨਿ ਜਾਨ ਕੈ ਤਿਨਿ ਦੀਨ ॥੨॥",
