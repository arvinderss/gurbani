    {
      "t": "ਜਗ ਆਪਨੋ ਅਜਿ ਮਾਨ ॥",
      "s": 8
    },
    {
      "t": "ਤਰਿ ਆਖ ਆਨ ਨ ਆਨ ॥",
      "s": 8
    },
    {
      "t": "ਤਬ ਕਾਲ ਕੋਪ ਕ੍ਰਵਾਲ ॥",
      "s": 8
    },
    {
      "t": "ਅਜਿ ਜਾਰੀਆ ਮਧਿ ਜ੍ਵਾਲ ॥੯੯॥",
      "s": 8
    },
    {
      "t": "ਅਜਿ ਜੋਤਿ ਜੋਤਿ ਮਿਲਾਨ ॥",
      "s": 8
    },
    {
      "t": "ਤਬ ਸਰਬ ਦੇਖਿ ਡਰਾਨ ॥",
      "s": 8
    },
    {
      "t": "ਜਿਮ ਨਾਵ ਖੇਵਟ ਹੀਨ ॥",
      "s": 8
    },
    {
      "t": "ਜਿਮ ਦੇਹ ਅਰਬਲ ਛੀਨ ॥੧੦੦॥",
      "s": 8
    },
    {
      "t": "ਜਿਮ ਗਾਵ ਰਾਵ ਬਿਹੀਨ ॥",
      "s": 8
    },
    {
      "t": "ਜਿਮ ਉਰਬਰਾ ਕ੍ਰਿਸ ਛੀਨ ॥",
      "s": 8
    },
    {
      "t": "ਜਿਮ ਦਿਰਬ ਹੀਣ ਭੰਡਾਰ ॥",
      "s": 8
    },
    {
      "t": "ਜਿਮ ਸਾਹਿ ਹੀਣ ਬਿਪਾਰ ॥੧੦੧॥",
