  "lines": [
    {
      "t": "ਤੋਮਰ ਛੰਦ ॥",
      "s": 9
    },
    {
      "t": "ਕੀਅ ਐਸ ਬ੍ਰਹਮਾ ਉਚਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਤੈ ਪੁਤ੍ਰ ਪਾਵਸ ਬਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਤਬਿ ਨਾਰਿ ਏ ਸੁਨ ਬੈਨ ॥",
      "s": 9
    },
    {
      "t": "ਬਹੁ ਆਸੁ ਡਾਰਤ ਨੈਨ ॥੨੫॥",
      "s": 9
    },
    {
      "t": "ਤਬ ਬਾਲ ਬਿਕਲ ਸਰੀਰ ॥",
      "s": 9
    },
    {
      "t": "ਜਲ ਸ੍ਰਵਤ ਨੈਨ ਅਧੀਰ ॥",
      "s": 9
    },
    {
      "t": "ਰੋਮਾਚਿ ਗਦ ਗਦ ਬੈਨ ॥",
      "s": 9
    },
    {
      "t": "ਦਿਨ ਤੇ ਭਈ ਜਨੁ ਰੈਨ ॥੨੬॥",
      "s": 9
    },
    {
      "t": "ਰੋਮਾਚਿ ਬਿਕਲ ਸਰੀਰ ॥",
      "s": 9
    },
    {
      "t": "ਤਨ ਕੋਪ ਮਾਨ ਅਧੀਰ ॥",
      "s": 9
    },
    {
      "t": "ਫਰਕੰਤ ਉਸਟਰੁ ਨੈਨ ॥",
      "s": 9
    },
    {
      "t": "ਬਿਨੁ ਬੁਧ ਬੋਲਤ ਬੈਨ ॥੨੭॥",
      "s": 9
    },
    {
      "t": "ਮੋਹਣ ਛੰਦ ॥",
      "s": 9
    },
    {
      "t": "ਸੁਨਿ ਐਸ ਬੈਨ ॥",
      "s": 9
    },
    {
      "t": "ਮ੍ਰਿਗੀਏਸ ਨੈਨ ॥",
      "s": 9
    },
    {
      "t": "ਅਤਿ ਰੂਪ ਧਾਮ ॥",
      "s": 9
    },
    {
      "t": "ਸੁੰਦਰ ਸੁ ਬਾਮ ॥੨੮॥",
      "s": 9
    },
    {
      "t": "ਚਲ ਚਾਲ ਚਿਤ ॥",
      "s": 9
    },
    {
      "t": "ਪਰਮੰ ਪਵਿਤ ॥",
      "s": 9
    },
    {
      "t": "ਅਤਿ ਕੋਪ ਵੰਤ ॥",
      "s": 9
    },
    {
      "t": "ਮੁਨਿ ਤ੍ਰਿਅ ਬਿਅੰਤ ॥੨੯॥",
      "s": 9
    },
    {
      "t": "ਉਪਟੰਤ ਕੇਸ ॥",
      "s": 9
    },
    {
      "t": "ਮੁਨਿ ਤ੍ਰਿਅ ਸੁਦੇਸ ॥",
      "s": 9
    },
    {
      "t": "ਅਤਿ ਕੋਪ ਅੰਗਿ ॥",
      "s": 9
    },
    {
      "t": "ਸੁੰਦਰ ਸੁਰੰਗ ॥੩੦॥",
      "s": 9
    },
    {
      "t": "ਤੋਰੰਤ ਹਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਉਪਟੰਤ ਬਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਡਾਰੰਤ ਧੂਰਿ ॥",
      "s": 9
    },
    {
      "t": "ਰੋਖੰਤ ਪੂਰ ॥੩੧॥",
      "s": 9
    },
    {
      "t": "ਤੋਮਰ ਛੰਦ ॥",
      "s": 9
    },
    {
      "t": "ਲਖਿ ਕੋਪ ਭੀ ਮੁਨਿ ਨਾਰਿ ॥",
      "s": 9
    },
    {
      "t": "ਉਠਿ ਭਾਜ ਬ੍ਰਹਮ ਉਦਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਸਿਵ ਸੰਗਿ ਲੈ ਰਿਖ ਸਰਬ ॥",
      "s": 9
    },
    {
      "t": "ਭਯਮਾਨ ਹ੍ਵੈ ਤਜਿ ਗਰਬ ॥੩੨॥",
      "s": 9
    },
    {
      "t": "ਤਬ ਕੋਪ ਕੈ ਮੁਨਿ ਨਾਰਿ ॥",
      "s": 9
    },
    {
      "t": "ਸਿਰ ਕੇਸ ਜਟਾ ਉਪਾਰਿ ॥",
      "s": 9
    },
    {
      "t": "ਕਰਿ ਸੌ ਜਬੈ ਕਰ ਮਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਤਬ ਲੀਨ ਦਤ ਅਵਤਾਰ ॥੩੩॥",
      "s": 9
    },
    {
      "t": "ਕਰ ਬਾਮ ਮਾਤ੍ਰ ਸਮਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਕਰੁ ਦਛਨਤ੍ਰਿ ਪ੍ਰਮਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਕੀਆ ਪਾਨ ਭੋਗ ਬਿਚਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਤਬ ਭਏ ਦਤ ਕੁਮਾਰ ॥੩੪॥",
      "s": 9
    },
    {
      "t": "ਅਨਭੂਤ ਉਤਮ ਗਾਤ ॥",
      "s": 9
    },
    {
      "t": "ਉਚਰੰਤ ਸਿੰਮ੍ਰਿਤ ਸਾਤ ॥",
      "s": 9
    },
    {
      "t": "ਮੁਖਿ ਬੇਦ ਚਾਰ ਰੜੰਤ ॥",
      "s": 9
    },
    {
      "t": "ਉਪਜੋ ਸੁ ਦਤ ਮਹੰਤ ॥੩੫॥",
      "s": 9
    },
    {
      "t": "ਸਿਵ ਸਿਮਰਿ ਪੂਰਬਲ ਸ੍ਰਾਪ ॥",
      "s": 9
