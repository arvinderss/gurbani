{
  "page": 638,
  "lines": [
    {
      "t": "ਬਪੁ ਦਤ ਕੋ ਧਰਿ ਆਪ ॥",
      "s": 9
    },
    {
      "t": "ਉਪਜਿਓ ਨਿਸੂਆ ਧਾਮਿ ॥",
      "s": 9
    },
    {
      "t": "ਅਵਤਾਰ ਪ੍ਰਿਥਮ ਸੁ ਤਾਮ ॥੩੬॥",
      "s": 9
    },
    {
      "t": "ਪਾਧਰੀ ਛੰਦ ॥",
      "s": 9
    },
    {
      "t": "ਉਪਜਿਓ ਸੁ ਦਤ ਮੋਨੀ ਮਹਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਦਸ ਚਾਰ ਚਾਰ ਬਿਦਿਆ ਨਿਧਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਸਾਸਤ੍ਰਗਿ ਸੁਧ ਸੁੰਦਰ ਸਰੂਪ ॥",
      "s": 9
    },
    {
      "t": "ਅਵਧੂਤ ਰੂਪ ਗਣ ਸਰਬ ਭੂਪ ॥੩੭॥",
      "s": 9
    },
    {
      "t": "ਸੰਨਿਆਸ ਜੋਗ ਕਿਨੋ ਪ੍ਰਕਾਸ ॥",
      "s": 9
    },
    {
      "t": "ਪਾਵਨ ਪਵਿਤ ਸਰਬਤ੍ਰ ਦਾਸ ॥",
      "s": 9
    },
    {
      "t": "ਜਨ ਧਰਿਓ ਆਨਿ ਬਪੁ ਸਰਬ ਜੋਗ ॥",
      "s": 9
    },
    {
      "t": "ਤਜਿ ਰਾਜ ਸਾਜ ਅਰੁ ਤਿਆਗ ਭੋਗ ॥੩੮॥",
      "s": 9
    },
    {
      "t": "ਆਛਿਜ ਰੂਪ ਮਹਿਮਾ ਮਹਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਦਸ ਚਾਰਵੰਤ ਸੋਭਾ ਨਿਧਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਰਵਿ ਅਨਿਲ ਤੇਜ ਜਲ ਸੋ ਸੁਭਾਵ ॥",
      "s": 9
    },
    {
      "t": "ਉਪਜਿਆ ਜਗਤ ਸੰਨ੍ਯਾਸ ਰਾਵ ॥੩੯॥",
      "s": 9
    },
    {
      "t": "ਸੰਨ੍ਯਾਸ ਰਾਜ ਭਏ ਦਤ ਦੇਵ ॥",
      "s": 9
    },
    {
      "t": "ਰੁਦ੍ਰਾਵਤਾਰ ਸੁੰਦਰ ਅਜੇਵ ॥",
      "s": 9
    },
    {
      "t": "ਪਾਵਕ ਸਮਾਨ ਭਯੇ ਤੇਜ ਜਾਸੁ ॥",
      "s": 9
    },
    {
      "t": "ਬਸੁਧਾ ਸਮਾਨ ਧੀਰਜ ਸੁ ਤਾਸੁ ॥੪੦॥",
      "s": 9
    },
    {
      "t": "ਪਰਮੰ ਪਵਿਤ੍ਰ ਭਏ ਦੇਵ ਦਤ ॥",
      "s": 9
    },
    {
      "t": "ਆਛਿਜ ਤੇਜ ਅਰੁ ਬਿਮਲ ਮਤਿ ॥",
      "s": 9
    },
    {
      "t": "ਸੋਵਰਣ ਦੇਖਿ ਲਾਜੰਤ ਅੰਗ ॥",
      "s": 9
    },
    {
      "t": "ਸੋਭੰਤ ਸੀਸ ਗੰਗਾ ਤਰੰਗ ॥੪੧॥",
      "s": 9
    },
    {
      "t": "ਆਜਾਨ ਬਾਹੁ ਅਲਿਪਤ ਰੂਪ ॥",
      "s": 9
    },
    {
      "t": "ਆਦਗ ਜੋਗ ਸੁੰਦਰ ਸਰੂਪ ॥",
      "s": 9
    },
    {
      "t": "ਬਿਭੂਤ ਅੰਗ ਉਜਲ ਸੁ ਬਾਸ ॥",
      "s": 9
    },
    {
      "t": "ਸੰਨਿਆਸ ਜੋਗ ਕਿਨੋ ਪ੍ਰਕਾਸ ॥੪੨॥",
      "s": 9
    },
    {
      "t": "ਅਵਿਲੋਕਿ ਅੰਗ ਮਹਿਮਾ ਅਪਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਸੰਨਿਆਸ ਰਾਜ ਉਪਜਾ ਉਦਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਅਨਭੂਤ ਗਾਤ ਆਭਾ ਅਨੰਤ ॥",
      "s": 9
    },
    {
      "t": "ਮੋਨੀ ਮਹਾਨ ਸੋਭਾ ਲਸੰਤ ॥੪੩॥",
      "s": 9
    },
    {
      "t": "ਆਭਾ ਅਪਾਰ ਮਹਿਮਾ ਅਨੰਤ ॥",
      "s": 9
    },
    {
      "t": "ਸੰਨ੍ਯਾਸ ਰਾਜ ਕਿਨੋ ਬਿਅੰਤ ॥",
      "s": 9
    },
    {
      "t": "ਕਾਪਿਆ ਕਪਟੁ ਤਿਹ ਉਦੇ ਹੋਤ ॥",
      "s": 9
    },
    {
      "t": "ਤਤਛਿਨ ਅਕਪਟ ਕਿਨੋ ਉਦੋਤ ॥੪੪॥",
      "s": 9
    },
    {
      "t": "ਮਹਿਮਾ ਅਛਿਜ ਅਨਭੂਤ ਗਾਤ ॥",
      "s": 9
    },
    {
      "t": "ਆਵਿਲੋਕਿ ਪੁਤ੍ਰ ਚਕਿ ਰਹੀ ਮਾਤ ॥",
      "s": 9
    },
    {
      "t": "ਦੇਸਨ ਬਿਦੇਸ ਚਕਿ ਰਹੀ ਸਰਬ ॥",
      "s": 9
    },
    {
      "t": "ਸੁਨਿ ਸਰਬ ਰਿਖਿਨ ਤਜਿ ਦੀਨ ਗਰਬ ॥੪੫॥",
      "s": 9
    },
    {
      "t": "ਸਰਬਤ੍ਰ ਪ੍ਰਯਾਲ ਸਰਬਤ੍ਰ ਅਕਾਸ ॥",
      "s": 9
    },
    {
      "t": "ਚਲ ਚਾਲ ਚਿਤੁ ਸੁੰਦਰ ਸੁ ਬਾਸ ॥",
      "s": 9
    },
    {
      "t": "ਕੰਪਾਇਮਾਨ ਹਰਖੰਤ ਰੋਮ ॥",
      "s": 9
    },
    {
      "t": "ਆਨੰਦਮਾਨ ਸਭ ਭਈ ਭੋਮ ॥੪੬॥",
      "s": 9
    },
    {
      "t": "ਥਰਹਰਤ ਭੂਮਿ ਆਕਾਸ ਸਰਬ ॥",
      "s": 9
    },
    {
      "t": "ਜਹ ਤਹ ਰਿਖੀਨ ਤਜਿ ਦੀਨ ਗਰਬ ॥",
      "s": 9
    },
    {
      "t": "ਬਾਜੇ ਬਜੰਤ੍ਰ ਅਨੇਕ ਗੈਨ ॥",
      "s": 9
    },
    {
      "t": "ਦਸ ਦਿਉਸ ਪਾਇ ਦਿਖੀ ਨ ਰੈਣ ॥੪੭॥",
      "s": 9
    }
  ]
}
