{
  "page": 639,
  "lines": [
    {
      "t": "ਜਹ ਤਹ ਬਜੰਤ੍ਰ ਬਾਜੇ ਅਨੇਕ ॥",
      "s": 9
    },
    {
      "t": "ਪ੍ਰਗਟਿਆ ਜਾਣੁ ਬਪੁ ਧਰਿ ਬਿਬੇਕ ॥",
      "s": 9
    },
    {
      "t": "ਸੋਭਾ ਅਪਾਰ ਬਰਨੀ ਨ ਜਾਇ ॥",
      "s": 9
    },
    {
      "t": "ਉਪਜਿਆ ਆਨ ਸੰਨ੍ਯਾਸ ਰਾਇ ॥੪੮॥",
      "s": 9
    },
    {
      "t": "ਜਨਮੰਤ ਲਾਗਿ ਉਠ ਜੋਗ ਕਰਮ ॥",
      "s": 9
    },
    {
      "t": "ਹਤਿ ਕੀਓ ਪਾਪ ਪਰਚੁਰਿਓ ਧਰਮ ॥",
      "s": 9
    },
    {
      "t": "ਰਾਜਾਧਿਰਾਜ ਬਡ ਲਾਗ ਚਰਨ ॥",
      "s": 9
    },
    {
      "t": "ਸੰਨਿਆਸ ਜੋਗ ਉਠਿ ਲਾਗ ਕਰਨ ॥੪੯॥",
      "s": 9
    },
    {
      "t": "ਅਤਿਭੁਤਿ ਅਨੂਪ ਲਖਿ ਦਤ ਰਾਇ ॥",
      "s": 9
    },
    {
      "t": "ਉਠਿ ਲਗੇ ਪਾਇ ਨ੍ਰਿਪ ਸਰਬ ਆਇ ॥",
      "s": 9
    },
    {
      "t": "ਅਵਿਲੋਕਿ ਦਤ ਮਹਿਮਾ ਮਹਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਦਸ ਚਾਰ ਚਾਰ ਬਿਦਿਆ ਨਿਧਾਨ ॥੫੦॥",
      "s": 9
    },
    {
      "t": "ਸੋਭੰਤ ਸੀਸ ਜਤ ਕੀ ਜਟਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਨਖ ਨੇਮ ਕੇ ਸੁ ਬਢਏ ਮਹਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਬਿਭ੍ਰਮ ਬਿਭੂਤ ਉਜਲ ਸੋ ਸੋਹ ॥",
      "s": 9
    },
    {
      "t": "ਦਿਜ ਚਰਜ ਤੁਲਿ ਮ੍ਰਿਗ ਚਰਮ ਅਰੋਹ ॥੫੧॥",
      "s": 9
    },
    {
      "t": "ਮੁਖ ਸਿਤ ਬਿਭੂਤ ਲੰਗੋਟ ਬੰਦ ॥",
      "s": 9
    },
    {
      "t": "ਸੰਨ੍ਯਾਸ ਚਰਜ ਤਜਿ ਛੰਦ ਬੰਦ ॥",
      "s": 9
    },
    {
      "t": "ਆਸੁਨਕ ਸੁੰਨਿ ਅਨਵ੍ਰਯਕਤ ਅੰਗ ॥",
      "s": 9
    },
    {
      "t": "ਆਛਿਜ ਤੇਜ ਮਹਿਮਾ ਸੁਰੰਗ ॥੫੨॥",
      "s": 9
    },
    {
      "t": "ਇਕ ਆਸ ਚਿਤ ਤਜਿ ਸਰਬ ਆਸ ॥",
      "s": 9
    },
    {
      "t": "ਅਨਭੂਤ ਗਾਤ ਨਿਸ ਦਿਨ ਉਦਾਸ ॥",
      "s": 9
    },
    {
      "t": "ਮੁਨਿ ਚਰਜ ਲੀਨ ਤਜਿ ਸਰਬ ਕਾਮ ॥",
      "s": 9
    },
    {
      "t": "ਆਰਕਤਿ ਨੇਤ੍ਰ ਜਨੁ ਧਰਮ ਧਾਮ ॥੫੩॥",
      "s": 9
    },
    {
      "t": "ਅਬਿਕਾਰ ਚਿਤ ਅਣਡੋਲ ਅੰਗ ॥",
      "s": 9
    },
    {
      "t": "ਜੁਤ ਧਿਆਨ ਨੇਤ੍ਰ ਮਹਿਮਾ ਅਭੰਗ ॥",
      "s": 9
    },
    {
      "t": "ਧਰਿ ਏਕ ਆਸ ਅਉਦਾਸ ਚਿਤ ॥",
      "s": 9
    },
    {
      "t": "ਸੰਨਿਯਾਸ ਦੇਵ ਪਰਮੰ ਪਵਿਤ ॥੫੪॥",
      "s": 9
    },
    {
      "t": "ਅਵਧੂਤ ਗਾਤ ਮਹਿਮਾ ਅਪਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਸ੍ਰੁਤਿ ਗਿਆਨ ਸਿੰਧੁ ਬਿਦਿਆ ਉਦਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਮੁਨਿ ਮਨਿ ਪ੍ਰਬੀਨ ਗੁਨਿ ਗਨ ਮਹਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਜਨੁ ਭਯੋ ਪਰਮ ਗਿਆਨੀ ਮਹਾਨ ॥੫੫॥",
      "s": 9
    },
    {
      "t": "ਕਬਹੂੰ ਨ ਪਾਪ ਜਿਹ ਛੁਹਾ ਅੰਗ ॥",
      "s": 9
    },
    {
      "t": "ਗੁਨਿ ਗਨ ਸੰਪੰਨ ਸੁੰਦਰ ਸੁਰੰਗ ॥",
      "s": 9
    },
    {
      "t": "ਲੰਗੋਟਬੰਦ ਅਵਧੂਤ ਗਾਤ ॥",
      "s": 9
    },
    {
      "t": "ਚਕਿ ਰਹੀ ਚਿਤ ਅਵਲੋਕਿ ਮਾਤ ॥੫੬॥",
      "s": 9
    },
    {
      "t": "ਸੰਨਿਯਾਸ ਦੇਵ ਅਨਭੂਤ ਅੰਗ ॥",
      "s": 9
    },
    {
      "t": "ਲਾਜੰਤ ਦੇਖਿ ਜਿਹ ਦੁਤਿ ਅਨੰਗ ॥",
      "s": 9
    },
    {
      "t": "ਮੁਨਿ ਦਤ ਦੇਵ ਸੰਨ੍ਯਾਸ ਰਾਜ ॥",
      "s": 9
    },
    {
      "t": "ਜਿਹ ਸਧੇ ਸਰਬ ਸੰਨ੍ਯਾਸ ਸਾਜ ॥੫੭॥",
      "s": 9
    },
    {
      "t": "ਪਰਮੰ ਪਵਿਤ੍ਰ ਜਾ ਕੇ ਸਰੀਰ ॥",
      "s": 9
    },
    {
      "t": "ਕਬਹੂੰ ਨ ਕਾਮ ਕਿਨੋ ਅਧੀਰ ॥",
      "s": 9
    },
    {
      "t": "ਜਟ ਜੋਗ ਜਾਸੁ ਸੋਭੰਤ ਸੀਸ ॥",
      "s": 9
    },
    {
      "t": "ਅਸ ਧਰਾ ਰੂਪ ਸੰਨਿਯਾਸ ਈਸ ॥੫੮॥",
      "s": 9
    },
    {
      "t": "ਆਭਾ ਅਪਾਰ ਕਥਿ ਸਕੈ ਕਉਨ ॥",
      "s": 9
    },
    {
      "t": "ਸੁਨਿ ਰਹੈ ਜਛ ਗੰਧ੍ਰਬ ਮਉਨ ॥",
      "s": 9
    },
    {
      "t": "ਚਕਿ ਰਹਿਓ ਬ੍ਰਹਮ ਆਭਾ ਬਿਚਾਰਿ ॥",
      "s": 9
    },
    {
      "t": "ਲਾਜਯੋ ਅਨੰਗ ਆਭਾ ਨਿਹਾਰਿ ॥੫੯॥",
      "s": 9
    }
  ]
}
