{
  "page": 641,
  "lines": [
    {
      "t": "ਦੀਨਨ ਉਧਾਰਣਿ ਜਾਸੁ ਬਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਕੋਊ ਕਹੈ ਕੈਸੇਈ ਲੇਤ ਮਾਨ ॥੭੧॥",
      "s": 9
    },
    {
      "t": "ਅਕਲੰਕ ਰੂਪ ਅਨਛਿਜ ਤੇਜ ॥",
      "s": 9
    },
    {
      "t": "ਆਸਨ ਅਡੋਲ ਸੁਭ ਸੁਭ੍ਰ ਸੇਜ ॥",
      "s": 9
    },
    {
      "t": "ਅਨਗਨ ਜਾਸੁ ਗੁਨ ਮਧਿ ਸੋਭ ॥",
      "s": 9
    },
    {
      "t": "ਲਖਿ ਸਤ੍ਰ ਮਿਤ੍ਰ ਜਿਹ ਰਹਤ ਲੋਭ ॥੭੨॥",
      "s": 9
    },
    {
      "t": "ਜਿਹ ਸਤ੍ਰ ਮਿਤ੍ਰ ਸਮ ਏਕ ਜਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਉਸਤਤੀ ਨਿੰਦ ਜਿਹ ਏਕ ਮਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਆਸਨ ਅਡੋਲ ਅਨਛਿਜ ਰੂਪ ॥",
      "s": 9
    },
    {
      "t": "ਪਰਮੰ ਪਵਿਤ੍ਰ ਭੂਪਾਣ ਭੂਪ ॥੭੩॥",
      "s": 9
    },
    {
      "t": "ਜਿਹਬਾ ਸੁਧਾਨ ਖਗ ਉਧ ਸੋਹਿ ॥",
      "s": 9
    },
    {
      "t": "ਅਵਿਲੋਕ ਦਈਤ ਅਰੁ ਦੇਵ ਮੋਹਿ ॥",
      "s": 9
    },
    {
      "t": "ਬਿਨੁ ਬੈਰ ਰੂਪ ਅਨਭਵ ਪ੍ਰਕਾਸ ॥",
      "s": 9
    },
    {
      "t": "ਅਨਛਿਜ ਗਾਤ ਨਿਸਿ ਦਿਨ ਨਿਰਾਸ ॥੭੪॥",
      "s": 9
    },
    {
      "t": "ਦੁਤਿ ਆਦਿ ਅੰਤਿ ਏਕੈ ਸਮਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਖੜਗੰਨ ਸਪੰਨਿ ਸਬ ਬਿਧਿ ਨਿਧਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਸੋਭਾ ਸੁ ਬਹੁਤ ਤਨ ਜਾਸੁ ਸੋਭ ॥",
      "s": 9
    },
    {
      "t": "ਦੁਤਿ ਦੇਖਿ ਜਛ ਗੰਧ੍ਰਬ ਲੋਭ ॥੭੫॥",
      "s": 9
    },
    {
      "t": "ਅਨਭੰਗ ਅੰਗ ਅਨਭਵ ਪ੍ਰਕਾਸ ॥",
      "s": 9
    },
    {
      "t": "ਪਸਰੀ ਜਗਤਿ ਜਿਹ ਜੀਵ ਰਾਸਿ ॥",
      "s": 9
    },
    {
      "t": "ਕਿਨੇ ਸੁ ਜੀਵ ਜਲਿ ਥਲਿ ਅਨੇਕ ॥",
      "s": 9
    },
    {
      "t": "ਅੰਤਹਿ ਸਮੇਯ ਫੁਨਿ ਰੂਪ ਏਕ ॥੭੬॥",
      "s": 9
    },
    {
      "t": "ਜਿਹ ਛੂਆ ਨੈਕੁ ਨਹੀ ਕਾਲ ਜਾਲੁ ॥",
      "s": 9
    },
    {
      "t": "ਛ੍ਵੈ ਸਕਾ ਪਾਪ ਨਹੀ ਕਉਨ ਕਾਲ ॥",
      "s": 9
    },
    {
      "t": "ਆਛਿਜ ਤੇਜ ਅਨਭੂਤ ਗਾਤ ॥",
      "s": 9
    },
    {
      "t": "ਏਕੈ ਸਰੂਪ ਨਿਸ ਦਿਨ ਪ੍ਰਭਾਤ ॥੭੭॥",
      "s": 9
    },
    {
      "t": "ਇਹ ਭਾਤਿ ਦਤ ਅਸਤੋਤ੍ਰ ਪਾਠ ॥",
      "s": 9
    },
    {
      "t": "ਮੁਖ ਪੜਤ ਅਛ੍ਰ ਗਯੋ ਪਾਪ ਨਾਠ ॥",
      "s": 9
    },
    {
      "t": "ਕੋ ਸਕੈ ਬਰਨ ਮਹਿਮਾ ਅਪਾਰ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 9
    },
    {
      "t": "ਸੰਛੇਪ ਕੀਨ ਤਾ ਤੇ ਉਚਾਰ ॥੭੮॥",
      "s": 9
    },
    {
      "t": "ਜੇ ਕਰੈ ਪਤ੍ਰ ਕਾਸਿਪੀ ਸਰਬ ॥",
      "s": 9
    },
    {
      "t": "ਲਿਖੇ ਗਣੇਸ ਕਰਿ ਕੈ ਸੁ ਗਰਬ ॥",
      "s": 9
    },
    {
      "t": "ਮਸੁ ਸਰਬ ਸਿੰਧ ਲੇਖਕ ਬਨੇਸਿ ॥",
      "s": 9
    },
    {
      "t": "ਨਹੀ ਤਦਿਪ ਅੰਤਿ ਕਹਿ ਸਕੈ ਸੇਸੁ ॥੭੯॥",
      "s": 9
    },
    {
      "t": "ਜਉ ਕਰੈ ਬੈਠਿ ਬ੍ਰਹਮਾ ਉਚਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਨਹੀ ਤਦਿਪ ਤੇਜ ਪਾਯੰਤ ਪਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਮੁਖ ਸਹੰਸ ਨਾਮ ਫਣ ਪਤਿ ਰੜੰਤ ॥",
      "s": 9
    },
    {
      "t": "ਨਹੀ ਤਦਿਪ ਤਾਸੁ ਪਾਯੰਤ ਅੰਤੁ ॥੮੦॥",
      "s": 9
    },
    {
      "t": "ਨਿਸ ਦਿਨ ਜਪੰਤ ਸਨਕੰ ਸਨਾਤ ॥",
      "s": 9
    },
    {
      "t": "ਨਹੀ ਤਦਿਪ ਤਾਸੁ ਸੋਭਾ ਨਿਰਾਤ ॥",
      "s": 9
    },
    {
      "t": "ਮੁਖ ਚਾਰ ਬੇਦ ਕਿਨੇ ਉਚਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਤਜਿ ਗਰਬ ਨੇਤਿ ਨੇਤੈ ਬਿਚਾਰ ॥੮੧॥",
      "s": 9
    },
    {
      "t": "ਸਿਵ ਸਹੰਸ੍ਰ ਬਰਖ ਲੌ ਜੋਗ ਕੀਨ ॥",
      "s": 9
    },
    {
      "t": "ਤਜਿ ਨੇਹ ਗੇਹ ਬਨ ਬਾਸ ਲੀਨ ॥",
      "s": 9
    },
    {
      "t": "ਬਹੁ ਕੀਨ ਜੋਗ ਤਹ ਬਹੁ ਪ੍ਰਕਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਨਹੀ ਤਦਿਪ ਤਾਸੁ ਲਹਿ ਸਕਾ ਪਾਰ ॥੮੨॥",
      "s": 9
    },
    {
      "t": "ਜਿਹ ਏਕ ਰੂਪ ਅਨਕੰ ਪ੍ਰਕਾਸ ॥",
      "s": 9
    },
    {
      "t": "ਅਬਿਯਕਤ ਤੇਜ ਨਿਸ ਦਿਨ ਉਦਾਸ ॥",
      "s": 9
    }
  ]
}
