{
  "page": 642,
  "lines": [
    {
      "t": "ਆਸਨ ਅਡੋਲ ਮਹਿਮਾ ਅਭੰਗ ॥",
      "s": 9
    },
    {
      "t": "ਅਨਭਵ ਪ੍ਰਕਾਸ ਸੋਭਾ ਸੁਰੰਗ ॥੮੩॥",
      "s": 9
    },
    {
      "t": "ਜਿਹ ਸਤ੍ਰੁ ਮਿਤ੍ਰ ਏਕੈ ਸਮਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਅਬਿਯਕਤ ਤੇਜ ਮਹਿਮਾ ਮਹਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਜਿਹ ਆਦਿ ਅੰਤਿ ਏਕੈ ਸਰੂਪ ॥",
      "s": 9
    },
    {
      "t": "ਸੁੰਦਰ ਸੁਰੰਗ ਜਗ ਕਰਿ ਅਰੂਪ ॥੮੪॥",
      "s": 9
    },
    {
      "t": "ਜਿਹ ਰਾਗ ਰੰਗ ਨਹੀ ਰੂਪ ਰੇਖ ॥",
      "s": 9
    },
    {
      "t": "ਨਹੀ ਨਾਮ ਠਾਮ ਅਨਭਵ ਅਭੇਖ ॥",
      "s": 9
    },
    {
      "t": "ਆਜਾਨ ਬਾਹਿ ਅਨਭਵ ਪ੍ਰਕਾਸ ॥",
      "s": 9
    },
    {
      "t": "ਆਭਾ ਅਨੰਤ ਮਹਿਮਾ ਸੁ ਬਾਸ ॥੮੫॥",
      "s": 9
    },
    {
      "t": "ਕਈ ਕਲਪ ਜੋਗ ਜਿਨਿ ਕਰਤ ਬੀਤ ॥",
      "s": 9
    },
    {
      "t": "ਨਹੀ ਤਦਿਪ ਤਉਨ ਧਰਿ ਗਏ ਚੀਤ ॥",
      "s": 9
    },
    {
      "t": "ਮੁਨਿ ਮਨ ਅਨੇਕ ਗੁਨਿ ਗਨ ਮਹਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਬਹੁ ਕਸਟ ਕਰਤ ਨਹੀ ਧਰਤ ਧਿਆਨ ॥੮੬॥",
      "s": 9
    },
    {
      "t": "ਜਿਹ ਏਕ ਰੂਪ ਕਿਨੇ ਅਨੇਕ ॥",
      "s": 9
    },
    {
      "t": "ਅੰਤਹਿ ਸਮੇਯ ਫੁਨਿ ਭਏ ਏਕ ॥",
      "s": 9
    },
    {
      "t": "ਕਈ ਕੋਟਿ ਜੰਤ ਜੀਵਨ ਉਪਾਇ ॥",
      "s": 9
    },
    {
      "t": "ਫਿਰਿ ਅੰਤ ਲੇਤ ਆਪਹਿ ਮਿਲਾਇ ॥੮੭॥",
      "s": 9
    },
    {
      "t": "ਜਿਹ ਜਗਤ ਜੀਵ ਸਬ ਪਰੇ ਸਰਨਿ ॥",
      "s": 9
    },
    {
      "t": "ਮੁਨ ਮਨਿ ਅਨੇਕ ਜਿਹ ਜਪਤ ਚਰਨ ॥",
      "s": 9
    },
    {
      "t": "ਕਈ ਕਲਪ ਤਿਹੰ ਕਰਤ ਧਿਆਨ ॥",
      "s": 9
    },
    {
      "t": "ਕਹੂੰ ਨ ਦੇਖਿ ਤਿਹ ਬਿਦਿਮਾਨ ॥੮੮॥",
      "s": 9
    },
    {
      "t": "ਆਭਾ ਅਨੰਤ ਮਹਿਮਾ ਅਪਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਮੁਨ ਮਨਿ ਮਹਾਨ ਅਤ ਹੀ ਉਦਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਆਛਿਜ ਤੇਜ ਸੂਰਤਿ ਅਪਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਨਹੀ ਸਕਤ ਬੁਧ ਕਰਿ ਕੈ ਬਿਚਾਰ ॥੮੯॥",
      "s": 9
    },
    {
      "t": "ਜਿਹ ਆਦਿ ਅੰਤਿ ਏਕਹਿ ਸਰੂਪ ॥",
      "s": 9
    },
    {
      "t": "ਸੋਭਾ ਅਭੰਗ ਮਹਿਮਾ ਅਨੂਪ ॥",
      "s": 9
    },
    {
      "t": "ਜਿਹ ਕੀਨ ਜੋਤਿ ਉਦੋਤ ਸਰਬ ॥",
      "s": 9
    },
    {
      "t": "ਜਿਹ ਹਤ੍ਰਯੋ ਸਰਬ ਗਰਬੀਨ ਗਰਬ ॥੯੦॥",
      "s": 9
    },
    {
      "t": "ਜਿਹ ਗਰਬਵੰਤ ਏਕੈ ਨ ਰਾਖ ॥",
      "s": 9
    },
    {
      "t": "ਫਿਰਿ ਕਹੋ ਬੈਣ ਨਹੀ ਬੈਣ ਭਾਖ ॥",
      "s": 9
    },
    {
      "t": "ਇਕ ਬਾਰ ਮਾਰਿ ਮਾਰ੍ਯੋ ਨ ਸਤ੍ਰੁ ॥",
      "s": 9
    },
    {
      "t": "ਇਕ ਬਾਰ ਡਾਰਿ ਡਾਰਿਓ ਨ ਅਤ੍ਰ ॥੯੧॥",
      "s": 9
    },
    {
      "t": "ਸੇਵਕ ਥਾਪਿ ਨਹੀ ਦੂਰ ਕੀਨ ॥",
      "s": 9
    },
    {
      "t": "ਲਖਿ ਭਈ ਭੂਲ ਮੁਖਿ ਬਿਹਸ ਦੀਨ ॥",
      "s": 9
    },
    {
      "t": "ਜਿਹ ਗਹੀ ਬਾਹਿਾਂ ਕਿਨੋ ਨਿਬਾਹ ॥",
      "s": 9
    },
    {
      "t": "ਤ੍ਰੀਯਾ ਏਕ ਬ੍ਯਾਹਿ ਨਹੀ ਕੀਨ ਬ੍ਯਾਹ ॥੯੨॥",
      "s": 9
    },
    {
      "t": "ਰੀਝੰਤ ਕੋਟਿ ਨਹੀ ਕਸਟ ਕੀਨ ॥",
      "s": 9
    },
    {
      "t": "ਸੀਝੰਤ ਏਕ ਹੀ ਨਾਮ ਲੀਨ ॥",
      "s": 9
    },
    {
      "t": "ਅਨਕਪਟ ਰੂਪ ਅਨਭਉ ਪ੍ਰਕਾਸ ॥",
      "s": 9
    },
    {
      "t": "ਖੜਗਨ ਸਪੰਨਿ ਨਿਸ ਦਿਨ ਨਿਰਾਸ ॥੯੩॥",
      "s": 9
    },
    {
      "t": "ਪਰਮੰ ਪਵਿਤ੍ਰ ਪੂਰਣ ਪੁਰਾਣ ॥",
      "s": 9
    },
    {
      "t": "ਮਹਿਮਾ ਅਭੰਗ ਸੋਭਾ ਨਿਧਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਪਾਵਨ ਪ੍ਰਸਿਧ ਪਰਮੰ ਪੁਨੀਤ ॥",
      "s": 9
    },
    {
      "t": "ਆਜਾਨ ਬਾਹੁ ਅਨਭੈ ਅਜੀਤ ॥੯੪॥",
      "s": 9
    },
    {
      "t": "ਕਈ ਕੋਟਿ ਇੰਦ੍ਰ ਜਿਹ ਪਾਨਿਹਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਕਈ ਚੰਦ ਸੂਰ ਕ੍ਰਿਸਨਾਵਤਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਕਈ ਬਿਸਨ ਰੁਦ੍ਰ ਰਾਮਾ ਰਸੂਲ ॥",
      "s": 9
    },
    {
      "t": "ਬਿਨੁ ਭਗਤਿ ਯੌ ਨ ਕੋਈ ਕਬੂਲ ॥੯੫॥",
      "s": 9
    },
    {
      "t": "ਕਈ ਦਤ ਸਤ ਗੋਰਖ ਦੇਵ ॥",
      "s": 9
    },
    {
      "t": "ਮੁਨਮਨਿ ਮਛਿੰਦ੍ਰ ਨਹੀ ਲਖਤ ਭੇਵ ॥",
      "s": 9
    },
    {
      "t": "ਬਹੁ ਭਾਤਿ ਮੰਤ੍ਰ ਮਤ ਕੈ ਪ੍ਰਕਾਸ ॥",
      "s": 9
    },
    {
      "t": "ਬਿਨੁ ਏਕ ਆਸ ਸਭ ਹੀ ਨਿਰਾਸ ॥੯੬॥",
      "s": 9
    },
    {
      "t": "ਜਿਹ ਨੇਤਿ ਨੇਤਿ ਭਾਖਤ ਨਿਗਮ ॥",
      "s": 9
    },
    {
      "t": "ਕਰਤਾਰ ਸਰਬ ਕਾਰਣ ਅਗਮ ॥",
      "s": 9
    },
    {
      "t": "ਜਿਹ ਲਖਤ ਕੋਈ ਨਹੀ ਕਉਨ ਜਾਤਿ ॥",
      "s": 9
    },
    {
      "t": "ਜਿਹ ਨਾਹਿ ਪਿਤਾ ਭ੍ਰਿਤ ਤਾਤ ਮਾਤ ॥੯੭॥",
      "s": 9
    },
    {
      "t": "ਜਾਨੀ ਨ ਜਾਤ ਜਿਹ ਰੰਗ ਰੂਪ ॥",
      "s": 9
    },
    {
      "t": "ਸਾਹਾਨ ਸਾਹਿ ਭੂਪਾਨ ਭੂਪ ॥",
      "s": 9
    },
    {
      "t": "ਜਿਹ ਬਰਣ ਜਾਤਿ ਨਹੀ ਕ੍ਰਿਤ ਅਨੰਤ ॥",
      "s": 9
    },
    {
      "t": "ਆਦੋ ਅਪਾਰ ਨਿਰਬਿਖ ਬਿਅੰਤ ॥੯੮॥",
      "s": 9
    },
    {
      "t": "ਬਰਣੀ ਨ ਜਾਤਿ ਜਿਹ ਰੰਗ ਰੇਖ ॥",
      "s": 9
    },
    {
      "t": "ਅਤਭੁਤ ਅਨੰਤ ਅਤਿ ਬਲ ਅਭੇਖ ॥",
      "s": 9
    },
    {
      "t": "ਅਨਖੰਡ ਚਿਤ ਅਬਿਕਾਰ ਰੂਪ ॥",
      "s": 9
    },
    {
      "t": "ਦੇਵਾਨ ਦੇਵ ਮਹਿਮਾ ਅਨੂਪ ॥੯੯॥",
      "s": 9
    },
    {
      "t": "ਉਸਤਤੀ ਨਿੰਦ ਜਿਹ ਇਕ ਸਮਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਆਭਾ ਅਖੰਡ ਮਹਿਮਾ ਮਹਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਅਬਿਕਾਰ ਚਿਤ ਅਨੁਭਵ ਪ੍ਰਕਾਸ ॥",
      "s": 9
    },
    {
      "t": "ਘਟਿ ਘਟਿ ਬਿਯਾਪ ਨਿਸ ਦਿਨ ਉਦਾਸ ॥੧੦੦॥",
      "s": 9
    },
    {
      "t": "ਇਹ ਭਾਤਿ ਦਤ ਉਸਤਤਿ ਉਚਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਡੰਡਵਤ ਕੀਨ ਅਤ੍ਰਿਜ ਉਦਾਰ ॥",
      "s": 9
    }
  ]
}
