{
  "page": 645,
  "lines": [
    {
      "t": "ਰਹੇ ਏਕ ਚਿਤੰ ਨ ਚਿਤੰ ਚਲਾਵੈ ॥",
      "s": 9
    },
    {
      "t": "ਕਰੈ ਜੋਗ ਨ੍ਯਾਸੰ ਨਿਰਾਸੰ ਉਦਾਸੀ ॥",
      "s": 9
    },
    {
      "t": "ਧਰੇ ਮੇਖਲਾ ਪਰਮ ਤਤੰ ਪ੍ਰਕਾਸੀ ॥੧੨੩॥",
      "s": 9
    },
    {
      "t": "ਮਹਾ ਆਤਮ ਦਰਸੀ ਮਹਾ ਤਤ ਬੇਤਾ ॥",
      "s": 9
    },
    {
      "t": "ਥਿਰੰ ਆਸਣੇਕੰ ਮਹਾ ਊਰਧਰੇਤਾ ॥",
      "s": 9
    },
    {
      "t": "ਕਰੈ ਸਤਿ ਕਰਮੰ ਕੁਕਰਮੰ ਪ੍ਰਨਾਸੰ ॥",
      "s": 9
    },
    {
      "t": "ਰਹੈ ਏਕ ਚਿਤੰ ਮੁਨੀਸੰ ਉਦਾਸੰ ॥੧੨੪॥",
      "s": 9
    },
    {
      "t": "ਸੁਭੰ ਸਾਸਤ੍ਰਗੰਤਾ ਕੁਕਰਮੰ ਪ੍ਰਣਾਸੀ ॥",
      "s": 9
    },
    {
      "t": "ਬਸੈ ਕਾਨਨੇਸੰ ਸੁਪਾਤ੍ਰੰ ਉਦਾਸੀ ॥",
      "s": 9
    },
    {
      "t": "ਤਜ੍ਯੋ ਕਾਮ ਕਰੋਧੰ ਸਬੈ ਲੋਭ ਮੋਹੰ ॥",
      "s": 9
    },
    {
      "t": "ਮਹਾ ਜੋਗ ਜ੍ਵਾਲਾ ਮਹਾ ਮੋਨਿ ਸੋਹੰ ॥੧੨੫॥",
      "s": 9
    },
    {
      "t": "ਕਰੈ ਨ੍ਯਾਸ ਏਕੰ ਅਨੇਕੰ ਪ੍ਰਕਾਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਮਹਾ ਬ੍ਰਹਮਚਰਜੰ ਸੁ ਧਰਮਾਧਿਕਾਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਮਹਾ ਤਤ ਬੇਤਾ ਸੁ ਸੰਨ੍ਯਾਸ ਜੋਗੰ ॥",
      "s": 9
    },
    {
      "t": "ਅਨਾਸੰ ਉਦਾਸੀ ਸੁ ਬਾਸੰ ਅਰੋਗੰ ॥੧੨੬॥",
      "s": 9
    },
    {
      "t": "ਅਨਾਸ ਮਹਾ ਊਰਧਰੇਤਾ ਸੰਨ੍ਯਾਸੀ ॥",
      "s": 9
    },
    {
      "t": "ਮਹਾ ਤਤ ਬੇਤਾ ਅਨਾਸੰ ਉਦਾਸੀ ॥",
      "s": 9
    },
    {
      "t": "ਸਬੈ ਜੋਗ ਸਾਧੈ ਰਹੈ ਏਕ ਚਿਤੰ ॥",
      "s": 9
    },
    {
      "t": "ਤਜੈ ਅਉਰ ਸਰਬੰ ਗਹ੍ਰਯੋ ਏਕ ਹਿਤੰ ॥੧੨੭॥",
      "s": 9
    },
    {
      "t": "ਤਰੇ ਤਾਪ ਧੂਮੰ ਕਰੈ ਪਾਨ ਉਚੰ ॥",
      "s": 9
    },
    {
      "t": "ਝੁਲੈ ਮਧਿ ਅਗਨੰ ਤਉ ਧਿਆਨ ਮੁਚੰ ॥",
      "s": 9
    },
    {
      "t": "ਮਹਾ ਬ੍ਰਹਮਚਰਜੰ ਮਹਾ ਧਰਮ ਧਾਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਭਏ ਦਤ ਕੇ ਰੁਦ੍ਰ ਪੂਰਣ ਵਤਾਰੀ ॥੧੨੮॥",
      "s": 9
    },
    {
      "t": "ਹਠੀ ਤਾਪਸੀ ਮੋਨ ਮੰਤ੍ਰ ਮਹਾਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਪਰੰ ਪੂਰਣੰ ਦਤ ਪ੍ਰਗ੍ਰਯਾ ਨਿਧਾਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਕਰੈ ਜੋਗ ਨ੍ਯਾਸੰ ਤਜੇ ਰਾਜ ਭੋਗੰ ॥",
      "s": 9
    },
    {
      "t": "ਚਕੇ ਸਰਬ ਦੇਵੰ ਜਕੇ ਸਰਬ ਲੋਗੰ ॥੧੨੯॥",
      "s": 9
    },
    {
      "t": "ਜਕੇ ਜਛ ਗੰਧ੍ਰਬ ਬਿਦਿਆ ਨਿਧਾਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਚਕੇ ਦੇਵਤਾ ਚੰਦ ਸੂਰੰ ਸੁਰਾਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਛਕੇ ਜੀਵ ਜੰਤ੍ਰੰ ਲਖੇ ਪਰਮ ਰੂਪੰ ॥",
      "s": 9
    },
    {
      "t": "ਤਜ੍ਯੋ ਗਰਬ ਸਰਬੰ ਲਗੇ ਪਾਨ ਭੂਪੰ ॥੧੩੦॥",
      "s": 9
    },
    {
      "t": "ਜਟੀ ਦੰਡ ਮੁੰਡੀ ਤਪੀ ਬ੍ਰਹਮਚਾਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਜਤੀ ਜੰਗਮੀ ਜਾਮਨੀ ਜੰਤ੍ਰ ਧਾਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਪਰੀ ਪਾਰਬਤੀ ਪਰਮ ਦੇਸੀ ਪਛੇਲੇ ॥",
      "s": 9
    },
    {
      "t": "ਬਲੀ ਬਾਲਖੀ ਬੰਗ ਰੂਮੀ ਰੁਹੇਲੇ ॥੧੩੧॥",
      "s": 9
    },
    {
      "t": "ਜਟੀ ਜਾਮਨੀ ਜੰਤ੍ਰ ਧਾਰੀ ਛਲਾਰੇ ॥",
      "s": 9
    },
    {
      "t": "ਅਜੀ ਆਮਰੀ ਨਿਵਲਕਾ ਕਰਮ ਵਾਰੇ ॥",
      "s": 9
    },
    {
      "t": "ਅਤੇਵਾਗਨਹੋਤ੍ਰੀ ਜੂਆ ਜਗ੍ਯ ਧਾਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਅਧੰ ਉਰਧਰੇਤੇ ਬਰੰ ਬ੍ਰਹਮਚਾਰੀ ॥੧੩੨॥",
      "s": 9
    },
    {
      "t": "ਜਿਤੇ ਦੇਸ ਦੇਸੰ ਹੁਤੇ ਛਤ੍ਰਧਾਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਸਬੈ ਪਾਨ ਲਗੇ ਤਜ੍ਯੋ ਗਰਬ ਭਾਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਕਰੈ ਲਾਗ ਸਰਬੰ ਸੁ ਸੰਨ੍ਯਾਸ ਜੋਗੰ ॥",
      "s": 9
    },
    {
      "t": "ਇਹੀ ਪੰਥ ਲਾਗੇ ਸੁਭੰ ਸਰਬ ਲੋਗੰ ॥੧੩੩॥",
      "s": 9
    },
    {
      "t": "ਸਬੇ ਦੇਸ ਦੇਸਾਨ ਤੇ ਲੋਗ ਆਏ ॥",
      "s": 9
    },
    {
      "t": "ਕਰੰ ਦਤ ਕੇ ਆਨਿ ਮੂੰਡੰ ਮੁੰਡਾਏ ॥",
      "s": 9
    },
    {
      "t": "ਧਰੇ ਸੀਸ ਪੈ ਪਰਮ ਜੂਟੇ ਜਟਾਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਕਰੈ ਲਾਗਿ ਸੰਨ੍ਯਾਸ ਜੋਗ ਅਪ੍ਰਮਾਨੰ ॥੧੩੪॥",
      "s": 9
    },
    {
      "t": "ਰੂਆਲ ਛੰਦ ॥",
      "s": 9
    }
  ]
}
