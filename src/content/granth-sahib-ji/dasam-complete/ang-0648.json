{
  "page": 648,
  "lines": [
    {
      "t": "ਕੇਈ ਸੁਨਤ ਪਾਠ ਪਰਮੰ ਪੁਨੀਤ ॥",
      "s": 9
    },
    {
      "t": "ਨਹੀ ਮੁਰਤ ਕਲਪ ਬਹੁਤ ਜਾਤ ਬੀਤ ॥੧੫੮॥",
      "s": 9
    },
    {
      "t": "ਕੇਈ ਬੈਠ ਕਰਤ ਜਲਿ ਕੋ ਅਹਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਕੇਈ ਭ੍ਰਮਤ ਦੇਸ ਦੇਸਨ ਪਹਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਕੇਈ ਜਪਤ ਮਧ ਕੰਦਰੀ ਦੀਹ ॥",
      "s": 9
    },
    {
      "t": "ਕੇਈ ਬ੍ਰਹਮਚਰਜ ਸਰਤਾ ਮਝੀਹ ॥੧੫੯॥",
      "s": 9
    },
    {
      "t": "ਕੇਈ ਰਹਤ ਬੈਠਿ ਮਧ ਨੀਰ ਜਾਇ ॥",
      "s": 9
    },
    {
      "t": "ਕੇਈ ਅਗਨ ਜਾਰਿ ਤਾਪਤ ਬਨਾਇ ॥",
      "s": 9
    },
    {
      "t": "ਕੇਈ ਰਹਤ ਸਿਧਿ ਮੁਖ ਮੋਨ ਠਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਅਨਿ ਆਸ ਚਿਤ ਇਕ ਆਸ ਮਾਨ ॥੧੬੦॥",
      "s": 9
    },
    {
      "t": "ਅਨਡੋਲ ਗਾਤ ਅਬਿਕਾਰ ਅੰਗ ॥",
      "s": 9
    },
    {
      "t": "ਮਹਿਮਾ ਮਹਾਨ ਆਭਾ ਅਭੰਗ ॥",
      "s": 9
    },
    {
      "t": "ਅਨਭੈ ਸਰੂਪ ਅਨਭਵ ਪ੍ਰਕਾਸ ॥",
      "s": 9
    },
    {
      "t": "ਅਬਯਕਤ ਤੇਜ ਨਿਸ ਦਿਨ ਉਦਾਸ ॥੧੬੧॥",
      "s": 9
    },
    {
      "t": "ਇਹ ਭਾਤਿ ਜੋਗਿ ਕੀਨੇ ਅਪਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਗੁਰ ਬਾਝ ਯੌ ਨ ਹੋਵੈ ਉਧਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਤਬ ਪਰੇ ਦਤ ਕੇ ਚਰਨਿ ਆਨਿ ॥",
      "s": 9
    },
    {
      "t": "ਕਹਿ ਦੇਹਿ ਜੋਗ ਕੇ ਗੁਰ ਬਿਧਾਨ ॥੧੬੨॥",
      "s": 9
    },
    {
      "t": "ਜਲ ਮਧਿ ਜੌਨ ਮੁੰਡੇ ਅਪਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਬਨ ਨਾਮ ਤਉਨ ਹ੍ਵੈਗੇ ਕੁਮਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਗਿਰਿ ਮਧਿ ਸਿਖ ਕਿਨੇ ਅਨੇਕ ॥",
      "s": 9
    },
    {
      "t": "ਗਿਰਿ ਭੇਸ ਸਹਤਿ ਸਮਝੋ ਬਿਬੇਕ ॥੧੬੩॥",
      "s": 9
    },
    {
      "t": "ਭਾਰਥ ਭਣੰਤ ਜੇ ਭੇ ਦੁਰੰਤ ॥",
      "s": 9
    },
    {
      "t": "ਭਾਰਥੀ ਨਾਮ ਤਾ ਕੇ ਭਣੰਤ ॥",
      "s": 9
    },
    {
      "t": "ਪੁਰਿ ਜਾਸ ਸਿਖ ਕੀਨੇ ਅਪਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਪੁਰੀ ਨਾਮ ਤਉਨ ਜਾਨ ਬਿਚਾਰ ॥੧੬੪॥",
      "s": 9
    },
    {
      "t": "ਪਰਬਤ ਬਿਖੈ ਸਜੇ ਸਿਖ ਕੀਨ ॥",
      "s": 9
    },
    {
      "t": "ਪਰਬਤਿ ਸੁ ਨਾਮ ਲੈ ਤਾਹਿ ਦੀਨ ॥",
      "s": 9
    },
    {
      "t": "ਇਹ ਭਾਤਿ ਉਚਰਿ ਕਰਿ ਪੰਚ ਨਾਮ ॥",
      "s": 9
    },
    {
      "t": "ਤਬ ਦਤ ਦੇਵ ਕਿੰਨੇ ਬਿਸ੍ਰਾਮ ॥੧੬੫॥",
      "s": 9
    },
    {
      "t": "ਸਾਗਰ ਮੰਝਾਰ ਜੇ ਸਿਖ ਕੀਨ ॥",
      "s": 9
    },
    {
      "t": "ਸਾਗਰਿ ਸੁ ਨਾਮ ਤਿਨ ਕੇ ਪ੍ਰਬੀਨ ॥",
      "s": 9
    },
    {
      "t": "ਸਾਰਸੁਤਿ ਤੀਰ ਜੇ ਕੀਨ ਚੇਲ ॥",
      "s": 9
    },
    {
      "t": "ਸਾਰਸੁਤੀ ਨਾਮ ਤਿਨ ਨਾਮ ਮੇਲ ॥੧੬੬॥",
      "s": 9
    },
    {
      "t": "ਤੀਰਥਨ ਬੀਚ ਜੇ ਸਿਖ ਕੀਨ ॥",
      "s": 9
    },
    {
      "t": "ਤੀਰਥਿ ਸੁ ਨਾਮ ਤਿਨ ਕੋ ਪ੍ਰਬੀਨ ॥",
      "s": 9
    },
    {
      "t": "ਜਿਨ ਚਰਨ ਦਤ ਕੇ ਗਹੇ ਆਨਿ ॥",
      "s": 9
    },
    {
      "t": "ਤੇ ਭਏ ਸਰਬ ਬਿਦਿਆ ਨਿਧਾਨ ॥੧੬੭॥",
      "s": 9
    },
    {
      "t": "ਇਮਿ ਕਰਤ ਸਿਖ ਜਹ ਤਹ ਬਿਹਾਰਿ ॥",
      "s": 9
    },
    {
      "t": "ਆਸ੍ਰਮਨ ਬੀਚ ਜੋ ਜੋ ਨਿਹਾਰਿ ॥",
      "s": 9
    },
    {
      "t": "ਤਹ ਤਹੀ ਸਿਖ ਜੋ ਕੀਨ ਜਾਇ ॥",
      "s": 9
    },
    {
      "t": "ਆਸ੍ਰਮਿ ਸੁ ਨਾਮ ਕੋ ਤਿਨ ਸੁਹਾਇ ॥੧੬੮॥",
      "s": 9
    },
    {
      "t": "ਆਰੰਨ ਬੀਚ ਜੇਅ ਭੇ ਦਤ ॥",
      "s": 9
    },
    {
      "t": "ਸੰਨ੍ਯਾਸ ਰਾਜ ਅਤਿ ਬਿਮਲ ਮਤਿ ॥",
      "s": 9
    },
    {
      "t": "ਤਹ ਤਹ ਸੁ ਕੀਨ ਜੇ ਸਿਖ ਜਾਇ ॥",
      "s": 9
    },
    {
      "t": "ਅਰਿੰਨਿ ਨਾਮ ਤਿਨ ਕੋ ਰਖਾਇ ॥੧੬੯॥",
      "s": 9
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਬਚਿਤ੍ਰ ਨਾਟਕ ਗ੍ਰੰਥੇ ਦਤ ਮਹਾਤਮੇ ਅਨਭਉ ਪ੍ਰਕਾਸੇ ਦਸ ਨਾਮ ਧ੍ਰਯਾਯ ਸੰਪੂਰਣ ॥",
      "s": 9
    },
    {
      "t": "ਪਾਧੜੀ ਛੰਦ ॥",
      "s": 9
    },
    {
      "t": "ਆਜਾਨ ਬਾਹੁ ਅਤਿਸੈ ਪ੍ਰਭਾਵ ॥",
      "s": 9
    },
    {
      "t": "ਅਬਿਯਕਤ ਤੇਜ ਸੰਨ੍ਯਾਸ ਰਾਵ ॥",
      "s": 9
    },
    {
      "t": "ਜਹ ਜਹ ਬਿਹਾਰ ਮੁਨਿ ਕਰਤ ਦਤ ॥",
      "s": 9
    },
    {
      "t": "ਅਨਭਉ ਪ੍ਰਕਾਸ ਅਰੁ ਬਿਮਲ ਮਤ ॥੧੭੦॥",
      "s": 9
    },
    {
      "t": "ਜੇ ਹੁਤੇ ਦੇਸ ਦੇਸਨ ਨ੍ਰਿਪਾਲ ॥",
      "s": 9
    },
    {
      "t": "ਤਜਿ ਗਰਬ ਪਾਨ ਲਾਗੇ ਸੁ ਢਾਲ ॥",
      "s": 9
    },
    {
      "t": "ਤਜਿ ਦੀਨ ਅਉਰ ਝੂਠੇ ਉਪਾਇ ॥",
      "s": 9
    },
    {
      "t": "ਦ੍ਰਿੜ ਗਹਿਓ ਏਕ ਸੰਨ੍ਯਾਸ ਰਾਇ ॥੧੭੧॥",
      "s": 9
    },
    {
      "t": "ਤਜਿ ਸਰਬ ਆਸ ਇਕ ਆਸ ਚਿਤ ॥",
