{
  "page": 650,
  "lines": [
    {
      "t": "ਧਿਆਨ ਲਾਇ ਮੁਨਿ ਨਿਰਖਨ ਲਾਗੈ ॥੧੮੫॥",
      "s": 9
    },
    {
      "t": "ਮੂਸ ਕਾਜ ਜਸ ਲਾਵਤ ਧਿਆਨੂ ॥",
      "s": 9
    },
    {
      "t": "ਲਾਜਤ ਦੇਖਿ ਮਹੰਤ ਮਹਾਨੂੰ ॥",
      "s": 9
    },
    {
      "t": "ਐਸ ਧਿਆਨ ਹਰਿ ਹੇਤ ਲਗਈਐ ॥",
      "s": 9
    },
    {
      "t": "ਤਬ ਹੀ ਨਾਥ ਨਿਰੰਜਨ ਪਈਐ ॥੧੮੬॥",
      "s": 9
    },
    {
      "t": "ਪੰਚਮ ਗੁਰੂ ਯਾਹਿ ਹਮ ਜਾਨਾ ॥",
      "s": 9
    },
    {
      "t": "ਯਾ ਕਹੁ ਭਾਵ ਹੀਐ ਅਨੁਮਾਨਾ ॥",
      "s": 9
    },
    {
      "t": "ਐਸੀ ਭਾਤਿ ਧਿਆਨ ਜੋ ਲਾਵੈ ॥",
      "s": 9
    },
    {
      "t": "ਸੋ ਨਿਹਚੈ ਸਾਹਿਬ ਕੋ ਪਾਵੈ ॥੧੮੭॥",
      "s": 9
    },
    {
      "t": "ਇਤਿ ਬਿੜਾਲ ਪੰਚਮੋ ਗੁਰੂ ਸਮਾਪਤੰ ॥੫॥",
      "s": 9
    },
    {
      "t": "ਅਥ ਧੁਨੀਆ ਗੁਰੂ ਕਥਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 9
    },
    {
      "t": "ਆਗੇ ਚਲਾ ਰਾਜ ਸੰਨ੍ਯਾਸਾ ॥",
      "s": 9
    },
    {
      "t": "ਏਕ ਆਸ ਗਹਿ ਐਸ ਅਨਾਸਾ ॥",
      "s": 9
    },
    {
      "t": "ਤਹ ਇਕ ਰੂਮ ਧੁਨਖਤੋ ਲਹਾ ॥",
      "s": 9
    },
    {
      "t": "ਐਸ ਭਾਤਿ ਮਨ ਸੌ ਮੁਨਿ ਕਹਾ ॥੧੮੮॥",
      "s": 9
    },
    {
      "t": "ਭੂਪ ਸੈਨ ਇਹ ਜਾਤ ਨ ਲਹੀ ॥",
      "s": 9
    },
    {
      "t": "ਗ੍ਰੀਵਾ ਨੀਚ ਨੀਚ ਹੀ ਰਹੀ ॥",
      "s": 9
    },
    {
      "t": "ਸਗਲ ਸੈਨ ਵਾਹੀ ਮਗ ਗਈ ॥",
      "s": 9
    },
    {
      "t": "ਤਾ ਕੌ ਨੈਕੁ ਖਬਰ ਨਹੀ ਭਈ ॥੧੮੯॥",
      "s": 9
    },
    {
      "t": "ਰੂਈ ਧੁਨਖਤੋ ਫਿਰਿ ਨ ਨਿਹਾਰਾ ॥",
      "s": 9
    },
    {
      "t": "ਨੀਚ ਹੀ ਗ੍ਰੀਵਾ ਰਹਾ ਬਿਚਾਰਾ ॥",
      "s": 9
    },
    {
      "t": "ਦਤ ਬਿਲੋਕਿ ਹੀਏ ਮੁਸਕਾਨਾ ॥",
      "s": 9
    },
    {
      "t": "ਖਸਟਮ ਗੁਰੂ ਤਿਸੀ ਕਹੁ ਜਾਨਾ ॥੧੯੦॥",
      "s": 9
    },
    {
      "t": "ਰੂਮ ਹੇਤ ਇਹ ਜਿਮ ਚਿਤੁ ਲਾਯੋ ॥",
      "s": 9
    },
    {
      "t": "ਸੈਨ ਗਈ ਪਰੁ ਸਿਰ ਨ ਉਚਾਯੋ ॥",
      "s": 9
    },
    {
      "t": "ਤੈਸੀਏ ਪ੍ਰਭ ਸੌ ਪ੍ਰੀਤਿ ਲਗਈਐ ॥",
      "s": 9
    },
    {
      "t": "ਤਬ ਹੀ ਪੁਰਖ ਪੁਰਾਤਨ ਪਈਐ ॥੧੯੧॥",
      "s": 9
    },
    {
      "t": "ਇਤਿ ਰੂਈ ਧੁਨਖਤਾ ਪੇਾਂਜਾ ਖਸਟਮੋ ਗੁਰੂ ਸਮਾਪਤੰ ॥੬॥",
      "s": 9
    },
    {
      "t": "ਅਥ ਮਾਛੀ ਸਪਤਮੋ ਗੁਰੂ ਕਥਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 9
    },
    {
      "t": "ਆਗੇ ਚਲਾ ਰਾਜ ਸੰਨ੍ਯਾਸਾ ॥",
      "s": 9
    },
    {
      "t": "ਮਹਾ ਬਿਮਲ ਮਨ ਭਯੋ ਉਦਾਸਾ ॥",
      "s": 9
    },
    {
      "t": "ਨਿਰਖਾ ਤਹਾ ਏਕ ਮਛਹਾ ॥",
      "s": 9
    },
    {
      "t": "ਲਏ ਜਾਰ ਕਰਿ ਜਾਤ ਨ ਕਹਾ ॥੧੯੨॥",
      "s": 9
    },
    {
      "t": "ਬਿਨਛੀ ਏਕ ਹਾਥ ਮੋ ਧਾਰੇ ॥",
      "s": 9
    },
    {
      "t": "ਜਰੀਆ ਅੰਧ ਕੰਧ ਪਰ ਡਾਰੇ ॥",
      "s": 9
    },
    {
      "t": "ਇਸਥਿਤ ਏਕ ਮਛਿ ਕੀ ਆਸਾ ॥",
      "s": 9
    },
    {
      "t": "ਜਾਨੁਕ ਵਾ ਕੇ ਮਧ ਨ ਸਾਸਾ ॥੧੯੩॥",
      "s": 9
    },
    {
      "t": "ਏਕਸੁ ਠਾਢ ਮਛ ਕੀ ਆਸੂ ॥",
      "s": 9
    },
    {
      "t": "ਰਾਜ ਪਾਟ ਤੇ ਜਾਨ ਉਦਾਸੂ ॥",
      "s": 9
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਨੇਹ ਨਾਥ ਸੌ ਲਈਐ ॥",
      "s": 9
    },
    {
      "t": "ਤਬ ਹੀ ਪੂਰਨ ਪੁਰਖ ਕਹ ਪਈਐ ॥੧੯੪॥",
      "s": 9
    },
    {
      "t": "ਇਤਿ ਮਾਛੀ ਗੁਰੂ ਸਪਤਮੋ ਸਮਾਪਤੰ ॥੭॥",
      "s": 9
    },
    {
      "t": "ਅਥ ਚੇਰੀ ਅਸਟਮੋ ਗੁਰੂ ਕਥਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 9
    },
    {
      "t": "ਹਰਖਤ ਅੰਗ ਸੰਗ ਸੈਨਾ ਸੁਨਿ ॥",
      "s": 9
    },
    {
      "t": "ਆਯੋ ਦਛ ਪ੍ਰਜਾਪਤਿ ਕੇ ਮੁਨਿ ॥",
      "s": 9
    }
  ]
}
