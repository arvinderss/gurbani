{
  "page": 658,
  "lines": [
    {
      "t": "ਪ੍ਰਭ ਏਕ ਹੀ ਰਸ ਪਗਤ ॥੨੮੦॥",
      "s": 9
    },
    {
      "t": "ਜਲ ਪਰਤ ਮੂਸਲਧਾਰ ॥",
      "s": 9
    },
    {
      "t": "ਗ੍ਰਿਹ ਲੇ ਨ ਓਟਿ ਦੁਆਰ ॥",
      "s": 9
    },
    {
      "t": "ਪਸੁ ਪਛ ਸਰਬਿ ਦਿਸਾਨ ॥",
      "s": 9
    },
    {
      "t": "ਸਭ ਦੇਸ ਦੇਸ ਸਿਧਾਨ ॥੨੮੧॥",
      "s": 9
    },
    {
      "t": "ਇਹ ਠਾਢ ਹੈ ਇਕ ਆਸ ॥",
      "s": 9
    },
    {
      "t": "ਇਕ ਪਾਨ ਜਾਨ ਉਦਾਸ ॥",
      "s": 9
    },
    {
      "t": "ਅਸਿ ਲੀਨ ਪਾਨਿ ਪ੍ਰਚੰਡ ॥",
      "s": 9
    },
    {
      "t": "ਅਤਿ ਤੇਜਵੰਤ ਅਖੰਡ ॥੨੮੨॥",
      "s": 9
    },
    {
      "t": "ਮਨਿ ਆਨਿ ਕੋ ਨਹੀ ਭਾਵ ॥",
      "s": 9
    },
    {
      "t": "ਇਕ ਦੇਵ ਕੋ ਚਿਤ ਚਾਵ ॥",
      "s": 9
    },
    {
      "t": "ਇਕ ਪਾਵ ਐਸੇ ਠਾਢ ॥",
      "s": 9
    },
    {
      "t": "ਰਨ ਖੰਭ ਜਾਨੁਕ ਗਾਡ ॥੨੮੩॥",
      "s": 9
    },
    {
      "t": "ਜਿਹ ਭੂਮਿ ਧਾਰਸ ਪਾਵ ॥",
      "s": 9
    },
    {
      "t": "ਨਹੀ ਨੈਕੁ ਫੇਰਿ ਉਚਾਵ ॥",
      "s": 9
    },
    {
      "t": "ਨਹੀ ਠਾਮ ਭੀਜਸ ਤਉਨ ॥",
      "s": 9
    },
    {
      "t": "ਅਵਲੋਕ ਭਇਓ ਮੁਨਿ ਮਉਨ ॥੨੮੪॥",
      "s": 9
    },
    {
      "t": "ਅਵਲੋਕਿ ਤਾਸੁ ਮੁਨੇਸ ॥",
      "s": 9
    },
    {
      "t": "ਅਕਲੰਕ ਭਾਗਵਿ ਭੇਸ ॥",
      "s": 9
    },
    {
      "t": "ਗੁਰੁ ਜਾਨਿ ਪਰੀਆ ਪਾਇ ॥",
      "s": 9
    },
    {
      "t": "ਤਜਿ ਲਾਜ ਸਾਜ ਸਚਾਇ ॥੨੮੫॥",
      "s": 9
    },
    {
      "t": "ਤਿਹ ਜਾਨ ਕੈ ਗੁਰਦੇਵ ॥",
      "s": 9
    },
    {
      "t": "ਅਕਲੰਕ ਦਤ ਅਭੇਵ ॥",
      "s": 9
    },
    {
      "t": "ਚਿਤ ਤਾਸ ਕੇ ਰਸ ਭੀਨ ॥",
      "s": 9
    },
    {
      "t": "ਗੁਰੁ ਤ੍ਰਉਦਸਮੋ ਤਿਹ ਕੀਨ ॥੨੮੬॥",
      "s": 9
    },
    {
      "t": "ਇਤਿ ਤ੍ਰਉਦਸਮੋ ਗੁਰੂ ਭ੍ਰਿਤ ਸਮਾਪਤੰ ॥੧੩॥",
      "s": 9
    },
    {
      "t": "ਅਥ ਚਤੁਰਦਸਮੋ ਗੁਰ ਨਾਮ ॥",
      "s": 9
    },
    {
      "t": "ਰਸਾਵਲ ਛੰਦ ॥",
      "s": 9
    },
    {
      "t": "ਚਲ੍ਯੋ ਦਤ ਰਾਜੰ ॥",
      "s": 9
    },
    {
      "t": "ਲਖੇ ਪਾਪ ਭਾਜੰ ॥",
      "s": 9
    },
    {
      "t": "ਜਿਨੈ ਨੈਕੁ ਪੇਖਾ ॥",
      "s": 9
    },
    {
      "t": "ਗੁਰੂ ਤੁਲਿ ਲੇਖਾ ॥੨੮੭॥",
      "s": 9
    },
    {
      "t": "ਮਹਾ ਜੋਤਿ ਰਾਜੈ ॥",
      "s": 9
    },
    {
      "t": "ਲਖੈ ਪਾਪ ਭਾਜੈ ॥",
      "s": 9
    },
    {
      "t": "ਮਹਾ ਤੇਜ ਸੋਹੈ ॥",
      "s": 9
    },
    {
      "t": "ਸਿਵਊ ਤੁਲਿ ਕੋ ਹੈ ॥੨੮੮॥",
      "s": 9
    },
    {
      "t": "ਜਿਨੈ ਨੈਕੁ ਪੇਖਾ ॥",
      "s": 9
    },
    {
      "t": "ਮਨੋ ਮੈਨ ਦੇਖਾ ॥",
      "s": 9
    },
    {
      "t": "ਸਹੀ ਬ੍ਰਹਮ ਜਾਨਾ ॥",
      "s": 9
    },
    {
      "t": "ਨ ਦ੍ਵੈ ਭਾਵ ਆਨਾ ॥੨੮੯॥",
      "s": 9
    },
    {
      "t": "ਰਿਝੀ ਸਰਬ ਨਾਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਮਹਾ ਤੇਜ ਧਾਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਨ ਹਾਰੰ ਸੰਭਾਰੈ ॥",
      "s": 9
    },
    {
      "t": "ਨ ਚੀਰਊ ਚਿਤਾਰੈ ॥੨੯੦॥",
      "s": 9
    },
    {
      "t": "ਚਲੀ ਧਾਇ ਐਸੇ ॥",
      "s": 9
    },
    {
      "t": "ਨਦੀ ਨਾਵ ਜੈਸੇ ॥",
      "s": 9
    },
    {
      "t": "ਜੁਵਾ ਬ੍ਰਿਧ ਬਾਲੈ ॥",
      "s": 9
    },
    {
      "t": "ਰਹੀ ਕੌ ਨ ਆਲੈ ॥੨੯੧॥",
      "s": 9
    }
  ]
}
