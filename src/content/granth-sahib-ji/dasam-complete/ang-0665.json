{
  "page": 665,
  "lines": [
    {
      "t": "ਅਤਿ ਉਜਲ ਅੰਗ ਸੁਰੰਗ ਸੁਭੰ ॥",
      "s": 9
    },
    {
      "t": "ਨਹੀ ਆਨਿ ਬਿਲੋਕਤ ਆਪ ਦ੍ਰਿਗੰ ॥",
      "s": 9
    },
    {
      "t": "ਇਹ ਭਾਤਿ ਰਹ੍ਯੋ ਗਡ ਮਛ ਮਨੰ ॥੩੬੭॥",
      "s": 9
    },
    {
      "t": "ਤਹਾ ਜਾਇ ਮਹਾ ਮੁਨਿ ਮਜਨ ਕੈ ॥",
      "s": 9
    },
    {
      "t": "ਉਠਿ ਕੈ ਹਰਿ ਧਿਆਨ ਲਗਾ ਸੁਚ ਕੈ ॥",
      "s": 9
    },
    {
      "t": "ਨ ਟਰੋ ਤਬ ਲੌ ਵਹ ਮਛ ਅਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਰਥ ਸੂਰ ਅਥਿਓ ਨਹ ਡੀਠ ਟਰੀ ॥੩੬੮॥",
      "s": 9
    },
    {
      "t": "ਥਰਕੰਤ ਰਹਾ ਨਭਿ ਮਛ ਕਟੰ ॥",
      "s": 9
    },
    {
      "t": "ਰਥ ਭਾਨੁ ਹਟਿਓ ਨਹੀ ਧ੍ਯਾਨ ਛੁਟੰ ॥",
      "s": 9
    },
    {
      "t": "ਅਵਿਲੋਕ ਮਹਾ ਮੁਨਿ ਮੋਹਿ ਰਹਿਓ ॥",
      "s": 9
    },
    {
      "t": "ਗੁਰੁ ਸਤ੍ਰਸਵੋ ਕਰ ਤਾਸੁ ਕਹਿਓ ॥੩੬੯॥",
      "s": 9
    },
    {
      "t": "ਇਤਿ ਸਤਾਰਵੋ ਗੁਰੂ ਦੁਧੀਰਾ ਸਮਾਪਤੰ ॥੧੭॥",
      "s": 9
    },
    {
      "t": "ਅਥ ਮ੍ਰਿਗਹਾ ਅਠਾਰਸਵੋ ਗੁਰੂ ਬਰਨਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਤੋਟਕ ਛੰਦ ॥",
      "s": 9
    },
    {
      "t": "ਕਰਿ ਮਜਨ ਗੋਬਿੰਦ ਗਾਇ ਗੁਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਉਠਿ ਜਾਤਿ ਭਏ ਬਨ ਮਧਿ ਮੁਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਜਹ ਸਾਲ ਤਮਾਲ ਮਢਾਲ ਲਸੈ ॥",
      "s": 9
    },
    {
      "t": "ਰਥ ਸੂਰਜ ਕੇ ਪਗ ਬਾਜ ਫਸੈ ॥੩੭੦॥",
      "s": 9
    },
    {
      "t": "ਅਵਿਲੋਕ ਤਹਾ ਇਕ ਤਾਲ ਮਹਾ ॥",
      "s": 9
    },
    {
      "t": "ਰਿਖਿ ਜਾਤ ਭਏ ਹਿਤ ਜੋਗ ਜਹਾ ॥",
      "s": 9
    },
    {
      "t": "ਤਹ ਪਤ੍ਰਣ ਮਧ ਲਹ੍ਯੋ ਮ੍ਰਿਗਹਾ ॥",
      "s": 9
    },
    {
      "t": "ਤਨ ਸੋਭਤ ਕੰਚਨ ਸੁਧ ਪ੍ਰਭਾ ॥੩੭੧॥",
      "s": 9
    },
    {
      "t": "ਕਰਿ ਸੰਧਿਤ ਬਾਣ ਕਮਾਣ ਸਿਤੰ ॥",
      "s": 9
    },
    {
      "t": "ਮ੍ਰਿਗ ਮਾਰਤ ਕੋਟ ਕਰੋਰ ਕਿਤੰ ॥",
      "s": 9
    },
    {
      "t": "ਸਭ ਸੈਨ ਮੁਨੀਸਰ ਸੰਗਿ ਲਏ ॥",
      "s": 9
    },
    {
      "t": "ਜਹ ਕਾਨਨ ਥੋ ਤਹ ਜਾਤ ਭਏ ॥੩੭੨॥",
      "s": 9
    },
    {
      "t": "ਕਨਕੰ ਦੁਤਿ ਉਜਲ ਅੰਗ ਸਨੇ ॥",
      "s": 9
    },
    {
      "t": "ਮੁਨਿ ਰਾਜ ਮਨੰ ਰਿਤੁ ਰਾਜ ਬਨੇ ॥",
      "s": 9
    },
    {
      "t": "ਰਿਖਿ ਸੰਗ ਸਖਾ ਨਿਸਿ ਬਹੁਤ ਲਏ ॥",
      "s": 9
    },
    {
      "t": "ਤਿਹ ਬਾਰਿਧ ਦੂਜ ਬਿਲੋਕਿ ਗਏ ॥੩੭੩॥",
      "s": 9
    },
    {
      "t": "ਰਿਖਿ ਬੋਲਤ ਘੋਰਤ ਨਾਦ ਨਵੰ ॥",
      "s": 9
    },
    {
      "t": "ਤਿਹ ਠਉਰ ਕੁਲਾਹਲ ਉਚ ਹੂਅੰ ॥",
      "s": 9
    },
    {
      "t": "ਜਲ ਪੀਵਤ ਠਉਰ ਹੀ ਠਉਰ ਮੁਨੀ ॥",
      "s": 9
    },
    {
      "t": "ਬਨ ਮਧਿ ਮਨੋ ਰਿਖ ਮਾਲ ਬਨੀ ॥੩੭੪॥",
      "s": 9
    },
    {
      "t": "ਅਤਿ ਉਜਲ ਅੰਗ ਬਿਭੂਤ ਧਰੈ ॥",
      "s": 9
    },
    {
      "t": "ਬਹੁ ਭਾਤਿ ਨ੍ਯਾਸ ਅਨਾਸ ਕਰੈ ॥",
      "s": 9
    },
    {
      "t": "ਨਿਵਲ੍ਰਯਾਦਿਕ ਸਰਬੰ ਕਰਮ ਕੀਏ ॥",
      "s": 9
    },
    {
      "t": "ਰਿਖਿ ਸਰਬ ਚਹੂੰ ਚਕ ਦਾਸ ਥੀਏ ॥੩੭੫॥",
      "s": 9
    },
    {
      "t": "ਅਨਭੰਗ ਅਖੰਡ ਅਨੰਗ ਤਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਬਹੁ ਸਾਧਤ ਨ੍ਯਾਸ ਸੰਨ੍ਯਾਸ ਬਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਜਟ ਸੋਹਤ ਜਾਨੁਕ ਧੂਰ ਜਟੀ ॥",
      "s": 9
    },
    {
      "t": "ਸਿਵ ਕੀ ਜਨੁ ਜੋਗ ਜਟਾ ਪ੍ਰਗਟੀ ॥੩੭੬॥",
      "s": 9
    },
    {
      "t": "ਸਿਵ ਤੇ ਜਨੁ ਗੰਗ ਤਰੰਗ ਛੁਟੇ ॥",
      "s": 9
    },
    {
      "t": "ਇਹ ਹੁਇ ਜਨ ਜੋਗ ਜਟਾ ਪ੍ਰਗਟੇ ॥",
      "s": 9
    },
    {
      "t": "ਤਪ ਸਰਬ ਤਪੀਸਨ ਕੇ ਸਬ ਹੀ ॥",
      "s": 9
    },
    {
      "t": "ਮੁਨਿ ਜੇ ਸਬ ਛੀਨ ਲਏ ਤਬ ਹੀ ॥੩੭੭॥",
      "s": 9
    },
    {
      "t": "ਸ੍ਰੁਤ ਜੇਤਿਕ ਨ੍ਯਾਸ ਉਦਾਸ ਕਹੇ ॥",
      "s": 9
    },
    {
      "t": "ਸਬ ਹੀ ਰਿਖਿ ਅੰਗਨ ਜਾਨ ਲਏ ॥",
      "s": 9
    }
  ]
}
