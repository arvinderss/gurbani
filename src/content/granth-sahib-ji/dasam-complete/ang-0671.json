{
  "page": 671,
  "lines": [
    {
      "t": "ਤਾ ਕੇ ਜਾਇ ਦੁਆਰ ਪਰ ਬੈਠੇ ॥",
      "s": 9
    },
    {
      "t": "ਸਕਲ ਮੁਨੀ ਮੁਨੀਰਾਜ ਇਕੈਠੇ ॥੪੪੨॥",
      "s": 9
    },
    {
      "t": "ਸਾਹ ਸੁ ਦਿਰਬ ਬ੍ਰਿਤ ਲਗ ਰਹਾ ॥",
      "s": 9
    },
    {
      "t": "ਰਿਖਨ ਓਰ ਤਿਨ ਚਿਤ੍ਰਯੋ ਨ ਕਹਾ ॥",
      "s": 9
    },
    {
      "t": "ਨੇਤ੍ਰ ਮੀਚ ਏਕੈ ਧਨ ਆਸਾ ॥",
      "s": 9
    },
    {
      "t": "ਐਸ ਜਾਨੀਅਤ ਮਹਾ ਉਦਾਸਾ ॥੪੪੩॥",
      "s": 9
    },
    {
      "t": "ਤਹ ਜੇ ਹੁਤੇ ਰਾਵ ਅਰੁ ਰੰਕਾ ॥",
      "s": 9
    },
    {
      "t": "ਮੁਨਿ ਪਗ ਪਰੇ ਛੋਰ ਕੈ ਸੰਕਾ ॥",
      "s": 9
    },
    {
      "t": "ਤਿਹ ਬਿਪਾਰ ਕਰਮ ਕਰ ਭਾਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਰਿਖੀਅਨ ਓਰ ਨ ਦ੍ਰਿਸਟਿ ਪਸਾਰੀ ॥੪੪੪॥",
      "s": 9
    },
    {
      "t": "ਤਾਸੁ ਦੇਖਿ ਕਰਿ ਦਤ ਪ੍ਰਭਾਊ ॥",
      "s": 9
    },
    {
      "t": "ਪ੍ਰਗਟ ਕਹਾ ਤਜ ਕੈ ਹਠ ਭਾਊ ॥",
      "s": 9
    },
    {
      "t": "ਐਸ ਪ੍ਰੇਮ ਪ੍ਰਭੁ ਸੰਗ ਲਗਈਐ ॥",
      "s": 9
    },
    {
      "t": "ਤਬ ਹੀ ਪੁਰਖੁ ਪੁਰਾਤਨ ਪਈਐ ॥੪੪੫॥",
      "s": 9
    },
    {
      "t": "ਇਤਿ ਸਾਹ ਬੀਸਵੋ ਗੁਰੂ ਸਮਾਪਤੰ ॥੨੦॥",
      "s": 9
    },
    {
      "t": "ਅਥ ਸੁਕ ਪੜਾਵਤ ਨਰ ਇਕੀਸਵੋ ਗੁਰੂ ਕਥਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 9
    },
    {
      "t": "ਬੀਸ ਗੁਰੂ ਕਰਿ ਆਗੇ ਚਲਾ ॥",
      "s": 9
    },
    {
      "t": "ਸੀਖੇ ਸਰਬ ਜੋਗ ਕੀ ਕਲਾ ॥",
      "s": 9
    },
    {
      "t": "ਅਤਿ ਪ੍ਰਭਾਵ ਅਮਿਤੋਜੁ ਪ੍ਰਤਾਪੂ ॥",
      "s": 9
    },
    {
      "t": "ਜਾਨੁਕ ਸਾਧਿ ਫਿਰਾ ਸਬ ਜਾਪੂ ॥੪੪੬॥",
      "s": 9
    },
    {
      "t": "ਲੀਏ ਬੈਠ ਦੇਖਾ ਇਕ ਸੂਆ ॥",
      "s": 9
    },
    {
      "t": "ਜਿਹ ਸਮਾਨ ਜਗਿ ਭਯੋ ਨ ਹੂਆ ॥",
      "s": 9
    },
    {
      "t": "ਤਾ ਕਹੁ ਨਾਥ ਸਿਖਾਵਤ ਬਾਨੀ ॥",
      "s": 9
    },
    {
      "t": "ਏਕ ਟਕ ਪਰਾ ਅਉਰ ਨ ਜਾਨੀ ॥੪੪੭॥",
      "s": 9
    },
    {
      "t": "ਸੰਗ ਲਏ ਰਿਖਿ ਸੈਨ ਅਪਾਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਬਡੇ ਬਡੇ ਮੋਨੀ ਬ੍ਰਤਿਧਾਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਤਾ ਕੇ ਤੀਰ ਤੀਰ ਚਲਿ ਗਏ ॥",
      "s": 9
    },
    {
      "t": "ਤਿਨਿ ਨਰ ਏ ਨਹੀ ਦੇਖਤ ਭਏ ॥੪੪੮॥",
      "s": 9
    },
    {
      "t": "ਸੋ ਨਰ ਸੁਕਹਿ ਪੜਾਵਤ ਰਹਾ ॥",
      "s": 9
    },
    {
      "t": "ਇਨੈ ਕਛੂ ਮੁਖ ਤੇ ਨਹੀ ਕਹਾ ॥",
      "s": 9
    },
    {
      "t": "ਨਿਰਖਿ ਨਿਠੁਰਤਾ ਤਿਹ ਮੁਨਿ ਰਾਊ ॥",
      "s": 9
    },
    {
      "t": "ਪੁਲਕ ਪ੍ਰੇਮ ਤਨ ਉਪਜਾ ਚਾਊ ॥੪੪੯॥",
      "s": 9
    },
    {
      "t": "ਐਸੇ ਨੇਹੁੰ ਨਾਥ ਸੋ ਲਾਵੈ ॥",
      "s": 9
    },
    {
      "t": "ਤਬ ਹੀ ਪਰਮ ਪੁਰਖ ਕਹੁ ਪਾਵੈ ॥",
      "s": 9
    },
    {
      "t": "ਇਕੀਸਵਾ ਗੁਰੁ ਤਾ ਕਹ ਕੀਆ ॥",
      "s": 9
    },
    {
      "t": "ਮਨ ਬਚ ਕਰਮ ਮੋਲ ਜਨੁ ਲੀਆ ॥੪੫੦॥",
      "s": 9
    },
    {
      "t": "ਇਤਿ ਇਕੀਸਵੋਂ ਗੁਰੁ ਸੁਕ ਪੜਾਵਤ ਨਰ ਸਮਾਪਤੰ ॥੨੧॥",
      "s": 9
    },
    {
      "t": "ਅਥਿ ਹਰ ਬਾਹਤ ਬਾਈਸਵੋ ਗੁਰੂ ਕਥਨੰ ॥",
      "s": 9
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 9
    },
    {
      "t": "ਜਬ ਇਕੀਸ ਕਰ ਗੁਰੂ ਸਿਧਾਰਾ ॥",
      "s": 9
    },
    {
      "t": "ਹਰ ਬਾਹਤ ਇਕ ਪੁਰਖ ਨਿਹਾਰਾ ॥",
      "s": 9
    },
    {
      "t": "ਤਾ ਕੀ ਨਾਰਿ ਮਹਾ ਸੁਖਕਾਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਪਤਿ ਕੀ ਆਸ ਹੀਏ ਜਿਹ ਭਾਰੀ ॥੪੫੧॥",
      "s": 9
    },
    {
      "t": "ਭਤਾ ਲਏ ਪਾਨਿ ਚਲਿ ਆਈ ॥",
      "s": 9
    },
    {
      "t": "ਜਨੁਕ ਨਾਥ ਗ੍ਰਿਹ ਬੋਲ ਪਠਾਈ ॥",
      "s": 9
    },
    {
      "t": "ਹਰ ਬਾਹਤ ਤਿਨ ਕਛੂ ਨ ਲਹਾ ॥",
      "s": 9
    },
    {
      "t": "ਤ੍ਰੀਆ ਕੋ ਧਿਆਨ ਨਾਥ ਪ੍ਰਤਿ ਰਹਾ ॥੪੫੨॥",
      "s": 9
    }
  ]
}
