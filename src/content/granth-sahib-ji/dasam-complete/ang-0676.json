{
  "page": 676,
  "lines": [
    {
      "t": "ਸੁਨੋ ਭੂਪ ਇਕ ਕਹੋਂ ਕਹਾਨੀ ॥",
      "s": 9
    },
    {
      "t": "ਏਕ ਪੁਰਖ ਉਪਜ੍ਯੋ ਅਭਿਮਾਨੀ ॥",
      "s": 9
    },
    {
      "t": "ਜਿਹ ਸਮ ਰੂਪ ਜਗਤ ਨਹੀ ਕੋਈ ॥",
      "s": 9
    },
    {
      "t": "ਏਕੈ ਘੜਾ ਬਿਧਾਤਾ ਸੋਈ ॥੫॥",
      "s": 9
    },
    {
      "t": "ਕੈ ਗੰਧ੍ਰਬ ਜਛ ਕੋਈ ਅਹਾ ॥",
      "s": 9
    },
    {
      "t": "ਜਾਨੁਕ ਦੂਸਰ ਭਾਨੁ ਚੜ ਰਹਾ ॥",
      "s": 9
    },
    {
      "t": "ਅਤਿ ਜੋਬਨ ਝਮਕਤ ਤਿਹ ਅੰਗਾ ॥",
      "s": 9
    },
    {
      "t": "ਨਿਰਖਤ ਜਾ ਕੇ ਲਜਤ ਅਨੰਗਾ ॥੬॥",
      "s": 9
    },
    {
      "t": "ਭੂਪਤਿ ਦੇਖਨ ਕਾਜ ਬੁਲਾਵਾ ॥",
      "s": 9
    },
    {
      "t": "ਪਹਿਲੇ ਦ੍ਯੋਸ ਸਾਥ ਚਲ ਆਵਾ ॥",
      "s": 9
    },
    {
      "t": "ਹਰਖ ਹ੍ਰਿਦੈ ਧਰ ਕੇ ਜਟਧਾਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਜਾਨੁਕ ਦੁਤੀ ਦਤ ਅਵਤਾਰੀ ॥੭॥",
      "s": 9
    },
    {
      "t": "ਨਿਰਖ ਰੂਪ ਕਾਪੇ ਜਟਧਾਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਯਹ ਕੋਊ ਭਯੋ ਪੁਰਖੁ ਅਵਤਾਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਯਹ ਮਤ ਦੂਰ ਹਮਾਰਾ ਕੈ ਹੈ ॥",
      "s": 9
    },
    {
      "t": "ਜਟਾਧਾਰ ਕੋਈ ਰਹੈ ਨ ਪੈ ਹੈ ॥੮॥",
      "s": 9
    },
    {
      "t": "ਤੇਜ ਪ੍ਰਭਾਵ ਨਿਰਖਿ ਤਬ ਰਾਜਾ ॥",
      "s": 9
    },
    {
      "t": "ਅਤਿ ਪ੍ਰਸੰਨਿ ਪੁਲਕਤ ਚਿਤ ਗਾਜਾ ॥",
      "s": 9
    },
    {
      "t": "ਜਿਹ ਜਿਹਾ ਲਖਾ ਰਹੇ ਬਿਸਮਾਈ ॥",
      "s": 9
    },
    {
      "t": "ਜਾਨੁਕ ਰੰਕ ਨਵੋ ਨਿਧ ਪਾਈ ॥੯॥",
      "s": 9
    },
    {
      "t": "ਮੋਹਨ ਜਾਲ ਸਭਨ ਸਿਰ ਡਾਰਾ ॥",
      "s": 9
    },
    {
      "t": "ਚੇਟਕ ਬਾਨ ਚਕ੍ਰਿਤ ਹ੍ਵੈ ਮਾਰਾ ॥",
      "s": 9
    },
    {
      "t": "ਜਹ ਤਹ ਮੋਹਿ ਸਕਲ ਨਰ ਗਿਰੇ ॥",
      "s": 9
    },
    {
      "t": "ਜਾਨ ਸੁਭਟ ਸਾਮੁਹਿ ਰਣ ਭਿਰੇ ॥੧੦॥",
      "s": 9
    },
    {
      "t": "ਨਰ ਨਾਰੀ ਜਿਹ ਜਿਹ ਤਿਹ ਪੇਖਾ ॥",
      "s": 9
    },
    {
      "t": "ਤਿਹ ਤਿਹ ਮਦਨ ਰੂਪ ਅਵਿਰੇਖਾ ॥",
      "s": 9
    },
    {
      "t": "ਸਾਧਨ ਸਰਬ ਸਿਧਿ ਕਰ ਜਾਨਾ ॥",
      "s": 9
    },
    {
      "t": "ਜੋਗਨ ਜੋਗ ਰੂਪ ਅਨੁਮਾਨਾ ॥੧੧॥",
      "s": 9
    },
    {
      "t": "ਨਿਰਖਿ ਰੂਪ ਰਨਵਾਸ ਲੁਭਾਨਾ ॥",
      "s": 9
    },
    {
      "t": "ਦੇ ਤਿਹ ਸੁਤਾ ਨ੍ਰਿਪਤਿ ਮਨਿ ਮਾਨਾ ॥",
      "s": 9
    },
    {
      "t": "ਨ੍ਰਿਪ ਕੋ ਭਯੋ ਜਬੈ ਜਾਮਾਤਾ ॥",
      "s": 9
    },
    {
      "t": "ਮਹਾ ਧਨੁਖਧਰ ਬੀਰ ਬਿਖ੍ਯਾਤਾ ॥੧੨॥",
      "s": 9
    },
    {
      "t": "ਮਹਾ ਰੂਪ ਅਰੁ ਅਮਿਤ ਪ੍ਰਤਾਪੂ ॥",
      "s": 9
    },
    {
      "t": "ਜਾਨੁ ਜਪੈ ਹੈ ਆਪਨ ਜਾਪੂ ॥",
      "s": 9
    },
    {
      "t": "ਸਸਤ੍ਰ ਸਾਸਤ੍ਰ ਬੇਤਾ ਸੁਰਿ ਗ੍ਯਾਨਾ ॥",
      "s": 9
    },
    {
      "t": "ਜਾ ਸਮ ਪੰਡਿਤ ਜਗਤਿ ਨ ਆਨਾ ॥੧੩॥",
      "s": 9
    },
    {
      "t": "ਥੋਰਿ ਬਹਿਕ੍ਰਮ ਬੁਧਿ ਬਿਸੇਖਾ ॥",
      "s": 9
    },
    {
      "t": "ਜਾਨੁਕ ਧਰਾ ਬਿਤਨ ਯਹਿ ਭੇਖਾ ॥",
      "s": 9
    },
    {
      "t": "ਜਿਹ ਜਿਹ ਰੂਪ ਤਵਨ ਕਾ ਲਹਾ ॥",
      "s": 9
    },
    {
      "t": "ਸੋ ਸੋ ਚਮਕ ਚਕ੍ਰਿ ਹੁਐ ਰਹਾ ॥੧੪॥",
      "s": 9
    },
    {
      "t": "ਸਵੈਯਾ ॥",
      "s": 9
    },
    {
      "t": "ਮਾਨ ਭਰੇ ਸਰ ਸਾਨ ਧਰੇ ਮਠ ਸਾਨ ਚੜੇ ਅਸਿ ਸ੍ਰੋਣਤਿ ਸਾਏ ॥",
