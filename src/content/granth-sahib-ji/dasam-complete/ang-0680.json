{
  "page": 680,
  "lines": [
    {
      "t": "ਸੁੰਭ ਹੰਤੀ ਜਯੰਤੀ ਖੰਕਾਲੀ ॥",
      "s": 9
    },
    {
      "t": "ਕੰਕੜੀਆ ਰੂਪਾ ਰਕਤਾਲੀ ॥",
      "s": 9
    },
    {
      "t": "ਤੋਤਲੀਆ ਜਿਹਵਾ ਸਿੰਧੁਲੀਆ ॥",
      "s": 9
    },
    {
      "t": "ਹਿੰਗਲੀਆ ਮਾਤਾ ਪਿੰਗਲੀਆ ॥੫੮॥",
      "s": 9
    },
    {
      "t": "ਚੰਚਾਲੀ ਚਿਤ੍ਰਾ ਚਿਤ੍ਰਾਗੀ ॥",
      "s": 9
    },
    {
      "t": "ਭਿੰਭਰੀਆ ਭੀਮਾ ਸਰਬਾਗੀ ॥",
      "s": 9
    },
    {
      "t": "ਬੁਧਿ ਭੂਪਾ ਕੂਪਾ ਜੁਜ੍ਵਾਲੀ ॥",
      "s": 9
    },
    {
      "t": "ਅਕਲੰਕਾ ਮਾਈ ਨ੍ਰਿਮਾਲੀ ॥੫੯॥",
      "s": 9
    },
    {
      "t": "ਉਛਲੈ ਲੰਕੁੜੀਆ ਛਤ੍ਰਾਲਾ ॥",
      "s": 9
    },
    {
      "t": "ਭਿੰਭਰੀਆ ਭੈਰੋ ਭਉਹਾਲਾ ॥",
      "s": 9
    },
    {
      "t": "ਜੈ ਦਾਤਾ ਮਾਤਾ ਜੈਦਾਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਲੋਕੇਸੀ ਦੁਰਗਾ ਭਾਵਾਣੀ ॥੬੦॥",
      "s": 9
    },
    {
      "t": "ਸੰਮੋਹੀ ਸਰਬੰ ਜਗਤਾਯੰ ॥",
      "s": 9
    },
    {
      "t": "ਨਿੰਦ੍ਰਾ ਛੁਧ੍ਰਯਾ ਪਿਪਾਸਾਯੰ ॥",
      "s": 9
    },
    {
      "t": "ਜੈ ਕਾਲੰ ਰਾਤੀ ਸਕ੍ਰਾਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਉਧਾਰੀ ਭਾਰੀ ਭਗਤਾਣੀ ॥੬੧॥",
      "s": 9
    },
    {
      "t": "ਜੈ ਮਾਈ ਗਾਈ ਬੇਦਾਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਅਨਛਿਜ ਅਭਿਦਾ ਅਖਿਦਾਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਭੈ ਹਰਣੀ ਸਰਬੰ ਸੰਤਾਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਜੈ ਦਾਤਾ ਮਾਤਾ ਕ੍ਰਿਪਾਣੀ ॥੬੨॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 9
    },
    {
      "t": "ਅਚਕੜਾ ਛੰਦ ॥ ਤ੍ਵਪ੍ਰਸਾਦਿ ॥",
      "s": 9
    },
    {
      "t": "ਅੰਬਿਕਾ ਤੋਤਲਾ ਸੀਤਲਾ ਸਾਕਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਸਿੰਧੁਰੀ ਸੁਪ੍ਰਭਾ ਸੁਭ੍ਰਮਾ ਡਾਕਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਸਾਵਜਾ ਸੰਭਿਰੀ ਸਿੰਧੁਲਾ ਦੁਖਹਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਸੁੰਮਿਲਾ ਸੰਭਿਲਾ ਸੁਪ੍ਰਭਾ ਦੁਧਰੀ ॥੬੩॥",
      "s": 9
    },
    {
      "t": "ਭਾਵਨਾ ਭੈ ਹਰੀ ਭੂਤਿਲੀ ਭੈਹਰਾ ॥",
      "s": 9
    },
    {
      "t": "ਟਾਕਣੀ ਝਾਕਣੀ ਸਾਕਣੀ ਸਿੰਧੁਲਾ ॥",
      "s": 9
    },
    {
      "t": "ਦੁਧਰਾ ਦ੍ਰੁਮੁਖਾ ਦ੍ਰੁਕਟਾ ਦੁਧਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਕੰਪਿਲਾ ਜੰਪਿਲਾ ਹਿੰਗੁਲਾ ਭੈਹਰੀ ॥੬੪॥",
      "s": 9
    },
    {
      "t": "ਚਿਤ੍ਰਣੀ ਚਾਪਣੀ ਚਾਰਣੀ ਚਛਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਹਿੰਗੁਲਾ ਪਿੰਗੁਲਾ ਗੰਧ੍ਰਬਾ ਜਛਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਬਰਮਣੀ ਚਰਮਣੀ ਪਰਘਣੀ ਪਾਸਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਖੜਗਣੀ ਗੜਗਣੀ ਸੈਥਣੀ ਸਾਪਣੀ ॥੬੫॥",
      "s": 9
    },
    {
      "t": "ਭੀਮੜਾ ਸਮਦੜਾ ਹਿੰਗੁਲਾ ਕਾਰਤਕੀ ॥",
      "s": 9
    },
    {
      "t": "ਸੁਪ੍ਰਭਾ ਅਛਿਦਾ ਅਧਿਰਾ ਮਾਰਤਕੀ ॥",
      "s": 9
    },
    {
      "t": "ਗਿੰਗਲੀ ਹਿੰਗੁਲੀ ਠਿੰਗੁਲੀ ਪਿੰਗੁਲਾ ॥",
      "s": 9
    },
    {
      "t": "ਚਿਕਣੀ ਚਰਕਟਾ ਚਰਪਟਾ ਚਾਵਡਾ ॥੬੬॥",
      "s": 9
    },
    {
      "t": "ਅਛਿਦਾ ਅਭਿਦਾ ਅਸਿਤਾ ਅਧਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਅਕਟਾ ਅਖੰਡਾ ਅਛਟਾ ਦੁਧਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਅੰਜਨੀ ਅੰਬਿਕਾ ਅਸਤ੍ਰਣੀ ਧਾਰਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਅਭਰੰ ਅਧਰਾ ਜਗਤਿ ਉਧਾਰਣੀ ॥੬੭॥",
      "s": 9
    },
    {
      "t": "ਅੰਜਨੀ ਗੰਜਨੀ ਸਾਕੜੀ ਸੀਤਲਾ ॥",
      "s": 9
    },
    {
      "t": "ਸਿਧਰੀ ਸੁਪ੍ਰਭਾ ਸਾਮਲਾ ਤੋਤਲਾ ॥",
      "s": 9
    },
    {
      "t": "ਸੰਭਰੀ ਗੰਭਰੀ ਅੰਭਰੀ ਅਕਟਾ ॥",
      "s": 9
    },
    {
      "t": "ਦੁਸਲਾ ਦ੍ਰੁਭਿਖਾ ਦ੍ਰੁਕਟਾ ਅਮਿਟਾ ॥੬੮॥",
      "s": 9
    },
    {
      "t": "ਭੈਰਵੀ ਭੈਹਰੀ ਭੂਚਰਾ ਭਾਨਵੀ ॥",
      "s": 9
    },
    {
      "t": "ਤ੍ਰਿਕੁਟਾ ਚਰਪਟਾ ਚਾਵਡਾ ਮਾਨਵੀ ॥",
      "s": 9
    },
    {
      "t": "ਜੋਬਨਾ ਜੈਕਰੀ ਜੰਭਹਰੀ ਜਾਲਪਾ ॥",
      "s": 9
    }
  ]
}
