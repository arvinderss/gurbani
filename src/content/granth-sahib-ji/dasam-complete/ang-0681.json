{
  "page": 681,
  "lines": [
    {
      "t": "ਤੋਤਲਾ ਤੁੰਦਲਾ ਦੰਤਲੀ ਕਾਲਿਕਾ ॥੬੯॥",
      "s": 9
    },
    {
      "t": "ਭਰਮਣਾ ਨਿਭ੍ਰਮਾ ਭਾਵਨਾ ਭੈਹਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਬਰ ਬੁਧਾ ਦਾਤ੍ਰਣੀ ਸਤ੍ਰਣੀ ਛੈਕਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਦ੍ਰੁਕਟਾ ਦ੍ਰੁਭਿਦਾ ਦੁਧਰਾ ਦ੍ਰੁਮਦੀ ॥",
      "s": 9
    },
    {
      "t": "ਅਤ੍ਰੁਟਾ ਅਛੁਟਾ ਅਜਟਾ ਅਭਿਦੀ ॥੭੦॥",
      "s": 9
    },
    {
      "t": "ਤੰਤਲਾ ਅੰਤਲਾ ਸੰਤਲਾ ਸਾਵਜਾ ॥",
      "s": 9
    },
    {
      "t": "ਭੀਮੜਾ ਭੈਹਰੀ ਭੂਤਲਾ ਬਾਵਜਾ ॥",
      "s": 9
    },
    {
      "t": "ਡਾਕਣੀ ਸਾਕਣੀ ਝਾਕਣੀ ਕਾਕਿੜਾ ॥",
      "s": 9
    },
    {
      "t": "ਕਿੰਕੜੀ ਕਾਲਿਕਾ ਜਾਲਪਾ ਜੈ ਮ੍ਰਿੜਾ ॥੭੧॥",
      "s": 9
    },
    {
      "t": "ਠਿੰਗੁਲਾ ਹਿੰਗੁਲਾ ਪਿੰਗੁਲਾ ਪ੍ਰਾਸਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਸਸਤ੍ਰਣੀ ਅਸਤ੍ਰਣੀ ਸੂਲਣੀ ਸਾਸਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਕੰਨਿਕਾ ਅੰਨਿਕਾ ਧੰਨਿਕਾ ਧਉਲਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਰਕਤਿਕਾ ਸਕਤਿਕਾ ਭਕਤਕਾ ਜੈਕਰੀ ॥੭੨॥",
      "s": 9
    },
    {
      "t": "ਝਿੰਗੜਾ ਪਿੰਗੜਾ ਜਿੰਗੜਾ ਜਾਲਪਾ ॥",
      "s": 9
    },
    {
      "t": "ਜੋਗਣੀ ਭੋਗਣੀ ਰੋਗ ਹਰੀ ਕਾਲਿਕਾ ॥",
      "s": 9
    },
    {
      "t": "ਚੰਚਲਾ ਚਾਵਡਾ ਚਾਚਰਾ ਚਿਤ੍ਰਤਾ ॥",
      "s": 9
    },
    {
      "t": "ਤੰਤਰੀ ਭਿੰਭਰੀ ਛਤ੍ਰਣੀ ਛਿੰਛਲਾ ॥੭੩॥",
      "s": 9
    },
    {
      "t": "ਦੰਤੁਲਾ ਦਾਮਣੀ ਦ੍ਰੁਕਟਾ ਦ੍ਰੁਭ੍ਰਮਾ ॥",
      "s": 9
    },
    {
      "t": "ਛੁਧਿਤਾ ਨਿੰਦ੍ਰਕਾ ਨ੍ਰਿਭਿਖਾ ਨ੍ਰਿਗਮਾ ॥",
      "s": 9
    },
    {
      "t": "ਕਦ੍ਰਕਾ ਚੂੜਿਕਾ ਚਾਚਕਾ ਚਾਪਣੀ ॥",
      "s": 9
    },
    {
      "t": "ਚਿਚ੍ਰੜੀ ਚਾਵੜਾ ਚਿੰਪਿਲਾ ਜਾਪਣੀ ॥੭੪॥",
      "s": 9
    },
    {
      "t": "ਬਿਸਨਪਦ ॥ ਪਰਜ ॥ ਤ੍ਵਪ੍ਰਸਾਦਿ ਕਥਤਾ ॥",
      "s": 9
    },
    {
      "t": "ਕੈਸੇ ਕੈ ਪਾਇਨ ਪ੍ਰਭਾ ਉਚਾਰੋਂ ॥",
      "s": 9
    },
    {
      "t": "ਜਾਨੁਕ ਨਿਪਟ ਅਘਟ ਅੰਮ੍ਰਿਤ ਸਮ ਸੰਪਟ ਸੁਭਟ ਬਿਚਾਰੋ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 9
    },
    {
      "t": "ਮਨ ਮਧੁਕਰਹਿ ਚਰਨ ਕਮਲਨ ਪਰ ਹ੍ਵੈ ਮਨਮਤ ਗੁੰਜਾਰੋ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 9
    },
    {
      "t": "ਮਾਤ੍ਰਿਕ ਸਪਤ ਸਪਿਤ ਪਿਤਰਨ ਕੁਲ ਚੌਦਹੂੰ ਕੁਲੀ ਉਧਾਰੋ ॥੭੫॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 9
    },
    {
      "t": "ਬਿਸਨਪਦ ॥ ਕਾਫੀ ॥",
      "s": 9
    },
    {
      "t": "ਤਾ ਦਿਨ ਦੇਹ ਸਫਲ ਕਰ ਜਾਨੋ ॥",
      "s": 9
    },
    {
      "t": "ਜਾ ਦਿਨ ਜਗਤ ਮਾਤ ਪ੍ਰਫੁਲਿਤ ਹ੍ਵੈ ਦੇਹਿ ਬਿਜੈ ਬਰਦਾਨੋ ॥",
      "v": [
