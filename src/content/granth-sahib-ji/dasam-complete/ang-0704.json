{
  "page": 704,
  "lines": [
    {
      "t": "ਭਲ ਭਲ ਸੁਭਟ ਪਖਰੀਆ ਪਰਖਾ ॥",
      "s": 9
    },
    {
      "t": "ਸਿਮਟੇ ਸੁਭਟ ਅਨੰਤ ਅਪਾਰਾ ॥",
      "s": 9
    },
    {
      "t": "ਪਰਿ ਗਈ ਅੰਧ ਧੁੰਧ ਬਿਕਰਾਰਾ ॥੨੯੩॥",
      "s": 9
    },
    {
      "t": "ਨ੍ਰਿਪ ਬਿਬੇਕ ਤਬ ਰੋਸਹਿ ਭਰਾ ॥",
      "s": 9
    },
    {
      "t": "ਸਭ ਸੈਨਾ ਕਹਿ ਆਇਸੁ ਕਰਾ ॥",
      "s": 9
    },
    {
      "t": "ਉਮਡੇ ਸੂਰ ਸੁ ਫਉਜ ਬਨਾਈ ॥",
      "s": 9
    },
    {
      "t": "ਨਾਮ ਤਾਸ ਕਬਿ ਦੇਤ ਬਤਾਈ ॥੨੯੪॥",
      "s": 9
    },
    {
      "t": "ਸਿਰੀ ਪਾਖਰੀ ਟੋਪ ਸਵਾਰੇ ॥",
      "s": 9
    },
    {
      "t": "ਚਿਲਤਹ ਰਾਗ ਸੰਜੋਵਾ ਡਾਰੇ ॥",
      "s": 9
    },
    {
      "t": "ਚਲੇ ਜੁਧ ਕੇ ਕਾਜ ਸੁ ਬੀਰਾ ॥",
      "s": 9
    },
    {
      "t": "ਸੂਖਤ ਭਯੋ ਨਦਨ ਕੋ ਨੀਰਾ ॥੨੯੫॥",
      "s": 9
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 9
    },
    {
      "t": "ਦੁਹੂ ਦਿਸਨ ਮਾਰੂ ਬਜ੍ਯੋ ਪਰ੍ਯੋ ਨਿਸਾਣੇ ਘਾਉ ॥",
      "s": 9
    },
    {
      "t": "ਉਮਡਿ ਦੁਬਹੀਆ ਉਠਿ ਚਲੇ ਭਯੋ ਭਿਰਨ ਕੋ ਚਾਉ ॥੨੯੬॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 9
    },
    {
      "t": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 9
    },
    {
      "t": "ਰਣੰ ਸੁਧਿ ਸਾਵੰਤ ਭਾਵੰਤ ਗਾਜੇ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 9
    },
    {
      "t": "ਤਹਾ ਤੂਰ ਭੇਰੀ ਮਹਾ ਸੰਖ ਬਾਜੇ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 9
    },
    {
      "t": "ਭਯੋ ਉਚ ਕੋਲਾਹਲੰ ਬੀਰ ਖੇਤੰ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 9
    },
    {
      "t": "ਬਹੇ ਸਸਤ੍ਰ ਅਸਤ੍ਰੰ ਨਚੇ ਭੂਤ ਪ੍ਰੇਤੰ ॥੨੯੭॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 9
    },
    {
      "t": "ਫਰੀ ਧੋਪ ਪਾਇਕ ਸੁ ਖੰਡੇ ਬਿਸੇਖੰ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 9
    },
    {
      "t": "ਤੁਰੇ ਤੁੰਦ ਤਾਜੀ ਭਏ ਭੂਤ ਭੇਖੰ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 9
    },
    {
      "t": "ਰਣੰ ਰਾਗ ਬਜੇ ਤਿ ਗਜੇ ਭਟਾਣੰ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 9
    },
    {
      "t": "ਤੁਰੀ ਤਤ ਨਚੇ ਪਲਟੇ ਭਟਾਣੰ ॥੨੯੮॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 9
    },
    {
      "t": "ਹਿਣੰਕੇਤ ਹੈਵਾਰ ਗੈਵਾਰ ਗਾਜੀ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 9
    },
    {
      "t": "ਮਟਕੇ ਮਹਾਬੀਰ ਸੁਟੇ ਸਿਰਾਜੀ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 9
    },
    {
      "t": "ਕੜਾਕੁਟ ਸਸਤ੍ਰਾਸਤ੍ਰ ਬਜੇ ਅਪਾਰੰ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 9
    },
    {
      "t": "ਨਚੇ ਸੁਧ ਸਿਧੰ ਉਠੀ ਸਸਤ੍ਰ ਝਾਰੰ ॥੨੯੯॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 9
    },
    {
      "t": "ਕਿਲੰਕੀਤ ਕਾਲੀ ਕਮਛ੍ਰਯਾ ਕਰਾਲੰ ॥",
