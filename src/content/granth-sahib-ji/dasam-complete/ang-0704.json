        [
          1,
          1
        ]
      ],
      "s": 9
    },
    {
      "t": "ਬਹੇ ਬੋਰ ਪਿੰਗੀ ਸਮੁੰਦੇ ਕੰਧਾਰੰ ॥੩੦੧॥",
      "v": [
        [
          2,
          1
        ]
