{
  "page": 707,
  "lines": [
    {
      "t": "ਭਯੋ ਬੀਰਖੇਤੰ ਕਥੈ ਕਉਣ ਖੰਤੰ ॥੩੨੬॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 9
    },
    {
      "t": "ਤੇਰੇ ਜੋਰ ਸੰਗ ਕਹਤਾ ॥",
      "s": 9
    },
    {
      "t": "ਭਈ ਅੰਧ ਧੁੰਧੰ ਮਚ੍ਯੋ ਬੀਰ ਖੇਤੰ ॥",
      "s": 9
    },
    {
      "t": "ਨਚੀ ਜੁਗਣੀ ਚਾਰੁ ਚਉਸਠ ਪ੍ਰੇਤੰ ॥",
      "s": 9
    },
    {
      "t": "ਨਚੀ ਕਾਲਕਾ ਸ੍ਰੀ ਕਮਖ੍ਰਯਾ ਕਰਾਲੰ ॥",
      "s": 9
    },
    {
      "t": "ਡਕੰ ਡਾਕਣੀ ਜੋਧ ਜਾਗੰਤ ਜ੍ਵਾਲੰ ॥੩੨੭॥",
      "s": 9
    },
    {
      "t": "ਤੇਰਾ ਜੋਰੁ ॥",
      "s": 9
    },
    {
      "t": "ਮਚ੍ਯੋ ਜੋਰ ਜੁਧੰ ਹਟ੍ਰਯੋ ਨਾਹਿ ਕੋਊ ॥",
      "s": 9
    },
    {
      "t": "ਬਡੇ ਛਤ੍ਰਧਾਰੀ ਪਤੀ ਛਤ੍ਰ ਦੋਊ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 9
    },
    {
      "t": "ਖਪ੍ਯੋ ਸਰਬ ਲੋਕੰ ਅਲੋਕੰ ਅਪਾਰੰ ॥",
      "s": 9
    },
    {
      "t": "ਮਿਟੇ ਜੁਧ ਤੇ ਏ ਨ ਜੋਧਾ ਜੁਝਾਰੰ ॥੩੨੮॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 9
    },
    {
      "t": "ਤੇਰਾ ਜੋਰ ॥",
      "s": 9
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 9
    },
    {
      "t": "ਚਟਪਟ ਸੁਭਟ ਬਿਕਟ ਕਟੇ ਝਟਪਟ ਭਈ ਅਭੰਗ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 9
    },
    {
      "t": "ਲਟਿ ਭਟ ਹਟੇ ਨ ਰਨ ਘਟ੍ਰਯੋ ਅਟਪਟ ਮਿਟ੍ਰਯੋ ਨ ਜੰਗ ॥੩੨੯॥",
      "v": [
        [
          5,
          2
        ]
      ],
      "s": 9
    },
    {
      "t": "ਤੇਰੇ ਜੋਰਿ ॥",
      "s": 9
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 9
    },
    {
      "t": "ਬੀਸ ਲਛ ਜੁਗ ਐਤੁ ਪ੍ਰਮਾਨਾ ॥",
      "s": 9
    },
    {
      "t": "ਲਰੇ ਦੋਊ ਭਈ ਕਿਸ ਨ ਹਾਨਾ ॥",
      "s": 9
    },
    {
      "t": "ਤਬ ਰਾਜਾ ਜੀਅ ਮੈ ਅਕੁਲਾਯੋ ॥",
      "s": 9
    },
    {
      "t": "ਨਾਕ ਚਢੇ ਮਛਿੰਦ੍ਰ ਪੈ ਆਯੋ ॥੩੩੦॥",
      "s": 9
    },
    {
      "t": "ਕਹਿ ਮੁਨਿ ਬਰਿ ਸਭ ਮੋਹਿ ਬਿਚਾਰਾ ॥",
      "s": 9
    },
    {
      "t": "ਏ ਦੋਊ ਬੀਰ ਬਡੇ ਬਰਿਆਰਾ ॥",
      "s": 9
    },
    {
      "t": "ਇਨ ਕਾ ਬਿਰੁਧ ਨਿਵਰਤ ਨ ਭਯਾ ॥",
      "s": 9
    },
    {
      "t": "ਇਨੋ ਛਡਾਵਤ ਸਭ ਜਗੁ ਗਯਾ ॥੩੩੧॥",
      "s": 9
    },
    {
      "t": "ਇਨੈ ਜੁਝਾਵਤ ਸਬ ਕੋਈ ਜੂਝਾ ॥",
      "s": 9
    },
    {
      "t": "ਇਨ ਕਾ ਅੰਤ ਨ ਕਾਹੂ ਸੂਝਾ ॥",
      "s": 9
    },
    {
      "t": "ਏ ਹੈ ਆਦਿ ਹਠੀ ਬਰਿਆਰਾ ॥",
      "s": 9
    },
    {
      "t": "ਮਹਾਰਥੀ ਅਉ ਮਹਾ ਭਯਾਰਾ ॥੩੩੨॥",
      "s": 9
    },
    {
      "t": "ਬਚਨੁ ਮਛਿੰਦ੍ਰ ਸੁਨਤ ਚੁਪ ਰਹਾ ॥",
      "s": 9
    },
    {
      "t": "ਧਰਾ ਨਾਥ ਸਬਨਨ ਤਨ ਕਹਾ ॥",
      "s": 9
    },
    {
      "t": "ਚਕ੍ਰਿਤ ਚਿਤ ਚਟਪਟ ਹ੍ਵੈ ਦਿਖਸਾ ॥",
      "s": 9
    },
    {
      "t": "ਚਰਪਟ ਨਾਥ ਤਦਿਨ ਤੇ ਨਿਕਸਾ ॥੩੩੩॥",
      "s": 9
    },
    {
      "t": "ਇਤਿ ਚਰਪਟ ਨਾਥ ਪ੍ਰਗਟਣੋ ਨਾਮਹ ॥",
      "s": 9
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 9
    },
    {
      "t": "ਸੁਨਿ ਰਾਜਾ ਤੁਹਿ ਕਹੈ ਬਿਬੇਕਾ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 9
    },
    {
      "t": "ਇਨ ਕਹ ਦ੍ਵੈ ਜਾਨਹੁ ਜਿਨਿ ਏਕਾ ॥",
      "s": 9
    },
    {
      "t": "ਏ ਅਬਿਕਾਰ ਪੁਰਖ ਅਵਤਾਰੀ ॥",
      "s": 9
    },
    {
      "t": "ਬਡੇ ਧਨੁਰਧਰ ਬਡੇ ਜੁਝਾਰੀ ॥੩੩੪॥",
      "s": 9
    },
    {
      "t": "ਆਦਿ ਪੁਰਖ ਜਬ ਆਪ ਸੰਭਾਰਾ ॥",
      "s": 9
    },
    {
      "t": "ਆਪ ਰੂਪ ਮੈ ਆਪ ਨਿਹਾਰਾ ॥",
      "s": 9
    },
    {
      "t": "ਓਅੰਕਾਰ ਕਹ ਇਕਦਾ ਕਹਾ ॥",
      "s": 9
    },
    {
      "t": "ਭੂਮਿ ਅਕਾਸ ਸਕਲ ਬਨਿ ਰਹਾ ॥੩੩੫॥",
      "s": 9
    },
    {
      "t": "ਦਾਹਨ ਦਿਸ ਤੇ ਸਤਿ ਉਪਜਾਵਾ ॥",
      "s": 9
    },
    {
      "t": "ਬਾਮ ਪਰਸ ਤੇ ਝੂਠ ਬਨਾਵਾ ॥",
      "s": 9
    },
    {
      "t": "ਉਪਜਤ ਹੀ ਉਠਿ ਜੁਝੇ ਜੁਝਾਰਾ ॥",
      "s": 9
    },
    {
      "t": "ਤਬ ਤੇ ਕਰਤ ਜਗਤ ਮੈ ਰਾਰਾ ॥੩੩੬॥",
      "s": 9
    },
    {
      "t": "ਸਹੰਸ ਬਰਖ ਜੋ ਆਯੁ ਬਢਾਵੈ ॥",
      "s": 9
    }
  ]
}
