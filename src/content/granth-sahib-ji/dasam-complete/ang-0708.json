        [
          1,
          1
        ]
      ],
      "s": 9
    },
    {
      "t": "ਜਤੀ ਜੋਗ ਜੁਧੀ ਜਕੀ ਜ੍ਵਾਲ ਮਾਲੀ ॥",
      "v": [
        [
          2,
          1
        ]
