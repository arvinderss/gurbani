  "lines": [
    {
      "t": "ਰਸਨਾ ਸਹਸ ਸਦਾ ਲੌ ਪਾਵੈ ॥",
      "s": 9
    },
    {
      "t": "ਸਹੰਸ ਜੁਗਨ ਲੌ ਕਰੇ ਬਿਚਾਰਾ ॥",
      "s": 9
    },
    {
      "t": "ਤਦਪਿ ਨ ਪਾਵਤ ਪਾਰ ਤੁਮਾਰਾ ॥੩੩੭॥",
      "s": 9
    },
    {
      "t": "ਤੇਰੇ ਜੋਰਿ ਗੁੰਗਾ ਕਹਤਾ ॥",
      "s": 9
    },
    {
      "t": "ਬਿਆਸ ਪਰਾਸਰ ਅਉ ਰਿਖਿ ਘਨੇ ॥",
      "s": 9
    },
    {
      "t": "ਸਿੰਗੀ ਰਿਖਿ ਬਕਦਾਲਭ ਭਨੇ ॥",
      "s": 9
    },
    {
      "t": "ਸਹੰਸ ਮੁਖਨ ਕਾ ਬ੍ਰਹਮਾ ਦੇਖਾ ॥",
      "s": 9
    },
    {
      "t": "ਤਊ ਨ ਤੁਮਰਾ ਅੰਤੁ ਬਿਸੇਖਾ ॥੩੩੮॥",
      "s": 9
    },
    {
      "t": "ਤੇਰਾ ਜੋਰੁ ॥",
      "s": 9
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 9
    },
    {
      "t": "ਸਿੰਧੁ ਸੁਭਟ ਸਾਵੰਤ ਸਭ ਮੁਨਿ ਗੰਧਰਬ ਮਹੰਤ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 9
    },
    {
      "t": "ਕੋਟਿ ਕਲਪ ਕਲਪਾਤ ਭੇ ਲਹ੍ਯੋ ਨ ਤੇਰੋ ਅੰਤ ॥੩੩੯॥",
      "s": 9
    },
    {
      "t": "ਤੇਰੇ ਜੋਰ ਸੋ ਕਹੋ ॥",
      "s": 9
    },
    {
      "t": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 9
    },
    {
      "t": "ਸੁਨੋ ਰਾਜ ਸਾਰਦੂਲ ਉਚਰੋ ਪ੍ਰਬੋਧੰ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 9
    },
    {
      "t": "ਸੁਨੋ ਚਿਤ ਦੈ ਕੈ ਨ ਕੀਜੈ ਬਿਰੋਧੰ ॥",
      "v": [
        [
          3,
          1
        ]
      ],
      "s": 9
    },
    {
      "t": "ਸੁ ਸ੍ਰੀ ਆਦ ਪੁਰਖੰ ਅਨਾਦੰ ਸਰੂਪੰ ॥",
      "v": [
        [
          3,
          1
        ]
      ],
      "s": 9
    },
    {
      "t": "ਅਜੇਅੰ ਅਭੇਅੰ ਅਦਗੰ ਅਰੂਪੰ ॥੩੪੦॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 9
    },
    {
      "t": "ਅਨਾਮੰ ਅਧਾਮੰ ਅਨੀਲੰ ਅਨਾਦੰ ॥",
