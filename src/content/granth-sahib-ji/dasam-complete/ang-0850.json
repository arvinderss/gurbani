{
  "page": 850,
  "lines": [
    {
      "t": "ਭਵਨ ਚਤੁਰਦਸ ਮਾਝਿ ਉਜਿਯਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜਾ ਛਤ੍ਰਕੇਤੁ ਕੀ ਨਾਰੀ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਛਤ੍ਰ ਮੰਜਰੀ ਤਾ ਕੀ ਪ੍ਯਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਅੰਗ ਉਤੰਗ ਨ੍ਰਿਪਤਿ ਤੇ ਭਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਤ ਜਤਨ ਆਗਮ ਕੋ ਕਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਕੈਸੇ ਰਾਜ ਹਮਾਰੋ ਸਰੈ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਕੰਨ੍ਯਾ ਹ੍ਵੈ ਤਾ ਕੇ ਮਰਿ ਜਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਪੂਤ ਆਨਿ ਪ੍ਰਗਟੈ ਕੋਊ ਨਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯ ਕੌ ਸੋਕ ਅਧਿਕ ਜਿਯ ਭਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਚਰਿਤ ਏਕ ਤਿਯ ਚਿਤ ਬਿਚਾਰੋ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਸੁਤ ਬਿਨੁ ਤ੍ਰਿਯ ਚਿਤ ਚਿਤ ਬਿਚਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਕ੍ਯੋ ਨ ਦੈਵ ਗਤਿ ਕਰੀ ਹਮਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਦਿਜ ਮੁਰਿ ਹਾਥ ਦਾਨ ਨਹਿ ਲੇਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਗ੍ਰਿਹ ਕੇ ਲੋਗ ਉਰਾਭੇ ਦੇਹੀ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਦੁਰਾਚਾਰ ਕਛੁ ਕਰਿਯੈ ॥",
      "s": 14
    },
    {
      "t": "ਪੁਤ੍ਰ ਰਾਵ ਕੋ ਬਦਨ ਉਚਰਿਯੈ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਪੁਤ੍ਰ ਲੀਜੈ ਉਪਜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਕੋ ਕਵਨ ਨਿਰਖਿ ਹੈ ਆਈ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਸਵਤਿ ਏਕ ਤਿਹ ਨ੍ਰਿਪਤਿ ਬੁਲਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬ੍ਯਾਹਹੁ ਇਹ ਜਗਤ ਉਡਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਯੌ ਸੁਨਿ ਨਾਰਿ ਅਧਿਕ ਅਕੁਲਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੇਵਕਾਨ ਸੌ ਦਰਬੁ ਲੁਟਾਈ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਵਤਿ ਤ੍ਰਾਸ ਰਾਨੀ ਅਧਿਕ ਲੋਗਨ ਦਰਬੁ ਲੁਟਾਇ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤੇ ਵਾ ਕੀ ਸਵਤਿਹ ਚਹੈ ਸਕੈ ਨ ਮੂਰਖ ਪਾਇ ॥੮॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਲੋਗ ਸਵਤਿ ਤਾ ਕੀ ਕਹ ਚਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਵਾ ਕੀ ਉਸਤਤਿ ਨ੍ਰਿਪ ਸੋ ਕਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੈ ਜੁ ਇਹ ਪ੍ਰਭੂ ਬਰੈ ਸੁ ਮਾਰੋ ॥",
      "v": [
        [
          4,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਟੂਕਰੋ ਚਲੈ ਹਮਾਰੋ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਸਵਤਿ ਤ੍ਰਾਸ ਅਤਿ ਤ੍ਰਿਯਹਿ ਦਿਖਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੋ ਮੂੰਡ ਮੂੰਡ ਕਰਿ ਖਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕਹ ਦਰਬੁ ਨ ਦੇਖਨ ਦੇਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਲੂਟਿ ਕੂਟਿ ਬਾਹਰ ਤੇ ਲੇਹੀ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਪੁਨਿ ਤਿਹ ਮਿਲਿਹਿ ਸਵਤਿ ਸੌ ਜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਤਿਨ ਕਰਹਿ ਬਡਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਮ ਕਹ ਬਰਿ ਹੈ ਨ੍ਰਿਪਤਿ ਹਮਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਹ੍ਵੈਹੈ ਅਧਿਕ ਪ੍ਰਤਾਪ ਤੁਮਾਰੋ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਯੌ ਕਹਿ ਕੈ ਤਾ ਕੌ ਧਨ ਲੂਟਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਆਨਿ ਵਾ ਤ੍ਰਿਯਾ ਕਹ ਕੂਟਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧ ਤ੍ਰਾਸ ਤਿਨੈ ਦਿਖਰਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਹੂੰਅਨ ਮੂੰਡ ਮੂੰਡਿ ਕੈ ਖਾਵੈ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਨਿਕ ਭਾਤਿ ਤਿਹ ਨ੍ਰਿਪਤਿ ਕੋ ਦੁਹੂੰਅਨ ਤ੍ਰਾਸ ਦਿਖਾਇ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਦਰਬੁ ਜੜਨਿ ਕੇ ਧਾਮ ਕੌ ਇਹ ਛਲ ਛਲਹਿ ਬਨਾਇ ॥੧੩॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਵਤਿ ਤ੍ਰਾਸ ਜੜ ਦਰਬੁ ਲੁਟਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਰਾਚਾਰ ਸੁਤ ਹੇਤ ਕਮਾਵੈ ॥",
      "s": 14
    }
  ]
}
