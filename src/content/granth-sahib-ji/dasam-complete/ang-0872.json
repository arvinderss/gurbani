  "lines": [
    {
      "t": "ਮੁਨਿ ਨਾਰਦ ਕਹੂੰ ਬੇਨੁ ਬਜਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਰੁਦ੍ਰ ਡਮਰੂ ਡਮਕਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਰੁਧਿਰ ਖਪਰ ਜੁਗਿਨ ਭਰਿ ਭਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਰਹਿ ਭੂਤ ਪ੍ਰੇਤ ਕਿਲਕਾਰੀ ॥੩੨॥",
      "s": 14
    },
    {
      "t": "ਰਨ ਅਗੰਮ ਕੋਊ ਜਾਨ ਨ ਪਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਡਹ ਡਹ ਡਹ ਸਿਵ ਡਮਰੁ ਬਜਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਹ ਕਹ ਕਹੂੰ ਕਾਲਿਕਾ ਕਹਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨੁਕ ਧੁਜਾ ਕਾਲ ਕੀ ਲਹਕੈ ॥੩੩॥",
      "s": 14
    },
    {
      "t": "ਹਸਤ ਪਾਰਬਤੀ ਨੈਨ ਬਿਸਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਚਤ ਭੂਪ ਪ੍ਰੇਤ ਬੈਤਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਹ ਕਹਾਟ ਕਹੂੰ ਕਾਲ ਸੁਨਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਭੀਖਨ ਸੁਨੇ ਨਾਦ ਭੈ ਆਵੈ ॥੩੪॥",
      "s": 14
    },
    {
      "t": "ਬਿਨੁ ਸੀਸਨ ਕੇਤਿਕ ਭਟ ਡੋਲਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਕੇਤਿਨ ਮਾਰਿ ਮਾਰਿ ਕਰਿ ਬੋਲਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਤੇ ਤਮਕਿ ਰਨ ਤੁਰੈ ਨਚਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਜੂਝਿ ਕਿਤਕ ਜਮ ਲੋਕ ਸਿਧਾਵੈ ॥੩੫॥",
      "s": 14
    },
    {
      "t": "ਕਟਿ ਕਟਿ ਪਰੇ ਸੁਭਟ ਛਿਤ ਭਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਪ ਸੁਤਾ ਕਰਿ ਕੋਪ ਪਛਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਨ ਕੇ ਪਰੀ ਹਾਥ ਨਹਿ ਪ੍ਯਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਨੁ ਮਾਰੇ ਹਨਿ ਮਰੇ ਕਟਾਰੀ ॥੩੬॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਮੋੜਤੇਸ ਅੰਬੇਰ ਪਤਿ ਅਮਿਤ ਸੈਨ ਲੈ ਸਾਥ ॥",
      "v": [
        [
          2,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਬਾਲ ਨਿਮਿਤਿ ਆਵਤ ਭਏ ਗਹੇ ਬਰਛਿਯੈ ਹਾਥ ॥੩੭॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਬਿਕਟ ਸਿੰਘ ਅੰਬੇਰ ਪਤਿ ਅਮਿਟ ਸਿੰਘ ਤਿਹ ਨਾਮ ॥",
      "v": [
        [
          3,
          2
        ]
