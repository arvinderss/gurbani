      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਤੇ ਨ੍ਰਿਪ ਜੋਰਿ ਸੈਨ ਦ੍ਵੈ ਧਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਬਾਜਿਤ੍ਰ ਬਜਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਸੁਤਾ ਜਬ ਨੈਨ ਨਿਹਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਸੈਨਾ ਸਹਿਤ ਮਾਰ ਹੀ ਡਾਰੇ ॥੩੯॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਅਬਲਾ ਨ੍ਰਿਪ ਦੋਊ ਸੰਘਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਠਟਕੇ ਸੁਭਟ ਸਕਲ ਤਬ ਭਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਖੇਤ ਛਾਡਿ ਯਹ ਤਰੁਨਿ ਨ ਟਰਿਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਸਭਹਿਨ ਕੋ ਪ੍ਰਾਨਨ ਬਿਨੁ ਕਰਿ ਹੈ ॥੪੦॥",
      "s": 14
    },
    {
      "t": "ਬੂੰਦੀ ਨਾਥ ਰਣੁਤ ਕਟ ਧਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਮਦੁਤ ਕਟ ਸਿੰਘ ਰਿਸਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਥ ਉਜੈਨ ਜਿਸੇ ਜਗ ਕਹਈ ॥",
      "s": 14
    },
    {
      "t": "ਵਾ ਕਹਿ ਜੀਤੈ ਜਗ ਕੋ ਰਹਈ ॥੪੧॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਅਬਲਾ ਆਵਤ ਵਹੁ ਲਹੇ ॥",
      "s": 14
    },
    {
      "t": "ਹਾਥ ਹਥਯਾਰ ਆਪਨੇ ਗਹੇ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਕੋਪ ਕਰਿ ਕੁਵਤਿ ਪ੍ਰਹਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਛਿਨਿਕ ਬਿਖੈ ਦਲ ਸਹਿਤ ਸੰਘਾਰੇ ॥੪੨॥",
      "s": 14
    },
    {
      "t": "ਗੰਗਾਦ੍ਰੀ ਜਮੁਨਾਦ੍ਰੀ ਹਠੇ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਰਸ੍ਵਤੀ ਹ੍ਵੈ ਚਲੇ ਇਕਠੇ ॥",
      "s": 14
    },
    {
      "t": "ਸਤੁਦ੍ਰਵਾਦਿ ਅਤਿ ਦ੍ਰਿੜ ਪਗ ਰੋਪੇ ॥",
      "s": 14
    },
    {
      "t": "ਬ੍ਰਯਾਹਾਦ੍ਰੀ ਸਿਗਰੇ ਮਿਲਿ ਕੋਪੇ ॥੪੩॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਪਰਮ ਸਿੰਘ ਪੂਰੋ ਪੁਰਖ ਕਰਮ ਸਿੰਘ ਸੁਰ ਗ੍ਯਾਨ ॥",
      "s": 14
    },
    {
      "t": "ਧਰਮ ਸਿੰਘ ਹਾਠੋ ਹਠੀ ਅਮਿਤ ਜੁਧ ਕੀ ਖਾਨ ॥੪੪॥",
