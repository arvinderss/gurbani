  "lines": [
    {
      "t": "ਬਨਿਕ ਬੋਲਿ ਸਾਹੁਨਿ ਸੋ ਭਾਖ੍ਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਮ ਹਮੈ ਨਿਪੂਤ ਕਰਿ ਰਾਖ੍ਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਧਨ ਬਹੁ ਧਾਮ ਕਾਮ ਕਿਹ ਆਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਪੁਤ੍ਰ ਬਿਨਾ ਮੁਰ ਬੰਸ ਲਜਾਵੈ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨੁ ਸਾਹੁਨਿ ਹਮਰੇ ਬਿਧਹਿ ਪੂਤ ਨ ਦੀਨਾ ਧਾਮ ॥",
      "v": [
        [
          1,
          1
        ],
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੋਰਹੁ ਸੁਤ ਕੈ ਰਾਖਿਯੈ ਜੋ ਹ੍ਯਾਂ ਲ੍ਯਾਵੈ ਰਾਮ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਚੋਰਹੁ ਹੋਇ ਪੂਤ ਕਰਿ ਰਾਖੋ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਕਛੂ ਨ ਮੁਖ ਤੇ ਭਾਖੋ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸਾਹੁਨਿ ਸਹਿਤ ਬਨਿਕ ਜਬ ਮਰਿ ਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਹਮਰੋ ਕਵਨ ਦਰਬੁ ਲੈ ਕਰਿ ਹੈ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਯਹ ਜਬ ਭਨਕ ਚੋਰ ਸੁਨਿ ਪਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਫੂਲਿ ਗਯੋ ਬਸਤ੍ਰਨ ਨਹਿ ਮਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਇ ਬਨਿਕ ਕੋ ਪੂਤ ਕਹੈਹੋਂ ॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਕੈ ਮਰੇ ਸਕਲ ਧਨ ਲੈਹੋਂ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਲੋ ਚੋਰ ਦ੍ਰਿਸਟਿ ਪਰ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਬਨਿਕ ਕੇ ਆਨੰਦ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪਲ੍ਰਯੋ ਪਲੋਸ੍ਰਯੋ ਸੁਤੁ ਬਿਧਿ ਦੀਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੋ ਪੂਤ ਪੂਤ ਕਹਿ ਲੀਨੋ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਖਾਟ ਉਪਰ ਤਸਕਰਹਿ ਬੈਠਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭਲੋ ਭਲੋ ਪਕਵਾਨ ਖਵਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪੂਤ ਪੂਤ ਕਹਿ ਸਾਹੁਨਿ ਧਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਹੁ ਚਉਤਰੇ ਜਾਇ ਜਤਾਈ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਪੰਚ ਪਯਾਦੇ ਸੰਗ ਲੈ ਚੋਰਹਿ ਦਯੋ ਦਿਖਾਇ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਹ ਪੈਂਡੇ ਆਯੋ ਹੁਤੋ ਮੈ ਸੁਤ ਕਹਿਯੋ ਬੁਲਾਇ ॥੮॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਮਿਤ ਦਰਬੁ ਹਮਰੇ ਬਿਧਿ ਦਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪੂਤ ਨ ਧਾਮ ਹਮਾਰੇ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਕਉ ਹਮ ਕਹਿ ਪੂਤ ਉਚਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਤੁਮ ਮਿਲਿ ਕੈ ਨਹਿ ਮਾਰੋ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਪੂਤ ਪੂਤ ਬਨਿਯਾ ਕਹਿ ਰਹਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪੰਚ ਪਯਾਦਨ ਤਸਕਰ ਗਹਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੋ ਕਹਿਯੋ ਏਕ ਨਹਿ ਕੀਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਲੈ ਤਸਕਰ ਫਾਸੀ ਸੋ ਦੀਨੋ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਪੁਰਖ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕਸਠਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੬੧॥੧੧੦੬॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਸਿੰਘ ਕੇ ਘਰ ਬਿਖੈ ਤਸਕਰ ਰਹੈ ਅਪਾਰ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਨਿਤਿਪ੍ਰਤਿ ਤਾ ਕੇ ਲ੍ਯਾਵਹੀ ਅਧਿਕ ਖਜਾਨੋ ਮਾਰਿ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਹਰਨ ਦਰਬੁ ਤਸਕਰ ਚਲਿ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਗਹਿ ਲਯੋ ਜਾਨ ਨਹਿ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਸਿੰਘ ਤਾ ਕੋ ਯੌ ਕਹਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਮ ਅਪਨੇ ਚਿਤ ਮੈ ਦ੍ਰਿੜ ਰਹਿਯੋ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਮਰੇ ਸਿਰ ਪਰ ਕਾਢਿ ਕੈ ਠਾਢੇ ਹ੍ਵੈ ਤਰਵਾਰਿ ॥",
      "v": [
        [
          4,
          2
        ]
