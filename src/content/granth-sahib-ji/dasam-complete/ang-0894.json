  "lines": [
    {
      "t": "ਮਹਾ ਰੋਗ ਤੇ ਲੇਹੁ ਉਬਾਰੀ ॥੩੩॥",
      "s": 14
    },
    {
      "t": "ਸਾਹ ਸੁਤ ਬਾਚ ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਕਲ ਕਥਾ ਤਿਨ ਭਾਖਿ ਸੁਨਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਪੁਰ ਲੋਗਨ ਸਭਹੂੰ ਸੁਨਿ ਪਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਲੈ ਦੂਜੀ ਕੰਨ੍ਯਾ ਤਿਹ ਦੀਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਉਸਤਤਿ ਮਿਲ ਕੀਨੀ ॥੩੪॥",
      "s": 14
    },
    {
      "t": "ਔਰ ਸਕਲ ਪੁਰ ਛੋਰਿ ਉਬਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਨਊਆ ਸੁਤ ਚਿਮਟਿਯੋ ਹੀ ਮਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬ੍ਯਾਹ ਦੂਸਰੋ ਅਪਨੋ ਕੀਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਜੁ ਪੁਰ ਕੋ ਬਹੁਰੋ ਮਗੁ ਲੀਨੋ ॥੩੫॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਪੁਰਖ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਅਠਾਸਠਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੬੮॥੧੨੨੨॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਚਪਲ ਸਿੰਘ ਰਾਜਾ ਬਡੋ ਰਾਜ ਕਲਾ ਤਿਹ ਨਾਰਿ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇੰਦ੍ਰ ਦੇਵ ਰੀਝੇ ਰਹੈ ਜਾਨਿ ਸਚੀ ਅਨੁਹਾਰਿ ॥੧॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸੋ ਰਾਨੀ ਇਕ ਚੋਰ ਸੋ ਰਮ੍ਯੋ ਕਰਤ ਦਿਨੁ ਰੈਨਿ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਬੁਲਾਵੈ ਨਿਜੁ ਸਦਨ ਆਪੁ ਜਾਇ ਤਿਹ ਐਨ ॥੨॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਏਕ ਦਿਵਸ ਆਵਤ ਸਦਨ ਨ੍ਰਿਪ ਬਰ ਲਖਿਯੋ ਬਨਾਇ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਲੂਟਿ ਕੂਟਿ ਤਸਕਰ ਲਯੋ ਸੂਰੀ ਦਿਯੋ ਚਰਾਇ ॥੩॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਜਬ ਸ੍ਰੋਨਤ ਭਭਕੋ ਉਠਤ ਤਬ ਆਖੈ ਖੁਲਿ ਜਾਹਿ ॥",
      "v": [
        [
          3,
          2
