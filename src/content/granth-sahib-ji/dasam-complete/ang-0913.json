    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਪਤਿਯਾ ਤਿਨ ਛੋਰਿ ਬਚਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਮੀਤ ਨਾਮ ਸੁਨਿ ਕੰਠ ਲਗਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਯਹੈ ਯਾਰਿ ਲਿਖਿ ਤਾਹਿ ਪਠਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਮ ਬਿਨੁ ਅਧਿਕ ਕਸਟ ਹਮ ਪਾਯੋ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਪਤਿਯਾ ਮੈ ਲਖਿ ਯਹੈ ਪਠਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਮ ਬਿਨ ਹਮ ਸਭ ਕਿਛੁ ਬਿਸਰਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਹਮਰੀ ਸੁਧਿ ਆਪਨ ਤੁਮ ਲੀਜਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਕਛੁ ਧਨੁ ਕਾਢਿ ਪਠੈ ਮੁਹਿ ਦੀਜਹੁ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਤ ਬਾਤ ਮੂਰਖ ਤ੍ਰਿਯਾ ਚਿਤ ਮੈ ਭਈ ਪ੍ਰਸੰਨ੍ਯ ॥",
      "s": 14
    },
    {
      "t": "ਮੀਤ ਚਿਤਾਰਿਯੋ ਆਜੁ ਮੁਹਿ ਧਰਨੀ ਤਲ ਹੌਂ ਧੰਨ੍ਯ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਜਿ ਕਾਹੂ ਤ੍ਰਿਯ ਇਹੈ ਸਿਖਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਲਿਖਿ ਪਤਿਯਾ ਮੈ ਯਹੈ ਪਠਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਾਤ ਸਮੈ ਪਿਛਵਾਰੇ ਐਹੌ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਹੂੰ ਹਾਥ ਭਏ ਤਾਲ ਬਜੈਹੌ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਤਾਰੀ ਸ੍ਰਵਨਨ ਸੁਨਿ ਪੈਯਹੁ ॥",
      "s": 14
    },
    {
