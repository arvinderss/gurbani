      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਹਠੀ ਹੈ ਹਮਾਰੀ ਸੁ ਤੁਮਹੂੰ ਪਛਾਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਦਿਸਾ ਚਾਰਿ ਜਾ ਕੀ ਸਦਾ ਲੋਹ ਮਾਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਲੀ ਦੇਵ ਆਦੇਵ ਜਾ ਕੌ ਬਖਾਨੈ ॥",
      "s": 14
