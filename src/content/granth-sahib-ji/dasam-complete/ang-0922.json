      "s": 14
    },
    {
      "t": "ਕਾਮਵਤੀ ਭੀਤਰ ਦੂਤਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮਸੈਨ ਜੂ ਕੋ ਸਿਰੁ ਨ੍ਯਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਕ੍ਰਮ ਕਹਿਯੋ ਸੁ ਤਾਹਿ ਸੁਨਾਵਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਰਾਵ ਕੋ ਦੁਖ ਉਪਜਾਵਾ ॥੪੨॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਸਿਸਿ ਚੜੇ ਦਿਨ ਕੇ ਭਏ ਨਿਸਿ ਰਵਿ ਕਰੈ ਉਦੋਤ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਕਾਮਕੰਦਲਾ ਕੋ ਦਿਯਬ ਤਊ ਨ ਹਮ ਤੇ ਹੋਤ ॥੪੩॥",
      "v": [
        [
          2,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਦੂਤੋ ਬਾਚ ॥",
      "s": 14
    },
    {
      "t": "ਭੁਜੰਗ ਛੰਦ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨੋ ਰਾਜ ਕਹਾ ਨਾਰਿ ਕਾਮਾ ਬਿਚਾਰੀ ॥",
