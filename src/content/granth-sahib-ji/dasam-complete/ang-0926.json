      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਗ੍ਰਿਹ ਜਨ ਕਹਾ ਖਾਹੁ ਨਹਿ ਖਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਖਨ ਮਰਤ ਨ ਲਜਤ ਬਤਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਆਧੀ ਰੈਨਿ ਬੀਤ ਜਬ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਲਾਗਤੁ ਅਧਿਕ ਛੁਧਾ ਤਿਹ ਭਈ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਲਕਰੀ ਭਏ ਤੇਲ ਘਟ ਫੋਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪੀਨੋ ਸਕਲ ਨੈਕ ਨਹਿ ਛੋਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੂਰਜ ਚੜਿਯੋ ਉਡਗ ਛਪਿ ਗਏ ॥",
      "s": 14
    },
    {
      "t": "ਫਾਸਿ ਪਾਨ ਸੋ ਕਊਆ ਲਏ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਨੀ ਬੇਚਿ ਕ੍ਰਿਪਾਨ ਲੀ ਚਲਿਯੋ ਚਾਕਰੀ ਧਾਇ ॥",
      "v": [
        [
          1,
          1
        ],
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਮਾਰਤ ਮਾਰਗ ਸਿੰਘ ਜਹ ਤਿਹ ਠਾ ਪਹੁਚ੍ਯੋ ਜਾਇ ॥੧੬॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਸਿਤ ਜੁਲਾਹੋ ਦ੍ਰੁਮ ਚੜ੍ਯੋ ਗਹੈ ਸੈਹਥੀ ਹਾਥ ॥",
      "s": 14
    },
    {
      "t": "ਤਰੇ ਆਨਿ ਠਾਢੋ ਭਯੋ ਸਿੰਘ ਰੋਸ ਕੇ ਸਾਥ ॥੧੭॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਿੰਘਹਿ ਦ੍ਰਿਸਟਿ ਜੁਲਾਹੇ ਪਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਬਰਛੀ ਕੰਪਤ ਹਾਥ ਤੇ ਝਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਮੁਖ ਮੈ ਲਗੀ ਪਿਸਟਿ ਤਰ ਨਿਕਸੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਨ ਕਰਿ ਕੰਜਕਲੀ ਸੀ ਬਿਗਸੀ ॥੧੮॥",
      "s": 14
    },
    {
      "t": "ਜਾਨ੍ਯੋ ਸਾਚੁ ਸਿੰਘ ਮਰਿ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਉਤਰਿਯੋ ਪੂਛਿ ਕਾਨ ਕਟਿ ਲਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਇ ਨ੍ਰਿਪਤਿ ਕੌ ਤਾਹਿ ਦਿਖਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਮਹੀਨੋ ਅਪਨ ਕਰਾਯੋ ॥੧੯॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਸਤ੍ਰੁ ਤਾ ਕੋ ਹੁਤੋ ਚੜਿਯੋ ਅਨੀ ਬਨਾਇ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸੈਨਾਪਤਿ ਪਚਮਾਰ ਕੈ ਇਹ ਨ੍ਰਿਪ ਦਿਯੋ ਪਠਾਇ ॥੨੦॥",
      "v": [
        [
          2,
