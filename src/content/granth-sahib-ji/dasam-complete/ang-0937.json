{
  "page": 937,
  "lines": [
    {
      "t": "ਜਨੁ ਸਾਵਕ ਸਾਯਕ ਕੇ ਮਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਚਿਤ ਮੈ ਅਧਿਕ ਰੀਝ ਕੇ ਰਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਝਨ ਰਾਝਨ ਮੁਖ ਤੇ ਕਹੈ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਕਰਮ ਕਾਲ ਤਹ ਐਸੋ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤੌਨੇ ਦੇਸ ਕਾਲ ਪਰ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਯਤ ਨ ਕੌ ਨਰ ਬਚਿਯੋ ਨਗਰ ਮੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਉਬਰਿਯੋ ਜਾ ਕੇ ਧਨੁ ਘਰ ਮੈ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਚਿਤ੍ਰ ਦੇਵਿ ਇਕ ਰਾਨਿ ਨਗਰ ਮੈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਝਾ ਏਕ ਪੂਤ ਤਿਹ ਘਰ ਮੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੇ ਔਰ ਨ ਬਚਿਯੋ ਕੋਈ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਇ ਪੂਤ ਵੈ ਬਾਚੇ ਦੋਈ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਰਨਿਯਹਿ ਭੂਖ ਅਧਿਕ ਜਬ ਜਾਗੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੌ ਬੇਚਿ ਮੇਖਲਾ ਸਾਜੀ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਤਿ ਪੀਸਨ ਪਰ ਦ੍ਵਾਰੇ ਜਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਜੂਠ ਚੂਨ ਚੌਕਾ ਚੁਨਿ ਖਾਵੈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਐਸੇ ਹੀ ਭੂਖਨ ਮਰਿ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਪੁਨਿ ਬਿਧਿ ਤਹਾ ਬ੍ਰਿਸਟਿ ਅਤਿ ਦਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੂਕੇ ਭਏ ਹਰੇ ਜਨੁ ਸਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਜੀਤ ਕੇ ਬਜੇ ਨਗਾਰੇ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਤਹਾ ਏਕ ਰਾਝਾ ਹੀ ਉਬਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਔਰ ਲੋਗ ਸਭ ਤਹ ਕੋ ਮਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਝੋ ਜਾਟ ਹੇਤ ਤਿਨ ਪਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪੂਤ ਭਾਵ ਤੇ ਤਾਹਿ ਜਿਯਾਰਿਯੋ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਪੂਤ ਜਾਟ ਕੋ ਸਭ ਕੋ ਜਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਸ ਤੇ ਕੋਊ ਨ ਰਹਿਯੋ ਪਛਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਐਸੇ ਕਾਲ ਬੀਤ ਕੈ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਮੈ ਮਦਨ ਦਮਾਮੋ ਦਯੋ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਮਹਿਖੀ ਚਾਰਿ ਨਿਤਿ ਗ੍ਰਿਹ ਆਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਝਾ ਅਪਨੋ ਨਾਮ ਸਦਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਪੂਤ ਜਾਟ ਕੋ ਤਿਹ ਸਭ ਜਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜਪੂਤੁ ਕੈ ਕੋ ਪਹਿਚਾਨੈ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਇਤੀ ਬਾਤ ਰਾਝਾ ਕੀ ਕਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਚਲਿ ਬਾਤ ਹੀਰ ਪੈ ਰਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਮ ਕੌ ਤਾ ਕੀ ਕਥਾ ਸੁਨਾਊ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਤੁਮਰੋ ਹ੍ਰਿਦੈ ਸਿਰਾਊ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਅੜਿਲ ॥",
      "s": 14
    },
    {
      "t": "ਇੰਦ੍ਰ ਰਾਇ ਕੇ ਨਗਰ ਅਪਸਰਾ ਇਕ ਰਹੈ ॥",
      "v": [
        [
          3,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਮੈਨ ਕਲਾ ਤਿਹ ਨਾਮ ਸਕਲ ਜਗ ਯੌ ਕਹੈ ॥",
      "v": [
        [
          3,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤਾ ਕੌ ਰੂਪ ਨਰੇਸ ਜੋ ਕੋਊ ਨਿਹਾਰਹੀ ॥",
      "v": [
        [
          3,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਹੋ ਗਿਰੈ ਧਰਨਿ ਪਰ ਝੂਮਿ ਮੈਨ ਸਰ ਮਾਰਹੀ ॥੧੧॥",
      "v": [
        [
          4,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਤੌਨੇ ਸਭਾ ਕਪਿਲ ਮੁਨਿ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਔਸਰ ਜਹਾ ਮੈਨਕਾ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਲਖਿ ਮੁਨਿ ਬੀਰਜ ਗਿਰਿ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਚਪਿ ਚਿਤ ਮੈ ਸ੍ਰਾਪਤ ਤਿਹ ਭਯੋ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਤੁਮ ਗਿਰਿ ਮਿਰਤ ਲੋਕ ਮੈ ਪਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਜੂਨਿ ਸਯਾਲ ਜਾਟ ਕੀ ਧਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਹੀਰ ਆਪਨੋ ਨਾਮ ਸਦਾਵੋ ॥",
      "s": 14
    }
  ]
}
