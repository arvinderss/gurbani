  "lines": [
    {
      "t": "ਮੇਹੀਵਾਲ ਅਧਿਕ ਦੁਖੁ ਧਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਾ ਸੋਹਨੀ ਰਹੀ ਬਿਚਾਰਿਯੋ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਨਦੀ ਬੀਚ ਖੋਜਤ ਬਹੁ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਆਈ ਲਹਿਰ ਡੂਬਿ ਸੋ ਗਯੋ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਪੁਰਖ ਯਹ ਚਰਿਤ੍ਰ ਸੁਧਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੇਹੀਵਾਲ ਸੋਹਨਿਯਹਿ ਮਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਚੋ ਘਟ ਵਾ ਕੋ ਦੈ ਬੋਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੇਹੀਵਾਲ ਹੂੰ ਕੋ ਸਿਰ ਤੋਰਿਯੋ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਪੁਰਖ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਇਕ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੦੧॥੧੮੬੫॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਵਧ ਪੁਰੀ ਭੀਤਰ ਬਸੈ ਅਜ ਸੁਤ ਦਸਰਥ ਰਾਵ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਦੀਨਨ ਕੀ ਰਛਾ ਕਰੈ ਰਾਖਤ ਸਭ ਕੋ ਭਾਵ ॥੧॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਦੈਤ ਦੇਵਤਨ ਕੋ ਬਨ੍ਯੋ ਏਕ ਦਿਵਸ ਸੰਗ੍ਰਾਮ ॥",
      "s": 14
    },
    {
      "t": "ਬੋਲਿ ਪਠਾਯੋ ਇੰਦ੍ਰ ਨੈ ਲੈ ਦਸਰਥ ਕੋ ਨਾਮ ॥੨॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਦੂਤਹਿ ਕਹਿਯੋ ਤੁਰਤ ਤੁਮ ਜੈਯਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਸੈਨ ਸਹਿਤ ਦਸਰਥ ਕੈ ਲ੍ਰਯੈਯਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਗ੍ਰਿਹ ਕੇ ਸਕਲ ਕਾਮ ਤਜ ਆਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਹਮਰੀ ਦਿਸਿ ਹ੍ਵੈ ਜੁਧੁ ਮਚਾਵੈ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਦੂਤ ਸਤਕ੍ਰਿਤ ਜੋ ਪਠਿਯੋ ਸੋ ਦਸਰਥ ਪੈ ਆਇ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਜੋ ਤਾ ਸੋ ਸ੍ਵਾਮੀ ਕਹਿਯੋ ਸੋ ਤਿਹ ਕਹਿਯੋ ਸੁਨਾਇ ॥੪॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਸਵ ਕਹਿਯੋ ਸੁ ਤਾਹਿ ਸੁਨਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਸੁਨਿ ਭੇਦ ਕੇਕਈ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਚਲੇ ਚਲੋ ਰਹਿ ਹੌ ਤੌ ਰਹਿ ਹੌ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਨਾਤਰ ਦੇਹ ਅਗਨਿ ਮੈ ਦਹਿ ਹੌ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯ ਕੋ ਮੋਹ ਨ੍ਰਿਪਤਿ ਸੌ ਭਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਸੰਗ ਲੈ ਉਹ ਓਰਿ ਪਧਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਲ ਕਹਿਯੋ ਸੇਵਾ ਤਵ ਕਰਿਹੋ ॥",
      "s": 14
    },
    {
      "t": "ਜੂਝੋ ਨਾਥ ਪਾਵਕਹਿ ਬਰਿਹੋ ॥੬॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਅਵਧ ਰਾਜ ਤਹ ਤੁਰਤ ਸਿਧਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਰ ਅਸੁਰਨ ਜਹ ਜੁਧ ਮਚਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਜ੍ਰ ਬਾਨ ਬਿਛੂਆ ਜਹ ਬਰਖੈ ॥",
      "s": 14
    },
    {
      "t": "ਕੁਪਿ ਕੁਪਿ ਬੀਰ ਧਨੁਹਿਯਨ ਕਰਖੈ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਭੁਜੰਗ ਛੰਦ ॥",
      "s": 14
    },
    {
      "t": "ਬਧੇ ਗੋਲ ਗਾੜੇ ਚਲਿਯੋ ਬਜ੍ਰਧਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਬਜੈ ਦੇਵ ਦਾਨਵ ਜਹਾ ਹੀ ਹਕਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਗਜੈ ਕੋਟਿ ਜੋਧਾ ਮਹਾ ਕੋਪ ਕੈ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਪਰੈ ਆਨਿ ਕੈ ਬਾਢਵਾਰੀਨ ਲੈ ਕੈ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਭਜੇ ਦੇਵ ਦਾਨੋ ਅਨਿਕ ਬਾਨ ਮਾਰੇ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚਲੇ ਛਾਡਿ ਕੈ ਇੰਦਰ ਕੇ ਬੀਰ ਭਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਰਹਿਯੋ ਏਕ ਠਾਢੋ ਤਹਾ ਬਜ੍ਰਧਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਪਰਿਯੋ ਤਾਹਿ ਸੋ ਰਾਵ ਤਹਿ ਮਾਰ ਭਾਰੀ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਇਤੈ ਇੰਦ੍ਰ ਰਾਜਾ ਉਤੈ ਦੈਤ ਭਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਹਟੇ ਨ ਹਠੀਲੇ ਮਹਾ ਰੋਹ ਵਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਲਯੋ ਘੇਰਿ ਤਾ ਕੋ ਚਹੂੰ ਓਰ ਐਸੇ ॥",
      "s": 14
    },
    {
      "t": "ਮਨੋ ਪਵਨ ਉਠੈ ਘਟਾ ਘੋਰ ਜੈਸੇ ॥੧੦॥",
      "s": 14
    }
