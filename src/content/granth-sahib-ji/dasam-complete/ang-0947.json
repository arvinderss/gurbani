{
  "page": 947,
  "lines": [
    {
      "t": "ਜਾਨਕ ਰੰਕ ਨਵੋ ਨਿਧਿ ਪਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਐਸੀ ਬਸਿ ਤਰੁਨੀ ਹ੍ਵੈ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਨਹੁ ਸਾਹ ਜਲਾਲੈ ਭਈ ॥੩੪॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਰੁਨ ਬਸਤ੍ਰ ਅਤਿ ਕ੍ਰਾਤ ਤਿਹ ਤਰੁਨਿ ਤਰੁਨ ਕੋ ਪਾਇ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਭੋਗਨ ਭਯੋ ਤਾਹਿ ਗਰੇ ਸੌ ਲਾਇ ॥੩੫॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਐਸੀ ਪ੍ਰੀਤਿ ਦੁਹੂ ਕੀ ਲਾਗੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੋ ਸਭ ਗਾਵਤ ਅਨੁਰਾਗੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੋਤ ਜਗਤ ਡੋਲਤ ਹੀ ਮਗ ਮੈ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਹਿਰ ਭਈ ਸਗਲ ਹੀ ਜਗ ਮੈ ॥੩੬॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਤਿੰਨ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੦੩॥੧੯੩੫॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਅਬਲਾ ਥੀ ਜਾਟ ਕੀ ਤਸਕਰ ਸੋ ਤਿਹ ਨੇਹ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਕੇਲ ਕਮਾਵਤ ਤੌਨ ਸੋ ਨਿਤਿ ਬੁਲਾਵਤ ਗ੍ਰੇਹ ॥੧॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਦਿਵਸ ਤਸਕਰ ਗ੍ਰਿਹ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਹਸਿ ਨਾਰਿ ਯੌ ਬਚਨ ਸੁਨਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਾ ਚੋਰ ਤੁਮ ਦਰਬੁ ਚੁਰਾਵਤ ॥",
      "s": 14
    },
    {
      "t": "ਸੁ ਤੁਮ ਨਿਜੁ ਧਨ ਹਿਰਿ ਲੈ ਜਾਵਤ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਪਤ ਹੋ ਚਿਤ ਮੈ ਅਧਿਕ ਨੈਕੁ ਨਿਹਾਰਤ ਭੋਰ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਭਜਤ ਸੰਧਿ ਕੋ ਤਜਿ ਸਦਨ ਚਿਤ ਚੁਰਾਵੋ ਚੋਰ ॥੩॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਥਮ ਸਾਧਿ ਦੈ ਦਰਬੁ ਚੁਰਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਪੁਨਿ ਅਪੁਨੇ ਪਤਿ ਕੌ ਦਿਖਰਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਜੀ ਮੁਫਤੀ ਸਕਲ ਨਿਹਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਤਸਕਰ ਤਿਹ ਰਾਹ ਪਧਾਰੈ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਧਨ ਤਸਕਰ ਕੌ ਅਮਿਤ ਦੇ ਘਰ ਤੇ ਦਯੋ ਪਠਾਇ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਕੋਟਵਾਰ ਕੋ ਖਬਰਿ ਕਰਿ ਹੌ ਮਿਲਿਹੌ ਤੁਹਿ ਆਇ ॥੫॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਮਿਤ ਦਰਬੁ ਦੈ ਚੋਰ ਨਿਕਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੈ ਸਾਧਹਿ ਇਹ ਭਾਤਿ ਪੁਕਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪਤਿਹਿ ਜਗਾਇ ਕਹਿਯੋ ਧਨ ਹਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਦੇਸੇਸ ਨ੍ਯਾਇ ਨਹਿ ਕਰਿਯੋ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯੋ ਬਾਚ ॥",
      "s": 14
    },
    {
      "t": "ਕੋਟਵਾਰ ਪੈ ਜਾਇ ਪੁਕਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਨੀ ਚੋਰ ਧਨ ਹਰਿਯੋ ਹਮਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਕਲ ਲੋਕ ਤਿਹ ਠਾ ਪਗ ਧਰਿਯੈ ॥",
      "s": 14
    },
    {
      "t": "ਹਮਰੋ ਕਛੁਕ ਨ੍ਯਾਇ ਬਿਚਰਿਯੈ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਕਾਜੀ ਕੋਟਵਾਰ ਕੌ ਲ੍ਯਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਲੋਗਨ ਕੋ ਸਾਧਿ ਦਿਖਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੌ ਹੇਰਿ ਅਧਿਕ ਪਤਿ ਰੋਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਚੋਰਨ ਮੋਰ ਸਕਲ ਧਨੁ ਖੋਯੋ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਦੇਖਤ ਤਿਨੈ ਮੂੰਦ ਵਹ ਲਈ ॥",
      "s": 14
    },
    {
      "t": "ਰਹਨ ਤੈਸਿਯੈ ਅੰਤਰ ਦਈ ॥",
      "s": 14
    },
    {
      "t": "ਦਿਨ ਬੀਤਯੋ ਰਜਨੀ ਹ੍ਵੈ ਆਈ ॥",
      "s": 14
    }
  ]
}
