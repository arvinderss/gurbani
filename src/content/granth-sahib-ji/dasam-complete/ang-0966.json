{
  "page": 966,
  "lines": [
    {
      "t": "ਏਤੇ ਹਠਿ ਜਿਨਿ ਕਰੋ ਪਿਯਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਾਨ ਪਤਨ ਆਪਨ ਜਿਨਿ ਕੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਆਧੋ ਰਾਜ ਹਮਾਰੋ ਲੀਜੈ ॥੨੦॥",
      "s": 14
    },
    {
      "t": "ਕੌਨ ਕਾਜ ਨ੍ਰਿਪ ਰਾਜ ਹਮਾਰੈ ॥",
      "v": [
        [
          1,
          1
        ],
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸਦਾ ਰਹੋ ਇਹ ਧਾਮ ਤਿਹਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਮੈ ਜੁਗ ਚਾਰਿ ਲਗੈ ਨਹਿ ਥੀਹੌ ॥",
      "s": 14
    },
    {
      "t": "ਪਿਯ ਕੇ ਮਰੇ ਬਹੁਰਿ ਮੈ ਜੀਹੌ ॥੨੧॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਰਾਨੀ ਨ੍ਰਿਪ ਬਹੁਰਿ ਪਠਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਕੋ ਕਹੋ ਬਹੁਰਿ ਤੁਮ ਜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜ੍ਯੋ ਤ੍ਰਯੋ ਯਾ ਤੇ ਯਾਹਿ ਨਿਵਰਿਯਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਵਹ ਕਹੈ ਵਹੈ ਤੁਮ ਕਰਿਯਹੁ ॥੨੨॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਰਾਨੀ ਤਾ ਪੈ ਚਲਿ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਤ ਕਰਤ ਬਹੁਤੈ ਬਿਧਿ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਿਯੋ ਸਤੀ ਸੋਊ ਬਚ ਮੈ ਕਹੂੰ ॥",
      "s": 14
    },
    {
      "t": "ਇਨ ਤੇ ਹੋਇ ਨ ਸੋ ਹਠ ਗਹੂੰ ॥੨੩॥",
      "s": 14
    },
    {
      "t": "ਰਨਿਯਹਿ ਕਹਿਯੋ ਸਤੀ ਪਤਿ ਦੈ ਹੌ ॥",
      "s": 14
    },
    {
      "t": "ਮੋਰੇ ਅਗ੍ਰ ਦਾਸਿਨੀ ਹ੍ਵੈ ਹੌ ॥",
      "s": 14
    },
    {
      "t": "ਤਵ ਦੇਖਤ ਤੇਰੋ ਨ੍ਰਿਪ ਰਾਊ ॥",
      "s": 14
    },
    {
      "t": "ਤਵ ਘਟ ਦੈ ਸਿਰ ਨੀਰ ਭਰਾਊ ॥੨੪॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਕਹਿਯੋ ਪਤਿਹਿ ਤੁਹਿ ਦੈ ਹੌ ॥",
      "s": 14
    },
    {
      "t": "ਤੋਰੇ ਅਗ੍ਰ ਦਾਸਿਨੀ ਹ੍ਵੈ ਹੌ ॥",
      "s": 14
    },
    {
      "t": "ਦ੍ਰਿਗ ਦੇਖਤ ਨਿਰਪ ਤੁਹਿ ਰਮਵਾਊ ॥",
      "s": 14
    },
    {
      "t": "ਗਗਰੀ ਬਾਰਿ ਸੀਸ ਧਰਿ ਲ੍ਯਾਊ ॥੨੫॥",
      "s": 14
    },
    {
      "t": "ਪਾਵਕ ਬੀਚ ਸਤੀ ਜਿਨਿ ਜਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਛੂ ਬਕਤ੍ਰ ਤੇ ਹਮੈ ਉਚਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਜੌ ਤੂ ਕਹੈ ਤ ਤੋ ਕੌ ਬਰਿ ਹੌ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਕਹੁ ਤੇ ਰਾਨੀ ਤੁਹਿ ਕਰਿ ਹੌ ॥੨੬॥",
      "s": 14
    },
    {
      "t": "ਯੌ ਕਹਿ ਪਕਰਿ ਬਾਹ ਤੇ ਲਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਡੋਰੀ ਬੀਚ ਡਾਰਿ ਕਰਿ ਦਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਮ ਤ੍ਰਿਯ ਜਿਨਿ ਪਾਵਕ ਮੋ ਜਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੋਹੂ ਕੋ ਭਰਤਾ ਲੈ ਕਰੋ ॥੨੭॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਭਹਿਨ ਕੇ ਦੇਖਤ ਤਿਸੈ ਲਯੋ ਬਿਵਾਨ ਚੜਾਇ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਹ ਚਰਿਤ੍ਰ ਤਾ ਕੋ ਬਰਿਯੋ ਰਾਨੀ ਕਿਯੋ ਬਨਾਇ ॥੨੮॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਬਾਰਹਾ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੧੨॥੨੧੮੫॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਸਨ ਸਿੰਘ ਰਾਜਾ ਬਡੋ ਬੰਗਸ ਮੈ ਬਡਭਾਗ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਊਚ ਨੀਚ ਤਾ ਕੈ ਪ੍ਰਜਾ ਰਹੀ ਚਰਨ ਸੌ ਲਾਗ ॥੧॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਕ੍ਰਿਸਨ ਕੁਅਰਿ ਤਾ ਕੇ ਪਟਰਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨੁਕ ਤੀਰ ਸਿੰਧ ਮਥਿਆਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਨੈਨ ਦਿਪੈ ਨੀਕੇ ਕਜਰਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਲਖੇ ਹੋਤ ਲਲਨਾ ਮਤਵਾਰੇ ॥੨॥",
