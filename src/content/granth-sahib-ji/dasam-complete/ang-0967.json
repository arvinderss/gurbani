      "s": 14
    },
    {
      "t": "ਸ੍ਰੋਨਤ ਸੋ ਭੀਜਤ ਭਈ ਸਕਲ ਧਰਨਿ ਸਰਬੰਗ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਆਨਿ ਤਰੇ ਰਾਜਾ ਪਰਿਯੋ ਲਗੇ ਕਟਾਰੀ ਅੰਗ ॥੧੪॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਨ੍ਰਿਪ ਮਰਿਯੋ ਤ੍ਰਿਯਹਿ ਲਖਿ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਹ੍ਵੈ ਦੁਖਿਤ ਸੁਨਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕੌਨ ਕਾਲ ਗਤਿ ਕਰੀ ਹਮਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜਾ ਜੂ ਚੁਭਿ ਮਰੇ ਕਟਾਰੀ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਰਾਨੀ ਹ੍ਵੈ ਦੀਨ ਉਘਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬੈਠੇ ਸਭ ਲੋਗਨ ਸੁਨਿ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੋ ਸਭ ਪੂਛਨਿ ਮਿਲਿ ਆਏ ॥",
      "s": 14
    },
    {
      "t": "ਕੋਨੈ ਦੁਸਟ ਰਾਵ ਜੂ ਘਾਏ ॥੧੬॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਰਾਨੀ ਅਤਿ ਦੁਖਿਤ ਬਖਾਨ੍ਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੋ ਭੇਦ ਕਛੂ ਨ ਪਛਾਨ੍ਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਥਮ ਰਾਵ ਜੂ ਮਾਸੁ ਮੰਗਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਆਪੁ ਭਖ੍ਰਯੋ ਕਛੁ ਭ੍ਰਿਤਨ ਪਠਾਯੋ ॥੧੭॥",
      "s": 14
    },
    {
      "t": "ਪੁਨਿ ਰਾਜਾ ਜੂ ਅਮਲ ਮੰਗਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਆਪੁ ਪਿਯੋ ਕਛੁ ਹਮੈ ਪਿਯਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪੀਏ ਕੈਫ ਕੈ ਅਤਿ ਮਤਿ ਭਏ ॥",
      "s": 14
