  "lines": [
    {
      "t": "ਨ੍ਰਿਪਹੂੰ ਕੋ ਅਤਿ ਚਾਹਤ ਪ੍ਯਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਹੂੰਅਨ ਪਰਮ ਪ੍ਰੀਤ ਭੀ ਐਸੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੀਤਾ ਸੋ ਰਘੁਨਾਥਨ ਵੈਸੀ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਹੇਰਿ ਤ੍ਰਿਯ ਰਾਵ ਲੁਭਾਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਜੁ ਤ੍ਰਿਯ ਸੰਗ ਨੇਹ ਘਟ ਮਾਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਇਹ ਕ੍ਰਿਸਨ ਕੁਅਰਿ ਸੁਨਿ ਪਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜਾ ਪੈ ਚਿਤ ਤੇ ਖੁਨਸਾਈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਕ੍ਰਿਸਨ ਕੁਅਰਿ ਚਿਤ ਅਧਿਕ ਰਿਸਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਮਨ ਮੈ ਘਾਤ ਯਹੈ ਠਹਰਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਹਕਰਿ ਕਰਿ ਮੈ ਆਜੁ ਸੁ ਕਰਿਹੋ ॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪਹ ਸੰਘਾਰਿ ਆਪੁ ਪੁਨਿ ਮਰਿਹੋ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਰਾਨੀ ਚਿਤ ਤੇ ਜਰੀ ਮਨ ਮੈ ਅਧਿਕ ਰਿਸਾਇ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਜ੍ਯੋਂ ਸੀਸੋ ਸਰ ਕੇ ਲਗੇ ਤੂਟਿ ਤਰਕ ਦੈ ਜਾਇ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਪਠੈ ਦੂਤ ਰਾਜੈ ਤੁਰਤ ਲੀਨੀ ਤਰੁਨਿ ਬੁਲਾਇ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਗਰਬ ਪ੍ਰਹਰਿ ਝਖ ਕੇਤੁ ਕੋ ਸੋਇ ਰਹੈ ਸੁਖੁ ਪਾਇ ॥੮॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਐਸੇ ਰਾਨੀ ਸੁਨਿ ਪਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਮਧਰ ਲਏ ਹਾਥ ਮੋ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਸਨ ਸਿੰਘ ਪਤਿ ਪ੍ਰਥਮ ਸੰਘਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਪਾਛੇ ਤਿਹ ਤ੍ਰਿਯ ਕੋ ਮਾਰਿਯੋ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਰਿ ਮਾਸ ਤ੍ਰਿਯ ਤਵਨ ਕੋ ਰਾਧਿ ਲਯੋ ਤਿਹ ਕਾਲ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸਦਨ ਏਕ ਉਮਰਾਵ ਕੇ ਭੇਜ ਦਯੋ ਤਤਕਾਲ ॥੧੦॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਮਾਸ ਜਾਨਿ ਤਾ ਕੋ ਤੁਰਤ ਚਾਬਿ ਗਏ ਸਭ ਸੋਇ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਭਲੋ ਭਲੋ ਸਭ ਕੋ ਕਹੈ ਭੇਦ ਨ ਪਾਵੈ ਕੋਇ ॥੧੧॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਹਾਥ ਪਾਵ ਨ੍ਰਿਪ ਕੇ ਸਕਲ ਸੰਗ ਮੁਤਹਰੀ ਤੋਰਿ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸੀੜਨ ਪਰ ਤੇ ਆਨਿ ਕੈ ਦਯੋ ਧਰਨਿ ਕਹ ਛੋਰਿ ॥੧੨॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਮਦਰਾ ਕੇ ਮਦ ਸੋ ਛਕ੍ਯੋ ਉਰ ਜਮਧਰ ਕੀ ਖਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਸੀੜਿਨ ਤੇ ਖਿਸਕਤ ਨ੍ਰਿਪਤ ਪਰਿਯੋ ਧਰਨਿ ਪਰ ਆਇ ॥੧੩॥",
      "v": [
        [
          3,
          2
        ]
