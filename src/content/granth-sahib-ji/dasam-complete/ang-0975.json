  "lines": [
    {
      "t": "ਸੁਰ ਪੁਰ ਬਹੁਰ ਬਧਾਵੋ ਭਯੋ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਸਤਰਹ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੧੭॥੨੨੯੬॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਪਛਿਮ ਦੇਵ ਰਾਵ ਬਡਭਾਗੀ ॥",
      "s": 14
    },
    {
      "t": "ਮੰਤ੍ਰ ਕਲਾ ਰਾਨੀ ਸੌ ਪਾਗੀ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਤ੍ਰਿਯ ਕਹੈ ਵਹੈ ਜੜ ਕਰਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਨੁ ਪੂਛੈ ਕਛੁ ਤਿਹ ਨ ਨੁਸਰਈ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਪਰ ਰਹਤ ਰਾਵ ਉਰਝਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੋਇ ਪੁਤ੍ਰ ਤਾ ਤੇ ਉਪਜਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਲ ਪਾਇ ਰਾਜਾ ਮਰਿ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਪੁਤ੍ਰ ਤਾ ਕੇ ਕੋ ਭਯੋ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਪੁਰਖ ਆਯੋ ਤਹਾ ਅਮਿਤ ਰੂਪ ਕੀ ਖਾਨਿ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਲਖਿ ਰਾਨੀ ਤਿਹ ਬਸਿ ਭਈ ਬਧੀ ਬਿਰਹ ਕੈ ਬਾਨ ॥੩॥",
      "v": [
        [
          4,
