{
  "page": 977,
  "lines": [
    {
      "t": "ਬਿਦਾ ਅਮਿਤ ਧਨ ਦੈ ਕਰੋ ਯਾ ਕੌ ਅਧਿਕ ਰਿਝਾਇ ॥੧੧॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਇਹ ਬਾਤ ਨ੍ਰਿਪਤਿ ਸੁਨਿ ਪਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨ੍ਯੋ ਮੋਰਿ ਧਰਮਜਾ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਛੋਰਿ ਭੰਡਾਰ ਅਮਿਤ ਧਨ ਦਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਹਿਤਾ ਹੇਤ ਬਿਦਾ ਤਿਹ ਕਿਯੋ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਮੰਤ੍ਰ ਕਲਾ ਪਿਤੁ ਤੀਰ ਉਚਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਧਰਮ ਬਹਿਨ ਮੋ ਕੌ ਅਤਿ ਪ੍ਯਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਮੈ ਯਹ ਅਜੁ ਸੰਗ ਲੈ ਜੈਹੌ ॥",
      "s": 14
    },
    {
      "t": "ਬਨ ਉਪਬਨ ਕੇ ਚਰਿਤ੍ਰ ਦਿਖੈਹੌ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਯੌ ਕਹਿ ਪਲਟਿ ਧਾਮ ਨਿਜੁ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਪਿਯ ਸੌ ਕਹੀ ਬਾਤ ਮੁਸਕਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਧਰਮ ਭਗਨਿ ਮੁਹਿ ਤੂ ਅਤਿ ਪ੍ਯਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਇਸੀ ਪਾਲਕੀ ਚਰ੍ਰਹੋ ਹਮਾਰੀ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਬਾਤ ਕਹਤ ਦੋਊ ਹਮ ਜੈਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਚਿਤ ਕੈ ਸੋਕ ਦੂਰਿ ਕਰਿ ਦੈਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਪਾਲਕੀ ਲਯੋ ਚਰ੍ਰਹਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਨ ਉਪਬਨ ਬਿਹਰਨ ਕੌ ਆਈ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਬੀਚ ਬਜਾਰ ਪਾਲਕੀ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਪਰਦਨ ਪਾਤਿ ਛੋਰਿ ਕੈ ਦਈ ॥",
      "s": 14
    },
    {
      "t": "ਤੇ ਕਾਹੂ ਕੌ ਦ੍ਰਿਸਟਿ ਨ ਆਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਕੇਲ ਕਮਾਤ ਚਲੇ ਦੋਊ ਜਾਵੈ ॥੧੬॥",
      "s": 14
    },
    {
      "t": "ਮਨ ਭਾਵਤ ਕੋ ਭੋਗ ਕਮਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਦਿਨ ਬਜਾਰ ਮਹਿ ਕਿਨੂੰ ਨ ਪਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਅਸਟ ਕਹਾਰਨ ਕੇ ਕੰਧ ਊਪਰ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਘੈ ਲਈ ਮੀਤ ਭੁਜ ਦੂਪਰ ॥੧੭॥",
      "s": 14
    },
    {
      "t": "ਜ੍ਯੋਂ ਜ੍ਯੋਂ ਚਲੀ ਪਾਲਕੀ ਜਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਯੋਂ ਪ੍ਰੀਤਮ ਚਟਕੇ ਚਟਕਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਲਹੈਂ ਕਹਾਰ ਪਾਲਕੀ ਚਰਿ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਯੋਂ ਤ੍ਯੋਂ ਗਹੈ ਕੰਧ ਦ੍ਰਿੜ ਕਰਿ ਕੈ ॥੧੮॥",
      "s": 14
    },
    {
      "t": "ਬਨ ਮੈ ਜਾਇ ਪਾਲਕੀ ਧਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਸੇਤੀ ਰਤਿ ਕਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਅਮਿਤ ਦਰਬੁ ਚਾਹਿਯੋ ਸੋ ਲਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯ ਕਰਿ ਤਾਹਿ ਦੇਸ ਲੈ ਗਯੋ ॥੧੯॥",
      "s": 14
    },
    {
      "t": "ਲਿਖਿ ਪਤਿਯਾ ਡੋਰੀ ਮਹਿ ਧਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਤ ਪਿਤਾ ਤਨ ਇਹੈ ਉਚਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਨਰ ਸੁੰਦਰ ਮੋ ਕਹ ਯਹ ਭਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਮੈ ਯਹ ਚਰਿਤ ਬਨਾਯੋ ॥੨੦॥",
      "s": 14
    },
    {
      "t": "ਵਹ ਧ੍ਰਮਜਾ ਨਹਿ ਹੋਇ ਤਿਹਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਮੈ ਪਕਰਿ ਪਾਲਕੀ ਡਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਕਚ ਅਰਿ ਲਏ ਦੂਰਿ ਕਚ ਕਏ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਖਨ ਬਸਤ੍ਰ ਬਾਲ ਕੇ ਦਏ ॥੨੧॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਧਨ ਚਹਿਯੋ ਸੋਊ ਸਭ ਲੀਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਤ ਮਾਤ ਕੋ ਦਰਸਨ ਕੀਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਮ ਤੇ ਜਬ ਲੈ ਬਿਦਾ ਸਿਧਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਕੇ ਸੰਗ ਤਬੈ ਉਠਿ ਆਈ ॥੨੨॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਸ ਸੁਖੀ ਤੁਮਰੋ ਬਸੋ ਸੁਖੀ ਰਹਹੁ ਤੁਮ ਤਾਤ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸੁਖੀ ਦੋਊ ਹਮਹੂੰ ਬਸੈ ਚਿਰ ਜੀਵੋ ਤੁਮ ਮਾਤ ॥੨੩॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਉਨੀਸਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੧੯॥੨੩੩੨॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਦਿਵਸ ਸ੍ਰੀ ਇੰਦ੍ਰ ਜੂ ਹਰ ਘਰ ਕਿਯੋ ਪਿਯਾਨ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਮਹਾ ਰੁਦ੍ਰ ਕਉ ਰੁਦ੍ਰ ਲਖਿ ਚਿੰਤ ਬਢੀ ਅਪ੍ਰਮਾਨ ॥੧॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਵਤੇਸ ਜਬ ਰੁਦ੍ਰ ਨਿਹਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਕੋਪ ਕਰਿ ਬਜ੍ਰ ਪ੍ਰਹਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਅਮਿਤ ਕੋਪ ਤਬ ਤਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਛਾਡਤ ਜ੍ਵਾਲ ਬਕਤ੍ਰ ਤੇ ਭਯੋ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਪਸਰਿ ਜ੍ਵਾਲ ਸਭ ਜਗ ਮਹਿ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਦਾਹਤ ਤੀਨਿ ਭਵਨ ਕਹ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਵ ਦੈਤ ਸਭ ਹੀ ਡਰ ਪਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਮਿਲਿ ਕਰਿ ਮਹਾ ਰੁਦ੍ਰ ਪਹਿ ਆਏ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਰੁਦ੍ਰ ਤਬ ਕੋਪ ਨਿਵਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਰਿਧ ਮੈ ਪਾਵਕ ਕੋ ਡਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਕਲ ਤੇਜ ਇਕਠੋ ਹ੍ਵੈ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਦੈਤ ਜਲੰਧਰ ਭਯੋ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਬ੍ਰਿੰਦਾ ਨਾਮ ਤ੍ਰਿਯਾ ਤਿਨ ਕੀਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਅਤਿ ਪਤਿਬ੍ਰਤਾ ਜਗਤ ਮੈ ਚੀਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਪ੍ਰਸਾਦਿ ਪਤਿ ਰਾਜ ਕਮਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੌ ਦੁਸਟ ਨ ਦੇਖਨ ਪਾਵੈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਦੇਵ ਅਦੇਵ ਜੀਤਿ ਤਿਨ ਲਏ ॥",
      "s": 14
    },
    {
      "t": "ਲੋਕ ਚਤੁਰਦਸ ਬਸਿ ਮਹਿ ਭਏ ॥",
      "s": 14
    }
  ]
