{
  "page": 980,
  "lines": [
    {
      "t": "ਤਾ ਪਾਛੈ ਜਾਲੰਧਰ ਮਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰੋ ਰਾਜ ਆਪਨੋ ਲਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਰ ਪੁਰ ਮਾਝ ਬਧਾਵੋ ਕਿਯੋ ॥੨੯॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਚਰਿਤ੍ਰ ਸੌ ਬਿਸਨ ਜੂ ਬ੍ਰਿੰਦਾ ਕੋ ਸਤ ਟਾਰਿ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਆਨਿ ਰਾਜ ਅਪਨੋ ਲਯੋ ਜਾਲੰਧਰ ਕਹ ਮਾਰਿ ॥੩੦॥੧॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਪੁਰਖ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਬੀਸਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੨੦॥੨੩੬੨॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਹਾਗੀਰ ਜਬ ਤਖਤ ਸੁਹਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਬੁਰਕਾ ਪਹਿਰਿ ਨਾਰਿ ਇਕ ਆਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਖੀਸੇ ਕਾਟਿ ਬਹੁਨ ਕੇ ਲੇਈ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਜ ਮੁਖ ਕਿਸੂ ਨ ਦੇਖਨ ਦੇਈ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੋ ਭੇਦ ਏਕ ਨਰ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਔਰ ਨ ਕਾਹੂੰ ਤੀਰ ਜਤਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਾਤ ਭਏ ਆਈ ਤ੍ਰਿਯ ਜਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਚਿਤ ਕੇ ਬਿਖੈ ਇਹੈ ਮਤਿ ਠਾਨੀ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਪਨਹੀ ਹਾਥ ਆਪਨੇ ਲਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਮਾਰਿ ਤਾ ਤ੍ਰਿਯ ਕੌ ਦਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਤਰ ਛੋਰਿ ਆਈ ਕ੍ਯੋਨ ਚਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜੂਤਿਨ ਸੌ ਕਮਰੀ ਕਰਿ ਡਾਰੀ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਮਰੀ ਕੈ ਜੂਤਿਨ ਦਈ ਭੂਖਨ ਲਏ ਉਤਾਰਿ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਕਿਹ ਨਿਮਿਤ ਆਈ ਇਹਾ ਐਸੇ ਬਚਨ ਉਚਾਰਿ ॥੪॥",
      "v": [
        [
          3,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਭਹੂੰ ਇਹੈ ਚਿਤ ਮੈ ਜਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੀ ਨਾਰਿ ਤ੍ਰਿਯਾ ਪਹਿਚਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਨੁ ਪੂਛੇ ਪਤਿ ਕੇ ਕ੍ਯੋਨ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਤੇ ਆਜੁ ਮਾਰਿ ਤੈਂ ਖਾਈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਲੌ ਤਾਹਿ ਤ੍ਰਿਯਹਿ ਸੁਧਿ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਲੌ ਗਯੋ ਵਹ ਪੁਰਖ ਲੁਕਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਤ੍ਰਸਤ ਨ ਤਹ ਪੁਨਿ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਚੋਰੀ ਕਰਤ ਹੁਤੀ ਤਜਿ ਦਈ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਪੁਰਖ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਇਕੀਸਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੨੧॥੨੩੬੮॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਭੈ ਸਾਡ ਰਾਜਾ ਇਕ ਭਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਲੂਰ ਕੇ ਦੇਸ ਉਜਿਯਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਖਾਨ ਤਤਾਰ ਖੇਤ ਤਿਨ ਮਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਕਨ ਕੋ ਕੂਆ ਭਰ ਡਾਰਿਯੋ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਪੈ ਚੜੇ ਖਾਨ ਰਿਸਿ ਭਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਤਿਨ ਨ੍ਰਿਪਤਿ ਸੰਘਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਹਾਰੇ ਸਭੈ ਉਪਾਇ ਬਨਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਛਜੂਅਹਿ ਗਜੂਅਹਿ ਖਾਨ ਬੁਲਾਯੋ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਕਾਖ ਬਿਖੈ ਕਬੂਤਰ ਇਕ ਰਾਖਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਸੌ ਬਚਨ ਬਕਤ੍ਰ ਤੇ ਭਾਖਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਨ੍ਰਿਪ ਕੋ ਜੁ ਬੁਰਾ ਕੋਊ ਕਰਿ ਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੋ ਪਾਪ ਮੂਡ ਇਹ ਪਰਿ ਹੈ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਯਹ ਸੁਨਿ ਬਚਨ ਮਾਨਿ ਤੇ ਗਏ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਨ ਚੀਨਤ ਭਏ ॥",
      "s": 14
    }
  ]
