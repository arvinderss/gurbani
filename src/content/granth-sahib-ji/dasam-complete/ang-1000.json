    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਮੂਰਖ ਰਾਵ ਬਾਇ ਮੁਖ ਰਹਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਖਤ ਰਹਿਯੋ ਜਾਰ ਨਹਿੰ ਗਹਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪਾਹਰੂਨ ਜੋ ਖੀਰ ਪਠਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਖਾਨ ਲਗੇ ਗ੍ਰੀਵਾ ਨਿਹੁਰਾਈ ॥੨੭॥",
      "s": 14
    },
    {
      "t": "ਜਿਯਤ ਜਾਰ ਤ੍ਰਿਯ ਘਰ ਪਹੁਚਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪਾਹਰੂ ਨ ਰਾਜਾ ਲਖ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਪਹੁਚਾਇ ਸਖੀ ਜਬ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਰਾਨੀ ਅਤਿ ਹੀ ਹਰਖਾਈ ॥੨੮॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਰਾਵ ਰਾਨੀ ਰਤਿ ਕੀਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਚਿਤ ਕੀ ਬਾਤ ਤਾਹਿ ਕਹਿ ਦੀਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਨਹੂੰ ਭ੍ਰਮ ਮੋਰੇ ਚਿਤ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਮੈ ਦੇਖਨਿ ਗ੍ਰਿਹ ਆਯੋ ॥੨੯॥",
      "s": 14
    },
    {
      "t": "ਪੁਨਿ ਰਾਨੀ ਯਹ ਭਾਤਿ ਉਚਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨੋ ਨ੍ਰਿਪਤਿ ਤੁਮ ਬਚਨ ਹਮਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਨ ਤੁਹਿ ਕਹਿਯੋ ਸੁ ਮੁਹਿ ਕਹਿ ਦੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਤਰ ਆਸ ਨ ਹਮਰੀ ਕੀਜੈ ॥੩੦॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਰਾਨੀ ਇਹ ਭਾਤਿ ਸੁਨਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਰਾਜੇ ਸੋ ਸਖੀ ਬਤਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਤੁਮ ਕਹਿਯੋ ਸਾਚੀ ਪਹੁਚਾਵੋ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਤਰ ਧਾਮ ਮ੍ਰਿਤੁ ਕੇ ਜਾਵੋ ॥੩੧॥",
      "s": 14
    },
    {
      "t": "ਰਾਨਿਨ ਕੋ ਕੋਊ ਦੋਸ ਲਗਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਨ ਕੌ ਜਗਤ ਸੀਸ ਨਿਹੁਰਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਝੂਠੀ ਸਖੀ ਜਾਨਿ ਬਧ ਕੀਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੂਰਖ ਰਾਵ ਭੇਦ ਨਹਿ ਚੀਨੋ ॥੩੨॥",
      "s": 14
    },
    {
