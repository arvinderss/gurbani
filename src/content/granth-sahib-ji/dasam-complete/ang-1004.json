        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਪੈ ਪਰੀ ਬਹੁਤ ਚਲਿ ਆਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਕੋਊ ਨਾਚਿ ਉਠ ਕੋਊ ਗਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਕੇ ਭਾਵ ਦਿਖਾਵਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਖਨਹਾਰ ਸਭੇ ਬਲਿ ਜਾਵਹਿ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਲਾਲ ਪਰੀ ਇਕ ਬਚਨ ਉਚਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਹ ਪਰੀ ਸੁਨੁ ਬੈਨ ਹਮਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੁੰਦਰਿ ਕਲਾ ਕੁਅਰਿ ਇਕ ਭਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁਕ ਰੂਪ ਕੀ ਰਾਸਿ ਸਵਾਰੀ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹੀ ਤੇ ਬਿਧਿ ਰੂਪ ਲੈ ਕੀਨੇ ਰੂਪ ਅਨੇਕ ॥",
