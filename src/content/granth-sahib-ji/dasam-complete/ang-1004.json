      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੀ ਪ੍ਰਭਾ ਜਾਤ ਨਹਿ ਕਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨੁਕ ਫੂਲਿ ਮਾਲਿਤੀ ਰਹੀ ॥",
      "v": [
        [
          0,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਕਵਨ ਸੁ ਕਬਿ ਤਿਹ ਪ੍ਰਭਾ ਉਚਾਰੈ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਕੋਟਿ ਸੂਰ ਜਨੁ ਚੜੇ ਸਵਾਰੇ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਮੁਲਾ ਬਾਤ ਸ੍ਰਵਨ ਯਹ ਸੁਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਰਹ ਬਿਕਲ ਹ੍ਵੈ ਮੂੰਡੀ ਧੁਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਦੇਵ ਭੇਜਾ ਤਹ ਜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੀ ਖਾਟ ਉਠਾਇ ਮੰਗਾਈ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਵਾ ਸੁੰਦਰਿ ਕੋ ਕਛੁ ਨ ਬਸਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੁਲਾ ਕੇ ਸੰਗ ਭੋਗ ਕਮਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬੀਤੀ ਰੈਨਿ ਭੋਰ ਜਬ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਪਹੁਚਾਇ ਤਹੀ ਤਿਨ ਦਯੋ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਐਸੀ ਬਿਧਿ ਤਿਹ ਰੋਜ ਬੁਲਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਹੋਤ ਉਦੋਤ ਫਿਰੰਗ ਪਠਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਮਨ ਮਾਨਤ ਕੇ ਕੇਲਨ ਕਰੈ ॥",
