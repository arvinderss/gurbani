      "s": 14
    },
    {
      "t": "ਅੜਿਲ ॥",
      "s": 14
    },
    {
      "t": "ਪਕਰਿ ਮੁਤਹਰੀ ਪੁਨਿ ਸਕੋਪ ਮੁੰਡਿਯਾ ਭਏ ॥",
      "v": [
        [
          2,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਫਰੂਆ ਲਾਠੀ ਸਭੇ ਲਏ ਉਦਿਤ ਭਏ ॥",
      "v": [
        [
          2,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਕਾਟਿ ਕਾਟਿ ਕੈ ਅੰਗ ਸੰਨ੍ਯਾਸਿਨ ਖਾਵਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਹੋ ਦਸ ਨਾਮਨ ਕੋ ਲੈ ਲੈ ਨਾਮ ਗਿਰਾਵਹੀ ॥੧੩॥",
      "v": [
        [
          5,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤਬ ਸੰਨ੍ਯਾਸੀ ਧਾਇ ਧਾਇ ਤਿਨ ਕਾਟਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਤੋਰਿ ਤੋਰਿ ਕੰਠਿਨ ਤੇ ਕੰਠੀ ਸਾਟਹੀ ॥",
