  "lines": [
    {
      "t": "ਤਬ ਸਭ ਹੀ ਸੰਨ੍ਯਾਸੀ ਧਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਗਹਿ ਗਹਿ ਹਾਥ ਜੂਤਿਯੈ ਆਏ ॥",
      "s": 14
    },
    {
      "t": "ਚੌੜ ਭਰਥ ਰੰਡੀਗਿਰ ਦੌਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਲੈ ਲੈ ਢੋਵ ਚੇਲਕਾ ਔਰੇ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਬਾਲਕ ਰਾਮ ਘੇਰਿ ਕੈ ਲਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜੂਤਨ ਸਾਥ ਦਿਵਾਨੋ ਕਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਘੂਮਿ ਭੂਮਿ ਕੇ ਊਪਰ ਛਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁ ਕਰਿ ਬੀਜੁ ਮੁਨਾਰਾ ਪਰਿਯੋ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਮੁੰਡਿਯਾ ਕ੍ਰੁਧਿਤ ਭਏ ਭਾਜਤ ਭਯੋ ਨ ਏਕ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌੜ ਭਰਥ ਗਿਰ ਰਾਡ ਪੈ ਕੁਤਕਾ ਹਨੇ ਅਨੇਕ ॥੧੧॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸੰਨ੍ਯਾਸੀ ਕੋਪਿਤ ਭਏ ਲਗੇ ਮੁਤਹਰੀ ਘਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਲਾਤ ਮੁਸਟ ਜੂਤਿਨ ਭਏ ਮੁੰਡਿਯਾ ਦਏ ਗਿਰਾਇ ॥੧੨॥",
      "v": [
        [
          3,
          2
        ]
