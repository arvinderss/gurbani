{
  "page": 1054,
  "lines": [
    {
      "t": "ਬੇਰੀ ਏਕ ਬੈਠਿ ਸੁਖ ਕੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਦੂਜੀ ਨਾਵ ਬੇਸਵਨ ਦੀਜੈ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਹਮ ਤੁਮ ਬੈਠਿ ਨਾਵ ਸੁਖ ਕੈਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਇਨ ਬੇਸ੍ਵਨ ਤੇ ਗੀਤਿ ਗਵੈਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਸੁੰਦਰਿ ਇਨ ਤੇ ਲਖਿ ਲਿਜਿਯਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਸੌ ਭੋਗ ਰਾਵ ਤੁਮ ਕਿਜਿਯਹੁ ॥੧੩॥",
      "v": [
        [
          3,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸੋ ਸੁਨਿ ਰਾਵ ਅਨੰਦਿਤ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯਨ ਸਹਿਤ ਬੇਸ੍ਵਨ ਲੈ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਆਮੂੰ ਜਹਾ ਬਹਿਤ ਨਦ ਭਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁ ਬਿਧਿ ਅਸਟਮ ਸਿੰਧੁ ਸਵਾਰੋ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਨੀਕੀ ਨਾਵ ਰਾਨਿਯਨ ਲਈ ॥",
      "s": 14
    },
    {
      "t": "ਬੇਰੀ ਬੁਰੀ ਬੇਸ੍ਵਨ ਦਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਪਨੇ ਰਾਵ ਤੀਰ ਬੈਠਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੂਰਖ ਭੇਦ ਨ ਕਛੂ ਬਿਚਾਰਿਯੋ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਰਾਨੀ ਤਿਨ ਅਤਿ ਧਨੁ ਦੀਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਬੇਰਿਯਾਰ ਅਪਨੇ ਬਸਿ ਕੀਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਹਾ ਬਹਤ ਆਮੂੰ ਨਦ ਭਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਬੇਸ੍ਵਨ ਤਹੀ ਬੋਰਿ ਤੁਮ ਡਾਰੋ ॥੧੬॥",
      "s": 14
    },
    {
      "t": "ਅਰਧ ਨਦੀ ਨਵਕਾ ਜਬ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਹੀ ਫੋਰਿ ਮਲਾਹਨ ਦਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਬੇਸ੍ਵਾ ਡੂਬਨ ਤਬ ਲਾਗੀ ॥",
      "s": 14
    },
    {
      "t": "ਭਰੂਵਨਿ ਦਸੋ ਦਿਸਨ ਕਹ ਭਾਗੀ ॥੧੭॥",
      "s": 14
    },
    {
      "t": "ਬੇਸ੍ਵਾ ਸਕਲ ਗੁਚਕਿਯਨ ਖਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਠੌਰ ਨ ਰਹੀ ਭਾਜਿ ਜਿਤ ਜਾਹੀ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਹਾਇ ਹਾਇ ਰਾਨੀ ਤਬ ਕਰਈ ॥",
      "s": 14
    },
    {
      "t": "ਇਨ ਮੂਏ ਰਾਜਾ ਇਹ ਮਰਈ ॥੧੮॥",
      "s": 14
    },
    {
      "t": "ਰਾਵ ਸੁਨਤ ਇਨ ਕਹੈ ਨਿਕਾਰਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਸਖਿਯਨ ਕਹਿਯੋ ਬੋਰ ਗਹਿ ਡਾਰਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਅਮਿਤ ਮ੍ਰਿਦੰਗ ਬਹਤ ਕਹੂੰ ਜਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਬੇਸ੍ਵਾ ਕਹੀ ਗੁਚਕਿਯਨ ਖਾਹੀ ॥੧੯॥",
      "s": 14
    },
    {
      "t": "ਮੁਰਲੀ ਮੁਰਜ ਤੰਬੂਰਾ ਬਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਭਰੂਆ ਬਹੇ ਜਾਤਿ ਨਹਿ ਕਹੇ ॥",
      "s": 14
    },
    {
      "t": "ਭਰੂਅਨਿ ਕਹੂੰ ਪੁਕਾਰਤ ਜਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਬੇਸ੍ਵਨ ਰਹੀ ਕਛੂ ਸੁਧਿ ਨਾਹੀ ॥੨੦॥",
      "s": 14
    },
    {
      "t": "ਡੂਬਿ ਡੂਬਿ ਭਰੂਆ ਕਹੂੰ ਮਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਭਰੂਅਨਿ ਉਦਰ ਨੀਰ ਸੋ ਭਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਬੇਸ੍ਵਾ ਏਕ ਜਿਯਤ ਨਹਿ ਬਾਚੀ ॥",
      "s": 14
    },
    {
      "t": "ਐਸੀ ਮਾਰ ਕਿਰੀਚਕ ਮਾਚੀ ॥੨੧॥",
      "s": 14
    },
    {
      "t": "ਗੁਚਕਿ ਖਾਤ ਬੇਸ੍ਵਾ ਜੇ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਟੰਗਰਨਿ ਪਕਰਿ ਬੋਰਿ ਸੋਊ ਦਈ ॥",
      "s": 14
    },
    {
      "t": "ਹਾਇ ਹਾਇ ਨ੍ਰਿਪ ਠਾਢ ਪੁਕਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਕੋ ਪਹੁਚੈ ਤਿਨ ਖੈਂਚਿ ਨਿਕਾਰੈ ॥੨੨॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਬੇਸ੍ਵਾ ਕਾਢਨ ਕਹ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਡੂਬਤ ਵਹੂ ਨਦੀ ਮਹਿ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਧਾਰ ਧਾਰ ਭਰੁਅਨਿ ਇਕ ਕਰਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਡੂਬਿ ਡੂਬਿ ਸਰਿਤਾ ਮੋ ਮਰਹੀ ॥੨੩॥",
      "s": 14
    },
    {
      "t": "ਕੂਕਿ ਕੂਕਿ ਬੇਸ੍ਵਾ ਸਭ ਹਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਨਹੀ ਪੁਰਖ ਨ ਐਂਚਿ ਨਿਕਾਰੀ ॥",
      "s": 14
    }
  ]
}
