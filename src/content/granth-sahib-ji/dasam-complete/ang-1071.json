{
  "page": 1071,
  "lines": [
    {
      "t": "ਟੂਕ ਅਨੇਕ ਤਾਹਿ ਕਰਿ ਦਿਯੋ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਾਤ ਸਮੈ ਕ੍ਰੀਚਕ ਰਿਸਿ ਭਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਕੇਸ ਦ੍ਰੋਪਤੀ ਕੇ ਦ੍ਰਿੜ ਧਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਯਾਹਿ ਅਗਨਿ ਕੇ ਬੀਚ ਜਰੈ ਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਭ੍ਰਾਤ ਗਯੋ ਤਹ ਤੋਹਿ ਪਠੈ ਹੈ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਗਹਿ ਕੇ ਕੇਸ ਤਾਹਿ ਲੈ ਚਲੇ ॥",
      "s": 14
    },
    {
      "t": "ਕ੍ਰੀਚਕ ਬੀਰ ਸੂਰਮਾ ਭਲੇ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਹੀ ਕੋਪ ਭੀਮ ਅਤਿ ਭਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਗਹਿ ਕੈ ਤਾਰ ਬ੍ਰਿਛ ਕਰਿ ਧਰਿਯੋ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੌ ਕੋਪਿ ਬ੍ਰਿਛ ਕੀ ਮਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੋ ਮੂੰਡ ਚੌਥਿ ਹੀ ਡਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਹੂੰ ਪਕਰਿ ਟਾਗ ਤੇ ਆਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਸੂ ਕੇਸ ਤੇ ਐਂਚਿ ਬਿਗਾਵੈ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਕਨਿਯਾ ਬਿਖੈ ਕ੍ਰੀਚਕਨ ਧਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਬਰਤ ਚਿਤਾ ਭੀਤਰ ਲੈ ਡਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਸਹਸ ਪਾਚ ਕ੍ਰੀਚਕ ਸੰਗ ਮਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਜੁ ਨਾਰੀ ਕੋ ਪ੍ਰਾਨ ਉਬਾਰਿਯੋ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਚੌਰਾਸੀਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੮੪॥੩੫੪੩॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਬਨਿਕ ਕੀ ਭਾਰਜਾ ਅਕਬਰਬਾਦ ਮੰਝਾਰ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਦੇਵ ਦੈਤ ਰੀਝੈ ਨਿਰਖਿ ਸ੍ਰੀ ਰਨ ਰੰਗ ਕੁਮਾਰਿ ॥੧॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਅਕਬਰ ਆਖੇਟ ਸਿਧਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੋ ਰੂਪ ਨਿਰਖਿ ਬਿਰਮਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਖੀ ਏਕ ਤਿਹ ਤੀਰ ਪਠਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਆਨਿ ਮੁਹਿ ਦੇਹਿ ਮਿਲਾਈ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਚਲ ਸਖੀ ਭਵਨ ਤਿਹ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਵਾ ਕੌ ਭੇਦ ਜਤਾਵਤ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਹਜਰਤਿ ਕੇ ਧਾਮ ਨ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਹਜਰਤਿ ਜੂ ਗ੍ਰਿਹ ਲਏ ਬੁਲਾਈ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਹਜਰਤਿ ਜਬੈ ਭਵਨ ਤਿਹ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਅਬਲਾ ਕੀ ਸੇਜ ਸੁਹਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਰਾਨੀ ਤਿਨ ਬਚਨ ਉਚਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਹੁ ਸਾਹ ਪ੍ਰਾਨਨ ਤੇ ਪ੍ਯਾਰੇ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਕਹੌ ਤੋ ਅਬੈ ਡਾਰਿ ਲਘੁ ਆਊ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਤਿਹਾਰੀ ਸੇਜ ਸੁਹਾਊ ॥",
      "s": 14
    },
    {
      "t": "ਯੌ ਕਹਿ ਜਾਤ ਤਹਾ ਤੇ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਗ੍ਰਿਹ ਕੀ ਐਂਚਿ ਕਿਵਰਿਯਾ ਦਈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਪਤਿ ਕਹ ਜਾਇ ਸਕਲ ਸੁਧਿ ਦਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੰਗ ਕਰਿ ਨਾਥੇ ਲ੍ਯਾਵਤ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਤਿ ਤਬ ਕੋਪ ਬਨਿਕ ਕੋ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਛਿਤ੍ਰ ਉਤਾਰਿ ਹਾਥ ਮੈ ਲਯੋ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਹਜਰਤਿ ਕੋ ਪਨਹੀ ਸਿਰ ਝਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਲਜਤ ਸਾਹ ਨਹਿ ਬਚਨ ਉਚਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਜੂਤਨਿ ਮਾਰਿ ਭੋਹਰੇ ਦਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਵੈਸਹਿ ਦੈ ਦਰਵਾਜੋ ਲਿਯੋ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਾਤ ਭਏ ਕੁਟਵਾਰ ਕੇ ਭਈ ਪੁਕਾਰੂ ਜਾਇ ॥",
