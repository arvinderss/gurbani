{
  "page": 1073,
  "lines": [
    {
      "t": "ਦਾਰੂ ਬਿਖੈ ਅੰਗਾਰੇ ਝਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਤਸਕਰ ਤਬ ਹੀ ਉਡ ਗਏ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਚਰ ਤੇ ਖੇਚਰ ਸੋ ਭਏ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਦਾਰੂ ਉਡਤ ਚੋਰਿ ਉਡਿ ਗਏ ॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਹੀ ਫਿਰਤ ਗਗਨ ਮੌ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਦਸ ਦਸ ਕੋਸ ਜਾਇ ਕਰ ਪਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਹਾਡ ਗੋਡ ਨਹਿ ਮੂੰਡ ਉਬਰੇ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਏਕੈ ਬਾਰ ਚੋਰ ਉਡ ਗਏ ॥",
      "s": 14
    },
    {
      "t": "ਜੀਵਤ ਏਕ ਨ ਬਾਚਤ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਚਰਿਤ੍ਰ ਅਬਲਾ ਤਿਹ ਮਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਛਲ ਕੇ ਅਪਨੋ ਧਾਮ ਉਬਾਰਿਯੋ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਸਭ ਚੋਰਨ ਕਹ ਘਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰੈ ਧਾਮ ਆਪਨੋ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਇੰਦ੍ਰ ਬਿਸਨ ਬ੍ਰਹਮਾ ਸਿਵ ਹੋਈ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯ ਚਰਿਤ੍ਰ ਤੇ ਬਚਤ ਨ ਕੋਈ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਛਿਆਸੀਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੮੬॥੩੫੬੬॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਕਲਾ ਕਾਮਨਿ ਇਕ ਸੁਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਬੇਦ ਸਾਸਤ੍ਰ ਭੀਤਰਿ ਅਤਿ ਗੁਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੋ ਪੁਤ੍ਰ ਨ ਆਗ੍ਯਾ ਮਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਤੇ ਮਾਤ ਕੋਪ ਚਿਤ ਠਾਨੈ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਕੁਬੁਧਿ ਬਿਖੈ ਦਿਨੁ ਰੈਨਿ ਗਵਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਤ ਪਿਤਾ ਕੋ ਦਰਬੁ ਲੁਟਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਗੁੰਡਨ ਸਾਥ ਕਰੈ ਗੁਜਰਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਰਤ ਕੁਬਿਰਤਿ ਪਿਯਤ ਮਦ ਪਾਨਾ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੋ ਭ੍ਰਾਤ ਦੁਤਿਯ ਸੁਭ ਕਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜੂਪ ਰਹਿਤ ਨ ਕਛੂ ਦੁਰਚਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਸੌ ਨੇਹ ਮਾਤ ਕੋ ਰਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਕੌ ਬੇਗਿ ਸੰਘਾਰੋ ਚਹੈ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਦਿਵਸ ਜਬ ਸੋ ਘਰ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੋਤ ਛਾਪਰੀ ਮਾਝ ਤਕਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਟਟਿਆ ਦ੍ਵਾਰ ਆਗਿ ਦੈ ਦਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਤ ਕੋ ਮਾਤ ਜਰਾਵਤ ਭਈ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਮਾਤ ਪੂਤ ਕੌ ਪ੍ਰਥਮ ਜਰਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰੋਇ ਰੋਇ ਸਭ ਜਗਤ ਸੁਨਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਆਗਿ ਲਗਾਇ ਪਾਨਿ ਕੌ ਧਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਮੂਰਖ ਬਾਤ ਨ ਕਿਨਹੂੰ ਪਾਈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਸਤਾਸੀਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੧੮੭॥੩੫੭੧॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਕੰਚਨ ਪ੍ਰਭਾ ਜਾਟਜਾ ਰਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਅਤਿ ਦੁਤਿਵਾਨ ਤਾਹਿ ਜਗ ਕਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਭਰਤਾ ਏਕ ਪ੍ਰਥਮ ਤਿਨ ਕਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰੁਚਿਯੋ ਨ ਡਾਰਿ ਫਾਸ ਹਨਿ ਦਿਯੋ ॥੧॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਕੇਤਿਕ ਦਿਨਨ ਔਰ ਪਤਿ ਕਰਿਯੋ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸੋਊ ਨ ਰੁਚਿਯੋ ਕਟਾਰੀ ਮਰਿਯੋ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਮਾਸ ਬਿਖੈ ਔਰੈ ਪਤਿ ਪਾਯੋ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸੋਊ ਦੈ ਕੈ ਬਿਖੁ ਤ੍ਰਿਯ ਘਾਯੋ ॥੨॥",
      "v": [
        [
          3,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਥੇ ਨਾਥ ਨਾਇਕਾ ਕੀਨੋ ॥",
      "s": 14
    }
  ]
}
