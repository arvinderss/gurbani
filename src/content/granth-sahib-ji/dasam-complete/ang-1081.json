  "lines": [
    {
      "t": "ਗਹਿ ਗਹਿ ਸਸਤ੍ਰ ਸੂਰਮਾ ਧਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਵ ਅਦੇਵ ਬਿਲੋਕਨ ਆਏ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਪਰ ਦੋਇ ਕਰੰਧਰ ਧਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਸੁਭਟ ਤੇ ਦੋ ਦੋ ਕਰੈ ॥੨੪॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੈ ਅੰਗ ਸਰੋਹੀ ਬਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੀ ਗ੍ਰੀਵ ਸੰਗ ਨਹਿ ਰਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੈ ਲਗਿਯੋ ਕੁਹਕਤੋ ਬਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਪਲਕ ਏਕ ਮੈ ਤਜੈ ਪਰਾਨਾ ॥੨੫॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੈ ਘਾਇ ਗੁਰਜ ਕੋ ਲਾਗਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੋ ਪ੍ਰਾਨ ਦੇਹ ਤਜਿ ਭਾਗਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਹਾਹਾਕਾਰ ਪਖਰਿਯਾ ਕਰਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਠੌਰਨ ਕੇ ਪਾਲੇ ਪਰਹੀ ॥੨੬॥",
      "s": 14
    },
    {
      "t": "ਸਵੈਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਆਨਿ ਪਰੇ ਰਿਸਿ ਠਾਨਿ ਰਠੌਰ ਚਹੂੰ ਦਿਸ ਤੇ ਕਰ ਆਯੁਧ ਲੀਨੇ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਬੀਰ ਕਰੋਰਿਨ ਕੇ ਸਿਰ ਤੋਰਿ ਸੁ ਹਾਥਨ ਕੋ ਹਲਕਾਹਿਨ ਦੀਨੇ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਰੁੰਡ ਪਰੇ ਕਹੂੰ ਤੁੰਡ ਨ੍ਰਿਪਾਨ ਕੇ ਝੁੰਡ ਹਯਾਨ ਕੇ ਜਾਤ ਨ ਚੀਨੇ ॥",
      "v": [
        [
          5,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਕੰਬਰ ਕੇ ਬਹੁ ਟੰਬਰ ਅੰਬਰ ਅੰਬਰ ਛੀਨਿ ਦਿਗੰਬਰ ਕੀਨੈ ॥੨੭॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਐਸੀ ਭਾਤਿ ਸੁ ਭਟ ਬਹੁ ਮਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਰਘੁਨਾਥੋ ਸੁਰ ਲੋਕ ਸਿਧਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਵਾਮਿ ਕਾਜ ਕੇ ਪ੍ਰਨਹਿ ਨਿਬਾਹਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਹਡਿਯਹਿ ਪੁਰੇ ਜੋਧ ਪਹੁਚਾਯੋ ॥੨੮॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਤਿ ਬਰਿ ਕੈ ਭਾਰੀ ਜੁਝ੍ਰਯੋ ਤਨਕ ਨ ਮੋਰਿਯੋ ਅੰਗ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸੁ ਕਬਿ ਕਾਲ ਪੂਰਨ ਭਯੋ ਤਬ ਹੀ ਕਥਾ ਪ੍ਰਸੰਗ ॥੨੯॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਇਕ ਸੌ ਪਚਾਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤ ॥੧੯੫॥੩੬੬੯॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਚੰਦ੍ਰਪੁਰੀ ਨਗਰੀ ਇਕ ਸੁਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਅਪ੍ਰਤਿਮ ਕਲਾ ਰਾਨੀ ਬਹੁ ਗੁਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਅੰਜਨ ਰਾਇ ਬਿਲੋਕ੍ਯੋ ਜਬ ਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਹਰਅਰਿ ਸਰ ਮਾਰਿਯੋ ਤਿਹ ਤਬ ਹੀ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੌ ਧਾਮ ਬੋਲਿ ਕਰਿ ਲਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਕੇਲ ਤਾ ਸੌ ਦ੍ਰਿੜ ਕਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਜਾਰ ਇਹ ਭਾਤਿ ਉਚਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਨਿ ਮਤਿ ਲਖਿ ਪਤਿ ਹਨੈ ਤੁਮਾਰੇ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯੋ ਵਾਚ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਮ ਚਿਤ ਮੈ ਨਹਿ ਤ੍ਰਾਸ ਬਢਾਵੋ ॥",
      "s": 14
    },
    {
      "t": "ਹਮ ਸੌ ਦ੍ਰਿੜ ਕਰਿ ਕੇਲ ਕਮਾਵੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੈ ਤੁਹਿ ਏਕ ਚਰਿਤ੍ਰ ਦਿਖੈਹੌ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਤੁਮਰੋ ਸੋਕ ਮਿਟੈਹੌ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਪਤਿ ਦੇਖਤ ਤੋ ਸੌ ਰਮੌ ਗ੍ਰਿਹ ਕੋ ਦਰਬੁ ਲੁਟਾਇ ॥",
