{
  "page": 1086,
  "lines": [
    {
      "t": "ਦਿਨ ਰੈਨਿ ਭਜੈ ਮੁਖ ਜਾਸੁ ਪਿਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਸੁਨਾਥ ਪ੍ਰਭਾ ਤ੍ਰਿਯ ਔਰ ਰਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਅਤਿ ਸੁੰਦਰ ਤਾ ਕਹ ਜਗਤ ਕਹੈ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਬਿਸੁਨਾਥ ਪ੍ਰਭਾ ਤਨ ਪ੍ਰੀਤਿ ਰਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਉਡਗਿੰਦ੍ਰ ਪ੍ਰਭਾ ਇਕ ਬੈਨ ਚਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਦਿਨ ਰੈਨਿ ਬਿਤੀਤ ਕਰੈ ਇਹ ਕੇ ॥",
      "s": 14
    },
    {
      "t": "ਕਬਹੂੰ ਗ੍ਰਿਹ ਜਾਤ ਨਹੀ ਤਿਹ ਕੇ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਪਰ ਸਤ੍ਰੁ ਤਵਨ ਕੋ ਧਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਦ੍ਰੁਗਤਿ ਸਿੰਘ ਦਲੁ ਲੈ ਸਮੁਹਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮਚਿਯੋ ਜੁਧ ਅਤਿ ਬਜੇ ਨਗਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਵ ਅਦੇਵ ਬਿਲੋਕਤ ਸਾਰੇ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਉਮਡੇ ਸੂਰ ਸਿੰਘ ਜਿਮਿ ਗਾਜਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਦੋਊ ਦਿਸਨ ਜੁਝਊਆ ਬਾਜਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਗੋਮੁਖ ਸੰਖ ਨਿਸਾਨ ਅਪਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਢੋਲ ਮ੍ਰਿਦੰਗ ਮੁਚੰਗ ਨਗਾਰਾ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਤੁਰਹੀ ਨਾਦ ਨਫੀਰੀ ਬਾਜਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਮੰਦਲ ਤੂਰ ਉਤੰਗ ਬਿਰਾਜਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਮੁਰਲੀ ਝਾਝ ਭੇਰ ਰਨ ਭਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਤ ਨਾਦ ਧੁਨਿ ਹਠੇ ਹਕਾਰੀ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਜੁਗਨਿ ਦੈਤ ਅਧਿਕ ਹਰਖਾਨੇ ॥",
      "s": 14
    },
    {
      "t": "ਗੀਧ ਸਿਵਾ ਫਿਕਰਹਿ ਅਭਿਮਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਤ ਪ੍ਰੇਤ ਨਾਚਹਿ ਅਰੁ ਗਾਵਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਰੁਦ੍ਰ ਡਮਰੂ ਡਮਕਾਵਹਿ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਅਚਿ ਅਚਿ ਰੁਧਰ ਡਾਕਨੀ ਡਹਕਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਭਖਿ ਭਖਿ ਅਮਿਖ ਕਾਕ ਕਹੂੰ ਕਹਕਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਜੰਬੁਕ ਗੀਧ ਮਾਸੁ ਲੈ ਜਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਕਛੁ ਕਛੁ ਸਬਦ ਬਿਤਾਲ ਸੁਨਾਹੀ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਝਮਕੈ ਕਹੂੰ ਅਸਿਨ ਕੀ ਧਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਭਭਕਹਿ ਰੁੰਡ ਮੁੰਡ ਬਿਕਰਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਧੁਕਿ ਧੁਕਿ ਪਰੇ ਧਰਨਿ ਭਟ ਭਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਝੁਕਿ ਝੁਕਿ ਬਡੇ ਪਖਰਿਯਾ ਮਾਰੇ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਠਿਲਾ ਠਿਲੀ ਬਰਛਨਿ ਸੌ ਮਾਚੀ ॥",
      "s": 14
    },
    {
      "t": "ਕਢਾ ਕਢੀ ਕਰਵਾਰਿਨ ਰਾਚੀ ॥",
      "s": 14
    },
    {
      "t": "ਕਟਾ ਕਟੀ ਕਹੂੰ ਭਈ ਕਟਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਧਰਨੀ ਅਰੁਨ ਭੇਸ ਭਈ ਸਾਰੀ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਕਾਢੇ ਦੈਤ ਦਾਤ ਕਹੂੰ ਫਿਰੈਂ ॥",
      "s": 14
    },
    {
      "t": "ਬਰਿ ਬਰਿ ਕਹੂੰ ਬਰੰਗਨ ਬਰੈਂ ॥",
      "s": 14
    },
    {
      "t": "ਭੀਖਨ ਭਏ ਨਾਦ ਕਹੂੰ ਭਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਭੈਰਵਾਦਿ ਛਬਿ ਲਖਨ ਸਿਧਾਰੇ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਭਕਭਕਾਹਿ ਘਾਯਲ ਕਹੂੰ ਕਹਕੈ ਅਮਿਤ ਮਸਾਨ ॥",
      "v": [
        [
          2,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਬਿਕਟਿ ਸੁਭਟ ਚਟਪਟ ਕਟੇ ਤਨ ਬ੍ਰਿਨ ਬਹੈ ਕ੍ਰਿਪਾਨ ॥੧੨॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਭੈਰਵ ਕਹੂੰ ਅਧਿਕ ਭਵਕਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਮਸਾਨ ਕਿਲਕਟੀ ਮਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਭਾ ਭਾ ਬਜੇ ਭੇਰ ਕਹੂੰ ਭੀਖਨ ॥",
      "s": 14
    },
    {
      "t": "ਤਨਿ ਧਨੁ ਤਜਹਿ ਸੁਭਟ ਸਰ ਤੀਖਨ ॥੧੩॥",
      "s": 14
    }
  ]
}
