  "lines": [
    {
      "t": "ਇਹੈ ਆਪਨੇ ਚਿਤ ਬਿਚਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਕੌ ਭਲੀ ਭਾਤਿ ਗਹਿ ਤੋਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਬ੍ਰਾਹਮਨੀ ਹਮ ਨ ਕਛੁ ਛੋਰੋ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਸਹਿਚਰੀ ਤਹਾ ਪਠਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਰੁਨਿ ਕੁਅਰਿ ਤਨ ਬਾਤ ਜਤਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਆਜੁ ਨ੍ਰਿਪਤਿ ਕੇ ਸਦਨ ਸਿਧਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਲਪਟਿ ਲਪਟਿ ਤਿਹ ਸੰਗ ਬਿਹਾਰੋ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਤਰੁਨਿ ਕੁਅਰਿ ਮਨ ਮੈ ਯੌ ਕਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਹਮਰੀ ਬਾਤ ਧਰਮ ਕੀ ਰਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਹਾ ਭਾਖੌ ਤੌ ਧਰਮ ਗਵਾਊਾਂ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਨਾਹਿ ਕਰੇ ਬਾਧੀ ਘਰ ਜਾਊਾਂ ॥੫॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਜਤਨ ਐਸ ਕਛੁ ਕਰਿਯੈ ॥",
      "s": 14
    },
    {
      "t": "ਧਰਮ ਰਾਖਿ ਮੂਰਖ ਕਹ ਮਰਿਯੈ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਹਿ ਨਾਮ ਪਾਪੀ ਸੁਨਿ ਲੈਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਖਾਟਿ ਉਠਾਇ ਮੰਗਾਇ ਪਠੈਹੈ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤਿਨ ਕਹਿਯੋ ਬਚਨ ਸਹਚਰਿ ਸੁਨਿ ॥",
      "s": 14
    },
    {
      "t": "ਪੂਜਨ ਕਾਲਿ ਜਾਊਗੀ ਮੈ ਮੁਨਿ ॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਹੀ ਆਪ ਨ੍ਰਿਪਤਿ ਤੁਮ ਐਯਹੁ ॥",
      "v": [
        [
          3,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਮੁਹਿ ਸਾਥ ਕਮੈਯਹੁ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਭੋਰ ਭਯੋ ਪੂਜਨ ਸਿਵ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪਹੂੰ ਤਹਾ ਬੁਲਾਵਤ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਉਤੈ ਦੁਸਮਨਨ ਦੂਤ ਪਠਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੰਭਹਿ ਮ੍ਰਿਤੁ ਸ੍ਵਾਨ ਕੀ ਘਾਯੋ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਹੀ ਫੌਜ ਸਤ੍ਰੁ ਕੀ ਧਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਬਲਾ ਸਹਿਤ ਨ੍ਰਿਪਤਿ ਗਹਿ ਲਈ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਿ ਰੂਪ ਤਾ ਕੋ ਲਲਚਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭੋਗ ਕਰਨ ਤਾ ਸੌ ਚਿਤ ਭਾਯੋ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਰੁਨ ਕਲਾ ਤਰੁਨੀ ਤਬੈ ਅਧਿਕ ਕਟਾਛ ਦਿਖਾਇ ॥",
