      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਆਗਮਨ ਜਹਾ ਸੁਨਿ ਲਈ ॥",
      "s": 14
    },
    {
      "t": "ਅੰਗ ਅੰਗ ਸੁਭ ਸਜੇ ਸਿੰਗਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁ ਨਿਸਪਤਿ ਸੌਭਿਤ ਜੁਤ ਤਾਰਾ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਸੀਸ ਫੂਲ ਸਿਰ ਪਰ ਤ੍ਰਿਯ ਝਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਰਨ ਫੂਲ ਦੁਹੂੰ ਕਰਨ ਸੁ ਧਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਮੋਤਿਨ ਕੀ ਮਾਲਾ ਕੋ ਧਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਮੋਤਿਨ ਹੀ ਸੋ ਮਾਗਹਿ ਭਰਾ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਭੂਖਨ ਮੋਤਿਨ ਕੇ ਧਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਨ ਮਹਿ ਬਜ੍ਰ ਲਾਲ ਗੁਹਿ ਡਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਨੀਲ ਹਰਿਤ ਮਨਿ ਪ੍ਰੋਈ ਭਲੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁ ਤੇ ਹਸਿ ਉਡਗਨ ਕਹ ਚਲੀ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਰਾਜੈ ਵਾ ਤ੍ਰਿਯ ਕੋ ਲਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਨ ਮਹਿ ਅਧਿਕ ਚਕ੍ਰਿਤ ਹ੍ਵੈ ਰਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਵ ਅਦੇਵ ਜਛ ਗੰਧ੍ਰਬਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਨਰੀ ਨਾਗਨੀ ਸੁਰੀ ਪਰੀਜਾ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਚਿਤ੍ਰਯੋ ਇਹ ਪੂਛੀਯੈ ਕ੍ਯੋ ਆਈ ਇਹ ਦੇਸ ॥",
      "s": 14
    },
    {
