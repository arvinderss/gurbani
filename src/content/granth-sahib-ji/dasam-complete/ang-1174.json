  "lines": [
    {
      "t": "ਰਾਜ ਸਾਜ ਸਭ ਤ੍ਯਾਗਿ ਕਰਿ ਭੇਖ ਅਤਿਥ ਬਨਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਤਵਨਿ ਝਰੋਖਾ ਕੇ ਤਰੇ ਬੈਠਿਯੋ ਧੂੰਆ ਲਾਇ ॥੨੨॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਸੁਤਾ ਭਿਛਾ ਲੈ ਆਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕਹ ਅਪਨੇ ਹਾਥ ਜਿਵਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਸਿ ਕਹ ਲੋਗ ਜਬੈ ਸ੍ਵੈ ਜਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਲਪਟਿ ਲਪਟਿ ਦੋਊ ਭੋਗ ਕਮਾਹੀ ॥੨੩॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਕੁਅਰਿ ਅਧਿਕ ਸੁਖ ਲੀਏ ॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਹੀ ਲੋਗ ਬਿਸ੍ਵਾਸਿਤ ਕੀਏ ॥",
      "s": 14
    },
    {
      "t": "ਅਤਿਥ ਲੋਗ ਕਹਿ ਤਾਹਿ ਬਖਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜਾ ਕਰਿ ਕੋਊ ਨ ਪਛਾਨੈ ॥੨੪॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਦਿਨ ਕੁਅਰਿ ਪਿਤਾ ਪਹਿ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਚਨ ਕਠੋਰ ਬਖਾਨਤ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਕੋਪ ਬਹੁਤ ਰਾਜਾ ਤਬ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਨ ਬਾਸਾ ਦੁਹਿਤਾ ਕਹ ਦਯੋ ॥੨੫॥",
      "s": 14
    },
    {
      "t": "ਸੁਨ ਬਨਬਾਸ ਪ੍ਰਗਟਿ ਅਤਿ ਰੋਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਚਿਤ ਕੇ ਬਿਖੈ ਸਕਲ ਦੁਖ ਖੋਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਸਿਧਿ ਕਾਜ ਮੋਰਾ ਪ੍ਰਭੁ ਕੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਤ ਹਮੈ ਬਨ ਬਾਸਾ ਦੀਨਾ ॥੨੬॥",
      "s": 14
    },
    {
      "t": "ਸਿਵਕਨ ਸੰਗ ਇਮਿ ਰਾਜ ਉਚਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਏਹ ਕੰਨ੍ਯਾ ਕਹ ਬੇਗਿ ਨਿਕਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਹ ਬਨ ਹੋਇ ਘੋਰ ਬਿਕਰਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਇਹ ਛਡ ਆਵਹੁ ਤਤਕਾਲਾ ॥੨੭॥",
      "s": 14
    },
    {
      "t": "ਲੈ ਸੇਵਕ ਤਿਤ ਸੰਗ ਸਿਧਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੋ ਬਨ ਭੀਤਰ ਤਜਿ ਆਏ ॥",
      "s": 14
    },
    {
      "t": "ਵਹ ਰਾਜਾ ਆਵਤ ਤਹ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਹੀ ਤਵਨਿ ਤੇ ਆਸਨ ਲਯੋ ॥੨੮॥",
      "s": 14
    },
    {
      "t": "ਦ੍ਰਿੜ ਰਤਿ ਪ੍ਰਥਮ ਤਵਨ ਸੌ ਕਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਕੈ ਭੋਗਨ ਭਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਹੈ ਆਰੂੜਤ ਪੁਨਿ ਤਿਹ ਕੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਨਗਰ ਅਪਨ ਕੋ ਮਾਰਗ ਲੀਨਾ ॥੨੯॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਸਤਾਵਨ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੫੭॥੪੮੫੬॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਹੰਸਾ ਧੁਜ ਰਾਜਾ ਇਕ ਸੁਨਿਯਤ ॥",
      "s": 14
    },
    {
      "t": "ਬਲ ਪ੍ਰਤਾਪ ਜਿਹ ਅਤਿ ਜਗ ਗੁਨਿਯਤ ॥",
      "s": 14
    },
    {
      "t": "ਕੇਸੋਤਮਾ ਧਾਮ ਤਿਹ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਸਮ ਸੁਨੀ ਨ ਨੈਨ ਨਿਹਾਰੀ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਹੰਸ ਮਤੀ ਤਿਹ ਗ੍ਰਿਹ ਦੁਹਿਤਾ ਇਕ ॥",
      "s": 14
    },
    {
      "t": "ਪੜੀ ਬ੍ਯਾਕਰਨ ਕੋਕ ਸਾਸਤ੍ਰਨਿਕ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਸਮ ਅਵਰ ਨ ਕੋਊ ਜਗ ਮੈ ॥",
      "s": 14
    },
    {
      "t": "ਥਕਿਤ ਰਹਿਤ ਨਿਰਖਤ ਰਵਿ ਮਗ ਮੈ ॥੨॥",
      "s": 14
    },
