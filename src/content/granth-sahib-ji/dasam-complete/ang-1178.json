{
  "page": 1178,
  "lines": [
    {
      "t": "ਉਦਿਤ ਦੋਊ ਆਹਵ ਕਹ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਢਿ ਕ੍ਰਿਪਾਨ ਕੋਪ ਤਨ ਤਏ ॥",
      "s": 14
    },
    {
      "t": "ਅਸਿ ਲੈ ਪਿਤੁ ਸੁਤ ਕੇ ਸਿਰ ਝਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਪੂਤ ਕਾਢਿ ਪਿਤੁ ਸੀਸ ਪ੍ਰਹਾਰਾ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਮੈ ਠਾਢੀ ਇਹ ਚਰਿਤ ਨਿਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਫੂਟਿ ਨ ਗਏ ਨੈਨ ਕਰਤਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਦਾਵ ਬਚਾਇ ਨ ਇਨ ਤੇ ਅਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਕਾਲ ਦੁਹੂੰਨ ਕੇ ਭਯੋ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਹੌ ਦੈਵ ਕਹੌ ਕਾ ਕਰੌਂ ॥",
      "s": 14
    },
    {
      "t": "ਉਰ ਮਹਿ ਮਾਰਿ ਕਟਾਰੀ ਮਰੌਂ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਨ ਪ੍ਰਸਥ ਹ੍ਵੈ ਬਨਹਿ ਸਿਧੈ ਹੌਂ ॥",
      "s": 14
    },
    {
      "t": "ਲਹੁ ਸੁਤ ਕੇ ਸਿਰ ਛਤ੍ਰ ਢੁਰੈ ਹੌਂ ॥੧੬॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਥਮ ਪੂਤ ਪਤਿ ਕੋ ਬਧ ਕੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਰਾਜ ਲਹੁ ਸੁਤ ਕਹ ਦੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰੌ ਭੇਖ ਅਤਿਥ ਕੋ ਧਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਪੰਥ ਉਤਰਾ ਓਰ ਸਿਧਾਰੀ ॥੧੭॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਹਾ ਜਾਇ ਤਪਸਾ ਕਰੀ ਸਿਵ ਕੀ ਬਿਬਿਧ ਪ੍ਰਕਾਰ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਭੂਤ ਰਾਟ ਰੀਝਤ ਭਏ ਨਿਰਖਿ ਨਿਠੁਰਤਾ ਨਾਰਿ ॥੧੮॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਰੰਬ੍ਰਯੂਹ ਪੁਤ੍ਰੀ ਹੈ ਕਹਾ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਜੋ ਤਵ ਬ੍ਯਾਪਿ ਹ੍ਰਿਦੈ ਮਹਿ ਰਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਹੁ ਤ ਪਿਤਾ ਇਹੈ ਬਰ ਪਾਊ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਰਧਾ ਤੇ ਤਰੁਨੀ ਹ੍ਵੈ ਜਾਊ ॥੧੯॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਰਧਾ ਤੇ ਤਰੁਨੀ ਭਈ ਬਰੁ ਦੀਨਾ ਤ੍ਰਿਪਰਾਰਿ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤੁਚਾ ਪੁਰਾਤਨ ਛਾਡਿ ਕਰਿ ਜ੍ਯੋ ਅਹਿ ਕੁੰਚੁਰ ਡਾਰਿ ॥੨੦॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਰਧਾ ਤੇ ਤਰੁਨੀ ਜਬ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਚਲਿ ਤਿਸੀ ਨਗਰ ਕਹ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਹ ਖੇਲਤ ਸੁਤ ਚੜਾ ਸਿਕਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਰੇ ਰੀਛ ਰੋਝ ਝੰਖਾਰਾ ॥੨੧॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਮ੍ਰਿਗੀ ਕਾ ਭੇਸ ਧਰਾ ਤਬ ॥",
      "s": 14
    },
    {
      "t": "ਤਨ ਕੇ ਬਸਤ੍ਰ ਛੋਡ ਸੁੰਦਰ ਸਬ ॥",
      "s": 14
    },
    {
      "t": "ਖੇਲਤ ਹੁਤੋ ਅਖਿਟ ਸੁਤ ਜਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਹਰਨੀ ਹ੍ਵੈ ਨਿਕਸਤ ਭੀ ਤਹਾ ॥੨੨॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਪਾਛੇ ਤਿਹ ਸੁਤ ਹੈ ਡਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੰਗੀ ਕਿਸੂ ਨ ਓਰ ਨਿਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਏਕਲ ਜਾਤ ਦੂਰਿ ਭਯੋ ਤਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਥੋ ਬਨ ਘੋਰ ਭਯਾਨਕ ਜਹਾ ॥੨੩॥",
      "s": 14
    },
    {
      "t": "ਸਾਲ ਤਮਾਲ ਜਹਾ ਦ੍ਰੁਮ ਭਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਨਿੰਬੂ ਕਦਮ ਸੁ ਬਟ ਜਟਿਯਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਸੀਬਰ ਤਾਰ ਖਜੂਰੇ ਭਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਜ ਹਾਥਨ ਜਨੁ ਈਸ ਸੁਧਾਰੀ ॥੨੪॥",
      "s": 14
    },
    {
      "t": "ਮ੍ਰਿਗੀ ਜਾਇ ਤਹ ਗਈ ਭੁਲਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਉਤਮਾਗਨਾ ਭੇਸ ਬਨਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਆਨਿ ਅਪਨ ਤਿਹ ਰੂਪ ਦਿਖਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਕੁਅਰ ਮੋਹਿਤ ਕਰਿ ਡਾਰਾ ॥੨੫॥",
      "s": 14
    }
  ]
}
