        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਮਰੇ ਪਗ ਪਰਸਨ ਕੇ ਕਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਕਾਰਨ ਆਯੋ ਇਹ ਰਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਨ ਹਨੋ ਇਹ ਬਹੁ ਧਨ ਦੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਚਰਨ ਲਗਾ ਪਤਿ ਬਿਦਾ ਕਰੀਜੈ ॥੧੭॥",
