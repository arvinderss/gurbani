    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਚਾਰਿ ਭ੍ਰਾਤ ਤਾ ਕੇ ਬਲਵਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੂਰਬੀਰ ਸਭ ਸਸਤ੍ਰ ਨਿਧਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਤੇਜਵਾਨ ਦੁਤਿਮਾਨ ਅਤੁਲ ਬਲ ॥",
      "s": 14
    },
    {
      "t": "ਅਰਿ ਅਨੇਕ ਜੀਤੇ ਜਿਹ ਦਲਿ ਮਲਿ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਸਾਰਦੂਲ ਧੁਜ ਨਾਹਰ ਧੁਜ ਭਨ ॥",
      "s": 14
    },
    {
      "t": "ਸਿੰਘ ਕੇਤੁ ਹਰਿ ਕੇਤੁ ਮਹਾ ਮਨ ॥",
      "s": 14
    },
    {
      "t": "ਚਾਰੌ ਸੂਰਬੀਰ ਬਲਵਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਨਤ ਸਤ੍ਰੁ ਸਕਲ ਜਿਹ ਆਨਾ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਚਾਰੌ ਕੁਅਰਿ ਪੜਨ ਕੇ ਕਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਦਿਜ ਇਕ ਬੋਲਿ ਪਠਾਯੋ ਰਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਖ੍ਰਯਾਦਿਕ ਬ੍ਯਾਕਰਨ ਪੜੇ ਜਿਨ ॥",
      "s": 14
    },
    {
      "t": "ਔਗਾਹਨ ਸਭ ਕਿਯ ਪੁਰਾਨ ਤਿਨ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਦਰਬ ਨ੍ਰਿਪ ਬਰ ਤਿਹ ਦੀਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਬਿਧ ਬਿਧਨ ਕਰਿ ਆਦਰ ਕੀਯਾ ॥",
