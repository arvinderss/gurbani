{
  "page": 1209,
  "lines": [
    {
      "t": "ਆਪੁ ਭਾਜ ਪੁਨਿ ਤਹ ਤੇ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤੇਜ ਭਏ ਤ੍ਰਿਯ ਕੋ ਤਨ ਤਯੋ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਲਿਖਿ ਪਤਿਯਾ ਅਸਿ ਤਾਹਿ ਪਠਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਤੋਹਿ ਮਿਤ੍ਰ ਮੁਹਿ ਤਜਾ ਨ ਜਾਈ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਛਿਮਾ ਕਰਹੁ ਇਹ ਭੂਲਿ ਹਮਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਦਾਸੀ ਮੈ ਭਈ ਤਿਹਾਰੀ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਜੌ ਆਗੇ ਫਿਰਿ ਐਸ ਨਿਹਰਿਯਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਮੋਹੂ ਸਹਿਤ ਮਾਰਿ ਤਿਹ ਡਰਿਯਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਭਲਾ ਕਿਯਾ ਤੁਮ ਤਾਹਿ ਸੰਘਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਆਗੇ ਰਾਹ ਮਿਤ੍ਰ ਮੁਹਿ ਡਾਰਾ ॥੮॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਪਤਿਯਾ ਬਾਚਤ ਮੂੜ ਮਤਿ ਫੂਲ ਗਯੋ ਮਨ ਮਾਹਿ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਤਹਾ ਆਵਤ ਭਯੋ ਭੇਦ ਪਛਾਨਿਯੋ ਨਾਹਿ ॥੯॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਥਮ ਮਿਤ੍ਰ ਤਿਹ ਠਾ ਜਬ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਤਿਯ ਮਿਤ੍ਰ ਸੌ ਬਾਧਿ ਜਰਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਨ ਮੇਰੇ ਮਿਤਵਾ ਕਹ ਮਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਵਹੈ ਚਾਹਿਯਤ ਪਕਰਿ ਸੰਘਾਰਿਯੋ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਅਸ ਤ੍ਰਿਯ ਪ੍ਰਥਮ ਭਜਤ ਭੀ ਜਾ ਕੋ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਚਰਿਤ੍ਰ ਪੁਨਿ ਮਾਰਿਯੋ ਤਾ ਕੋ ॥",
      "s": 14
    },
    {
      "t": "ਇਨ ਅਬਲਨ ਕੀ ਰੀਤਿ ਅਪਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਨ ਕੋ ਆਵਤ ਵਾਰ ਨ ਪਾਰਾ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਤਿਹਤਰ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੭੩॥੫੨੯੦॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਅੰਬਸਟ ਕੇ ਦੇਸ ਨ੍ਰਿਪਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਪਦੁਮਿਨਿ ਦੇ ਜਾ ਕੇ ਗ੍ਰਿਹ ਬਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਪ੍ਰਮਾਨ ਤਿਹ ਪ੍ਰਭਾ ਭਨਿਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਕੋ ਕੋ ਪਤਟਰ ਤ੍ਰਿਯ ਦਿਜੈ ॥੧॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤਾ ਕੇ ਏਕ ਦਾਸ ਘਰ ਮਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਸਮ ਸ੍ਯਾਮ ਬਰਨ ਕਹੂੰ ਨਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਮਾਫਿਕ ਸੰਖ੍ਯਾ ਤਿਹ ਰਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਨੁਖ ਜੋਨਿ ਕਵਨ ਤਿਹ ਕਹੈ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਚੇਰੀ ਏਕ ਹੁਤੀ ਤਾ ਸੌ ਰਤਿ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੇ ਹੁਤੀ ਨ ਕਛੁ ਘਟ ਮਹਿ ਮਤਿ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਮਾਫਿਕ ਤਿਨ ਨਾਰਿ ਬੁਲਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਮਨ ਖੋਲਿ ਮਚਾਯੋ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਲਗਿ ਆਇ ਨ੍ਰਿਪਤਿ ਗਯੋ ਤਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਚੇਰੀ ਰਮਤ ਦਾਸਿ ਸੰਗ ਜਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਲਟਪਟਾਇ ਦਾਸੀ ਤਬ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਚਟਪਟ ਜਾਤ ਸਕਲ ਸੁਧਿ ਭਈ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਜਤਨ ਅਵਰ ਕਛੁ ਹਾਥ ਨ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਰਿ ਦਾਸ ਉਲਟੋ ਲਟਕਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਹਰੇ ਹਰੇ ਤਰ ਆਗਿ ਜਰਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਢਤ ਹੈ ਜਨੁ ਕਰਿ ਮਿਮਿਯਾਈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪਤਿ ਮ੍ਰਿਤਕ ਜਬ ਦਾਸ ਨਿਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਦਭੁਦ ਹ੍ਵੈ ਇਹ ਭਾਤਿ ਉਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕ੍ਯੋ ਇਹ ਹਨਿ ਤੈ ਦਿਯ ਲਟਕਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਹ ਕਾਰਨ ਤਰ ਆਗਿ ਜਰਾਈ ॥੬॥",
      "s": 14
    }
  ]
}
