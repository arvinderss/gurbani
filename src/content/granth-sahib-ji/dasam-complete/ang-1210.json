{
  "page": 1210,
  "lines": [
    {
      "t": "ਚੇਰੀ ਬਾਚ ॥",
      "s": 14
    },
    {
      "t": "ਮਿਲ੍ਯੋ ਬੈਦ ਮੁਹਿ ਏਕ ਨ੍ਰਿਪਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕ੍ਰਿਯਾ ਦਈ ਤਿਨ ਮੋਹਿ ਸੁਧਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਮੈ ਇਹ ਕਰੀ ਚਕਿਤਸਾ ਤਾ ਤੇ ॥",
      "s": 14
    },
    {
      "t": "ਲੀਜੈ ਸਕਲ ਬ੍ਰਿਥਾ ਸੁਨਿ ਯਾ ਤੇ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਖਈ ਰੋਗ ਇਹ ਕਹਿਯੋ ਰਾਜ ਮਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਮਾਰਿ ਦਾਸ ਤੂ ਇਹ ਕਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਕਰਿ ਮਿਮਿਯਾਈ ਨ੍ਰਿਪਹਿ ਖਵਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤਿਹ ਦੋਖ ਦੂਰ ਹ੍ਵੈ ਜਾਵੈ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਨਿਮਿਤ ਯਾ ਕੋ ਮੈ ਘਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮਿਮਿਯਾਈ ਕੋ ਬਿਵਤ ਬਨਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜੌ ਤੁਮ ਭਛਨ ਕਰਹੁ ਤੇ ਕੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਤਰ ਛਾਡਿ ਆਜੁ ਹੀ ਦੀਜੈ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਇਹ ਭਾਤਿ ਨ੍ਰਿਪਤਿ ਸੁਨਿ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਬੈਦਨੀ ਕਰਿ ਠਹਰਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮਨ ਮਹਿ ਕਹਿਯੋ ਭਲੀ ਬਿਧਿ ਕੀਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਘਰ ਮਹਿ ਨਾਰਿ ਰੋਗਿਹਾ ਦੀਨੀ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਧੰਨਿ ਧੰਨਿ ਕਹਿ ਤਾਹਿ ਬਖਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਤੇਰੋ ਗੁਨ ਹਮ ਆਜੁ ਪਛਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਪਛਮ ਦਿਸਿ ਹਮ ਸੁਨੀ ਬਨੈਯਤ ॥",
      "s": 14
    },
    {
      "t": "ਹਮਰੇ ਦੇਸ ਨ ਢੂੰਡੀ ਪੈਯਤ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਤੁਹਿ ਜਾਨਤ ਮੁਹਿ ਕਹਤ ਬਤਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਮਿਮਿਆਈ ਇਹ ਦੇਸ ਬਨਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਾ ਭਯੋ ਇਕ ਦਾਸ ਸੰਘਾਰਾ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਹਮਰੋ ਰੋਗ ਬਡੋ ਤੈ ਟਾਰਾ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਚੌਹਤਰ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੭੪॥੫੩੦੨॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਬੰਦਰ ਬਸ ਤਹ ਬਾਸੀ ਜਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਹਬਸੀ ਰਾਇ ਨਰਾਧਿਪ ਤਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਹਬਸ ਮਤੀ ਤਾ ਕੈ ਘਰ ਰਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁ ਪੁਰ ਖੋਜਿ ਚੌਦਹੂੰ ਆਨੀ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਹਾਸਿਮ ਖਾਨ ਪਠਾਨ ਇਕ ਤਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਸਮ ਸੁੰਦਰ ਕੋਊ ਨ ਕਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਤਾਹਿ ਨਿਰਖਿ ਉਰਝਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਰਹ ਬਿਕਲ ਹ੍ਵੈ ਗਈ ਦਿਵਾਨੀ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਜਤਨ ਅਨੇਕ ਬਨਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਛਲ ਬਲ ਸੌ ਗ੍ਰਿਹ ਮਿਤ੍ਰ ਬੁਲਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਤਿਹ ਸੰਗ ਕਮਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਆਸਨ ਚੁੰਬਨ ਕੀਏ ਪ੍ਰਮਾਨਾ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਨਿਕ ਭਾਤਿ ਭਜਿ ਮਿਤ੍ਰ ਕਹ ਗਰੇ ਰਹੀ ਲਪਟਾਇ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਜਾਨੁ ਨਿਰਧਨੀ ਪਾਇ ਧਨ ਰਹਿਯੋ ਹੀਯ ਸੌ ਲਾਇ ॥੪॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਰਾਜਾ ਤਾ ਕੇ ਗ੍ਰਿਹ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਿ ਸੇਜ ਪਰ ਤਾਹਿ ਰਿਸਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਸਿ ਗਹਿ ਧਯੋ ਹਾਥ ਗਹਿ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਸੌ ਹਸਿ ਬਾਤ ਉਚਾਰੀ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਤੈ ਰਾਜਾ ਇਹ ਭੇਦ ਨ ਜਾਨਾ ॥",
      "v": [
        [
