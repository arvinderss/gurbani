{
  "page": 1211,
  "lines": [
    {
      "t": "ਬਿਨੁ ਬੂਝੇ ਅਸਿ ਕੋਪ ਪ੍ਰਮਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਥਮਹਿ ਬਾਤ ਜਾਨਿਯੈ ਯਾ ਕੀ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰੌ ਸੁਧਿ ਲੀਜੈ ਕਛੁ ਤਾ ਕੀ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਹੈ ਮਿਤ੍ਰ ਮਛਿੰਦਰ ਰਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਆਯੋ ਨ੍ਯਾਇ ਲਹਨ ਤਵ ਕਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਪਸ੍ਯਾ ਬਲ ਆਯੋ ਇਹ ਠੌਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਹੈ ਸਭ ਤਪਸਿਨ ਕਾ ਸਿਰਮੌਰਾ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਸੰਗ ਮਿਤ੍ਰਾਚਾਰ ਕਰੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਭੁਗਤਿ ਜੁਗਤਿ ਬਹੁ ਬਿਧਿ ਤਿਹ ਦੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਭਲੀ ਭਲੀ ਤੁਹਿ ਕ੍ਰਿਯਾ ਸਿਖੈਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਜੋਗ ਬੈਠੋ ਗ੍ਰਿਹ ਪੈਹੈ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਏ ਬਚਨ ਸੁਨਤ ਪਗ ਪਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਿਤ੍ਰਾਚਾਰ ਤਵਨ ਸੰਗ ਕਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਮਛਿੰਦ੍ਰਾ ਨਾਥ ਪਛਾਨ੍ਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੂਰਖ ਭੇਵ ਅਭੇਵ ਨ ਜਾਨ੍ਯੋ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਬਹੁ ਬਿਧਿ ਤਨ ਪੂਜਾ ਤਿਹ ਕਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਰੰਬਾਰ ਪਾਇ ਪਸੁ ਪਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਸਹੀ ਰਿਖਿਰਾਜ ਪਛਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਤਿ ਬਚਨ ਤ੍ਰਿਯ ਕੌ ਕਰਿ ਜਾਨਾ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਮਛਿੰਦਰ ਕਰਿ ਠਹਰਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯ ਕਹ ਸੌਪਿ ਤਾਹਿ ਉਠਿ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਵਹ ਤਾ ਸੌ ਨਿਤਿ ਭੋਗ ਕਮਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਮੂਰਖ ਬਾਤ ਨ ਰਾਜਾ ਪਾਵੈ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਸਾਥ ਜਾਰ ਭਜਿ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਤਿ ਬਿਸਮੈ ਰਾਜਾ ਕੌ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਰਾਨੀ ਰਾਜਾ ਢਿਗ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਜੋਰਿ ਹਾਥ ਅਸ ਬਿਨੈ ਸੁਨਾਈ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਜਿਨ ਨ੍ਰਿਪ ਰਾਜ ਆਪਨਾ ਤ੍ਯਾਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਜੋਗ ਕਰਨ ਕੇ ਰਸ ਅਨੁਰਾਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਤੇਰੀ ਪਰਵਾਹਿ ਨ ਰਾਖੈ ॥",
      "s": 14
    },
    {
      "t": "ਇਮਿ ਰਾਨੀ ਰਾਜਾ ਤਨ ਭਾਖੈ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਸਤਿ ਸਤਿ ਤਬ ਰਾਜ ਬਖਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੋ ਦਰਸ ਸਫਲ ਕਰਿ ਮਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਜੜ ਕਛੂ ਨ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯ ਸੰਗ ਚੌਗੁਨ ਨੇਹ ਬਢਾਯੋ ॥੧੪॥੧॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਪਚਹਤਰਿ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੭੫॥੫੩੧੬॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੰਕ੍ਰਾਵਤੀ ਨਗਰ ਇਕ ਰਾਜਤ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁ ਸੰਕਰ ਕੇ ਲੋਕ ਬਿਰਾਜਤ ॥",
      "s": 14
    },
    {
      "t": "ਸੰਕਰ ਸੈਨ ਤਹਾ ਕੋ ਰਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਸਮ ਦੁਤਿਯ ਨ ਬਿਧਨਾ ਸਾਜਾ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਸੰਕਰ ਦੇ ਤਾ ਕੀ ਬਰ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁਕ ਆਪੁ ਜਗਦੀਸ ਸਵਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਰੁਦ੍ਰ ਮਤੀ ਦੁਹਿਤਾ ਤਿਹ ਸੋਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਰ ਨਰ ਨਾਗ ਅਸੁਰ ਮਨ ਮੋਹੈ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਤਹਾ ਛਬੀਲ ਦਾਸ ਥੋ ਛਤ੍ਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਰੂਪਵਾਨ ਛਬਿ ਮਾਨ ਅਤਿ ਅਤ੍ਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਪਰ ਅਟਕ ਕੁਅਰਿ ਕੀ ਭਈ ॥",
      "s": 14
    }
  ]
}
