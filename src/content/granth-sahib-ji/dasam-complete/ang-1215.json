{
  "page": 1215,
  "lines": [
    {
      "t": "ਆਠ ਬਰਸਿ ਹਮ ਸੌ ਤੁਮ ਸੋਵੌ ॥",
      "s": 14
    },
    {
      "t": "ਰੈਨਿ ਦਿਵਸ ਮੋਰੇ ਗ੍ਰਿਹ ਖੋਵੌ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਪਟੀ ਬਾਧਿ ਦ੍ਰਿਗਨ ਦੁਹੂੰ ਸੋਵੌ ॥",
      "s": 14
    },
    {
      "t": "ਆਠ ਬਰਸਿ ਲਗਿ ਜਗਹਿ ਨ ਜੋਵੌ ॥",
      "s": 14
    },
    {
      "t": "ਉਪਜੋ ਪੂਤ ਧਾਮ ਬਿਨ ਸਾਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਕਲ ਖਲਨ ਕੋ ਹ੍ਵੈ ਹੈ ਨਾਸਾ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਕਿਲਬਿਖ ਏਕ ਨ ਤਵ ਤਨ ਰਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਮੁਹਿ ਸਿਵ ਸੁਪਨ ਬਿਖੈ ਇਮਿ ਕਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਅਪ੍ਰਮਾਨ ਧਨ ਭਰੇ ਭੰਡਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਕਲ ਕਾਜ ਸਭ ਹੋਇ ਤਿਹਾਰਾ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਰਾਜੈ ਸਤਿ ਇਹੀ ਦ੍ਰਿੜ ਕੀਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਪਟੀ ਬਾਧਿ ਦੁਹੂੰ ਦ੍ਰਿਗ ਲੀਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਆਠ ਬਰਸ ਰਾਨੀ ਸੰਗ ਸੋਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਚਿਤ ਜੁ ਹੁਤੋ ਸਕਲ ਦੁਖੁ ਖੋਯੋ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਆਖੈ ਬਾਧਿ ਤਹਾ ਨ੍ਰਿਪ ਸੋਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਆਵਤ ਜਾਤ ਨ ਕਾਹੂ ਜੋਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਉਤ ਰਾਨੀ ਕਹ ਜੋ ਨਰ ਭਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਤੁਰਤ ਗ੍ਰਿਹ ਬੋਲਿ ਪਠਾਵੈ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਬਹੁ ਬਿਧਿ ਕਰੈ ਕੇਲ ਸੰਗ ਤਾ ਕੇ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਨਰ ਰੁਚੈ ਚਿਤ ਤ੍ਰਿਯ ਵਾ ਕੇ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਤ ਕਰਤ ਪਤਿ ਸੋ ਇਤ ਜਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਉਤੈ ਜਾਰ ਤਰ ਪਰੀ ਠੁਕਾਵੈ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਤ੍ਰਿਯ ਚਹੈ ਵਹੈ ਤਹ ਆਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਖੈਚਿ ਤਰੁਨਿ ਤਰੁ ਐਚਿ ਬਜਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁ ਨਰ ਜਾ ਸੌ ਭੋਗ ਕਮਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਏਕੋ ਪੂਤ ਹੋਇ ਗ੍ਰਿਹ ਨਾਹੀ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਕਿਤਕ ਦਿਨਨ ਮਹਿ ਸੁਤ ਇਕ ਜਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਕੋ ਸਾਚ ਹਿਯੇ ਮਹਿ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਆਗੈ ਜੋ ਤ੍ਰਿਯ ਕਹੈ ਸੁ ਮਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਨ ਮੂੜ ਪਛਾਨੈ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਉਨਾਸੀ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੭੯॥੫੩੬੬॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਸਨ ਚੰਦ ਇਕ ਨ੍ਰਿਪਤ ਫਿਰੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੇ ਦਿਪਤ ਅਧਿਕ ਛਬਿ ਅੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਜੁਗਰਾਜ ਮੰਜਰੀ ਰਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੁੰਦਰਿ ਭਵਨ ਚਤੁਰਦਸ ਜਾਨੀ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਸੁਕ੍ਰਿਤ ਨਾਥ ਜੋਗੀ ਇਕ ਤਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਜੁਗਰਾਜ ਮਤੀ ਤ੍ਰਿਯ ਜਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਜੋਗੀ ਦ੍ਰਿਸਟਿ ਜਬੈ ਤਿਹ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਦਨ ਚੰਚਲੈ ਬੋਲਿ ਪਠਾਯੋ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਤਾ ਸੋ ਕਿਯੋ ਹ੍ਰਿਦੈ ਹਰਖ ਉਪਜਾਇ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਪਕਰਿ ਭੁਜਨ ਆਸਨ ਤਰੇ ਜਾਤ ਭਈ ਲਪਟਾਇ ॥੩॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁ ਬਿਧਿ ਭੋਗ ਤਾਹਿ ਤਿਨ ਕੀਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਮੋਹਿ ਹ੍ਰਿਦੈ ਰਾਨੀ ਕੋ ਲੀਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯ ਤਾ ਸੌ ਅਤਿ ਹਿਤ ਉਪਜਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜਾ ਕਹ ਚਿਤ ਤੇ ਬਿਸਰਾਯੋ ॥੪॥",
      "s": 14
    }
  ]
