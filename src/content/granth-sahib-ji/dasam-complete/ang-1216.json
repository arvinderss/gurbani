{
  "page": 1216,
  "lines": [
    {
      "t": "ਤ੍ਰਿਯ ਐਸੀ ਬਿਧਿ ਚਿਤਹਿ ਬਿਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਰਾਜਾ ਕਹ ਚਹਿਯਤ ਮਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਲੈ ਤਿਹ ਰਾਜ ਜੋਗਿਯਹਿ ਦੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਛੂ ਚਰਿਤ੍ਰ ਐਸਿ ਬਿਧਿ ਕੀਜੈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਸੋਵਤ ਸਮੈ ਨ੍ਰਿਪਤਿ ਕਹ ਮਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਗਾਡਿ ਤਾਹਿ ਇਹ ਭਾਤਿ ਉਚਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜੈ ਰਾਜ ਜੋਗਿਯਹਿ ਦੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਆਪਨ ਭੇਸ ਜੋਗ ਕੋ ਲੀਨਾ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਜੋਗ ਭੇਸ ਧਾਰਤ ਨ੍ਰਿਪ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਦੈ ਇਹ ਰਾਜ ਬਨਹਿ ਉਠ ਗਏ ॥",
      "s": 14
    },
    {
      "t": "ਹਮਹੂੰ ਰਾਜ ਜੋਗਿਯਹਿ ਦੈ ਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਥ ਗਏ ਜਿਤ ਤਹੀ ਸਿਧੈ ਹੈ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਸਤਿ ਸਤਿ ਸਭ ਪ੍ਰਜਾ ਬਖਾਨਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਨ੍ਰਿਪ ਕਹਿਯੋ ਵਹੈ ਹਮ ਮਾਨਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਭਹਿਨ ਰਾਜ ਜੋਗਯਹਿ ਦੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਮੂੜ ਨਹਿ ਚੀਨਾ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਰਿ ਨ੍ਰਿਪਤਿ ਕਹ ਚੰਚਲੈ ਕਿਯੋ ਆਪਨੇ ਕਾਜ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸਕਲ ਪ੍ਰਜਾ ਡਾਰੀ ਪਗਨ ਦੈ ਜੋਗੀ ਕਹ ਰਾਜ ॥੯॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਰਾਜ ਜੋਗਿਯਹਿ ਦੀਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਸੌ ਪਤਿ ਕੋ ਬਧ ਕੀਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਮੂਰਖ ਅਬ ਲਗ ਭੇਦ ਨ ਪਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਤਕ ਆਇ ਸੁ ਰਾਜ ਕਮਾਵੈ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਅਸੀ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੮੦॥੫੩੭੬॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਜੈ ਨਗਰ ਇਕ ਰਾਇ ਬਖਨਿਯਤ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੋ ਤ੍ਰਾਸ ਦੇਸ ਸਭ ਮਨਿਯਤ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਜੈ ਸੈਨ ਜਿਹ ਨਾਮ ਨ੍ਰਿਪਤਿ ਬਰ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਜੈ ਮਤੀ ਰਾਨੀ ਜਿਹ ਕੇ ਘਰ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਅਜੈ ਮਤੀ ਦੂਸਰਿ ਤਿਹ ਰਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੇ ਕਰ ਨ੍ਰਿਪ ਦੇਹਿ ਬਿਕਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਜੈ ਮਤੀ ਕੇ ਸੁਤ ਇਕ ਧਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਸੁਲਤਾਨ ਸੈਨ ਤਿਹ ਨਾਮਾ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਬਿਜੈ ਮਤੀ ਕੋ ਰੂਪ ਅਪਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਸੰਗ ਨਹੀ ਨ੍ਰਿਪਤਿ ਕੋ ਪ੍ਯਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਜੈ ਮਤੀ ਕੀ ਸੁੰਦਰਿ ਕਾਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਨ ਰਾਜਾ ਕੋ ਚਿਤ ਲੁਭਾਯਾ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੇ ਰਹਤ ਰੈਨਿ ਦਿਨ ਪਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜੈਸੀ ਭਾਤਿ ਗੋਰ ਮਹਿ ਮਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਤਿਯ ਨਾਰਿ ਕੇ ਧਾਮ ਨ ਜਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਤਰੁਨਿ ਅਧਿਕ ਕੁਰਰਾਵੈ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਆਗ੍ਯਾ ਚਲਤ ਤਵਨ ਕੀ ਦੇਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਭਈ ਨ੍ਰਿਪਤਿ ਕੇ ਭੇਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਯਹਿ ਰਿਸਿ ਨਾਰਿ ਦੁਤਿਯ ਜਿਯ ਰਾਖੀ ॥",
      "s": 14
    },
    {
      "t": "ਬੋਲਿਕ ਬੈਦ ਪ੍ਰਗਟ ਅਸਿ ਭਾਖੀ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਰਾਜਾ ਕਹ ਜੁ ਤੈ ਖਪਾਵੈਂ ॥",
      "s": 14
    },
    {
      "t": "ਮੁਖ ਮਾਗੈ ਮੋ ਤੇ ਸੋ ਪਾਵੈਂ ॥",
      "s": 14
    }
  ]
}
