{
  "page": 1217,
  "lines": [
    {
      "t": "ਤਬ ਚਲਿ ਬੈਦ ਨ੍ਰਿਪਤਿ ਪਹਿ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰੋਗੀ ਬਪੁ ਤਿਹ ਕੋ ਠਹਰਯੋ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਤੁਮ ਕਹੋ ਤੁ ਕਰੋ ਉਪਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜ੍ਯੋਂ ਤ੍ਯੋਂ ਕਹਿ ਤਿਹ ਬਰੀ ਖਵਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਰੋਗੀ ਭਯੋ ਅਰੋਗੀ ਤਨ ਸੌ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਨ ਪਾਵਤ ਜੜ ਸੌ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਭਛਤ ਬਰੀ ਪੇਟ ਤਿਹ ਛੂਟਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਵਨ ਜਾਨ ਪਨਾਰਾ ਫੂਟਾ ॥",
      "s": 14
    },
    {
      "t": "ਦੂਸਰਿ ਬਰੀ ਥੰਭ ਕੇ ਕਾਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਜੋਰਾਵਰੀ ਖਵਾਈ ਰਾਜੈ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਅਧਿਕ ਪੇਟ ਛੁਟਿ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਤੇ ਬਹੁ ਬਿਹਬਲ ਨ੍ਰਿਪ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੰਨ ਭਯੋ ਇਹ ਬੈਦ ਉਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧ ਕਿਯ ਉਪਚਾਰ ਬਿਚਾਰਾ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਦਸ ਤੋਲੇ ਅਹਿਫੇਨ ਮੰਗਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁ ਬਿਖਿ ਵਾ ਕੇ ਸੰਗ ਮਿਲਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਧੂਰਾ ਕੀਯਾ ਤਵਨ ਕੇ ਅੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਚਾਮ ਗਯੋ ਤਾ ਕੇ ਤਿਹ ਸੰਗਾ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਹਾਇ ਹਾਇ ਰਾਜਾ ਜਬ ਕਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਮਿ ਤਿਮਿ ਬੈਦ ਇਹ ਭਾਤਿ ਉਚਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਕਹੁ ਅਧਿਕ ਨ ਬੋਲਨ ਦੇਹੂ ॥",
      "s": 14
    },
    {
      "t": "ਮੂੰਦਿ ਬਦਨ ਰਾਜਾ ਕੋ ਲੇਹੂ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਜਿਮਿ ਜਿਮਿ ਧੂਰੋ ਤਿਹ ਤਨ ਪਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਹਾਇ ਹਾਇ ਤਿਮ ਨ੍ਰਿਪਤਿ ਉਚਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਨ ਕਿਨਹੂੰ ਚੀਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਪ੍ਰਾਨ ਤਵਨ ਕੋ ਲੀਨੋ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਸਾਥ ਨ੍ਰਿਪਤਿ ਕਹ ਮਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਪਨੇ ਛਤ੍ਰ ਪੁਤ੍ਰ ਸਿਰ ਢਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਸੌਅਨ ਕਹ ਦੇਤ ਨਿਕਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਨ ਕਿਨੂ ਬਿਚਾਰਿਯੋ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਇਕਾਸੀ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੮੧॥੫੩੮੯॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਮੀ ਕਰਨ ਇਕ ਸੁਨਾ ਨ੍ਰਿਪਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਮਰ ਕਲਾ ਜਾ ਕੇ ਗ੍ਰਿਹ ਬਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਗੜ ਸਿਰਾਜ ਕੋ ਰਾਜ ਕਮਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੀਰਾਜੀ ਜਗ ਨਾਮ ਕਹਾਵੈ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਅਸੁਰ ਕਲਾ ਦੂਸਰਿ ਤਾ ਕੀ ਤ੍ਰਿਯ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਸਿ ਦਿਨ ਰਹਤ ਨ੍ਰਿਪਤਿ ਜਾ ਮੈ ਜਿਯ ॥",
      "s": 14
    },
    {
      "t": "ਅਮਰ ਕਲਾ ਜਿਯ ਮਾਝ ਰਿਸਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਅਸੁਰ ਕਲਹਿ ਪਿਯ ਰੋਜ ਬੁਲਾਵੈ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਬਨਿਕ ਕੌ ਲਯੋ ਬੁਲਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਮਦਨ ਕ੍ਰੀੜ ਤਿਹ ਸਾਥ ਕਮਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਨਦ ਕੁਅਰ ਤਿਹ ਨਰ ਕੋ ਨਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੌ ਭਜਾ ਨ੍ਰਿਪਤਿ ਕੀ ਬਾਮਾ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਅਸੁਰ ਕਲਾ ਕੌ ਨਿਜੁ ਕਰ ਘਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮਰੀ ਨਾਰਿ ਤਵ ਪਤਿਹਿ ਸੁਨਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਰ ਤਖਤਾ ਕੇ ਮਿਤ੍ਰਹਿ ਧਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਪਰ ਬਡੋ ਅਡੰਬਰ ਕਰਾ ॥੪॥",
      "s": 14
    }
  ]
}
