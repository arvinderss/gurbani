{
  "page": 1218,
  "lines": [
    {
      "t": "ਤਰ ਤਖਤਾ ਕੇ ਮਿਤ੍ਰ ਦੁਰਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਪਰ ਸਵਤਿ ਲੋਥ ਕਹਿ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਨ ਕਿਨੂੰ ਬਿਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਅਪਨੋ ਯਾਰ ਨਿਕਾਰਾ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਵਤਿ ਸੰਘਾਰੀ ਪਤਿ ਛਲਾ ਮ੍ਰਿਤਹਿ ਲਯੋ ਉਬਾਰਿ ॥",
      "v": [
        [
          1,
          1
        ],
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਭੇਦ ਕਿਸੂ ਪਾਯੋ ਨਹੀ ਧੰਨ ਸੁ ਅਮਰ ਕੁਮਾਰਿ ॥੬॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਬਿਆਸੀ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੮੨॥੫੩੯੫॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਹਿਰ ਪਲਾਊ ਏਕ ਨ੍ਰਿਪਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਧਨਿ ਭਰੇ ਸਕਲ ਭੰਡਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਿੰਨ੍ਰ ਮਤੀ ਤਿਹ ਰਾਜ ਦੁਲਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨੁਕ ਚੰਦ੍ਰ ਲਈ ਉਜਿਯਾਰੀ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਬਿਕ੍ਰਮ ਸਿੰਘ ਸਾਹੁ ਸੁਤ ਇਕ ਤਹ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਸਮ ਸੁੰਦਰ ਦੁਤਿਯ ਨ ਮਹਿ ਮਹ ॥",
      "s": 14
    },
    {
      "t": "ਅਪ੍ਰਮਾਨ ਤਿਹ ਪ੍ਰਭਾ ਬਿਰਾਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਰ ਨਰ ਅਸੁਰ ਨਿਰਖਿ ਮਨ ਲਾਜੈ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਕਿੰਨ੍ਰ ਮਤੀ ਵਾ ਸੌ ਹਿਤ ਕਿਯੌ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਬੋਲਿ ਗ੍ਰਿਹ ਅਪਨੇ ਲਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਤਾ ਸੌ ਦ੍ਰਿੜ ਕਿਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਚਿਤ ਕੋ ਸੋਕ ਦੂਰਿ ਕਰ ਦਿਯਾ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਭੋਗ ਮਿਤ੍ਰ ਕੋ ਰਸਿ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਬਚਨ ਬਖਾਨ੍ਯੋ ਹਸਿ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਮ ਹਮ ਕਹ ਲੈ ਸੰਗ ਸਿਧਾਵਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਪਿਯ ਚਰਿਤ੍ਰ ਕਛੁ ਐਸ ਬਨਾਵਹੁ ॥੪॥",
      "v": [
        [
          0,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਮਿਤ੍ਰ ਕਹਿਯੋ ਮੈ ਕਹੌ ਸੁ ਕਰਿਯਹੁ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਭੇਦ ਪੁਰਖ ਦੂਸਰ ਨ ਉਚਰਿਯਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਰੁਦ੍ਰ ਭਵਨ ਪੂਜਨ ਤੁਮ ਜੈ ਹੌ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਹੀ ਹਿਤੂ ਹਿਤੂ ਕਹ ਪੈ ਹੌ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਪਤਿ ਤਨ ਭਾਖਿ ਦੇਹਰੇ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਤੇ ਜਾਤ ਮਿਤ੍ਰ ਸੰਗ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਨਹੂੰ ਪੁਰਖ ਭੇਦ ਨਹਿ ਜਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਸ ਰਾਜਾ ਤਨ ਬਚਨ ਬਖਾਨਾ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਰੁਦ੍ਰ ਭਵਨ ਜਬ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਿਵ ਜੂ ਬਿਖੈ ਲੀਨ ਸੋ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਸਾਜੁਜ ਮੁਕਤਿ ਕਹ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਨਮ ਮਰਨ ਕੋ ਤਾਪ ਮਿਟਾਯੋ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਸੁਨਿ ਰੁਦ੍ਰ ਭਗਤਿ ਅਨੁਰਾਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਧਨਿ ਧਨਿ ਤ੍ਰਿਯਹਿ ਬਖਾਨਨ ਲਾਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਹਕਰ ਕਰਮ ਕੀਆ ਜਿਨ ਦਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਪਲਿ ਪਲਿ ਪ੍ਰਤਿ ਤਾ ਕੇ ਬਲਿਹਾਰਾ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਤਰਾਸੀ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੮੩॥੫੪੦੩॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਦਛਨਿ ਸੈਨ ਦਛਨੀ ਰਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਦਛਨਿ ਦੇ ਰਾਨੀ ਸਿਰਤਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਸਮ ਔਰ ਨ ਦੂਜੀ ਰਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਦਛਿਨ ਵਤੀ ਬਸਤ ਰਜਧਾਨੀ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਦਛਿਨੀ ਰਾਇ ਏਕ ਤਹ ਚਾਕਰ ॥",
      "s": 14
    }
  ]
