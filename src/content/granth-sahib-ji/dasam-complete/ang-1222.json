  "lines": [
    {
      "t": "ਭਗਨੀ ਦਰਬ ਬਿਲੋਕਿ ਕੈ ਲੋਭ ਸਿੰਧ ਕੈ ਮਾਹਿ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਨਖ ਸਿਖ ਲੌ ਬੂਡਤ ਭਈ ਸੁਧਿ ਨ ਰਹੀ ਜਿਯ ਮਾਹਿ ॥੫॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਭ੍ਰਾਤ ਵਾਤ ਭਗਨੀ ਨ ਬਿਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਫਾਸੀ ਡਾਰਿ ਕੰਠਿ ਮਹਿ ਮਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਲੀਨਾ ਲੂਟਿ ਸਕਲ ਤਿਹ ਧਨ ਕੌ ॥",
      "s": 14
    },
    {
      "t": "ਕਰਿਯੋ ਅਮੋਹ ਆਪਨੇ ਮਨ ਕੌ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਾਤ ਭਏ ਰੋਵਨ ਤਬ ਲਾਗੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਸਭ ਪ੍ਰਜਾ ਗਾਵ ਕੀ ਜਾਗੀ ॥",
      "s": 14
    },
    {
      "t": "ਮ੍ਰਿਤਕ ਬੰਧੁ ਤਬ ਸਭਨ ਦਿਖਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮਰਿਯੋ ਆਜੁ ਇਹ ਸਾਪ ਚਬਾਯੋ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਭਲੀ ਭਾਤ ਤਨ ਤਾਹਿ ਗਡਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਯੌ ਕਾਜੀ ਤਨ ਆਪੁ ਜਤਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਜ ਬਾਜਿ ਇਕ ਯਾ ਕੋ ਘੋਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਔਰ ਜੁ ਕਛੁ ਯਾ ਕੌ ਧਨੁ ਥੋਰੋ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਇਹ ਤ੍ਰਿਯਹਿ ਪਠਾਵਨ ਕੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਫਾਰਖਤੀ ਹਮ ਕੌ ਲਿਖਿ ਦੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਬੁਜ ਲਿਖਾ ਕਾਜੀ ਤੇ ਲਈ ॥",
      "s": 14
    },
    {
      "t": "ਕਛੁ ਧਨ ਮ੍ਰਿਤਕ ਤ੍ਰਿਯਾ ਕਹ ਦਈ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਅਪਨੋ ਭ੍ਰਾਤ ਹਤਿ ਲੀਨੀ ਕਬੁਜਿ ਲਿਖਾਇ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਨਿਸਾ ਕਰੀ ਤਿਹ ਨਾਰਿ ਕੀ ਸਭ ਧਨ ਗਈ ਪਚਾਇ ॥੧੦॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਸਤਾਸੀ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੮੭॥੫੪੫੧॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਯੂਨਾ ਸਹਿਰ ਰੂਮ ਮਹਿ ਜਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਵ ਛਤ੍ਰ ਰਾਜਾ ਇਕ ਤਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਛੈਲ ਦੇਇ ਦੁਹਿਤਾ ਤਾ ਕੇ ਇਕ ॥",
      "s": 14
    },
    {
      "t": "ਪੜੀ ਬ੍ਯਾਕਰਨ ਕੋਕ ਸਾਸਤ੍ਰਨਿਕ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਅਜਿਤ ਸੈਨ ਤਿਹ ਠਾ ਇਕ ਛਤ੍ਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਤੇਜਵਾਨ ਬਲਵਾਨ ਧਰਤ੍ਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਰੂਪਵਾਨ ਬਲਵਾਨ ਅਪਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਪੂਰੋ ਪੁਰਖ ਜਗਤ ਉਜਿਯਾਰਾ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਤੇਜਵਾਨ ਦੁਤਿਵਾਨ ਅਤੁਲ ਬਲ ॥",
      "s": 14
    },
    {
      "t": "ਅਰਿ ਅਨੇਕ ਜੀਤੇ ਜਿਨ ਦਲਿ ਮਲਿ ॥",
      "s": 14
    },
    {
      "t": "ਆਵਤ ਤਾਹਿ ਬਿਲੋਕ੍ਯੋ ਰਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਹਿਤਾ ਸੋ ਇਹ ਭਾਤਿ ਬਖਾਨੀ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਜੌ ਇਹ ਧਾਮ ਨ੍ਰਿਪਤਿ ਕੇ ਹੋਤੋ ॥",
      "s": 14
    },
    {
      "t": "ਤੌ ਤੁਮਰੇ ਲਾਇਕ ਬਰ ਕੋ ਥੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਮੈ ਅਸ ਕਹ ਕਰੌ ਉਪਾਊ ॥",
      "s": 14
    },
    {
      "t": "ਐਸੋ ਬਰ ਤੁਹਿ ਆਨ ਮਿਲਾਊ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਅੜਿਲ ॥",
      "s": 14
    },
    {
      "t": "ਤਨਿਕ ਕੁਅਰਿ ਕੇ ਧੁਨਿ ਜਬ ਅਸਿ ਕਾਨਨ ਪਰੀ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਦੇਖਿ ਰਹੀ ਤਹਿ ਓਰ ਮੈਨ ਅਰੁ ਮਦ ਭਰੀ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਮੋਹਿ ਰਹੀ ਮਨ ਮਾਹਿ ਨ ਪ੍ਰਗਟ ਜਤਾਇਯੋ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਹੋ ਪਲ ਪਲ ਬਲਿ ਬਲਿ ਜਾਤੀ ਦਿਵਸ ਗਵਾਇਯੋ ॥੫॥",
      "v": [
        [
          5,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਰੈਨਿ ਭਏ ਸਹਚਰੀ ਬੁਲਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਚਿਤ ਬ੍ਰਿਥਾ ਤਿਹ ਸਕਲ ਸੁਨਾਈ ॥",
