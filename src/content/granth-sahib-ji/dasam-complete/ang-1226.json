{
  "page": 1226,
  "lines": [
    {
      "t": "ਸੋਈ ਸਤਿ ਨ੍ਰਿਪਤਿ ਕਰਿ ਮਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਬਿਧਿ ਤਾ ਸੌ ਜਾਰ ਬਖਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੇ ਧਾਮ ਬੈਦਨੀ ਰਾਖੀ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਨਰ ਤੇ ਇਸਤ੍ਰੀ ਕਰਿ ਭਾਖੀ ॥੨੩॥",
      "s": 14
    },
    {
      "t": "ਰੈਨਿ ਦਿਵਸ ਤਾ ਕੇ ਸੋ ਰਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਭੋਗ ਕਰੈ ਤਰੁਨੀ ਜਬ ਚਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਮੂਰਖ ਰਾਵ ਭੇਦ ਨਹਿ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਆਠ ਬਰਿਸ ਲਗਿ ਮੂੰਡ ਮੁੰਡਾਯੋ ॥੨੪॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਚਰਿਤ੍ਰ ਤਿਨ ਚੰਚਲਾ ਨ੍ਰਿਪ ਕਹ ਛਲਾ ਸੁਧਾਰਿ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਆਠਿ ਬਰਸਿ ਮਿਤ੍ਰਹਿ ਭਜਿਯੋ ਸਕਿਯੋ ਨ ਮੂੜ ਬਿਚਾਰਿ ॥੨੫॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਉਨਾਨਵੇ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੮੯॥੫੫੦੨॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਪੂਰਬ ਦੇਸ ਏਕ ਨ੍ਰਿਪ ਰਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਪੂਰਬ ਸੈਨ ਨਾਮ ਜਗ ਕਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਪੂਰਬ ਦੇ ਤਾ ਕੇ ਘਰ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਸਮ ਲਗਤ ਨ ਦੇਵ ਕੁਮਾਰੀ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਰੂਪ ਸੈਨ ਛਤ੍ਰੀ ਇਕ ਤਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਸਮ ਸੁੰਦਰ ਕਹੂੰ ਨ ਕਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਪ੍ਰਮਾਨ ਤਿਹ ਤੇਜ ਬਿਰਾਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਨਰੀ ਨਾਗਨਿਨ ਕੋ ਮਨੁ ਲਾਜੈ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਤਰੁਨਿ ਜਬ ਤਾਹਿ ਨਿਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਨ ਬਚ ਕ੍ਰਮ ਇਹ ਭਾਤਿ ਬਿਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕੈਸੇ ਕੇਲ ਸੁ ਯਾ ਸੰਗ ਕਰੌ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਤਰ ਮਾਰਿ ਕਟਾਰੀ ਮਰੌ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਮਿਤ੍ਰ ਜਾਨਿ ਇਕ ਹਿਤੂ ਹਕਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਪ੍ਰਤਿ ਚਿਤ ਕੀ ਬਾਤ ਉਚਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਕੈ ਇਹ ਮੁਹਿ ਤੈ ਦੇਹਿ ਮਿਲਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਤਰ ਮੁਹਿ ਨ ਨਿਰਖਿ ਹੈ ਆਈ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕੈ ਸਜਨੀ ਮੁਹਿ ਮਿਤ੍ਰ ਕਹ ਅਬ ਹੀ ਦੇਹੁ ਮਿਲਾਇ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਨਾਤਰ ਰਾਨੀ ਮ੍ਰਿਤ ਕੌ ਬਹੁਰਿ ਨਿਰਖਿਯਹੁ ਆਇ ॥੫॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਇਹ ਭਾਤਿ ਉਚਾਰੋ ਰਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨਿ ਗਈ ਤਬ ਸਖੀ ਸਿਯਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਕੀ ਲਗਨ ਮਿਤ੍ਰ ਸੌ ਲਾਗੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਨੀਂਦ ਭੂਖ ਸਭ ਭਾਗੀ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਅੜਿਲ ॥",
      "s": 14
    },
    {
      "t": "ਤਨਿਕ ਨ ਲਗੀ ਅਵਾਰ ਸਜਨ ਕੈ ਘਰ ਗਈ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਬਹੁ ਬਿਧਿ ਤਾਹਿ ਪ੍ਰਬੋਧਤ ਤਹ ਲ੍ਯਾਵਤ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਹ ਆਗੇ ਤ੍ਰਿਯ ਬੈਠੀ ਸੇਜ ਡਸਾਇ ਕੈ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਹੋ ਤਹੀ ਤਵਨ ਕਹ ਹਿਤੂ ਨਿਕਾਸਿਯੋ ਲ੍ਯਾਇ ਕੈ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਉਠਿ ਕਰਿ ਕੁਅਰਿ ਅਲਿੰਗਨ ਕਿਯੋ ॥",
      "s": 14
