{
  "page": 1228,
  "lines": [
    {
      "t": "ਜਾ ਤੇ ਮੋਹਿ ਸਦਾ ਤੁਮ ਪਾਵਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਦੂਸਰੋ ਪੁਰਖ ਨ ਪਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਲਹੈ ਨ ਸ੍ਵਾਨ ਨ ਭੂਸਨ ਆਵੈ ॥੨੧॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਸੁਨੀ ਬਾਤ ਐਸੀ ਜਬ ॥",
      "s": 14
    },
    {
      "t": "ਬਚਨ ਕਹਾ ਹਸਿ ਕਰਿ ਪਿਯ ਸੋ ਤਬ ॥",
      "s": 14
    },
    {
      "t": "ਰੋਮ ਨਾਸ ਤੁਮ ਬਦਨ ਲਗਾਵਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਸਕਲ ਨਾਰਿ ਕੋ ਭੇਸ ਬਨਾਵਹੁ ॥੨੨॥",
      "s": 14
    },
    {
      "t": "ਰੋਮਾਤਕ ਰਾਨਿਯਹਿ ਮੰਗਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੇ ਬਦਨ ਸਾਥ ਲੈ ਲਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਹੀ ਕੇਸ ਦੂਰਿ ਜਬ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕਹ ਬਸਤ੍ਰ ਨਾਰਿ ਕੇ ਦਏ ॥੨੩॥",
      "s": 14
    },
    {
      "t": "ਬੀਨਾ ਦਈ ਕੰਧ ਤਾ ਕੈ ਪਰ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਨ ਨਮਿਤਿ ਰਾਖਿਯੋ ਤਾ ਕੌ ਘਰ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਰਾਜਾ ਤਾ ਕੇ ਗ੍ਰਿਹ ਆਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤੰਤ੍ਰੀ ਸੌ ਬੈਠਿ ਬਜਾਵੈ ॥੨੪॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਬੀਨ ਸੁਨਿ ਤ੍ਰਿਯ ਤਿਹ ਮਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਪੁਰਖ ਵਾਹਿ ਇਸਤ੍ਰੀ ਪਹਿਚਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੋ ਹੇਰਿ ਰੂਪ ਲਲਚਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਘਰ ਬਾਹਰ ਤਜਿ ਭਯੋ ਦਿਵਾਨਾ ॥੨੫॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਦੂਤੀ ਤਬ ਰਾਇ ਬੁਲਾਇਸਿ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਦਰਬ ਦੈ ਤਹਾ ਪਠਾਇਸਿ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਰਾਨੀ ਐਸੇ ਸੁਨਿ ਪਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਚਨ ਕਹਾ ਤਾ ਸੋ ਮੁਸਕਾਈ ॥੨੬॥",
      "s": 14
    },
    {
      "t": "ਜਿਨਿ ਤੋ ਕੋ ਰਾਜਾ ਯਹ ਬਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਹਮ ਸੋ ਨੇਹੁ ਸਕਲ ਤਜਿ ਡਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਮੈ ਅਪਨੇ ਸੰਗ ਲੈ ਤੁਹਿ ਸ੍ਵੈਹੋ ॥",
      "s": 14
    },
    {
      "t": "ਚਿਤ ਕੇ ਸਕਲ ਸੋਕ ਕਹ ਖ੍ਵੈਹੋ ॥੨੭॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਤਾ ਪਹਿ ਨ੍ਰਿਪ ਸਖੀ ਪਠਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਚਲਿ ਤੀਰ ਤਵਨ ਕੈ ਆਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਕੇ ਸੰਗ ਸੋਤ ਨਿਹਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਨ੍ਰਿਪ ਸੋ ਜਾਇ ਉਚਾਰੈ ॥੨੮॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਨ੍ਰਿਪਤਿ ਭੇਦ ਲਖ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਵਹਿ ਛੋਰਤ ਨਹਿ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਪਨੇ ਸੰਗ ਤਾਹਿ ਲੈ ਸੋਈ ॥",
      "s": 14
    },
    {
      "t": "ਹਮਰੋ ਦਾਵ ਨ ਲਾਗਤ ਕੋਈ ॥੨੯॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਇਹ ਭਾਤਿ ਨ੍ਰਿਪਤਿ ਸੁਨਿ ਪਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਤਿਹ ਆਪੁ ਬਿਲੋਕਨ ਆਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯ ਸੋ ਸੋਤ ਜਾਰ ਕੋ ਹੇਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਹਫਲ ਜਾਇ ਤਿਨੈ ਨਾਹਿ ਛੇਰੈ ॥੩੦॥",
      "s": 14
    },
    {
      "t": "ਮਾਥੋ ਧੁਨ੍ਰਯੋ ਨ੍ਰਿਪਤਿ ਸੌ ਕਹਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਹਮਰੋ ਭੇਦ ਰਾਨਿਯਹਿ ਲਹਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਯਾਹਿ ਸੰਗ ਲੈ ਸੋਈ ॥",
      "s": 14
    },
    {
      "t": "ਮੇਰੀ ਘਾਤ ਨ ਲਾਗਤ ਕੋਈ ॥੩੧॥",
      "s": 14
    },
    {
      "t": "ਉਨ ਰਾਨੀ ਐਸੋ ਤਬ ਕੀਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਭਾਖਿ ਸਖਯਿਨ ਸਭ ਦੀਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਇਹ ਸੋਤ ਅਨਤ ਨ੍ਰਿਪ ਪਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਪਕਰਿ ਭੋਗਬੇ ਕਾਜ ਮੰਗਾਵੈ ॥੩੨॥",
      "s": 14
    },
    {
      "t": "ਮੈ ਸੋਵਤ ਤਾ ਤੇ ਇਹ ਸੰਗਾ ॥",
      "s": 14
    }
  ]
}
