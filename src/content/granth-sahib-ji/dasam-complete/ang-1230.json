{
  "page": 1230,
  "lines": [
    {
      "t": "ਛਿਤ ਮੈ ਡਾਰਿ ਸ੍ਰੋਣ ਕੇ ਰੰਗਾ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਤ੍ਰਿਯ ਸਾਥ ਸਜਨ ਕੇ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਅਸ ਸਖੀ ਪੁਕਾਰਤ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਲਏ ਸਿੰਘ ਰਾਨੀ ਕਹ ਜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਕੋਊ ਆਨਿ ਲੇਹੁ ਛੁਟਕਾਈ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਸੂਰਨ ਸਿੰਘ ਨਾਮ ਸੁਨਿ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਸਤ ਭਏ ਅਸ ਕਰਨ ਉਚਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਇ ਭੇਦ ਰਾਜਾ ਤਨ ਦਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਲੈ ਕਰਿ ਸਿੰਘ ਰਾਨਿਯਹਿ ਗਯੋ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਧੁਨਿ ਸੀਸ ਬਾਇ ਮੁਖ ਰਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਹੋਨਹਾਰ ਭਯੋ ਹੋਤ ਸੁ ਕਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਕਛੂ ਨਹਿ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਲੈ ਰਾਨੀ ਕਹ ਜਾਰ ਸਿਧਾਯੋ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਇਕ੍ਰਯਾਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੯੧॥੫੫੪੯॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਉਤਰ ਸਿੰਘ ਨ੍ਰਿਪਤਿ ਇਕ ਭਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਉਤਰ ਦਿਸਿ ਕੋ ਰਹਤ ਨ੍ਰਿਪਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਉਤਰ ਮਤੀ ਧਾਮ ਤਿਹ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਸਮ ਕਾਨ ਸੁਨੀ ਨ ਨਿਹਾਰੀ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਤਹਾ ਲਹੌਰੀ ਰਾਇਕ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰੂਪਵਾਨ ਸਭ ਗੁਨਨ ਸਵਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਅਬਲਾ ਤਿਹ ਹੇਰਤ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਤਛਿਨ ਸਭ ਸੁਧਿ ਬੁਧਿ ਤਜਿ ਦਈ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਉਰ ਅੰਚਰਾ ਅੰਗਿਯਾ ਨ ਸੰਭਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਬ ਕਛੂ ਹ੍ਵੈ ਕਛੂ ਉਚਾਰੈ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਪਿਯ ਪਿਯ ਰਟਤ ਸਦਾ ਮੁਖ ਰਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਸ ਦਿਨ ਜਲ ਅਖਿਯਾ ਤੇ ਬਹੈ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਪੂਛਨ ਤਾਹਿ ਰਾਇ ਜਬ ਆਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਮੁਹੌ ਨ ਭਾਖਿ ਉਤਰਹਿ ਦ੍ਰਯਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਝੂਮ ਝੂਮਿ ਝਟ ਦੈ ਛਿਤ ਝਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਰ ਬਾਰ ਪਿਯ ਸਬਦ ਉਚਰੈ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਅਦਭੁਤ ਹੇਰਿ ਰਾਇ ਹ੍ਵੈ ਰਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਸਖਿਯਨ ਸੌ ਐਸੀ ਬਿਧਿ ਕਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਅਬਲਾ ਕੌ ਕਸ ਹ੍ਵੈ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਤੇ ਹਾਲ ਐਸ ਇਹ ਭਯੋ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਕੌ ਕੌਨ ਜਤਨ ਤਬ ਕਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਤੇ ਯਹ ਰਾਨੀ ਨਹਿ ਮਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਵਹ ਮਾਗੈ ਸੋ ਮੈ ਦੈ ਹੌ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਨਿਮਿਤਿ ਕਰਵਤਹਿ ਲੈ ਹੌ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਸਿਰ ਕਰਿ ਤਿਹ ਆਗੈ ਜਲ ਭਰੌ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਰ ਬਾਰ ਤਾ ਕੇ ਪਗ ਪਰੌ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਰਾਨੀ ਕਾ ਰੋਗ ਮਿਟਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਸਹਿਤ ਰਾਜ ਕਹ ਪਾਵੈ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਰਾਨੀ ਕਾ ਰੋਗੁ ਮਿਟਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਨਰ ਹਮ ਕਹ ਬਹੁਰਿ ਜਿਯਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਅਰਧ ਰਾਜ ਰਾਨੀ ਜੁਤ ਲੇਈ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਰਾਤ੍ਰਿ ਹਮ ਕਹ ਤ੍ਰਿਯ ਦੇਈ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਦਿਵਸ ਵਹੁ ਰਾਜ ਕਰਾਵੈ ॥",
      "s": 14
    }
  ]
}
