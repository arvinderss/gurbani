    },
    {
      "t": "ਇਕ ਦਿਨ ਭਜੈ ਜਾਰ ਕੌ ਬਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਦਿਨ ਰਾਜਾ ਰਾਜ ਕਮਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਰ ਛਤ੍ਰ ਦਿਨ ਦੁਤਿਯ ਢਰਾਵੈ ॥੨੨॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਬਾਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੯੨॥੫੫੭੧॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜਪੁਰੀ ਨਗਰੀ ਹੈ ਜਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਸੈਨ ਰਾਜਾ ਇਕ ਤਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਦੇਈ ਤਾ ਕੇ ਗ੍ਰਿਹ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਚੰਦ੍ਰ ਲਈ ਜਾ ਤੇ ਉਜਿਯਾਰੀ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਸੌ ਅਤਿ ਤ੍ਰਿਯ ਕੋ ਹਿਤ ਰਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੋਈ ਕਰਤ ਜੁ ਰਾਨੀ ਕਹੈ ॥",
