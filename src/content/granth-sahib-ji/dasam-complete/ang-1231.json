  "lines": [
    {
      "t": "ਰਾਨੀ ਕੇ ਸੰਗ ਭੋਗ ਕਮਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਦੂਸਰ ਦਿਨ ਹਮ ਰਾਜ ਕਮਾਵਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਲੈ ਅਪਨੀ ਇਸਤ੍ਰਿਯਹਿ ਬਜਾਵਹਿ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਬਹੁ ਬਿਧਿ ਨ੍ਰਿਪ ਐਸ ਉਚਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਹਚਰਿ ਏਕ ਜੋਰ ਦੋਊ ਕਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਯੌ ਰਾਜਾ ਸੌ ਬਚਨ ਉਚਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਸੁ ਮੈ ਕਹਤ ਹੌ ਸੁਨਹੋ ਪ੍ਯਾਰੇ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਬੈਦ ਤੁਮ ਤਾਹਿ ਬੁਲਾਵੌ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਇਹ ਉਪਚਾਰ ਕਰਾਵੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਛਿਨ ਮੈ ਯਾ ਕੋ ਦੁਖ ਹਰਿ ਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਰੋਗਨਿ ਤੇ ਸੁ ਅਰੋਗਿਨਿ ਕਰਿ ਹੈ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਰਾਜੇ ਐਸੇ ਸੁਨਿ ਪਾਵਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਤਛਿਨ ਤਾ ਕਹ ਬੋਲਿ ਪਠਾਵਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਕੀ ਨਾਟਿਕਾ ਦਿਖਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਬੋਲਾ ਬੈਦ ਦੇਖਿ ਸੁਖਦਾਈ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਦੁਖ ਜੌਨੇ ਇਹ ਤਰੁਨਿ ਦੁਖਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਦੁਖ ਤੁਮ ਸੋ ਕਹਿਯੋ ਨ ਜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨ ਮਾਫ ਹਮਰੀ ਜੋ ਕੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਪਾਛੇ ਬਾਤ ਸਕਲ ਸੁਨਿ ਲੀਜੈ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਰਾਨੀ ਕਹ ਕਾਮ ਸੰਤਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਮ ਨਹਿ ਇਹ ਸੰਗ ਭੋਗ ਕਮਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਯਹਿ ਰੋਗ ਗਹਿ ਲੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਹਮ ਤੇ ਜਾਤ ਉਪਾ ਨ ਕੀਨਾ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਯਹ ਮਦ ਮਤ ਮੈਨ ਤ੍ਰਿਯ ਭਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਮ ਕ੍ਰੀੜਾ ਇਹ ਸਾਥ ਨ ਕਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਯਹ ਅਧਿਕ ਭੋਗ ਜਬ ਪਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਕੋ ਰੋਗ ਦੂਰ ਹ੍ਵੈ ਜਾਵੈ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਤੁਮ ਤਬ ਉਪਚਾਰ ਕਰਾਵੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਚਨ ਹਾਥ ਮੋਰੇ ਪਰ ਦ੍ਰਯਾਵੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਇਹ ਦੁਖ ਮੈ ਦੂਰ ਕਰਾਊ ॥",
      "s": 14
    },
    {
      "t": "ਅਰਧ ਰਾਜ ਰਾਨੀ ਜੁਤ ਪਾਊ ॥੧੬॥",
      "s": 14
    },
    {
      "t": "ਭਲੀ ਭਲੀ ਰਾਜੈ ਤਬ ਭਾਖੀ ॥",
      "s": 14
    },
    {
      "t": "ਹਮਹੂੰ ਇਹ ਹਿਰਦੈ ਮਥਿ ਰਾਖੀ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਥਮ ਰੋਗ ਤੁਮ ਯਾਹਿ ਮਿਟਾਵੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਰਧ ਰਾਜ ਰਾਨੀ ਜੁਤ ਪਾਵੋ ॥੧੭॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਥਮਹਿ ਬਚਨ ਨ੍ਰਿਪਤਿ ਤੇ ਲਿਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਪੁਨਿ ਉਪਚਾਰ ਤਰੁਨਿ ਕੋ ਕਿਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਭੋਗ ਕਿਯੋ ਤ੍ਰਿਯ ਰੋਗ ਮਿਟਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਰਧ ਰਾਜ ਰਾਨੀ ਜੁਤ ਪਾਯੋ ॥੧੮॥",
      "s": 14
    },
    {
      "t": "ਅਰਧ ਰਾਜ ਇਹ ਛਲ ਤਿਹ ਦਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਭੋਗ ਮਿਤ੍ਰ ਸੰਗ ਕਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੂਰਖ ਨਾਹ ਨਾਹਿ ਛਲ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਗਟ ਆਪਨੋ ਮੂੰਡ ਮੁੰਡਾਯੋ ॥੧੯॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਰਾਨੀ ਨ੍ਰਿਪ ਛਲਾ ਰਮੀ ਮਿਤ੍ਰ ਕੇ ਸਾਥ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਅਰਧ ਰਾਜ ਤਾ ਕੋ ਦਿਯਾ ਭੇਦ ਨ ਪਾਯੋ ਨਾਥ ॥੨੦॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਅਰਧ ਰਾਜ ਤਿਹ ਦੀਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੂਰਖ ਪਤਿ ਕਹ ਅਸਿ ਛਲਿ ਲੀਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਦਿਨ ਰਨਿਯਹਿ ਜਾਰ ਬਜਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਅਰਧ ਰਾਜ ਤਿਹ ਆਪ ਕਮਾਵੈ ॥੨੧॥",
