{
  "page": 1234,
  "lines": [
    {
      "t": "ਦ੍ਵਾਦਸ ਬਰਖ ਸੰਗ ਲੈ ਸ੍ਵੈਯਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਹਸੰਸੈ ਘਰ ਮੈ ਸੁਤ ਹੋਈ ॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਮੈ ਬਾਤ ਨ ਦੂਜੀ ਕੋਈ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਜਤੀ ਤਿਹ ਮੁਨਿ ਕੋ ਜਾਨਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਨ ਬਿਨਸਾ ਤਾਹਿ ਪਛਾਨਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਰੰਭਾਦਿਕ ਇਸਤ੍ਰੀ ਪਚਿ ਹਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਬ੍ਰਤ ਤੇ ਟਰਾ ਨ ਰਿਖਿ ਬ੍ਰਤ ਧਾਰੀ ॥੧੧॥",
      "v": [
        [
          3,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਹਮ ਤੁਮ ਸਾਥ ਤਹਾ ਦੋਊ ਜਾਵੈਂ ॥",
      "s": 14
    },
    {
      "t": "ਜ੍ਯੋਂ ਤ੍ਯੋਂ ਮੁਨਹਿ ਪਾਇ ਪਰ ਲ੍ਯਾਵੈਂ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਰਹ ਬਰਿਸ ਮੋਰਿ ਸੰਗ ਸ੍ਵਾਵਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਹਸੰਸੈ ਘਰ ਮੈ ਸੁਤ ਪਾਵਹੁ ॥੧੨॥",
      "v": [
        [
          0,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸੁਨਿ ਬਚ ਨ੍ਰਿਪ ਉਠਿ ਠਾਢੋ ਭਯੋ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਸਹਿਤ ਤਵਨ ਬਨ ਗਯੋ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਜਹ ਛ੍ਵੈ ਬ੍ਰਿਛ ਗਗਨ ਤਨ ਰਹੇ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਘੋਰ ਭਯਾਨਕ ਜਾਤ ਨ ਕਹੇ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਸਹਿਤ ਰਾਵ ਤਹ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਹੇਰਤ ਤਵਨ ਮੁਨੀਸਹਿ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਰਿ ਸਹਿਤ ਪਾਇਨ ਤਿਹ ਪਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਚਿਤ ਮੈ ਇਹੈ ਬਿਚਾਰ ਬਿਚਾਰਿਯੋ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਸਿਵ ਸੁਪਨ ਸਮੈ ਕਹਿ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਹਮ ਸਾਚੁ ਦ੍ਰਿਗਨ ਲਹਿ ਲਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜ੍ਯੋਂ ਤ੍ਯੋਂ ਕਰਿ ਇਹ ਗ੍ਰਿਹ ਲੈ ਜਾਊਾਂ ॥",
      "s": 14
    },
    {
      "t": "ਲੈ ਰਾਨੀ ਕੇ ਸਾਥ ਸੁਵਾਊਾਂ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਜ੍ਯੋਂ ਜ੍ਯੋਂ ਨ੍ਰਿਪ ਪਾਇਨ ਪਰ ਪਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਯੋਂ ਤ੍ਯੋਂ ਮੁਨਿ ਆਂਖੈ ਨ ਉਘਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਯੋਂ ਰਾਜਾ ਸੀਸਹਿ ਨਿਹੁਰਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕਹ ਮਹਾ ਮੁਨੀ ਠਹਰਾਵੈ ॥੧੬॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਨ੍ਰਿਪ ਅਨਿਕ ਬਾਰ ਪਗ ਪਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਆਂਖੈ ਮੁਨਿ ਦੁਹੂੰ ਉਘਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਸੌ ਕਹਾ ਕਿਹ ਨਮਿਤਿ ਆਯੋ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਕਿਹ ਕਾਰਨ ਇਸਤ੍ਰੀ ਸੰਗ ਲ੍ਯਾਯੋ ॥੧੭॥",
      "s": 14
    },
    {
      "t": "ਹਮ ਹੈ ਮੁਨਿ ਕਾਨਨ ਕੇ ਬਾਸੀ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਨਾਮ ਜਾਨਤ ਅਬਿਨਾਸੀ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜਾ ਪ੍ਰਜਾ ਬਸਤ ਕਿਹ ਠੌਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਹਮ ਪ੍ਰਭ ਕੇ ਰਾਚੇ ਰਸ ਬੌਰਾ ॥੧੮॥",
      "s": 14
    },
    {
      "t": "ਯਹ ਸੰਪਤਿ ਹਮਰੇ ਕਿਹ ਕਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਲੈ ਹਮੈ ਦਿਖਾਵਤ ਰਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਹਮ ਨਹਿ ਧਾਮ ਕਿਸੂ ਕੇ ਜਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਬਨ ਹੀ ਮਹਿ ਹਰਿ ਧ੍ਯਾਨ ਲਗਾਹੀ ॥੧੯॥",
      "s": 14
    },
    {
