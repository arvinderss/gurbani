{
  "page": 1235,
  "lines": [
    {
      "t": "ਸੋਵਤ ਇਹਾ ਜਗਾਇ ਪਠਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਮਾਨਿ ਸੰਭੁ ਕੋ ਕਹੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਰਹ ਬਰਖ ਹਮਾਰੋ ਰਹੋ ॥੨੨॥",
      "s": 14
    },
    {
      "t": "ਸਿਵ ਕੀ ਸੁਨਤ ਭਯੋ ਜਬ ਬਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਮੁਨਿ ਸਾਥ ਚਲਨ ਕੀ ਮਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜਾ ਕੇ ਹ੍ਵੈ ਸੰਗ ਸਿਧਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਸਹਿਤ ਸਦਨ ਪਗ ਧਾਰਾ ॥੨੩॥",
      "s": 14
    },
    {
      "t": "ਖਾਨ ਪਾਨ ਆਗੈ ਨ੍ਰਿਪ ਧਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਨਿਰਖਿ ਰਿਖਿ ਐਸ ਉਚਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਭੋਜਨ ਹਮਰੇ ਕਿਹ ਕਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਏ ਹੈ ਇਨ ਗ੍ਰਿਹਸਤਨ ਕੇ ਸਾਜਾ ॥੨੪॥",
      "s": 14
    },
    {
      "t": "ਹਮ ਇਸਤ੍ਰਿਨ ਤਨ ਨੈਨ ਨ ਲਾਵਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਇਨ ਰਸ ਕਸਨ ਭੂਲ ਨਹਿ ਖਾਵਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਨ ਹਰਿ ਨਾਮ ਕਾਮ ਨਹਿ ਆਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਬੇਦ ਕਤੇਬ ਯੌ ਭੇਦ ਬਤਾਵੈ ॥੨੫॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਨ੍ਰਿਪ ਤਾਹਿ ਸਹੀ ਮੁਨਿ ਮਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਨ ਮੂੜ ਪਛਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਜੁ ਰਾਨੀ ਤਨ ਤਾਹਿ ਸੁਵਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੂਰਖ ਅਪਨੋ ਮੂੰਡ ਮੁਡਾਯੋ ॥੨੬॥",
      "s": 14
    },
    {
      "t": "ਨਿਜੁ ਕਰ ਮੂਰਖ ਸੇਜ ਬਿਛਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਤ੍ਰਿਯਾ ਕੇ ਸਾਥ ਸੁਵਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਜਤੀ ਤਾ ਕਹ ਪਹਿਚਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਨ ਮੂਰਖ ਜਾਨੈ ॥੨੭॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਪਤਿ ਨਹਿ ਹੇਰਤ ਤ੍ਰਿਯ ਜਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਤਾ ਸੋ ਦ੍ਰਿੜ ਠਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਗ ਅਫੀਮ ਅਧਿਕ ਤਿਹ ਖ੍ਵਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਚਾਰਿ ਪਹਰ ਰਤਿ ਕਰੀ ਪ੍ਯਾਰੀ ॥੨੮॥",
      "s": 14
    },
    {
      "t": "ਭੋਗ ਕਰਤ ਇਕ ਕ੍ਰਿਯਾ ਬਿਚਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਊਪਰ ਏਕ ਤੁਲਾਈ ਡਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਬੈਠੋ ਮੂਕਿਯੈ ਲਗਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਅੰਤਰ ਰਾਨਿਯਹਿ ਬਜਾਵੈ ॥੨੯॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਸੌ ਮਿਤ੍ਰਹਿ ਤਿਨ ਪਾਵਾ ॥",
      "s": 14
    },
    {
      "t": "ਮੂਰਖ ਭੂਪ ਨ ਭੇਵ ਜਤਾਵਾ ॥",
      "s": 14
    },
    {
      "t": "ਪਾਵਦ ਬੈਠਿ ਮੂਕਿਯਨ ਮਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਉਤ ਰਾਨੀ ਸੰਗ ਜਾਰ ਬਿਹਾਰੈ ॥੩੦॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਸੌ ਰਾਨੀ ਪਤਿ ਛਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਰ ਗਵਨ ਤ੍ਰਿਯਿ ਦੇਖਤ ਕਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੂਰਖਿ ਭੇਦ ਅਭੇਦ ਨ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਇਸਤ੍ਰੀ ਤੇ ਮੂੰਡ ਮੁਡਾਯੋ ॥੩੧॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਚੌਰਾਨਵੇ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੯੪॥੫੬੨੦॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਚੰਚਲ ਸੈਨ ਨ੍ਰਿਪਤਿ ਇਕ ਨਰਵਰ ॥",
      "s": 14
    },
    {
      "t": "ਅਵਰ ਨ੍ਰਿਪਤਿ ਤਾ ਕੀ ਨਹਿ ਸਰਬਰ ॥",
      "s": 14
    },
    {
      "t": "ਚੰਚਲ ਦੇ ਤਾ ਕੇ ਘਰ ਦਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਸਮ ਦੇਵ ਨ ਦੇਵ ਕੁਮਾਰਾ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਸੁੰਦਰਿਤਾ ਇਹ ਕਹੀ ਨ ਆਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੋ ਮਦਨ ਹੇਰਿ ਲਲਚਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਜੋਬਨ ਜੇਬ ਅਧਿਕ ਤਿਹ ਧਰੀ ॥",
      "s": 14
    }
  ]
}
