  "page": 1238,
  "lines": [
    {
      "t": "ਸਾਹੁ ਤਵਨ ਕੀ ਬਾਤ ਨ ਮਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਮੰਗਲਾ ਭਈ ਖਿਸਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਕੋਪ ਕਰਿ ਹੇਤੁ ਬਿਸਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਰਧਾ ਅਰਧ ਚੀਰ ਤਿਹ ਡਾਰਾ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਲੂਟਿ ਲਯੋ ਤਾ ਕੋ ਸਭ ਹੀ ਧਨ ॥",
      "s": 14
    },
    {
      "t": "ਘੋਰ ਅਪ੍ਰਾਧ ਕਿਯੋ ਪਾਪੀ ਇਨ ॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਕਹ ਚੀਰਿ ਮਤ ਗਜ ਡਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਨਹੂੰ ਪੁਰਖ ਨ ਕਰੀ ਨਿਵਾਰਾ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਵਾਰਸ ਭਈ ਆਪੁ ਤਾ ਕੀ ਤਿਯ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਤ੍ਰਾ ਲਈ ਮਾਰਿ ਤਾ ਕੋ ਜਿਯ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਨ ਕਿਨੂੰ ਬਿਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਭੋਗ ਨ ਕਿਯਾ ਤਿਸੈ ਕੌ ਮਾਰਾ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਮਾਰਾ ਤਾਹਿ ਕੌ ਜੌ ਨ ਰਮਾ ਤਿਹ ਸੰਗ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸੁ ਕਬਿ ਸ੍ਯਾਮ ਪੂਰਨ ਭਯੋ ਤਬ ਹੀ ਕਥਾ ਪ੍ਰਸੰਗ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਦੋਇ ਸੌ ਛ੍ਰਯਾਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੨੯੬॥੫੬੪੯॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਜੈ ਸੂਰ ਖਤ੍ਰੀ ਇਕ ਰਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਸਿਧ ਪਾਲ ਤਾ ਕਹ ਜਗ ਕਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਸਮਸਦੀਨ ਦਿਲੀਸ ਦਿਵਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨਤ ਸਕਲ ਰਾਵ ਅਰੁ ਰਾਨਾ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਲਛਿਮਨ ਸੈਨ ਧਾਮ ਸੁਤ ਸੁਭ ਮਤਿ ॥",
      "s": 14
    },
    {
      "t": "ਬਜ੍ਰ ਸੈਨ ਦੂਸਰੋ ਬਿਕਟ ਮਤਿ ॥",
      "s": 14
    },
    {
      "t": "ਸਕੁਚ ਮਤੀ ਦੁਹਿਤਾ ਇਕ ਤਾ ਕੇ ॥",
      "s": 14
    },
    {
      "t": "ਨਰੀ ਨਾਗਨੀ ਸਮ ਨਹਿ ਜਾ ਕੇ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਸਮਸਦੀਨ ਦਿਲੀਸ ਜੁਵਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਨਤ ਆਨਿ ਦੇਸ ਜਿਹ ਨਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਦਿਵਸ ਵਹੁ ਗਯੋ ਸਿਕਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਦਿਸ ਹੁਤੀ ਕੇਹਰੀ ਬਾਰਾ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਤਹੀ ਦਿਲੀਸ ਆਪੁ ਚਲਿ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਹਾ ਸਿੰਘਨੀ ਚਿਤਵਤ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਿਧ ਪਾਲ ਲੀਏ ਅਪਨੇ ਸੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਔਰ ਲੀਏ ਅਨਗਨ ਚਤੁਰੰਗਾ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਪਰ ਕਰੀ ਝੁਕਾਵਤ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕੇਹਰਿ ਸਮੈ ਜਨਮ ਤਬ ਲਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਰਧ ਰਹਾਤਨ ਮਾਤ ਕੁਖੂਤਰ ॥",
      "s": 14
    },
    {
      "t": "ਅਰਧਹ ਨਾਕਰ ਗਜ ਮਸਤਕ ਪਰ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਇਕ ਭਾਟ ਕੌਤਕ ਅਸ ਲਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਹਜਰਤਿ ਸੁਨਤ ਦੋਹਰਾ ਕਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੁ ਮੈ ਕਹਤ ਹੋ ਸੁਨਹੁ ਪ੍ਯਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਤਿਨ ਸਾਹ ਨ ਚਿਤ ਤੇ ਟਾਰੇ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਿੰਘ ਸਾਪੁਰਸ ਪਦਮਿਨੀ ਇਨ ਕਾ ਇਹੈ ਸੁਭਾਉ ॥",
      "v": [
        [
          2,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਜ੍ਯੋਂ ਜ੍ਯੋਂ ਦੁਖ ਗਾੜੋ ਪਰੈ ਤ੍ਯੋਂ ਤ੍ਯੋਂ ਆਗੇ ਪਾਉ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਟ ਜਬੈ ਇਹ ਭਾਤਿ ਉਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਹਜਰਤਿ ਬਚਨ ਸ੍ਰਵਨ ਇਹ ਧਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਅਪਨੇ ਮਹਲਨ ਮਹਿ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਿਧ ਪਾਲ ਕਹ ਬੋਲ ਪਠਾਯੋ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਸੋ ਇਹ ਬਿਧਿ ਨਾਥ ਬਖਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਤੈ ਹੈਂ ਮੋਰ ਵਜੀਰ ਸ੍ਯਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਕਛੁ ਅਸ ਤੁਮ ਕਰਹੁ ਉਪਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਤੇ ਮਿਲੈ ਪਦੁਮਿਨਿ ਆਈ ॥੯॥",
