{
  "page": 1240,
  "lines": [
    {
      "t": "ਛਤ੍ਰੀ ਸੁਤਾ ਤੁਰਕ ਕਹ ਦੈਹੈ ॥੨੬॥",
      "s": 14
    },
    {
      "t": "ਹਾਡਿਯਨ ਸੁਤਾ ਤੁਰਕਿ ਨਹਿ ਦਈ ॥",
      "s": 14
    },
    {
      "t": "ਛਤ੍ਰਾਨੀ ਤੁਰਕਨੀ ਨ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਕਛ ਰਜਪੂਤਨ ਲਾਜ ਗਵਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਤੇ ਬੇਗਮਾ ਕਹਾਈ ॥੨੭॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਮੈ ਧਰੈ ਇਹੌ ਨਿਜੁ ਬੁਧਾ ॥",
      "s": 14
    },
    {
      "t": "ਮੰਡੌ ਬੀਰ ਖੇਤ ਮਹਿ ਕ੍ਰੁਧਾ ॥",
      "s": 14
    },
    {
      "t": "ਪਹਿਰਿ ਕੌਚ ਕਰਿ ਖੜਗ ਸੰਭਾਰੌਂ ॥",
      "s": 14
    },
    {
      "t": "ਚੁਨਿ ਚੁਨਿ ਆਜੁ ਪਖਰਿਯਾ ਮਾਰੌਂ ॥੨੮॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਕੰਨ੍ਯਾ ਨਿਜੁ ਪਿਤਾ ਹਕਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਤਾ ਸੌ ਮੰਤ੍ਰ ਉਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਤ ਤਨਿਕ ਚਿੰਤਾ ਨਹਿ ਕਰੀਯੈ ॥",
      "s": 14
    },
    {
      "t": "ਸਨਮੁਖ ਪਾਤਿਸਾਹ ਸੌ ਲਰੀਯੈ ॥੨੯॥",
      "s": 14
    },
    {
      "t": "ਅੜਿਲ ॥",
      "s": 14
    },
    {
      "t": "ਬੋਲ ਸਦਾ ਥਿਰ ਰਹੈ ਦਿਵਸਰੇ ਜਾਇ ਹੈ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਕਰੇ ਕਰਮ ਛਤ੍ਰਿਨ ਕੇ ਚਾਰਣ ਗਾਇ ਹੈ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤਾਤ ਨ ਮੋ ਕੋ ਦੀਜੈ ਆਹਵ ਕੀਜਿਯੈ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਹੋ ਦਾਨ ਕ੍ਰਿਪਾਨ ਦੁਹੂੰ ਜਗ ਮੈ ਜਸ ਲੀਜਿਯੈ ॥੩੦॥",
      "v": [
        [
          5,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਖੜਗ ਹਾਥ ਜਿਨਿ ਤਜਹੁ ਖੜਗਧਾਰਾ ਸਹੋ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਭਾਜਿ ਨ ਚਲਿਯਹੁ ਤਾਤ ਮੰਡਿ ਰਨ ਕੌ ਰਹੋ ॥",
      "v": [
        [
          3,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਪਠੇ ਪਖਰਿਯਾ ਹਨਿਯਹੁ ਬਿਸਿਖ ਪ੍ਰਹਾਰ ਕਰਿ ॥",
      "v": [
        [
          2,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਹੋ ਮਾਰਿ ਅਰਿਨ ਕੌ ਮਰਿਯਹੁ ਹਮਹਿ ਸੰਘਾਰਿ ਕਰਿ ॥੩੧॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਹੁ ਪਿਤਾ ਇਕ ਕਰਹੁ ਉਪਾਈ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸਮਸਦੀਨ ਕਹ ਲੇਹੁ ਬੁਲਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਆਵੇ ਤਬ ਪਕਰਿ ਸੰਘਰਿਯਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰੌ ਨਿਕਸਿ ਜੁਧ ਕੌ ਕਰਿਯਹੁ ॥੩੨॥",
      "s": 14
    },
    {
      "t": "ਸਿਧ ਪਾਲ ਤਬ ਐਸ ਬਿਚਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਭਲੀ ਬਾਤ ਇਨ ਸੁਤਾ ਉਚਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਅੰਤਹਪੁਰ ਤੇ ਬਾਹਿਰ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬੋਲਿ ਪਠਾਨਨ ਐਸ ਜਤਾਯੋ ॥੩੩॥",
      "s": 14
    },
    {
      "t": "ਏ ਹੈ ਪ੍ਰਭੁ ਕੇ ਬਡੇ ਬਨਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਹਮ ਤੁਮ ਸੇ ਇਨ ਕੇ ਪਗ ਲਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਇਨ ਕਹਾ ਵਹੈ ਮਨ ਮਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਿਰ ਪਰ ਹੁਕਮ ਸਾਹ ਕੋ ਆਨਾ ॥੩੪॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਮਿਲਿ ਖਾਨ ਸਾਹ ਕੇ ਗਏ ॥",
      "s": 14
    },
    {
      "t": "ਅਤਿ ਹੀ ਹ੍ਰਿਦੈ ਅਨੰਦਿਤ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਰਕਹਿ ਛਤ੍ਰਿਨ ਸੁਤਾ ਨ ਦਈ ॥",
      "s": 14
    },
    {
      "t": "ਹਸਿ ਹੈ ਇਨੈ ਭਲੀ ਇਹ ਭਈ ॥੩੫॥",
      "s": 14
    },
    {
      "t": "ਦੁਹਿਤਾ ਇਤੈ ਪਿਤਹਿ ਸਮੁਝਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਛਤ੍ਰੀ ਜਨਮੁ ਫੇਰਿ ਨਹਿ ਆਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਲੌ ਐਸੀ ਬਾਤ ਨ ਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਰਕਨ ਕੇ ਛਤ੍ਰਾਨੀ ਗਈ ॥੩੬॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਮੋਹਿ ਨ ਦੀਜੈ ਤਾਤਾ ॥",
      "s": 14
    },
    {
      "t": "ਮੰਡਹੁ ਜੁਧ ਹੋਤ ਹੀ ਪ੍ਰਾਤਾ ॥",
      "s": 14
    },
    {
      "t": "ਚਲਿ ਹੈ ਕਥਾ ਸਦਾ ਜਗ ਮਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਾਤ ਪਠਾਨ ਕਿ ਛਤ੍ਰੀ ਨਾਹੀ ॥੩੭॥",
      "s": 14
    },
    {
      "t": "ਪਹਿਰਹੁ ਕੌਚ ਬਜਾਇ ਨਗਾਰੇ ॥",
      "s": 14
    }
  ]
}
