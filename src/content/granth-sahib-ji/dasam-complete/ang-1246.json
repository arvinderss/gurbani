{
  "page": 1246,
  "lines": [
    {
      "t": "ਰੂਪ ਕੇਤੁ ਰਾਜਾ ਇਕ ਤਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਰੂਪਮਾਨ ਅਰੁ ਸੂਰਾ ਮਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਥਰਹਰ ਕੰਪੈ ਸਤ੍ਰੁ ਜਾ ਕੇ ਡਰ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਗਟ ਭਯੋ ਜਨੁ ਦੁਤਿਯ ਨਿਸਾਕਰ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਸਪੂਤ ਪੂਤ ਤਿਨ ਜਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਸੌ ਔਰ ਨ ਜਗ ਮਹਿ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਝਿਲਮਿਲ ਦੇ ਤਾ ਕੌ ਲਖਿ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਹੀ ਤੇ ਬਵਰੀ ਸੀ ਭਈ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਵਾ ਸੌ ਬਾਧਾ ਅਧਿਕ ਸਨੇਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਦ੍ਵੈ ਤੇ ਕਰੀ ਏਕ ਜਨੁ ਦੇਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਔਰ ਉਪਾਉ ਨ ਚਲਿਯੋ ਚਲਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਅਬਲਾ ਨਰ ਭੇਸ ਬਨਾਯੋ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਧਰਿ ਕਰਿ ਭੇਸ ਕਰੌਲ ਕੌ ਗਈ ਤਵਨ ਕੇ ਧਾਮ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸਭ ਕੋ ਨਰ ਜਾਨੇ ਤਿਸੈ ਕੋਈ ਨ ਜਾਨੈ ਬਾਮ ॥੫॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਕੁਅਰਹਿ ਰੋਜ ਸਿਕਾਰ ਖਿਲਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਮ੍ਰਿਗਹਿ ਹਨਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਇਕਲੀ ਫਿਰੈ ਸਜਨ ਕੇ ਸੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਪਹਿਰੇ ਪੁਰਖ ਭੇਸ ਕਹ ਅੰਗਾ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਦਿਨ ਸਦਨ ਨ ਜਾਤ ਸੁ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਪਿਤ ਤਨ ਕਹੀ ਸੁਤਾ ਮਰਿ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਪਨੀ ਠਵਰ ਬਕਰਿਯਹਿ ਜਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਦੂਸਰ ਪੁਰਖ ਨ ਭੇਦ ਬਿਚਾਰਾ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਸਾਹ ਲਹਿਯੋ ਦੁਹਿਤਾ ਮਰ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਯੌ ਨਹੀ ਲਖਿਯੋ ਕਰੌਲਨ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੰਗ ਨਿਤ ਲੈ ਨ੍ਰਿਪ ਸੁਤ ਕੌ ਜਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਬਨ ਉਪਬਨ ਭੀਤਰ ਭ੍ਰਮਿ ਆਵੈ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਤ ਕਾਲ ਇਹ ਭਾਤਿ ਬਿਤਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਕੁਅਰ ਕਹ ਬਹੁ ਬਿਰਮਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਤਾ ਕਹ ਨਹਿ ਨਾਰਿ ਪਛਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਭਲੋ ਕਰੌਲ ਤਾਹਿ ਕਰਿ ਮਾਨੈ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਦਿਨ ਗਏ ਗਹਿਰ ਬਨ ਦੋਊ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਥੀ ਦੁਤਿਯ ਨ ਪਹੁਚਾ ਕੋਊ ॥",
      "s": 14
    },
    {
      "t": "ਅਥ੍ਰਯੋ ਦਿਵਸ ਰਜਨੀ ਹ੍ਵੈ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਬ੍ਰਿਛ ਤਰ ਬਸੇ ਬਨਾਈ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਇਕ ਆਯੋ ਸਿੰਘ ਅਪਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਢੇ ਦਾਤ ਬਡੇ ਬਿਕਰਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਨਿਰਖਿ ਨ੍ਰਿਪ ਸੁਤ ਡਰ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਹ ਸੁਤਾ ਤਿਹ ਧੀਰ ਬੰਧਾਯੋ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤਿਹ ਤਾਕਿ ਤੁਪਕ ਸੌ ਮਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਸੁਤ ਦੇਖਤ ਸਿੰਘ ਪ੍ਰਹਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਕੁਅਰ ਅਸ ਬਚਨ ਉਚਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਗਹੁ ਜੋ ਜਿਯ ਰੁਚਤ ਤਿਹਾਰੇ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤਿਨ ਤਾ ਸੌ ਬ੍ਰਿਥਾ ਉਚਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਕੁਅਰ ਮੈ ਸਾਹ ਦੁਲਾਰੀ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤੋ ਸੌ ਮੋਰਿ ਲਗਨਿ ਲਗ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਭੇਸ ਧਰਤ ਇਹ ਭਈ ॥੧੩॥",
      "s": 14
    }
  ]
}
