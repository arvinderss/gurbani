{
  "page": 1253,
  "lines": [
    {
      "t": "ਦੁਤਿਯ ਦਿਵਸ ਤਾ ਕੇ ਘਰ ਜਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਭੇਸ ਸੰਨ੍ਯਾਸਿਨਿ ਧਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਰਾਜਾ ਤਨ ਕਰੈ ॥੧੯॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਨ੍ਰਿਪ ਦੁਤਿਯ ਨਾਰਿ ਕਰਿ ਜਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਨ ਮੂੜ੍ਰਹ ਪਛਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਇਸਤ੍ਰੀ ਚਰਿਤ੍ਰ ਨਹੀ ਲਖਿ ਪਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਤਪ੍ਰਤਿ ਅਪਨੋ ਮੂੰਡ ਮੁੰਡਾਵੈ ॥੨੦॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਤੀਨ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੦੩॥੫੮੪੦॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਧੀ ਸੈਨ ਰਾਜਾ ਇਕ ਸੂਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਤੇਗ ਦੇਗ ਦੁਹੂੰਅਨਿ ਕਰਿ ਪੂਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਤੇਜਵਾਨ ਦੁਤਿਵਾਨ ਅਤੁਲ ਬਲ ॥",
      "s": 14
    },
    {
      "t": "ਅਰਿ ਅਨੇਕ ਜੀਤੇ ਜਿਨ ਦਲਿ ਮਲਿ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਬਿਧ੍ਰਯ ਮਤੀ ਦੁਹਿਤਾ ਇਕ ਤਾ ਕੇ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਨਰੀ ਨਾਗਨੀ ਸਮ ਨਹਿ ਜਾ ਕੇ ॥",
      "s": 14
    },
    {
      "t": "ਅਪ੍ਰਮਾਨ ਤਿਹ ਸੇਜ ਸੁਹਾਵੈ ॥",
      "v": [
        [
          0,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਰਵਿ ਸਸਿ ਰੋਜ ਬਿਲੋਕਨ ਆਵੈ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੋ ਲਗਿਯੋ ਏਕ ਸੰਗ ਨੇਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਜ੍ਯੋਂ ਸਾਵਨ ਕੋ ਬਰਿਸਤ ਮੇਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਚਤੁਰ ਕੁਅਰ ਤਿਹ ਨਾਮ ਭਨਿਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਵਨ ਪੁਰਖ ਪਟਤਰ ਤਿਹ ਦਿਜੈ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਬਿਧ੍ਯਾ ਦੇਈ ਇਕ ਦਿਨ ਰਸਿ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਬੋਲਿ ਲਿਯਾ ਪ੍ਰੀਤਮ ਕਹ ਕਸਿ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਤਿਹ ਸਾਥ ਕਮਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਰੁਨੀ ਤਰੁਨ ਅਧਿਕ ਸੁਖ ਪਾਯੋ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਬਿਧੀ ਸੈਨ ਸੌ ਕਿਨਹਿ ਜਤਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਤੋਰਿ ਸੁਤਾ ਗ੍ਰਿਹ ਜਾਰ ਬੁਲਾਈ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਤਿਹ ਸਾਥ ਕਰਤ ਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਤੋ ਤੇ ਨ੍ਰਿਪ ਨਹਿ ਨੈਕੁ ਡਰਤ ਹੈ ॥੫॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤਬ ਨ੍ਰਿਪ ਸਾਥ ਤਿਸੀ ਕੋ ਲੈ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਤ ਭਯੋ ਤਹ ਅਧਿਕ ਰਿਸੈ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਧ੍ਯਾ ਮਤੀ ਜਬੈ ਸੁਨਿ ਪਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਮੀਤ ਸਹਿਤ ਜਿਯ ਮੈ ਡਰ ਪਾਈ ॥੬॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਖੋਦਿ ਛਾਤ ਦ੍ਵੈ ਛੇਦ ਸਵਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਆਵਤ ਵੈ ਰਾਹ ਬਿਚਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਮਗ ਹ੍ਵੈ ਬਿਸਟਾ ਦੁਹੂੰ ਕਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਦੂਤ ਸਹਿਤ ਨ੍ਰਿਪ ਕੇ ਸਿਰ ਪਰਾ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਅੰਧ ਗਏ ਹ੍ਵੈ ਸੂਝ ਨ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਸੀ ਪੈਡ ਗ੍ਰਿਹਿ ਜਾਰ ਪਠਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜਾ ਭੇਦ ਅਭੇਦ ਨ ਲਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਹਿਤਾ ਕਾਮ ਕੈ ਗਈ ਕਹਾ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਬਿਸਟਾ ਰਹੀ ਦੁਹੂੰ ਕੇ ਲਗਿ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁ ਘਰ ਗਯੋ ਤਿਹ ਕੇ ਸਿਰ ਹਗਿ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਘਰੀਕ ਲਗੀ ਧੋਵਤੇ ਬਦਨਨ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਗਏ ਦੁਹਿਤਾ ਕੈ ਸਦਨਨ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਤਹਾ ਜਾਇ ਜੌ ਨ੍ਰਿਪਤਿ ਨਿਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਰ ਵਾਰ ਕਛੁ ਦਿਸਟਿ ਨ ਪਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਨ੍ਰਿਪ ਉਲਟਿ ਤਿਸੀ ਕੋ ਮਰਿਯੋ ॥",
      "s": 14
    }
  ]
}
