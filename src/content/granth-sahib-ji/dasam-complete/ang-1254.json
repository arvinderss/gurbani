{
  "page": 1254,
  "lines": [
    {
      "t": "ਬਿਸਟਾ ਪ੍ਰਥਮ ਜਾਹਿ ਸਿਰ ਪਰਿਯੋ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਸੌ ਤ੍ਰਿਯ ਪਿਯਹਿ ਉਬਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਕੇ ਮੁਖ ਬਿਸਟਾ ਕੌ ਡਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭਲਾ ਬੁਰਾ ਭੂਪਤਿ ਨ ਬਿਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਦਾਇਕਹਿ ਪਕਰਿ ਪਛਾਰਾ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਚਾਰ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੦੪॥੫੮੫੧॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਪੁਰਾ ਸਹਰ ਬਸਤ ਹੈ ਜਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਪੁਰ ਪਾਲ ਰਾਜਾ ਥੋ ਤਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਪੁਰ ਮਤੀ ਤਾ ਕੀ ਬਰ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਕਨਕ ਅਵਟਿ ਸਾਚੇ ਜਨੁ ਢਾਰੀ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਫੂਲ ਮਤੀ ਦੂਸਰਿ ਤਿਹ ਸਵਤਿਨਿ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁ ਤਿਹ ਹੁਤਾ ਆਖਿ ਮੈਂ ਸੌ ਕਨਿ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਸੌ ਤਾਹਿ ਸਿਪਰਧਾ ਰਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਚਿਤ ਭੀਤਰ ਮੁਖ ਤੇ ਨਹਿ ਕਹੈ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਪੁਰਾ ਮਤੀ ਏਕ ਦਿਜ ਊਪਰ ॥",
      "s": 14
    },
    {
      "t": "ਅਟਕੀ ਰਹੈ ਅਧਿਕ ਹੀ ਚਿਤ ਕਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਰੈਨਿ ਦਿਵਸ ਗ੍ਰਿਹ ਤਾਹਿ ਬੁਲਾਵੇ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਕੇਲ ਰੁਚਿ ਮਾਨ ਮਚਾਵੈ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਨਾਰਿ ਤਿਨ ਬੋਲਿ ਪਠਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਦਰਬ ਦੈ ਐਸਿ ਸਿਖਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਹੀ ਜਾਇ ਪ੍ਰਜਾ ਸਭ ਸੋਈ ॥",
      "s": 14
    },
    {
      "t": "ਊਚ ਸਬਦ ਉਠਿਯਹੁ ਤਬ ਰੋਈ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਯੌ ਕਹਿ ਜਾਇ ਨ੍ਰਿਪਤਿ ਤਨ ਸੋਈ ॥",
      "s": 14
    },
    {
      "t": "ਆਧੀ ਰਾਤਿ ਅੰਧੇਰੀ ਹੋਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਦੁਖਿਤ ਹ੍ਵੈ ਨਾਰਿ ਪੁਕਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਕੇ ਪਰੀ ਕਾਨ ਧੁਨਿ ਭਾਰੀ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਰਾਣੀ ਲਈ ਸੰਗ ਅਪਨੇ ਕਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਹਾਥ ਬਿਖੈ ਅਪਨੇ ਅਸ ਕੌ ਧਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਦੋਊ ਚਲਿ ਤੀਰ ਤਵਨ ਕੇ ਗਏ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਸੌ ਪੂਛਤ ਤਿਹ ਭਏ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕੋ ਹੈ ਰੀ ਤੂ ਰੋਤ ਕ੍ਯੋ ਕਹਾ ਲਗਿਯੋ ਦੁਖ ਤੋਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਰਤ ਹੌ ਨਹਿ ਠੌਰ ਤੁਹਿ ਸਾਚ ਬਤਾਵਹੁ ਮੋਹਿ ॥੭॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਮੁਹਿ ਅਰਬਲਾ ਨ੍ਰਿਪਤਿ ਕੀ ਜਾਨਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਪਤਿ ਭੋਰ ਕਾਲ ਪਹਿਚਾਨਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਮੈ ਰੋਵਤ ਦੁਖਿਯਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਸਭੈ ਬਿਛੁਰਿ ਹੈਂ ਨਿਸੁਪਤਿ ਪ੍ਯਾਰੀ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਕਿਹ ਬਿਧਿ ਬਚੈ ਨ੍ਰਿਪਤਿ ਕੇ ਪ੍ਰਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਾਤ ਕੀਜਿਯੈ ਸੋਈ ਬਿਧਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਤ੍ਰਿਯ ਕਹਿਯੋ ਕ੍ਰਿਯਾ ਇਕ ਕਰੈ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤਬ ਮਰਬੇ ਤੇ ਨ੍ਰਿਪਤਿ ਉਬਰੈ ॥੯॥",
      "v": [
        [
          0,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਪੁਰ ਮਤੀ ਦਿਜਬਰ ਕਹ ਦੇਹੂ ॥",
      "s": 14
    },
    {
      "t": "ਡੋਰੀ ਨਿਜੁ ਕਾਧੇ ਕਰਿ ਲੇਹੂ ॥",
      "s": 14
    },
    {
      "t": "ਦਰਬ ਸਹਿਤ ਤਿਹ ਗ੍ਰਿਹਿ ਪਹੁਚਾਵੈ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤਬ ਨ੍ਰਿਪ ਨਿਕਟ ਕਾਲ ਨਹਿ ਆਵੈ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਫੂਲਿ ਦੇਇ ਜੁ ਦੁਤਿਯ ਤ੍ਰਿਯ ਘਰ ਮੈ ॥",
      "v": [
        [
          1,
