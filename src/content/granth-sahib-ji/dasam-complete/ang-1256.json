  "page": 1256,
  "lines": [
    {
      "t": "ਦੇਗ ਤੇਗ ਕੋ ਜਾਹਿ ਭਰੋਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਘਨਾ ਵਤੀ ਸੁਤਾ ਇਕ ਤਾ ਕੀ ॥",
      "s": 14
    },
    {
      "t": "ਰੋਸਨ ਭਯੋ ਜੋਤਿ ਸਸਿ ਵਾ ਕੀ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਦਿਨ ਨਿਕਸਾ ਨ੍ਰਿਪਤਿ ਸਿਕਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਲਏ ਸ੍ਵਾਨ ਸੀਚਾਨ ਹਜਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਚੀਤਾ ਔਰ ਜਾਰਿਯਨ ਲੀਨੇ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰਯਾਹ ਗੋਸ ਨਹਿ ਜਾਹਿ ਸੁ ਚੀਨੇ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਲਗਰ ਝਗਰ ਜੁਰਰਾ ਅਰੁ ਬਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਹਰੀ ਕੁਹੀ ਸਿਚਾਨ ਸਮਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਸੇ ਔਰ ਬਸੀਨੈ ਘਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਚਿਪਕ ਧੂਤਿਯੈ ਜਾਹਿ ਨ ਗਨੀ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਖੇਲ ਸਿਕਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਮ੍ਰਿਗਨ ਕਹ ਖੇਦਿ ਪਛਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਲਗਿ ਦ੍ਰਿਸਟਿ ਬਰਾਹਿਕ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਪਾਛੇ ਤਿਹ ਤੁਰੰਗ ਧਵਾਯੋ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਜਾਤ ਭਯੋ ਤਾਹੀ ਕੇ ਦੇਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਹਾਕਿ ਤੁਰੰਗ ਪਵਨ ਕੇ ਭੇਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਘਨਾ ਵਤੀ ਲਖਾ ਜਬ ਤਾ ਕੌ ॥",
      "s": 14
    },
    {
      "t": "ਲਯੋ ਬੁਲਾਇ ਤਹੀ ਤੇ ਵਾ ਕੌ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਧੌਲਰ ਤਰ ਕਮੰਦ ਲਰਕਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਲਯੋ ਤਿਸੌ ਤਿਹ ਪੈਡ ਚੜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਅਤਿ ਰੁਚ ਕਰਿ ਮਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਦੂਸਰੇ ਮਨੁਖ ਨ ਜਾਨਾ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤਿਹ ਪਿਤ ਯੌ ਹ੍ਰਿਦੈ ਬਿਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਜੁ ਰਾਨੀ ਕੇ ਸਾਥ ਉਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਹਮ ਤੁਮ ਆਉ ਸੁਤਾ ਕੇ ਜਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਹਿਤਾ ਹੋਇ ਖੁਸੀ ਮਨ ਮਾਹੀ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਵੈ ਦੋਊ ਸੁਤਾ ਕੇ ਗਏ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੇ ਪ੍ਰਾਪਤਿ ਦ੍ਵਾਰ ਪਰ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਘਨਾ ਵਤੀ ਤਿਹ ਲਖਿ ਦੁਖ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਅਸਰਫੀ ਕਾਢਿ ਮੰਗਾਯੋ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਔਰ ਅਧਿਕ ਤਿਨ ਅਤਿਥ ਬੁਲਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਏਕ ਦੈ ਮੁਹਰ ਪਠਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਕੇ ਮਾਹਿ ਨ੍ਰਿਪਤਿ ਕਰ ਮੰਗਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਦੈ ਸਤ ਮੁਹਰ ਨਿਕਾਰਿਯੋ ਅੰਗਨਾ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਮੁਰ ਪਰਵਾਰ ਲਖ੍ਯੋ ਇਨ ਰਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਏਤੋ ਦਯੋ ਦਰਬ ਬਿਨੁ ਕਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਦੁਗੁਨ ਤਵਨ ਕਹ ਦਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਨ ਜਾਨਤ ਭਯੋ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਸੁਤਾ ਪਿਯ ਮਿਤ੍ਰ ਕੌ ਇਹ ਛਲ ਅਤਿਥ ਬਨਾਇ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਦੈ ਅਸਰਫੀ ਨਿਕਾਰਿਯੋ ਭੇਦ ਨ ਜਾਨਾ ਰਾਇ ॥੧੨॥",
      "v": [
        [
          2,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਮਨ ਮਾਨਤ ਕੋ ਭੋਗ ਕਰਿ ਪਿਤ ਅਰੁ ਮਾਤ ਦਿਖਾਇ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਸੌ ਕਾਢਾ ਤਿਸੈ ਕਿਨਹੂੰ ਨ ਗਹਿਯੋ ਬਨਾਇ ॥੧੩॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਸਾਤ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੦੭॥੫੮੮੫॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਕੋਚ ਬਿਹਾਰ ਸਹਿਰ ਜਹ ਬਸੈ ॥",
      "s": 14
    },
    {
      "t": "ਅਮਰਾਵਤੀ ਪੁਰੀ ਕਹ ਹਸੈ ॥",
      "s": 14
    },
    {
      "t": "ਬ੍ਰਿਧ ਕੇਤੁ ਤਿਹ ਭੂਪ ਭਨਿਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਕੋ ਰਾਜਾ ਪਟਤਰ ਤਿਹ ਦਿਜੈ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਫੁਟ ਬੇਸਰਿ ਦੇ ਤਹ ਦਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਸਮ ਦੇਵ ਨ ਦੇਵ ਕੁਮਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੋ ਜਾਤ ਨ ਰੂਪ ਉਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਦਿਵਸ ਭਯੋ ਤਾ ਤੇ ਉਜਿਯਾਰਾ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਹਾਜੀ ਰਾਇ ਤਹਾ ਖਤਿਰੇਟਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਸਕ ਮੁਸਕ ਕੇ ਸਾਥ ਲਪੇਟਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੀ ਜਾਤ ਨ ਪ੍ਰਭਾ ਉਚਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਫੂਲਿ ਰਹੀ ਜਾਨੁਕ ਫੁਲਵਾਰੀ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਫੁਟ ਬੇਸਰਿ ਦੇ ਤਿਹ ਲਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਚਿਤ ਅਪਨੇ ਮਹਿ ਕਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਕੈ ਅਬ ਮਰੌ ਕਟਾਰੀ ਹਨਿ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਕੈ ਇਹ ਭਜੌ ਆਜੁ ਬਨਿ ਠਨਿ ਕੈ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਸਿ ਭੀਜਤ ਤਿਹ ਬਦਨ ਪਰ ਅਤਿ ਸੁੰਦਰ ਸਰਬੰਗ ॥",
