{
  "page": 1257,
  "lines": [
    {
      "t": "ਹਾਇ ਹਾਇ ਗਿਰਿ ਭੂਮ ਉਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਮੁਰ ਕਰੇਜ ਡਾਇਨੀ ਨਿਹਾਰਾ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਤ੍ਰਿਯ ਬਸਤ੍ਰ ਹੁਤੇ ਪਹਿਰਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਡਾਇਨ ਸੁਨਤ ਲੋਗ ਉਠਿ ਧਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਗਹਿ ਤਾਹਿ ਬਹੁਤ ਬਿਧਿ ਮਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤਿਨ ਮਨਾ ਜੁ ਤ੍ਰਿਯਾ ਉਚਾਰਾ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਲਗਿ ਤਹਾ ਨ੍ਰਿਪਤਿ ਹੂੰ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਿ ਕਰੇਜ ਤ੍ਰਿਯ ਹਰਿਯੋ ਰਿਸਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਡਾਇਨਿ ਕਹ ਕਹਾ ਸੰਘਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਕੈ ਅਬ ਹੀ ਰਾਨੀਯਹਿ ਜਿਯਾਰੋ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤਿਨ ਦੂਰਿ ਠਾਢ ਨ੍ਰਿਪ ਕੀਏ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਕੇ ਚੁੰਬਨ ਤਿਨ ਲੀਏ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜਾ ਲਖੈ ਕਰੇਜੋ ਡਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਨਹਿ ਮੂੜ ਬਿਚਾਰੈ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਤਬ ਹੀ ਲੋਗਾਨ ਹਟਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਨਾਰਿ ਸੌ ਭੋਗ ਮਚਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਖੈ ਜੋ ਮੁਰਿ ਕਹਿ ਪ੍ਰਿਯ ਪ੍ਰਾਨਾ ॥",
      "v": [
        [
          4,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤੁਮ ਸੌ ਰਮੌ ਸਦਾ ਬਿਧਿ ਨਾਨਾ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਭੋਗ ਤਾ ਸੌ ਤ੍ਰਿਯ ਕਰਿ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਧਾਇ ਭੇਸ ਦੈ ਦਯੋ ਨਿਕਰਿ ਕੈ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਭਾਖਤ ਜਾਇ ਪਤਿਹਿ ਅਸ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਇ ਕਰਿਜਵਾ ਡਾਇਨਿ ਗਈ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਦਿਤ ਮੁਹਿ ਪ੍ਰਥਮ ਕਰਿਜਵਾ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਪੁਨਿ ਵਹ ਅੰਤ੍ਰਧ੍ਯਾਨ ਹ੍ਵੈ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਬਰ ਦ੍ਰਿਸਟਿ ਨ ਹਮਰੀ ਆਈ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਕ੍ਯਾ ਜਨਿਯੈ ਕਿਹ ਦੇਸ ਸਿਧਾਈ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਸਤਿ ਸਤਿ ਤਬ ਨ੍ਰਿਪਤਿ ਉਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਨ ਮੂੜ ਬਿਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਤ ਥੋ ਤ੍ਰਿਯ ਜਾਰ ਬਜਾਈ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਹ ਚਰਿਤ੍ਰ ਗਯੋ ਆਂਖਿ ਚੁਰਾਈ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਥਮ ਮਿਤ੍ਰ ਤ੍ਰਿਯ ਬੋਲਿ ਪਠਾਯੋ ॥",
      "v": [
        [
          0,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਕਹਿਯੋ ਨ ਕਿਯ ਤ੍ਰਿਯ ਤ੍ਰਾਸ ਦਿਖਾਯੋ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਭਜਾ ਇਹ ਚਰਿਤ ਲਖਾਯਾ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਠਾਢ ਨ੍ਰਿਪਤਿ ਜੜ ਮੂੰਡ ਮੁੰਡਾਯਾ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਆਠ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੦੮॥੫੯੦੦॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਕਰਨਾਟਕ ਕੋ ਦੇਸ ਬਸਤ ਜਹ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਕਰਨਾਟਕ ਸੈਨ ਨ੍ਰਿਪਤਿ ਤਹ ॥",
      "s": 14
    },
    {
      "t": "ਕਰਨਾਟਕ ਦੇਈ ਗ੍ਰਿਹ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਤੇ ਲਿਯ ਰਵਿ ਸਸਿ ਉਜਿਯਾਰੀ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਇਕ ਸਾਹ ਬਸਤ ਥੋ ਨੀਕੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਹਿ ਨਿਰਖਿ ਸੁਖ ਉਪਜਤ ਜੀ ਕੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੇ ਸੁਤਾ ਹੁਤੀ ਇਕ ਧਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਥਕਿਤ ਰਹਤ ਨਿਰਖਤ ਜਿਹ ਬਾਮਾ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਸੁਤਾ ਅਪੂਰਬ ਦੇ ਤਿਹ ਨਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਸੀ ਕਹੂੰ ਕੋਊ ਨਹਿ ਬਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਸਾਹ ਕੇ ਸੁਤ ਕਹ ਬ੍ਯਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਬੀਰਜ ਕੇਤੁ ਨਾਮ ਤਿਹ ਆਹੀ ॥੩॥",
      "s": 14
    }
  ]
}
