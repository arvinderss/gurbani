{
  "page": 1259,
  "lines": [
    {
      "t": "ਅਧਿਕ ਤਰੁਨ ਕੋ ਤੇਜ ਬਿਰਾਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਨਰੀ ਨਾਗਨੀ ਕੋ ਮਨ ਲਾਜੈ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਰਾਨੀ ਤਿਹ ਪ੍ਰਭਾ ਨਿਹਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤੇ ਭਈ ਅਧਿਕ ਮਤਵਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਿ ਮਿਤ੍ਰ ਕੇ ਨੈਨ ਬਿਕਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਹੀ ਤੇ ਹ੍ਵੈ ਗਈ ਦਿਵਾਨੀ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤਿਹ ਬੋਲਿ ਲੀਯੋ ਅਪਨੇ ਘਰ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਕੇਲ ਕੀਨਾ ਅਤਿ ਰੁਚਿ ਕਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਤਿਹ ਗਰੇ ਲਗਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਬਲਾ ਅਧਿਕ ਹ੍ਰਿਦੈ ਸੁਖੁ ਪਾਯੋ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਲਗ ਆਇ ਨ੍ਰਿਪਤਿ ਤਹ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਤਛਿਨ ਡਾਰਿ ਮਹਲ ਤੇ ਦਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮਰਿ ਗਯੋ ਨ੍ਰਿਪਤਿ ਨ ਭੇਦ ਬਿਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਜਨ ਅਰਧ ਉਰਧ ਤੇ ਪਾਰਾ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਆਪ ਰੋਤ ਇਹ ਭਾਤਿ ਉਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਵ ਪਕਰਿ ਕਰਿ ਨ੍ਰਿਪਤਿ ਪਛਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਮੋਰੇ ਸਾਥ ਕਿਯੋ ਥੋ ਸੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਭਯੋ ਅਪਵਿਤ੍ਰ ਸ੍ਰਬੰਗਾ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਜਾਰ ਨਿਕਾਰਿਯੋ ਨਿਜੁ ਨਾਇਕਹਿ ਸੰਘਾਰਿ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਮੂਰਖ ਕਿਛੂ ਸਕਾ ਨ ਨੈਕ ਬਿਚਾਰਿ ॥੮॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਨਿਜੁ ਨਾਇਕ ਕੌ ਮਹਲ ਤੇ ਤਿਹ ਹਿਤ ਦਿਯੋ ਗਿਰਾਇ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਯਾਰ ਬਚਾਯੋ ਆਪਨੋ ਨੈਕ ਨ ਰਹੀ ਲਜਾਇ ॥੯॥",
      "v": [
        [
          2,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਦਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੧੦॥੫੯੨੧॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਰਹ ਸੈਨ ਇਕ ਨ੍ਰਿਪਤਿ ਸੁਜਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਨਤ ਆਨਿ ਦੇਸ ਜਿਹ ਨਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਰਹ ਮੰਜਰੀ ਤਾ ਕੀ ਰਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੁੰਦਰਿ ਭਵਨ ਚਤ੍ਰਦਸ ਜਾਨੀ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੈ ਧਾਮ ਏਕ ਸੁਤ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨਕ ਰਵਿ ਦੁਤਿਯੋ ਪ੍ਰਗਟਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੁੰਦਰਿਤਾ ਤਿਹ ਕਹੀ ਨ ਆਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਤ ਪਲਕ ਨ ਜੋਰੀ ਜਾਵੈ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਇਕ ਤਰਨਿ ਸਾਹ ਕੀ ਜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੀ ਛਬਿ ਨਹਿ ਜਾਤ ਬਤਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਕੈ ਸਸਿ ਤੇ ਰੋਹਨਿ ਇਹ ਜਈ ॥",
      "s": 14
    },
    {
      "t": "ਆਗੇ ਹ੍ਵੈ ਹੈ ਨ ਪਾਛੇ ਭਈ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਕੁਅਰ ਜਬ ਤਵਨ ਨਿਹਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮਦਨ ਬਾਨ ਤਨ ਤਾਹਿ ਪ੍ਰਹਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਲਗੀ ਅਟਕਿ ਸੁਧਿ ਬੁਧਿ ਛੁਟ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਬਹਿ ਤਰੁਨਿ ਮਤਵਾਰੀ ਭਈ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਦਰਬੁ ਲੁਟਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਸਖਿਨ ਕਹ ਰਹੀ ਪਠਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਕੁਅਰ ਕ੍ਯੋਹੂੰ ਨਹਿ ਆਏ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਸੌ ਕਰੇ ਨ ਮਨ ਕੇ ਭਾਏ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਕਰਿ ਕਰਿ ਜਤਨ ਕੁਅਰਿ ਬਹੁ ਹਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਕੈਸਹੂੰ ਭਜੀ ਮਿਤ੍ਰ ਨਹਿ ਪ੍ਯਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਘਾਯਲ ਫਿਰੈ ਕੁਅਰਿ ਮਤਵਾਰੀ ॥",
      "s": 14
    }
  ]
}
