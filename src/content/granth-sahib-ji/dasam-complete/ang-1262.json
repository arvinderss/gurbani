{
  "page": 1262,
  "lines": [
    {
      "t": "ਬਿਸ੍ਵਮਤੀ ਤਾ ਕੇ ਇਕ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਤ ਨ ਜਿਹ ਕੀ ਪ੍ਰਭਾ ਉਚਾਰੀ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਨਾਇਨੇਕ ਤਿਨ ਨ੍ਰਿਪਤਿ ਨਿਹਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਰੂਪਮਾਨ ਗੁਨਮਾਨ ਬਿਚਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕਹ ਪਕਰਿ ਸਦਨ ਲੈ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਤਿਹ ਸਾਥ ਕਮਾਯੋ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੋ ਲੈ ਇਸਤ੍ਰੀ ਨ੍ਰਿਪ ਕਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਤਿਹ ਸਾਥ ਬਿਹਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤ੍ਰਿਯ ਕੀ ਕੁਟੇਵ ਨਹਿ ਜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਵਰਨ ਸਾਥ ਰਮੈ ਲਪਟਾਈ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਦਿਨ ਅਰਧ ਨਿਸਾ ਜਬ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਰ ਧਾਮ ਨਾਇਨ ਵਹ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਚੌਕੀਦਾਰਨ ਗਹਿ ਤਾ ਕੌ ਲਿਯ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਕ ਕਾਟਿ ਕਰ ਬਹੁਰਿ ਛਾਡਿ ਦਿਯ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਨਾਇਨਿ ਕਟੀ ਨਾਕ ਲੈ ਕੈ ਕਰ ॥",
      "s": 14
    },
    {
      "t": "ਫਿਰਿ ਆਈ ਨ੍ਰਿਪ ਕੇ ਭੀਤਰ ਘਰ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਨ੍ਰਿਪ ਰੋਮ ਮੂੰਡਬੇ ਕਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਗ੍ਯੋ ਤੁਰਤੁ ਉਸਤਰਾ ਰਾਜਾ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤਿਨ ਵਹੈ ਉਸਤਰਾ ਦੀਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਪਰ ਬਾਢਿ ਨ ਕਬਹੂੰ ਕੀਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਿ ਨ੍ਰਿਪਤਿ ਤਿਹ ਅਧਿਕ ਰਿਸਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਗਹਿ ਤਾ ਤ੍ਰਿਯ ਕੀ ਓਰ ਚਲਾਯੋ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤ੍ਰਿਯ ਹਾਇ ਹਾਇ ਕਹਿ ਉਠੀ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਟਿ ਨਾਕ ਰਾਜਾ ਜੂ ਸੁਟੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਰਾਜਾ ਹੇਰਨ ਤਿਹ ਧਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੋਨ ਪੁਲਤ ਲਖਿ ਮੁਖ ਬਿਸਮਾਯੋ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਹਾਹਾ ਪਦ ਤਬ ਨ੍ਰਿਪਤਿ ਉਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਮੈ ਨਹਿ ਐਸੇ ਭੇਦ ਬਿਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਹੁ ਤਾ ਤ੍ਰਿਯ ਕੀ ਚਤੁਰਈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜਾ ਮੂੰਡ ਬੁਰਾਈ ਦਈ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਕੌ ਤਿਨ ਨ੍ਰਿਪਤਿ ਕਿਯਾ ਨ ਹ੍ਰਿਦੈ ਬਿਚਾਰ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਬੁਰਾਈ ਸਿਰ ਦਈ ਨਾਕ ਕਟਾਈ ਨਾਰਿ ॥੯॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਤੇਰਹ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੧੩॥੫੯੫੮॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਦਛਿਨ ਸੈਨ ਸੁ ਦਛਿਨ ਨ੍ਰਿਪ ਇਕ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਸਤ੍ਰ ਸਿਮ੍ਰਿਤ ਜਾਨਤ ਥੋ ਨਿਕ ॥",
      "s": 14
    },
    {
      "t": "ਸਦਨ ਸੁ ਦਛਿਨ ਦੇ ਤਿਹ ਦਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁ ਸਸਿ ਚੜਿਯੋ ਗਗਨ ਮੰਝਾਰਾ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਅਪ੍ਰਮਾਨ ਰਾਨੀ ਕੀ ਥੀ ਛਬਿ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਿ ਪ੍ਰਭਾ ਜਿਹ ਰਹਤ ਭਾਨ ਦਬਿ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜਾ ਅਧਿਕ ਆਸਕਤ ਤਾ ਪਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਬਿਧਿ ਅਲਿ ਪੰਖੁਰੀ ਕਮਲ ਕਰਿ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਤਹਾ ਸਾਹ ਕੀ ਹੁਤੀ ਦੁਲਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਰਾਜਾ ਕੀ ਪ੍ਰਭਾ ਨਿਹਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਸੁ ਕੁਮਾਰ ਦੇਇ ਤਿਹ ਨਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਸੀ ਭਈ ਨ ਮਹਿ ਮਹਿ ਬਾਮਾ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਚਿਤ ਮਹਿ ਸਾਹ ਸੁਤਾ ਯੌ ਕਹਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਤਿਹ ਹੇਰਿ ਅਟਕ ਮਨ ਰਹਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕੌਨ ਜਤਨ ਜਾ ਤੇ ਨ੍ਰਿਪ ਪਾਊ ॥",
      "s": 14
    },
    {
      "t": "ਚਿਤ ਤੇ ਤ੍ਰਿਯ ਪਹਿਲੀ ਬਿਸਰਾਊ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਬਸਤ੍ਰਤਿ ਉਤਮ ਸਕਲ ਉਤਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਮੇਖਲਾਦਿ ਤਨ ਮੋ ਪਟ ਧਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੇ ਧੂਮ ਦ੍ਵਾਰ ਪਰ ਡਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਇਸਤ੍ਰੀ ਪੁਰਖ ਨ ਕਿਨੂੰ ਬਿਚਾਰਿਯੋ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਕੇਤਿਕ ਦਿਵਸ ਬੀਤ ਜਬ ਗਏ ॥",
      "s": 14
    },
    {
      "t": "ਲਖਨ ਨਗਰ ਨਿਕਸਤ ਪ੍ਰਭ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਖਾ ਸੁਨਨ ਸਭਨ ਕੀ ਕਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਤਿਥ ਭੇਸ ਧਰਿ ਨਿਕਸਿਯੋ ਰਾਜਾ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਤ੍ਰਿਯ ਭੇਸ ਅਤਿਥ ਕੋ ਧਰਿ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਬਚਨ ਉਚਾਰਿਯੋ ਨ੍ਰਿਪਹਿ ਨਿਹਰਿ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਹ ਭਯੋ ਰਾਜਾ ਮੂਰਖ ਮਤਿ ਕੌ ॥",
      "s": 14
    },
    {
      "t": "ਭਲੀ ਬੁਰੀ ਜਾਨਤ ਨਹਿ ਗਤਿ ਕੌ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਦੁਰਾਚਾਰ ਰਾਨੀ ਜੁ ਕਮਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੇ ਧਾਮ ਨਿਤ੍ਯ ਨ੍ਰਿਪ ਜਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਜੜ ਇਹ ਲਖਤ ਮੋਰਿ ਹਿਤਕਾਰਨਿ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਨਿਤ ਸੋਤ ਸੰਗ ਲੈ ਯਾਰਨਿ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਯਹ ਧੁਨਿ ਸ੍ਰਵਨਨ ਸੁਨਿ ਪਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਪੂਛਤ ਭਯੋ ਤਿਸੀ ਕਹ ਜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਥਿਤ ਨ੍ਰਿਪਤਿ ਹ੍ਯਾਂ ਦੋ ਕ੍ਯਾ ਕਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਤੁਮ ਕਹਹੁ ਸੋ ਬਿਧਿ ਪਰਹਰੈ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਨ੍ਰਿਪ ਜੋਗ ਨ ਐਸੀ ਨਾਰੀ ॥",
      "s": 14
    }
  ]
}
