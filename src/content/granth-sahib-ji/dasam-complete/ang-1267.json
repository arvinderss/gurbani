{
  "page": 1267,
  "lines": [
    {
      "t": "ਬ੍ਰਹਮਾ ਕਰੀ ਬਿਸਨ ਕੀ ਸੇਵਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਭਏ ਕ੍ਰਿਸਨ ਜਗ ਦੇਵਾ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਮੁਰ ਦਾਨਵ ਕੋ ਕੰਸ ਵਤਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਰਤ ਪੂਰਬ ਲੌ ਦ੍ਰੋਹ ਸੰਭਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਵਾ ਕੇ ਕਰਤ ਹਨਨ ਕੇ ਦਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਤਪ੍ਰਤਿ ਆਸੁਰਨ ਤਹਾ ਪਠਾਵੈ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਥਮ ਪੂਤਨਾ ਕ੍ਰਿਸਨ ਸੰਘਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਪੁਨਿ ਸਕਟਾਸੁਰ ਦੇਹ ਉਧਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਬਕਾਸੁਰ ਅਸੁਰ ਸੰਘਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬ੍ਰਿਖਭਾਸੁਰ ਕੇ ਬ੍ਰਿਖਨ ਉਪਾਰਿਯੋ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਆਘਾਸੁਰ ਕੋ ਅਘ ਨਿਵਰਤ ਕਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਪੁਨਿ ਕੇਸੀ ਮਾਰਿਯੋ ਚਰਨਨ ਧਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਬ੍ਰਹਮ ਕਹ ਚਰਿਤ ਦਿਖਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਧਰਿ ਕਰਿ ਪਰ ਗਿਰ ਇੰਦ੍ਰ ਹਰਾਯੋ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਨੰਦਹਿ ਛੀਨ ਬਰਨ ਤੇ ਲ੍ਯਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੰਦੀਪਨ ਕੇ ਸੁਤਹਿ ਮਿਲਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਦਾਵਾਨਲ ਤੇ ਗੋਪ ਉਬਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਗੋਪਨ ਸੌ ਬ੍ਰਿਜ ਕਰੇ ਅਖਾਰੇ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਕੁਬਲਯਾ ਗਜ ਕੋ ਦਾਤ ਲਯੋ ਹਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਚਾਡੂਰਹਿ ਮੁਸਟਕਹਿ ਪ੍ਰਹਰਿ ਕਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਪਕਰਿ ਕੇਸ ਤੇ ਕੰਸ ਪਛਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਉਪ੍ਰਸੈਨ ਸਿਰ ਛਤ੍ਰਹਿ ਢਾਰਾ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਜਰਾਸਿੰਧੁ ਕੀ ਚਮੂੰ ਸੰਘਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੰਖ ਲਯੋ ਸੰਖਾਸੁਰ ਮਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਨਗਰ ਦ੍ਵਾਰਿਕਾ ਕੀਯਾ ਪ੍ਰਵੇਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਸ ਦੇਸ ਕੇ ਜੀਤਿ ਨਰੇਸਾ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਦੰਤਬਕ੍ਰ ਨਰਕਾਸੁਰ ਘਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੋਰਹ ਸਹਸ ਬਧੂ ਬਰਿ ਲ੍ਯਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪਾਰਜਾਤ ਸੁਰ ਪੁਰ ਤੇ ਲ੍ਰਯਾਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਿੰਦ੍ਰਾਬਨ ਮਹਿ ਖੇਲ ਦਿਖਾਯਾ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਪੰਡ੍ਵਨ ਕੀ ਜਿਨ ਕਰੀ ਜਿਤਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਦ੍ਰੁਪਦ ਸੁਤਾ ਕੀ ਲਾਜ ਉਬਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਕੌਰਵ ਕੇ ਦਲਹਿ ਖਪਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੰਤਹਿ ਆਂਚ ਨ ਲਾਗਨ ਪਾਈ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਸੂਚਨਤਾ ਜੌ ਕਰਿ ਜੈਯੈ ॥",
      "s": 14
    },
    {
      "t": "ਗ੍ਰੰਥ ਬਢਨ ਤੇ ਅਧਿਕ ਡਰੈਯੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਥੋਰੀ ਕਥਾ ਉਚਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਚੂਕ ਹੋਇ ਕਬਿ ਲੇਹੁ ਸੁਧਾਰੀ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਮੈ ਕਹਤ ਕਥਾ ਰੁਕਮਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਛਲ ਬਰਿਯੋ ਕ੍ਰਿਸਨ ਸੋ ਧਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਲਿਖਿ ਪਤਿਯਾ ਦਿਜ ਹਾਥ ਪਠਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਿਯਹੁ ਮਹਾਰਾਜ ਤਨ ਜਾਈ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਸਵੈਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਬ੍ਯਾਹ ਬਦ੍ਯੋ ਸਿਸਪਾਲ ਭਏ ਸੁਈ ਜੋਰਿ ਬਰਾਤ ਬਿਯਾਹਨ ਆਏ ॥",
      "s": 14
    },
    {
      "t": "ਹੌ ਅਟਕੀ ਮਧਸੂਦਨ ਸੌ ਜਿਨ ਕੀ ਛਬਿ ਹਾਟਕ ਹੇਰਿ ਹਿਰਾਏ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚਾਤ੍ਰਿਕ ਕੀ ਜਿਮਿ ਪ੍ਯਾਸ ਘਟੇ ਨ ਬਿਨਾ ਘਨ ਸੇ ਘਨ ਸ੍ਯਾਮ ਸੁਹਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਹਾਰੀ ਗਿਰੀ ਨ ਹਿਰਿਯੋ ਹਿਯ ਕੋ ਦੁਖ ਹੇਰਿ ਰਹੀ ਨ ਹਹਾ ਹਰਿ ਆਏ ॥੧੨॥",
      "v": [
        [
          5,
          2
        ],
        [
          10,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    }
  ]
}
