{
  "page": 1277,
  "lines": [
    {
      "t": "ਨਿਤ ਪ੍ਰਤਿ ਤਾ ਸੌ ਕਰਤ ਬਿਲਾਸਾ ॥੩੪॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਪਚੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੨੫॥੬੧੪੨॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਗਹਰਵਾਰ ਰਾਜਾ ਇਕ ਅਤਿ ਬਲ ॥",
      "s": 14
    },
    {
      "t": "ਕਬੈ ਨ ਚਲਿਯਾ ਪੀਰ ਹਲਾਚਲ ॥",
      "s": 14
    },
    {
      "t": "ਗੂੜ੍ਰਹ ਮਤੀ ਨਾਰੀ ਤਾ ਕੇ ਘਰ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੀ ਨ ਪਰਤ ਪ੍ਰਭਾ ਤਾ ਕੀ ਬਰ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਇਕ ਹੁਤੋ ਸਾਹ ਬਡਭਾਗੀ ॥",
      "s": 14
    },
    {
      "t": "ਰੂਪਵਾਨ ਗੁਨਵਾਨ ਨੁਰਾਗੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਕਚ ਮਤੀ ਦੁਹਿਤਾ ਤਾ ਕੇ ਘਰ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਗਟ ਭਈ ਜਨੁ ਕਲਾ ਕਿਰਣਿਧਰ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਤਹਾ ਬੈਪਾਰੀ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਮਿਤ ਦਰਬ ਨਹਿ ਜਾਤ ਗਨਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਵਿਤ੍ਰ ਜਾਇਫਰ ਉਸਟੈ ਭਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਲੌਂਗ ਲਾਯਚੀ ਕਵਨ ਉਚਰੇ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਉਤਰਤ ਧਾਮ ਤਵਨ ਕੇ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮਿਲਬੋ ਕਾਜ ਸਾਹ ਸੰਗ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਹਿਤ ਘਾਤ ਤਵਨ ਕੀ ਪਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਕਲ ਦਰਬੁ ਤਿਹ ਲਿਯੋ ਚੁਰਾਈ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਮਾਤ੍ਰਾ ਗ੍ਰਿਹ ਕੀ ਸਕਲ ਨਿਕਾਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਦਈ ਬਹੁਰਿ ਤਹ ਆਗਿ ਪ੍ਰਜਾਰ ॥",
      "s": 14
    },
    {
      "t": "ਰੋਵਤ ਸੁਤਾ ਪਿਤਾ ਪਹਿ ਆਈ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਜਰਿਯੋ ਧਾਮ ਕਹਿ ਤਾਹਿ ਸੁਨਾਈ ॥੫॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸੁਨ ਤ੍ਰਿਯ ਬਚਨ ਸਾਹ ਦ੍ਵੈ ਧਾਏ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਘਰ ਕੋ ਮਾਲ ਨਿਕਾਸਨ ਆਏ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਆਗੇ ਆਇ ਨਿਹਾਰੈ ਕਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਾ ਢੇਰ ਭਸਮ ਕਾ ਤਹਾ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਸੁਤਾ ਇਮਿ ਬਚਨ ਉਚਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਯਹੈ ਪਿਤਾ ਦੁਖ ਹ੍ਰਿਦੈ ਹਮਾਰੇ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਆਪਨਿ ਗਏ ਕਾ ਸੋਕ ਨ ਆਵਾ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਯਾ ਕੋ ਲਗਤ ਹਮੈ ਪਛਤਾਵਾ ॥੭॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਪੁਨਿ ਸੁਤਾ ਕੌ ਅਸ ਸਾਹ ਉਚਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਸੋਈ ਭਯੋ ਜੁ ਲਿਖਿਯੋ ਹਮਾਰੇ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤੁਮ ਯਾ ਕੋ ਕਛੁ ਸੋਕ ਕਰਹੁ ਜਿਨ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਦੈ ਹੋ ਦਰਬੁ ਜਰਿਯੋ ਜਿਤਨੋ ਇਨ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਵ ਨ ਕਛੁ ਜੜ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੂੰਡ ਮੁੰਡਾਇ ਬਹੁਰਿ ਘਰ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਰਮ ਰੇਖ ਅਪਨੀ ਪਹਿਚਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯ ਚਰਿਤ੍ਰ ਕੀ ਰੀਤਿ ਨ ਜਾਨੀ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਸਾਹੁ ਸੁਤਾ ਇਹ ਛਲ ਧਨ ਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਨ ਤਾ ਕੇ ਪਿਤੈ ਬਿਚਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਯਾਨਾ ਹੁਤੋ ਭੇਦ ਨਹਿ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਨੁ ਲਾਗੇ ਜਲ ਮੂੰਡ ਮੁੰਡਾਯੋ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਛਬੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੨੬॥੬੧੫੨॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਚਲਾਵਤੀ ਨਗਰ ਇਕ ਸੋਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਅਚਲ ਸੈਨ ਰਾਜਾ ਤਹ ਕੋਹੈ ॥",
