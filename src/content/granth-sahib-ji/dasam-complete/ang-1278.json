{
  "page": 1278,
  "lines": [
    {
      "t": "ਅਚਲ ਦੇਇ ਤਾ ਕੇ ਘਰ ਰਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੁੰਦਰਿ ਭਵਨ ਚਤ੍ਰਦਸ ਜਾਨੀ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਅਚਲ ਮਤੀ ਦੂਸਰ ਤਿਹ ਦਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਸੁੰਦਰਿ ਹੁਤੀ ਅਪਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਸੌ ਨ੍ਰਿਪ ਕੋ ਨੇਹ ਅਪਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨਤ ਊਚ ਨੀਚ ਤਿਹ ਪ੍ਯਾਰਾ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਦੁਤਿਯ ਨਾਰਿ ਅਸ ਚਰਿਤ ਬਿਚਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਨਾਰਿ ਕੇ ਸਾਥ ਸਿਖਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੋ ਭਰਿਯੋ ਦਰਬ ਸੌ ਧਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨਤ ਅਵਰ ਨ ਦੂਜੀ ਬਾਮਾ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਸਭ ਅਰਧ ਰਾਤ੍ਰਿ ਸ੍ਵੈ ਜਾਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਗਤ ਰਹੈ ਏਕ ਜਨ ਨਾਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਦੀਪ ਜਰਿਯੋ ਧੌਲਰ ਜਬ ਲਹਿਯਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤੁਮ ਅਸ ਰਾਜਾ ਸੌ ਕਹਿਯਹੁ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਮਾਯਾ ਗਡੀ ਮੋਹਿ ਨ੍ਰਿਪ ਜਾਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਬਾਤ ਮੈ ਤੁਮੈ ਬਖਾਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਛਲਾ ਦੇ ਤ੍ਰਿਯ ਕੌ ਬਲਿ ਦੈ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਗ੍ਰਿਹ ਲੈ ਜਾਹਿ ਕਾਢਿ ਮੁਹਿ ਲੈ ਕੈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਅਛਲਾ ਦੇ ਜਬ ਹੀ ਸੁਨਿ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਉਲਟਿ ਭੇਦ ਤਿਹ ਤ੍ਰਿਯਹਿ ਸਿਖਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਬਾਤ ਮਾਗੇ ਮੁਹਿ ਦੇਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਪਹਿ ਨਾਮ ਤਿਸੀ ਕਾ ਲੇਹੁ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਥਮੈ ਅਧਿਕ ਦਰਬੁ ਤਿਹ ਦਿਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਗਨੋ ਦਰਬ ਦੇਨ ਤਿਹ ਕਿਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਸਹੇਟ ਉਤ ਦੀਪ ਜਗਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਇਸਤ੍ਰੀ ਇਮਿ ਭਾਖਿ ਸੁਨਾਯੋ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਹੇ ਨ੍ਰਿਪ ਮੁਹਿ ਮਾਯਾ ਤੁਮ ਜਾਨੋ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਬਿਕਟ ਕੇਤੁ ਕੀ ਗਡੀ ਪਛਾਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਪਨੀ ਇਸਤ੍ਰੀ ਕਹ ਬਲਿ ਦੈ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਤੇ ਭਖਹੁ ਕਾਢਿ ਧਨ ਲੈ ਕੈ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਸਾਥ ਜਹਾ ਨ੍ਰਿਪ ਸੋਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਰਧਿਕ ਰਾਤ੍ਰਿ ਬਚਨ ਤਹ ਹੋਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੁਹਿ ਮਾਯਾ ਕੌ ਘਰ ਹੀ ਰਾਖਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਇਸਤ੍ਰੀ ਦੈ ਅਪਨੀ ਬਲਿ ਭਾਖਹੁ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਜਿਨ ਇਸਤ੍ਰੀ ਇਹ ਚਰਿਤ ਬਨਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਹੀ ਕੋ ਨ੍ਰਿਪ ਨਾਮ ਸੁਨਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜਾ ਲੋਭ ਦਰਬ ਕੇ ਮਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਸੀ ਨਾਰਿ ਕਹ ਬਲਿ ਦੈ ਡਾਰੇ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਜਿਨਹੁ ਨਾਰਿ ਕੌ ਮਤੋ ਸਿਖਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪਲਟਿ ਕਾਮ ਤਾਹੀ ਕੇ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਉਨ ਤ੍ਰਿਯ ਦਰਬ ਤਾਹਿ ਬਹੁ ਦ੍ਰਯਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਰਿ ਤਿਸੀ ਕੌ ਹਨ੍ਯੌ ਬਨਾਇ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਬੁਰੀ ਬਾਤ ਜੋ ਕੋਈ ਬਨਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਉਲਟਿ ਕਾਮ ਤਾਹੀ ਕੇ ਆਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਜੈਸਾ ਕਿਯੋ ਤੈਸ ਫਲ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਹਨਤ ਥੀ ਆਪੁ ਹਨਾਯੋ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਸਤਾਈਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੨੭॥੬੧੬੪॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    }
  ]
}
