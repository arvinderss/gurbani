{
  "page": 1279,
  "lines": [
    {
      "t": "ਥੰਭਕਰਨ ਇਕ ਥੰਭ੍ਰ ਦੇਸ ਨ੍ਰਿਪ ॥",
      "s": 14
    },
    {
      "t": "ਸਿਖ੍ਯ ਸਾਧੁ ਕੋ ਦੁਸਟਨ ਕੋ ਰਿਪੁ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੇ ਸ੍ਵਾਨ ਏਕ ਥੋ ਆਛਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੁੰਦਰ ਘਨੋ ਸਿੰਘ ਸੋ ਕਾਛਾ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਦਿਨ ਧਾਮ ਨ੍ਰਿਪਤਿ ਕੇ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪਾਹਨ ਹਨਿ ਤਿਹ ਤਾਹਿ ਹਟਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯ ਕੀ ਹੁਤੀ ਸ੍ਵਾਨ ਸੌ ਪ੍ਰੀਤਾ ॥",
      "s": 14
    },
    {
      "t": "ਪਾਹਨ ਲਗੇ ਭਯੋ ਦੁਖ ਚੀਤਾ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਪਾਹਨ ਲਗੇ ਸ੍ਵਾਨ ਮਰਿ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਦੋਸ ਨ੍ਰਿਪਤਿ ਕਹ ਦਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮਰਿਯੋ ਸ੍ਵਾਨ ਭਯੋ ਕਹਾ ਉਚਾਰਾ ॥",
      "v": [
        [
          3,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਐਸੇ ਹਮਰੇ ਪਰੈ ਹਜਾਰਾ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਤੈ ਯਾ ਕੌ ਪੀਰ ਪਛਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੋ ਭਾਤਿ ਪੂਜਿ ਹੈ ਨਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਿਯੋ ਸਹੀ ਤਬ ਯਾਹਿ ਪੁਜਾਊ ॥",
      "s": 14
    },
    {
      "t": "ਭਲੇ ਭਲੇ ਤੇ ਨੀਰ ਭਰਾਊ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਕੁਤਬ ਸਾਹ ਰਾਖਾ ਤਿਹ ਨਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਹੀ ਖੋਦਿ ਭੂਅ ਗਾਡਿਯੋ ਬਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੀ ਗੋਰ ਬਣਾਈ ਐਸੀ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਸੀ ਪੀਰ ਕੀ ਹੋਇ ਨ ਜੈਸੀ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਦਿਨ ਆਪੁ ਤਹਾ ਤ੍ਰਿਯ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਿਰਨੀ ਕਛੂ ਚੜਾਵਤ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਮੰਨਤਿ ਮੋਰਿ ਕਹੀ ਬਰ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਪਨਾ ਦਿਯੋ ਪੀਰ ਸੁਖਦਾਈ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਮੋਹਿ ਸੋਵਤੇ ਪੀਰ ਜਗਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਆਪੁ ਆਪਨੀ ਕਬੁਰ ਬਤਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਮੈ ਇਹ ਠੌਰ ਪਛਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਹਮਰੀ ਮਨਸਾ ਬਰ ਆਨੀ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਜਬ ਪੁਰ ਮੈ ਸੁਨਿ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜ੍ਰਯਾਰਤਿ ਸਕਲ ਲੋਗ ਮਿਲਿ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਸੀਰਨੀ ਚੜਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਚੂੰਬਿ ਕਬੁਰ ਕੂਕਰ ਕੀ ਜਾਵੈ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਕਾਜੀ ਸੇਖ ਸੈਯਦ ਤਹ ਆਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਪੜਿ ਫਾਤਯਾ ਸੀਰਨੀ ਬਟਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਧੂਰਿ ਸਮਸ ਝਾਰੂਅਨ ਉਡਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਚੂੰਮਿ ਕਬੁਰ ਕੂਕਰ ਕੀ ਜਾਹੀ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਅਪਨੈ ਸ੍ਵਾਨ ਕੋ ਚਰਿਤ ਦਿਖਾਯੋ ਬਾਮ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਅਬ ਲਗਿ ਕਹ ਜ੍ਰਯਾਰਤਿ ਕਰੈ ਸਾਹੁ ਕੁਤਬ ਦੀ ਨਾਮ ॥੧੦॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਅਠਾਈਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੨੮॥੬੧੭੪॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਜਿਯਾਵਤੀ ਨਗਰ ਇਕ ਸੋਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਬ੍ਰਿਭ੍ਰਮ ਸੈਨ ਨ੍ਰਿਪਤਿ ਤਹ ਕੋਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਬ੍ਰਯਾਘ੍ਰ ਮਤੀ ਤਾ ਕੇ ਘਰ ਦਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਚੰਦ੍ਰ ਲਯੋ ਤਾ ਤੇ ਉਜਿਯਾਰਾ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਠਾ ਹੁਤੀ ਏਕ ਪਨਿਹਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਕੇ ਬਾਰ ਭਰਤ ਥੀ ਦ੍ਵਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਕੰਚਨ ਕੇ ਭੂਖਨ ਲਹਿ ਕੈ ॥",
      "s": 14
    }
  ]
}
