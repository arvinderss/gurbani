  "lines": [
    {
      "t": "ਆਪੁ ਆਪ ਮਹਿ ਤੇਊ ਨ ਜਾਨੈ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਾ ਲਖਾ ਤ੍ਰਿਯ ਕਰਮ ਕਰਿ ਕੈਸੇ ਕਰਮ ਕਮਾਇ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਸਭ ਆਪੁ ਮਹਿ ਸਕਾ ਨ ਕੋਊ ਪਾਇ ॥੧੨॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਤੇਤੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੩੩॥੬੨੪੦॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਸੈਨ ਇਕ ਰਾਜਾ ਦਛਿਨ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯ ਤਿਹ ਰਾਜ ਮਤੀ ਸੁਭ ਲਛਨ ॥",
      "s": 14
    },
    {
      "t": "ਅਮਿਤ ਦਰਬ ਤਨ ਭਰੇ ਭੰਡਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਨ ਕੋ ਆਵਤ ਵਾਰ ਨ ਪਾਰਾ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਪਿੰਗਲ ਦੇ ਤਹ ਸਾਹ ਦੁਲਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੀ ਸਮ ਨਹਿ ਦੁਤਿਯ ਕੁਮਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਿ ਨ੍ਰਿਪਤਿ ਤ੍ਰਿਯ ਭਈ ਦਿਵਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤੇ ਰੁਚਤ ਖਾਨ ਨਹਿ ਪਾਨੀ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੀ ਲਗਨਿ ਨ੍ਰਿਪਤਿ ਤਨ ਲਾਗੀ ॥",
      "s": 14
    },
    {
      "t": "ਛੂਟੈ ਕਹਾ ਅਨੋਖੀ ਜਾਗੀ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸਖੀ ਚੀਨਿ ਇਕ ਹਿਤੂ ਸ੍ਯਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਪਠੈ ਦਈ ਨ੍ਰਿਪ ਕੀ ਰਜਧਾਨੀ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਜਿਮਿ ਤਿਮਿ ਬਦਾ ਮਿਲਨ ਤਿਹ ਸੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਤਨ ਬ੍ਯਾਪਿਯੋ ਅਧਿਕ ਅਨੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਭੇਟਨ ਕੌ ਚਿਤ ਲਲਚਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਘਾਤ ਨ ਨਿਕਸਨ ਕੀ ਤ੍ਰਿਯ ਪਾਵੈ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਕਹਿਯੋ ਸਾਹੁ ਇਕ ਭੂਪ ਬੁਲਾਵਤ ॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਅੰਨਨ ਕੋ ਨਿਰਖ ਲਿਖਾਵਤ ॥",
      "s": 14
    },
    {
      "t": "ਬਚਨ ਸੁਨਤ ਤਹ ਸਾਹੁ ਸਿਧਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਭਲੋ ਬੁਰੋ ਨਹਿ ਮੂੜ ਬਿਚਾਰਾ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਨਿਕਸਤ ਭਈ ਘਾਤ ਤ੍ਰਿਯ ਪਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਭੋਗ ਕੀਆ ਰਾਜਾ ਸੋ ਜਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਰਹਿਯੋ ਮੂੜ ਪਰ ਦ੍ਵਾਰ ਬਹਿਠੋ ॥",
      "s": 14
    },
    {
      "t": "ਭਲਾ ਬੁਰਾ ਕਛੁ ਲਗਿਯੋ ਨ ਡਿਠੋ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯ ਕਰਿ ਕੇਲ ਭੂਪ ਸੌ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਲਯੋ ਸਾਹੁ ਘਰ ਬਹੁਰਿ ਬੁਲਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਿਯੋ ਪ੍ਰਾਤ ਹਮ ਤੁਮ ਦੋਊ ਜੈ ਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜਾ ਕਹਤ ਵਹੈ ਕਰਿ ਐਹੈ ॥੭॥",
      "s": 14
    },
