{
  "page": 1286,
  "lines": [
    {
      "t": "ਕਹ ਲਗਿ ਪ੍ਰਭਾ ਕਰੈ ਕਵਨੈ ਕਬਿ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਿ ਸੂਰ ਸਸਿ ਰਹਤ ਇੰਦ੍ਰ ਦਬਿ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਛੈਲ ਛਬੀਲੋ ਕੁਅਰ ਅਪਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਆਪੁ ਘੜਾ ਜਾਨੁਕ ਕਰਤਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਨਕ ਅਵਟਿ ਸਾਚੇ ਜਨ ਢਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰੀਝਿ ਰਹਤ ਜਿਨ ਬ੍ਰਹਮ ਸਵਾਰਿਯੋ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਨੈਨ ਫਬਤ ਮ੍ਰਿਗ ਸੇ ਕਜਰਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਕੇਸ ਜਾਲ ਜਨੁ ਫਾਸ ਸਵਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੇ ਪਰੇ ਗਰੈ ਸੋਈ ਜਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਨੁ ਬੂਝੈ ਕੋਈ ਕਹਾ ਪਛਾਨੈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਜੇਤਿਕ ਦੇਤ ਪ੍ਰਭਾ ਸਭ ਹੀ ਕਬਿ ॥",
      "s": 14
    },
    {
      "t": "ਤੇਤਿਕ ਹੁਤੀ ਤਵਨ ਭੀਤਰਿ ਛਬਿ ॥",
      "s": 14
    },
    {
      "t": "ਪੁਰਖ ਨਾਰਿ ਚਿਤਵਹ ਜੋ ਤਾਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਕਛੁ ਨ ਸੰਭਾਰ ਰਹਤ ਤਬ ਵਾਹਿ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਚੰਚਰੀਟ ਦੁਤਿ ਦੇਖਿ ਬਿਕਾਨੇ ॥",
      "s": 14
    },
    {
      "t": "ਭਵਰ ਆਜੁ ਲਗਿ ਫਿਰਤਿ ਦਿਵਾਨੇ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾਦੇਵ ਤੇ ਨੈਕ ਨਿਹਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਲਗਿ ਬਨ ਮੈ ਬਸਤ ਉਘਾਰੇ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਅੜਿਲ ॥",
      "s": 14
    },
    {
      "t": "ਚਤੁਰਾਨਨ ਮੁਖ ਚਤੁਰ ਲਖਿ ਯਾਹੀ ਤੇ ਕਰੈ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸਿਖਿ ਬਾਹਨ ਖਟ ਬਦਨ ਸੁ ਯਾਹੀ ਤੇ ਧਰੈ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਪੰਚਾਨਨ ਯਾ ਤੇ ਸਿਵ ਭਏ ਬਚਾਰਿ ਕਰਿ ॥",
      "v": [
        [
          2,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਹੋ ਸਹਸਾਨਨ ਨਹੁ ਸਕਾ ਪ੍ਰਭਾ ਕੋ ਸਿੰਧੁ ਤਰਿ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਜੇ ਅਬਲਾ ਤਿਹ ਰੂਪ ਨਿਹਾਰਤ ॥",
      "s": 14
    },
    {
      "t": "ਲਾਜ ਸਾਜ ਧਨ ਧਾਮ ਬਿਸਾਰਤ ॥",
      "s": 14
    },
    {
      "t": "ਮਨ ਮੈ ਰਹਤ ਮਗਨ ਹ੍ਵੈ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨੁ ਬਿਸਿਖ ਤਨ ਮ੍ਰਿਗੀ ਪ੍ਰਹਾਰੀ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਸਾਹ ਜੈਨ ਅਲਾਵਦੀਨ ਜਹ ॥",
      "s": 14
    },
    {
      "t": "ਆਯੋ ਕੁਅਰ ਰਹਨ ਚਾਕਰ ਤਹ ॥",
      "s": 14
    },
    {
      "t": "ਫੂਲਮਤੀ ਹਜਰਤਿ ਕੀ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੇ ਗ੍ਰਿਹ ਇਕ ਭਈ ਕੁਮਾਰੀ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਦਿਮਾਗ ਰੋਸਨ ਵਹ ਬਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁ ਰਤਿ ਪਤਿ ਤੇ ਭਈ ਕੁਮਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁਕ ਚੀਰਿ ਚੰਦ੍ਰਮਾ ਬਨਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹੀ ਤੇ ਤਾ ਮੈ ਅਤਿਤਾਈ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਬੀਰਮ ਦੇ ਮੁਜਰਾ ਕਹ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਹੁ ਸੁਤਾ ਕੋ ਹ੍ਰਿਦੈ ਚੁਰਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਨਿਕ ਜਤਨ ਅਬਲਾ ਕਰਿ ਹਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਕੈ ਸਿਹੁ ਮਿਲਾ ਨ ਪ੍ਰੀਤਮ ਪ੍ਯਾਰੀ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਕਾਮਾਤੁਰ ਭੀ ਅਧਿਕ ਬਿਗਮ ਜਬ ॥",
      "s": 14
    },
    {
      "t": "ਪਿਤਾ ਪਾਸ ਤਜਿ ਲਾਜ ਕਹੀ ਤਬ ॥",
      "s": 14
    },
    {
      "t": "ਕੈ ਬਾਬੁਲ ਗ੍ਰਿਹ ਗੋਰਿ ਖੁਦਾਓ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਕੈ ਬੀਰਮ ਦੇ ਮੁਹਿ ਬਰ ਦ੍ਰਯਾਓ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਭਲੀ ਭਲੀ ਤਬ ਸਾਹ ਉਚਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਮੁਸਲਮਾਨ ਬੀਰਮ ਕਰ ਪ੍ਯਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਤਾਹਿ ਤੁਮ ਕਰੌ ਨਿਕਾਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਸੌ ਤੁਮਰੀ ਲਗੀ ਨਿਗਾਹਾ ॥੧੪॥",
      "s": 14
    }
  ]
}
