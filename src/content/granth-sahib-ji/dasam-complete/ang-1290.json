{
  "page": 1290,
  "lines": [
    {
      "t": "ਚਾਹਤ ਤੁਮ ਸੌ ਜੂਪ ਮਚਾਯੋ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਕੇ ਤੀਰ ਤਰੁਨਿ ਤਬ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁ ਬਿਧਿ ਜੂਪ ਮਚਾਵਤ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਦਰਬ ਤਿਨ ਭੂਪ ਹਰਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬ੍ਰਹਮਾ ਤੇ ਨਹਿ ਜਾਤ ਗਨਾਯੋ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਨ੍ਰਿਪ ਦਰਬ ਬਹੁਤ ਬਿਧਿ ਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਤ ਊਪਰ ਪਾਸਾ ਤਬ ਢਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਵਹੈ ਹਰਾਯੋ ਦੇਸ ਲਗਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜੀਤਾ ਕੁਅਰ ਭਜ੍ਯੋ ਮਨ ਭਾਯੋ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜੀਤਿ ਸਕਲ ਧਨ ਤਵਨ ਕੋ ਦੀਨਾ ਦੇਸ ਨਿਕਾਰ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਕੁਅਰ ਜੀਤਿ ਕਰਿ ਪਤਿ ਕਰਾ ਬਸੀ ਧਾਮ ਹ੍ਵੈ ਨਾਰ ॥੧੧॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੰਚਲਾਨ ਕੇ ਚਰਿਤ ਕੋ ਸਕਤ ਨ ਕੋਈ ਬਿਚਾਰ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਬ੍ਰਹਮ ਬਿਸਨ ਸਿਵ ਖਟ ਬਦਨ ਜਿਨ ਸਿਰਜੀ ਕਰਤਾਰ ॥੧੨॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਛਤੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੩੬॥੬੩੦੭॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਮਲ ਸੈਨ ਰਾਜਾ ਬਲਵਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਤੀਨ ਲੋਕ ਮਾਨਤ ਜਿਹ ਆਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਮਲਾ ਟੋਡੀ ਕੋ ਨਰਪਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੂਰਬੀਰ ਅਰੁ ਬੁਧਿ ਬਿਸਾਲਾ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਸੋਰਠ ਦੇ ਰਾਨੀ ਤਿਹ ਸੁਨਿਯਤ ॥",
      "s": 14
    },
    {
      "t": "ਦਾਨ ਸੀਲ ਜਾ ਕੋ ਜਗ ਗੁਨਿਯਤ ॥",
      "s": 14
    },
    {
      "t": "ਪਰਜ ਮਤੀ ਦੁਹਿਤਾ ਇਕ ਤਾ ਕੀ ॥",
      "s": 14
    },
    {
      "t": "ਨਰੀ ਨਾਗਨੀ ਸਮ ਨਹਿ ਜਾ ਕੀ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਬਿਸਹਰ ਕੋ ਇਕ ਹੁਤੋ ਨ੍ਰਿਪਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਆਯੋ ਗੜ ਜਮਲਾ ਕਿਹ ਕਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਛਾਛ ਕਾਮਨੀ ਕੀ ਪੂਜਾ ਹਿਤ ॥",
      "s": 14
    },
    {
      "t": "ਮਨ ਕ੍ਰਮ ਬਚਨ ਇਹੈ ਕਰਿ ਕਰਿ ਬ੍ਰਤ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਠਾਢਿ ਪਰਜ ਦੇ ਨੀਕ ਨਿਵਾਸਨ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਕੁਅਰ ਨਿਰਖਾ ਦੁਖ ਨਾਸਨ ॥",
      "s": 14
    },
    {
      "t": "ਇਹੈ ਚਿਤ ਮੈ ਕੀਅਸਿ ਬਿਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਰੌ ਯਾਹਿ ਕਰਿ ਕਵਨ ਪ੍ਰਕਾਰਾ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਸਖੀ ਭੇਜਿ ਤਿਹ ਧਾਮ ਬੁਲਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਕੋ ਭੋਗ ਕਮਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਉਪਦੇਸ ਤਵਨ ਕਹ ਦਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਗੌਰਿ ਪੁਜਾਇ ਬਿਦਾ ਕਰ ਗਯੋ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਬਿਦਾ ਕੀਆ ਤਿਹ ਐਸ ਸਿਖਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਆਪੁ ਨ੍ਰਿਪਤਿ ਸੋ ਕਹੀ ਜਤਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਮਨੀਕਰਨ ਤੀਰਥ ਮੈ ਜੈ ਹੌ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਇ ਧੋਇ ਜਮਲਾ ਫਿਰਿ ਐ ਹੌ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਜਾਤ ਤੀਰਥ ਜਾਤ੍ਰਾ ਕਹ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਹਿਰ ਬੇਸਹਿਰ ਮੋ ਚਲਿ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਹੋਤ ਤਵਨ ਸੌ ਭੇਦ ਜਤਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮਨ ਮਾਨਤ ਕੇ ਭੋਗ ਕਮਾਯੋ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਕਰਿ ਕੈ ਘਰ ਰਾਖੀ ॥",
      "s": 14
    },
    {
      "t": "ਰਛਪਾਲਕਨ ਸੋ ਅਸ ਭਾਖੀ ॥",
      "s": 14
    },
    {
      "t": "ਬੇਗਿ ਨਗਰ ਤੇ ਇਨੈ ਨਿਕਾਰਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਹਾਥ ਉਠਾਵੈ ਤਿਹ ਹਨਿ ਮਾਰਹੁ ॥੮॥",
      "s": 14
    }
  ]
}
