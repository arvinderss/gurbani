{
  "page": 1292,
  "lines": [
    {
      "t": "ਕਿਨਹੂੰ ਬਾਤ ਜਾਨਿ ਨਹਿ ਲਈ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਮੂਰਖ ਰਾਇ ਬਾਇ ਮੁਖ ਰਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਭਲਾ ਬੁਰਾ ਕਛੁ ਤਾਹਿ ਨ ਕਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਰਿ ਜਾਰਿ ਕੇ ਸਾਥ ਸਿਧਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਤ ਭੇਦ ਕੀ ਕਿਨਹੁ ਨ ਪਾਈ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯ ਕੋ ਚਰਿਤ ਨ ਬਿਧਨਾ ਜਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਰੁਦ੍ਰ ਭੀ ਕਛੁ ਨ ਪਛਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਇਨ ਕੀ ਬਾਤ ਏਕ ਹੀ ਪਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਨ ਇਸਤ੍ਰੀ ਜਗਦੀਸ ਬਨਾਈ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਅਠਤੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੩੮॥੬੩੨੯॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਿਯਤ ਇਕ ਨਗਰੀ ਉਜਿਯਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਸੁਕਰਮਾ ਨਿਜੁ ਹਾਥ ਸਵਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਮੁ ਅਲੂਰਾ ਤਾ ਕੋ ਸੋਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਤੀਨੋ ਲੋਕ ਰਚਿਤ ਤਿਨ ਮੋਹੈ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਭੂਪ ਭਦ੍ਰ ਤਿਹ ਗੜ ਕੋ ਰਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਪਾਟ ਤਾਹੀ ਕਹ ਛਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਤਨ ਮਤੀ ਤਿਹ ਨ੍ਰਿਪ ਕੀ ਰਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਕੁਰੂਪ ਜਗਤ ਮਹਿ ਜਾਨੀ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੇ ਨਿਕਟ ਨ ਰਾਜਾ ਜਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਿ ਨਾਰਿ ਕੋ ਰੂਪ ਡਰਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਅਵਰ ਰਾਨਿਯਨ ਕੇ ਘਰ ਰਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਸੌ ਬੈਨ ਨ ਬੋਲਾ ਚਹੈ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਯਹ ਦੁਖ ਅਧਿਕ ਨਾਰਿ ਕੇ ਮਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਚਾਹਤ ਪ੍ਰੀਤਿ ਨ੍ਰਿਪਤਿ ਸੌ ਬਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਜਤਨ ਤਬ ਕਿਯਾ ਪਿਆਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਹੁ ਕਹਤ ਹੌ ਕਥਾ ਬਿਚਾਰੀ ॥੪॥",
      "v": [
        [
          0,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਪੂਜਾ ਕਰਤ ਲਖਿਯੋ ਜਬ ਰਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤਨ ਸਜਾ ਸਕਲ ਤ੍ਰਿਯ ਸਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਰੁਦ੍ਰ ਕੋ ਭੇਸ ਬਨਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਅਪਨੈ ਅੰਗ ਬਿਭੂਤਿ ਚੜਾਇ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਕਰਤ ਹੁਤੋ ਰਾਜਾ ਜਪੁ ਜਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਿਵ ਬਨਿ ਆਨਿ ਠਾਢਿ ਭੀ ਤਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਰਾਜੈ ਤਿਹ ਰੂਪ ਨਿਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਨ ਕ੍ਰਮ ਈਸ ਜਾਨਿ ਪਗ ਪਰਾ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਸੁਫਲ ਭਯੋ ਅਬ ਜਨਮ ਹਮਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾਦੇਵ ਕੋ ਦਰਸ ਨਿਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਿਯੋ ਕਰੀ ਮੈ ਬਡੀ ਕਮਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਤੇ ਦੀਨੀ ਰੁਦ੍ਰ ਦਿਖਾਈ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਬਰੰਬ੍ਰੂਹ ਤਿਹ ਕਹਾ ਨਾਰਿ ਤਬ ॥",
      "s": 14
    },
    {
      "t": "ਜੌ ਜੜ ਰੁਦ੍ਰ ਲਖਿਯੋ ਜਾਨਾ ਜਬ ॥",
      "s": 14
    },
    {
      "t": "ਤੈ ਮੁਰਿ ਕਰੀ ਸੇਵ ਭਾਖਾ ਅਤਿ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤਹਿ ਦਰਸੁ ਦਿਯੋ ਮੈ ਸੁਭ ਮਤਿ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਿ ਬਚ ਨਾਰਿ ਰਾਇ ਹਰਖਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਜੜ ਕਛੂ ਨ ਜਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯ ਕੇ ਚਰਨ ਰਹਾ ਲਪਟਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਰਿ ਚਰਿਤ ਕੀ ਬਾਤ ਨ ਪਾਈ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਐਸਾ ਤ੍ਰਿਯ ਕਿਯਾ ਉਚਾਰਾ ॥",
      "s": 14
    }
  ]
}
