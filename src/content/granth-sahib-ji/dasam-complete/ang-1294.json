{
  "page": 1294,
  "lines": [
    {
      "t": "ਚਤੁਰਿ ਜਾਨਿ ਤਹ ਸਖੀ ਪਠਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜ੍ਯੋਂ ਤ੍ਯੋਂ ਤਹਾ ਤਾਹਿ ਲੈ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਸੁਤਾ ਤਾ ਸੌ ਰਤਿ ਮਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਕੇਲ ਕਰਤ ਸਭ ਰਾਤਿ ਬਿਹਾਨੀ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਬਾਢਾ ਬਿਰਹ ਦੁਹਨ ਕੋ ਐਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਹਮ ਤੇ ਭਾਖਿ ਨ ਜਾਈ ਕੈਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਛੋਰਿ ਇਕ ਅਨਤ ਨ ਜਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਪਲਕ ਓਟ ਜੁਗ ਕੋਟਿ ਬਿਹਾਵੈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਕਰਿ ਬਦਾ ਸੰਕੇਤਾ ॥",
      "s": 14
    },
    {
      "t": "ਲਾਗਿਯੋ ਸਾਹ ਪੁਤ੍ਰ ਸੋ ਹੇਤਾ ॥",
      "s": 14
    },
    {
      "t": "ਮੁਹਿ ਅਪਨੇ ਲੈ ਸੰਗ ਸਿਧਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਜਾਨੌ ਤੈ ਯਾਰ ਹਮਾਰੋ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਸੌ ਰਤਿ ਕਰਿ ਧਾਮ ਸਿਧਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕੀਯਾ ਜਤਨ ਜੋ ਹਿਤੂ ਸਿਖਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਸਤ੍ਰ ਬਹੁਤ ਬਹੁ ਮੋਲ ਪਠਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਥਮ ਨ੍ਰਿਪਤਿ ਕਹ ਸਕਲ ਦਿਖਾਏ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਪੁਨਿ ਰਨਿਵਾਸਹਿ ਪਠੈ ਬਨਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਸੁਤਹਿ ਅਸ ਗਯੋ ਜਤਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਪਸੰਦ ਇਨ ਮੈ ਤੇ ਕੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਦੇ ਬਸਤ੍ਰ ਮੋਲਿ ਮੁਰਿ ਲੀਜੈ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਅੜਿਲ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਮਾਲੁ ਦਿਖਾਇ ਬਹੁਰਿ ਲੈ ਕੁਅਰਿ ਦਿਖਾਯੋ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਲਪਟਿ ਤਰੁਨਿ ਤਿਹ ਮਾਹਿ ਆਪਨੋ ਅੰਗ ਦੁਰਾਯੋ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਗਈ ਮਿਤ੍ਰ ਕੇ ਧਾਮ ਨ ਭੂਪ ਬਿਚਾਰਿਯੋ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਹੋ ਇਹ ਛਲ ਤਿਹ ਲੈ ਸਾਥ ਹਰੀਫ ਸਿਧਾਰਿਯੋ ॥੯॥",
      "v": [
        [
          5,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਗ ਨ ਭੌਦੂ ਪਿਯਤ ਥੋ ਰਾਹਤ ਭਯੌ ਪਰਬੀਨ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਦੁਹਿਤਾ ਹਰੀ ਹਰੀਫ ਯੌ ਸਕਾ ਨ ਜੜ ਛਲ ਚੀਨ ॥੧੦॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਇਕਤਾਲੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੪੧॥੬੩੬੨॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਉਤਰ ਦਿਸਾ ਪ੍ਰਗਟ ਇਕ ਨਗਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਬ੍ਰਿਜਰਾਜਵਤੀ ਸੁ ਉਜਗਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਬ੍ਰਿਜਰਾਜ ਸੈਨ ਤਹ ਰਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕਹ ਨਿਰਖਿ ਇੰਦ੍ਰ ਅਤਿ ਲਾਜਾ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਬ੍ਰਿਜਰਾਜ ਮਤੀ ਤਿਹ ਰਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੁੰਦਰਿ ਭਵਨ ਚਤਰਦਸ ਜਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਬਰੰਗਨਾ ਦੇ ਤਿਹ ਬਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁ ਨਿਰਧੂਮ ਅਗਨਿ ਕੀ ਜ੍ਵਾਲਾ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਚਤੁਰਿ ਸਖੀ ਜਬ ਤਾਹਿ ਨਿਹਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਮਧੁਰ ਬਚਨ ਮਿਲਿ ਐਸ ਉਚਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਜੈਸੀ ਇਹ ਹੈ ਦੁਤਿਯ ਨ ਜਈ ॥",
      "s": 14
    },
    {
      "t": "ਆਗੇ ਹੋਇ ਨ ਪਾਛੇ ਭਈ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਬਰੰਗਨਾ ਦੇਇ ਤਰੁਨਿ ਭੀ ॥",
      "s": 14
    },
    {
      "t": "ਲਰਿਕਾਪਨ ਕੀ ਬਾਤ ਬਿਸਰਿਗੀ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਕੁਅਰ ਤਬ ਤਾਹਿ ਨਿਹਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਪਰ ਤਰੁਨਿ ਪ੍ਰਾਨ ਕਹ ਵਾਰਿਯੋ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਸੌ ਕਾਮ ਭੋਗ ਨਿਤ ਮਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਦ੍ਵੈ ਤੈ ਏਕ ਦੇਹ ਕਰਿ ਜਾਨੈ ॥",
      "s": 14
    }
  ]
}
