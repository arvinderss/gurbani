{
  "page": 1295,
  "lines": [
    {
      "t": "ਤਬ ਚਤੁਰਾ ਇਹ ਚਰਿਤ੍ਰ ਬਿਚਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੋ ਨ੍ਰਿਪਤਿ ਸੋ ਪ੍ਰਗਟ ਉਚਾਰਿਯੋ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਮੋ ਕੌ ਸ੍ਰਾਪ ਸਦਾ ਸਿਵ ਦੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਜਨਮ ਤਿਹਾਰੇ ਲੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰਾਪ ਅਵਧਿ ਪੂਰਨ ਹ੍ਵੈ ਹੈ ਜਬ ॥",
      "s": 14
    },
    {
      "t": "ਪੁਨਿ ਜੈ ਹੌ ਹਰਿ ਲੋਕ ਬਿਖੈ ਤਬ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਦਿਨ ਗਈ ਮਿਤ੍ਰ ਕੇ ਸੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਲਿਖਿ ਪਤ੍ਰਾ ਪਰ ਅਪਨੇ ਅੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰਾਪ ਅਵਧਿ ਪੂਰਨ ਅਬ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਰਪੁਰ ਸੁਤਾ ਤਿਹਾਰੀ ਗਈ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਜੋ ਧਾਮ ਹਮਾਰੇ ਮਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਦੀਜੈ ਦਿਜ ਕੌ ਤਤਕਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਯਾਰ ਅਪਨੇ ਬ੍ਰਹਮਨ ਠਹਰਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਕਲ ਦਰਬ ਇਹ ਛਲ ਤਿਹ ਦ੍ਰਯਾਯੋ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਚਰਿਤ੍ਰ ਗੀ ਮਿਤ੍ਰਹ ਸਾਥਾ ॥",
      "s": 14
    },
    {
      "t": "ਦੈ ਧਨ ਕਿਯਾ ਅਨਾਥ ਸਨਾਥਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਤ ਪਿਤਾ ਸਭ ਅਸ ਲਖਿ ਲਈ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰਾਪ ਮੁਚਿਤ ਭਯੋ ਸੁਰਪੁਰ ਗਈ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਬਤਾਲੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੪੨॥੬੩੭੧॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੋਰਠ ਦੇਸ ਬਸਤ ਹੈ ਜਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਦਿਜਬਰ ਸੈਨ ਨਰਾਧਿਪ ਤਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਤੀ ਸੁਮੇਰ ਤਵਨ ਕੀ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਤਿਯ ਨ ਜਗ ਮੈ ਐਸਿ ਕੁਮਾਰੀ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਸੋਰਠ ਦੇਇ ਸੁਤਾ ਇਕ ਤਾ ਕੇ ॥",
      "s": 14
    },
    {
      "t": "ਔਰ ਨਾਰ ਸਮ ਤੁਲਿ ਨ ਵਾ ਕੇ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਤਿਯ ਪਰਜ ਦੇ ਭਈ ਕੁਮਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਸੀ ਦੁਤਿਯ ਨ ਬ੍ਰਹਮ ਸਵਾਰੀ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਦੋਊ ਸੁਤਾ ਤਰੁਨਿ ਜਬ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਨ ਕਰਿ ਕਿਰਣਿ ਸੂਰ ਸਸਿ ਵਈ ॥",
      "s": 14
    },
    {
      "t": "ਐਸੀ ਪ੍ਰਭਾ ਹੋਤ ਭੀ ਤਿਨ ਕੀ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਛਾ ਕਰਤ ਬਿਧਾਤਾ ਜਿਨ ਕੀ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਓਜ ਸੈਨ ਇਕ ਅਨਤ ਨ੍ਰਿਪਤਿ ਬਰ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁ ਕਰਿ ਮੈਨ ਪ੍ਰਗਟਿਯੋ ਬਪੁ ਧਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਨ੍ਰਿਪ ਖੇਲਨ ਚੜਾ ਸਿਕਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਰੋਝ ਰੀਛ ਮਾਰੇ ਝੰਖਾਰਾ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਨਿਕਸਿਯੋ ਤਹਾ ਏਕ ਝੰਖਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਦ੍ਵਾਦਸ ਜਾ ਕੇ ਸੀਗ ਅਪਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਤਿਹ ਨਿਰਖਿ ਤੁਰੰਗ ਧਵਾਵਾ ॥",
      "s": 14
    },
    {
      "t": "ਪਾਛੇ ਚਲਾ ਕੋਸ ਬਹੁ ਆਵਾ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਤ ਕੋਸ ਤਿਹ ਮ੍ਰਿਗਹਿ ਦਖੇਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਚਾਕਰ ਏਕ ਨ ਪਹੁਚਾ ਨੇਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਆਯੋ ਦੇਸ ਸੋਰਠੀ ਕੇ ਮਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਕੀ ਸੁਤਾ ਅਨਾਤ ਹੁਤੀ ਜਹਿ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਆਨਿ ਤਹੀ ਝੰਖਾਰ ਨਿਕਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਬਲਾ ਦੁਹੂੰ ਨਿਹਾਰਤਿ ਮਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਐਸਾ ਬਾਨ ਤਵਨ ਕਹ ਲਾਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਠੌਰ ਰਹਾ ਪਗ ਦ੍ਵੈਕ ਨ ਭਾਗਾ ॥੭॥",
      "s": 14
    }
  ]
}
