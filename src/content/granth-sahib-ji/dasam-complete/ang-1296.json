{
  "page": 1296,
  "lines": [
    {
      "t": "ਰਾਜ ਕੁਆਰੀ ਦੁਹੂੰ ਨਿਹਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਹੂੰ ਹ੍ਰਿਦੈ ਇਹ ਭਾਤਿ ਬਿਚਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਨੁ ਪੂਛੇ ਪਿਤੁ ਇਹ ਹਮ ਬਰਿ ਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਤਰ ਮਾਰਿ ਕਟਾਰੀ ਮਰਿ ਹੈ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਲਗੁ ਭੂਪ ਤ੍ਰਿਖਾਤੁਰ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮ੍ਰਿਗ ਕੇ ਸਹਿਤ ਤਹਾ ਚਲਿ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਮ੍ਰਿਗ ਰਾਜ ਸੁ ਤਨ ਕਹ ਦੀਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਕੋ ਸੀਤ ਬਾਰਿ ਲੈ ਪੀਯੋ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਬਾਧਾ ਬਾਜ ਏਕ ਦ੍ਰੁਮ ਕੇ ਤਰ ॥",
      "s": 14
    },
    {
      "t": "ਸੋਵਤ ਭਯੋ ਹ੍ਵੈ ਭੂਪ ਸ੍ਰਮਾਤੁਰ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਕੁਆਰਨ ਘਾਤ ਪਛਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਖਿਯਨ ਸੋ ਅਸ ਕਿਯਾ ਬਖਾਨਾ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਮਦਰਾ ਬਹੁ ਦੁਹੂੰ ਕੁਅਰਿ ਮੰਗਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਤ ਬਾਰ ਜੋ ਹੁਤੋ ਚੁਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਪਨ ਸਹਿਤ ਸਖਿਯਨ ਕੌ ਪ੍ਰਯਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਮਤ ਕਰਿ ਦਈ ਸੁਵਾਇ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਜਾਨਾ ਤੇ ਭਈ ਦਿਵਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੋਏ ਸਕਲ ਪਹਰੂਆ ਜਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਹੂੰ ਸਨਾਹੀ ਲਈ ਮੰਗਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਪਹਿਰਿ ਨਦੀ ਮੈ ਧਸੀ ਬਨਾਇ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਤਰਤ ਤਰਤ ਆਈ ਤੇ ਤਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੋਵਤ ਸੁਤੋ ਨਰਾਧਿਪ ਜਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਪਕਰਿ ਪਾਵ ਤਿਹ ਦਿਯਾ ਜਗਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਅਜਾ ਚਰਮ ਪਰ ਲਿਯਾ ਚੜਾਇ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਭੂਪਤਿ ਲਿਯਾ ਚੜਾਇ ਸਨਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਰਿਤਾ ਬੀਚ ਪਰੀ ਪੁਨਿ ਜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਰਤ ਤਰਤ ਅਪਨੋ ਤਜਿ ਦੇਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਾਪਤ ਭੀ ਤਿਹ ਦੇਸ ਨਰੇਸਾ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਕਛੁ ਸੁਧਿ ਸਖਿਯਨ ਤਿਨ ਪਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਸੰਦੇਹ ਯੌ ਹੀ ਠਹਰਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਮਦ ਸੌ ਭਈ ਜਾਨੁ ਮਤਵਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਡੂਬਿ ਮੁਈ ਦੋਊ ਰਾਜ ਦੁਲਾਰੀ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਵੈ ਦੋਊ ਨ੍ਰਿਪ ਸੰਗ ਗਈ ਅਨਿਕ ਹਿਯੇ ਹਰਖਾਤ ॥",
      "s": 14
    },
    {
      "t": "ਅਜਾ ਚਰਮ ਪਰ ਭੂਪ ਬਰ ਦੁਹੂੰਅਨ ਚਲਾ ਬਜਾਤ ॥੧੬॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਤ੍ਰਿਤਾਲੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੪੩॥੬੩੮੭॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਹਰਿਦ੍ਵਾਰ ਇਕ ਸੁਨ ਨ੍ਰਿਪਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਤੇਜਿਮਾਨ ਦੁਤਿਮਾਨ ਛਿਤਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਰਸਰੰਗ ਮਤੀ ਤਿਹ ਜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਸਮ ਦੂਸਰਿ ਬਿਧਿ ਨ ਬਨਾਈ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਵਹੁ ਤਰੁਨਿ ਤਰੁਨ ਅਤਿ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਪ ਸੈਨ ਨ੍ਰਿਪ ਕਹਿ ਪਿਤ ਦਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਿਰੀ ਨਗਰ ਭੀਤਰ ਜਬ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਲਖਿ ਚੰਡਾਲਿਕ ਅਧਿਕ ਲੁਭਾਈ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਪਠੈ ਸਹਚਰੀ ਲਿਯਾ ਬੁਲਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਸੌ ਭੋਗ ਕਥਾ ਬਿਸਰਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਰੈਨਿ ਦਿਵਸ ਤਿਹ ਲੇਤ ਬੁਲਾਈ ॥",
      "s": 14
    }
  ]
}
