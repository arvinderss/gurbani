{
  "page": 1298,
  "lines": [
    {
      "t": "ਕਰਹਿ ਬਿਲਾਸ ਪ੍ਰਜੰਕ ਚੜਿ ਹਸਿ ਹਸਿ ਨਾਰਿ ਔ ਨਾਹਿ ॥੬॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਕੇ ਆਸਨ ਲੈ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਅਬਲਾ ਕਹ ਬਹੁ ਭਾਤਿ ਰਿਝੈ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਆਪਨ ਪਰ ਘਾਯਲ ਕਰਿ ਮਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਮਦਨ ਮੋਹਨੀ ਰਾਜ ਦੁਲਾਰੀ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਬਢਾਇ ਨਾਰਿ ਸੌ ਹੇਤਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹਿ ਬਿਧਿ ਬਾਧਤ ਭਏ ਸੰਕੇਤਾ ॥",
      "s": 14
    },
    {
      "t": "ਧੂੰਈ ਕਾਲਿ ਪੀਰ ਕੀ ਐਯਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਡਾਰਿ ਭਾਗ ਹਲਵਾ ਮਹਿ ਜੈਯਹੁ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਸੋਫੀ ਜਬੈ ਚੂਰਮਾ ਖੈ ਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਜੀਯਤ ਮ੍ਰਿਤਕ ਸਭੈ ਹ੍ਵੈ ਜੈ ਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਹੀ ਕ੍ਰਿਪਾ ਕਰਿ ਤੁਮਹੂੰ ਐਯਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਮੁਹਿ ਲੈ ਸੰਗ ਦਰਬ ਜੁਤ ਜੈਯਹੁ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਹੀ ਦਿਨ ਧੂੰਈ ਕੋ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਗਿ ਡਾਰਿ ਚੂਰਮਾ ਪਕਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਕਲ ਮੁਰੀਦਨ ਗਈ ਖਵਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਖੇ ਮੂੜ ਮਤ ਕਰਿ ਸ੍ਵਾਇ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਸੋਫੀ ਭਏ ਜਬੈ ਮਤਵਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਿਥਮ ਦਰਬ ਹਰਿ ਬਸਤ੍ਰ ਉਤਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਹੂੰਅਨ ਲਿਯਾ ਦੇਸ ਕੋ ਪੰਥਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਦੈ ਸਾਜਨ ਕਹ ਸੰਥਾ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਭਯਾ ਪ੍ਰਾਤ ਸੋਫੀ ਸਭ ਜਾਗੇ ॥",
      "s": 14
    },
    {
      "t": "ਪਗਰੀ ਬਸਤ੍ਰ ਬਿਲੋਕਨ ਲਾਗੇ ॥",
      "s": 14
    },
    {
      "t": "ਸਰਵਰ ਕਹੈ ਕ੍ਰੋਧ ਕਿਯ ਭਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਭਹਿਨ ਕੌ ਅਸ ਚਰਿਤ ਦਿਖਾਰਾ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਜੜ ਰਹੋ ਤਹਾ ਮੁਖ ਬਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਲਜਾ ਮਾਨ ਮੂੰਡ ਨਿਹੁਰਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਨ ਕਿਨੂੰ ਪਛਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਰਵਰ ਕਿਯਾ ਸੁ ਸਿਰ ਪਰ ਮਾਨਾ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਤ੍ਰਿਯਾਨ ਕੋ ਸਕਤ ਨ ਕੋਊ ਪਾਇ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸਭਨ ਲਖੋ ਕੈਸੇ ਛਲਾ ਕਸ ਕਰਿ ਗਈ ਉਪਾਇ ॥੧੪॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਪੈਤਾਲੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੪੫॥੬੪੧੦॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨੁ ਰਾਜਾ ਇਕ ਕਹੌ ਕਬਿਤ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਬਿਧਿ ਅਬਲਾ ਕਿਯਾ ਚਰਿਤ ॥",
      "s": 14
    },
    {
      "t": "ਸਭਹਿਨ ਕੌ ਦਿਨ ਹੀ ਮਹਿ ਛਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਹੁ ਯਾ ਸੁੰਦਰਿ ਕੀ ਕਲਾ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਇਸਕਾਵਤੀ ਨਗਰ ਇਕ ਸੋਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਇਸਕ ਸੈਨ ਰਾਜਾ ਤਹ ਕੋ ਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਗਜਗਾਹ ਮਤੀ ਤਿਹ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਸਮ ਕਹੂੰ ਨ ਰਾਜ ਕੁਮਾਰੀ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਰਣਦੂਲਹ ਸੈਨ ਨ੍ਰਿਪਤਿ ਤਿਹ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਸਮ ਉਪਜਾ ਦੁਤਿਯ ਨ ਮਹਿ ਮਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਸੂਰ ਅਰੁ ਸੁੰਦਰ ਘਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁ ਅਵਤਾਰ ਮਦਨ ਕੋ ਬਨੋ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਨ੍ਰਿਪ ਇਕ ਦਿਨ ਚੜਾ ਸਿਕਾਰਾ ॥",
      "s": 14
    }
  ]
}
