{
  "page": 1300,
  "lines": [
    {
      "t": "ਨਿਜੁ ਨ੍ਰਿਪ ਤਾ ਕੀ ਕਥਾ ਜਤਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਮੈ ਹੌ ਰਾਸਟ੍ਰ ਦੇਸ ਕੋ ਰਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਵ ਹਿਤ ਭੇਸ ਅਤਿਥ ਕੋ ਸਾਜਾ ॥੧੬॥",
      "s": 14
    },
    {
      "t": "ਨੇਤ੍ਰ ਲਗੇ ਤੁਮ ਸੌ ਹਮਰੇ ਤਬ ॥",
      "s": 14
    },
    {
      "t": "ਤਵ ਪ੍ਰਤਿਬਿੰਬੁ ਲਖੇ ਜਲ ਮਹਿ ਜਬ ॥",
      "s": 14
    },
    {
      "t": "ਤਵ ਮੁਰਿ ਜਬ ਪ੍ਰਤਿਬਿੰਬੁ ਨਿਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਗਯੋ ਮਾਰਿ ਤੁਹਿ ਮਦਨ ਕਟਾਰਾ ॥੧੭॥",
      "s": 14
    },
    {
      "t": "ਮੁਹਿ ਲਖਿ ਧੀਰਜ ਨ ਤੁਮਰਾ ਰਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਰੰਗਿ ਖੋਦਿ ਸਖਿਯਨ ਅਸ ਕਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਗਹਿ ਮੁਹਿ ਗੀ ਤੀਰ ਤਿਹਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਚਹਤ ਜੋ ਥੋ ਸੋ ਭਈ ਪਿਯਾਰੀ ॥੧੮॥",
      "s": 14
    },
    {
      "t": "ਦੁਹੂੰ ਬੈਠ ਇਕ ਮੰਤ੍ਰ ਬਿਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਮੈ ਰਾਜਾ ਲਖਿ ਗਯੋ ਰਖਵਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਪਿਯ ਪਠਾਇ ਗ੍ਰਿਹ ਐਸ ਉਚਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਲੋਨ ਲੇਤ ਨ੍ਰਿਪ ਨਾਰ ਤਿਹਾਰੀ ॥੧੯॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਤ ਸ੍ਰਵਨ ਸਭ ਜਨ ਮਿਲਿ ਆਏ ॥",
      "s": 14
    },
    {
      "t": "ਆਨਿ ਤਵਨ ਕਹ ਬਚਨ ਸੁਨਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਹ ਨਿਮਿਤ ਛਾਡਤ ਹੈ ਦੇਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਿ ਰਾਜਾ ਕੀ ਨਾਰਿ ਸਨੇਹੀ ॥੨੦॥",
      "s": 14
    },
    {
      "t": "ਸੁਨੁ ਰਾਜਾ ਇਕ ਦਿਜ ਮਾਰਿਯੋ ਮੁਹਿ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਲੋਨ ਲੇਊਗੀ ਸਾਚ ਕਹੂੰ ਤੁਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਧਨ ਹਮਰੇ ਧਾਮ ਨਿਹਾਰਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਸਭ ਗਾਡਿ ਗੋਰਿ ਮਹਿ ਡਾਰਹੁ ॥੨੧॥",
      "s": 14
    },
    {
      "t": "ਹੋਰਿ ਰਹੇ ਸਭ ਏਕ ਨ ਮਾਨੀ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਪਰੀ ਭੋਹਰਾ ਭੀਤਰ ਰਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਆਸ ਪਾਸ ਲੈ ਲੋਨ ਬਿਥਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਧਨ ਹੁਤੋ ਗਾਡਿ ਸਭ ਡਾਰੋ ॥੨੨॥",
      "s": 14
    },
    {
      "t": "ਸੁਰੰਗਿ ਸੁਰੰਗਿ ਰਾਨੀ ਤਹ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਬੈਠੇ ਜਹਾ ਮੀਤ ਸੁਖਦਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੋ ਸੰਗ ਲੌ ਤਹੀ ਸਿਧਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਮੂੜ ਲੋਗ ਕਛੁ ਗਤਿ ਨ ਬਿਚਾਰੀ ॥੨੩॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਛਿਤਾਲੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੪੬॥੬੪੩੩॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਹ ਹਮ ਦਿਸਾ ਉਤਰਾ ਸੁਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜਾ ਤਹਿਕ ਬਸਤ ਥੋ ਗੁਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਕਲਗੀ ਰਾਇ ਜਾਹਿ ਜਗ ਭਾਖਤ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਨਾ ਦੇਸ ਕਾਨਿ ਤਿਹ ਰਾਖਤ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਮੀਤ ਮਤੀ ਤਿਹ ਨਾਰਿ ਬਿਰਾਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਹਿ ਬਿਲੋਕਿ ਚੰਦ੍ਰਮਾ ਲਾਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੀ ਏਕ ਲਛਿਮਿਨਿ ਦਾਸੀ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਰਬਲ ਦੇਹ ਘੜੀ ਅਬਿਨਾਸੀ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਸੌ ਨਾਰਿ ਹੇਤੁ ਅਤਿ ਮਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਮੂੜ ਨ ਰਾਨੀ ਕ੍ਰਿਆ ਪਛਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਗੁਪਤ ਲੇਤ ਦਾਸੀ ਸੁ ਛਿਮਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਬੁਰੀ ਬੁਰੀ ਤਿਹ ਦੇਤ ਉਗਾਹੀ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਰਾਨੀ ਅਪਨੀ ਕਰਿ ਮਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਮੂਰਖ ਤਾਹਿ ਜਸੂਸ ਨ ਜਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਪਰੈ ਬਾਤ ਤਾ ਕਹ ਜੇ ਸ੍ਰਵਨਨ ॥",
      "s": 14
    },
    {
      "t": "ਲਿਖਿ ਪਠਵੈ ਤਤਛਿਨ ਰਾਜਾ ਤਨ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਹੁਤੇ ਦੋਇ ਦਾਸੀ ਕੇ ਭਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਰਧ ਦੰਤ ਕਛੁ ਕਹਾ ਨ ਜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਯਾਮ ਬਰਨ ਇਕ ਦੁਤਿਯ ਕੁਰੂਪਾ ॥",
      "s": 14
    },
    {
      "t": "ਆਂਖੈ ਜਾਨੁ ਸੁਰਨ ਕੇ ਕੂਪਾ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਬਗਲ ਗੰਧਿ ਤਿਨ ਤੇ ਅਤਿ ਆਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਬੈਠਨ ਨਿਕਟ ਨ ਕੋਈ ਪਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਚੇਰੀ ਭ੍ਰਾਤ ਜਾਨਿ ਹਿਤ ਮਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਮੂੜ ਨਾਰਿ ਕਛੁ ਕ੍ਰਿਯਾ ਨ ਜਾਨੈ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਇਕ ਹੁਤੀ ਜਾਟਿ ਕੀ ਨਾਰ ॥",
      "s": 14
    },
    {
      "t": "ਮੈਨ ਕਹਤ ਤਿਹ ਨਾਮ ਉਚਾਰ ॥",
      "s": 14
    },
    {
      "t": "ਜਉ ਤਿਹ ਨਾਮ ਚੇਰਿ ਸੁਨਿ ਪਾਵੇ ॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਤੇ ਤਾਹਿ ਟੂਕਰਾ ਜਾਵੇ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਇਸਤ੍ਰੀ ਇਹ ਭਾਤਿ ਬਿਚਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਦਾਸੀ ਮੂੜ ਹ੍ਰਿਦੈ ਮਹਿ ਧਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਇ ਖਰਚੁ ਕਛੁ ਮਾਗਤ ਤੇਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਗੁਹਜ ਪਠੈਯੈ ਕਰਿ ਕਰਿ ਮੇਰੇ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਚੇਰੀ ਐਸੋ ਤਨ ਕਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਡਾਰਿ ਦਰਬ ਭੋਜਨ ਮਹਿ ਦਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਇ ਨਿਮਿਤ ਖਰਚੀ ਪਠ ਦਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਲੈ ਨਾਰਿ ਦਰਬੁ ਘਰ ਗਈ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਆਧੋ ਧਨ ਤਿਹ ਭ੍ਰਾਤਨ ਦੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਆਧੋ ਕਾਢਿ ਆਪਿ ਤ੍ਰਿਯ ਲੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਮੂਰਖ ਚੇਰੀ ਭੇਦ ਨ ਪਾਵੈ ॥",
      "s": 14
    }
  ]
}
