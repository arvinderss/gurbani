{
  "page": 1301,
  "lines": [
    {
      "t": "ਇਹ ਚਰਿਤ੍ਰ ਤਨ ਮੂੰਡ ਮੁੰਡਾਵੈ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਸੰਤਾਲੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੪੭॥੬੪੪੩॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਗੌਰਿਪਾਲ ਇਕ ਸੁਨਾ ਨਰੇਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਨਤ ਆਨਿ ਸਕਲ ਤਿਹ ਦੇਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਗੌਰਾ ਦੇਈ ਨਾਰਿ ਤਿਹ ਸੋਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਗੌਰਾਵਤੀ ਨਗਰ ਤਿਹ ਕੋ ਹੈ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੀ ਤ੍ਰਿਯਾ ਨੀਚ ਸੇਤੀ ਰਤਿ ॥",
      "s": 14
    },
    {
      "t": "ਭਲੀ ਬੁਰੀ ਜਾਨਤ ਨ ਮੂੜ ਮਤਿ ॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਦਿਨ ਭੇਦ ਭੂਪ ਲਖਿ ਲਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਾਸਿਤ ਜਾਰੁ ਤੁਰਤੁ ਭਜਿ ਗਯੋ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਗੌਰਾ ਦੇ ਇਕ ਚਰਿਤ ਬਨਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਲਿਖਾ ਏਕ ਲਿਖਿ ਤਹਾ ਪਠਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਰਾਜਾ ਕੀ ਜਾਨ ਸੁਰੀਤਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਤਾ ਕੌ ਠਹਰਾਯੋ ਮੀਤਾ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਤਿਸੁ ਮੁਖ ਤੇ ਲਿਖਿ ਲਿਖਾ ਪਠਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਹਾ ਹੁਤੇ ਅਪਨੇ ਸੁਖਦਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਕੋ ਦਿਨ ਰਮਤ ਈਹਾ ਤੇ ਰਹਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਦੈ ਕਰਿ ਪਠਿਵਹੁ ਹਮਰਾ ਲਹਨਾ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਪਤ੍ਰੀ ਨ੍ਰਿਪ ਕੇ ਕਰ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨੀ ਮੋਰਿ ਸੁਰੀਤਿ ਪਠਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜੜ ਨਿਜੁ ਤ੍ਰਿਯ ਕੋ ਭੇਦ ਨ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਨੇਹ ਤ੍ਯਾਗ ਤਿਹ ਸਾਥ ਗਵਾਯੋ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਸੁਘਰ ਹੁਤੌ ਤੌ ਭੇਵ ਪਛਾਨਤ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯ ਕੀ ਘਾਤ ਸਤਿ ਕਰਿ ਜਾਨਤ ॥",
      "s": 14
    },
    {
      "t": "ਮੂੜ ਰਾਵ ਕਛੁ ਕ੍ਰਿਯਾ ਨ ਜਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਮੂੰਡ ਮੂੰਡਿ ਗੀ ਰਾਨੀ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਅਠਤਾਲੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੪੮॥੬੪੪੯॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨੁ ਰਾਜਾ ਇਕ ਕਥਾ ਪ੍ਰਕਾਸੌ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤੁਮਰੇ ਜਿਯ ਕਾ ਭਰਮ ਬਿਨਾਸੌ ॥",
      "s": 14
    },
    {
      "t": "ਉਗ੍ਰਦਤ ਇਕ ਸੁਨਿਯਤ ਰਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਉਗ੍ਰਾਵਤੀ ਨਗਰ ਜਿਹ ਛਾਜਾ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਉਗ੍ਰ ਦੇਇ ਤਿਹ ਧਾਮ ਦੁਲਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਬ੍ਰਹਮਾ ਬਿਸਨ ਸਿਵ ਤਿਹੂੰ ਸਵਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਅਵਰਿ ਨ ਅਸਿ ਕੋਈ ਨਾਰਿ ਬਨਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜੈਸੀ ਯਹ ਰਾਜਾ ਕੀ ਜਾਈ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਅਜਬ ਰਾਇ ਇਕ ਤਹ ਖਤਿਰੇਟਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਸਕ ਮੁਸਕ ਕੇ ਸਾਥ ਲਪੇਟਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਸੁਤਾ ਜਬ ਤਿਹ ਲਖਿ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪਠੈ ਸਹਚਰੀ ਪਕਰਿ ਮੰਗਾਯੋ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਮਾਨਾ ਤਿਹ ਸੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਲਪਟਿ ਲਪਟਿ ਤਾ ਕੇ ਤਰ ਅੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਛਿਨ ਛੈਲ ਨ ਛੋਰਾ ਭਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਤ ਪਿਤਾ ਤੇ ਅਧਿਕ ਡਰਾਵੈ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਦਿਨ ਕਰੀ ਸਭਨ ਮਿਜਮਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੰਬਲ ਖਾਰ ਡਾਰਿ ਕਰਿ ਸ੍ਯਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜਾ ਰਾਨੀ ਸਹਿਤ ਬੁਲਾਏ ॥",
      "s": 14
    }
  ]
}
