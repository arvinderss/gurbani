{
  "page": 1305,
  "lines": [
    {
      "t": "ਸੰਗ ਸੁਤਾ ਕਾਜੀ ਕੀ ਆਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਹ ਸੁਨਤ ਇਹ ਭਾਤਿ ਬਖਾਨੀ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਹੁ ਕਾਜਿ ਸੁਤਾ ਮੁਹਿ ਬਰਾ ॥",
      "v": [
        [
          0,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਆਪਹਿ ਰੀਝਿ ਮਦਨਪਤਿ ਕਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਵਹੈ ਮੁਹਰ ਹਜਰਤਿਹਿ ਦਿਖਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਇਸਤ੍ਰੀ ਹ੍ਵੈ ਆਪੁ ਕਰਾਈ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਤ ਮੁਹਰ ਸਭਾ ਸਭ ਹਸੀ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਜਿ ਸੁਤਾ ਮਿਤਵਾ ਗ੍ਰਿਹ ਬਸੀ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਜੀ ਹੂੰ ਚੁਪ ਹ੍ਵੈ ਕਰਿ ਰਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਯਾਇ ਕਿਯਾ ਤੈਸਾ ਫਲ ਲਹਾ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਸੌ ਕਾਜੀ ਛਲਾ ਬਸੀ ਮਿਤ੍ਰ ਕੇ ਧਾਮ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਲਖਨ ਚਰਿਤ ਚਤੁਰਾਨ ਕੋ ਹੈ ਨ ਕਿਸੀ ਕੋ ਕਾਮ ॥੧੬॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਬਾਵਨ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੫੨॥੬੪੯੨॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਹੁ ਰਾਜ ਇਕ ਕਥਾ ਉਚਾਰੋ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਜਿਯ ਤੁਮਰੇ ਕੋ ਭਰਮ ਨਿਵਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਸਨਾਵਤੀ ਨਗਰ ਇਕ ਦਛਿਨ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਸਨ ਚੰਦ ਤਹ ਭੂਪ ਬਿਚਛਨ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਉਗ੍ਰ ਸਿੰਘ ਤਹ ਸਾਹੁ ਭਨਿਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਵਨ ਭੂਪ ਪਟਤਰ ਤਿਹ ਦਿਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਰਨਝੂਮਕ ਦੇ ਤਿਹਾ ਬਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਚੰਦ੍ਰ ਲਯੋ ਜਾ ਤੇ ਉਜਿਯਾਲਾ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਸੁੰਭ ਕਰਨ ਕਹ ਹੁਤੀ ਬਿਵਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਦਿਨ ਏਕ ਨਿਰਖ ਨ੍ਰਿਪ ਚਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਤਨ ਥਕਿਯੋ ਕਰਿ ਹਾਥ ਨ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਕੋਪ ਬਢਾ ਅਤਿ ਹੀ ਨਰ ਰਾਈ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਦੇਖਹੁ ਇਹੁ ਅਬਲਾ ਕਾ ਹੀਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਕਾਰਨ ਹਮ ਅਸ ਛਲ ਕੀਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਰੰਕ ਛੋਰਿ ਕਰਿ ਰਾਵ ਨ ਭਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁ ਭ੍ਰਿਤਨ ਕਹ ਤਹਾ ਪਠਾਯੋ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਤ ਬਚਨ ਚਾਕਰ ਤਹ ਗਏ ॥",
      "s": 14
    },
    {
      "t": "ਘੇਰ ਲੇਤ ਤਾ ਕੋ ਘਰ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੇ ਪਤਿ ਕਹ ਹਨਾ ਰਿਸਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਜਿ ਗਈ ਤ੍ਰਿਯ ਹਾਥ ਨ ਆਈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਮ੍ਰਿਤਕ ਨਾਥ ਜਬ ਨਾਰਿ ਨਿਹਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਇਹੈ ਚੰਚਲਾ ਚਰਿਤ ਬਿਚਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਵਨ ਜਤਨ ਰਾਜਾ ਕਹ ਮਰਿਯੈ ॥",
      "s": 14
    },
    {
      "t": "ਅਪਨੇ ਪਤਿ ਕੋ ਬੈਰ ਉਤਰਿਯੈ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਲਿਖ ਪਤਿਯਾ ਪਠਈ ਇਕ ਤਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਬੈਠੋ ਹੁਤੋ ਨਰਾਧਿਪ ਜਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਮੋ ਕਹ ਰਾਨੀ ਤੁਮ ਕਰਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਤੋ ਮੁਹਿ ਭੂਪ ਆਜੁ ਹੀ ਬਰਹੁ ॥੭॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸੁਨਤ ਬਚਨ ਨ੍ਰਿਪ ਬੋਲਿ ਪਠਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਪਰ ਕੀ ਤ੍ਰਿਯ ਰਾਨੀ ਠਹਰਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਤਿਹ ਬਿਧਿ ਤਾ ਕੋ ਗ੍ਰਿਹਿ ਆਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਜੜ ਕਛੁ ਨ ਪਛਾਨੋ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਸੰਗ ਅਪਨੇ ਤਾ ਕੌ ਲੈ ਸੋਯੋ ॥",
      "s": 14
    }
  ]
}
