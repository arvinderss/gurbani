{
  "page": 1307,
  "lines": [
    {
      "t": "ਤਹੀ ਹੁਤੀ ਤਿਨ ਕੀ ਰਾਜਧਾਨੀ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਿ ਪ੍ਰਭਾ ਤਿਹ ਜਾਤ ਨ ਕਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਰਜਧਾਨੀ ਐਸੀ ਤਿਹ ਅਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਊਚ ਧੌਲਹਰ ਤਹਾ ਸੁਧਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਨ ਪਰ ਬੈਠਿ ਪਕਰਿਯਤ ਤਾਰੇ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਮਜਨ ਹੇਤ ਤਹਾ ਨ੍ਰਿਪ ਆਵਤ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਇ ਪੂਰਬਲੇ ਪਾਪ ਗਵਾਵਤ ॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਇਕ ਨ੍ਰਹਾਨ ਨਰਾਧਿਪ ਚਲੋ ॥",
      "s": 14
    },
    {
      "t": "ਜੋਬਨਵਾਨ ਸਿਪਾਹੀ ਭਲੋ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਬਿਲਾਸ ਦੇ ਨੈਨ ਨਿਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਨ ਕ੍ਰਮ ਬਚ ਇਹ ਭਾਤਿ ਬਿਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕੈ ਮੈ ਅਬ ਯਾਹੀ ਕਹ ਬਰਿਹੌ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਤਰ ਬੂਡਿ ਗੰਗ ਮਹਿ ਮਰਿਹੌ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਸਖੀ ਲਖਿ ਹਿਤੂ ਸਿਯਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਸੌ ਚਿਤ ਕੀ ਬਾਤ ਬਖਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਤਾ ਕੌ ਤੂੰ ਮੁਝੈ ਮਿਲਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਮੁਖ ਮਾਗੈ ਜੇਤੋ ਧਨ ਪਾਵੈ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਸਖਿ ਗਈ ਤਵਨ ਕੇ ਗ੍ਰੇਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਪਰ ਪਾਇਨ ਅਸਿ ਦਿਯੋ ਸੰਦੇਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਸੁਤਾ ਤੁਮਰੈ ਪਰ ਅਟਕੀ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਲਿ ਗਈ ਤਾ ਕਹਿ ਸੁਧਿ ਘਟ ਕੀ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਿ ਨ੍ਰਿਪ ਬਚਨ ਭਯੋ ਬਿਸਮੈ ਮਨ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਤਾਹਿ ਬਖਾਨੇ ਬੈਨਨ ॥",
      "s": 14
    },
    {
      "t": "ਅਸ ਕਿਛੁ ਕਰਿਯੈ ਬਚਨ ਸ੍ਯਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਬਿਲਾਸ ਦੇ ਹ੍ਵੈ ਮੁਰ ਰਾਨੀ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਤੁਮ ਨ੍ਰਿਪ ਭੇਸ ਨਾਰਿ ਕੋ ਧਾਰਹੁ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਭੂਖਨ ਬਸਤਰ ਅੰਗ ਸੁਧਾਰਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਭੁਜੰਗ ਧੁਜ ਕਹ ਦੈ ਦਿਖਰਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਫੁਨਿ ਅੰਗਨਾ ਮਹਿ ਜਾਹੁ ਛਪਾਈ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਭੂਪਤਿ ਬਸਤ੍ਰ ਨਾਰਿ ਕੇ ਧਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਅੰਗ ਅੰਗ ਗਹਿਨਾ ਗੁਹਿ ਡਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਭੁਜੰਗ ਧੁਜ ਕਹ ਦਈ ਦਿਖਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਜੁ ਅੰਗਨਾ ਮਹਿ ਗਯੋ ਲੁਕਾਈ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਿ ਭੂਪ ਤਿਹ ਰਹਾ ਲੁਭਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਵਹੈ ਸਖੀ ਤਹ ਦੇਇ ਪਠਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਿਥਮੇ ਨਿਰਖਿ ਤਾਹਿ ਤੁਮ ਆਵਹੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਬਿਯਾਹ ਕੋ ਬ੍ਯੋਤ ਬਨਾਵਹੁ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਤ ਬਚਨ ਸਹਚਰਿ ਤਹ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਟਾਰਿ ਘਰੀ ਦ੍ਵੈ ਆਵਤ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਮੁਖ ਤੇ ਹ੍ਵੈ ਬਚਨ ਉਚਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਹੁ ਸ੍ਰਵਨ ਦੈ ਭੂਪ ਹਮਾਰੇ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਥਮ ਸੁਤਾ ਅਪਨੀ ਤਿਹ ਦੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰੌ ਬਹਿਨਿ ਤਵਨ ਕੀ ਲੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਤ ਬੈਨ ਨ੍ਰਿਪ ਫੇਰ ਨ ਕੀਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਹਿਤਹਿ ਕਾਢਿ ਤਵਨ ਕਹ ਦੀਨੋ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਸੁਤਾ ਪ੍ਰਥਮ ਦੈ ਬ੍ਯਾਹ ਰਚਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਕੌ ਬ੍ਯਾਹ ਨਾਰਿ ਕਰ ਲ੍ਯਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤਿਨ ਬਧਿ ਤਿਹ ਜੜ ਕੋ ਕਿਯੋ ॥",
      "s": 14
    }
  ]
}
