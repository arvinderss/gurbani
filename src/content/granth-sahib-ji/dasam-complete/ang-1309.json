{
  "page": 1309,
  "lines": [
    {
      "t": "ਸੁਨੁ ਰਾਜਾ ਇਕ ਔਰ ਪ੍ਰਸੰਗਾ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਭਾਖਿ ਸੁਨਾਵਤ ਤੁਮਰੇ ਸੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਚਲਾਵਤੀ ਨਗਰ ਇਕ ਰਾਜਤ ॥",
      "s": 14
    },
    {
      "t": "ਸੂਰ ਸਿੰਘ ਤਹ ਭੂਪ ਬਿਰਾਜਤ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਅੰਜਨ ਦੇਇ ਤਵਨ ਕੀ ਰਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਖੰਜਨ ਦੇ ਦੁਹਿਤਾ ਤਿਹ ਜਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਦੁਹੂੰ ਕੀ ਪ੍ਰਭਾ ਬਿਰਾਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਿ ਨਰੀ ਨਾਗਿਨਿ ਮਨ ਲਾਜੈ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਤਹਾ ਏਕ ਆਯੋ ਸੌਦਾਗਰ ॥",
      "s": 14
    },
    {
      "t": "ਰੂਪਵੰਤੁ ਜਨੁ ਦੁਤਿਯ ਨਿਸਾਕਰ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਅਬਲਾ ਤਿਹ ਰੂਪ ਨਿਹਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਪਾਟ ਤਜਿ ਸਾਥ ਸਿਧਾਰੈ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਆਯੋ ਨ੍ਰਿਪ ਤ੍ਰਿਯ ਕੇ ਘਰ ਤਰ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਸੁਤਾ ਨਿਰਖਾ ਤਿਹ ਦ੍ਰਿਗ ਭਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਮਨ ਬਚ ਕ੍ਰਮ ਇਹ ਉਪਰ ਭੂਲੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁ ਮਦ ਪੀ ਮਤਵਾਰੀ ਝੂਲੀ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਸਿੰਘ ਪ੍ਰਚੰਡ ਨਾਮ ਤਿਹ ਨਰ ਕੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁ ਕਰਿ ਮੁਕਟ ਕਾਮ ਕੇ ਸਿਰ ਕੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਖੀ ਏਕ ਤਹ ਕੁਅਰਿ ਪਠਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਿਯਹੁ ਬ੍ਰਿਥਾ ਸਜਨ ਸੌ ਜਾਈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਸਖੀ ਤੁਰਤ ਤਿਨ ਤਹ ਪਹੁਚਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਸ ਨਾਵਕ ਕੋ ਤੀਰ ਚਲਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਕਲ ਕੁਅਰਿ ਤਿਨ ਬ੍ਰਿਥਾ ਸੁਨਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਮਨ ਬਚ ਰੀਝਿ ਰਹਾ ਸੁਖਦਾਈ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਨਦੀ ਬਹਤ ਨ੍ਰਿਪ ਗ੍ਰਿਹਿ ਤਰ ਜਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਠਾਢ ਹੂਜਿਯਹੁ ਨਿਸਿ ਕਹ ਤਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਡਾਰਿ ਦੇਗ ਮੈ ਕੁਅਰਿ ਬਹੈ ਹੈਂ ॥",
      "s": 14
    },
    {
      "t": "ਛਿਦ੍ਰ ਮੂੰਦਿ ਤਾ ਕੋ ਸਭ ਲੈ ਹੈਂ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਊਪਰ ਬਾਧਿ ਤੰਬੂਰਾ ਦੈ ਹੈਂ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਚਰਿਤ੍ਰ ਮੁਹਿ ਤਾਹਿ ਮਿਲੈ ਹੈਂ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਤੁਬਰੀ ਲਖਿਯਹੁ ਢਿਗ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਢਿ ਭੋਗ ਦੀਜਹੁ ਸੁਖਦਾਈ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਬਦਿ ਤਾ ਸੌ ਸੰਕੇਤਾ ॥",
      "s": 14
    },
    {
      "t": "ਦੂਤੀ ਗੀ ਨ੍ਰਿਪ ਤ੍ਰਿਯਜ ਨਿਕੇਤਾ ॥",
      "s": 14
    },
    {
      "t": "ਡਾਰਿ ਦੇਗ ਮੈ ਕੁਅਰਿ ਬਹਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਧਿ ਤੂੰਬਰੀ ਤਹ ਪਹੁਚਾਈ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਬਹਤੀ ਤੁਬਰੀ ਤਹ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਆਵਤ ਕੁਅਰਿ ਲਖਾ ਸੁਖਦਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਐਂਚਿ ਤਹਾ ਤੇ ਦੇਗ ਨਿਕਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਲੈ ਪਲਕਾ ਊਪਰ ਬੈਠਾਰੀ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਪੋਸਤ ਭਾਗ ਅਫੀਮ ਮੰਗਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਹੂੰ ਖਾਟ ਪਰ ਬੈਠਿ ਚੜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਚਾਰਿ ਪਹਰ ਤਾ ਸੌ ਕਰਿ ਭੋਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਨ ਲਖਾ ਦੂਸਰੇ ਲੋਗਾ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਤਾ ਸੌ ਰੋਜ ਬੁਲਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਕਰਿ ਤਾਹਿ ਪਠਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਪ ਸਹਿਤ ਕੋਈ ਭੇਦ ਨ ਪਾਵੈ ॥",
      "s": 14
    }
  ]
}
