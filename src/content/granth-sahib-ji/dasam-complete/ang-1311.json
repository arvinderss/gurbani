      "v": [
        [
          2,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਭਾਗ ਕੌ ਤਾ ਮਹਿ ਤਰੁਨਿ ਮਿਲਾਇਯੋ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸਭ ਸੋਫੀ ਤਿਹ ਖਾਇ ਦਿਵਾਨੇ ਹ੍ਵੈ ਪਰੇ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਹੋ ਜਾਨੁ ਪ੍ਰਹਾਰ ਬਿਨਾ ਸਗਰੇ ਆਪੇ ਮਰੇ ॥੫॥",
      "v": [
        [
          3,
