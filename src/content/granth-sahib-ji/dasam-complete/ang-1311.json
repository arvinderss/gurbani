      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੋਫੀ ਭਏ ਸਭੇ ਮਤਵਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁ ਕਰ ਪਰੇ ਬੀਰ ਰਨ ਮਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਸੁਤਾ ਇਤ ਘਾਤ ਪਛਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਉਠ ਪ੍ਰੀਤਮ ਸੰਗ ਕਿਯਾ ਪਯਾਨਾ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਸੋਫੀ ਕਿਨੂੰ ਨ ਆਂਖਿ ਉਘਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਲਾਤ ਜਾਨੁ ਸੈਤਾਨ ਪ੍ਰਹਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਨ ਕਿਨਹੂੰ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਕੁਅਰਿ ਲੈ ਮੀਤ ਸਿਧਾਯੋ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਉਨਸਠਿ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੫੯॥੬੫੭੨॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨੁ ਰਾਜਾ ਇਕ ਔਰ ਪ੍ਰਸੰਗਾ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਜਸ ਕਿਯ ਸੁਤਾ ਪਿਤਾ ਕੇ ਸੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਬਲ ਸਿੰਘ ਰਾਜਾ ਇਕ ਅਤਿ ਬਲ ॥",
      "s": 14
    },
    {
      "t": "ਅਰਿ ਕਾਪਤ ਜਾ ਕੇ ਡਰ ਜਲ ਥਲ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਝਕਝੂਮਕ ਦੇ ਤਿਹ ਬਾਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਘੜੀ ਆਪੁ ਜਨੁ ਬ੍ਰਹਮ ਸੁ ਨਾਰ ॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਥੋ ਸੁਘਰ ਸੈਨ ਖਤਿਰੇਟਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਸਕ ਮੁਸਕ ਕੇ ਸਾਥ ਲਪੇਟਾ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਜਗੰਨਾਥ ਕਹ ਭੂਪ ਸਿਧਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪੁਤ੍ਰ ਕਲਤ੍ਰ ਸੰਗ ਲੈ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਗੰਨਾਥ ਕੋ ਨਿਰਖ ਦਿਵਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਚਨ ਬਖਾਨਾ ਭੂਪ ਉਤਾਲਾ ॥੩॥",
