  "lines": [
    {
      "t": "ਆਗੇ ਕਰਿ ਤ੍ਰਿਯ ਮਿਤ੍ਰ ਨਿਕਾਰਾ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਅਠਾਵਨ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੫੮॥੬੫੬੫॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨੁ ਰਾਜਾ ਇਕ ਔਰ ਚਰਿਤ੍ਰ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਛਲ ਨਾਰਿ ਨਿਕਾਰਾ ਮਿਤ੍ਰ ॥",
      "s": 14
    },
    {
      "t": "ਪੂਰਬ ਦੇਸ ਅਪੂਰਬ ਨਗਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹੂੰ ਭਵਨ ਕੇ ਬੀਚ ਉਜਗਰੀ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਸਿਵ ਪ੍ਰਸਾਦ ਰਾਜਾ ਤਹ ਕੋ ਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਸਦਾ ਸਰਬਦਾ ਸਿਵ ਰਤ ਸੋਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਵਨ ਦੇ ਤਿਹ ਨਾਰਿ ਭਣਿਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਮਨ ਮੋਹਨਿ ਦੇ ਸੁਤਾ ਕਹਿਜੈ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਸਾਹ ਮਦਾਰ ਪੀਰ ਤਹ ਜਾਹਿਰ ॥",
      "s": 14
    },
    {
      "t": "ਸੇਵਤ ਜਾਹਿ ਭੂਪ ਨਰ ਨਾਹਰ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਦਿਵਸ ਨ੍ਰਿਪ ਤਹਾ ਸਿਧਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਹਿਤਾ ਸਹਿਤ ਲਏ ਸੰਗ ਦਾਰਾ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਅੜਿਲ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਪੁਰਖ ਨ੍ਰਿਪ ਕੀ ਦੁਹਿਤਾ ਕਹਿ ਭਾਇਯੋ ॥",
      "v": [
        [
          1,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਪਠੈ ਸਹਚਰੀ ਤਾ ਕਹ ਤਹੀ ਬੁਲਾਇਯੋ ॥",
      "v": [
        [
          3,
          2
        ]
