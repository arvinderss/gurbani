      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਹੋ ਹਸਿ ਹਸਿ ਕਰਿ ਆਸਨ ਤਾ ਕੋ ਕਸਿ ਕਸਿ ਲਿਯੋ ॥੪॥",
      "v": [
