{
  "page": 1313,
  "lines": [
    {
      "t": "ਤਾ ਕੌ ਔਰ ਪੁਰਖ ਇਕ ਭਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਜੁ ਪਤਿ ਸੇਤੀ ਹੇਤੁ ਭੁਲਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰੈਨਿ ਦਿਵਸ ਤਿਹ ਧਾਮ ਬੁਲਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਤਿਨ ਸਾਥ ਕਮਾਵੈ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਦਿਨ ਸੁਧਿ ਤਾ ਕੇ ਪਤਿ ਪਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁ ਬਿਧਿ ਤਾ ਸੰਗ ਕਰੀ ਲਰਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਨਿਕ ਕਰੀ ਜੂਤਿਨ ਕੀ ਮਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤਿਨ ਇਹ ਬਿਧਿ ਚਰਿਤ ਬਿਚਾਰਾ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਦਿਨ ਤੇ ਨਿਜੁ ਪਤਿ ਕੌ ਤ੍ਯਾਗੀ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਥ ਫਕੀਰਨ ਕੇ ਅਨੁਰਾਗੀ ॥",
      "s": 14
    },
    {
      "t": "ਵਾਹਿ ਅਤਿਥ ਕਰਿ ਕੈ ਸੰਗ ਲੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਔਰੈ ਦੇਸ ਪਯਾਨਾ ਕੀਨਾ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਜਿਹ ਦੇਸ ਆਪੁ ਪਗੁ ਧਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਹੀ ਤਹੀ ਵਹੁ ਸੰਗ ਸਿਧਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਔਰ ਪੁਰਖੁ ਤਿਹ ਅਤਿਥ ਪਛਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰ ਨ ਕੋਈ ਜਾਨੈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਬਾਸਿਠ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੬੨॥੬੫੯੬॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨ ਰਾਜਾ ਇਕ ਕਥਾ ਨਵੀਨ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਜਸ ਚਰਿਤ੍ਰ ਕਿਯ ਨਾਰਿ ਪ੍ਰਬੀਨ ॥",
      "s": 14
    },
    {
      "t": "ਸਿੰਘ ਮਹੇਸ੍ਰ ਸੁਨਾ ਇਕ ਰਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਸਮ ਔਰ ਨ ਬਿਧਨਾ ਸਾਜਾ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਨਗਰ ਮਹੇਸ੍ਰਾਵਤਿ ਤਿਹ ਰਾਜਤ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਵਪੁਰੀ ਜਾ ਕੌ ਲਖਿ ਲਾਜਤ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਮਲ ਮਤੀ ਰਾਨੀ ਤਿਹ ਐਨ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਸਮ ਸੁਨੀ ਨ ਨਿਰਖੀ ਨੈਨ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਪੰਜਾਬ ਦੇਇ ਤਿਹ ਬੇਟੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਸਮ ਇੰਦ੍ਰ ਚੰਦ੍ਰ ਨਹਿ ਭੇਟੀ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਤਵਨ ਕੀ ਪ੍ਰਭਾ ਬਿਰਾਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਦੁਤਿ ਨਿਰਖਿ ਚੰਦ੍ਰਮਾ ਲਾਜੈ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਜੋਬਨ ਤਾ ਕੇ ਤਨ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅੰਗ ਅੰਗ ਮਦਨ ਦਮਾਮੋ ਦਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਪ ਬ੍ਯਾਹ ਕੋ ਬਿਵਤ ਬਨਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਸਕਲ ਪ੍ਰੋਹਿਤਨ ਲਿਯਾ ਬੁਲਾਇ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਸਿੰਘ ਸੁਰੇਸ੍ਰ ਭੂਪ ਤਬ ਚੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਸਸਿ ਜਾਤ ਨ ਪਟਤਰ ਦੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਰੀ ਤਵਨ ਕੇ ਸਾਥ ਸਗਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਦੈ ਸਨਮਾਨ ਬਰਾਤ ਬੁਲਾਈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਜੋਰਿ ਸੈਨ ਆਯੋ ਰਾਜਾ ਤਹ ॥",
      "s": 14
    },
    {
      "t": "ਰਚਾ ਬ੍ਯਾਹ ਕੋ ਬਿਵਤਾਰਾ ਜਹ ॥",
      "s": 14
    },
    {
      "t": "ਤਹੀ ਬਰਾਤ ਆਇ ਕਰਿ ਨਿਕਸੀ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਕੰਜ ਕਲੀ ਜਿਮਿ ਬਿਗਸੀ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਸੁਤਾ ਸੁੰਦਰ ਹੁਤੀ ਤਿਹ ਬਰ ਹੋਤ ਕੁਰੂਪ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਬਿਮਨ ਭਈ ਅਬਲਾ ਨਿਰਖਿ ਜਨੁ ਜਿਯ ਹਾਰਾ ਜੂਪ ॥੭॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਸਾਹੁ ਕੋ ਪੂਤ ਹੁਤੋ ਸੰਗ ॥",
      "s": 14
    },
    {
      "t": "ਸੁੰਦਰ ਹੁਤੇ ਸਕਲ ਜਾ ਕੇ ਅੰਗ ॥",
      "s": 14
    }
  ]
