{
  "page": 1316,
  "lines": [
    {
      "t": "ਪੋਸਤ ਭਾਗਿ ਅਫੀਮ ਮੰਗਾਵਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਸੇਜ ਦੋਊ ਬੈਠ ਚੜਾਵਹਿ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਕੈਫਹਿ ਹੋਤ ਰਸਮਸੇ ਜਬ ਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਕ੍ਰੀੜਾ ਕਰਤ ਦੋਊ ਮਿਲ ਤਬ ਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਆਸਨ ਲੈ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਚੁੰਬਨ ਔਰ ਅਲਿੰਗਨ ਕੈ ਕੈ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰਮਿਤ ਭਏ ਅਰੁ ਭੇ ਮਤਵਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਸੋਇ ਰਹੈ ਨਹਿ ਨੈਨ ਉਘਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਾਤਿ ਪਿਤਾ ਤਾ ਕੌ ਤਹ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਇ ਸਹਚਰੀ ਤਿਨੈ ਜਗਾਯੋ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਵਹੈ ਸਖੀ ਤਿਹ ਬਹੁਰਿ ਪਠਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਯੌ ਕਹਿਯਹੁ ਰਾਜਾ ਸੌ ਜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਚੌਕਾ ਪਰਾ ਭੋਜ ਦਿਜ ਕਾਰਨ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਨੁ ਨ੍ਰਹਾਏ ਨ੍ਰਿਪ ਤਹ ਨ ਸਿਧਾਰਨ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਬਸਤ੍ਰੁਤਾਰਿ ਕਰ ਇਹੀ ਅਨਾਵਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰ ਸੁਤਾ ਕੇ ਧਾਮ ਸਿਧਾਵਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਪ ਬਚਨ ਸੁਨਿ ਬਸਤ੍ਰ ਉਤਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਚਹਬਚਾ ਮਹਿ ਨ੍ਰਹਾਨ ਸਿਧਾਰੇ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਡੁਬਿਆ ਕਹ ਭੂਪਤ ਲੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਹੀ ਕਾਢਿ ਮਿਤ੍ਰ ਕਹ ਦੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਸਤ੍ਰ ਪਹਿਰਿ ਫਿਰਿ ਤਹਾ ਸਿਧਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਨ ਕਛੁ ਜੜ ਪਾਯੋ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਯਾਨੋ ਭੂਪ ਕਹਾਤ ਥੋ ਭਾਗ ਨ ਭੂਲ ਚਬਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਛਲਿ ਅਮਲੀ ਗਯੋ ਪਨਹੀ ਮੂੰਡ ਲਗਾਇ ॥੧੩॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਪੈਸਠਿ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੬੫॥੬੬੩੩॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨੁ ਰਾਜਾ ਇਕ ਔਰ ਪ੍ਰਸੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਸ ਛਲ ਕੀਨਾ ਨਾਰਿ ਸੁਰੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਛਿਤਪਤਿ ਸਿੰਘ ਇਕ ਭੂਪਤ ਬਰ ॥",
      "s": 14
    },
    {
      "t": "ਅਬਲਾ ਦੇ ਰਾਨੀ ਜਾ ਕੇ ਘਰ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਨਾਭ ਮਤੀ ਦੁਹਿਤਾ ਤਿਹ ਸੋਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਰ ਨਰ ਨਾਗ ਅਸੁਰ ਮਨ ਮੋਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਪਦੁਮਾਵਤੀ ਨਗਰ ਤਿਹ ਰਾਜਤ ॥",
      "s": 14
    },
    {
      "t": "ਇੰਦ੍ਰਾਵਤੀ ਨਿਰਖਿ ਤਿਹ ਲਾਜਤ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਬੀਰ ਕਰਨ ਰਾਜਾ ਇਕ ਔਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਭਦ੍ਰਾਵਤੀ ਬਸਤ ਥੋ ਠੌਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਐਂਠੀ ਸਿੰਘ ਪੂਤ ਤਿਹ ਜਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਿ ਮਦਨ ਜਿਹ ਰੂਪ ਬਿਕਾਯੋ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਸੁਤ ਖੇਲਨ ਚੜਾ ਸਿਕਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਆਵਤ ਭਯੋ ਤਿਹ ਨਗਰ ਮਝਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਹਾਵਤ ਹੁਤੀ ਜਹਾ ਨ੍ਰਿਪ ਬਾਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਥਕਤਿ ਰਹਾ ਤਿਹ ਰੂਪ ਨਿਹਾਰਿ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਸੁਤਾ ਤਿਹ ਊਪਰ ਅਟਕੀ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਸਰਿ ਗਈ ਉਤ ਤਿਹ ਸੁਧਿ ਘਟ ਕੀ ॥",
      "s": 14
    },
    {
      "t": "ਰੀਝ ਰਹੇ ਦੋਨੋ ਮਨ ਮਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਕਛੂ ਰਹੀ ਦੁਹੂੰਅਨਿ ਸੁਧਿ ਨਾਹੀ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਤਰੁਨਿ ਗਿਰਾ ਜਬ ਚਤੁਰ ਨਿਹਰਾ ॥",
      "s": 14
    }
  ]
}
