{
  "page": 1317,
  "lines": [
    {
      "t": "ਤਾ ਕੀ ਹਾਥ ਨਾਭਿ ਪਰ ਧਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਰੁ ਪਦ ਪੰਕਜ ਹਾਥ ਲਗਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਮੁਖ ਨ ਕਹਾ ਕਛੁ ਧਾਮ ਸਿਧਾਈ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਦ੍ਵੈਕ ਘਰੀ ਤਿਨ ਪਰੇ ਬਿਤਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਕੁਅਰ ਕਹ ਪੁਨਿ ਸੁਧਿ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਹਾਹਾ ਸਬਦ ਰਟਤ ਘਰ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਖਾਨ ਪਾਨ ਤਬ ਤੇ ਤਜਿ ਦਯੋ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਬਿਰਹੀ ਭਏ ਦੋਊ ਨਰ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਕੁਅਰ ਅਰੁ ਰਾਜ ਕੁਮਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਹਾਵ ਪਰਸਪਰ ਦੁਹੂਅਨ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਮੈ ਕਬਿਤਨ ਮਾਝ ਕਹਿਯੋ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਸਵੈਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਉਨ ਕੁੰਕਮ ਟੀਕੋ ਦਯੋ ਨ ਉਤੈ ਇਤ ਤੇਹੂੰ ਨ ਸੇਾਂਦੁਰ ਮਾਗ ਸਵਾਰੀ ॥",
      "v": [
        [
          5,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤ੍ਯਾਗਿ ਦਯੋ ਸਭ ਕੋ ਡਰਵਾ ਸਭ ਹੂੰ ਕੀ ਇਤੈ ਤਿਹ ਲਾਜ ਬਿਸਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਹਾਰ ਤਜੇ ਤਿਨ ਹੇਰਬ ਤੇ ਸਜਨੀ ਲਖਿ ਕੋਟਿ ਹਹਾ ਕਰਿ ਹਾਰੀ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਪਾਨ ਤਜੇ ਤੁਮ ਤਾ ਹਿਤ ਪ੍ਰੀਤਮ ਪ੍ਰਾਨ ਤਜੇ ਤੁਮਰੇ ਹਿਤ ਪ੍ਯਾਰੀ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਉਤੈ ਕੁਅਰਿ ਕਹ ਕਛੂ ਨ ਭਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਹਹਾ ਸਬਦ ਦਿਨ ਕਹਤ ਬਿਤਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਅੰਨ ਨ ਖਾਤ ਪਿਯਤ ਨਹਿ ਪਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਮਿਤ੍ਰ ਹੁਤੋ ਤਿਹ ਤਿਨ ਪਹਿਚਾਨੀ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਕੁਅਰ ਬ੍ਰਿਥਾ ਜਿਯ ਕੀ ਤਿਹ ਦਈ ॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਤ੍ਰਿਯ ਮੋਹਿ ਦਰਸ ਦੈ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਭ ਪਾਵ ਪਰ ਹਾਥ ਲਗਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਫਿਰਿ ਨ ਲਖਾ ਕਹ ਗਈ ਸੁ ਕਾਇ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੀ ਬਾਤ ਨ ਤਾਹਿ ਪਛਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਾ ਕੁਅਰ ਇਨ ਮੁਝੈ ਬਖਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਪੂਛਿ ਪੂਛਿ ਸਭ ਹੀ ਤਿਹ ਜਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੋ ਮਰਮੁ ਨ ਕੋਈ ਪਾਵੈ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੋ ਮਿਤ੍ਰ ਹੁਤੋ ਖਤਰੇਟਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਸਕ ਮੁਸਕ ਕੇ ਸਾਥ ਲਪੇਟਾ ॥",
      "s": 14
    },
    {
      "t": "ਕੁਅਰ ਤਵਨ ਪਹਿ ਬ੍ਰਿਥਾ ਸੁਨਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਤ ਬਾਤ ਸਭ ਹੀ ਤਿਨ ਪਾਈ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਨਾਭ ਮਤੀ ਤਿਹ ਨਾਮ ਪਛਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਨਾਭੀ ਕਹ ਹਾਥ ਛੁਆਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਪਦੁਮਾਵਤੀ ਨਗਰ ਠਹਰਾਯੌ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਪਦ ਪੰਕਜ ਕਰ ਲਾਯੋ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਦੋਊ ਚਲੇ ਤਹ ਤੇ ਉਠਿ ਸੋਊ ॥",
      "s": 14
    },
    {
      "t": "ਤੀਸਰ ਤਹਾ ਨ ਪਹੂਚਾ ਕੋਊ ॥",
      "s": 14
    },
    {
      "t": "ਪਦੁਮਾਵਤੀ ਨਗਰ ਥਾ ਜਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਭ ਮਤੀ ਸੁੰਦਰਿ ਥੀ ਤਹਾ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਪੂਛਤ ਚਲੇ ਤਿਸੀ ਪੁਰ ਆਏ ॥",
      "s": 14
    },
    {
      "t": "ਪਦੁਮਾਵਤੀ ਨਗਰ ਨਿਯਰਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਲਿਨਿ ਹਾਰ ਗੁਹਤ ਥੀ ਜਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਾਪਤਿ ਭਏ ਕੁਅਰ ਜੁਤ ਤਹਾ ॥੧੬॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਮੁਹਰ ਮਾਲਨਿ ਕਹ ਦਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਹਾਰ ਗੁਹਨ ਤਿਹ ਨ੍ਰਿਪ ਸੁਤ ਲਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਲਿਖਿ ਪਤ੍ਰੀ ਤਾ ਮਹਿ ਗੁਹਿ ਡਾਰੀ ॥",
      "s": 14
    }
  ]
}
