{
  "page": 1319,
  "lines": [
    {
      "t": "ਪਕਰਿ ਲਈ ਦੂਸਰਿ ਤ੍ਰਿਯ ਜਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਦ੍ਵੈ ਤ੍ਰਿਯ ਜੋਗ ਭੇਸ ਕੌ ਧਰਿ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਗਈ ਭੂਪ ਕੋ ਚਰਿਤ ਬਿਚਰਿ ਕੈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਭੂਪ ਕਹਾ ਸੂਰੀ ਇਹ ਦੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਤੀਨੋ ਹੁਕਮ ਹਮਾਰੇ ਲੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਹਨਨਨਾਤ ਲੈ ਤਾਹੀ ਸਿਧਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਦ੍ਵੈ ਇਸਤ੍ਰੀ ਹ੍ਵੈ ਅਤਿਥ ਪਧਾਰੇ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਜੋਗਿਨਿ ਨਾਰਿ ਕਹਾ ਅਸ ਕੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਦ੍ਵੈ ਮਹਿ ਇਕ ਜੋਗੀ ਕਹ ਦੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਐਹੈ ਇਹਾ ਅਰਸ ਕੀ ਬਾਤਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨਤ ਕੋਈ ਨ ਤਾ ਕੀ ਘਾਤਾ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਦੁਤਿਯ ਨਾਰ ਇਮਿ ਬਚਨ ਉਚਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਯਾਹਿ ਨ ਸੂਰੀ ਦੇਹੁ ਕਹਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਸੂਰੀ ਏਕ ਅਤਿਥ ਕੋ ਦੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਸਕਰ ਦੂਰ ਇਹਾ ਤੇ ਕੀਜੈ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਚਲੀ ਖਬਰਿ ਆਵੈ ਇਹ ਕਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਬੈਠਿ ਬਿਦਾਦ ਨਰਾਧਿਪ ਜਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਅੰਧ ਨਗਰ ਕੇ ਤੀਰ ਲੋਗ ਸਭ ॥",
      "s": 14
    },
    {
      "t": "ਅਛਰ ਕਛੁ ਨ ਪੜੈ ਤਿਨ ਗਰਧਭ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਔਰ ਕਛੂ ਜਾਨੈ ਨਹਿ ਬਾਤਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਪਸੂ ਮੂਰਖ ਬਿਖ੍ਯਾਤਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਧੁਨਿ ਪਰੀ ਕਾਨ ਪ੍ਰਭ ਕੇ ਜਬ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਨ ਚਲਾ ਅਤਿਥਹਿ ਦ੍ਵੈ ਤਬ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਦਰਸ ਕਿਯਾ ਤਿਨ ਕੋ ਜਬ ਜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਚਨ ਕਿਯਾ ਭੂਪਤਿ ਮੁਸਕਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਮ ਸੂਰੀ ਕਾਰਨ ਕਿਹ ਲੇਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਮੁਹਿ ਭੇਦ ਕ੍ਰਿਪਾ ਕਰਿ ਦੇਹੁ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਹੋ ਹਮ ਜਨਮ ਜਨਮ ਕਿਯ ਪਾਤਾ ॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਪਰ ਚੜਤ ਹੋਹਿ ਸਭ ਘਾਤਾ ॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਪਰ ਬਾਤ ਸ੍ਵਰਗ ਕੀ ਐਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਆਵਾ ਗਵਨ ਤੁਰਤ ਮਿਟਿ ਜੈਹੈ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਰਾਜੈ ਐਸੋ ਸੁਨਿ ਪਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਚਿਤ ਚੜਬੇ ਕੀ ਬਿਵਤ ਬਨਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਵਰ ਲੋਗ ਸਭ ਦਏ ਹਟਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਆਪੁ ਚੜਾ ਸੂਰੀ ਪਰ ਜਾਇ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਭੂਪ ਚੜਤ ਜੋਗੀ ਭਜਿ ਗਏ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਦੁਰੇ ਜਨਿਯਤ ਨਹਿ ਭਏ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਧਰਿ ਇਸਤ੍ਰਿਨ ਕੇ ਰੂਪ ਅਪਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਿਲਗੇ ਤਾ ਹੀ ਨਗਰ ਮੰਝਾਰਾ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਅਨ੍ਰਯਾਈ ਨ੍ਰਿਪ ਮਾਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਸ ਬਸਾਯੋ ਬਹੁਰਿ ਸੁਧਾਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਅੰਧ ਨਗਰ ਕਛੁ ਬਾਤ ਨ ਪਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਹਨਾ ਹਮਾਰਾ ਰਾਈ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਸਤਸਠ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੬੭॥੬੬੭੮॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਗੜ ਕਨੌਜ ਕੌ ਜਹਾ ਕਹਿਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਅਭੈ ਸਿੰਘ ਤਹ ਭੂਪ ਭਨਿਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਚਖੁ ਚਾਰ ਮਤੀ ਤਿਹ ਨਾਰੀ ॥",
      "s": 14
    }
  ]
}
