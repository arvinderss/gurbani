{
  "page": 1321,
  "lines": [
    {
      "t": "ਪੁਰਖ ਭੇਸ ਲਖਿ ਨਾਰਿ ਰਿਸਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਬਾਤੈਂ ਮੁਹਿ ਯਾਰ ਉਚਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੋ ਅਖਿਯਨ ਹਮ ਆਜੁ ਨਿਹਾਰੀ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਕਾਢਿ ਕ੍ਰਿਪਾਨ ਹਨਨਿ ਤਿਹ ਧਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਹਾਥ ਨਾਥ ਗਹਿ ਲਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਵ ਤ੍ਰਿਯ ਭੇਸ ਤਹਾ ਨਰ ਧਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤੈ ਜੜ ਯਾ ਕਹ ਜਾਰ ਬਿਚਾਰਾ ॥੯॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਜਬ ਤਿਹ ਨ੍ਰਿਪ ਨਿਜੁ ਨਾਰਿ ਬਿਚਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਉਤਰਾ ਕੋਪ ਹਿਯੈ ਥੋ ਧਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਇਸਤ੍ਰੀ ਇਹ ਭਾਤਿ ਉਚਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨੁ ਮੂਰਖ ਨ੍ਰਿਪ ਬਾਤ ਹਮਾਰੀ ॥੧੦॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਬਸਤ ਏਕ ਦਿਜਬਰ ਇਹ ਗਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਚੰਦ੍ਰ ਚੂੜ ਓਝਾ ਤਿਹ ਨਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਬ੍ਰਹਮ ਡੰਡ ਤਿਹ ਪੂਛਿ ਕਰਾਵਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਅਪਨੋ ਮੁਖ ਹਮੈ ਦਿਖਾਵਹੁ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਰਾਜਾ ਤਿਹ ਓਰ ਸਿਧਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਦਿਜ ਕੋ ਤ੍ਰਿਯ ਭੇਖ ਬਨਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਚੰਦ੍ਰ ਚੂੜ ਧਰਿ ਅਪਨਾ ਨਾਮ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਾਪਤਿ ਭਈ ਨ੍ਰਿਪਤਿ ਕੇ ਧਾਮ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਨ੍ਰਿਪ ਨਾਮ ਪੂਛ ਹਰਖਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਚੰਦ੍ਰ ਚੂੜ ਤਿਹ ਕੌ ਪਹਿਚਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਹਿਤ ਜਾਤ ਕਹੋ ਪਰਦੇਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਭਲੀ ਭਈ ਆਯੋ ਵਹੁ ਦੇਸਾ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਪੂਛਾ ਰਾਜੈ ਤਿਹ ਜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯ ਦਿਜ ਹ੍ਵੈ ਇਹ ਬਾਤ ਬਤਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਨ੍ਰਿਦੋਖ ਕਹ ਦੋਖ ਲਗਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਜਮਪੁਰ ਅਧਿਕ ਜਾਤਨਾ ਪਾਵੈ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਤਿਹ ਬਾਧਿ ਥੰਭ ਕੈ ਸੰਗ ॥",
      "s": 14
    },
    {
      "t": "ਤਪਤ ਤੇਲ ਡਾਰਤ ਤਿਹ ਅੰਗ ॥",
      "s": 14
    },
    {
      "t": "ਛੁਰਿਯਨ ਸਾਥ ਮਾਸੁ ਕਟਿ ਡਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਨਰਕ ਕੁੰਡ ਕੇ ਬੀਚ ਪਛਾਰੈ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਗਾਵਾ ਗੋਬਰ ਲੇਹੁ ਮਗਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੀ ਚਿਤਾ ਬਨਾਵਹੁ ਰਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਮੌ ਬੈਠਿ ਜਰੈ ਜੇ ਕੋਊ ॥",
      "s": 14
    },
    {
      "t": "ਜਮ ਪੁਰ ਬਿਖੈ ਨ ਟੰਗਿਯੈ ਸੋਊ ॥੧੬॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਤ ਬਚਨ ਦਿਜ ਨਾਰਿ ਨ੍ਰਿਪ ਗੋਬਰ ਲਿਯਾ ਮੰਗਾਇ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਬੈਠਿ ਆਪੁ ਤਾ ਮਹਿ ਜਰਾ ਸਕਾ ਨ ਤ੍ਰਿਯ ਛਲ ਪਾਇ ॥੧੭॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਉਨਹਤਰ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੬੯॥੬੭੦੦॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਬ੍ਰਯਾਘ੍ਰ ਕੇਤੁ ਸੁਨਿਯਤ ਇਕ ਰਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਸਮ ਦੁਤਿਯ ਨ ਬਿਧਨਾ ਸਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਬ੍ਰਯਾਘ੍ਰਵਤੀ ਨਗਰ ਤਿਹ ਸੋਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਇੰਦ੍ਰਾਵਤੀ ਨਗਰ ਕੋ ਮੋਹੈ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਅਬਦਾਲ ਮਤੀ ਤ੍ਰਿਯ ਤਾ ਕੀ ॥",
      "s": 14
    },
    {
      "t": "ਨਰੀ ਨਾਗਨੀ ਤੁਲਿ ਨ ਵਾ ਕੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਹ ਇਕ ਹੁਤੋ ਸਾਹੁ ਸੁਤ ਆਛੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁ ਅਲਿ ਪਨਚ ਕਾਛ ਤਨ ਕਾਛੋ ॥੨॥",
      "s": 14
    }
  ]
}
