{
  "page": 1327,
  "lines": [
    {
      "t": "ਬੇਗਮ ਕੀ ਤਾ ਸੌ ਰੁਚਿ ਲਾਗੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਤੇ ਨੀਂਦ ਭੂਖ ਸਭ ਭਾਗੀ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਖਿ ਗਈ ਜਬ ਤੇ ਤਿਹ ਧਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤੇ ਔਰ ਸੁਹਾਤ ਨ ਬਾਮਾ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਹਿਤੂ ਜਾਨ ਸਹਚਰੀ ਬੁਲਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਭਾਖਿ ਸਭ ਤਹਾ ਪਠਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਹਮੈ ਸਾਹ ਸੁਤ ਜੁ ਤੈ ਮਿਲੈ ਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਧਨ ਮੁਖ ਮੰਗਿ ਹੈਂ ਸੋ ਪੈ ਹੈਂ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਸਖੀ ਪਵਨ ਕੇ ਭੇਸ ਸਿਧਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਪਲਕ ਨ ਬਿਤੀ ਸਾਹ ਕੇ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਹ ਪੂਤ ਕਹ ਕਿਯਾ ਪ੍ਰਨਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਬੈਠੀ ਜਾਇ ਸੁਘਰਿ ਤਿਹ ਧਾਮਾ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਤੁਮਰੋ ਨਾਮ ਕਹਾ ਪਹਿਚਨਿਯਤ ॥",
      "s": 14
    },
    {
      "t": "ਕਵਨ ਦੇਸ ਕੇ ਬਾਸੀ ਜਨਿਯਤ ॥",
      "s": 14
    },
    {
      "t": "ਸਕਲ ਬ੍ਰਿਥਾ ਨਿਜ ਪ੍ਰਥਮ ਸੁਨਾਵਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਕੁਅਰਿ ਕੀ ਸੇਜ ਸੁਹਾਵਹੁ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਸੁਨੀ ਸਖੀ ਮਦ੍ਰ ਦੇਸ ਹਮ ਰਹਹੀ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਧੂਮ੍ਰ ਕੇਤੁ ਹਮ ਕੌ ਜਨ ਕਹਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੌਦਾ ਹਿਤ ਆਏ ਇਹ ਦੇਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਸ ਦੇਸ ਕੋ ਨਿਰਖਿ ਨਰੇਸਾ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਬਤਿਯਨ ਪ੍ਰਥਮ ਤਾਹਿ ਬਿਰਮਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਤਿਨ ਲੋਭ ਦਿਖਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਜ੍ਯੋਂ ਤ੍ਯੋਂ ਲੈ ਆਈ ਤਿਹ ਤਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਰਗ ਕੁਅਰਿ ਬਿਲੋਕਤ ਜਹਾ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਧਨ ਕਹਾ ਸੁੰਦ੍ਰ ਤਿਹ ਦੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਕੰਠ ਲਗਾਇ ਮਿਤ੍ਰ ਸੋ ਲੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਕੀ ਕੈਫ ਮੰਗਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਖਾਟ ਚੜਿ ਦੁਹੂੰ ਚੜਾਈ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਕੈਫ ਚੜਾਵਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਮਿਲਿ ਮਿਲਿ ਗੀਤ ਮਧੁਰ ਧੁਨਿ ਗਾਵਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਬਿਧ ਬਿਧਿਨ ਤਨ ਕਰਤ ਬਿਲਾਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਨੈਕੁ ਨ ਕਰੈ ਨ੍ਰਿਪਤਿ ਕੋ ਤ੍ਰਾਸਾ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਛੈਲਿਹਿ ਛੈਲ ਨ ਛੋਰਾ ਜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਸੁ ਦਿਨ ਰਾਖਤ ਕੰਠ ਲਗਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਕਬਹੂੰ ਆਖੇਟ ਸਿਧਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਅੰਬਾਰੀ ਤਾਹਿ ਚੜਾਵੈ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਤਹੀ ਕਾਮ ਕ੍ਰੀੜਾ ਕਹ ਕਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਤ ਪਿਤਾ ਤੇ ਨੈਕੁ ਨ ਡਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਦਿਨ ਰਾਜਾ ਚੜਾ ਸਿਕਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੰਗ ਲਏ ਮਿਹਰਿਯੈ ਅਪਾਰਾ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਬੇਗਮ ਸੋਊ ਸਿਕਾਰ ਸਿਧਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਅੰਬਾਰੀ ਤਾਹਿ ਚੜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਸਖੀ ਤਿਹ ਚੜਤ ਨਿਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਇ ਭੂਪ ਸੋ ਭੇਦ ਉਚਾਰਾ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਸੁਨਿ ਨ੍ਰਿਪ ਬਾਤ ਚਿਤ ਮੋ ਰਾਖੀ ॥",
      "s": 14
    },
    {
      "t": "ਔਰਿ ਨਾਰਿ ਸੋ ਪ੍ਰਗਟ ਨ ਭਾਖੀ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਹਿਤਾ ਕੋ ਜਬ ਗਜ ਨਿਕਟਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਤਾ ਕੋ ਪਿਤੁ ਨਿਕਟ ਬੁਲਾਯੌ ॥੧੫॥",
      "s": 14
    }
  ]
}
