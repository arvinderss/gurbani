  "lines": [
    {
      "t": "ਸੁਨਤ ਬੈਨ ਬੇਗਮ ਡਰਪਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਥਰਹਰ ਕੰਪਾ ਮਿਤ੍ਰ ਤਿਹ ਮਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਹੀ ਮੁਝੈ ਭੂਪ ਗਹਿ ਲੈ ਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਇਸੀ ਬਨ ਬਿਖੈ ਮਾਰਿ ਚੁਕੈ ਹੈ ॥੧੬॥",
      "s": 14
    },
    {
      "t": "ਨਾਰਿ ਕਹੀ ਪਿਯ ਜਿਨ ਜਿਯ ਡਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੌ ਚਰਿਤ੍ਰ ਤੁਮੈ ਸੋ ਕਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਰੀ ਰੂਖ ਕੇ ਤਰੈ ਨਿਕਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਲਪਟਿ ਰਹਾ ਤਾ ਸੌ ਤਹ ਯਾਰਾ ॥੧੭॥",
      "s": 14
    },
    {
      "t": "ਆਪੁ ਪਿਤਾ ਪ੍ਰਤਿ ਕਿਯਾ ਪਯਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਰੇ ਰੀਛ ਰੋਝ ਮ੍ਰਿਗ ਨਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਬਿਲੋਕਿ ਪਿਤਾ ਚੁਪ ਰਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਝੂਠ ਲਖਾ ਤਿਹ ਤ੍ਰਿਯ ਮੁਹਿ ਕਹਾ ॥੧੮॥",
      "s": 14
    },
    {
      "t": "ਉਸੀ ਸਖੀ ਕੋ ਪਲਟਿ ਪ੍ਰਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਝੂਠ ਬਚਨ ਇਨ ਮੁਝੈ ਉਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਖੇਲਿ ਅਖੇਟ ਭੂਪ ਗ੍ਰਿਹ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਸੀ ਬਿਰਛ ਤਰ ਕਰੀ ਲਖਾਯੋ ॥੧੯॥",
      "s": 14
    },
    {
      "t": "ਅੜਿਲ ॥",
      "s": 14
    },
    {
      "t": "ਪਕਰਿ ਭੁਜਾ ਗਜ ਪਰ ਪਿਯ ਲਯੋ ਚੜਾਇ ਕੈ ॥",
