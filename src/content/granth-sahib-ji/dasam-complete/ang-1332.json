{
  "page": 1332,
  "lines": [
    {
      "t": "ਨਿਜੁ ਪ੍ਯਾਰੇ ਬਿਨ ਰਹਿਯੋ ਨ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਘਾਲਿ ਸੰਦੂਕਹਿ ਸਾਥ ਚਲਯੋ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਨਿਸੁ ਦਿਨ ਤਾ ਸੌ ਭੋਗ ਕਮਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੋਵਤ ਰਹੈ ਨ ਭੂਪਤਿ ਪਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਦਿਵਸ ਜਬ ਹੀ ਨ੍ਰਿਪ ਜਾਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਨਿਯਹਿ ਛੋਰਿ ਜਾਰ ਉਠਿ ਭਾਗਾ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਿਯ ਸੌ ਬਚਨ ਕੋਪ ਕਰਿ ਭਾਖਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤੈ ਲੈ ਜਾਰ ਧਾਮ ਕਿਮਿ ਰਾਖਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕੈ ਅਬ ਹੀ ਮੁਹਿ ਬਾਤ ਬਤਾਵੌ ॥",
      "s": 14
    },
    {
      "t": "ਕੈ ਪ੍ਰਾਨਨ ਕੀ ਆਸ ਚੁਕਾਵੌ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਬਾਤ ਸਤ੍ਯ ਜਾਨੀ ਜਿਯ ਰਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਮੁਝੈ ਨ ਨ੍ਰਿਪ ਛਾਡਤ ਅਭਿਮਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਗ ਘੋਟਨਾ ਹਾਥ ਸੰਭਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਫੋਰਿ ਨਰਾਧਿਪ ਕੇ ਸਿਰ ਡਾਰਾ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਸਭਨ ਇਹ ਭਾਤਿ ਸੁਨਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਜਾ ਲੋਗ ਜਬ ਲਏ ਬੁਲਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਮਦ ਕਰਿ ਭੂਪ ਭਯੋ ਮਤਵਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਪਹਿਲ ਪੁਤ੍ਰ ਕੋ ਨਾਮ ਉਚਾਰਾ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਮ੍ਰਿਤਕ ਪੁਤ੍ਰ ਕੋ ਨਾਮਹਿ ਲਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਅਧਿਕ ਦੁਖਾਤੁਰ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੋਕ ਤਾਪ ਕੋ ਅਧਿਕ ਬਿਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਮੂੰਡ ਫੋਰਿ ਭੀਤਨ ਸੌ ਡਾਰਾ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਨਿਜੁ ਨਾਯਕ ਹਨਾ ਲੀਨਾ ਮਿਤ੍ਰ ਬਚਾਇ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਭੋਗ ਤਾ ਸੌ ਕਰੋ ਕੋ ਨ ਸਕਾ ਛਲ ਪਾਇ ॥੧੪॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਉਨਾਸੀ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੭੯॥੬੮੩੨॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਚਰਿਤ੍ਰ ਸੈਨ ਰਾਜਾ ਬਰ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਰਿ ਚਰਿਤ੍ਰ ਮਤੀ ਤਾ ਕੇ ਘਰ ॥",
      "s": 14
    },
    {
      "t": "ਵਤੀ ਚਰਿਤ੍ਰਾ ਤਾ ਕੀ ਨਗਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹੂੰ ਭਵਨ ਕੇ ਬੀਚ ਉਜਗਰੀ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਗੋਪੀ ਰਾਇ ਸਾਹ ਸੁਤ ਇਕ ਤਹ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਸਮ ਸੁੰਦਰ ਦੁਤਿਯ ਨ ਜਗ ਮਹ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਚਰਿਤ੍ਰ ਦੇ ਨੈਨ ਨਿਹਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅੰਗ ਅੰਗ ਤਿਹ ਮਦਨ ਪ੍ਰਜਾਰਿਯੋ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਤਿਹ ਬਿਧਿ ਤਿਹ ਲਯੋ ਬੁਲਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਉਠਤ ਲਯੋ ਛਤਿਯਾ ਸੌ ਲਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਕੇਲ ਕੀਨੋ ਰੁਚਿ ਠਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਕੇਲ ਕਰਤ ਸਭ ਰੈਨਿ ਬਿਹਾਨੀ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਪੋਸਤ ਭਾਗ ਅਫੀਮ ਮੰਗਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਸੇਜ ਚੜਿ ਦੁਹੂੰ ਚੜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਅਨਿਕ ਤਨ ਕਿਯੇ ਬਿਲਾਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਤ ਪਿਤਾ ਕੋ ਮਨ ਨ ਤ੍ਰਾਸਾ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਲਗਿ ਆਇ ਗਯੋ ਤਾ ਕੌ ਪਤਿ ॥",
      "s": 14
    },
    {
      "t": "ਡਾਰਿ ਦਯੋ ਸੇਜਾ ਤਰ ਉਪ ਪਤਿ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਪਟਾ ਡਾਰਿ ਦਯੋ ਤਿਹ ਮੁਖ ਪਰ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨ੍ਯੋ ਜਾਇ ਨ ਤਾ ਤੇ ਤ੍ਰਿਯ ਨਰ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਸੋਵਤ ਕਵਨ ਸੇਜ ਪਰ ਤੋਰੀ ॥",
      "s": 14
    }
  ]
}
