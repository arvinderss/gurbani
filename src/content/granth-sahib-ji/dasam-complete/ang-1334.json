          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਰਹੀ ਮੁਬਤਲਾ ਹ੍ਵੈ ਇਮਿ ਚਰਿਤ ਬਿਚਾਰਿ ਕਰਿ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਹ ਨਿਰਖੇ ਬਿਨੁ ਚੈਨ ਨ ਮੋ ਕੌ ਪਲ ਪਰੈ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਹੋ ਜੌ ਨਿਰਖਤ ਹੌ ਤਾਹਿ ਤੁ ਰਾਰਹਿ ਤ੍ਰਿਯ ਕਰੈ ॥੩॥",
      "v": [
        [
          4,
          2
        ]
