      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਸੀ ਤ੍ਰਿਯਾ ਕੇ ਧਾਮ ਸਿਧਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਤਕ ਭੇਟ ਅਸਰਫੀ ਲ੍ਯਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜੇਵਰ ਦੀਨੇ ਜਰੇ ਜਰਾਇਨ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਨ ਕੋ ਸਕਤ ਅੰਤ ਕੋਈ ਪਾਇਨ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਸੁ ਸਭ ਦਈ ਤਿਹ ਸਾਥਿ ਕਹਾ ਇਮਿ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਥ ਖਾਦਿਮਾ ਬਾਨੋ ਕੇ ਤਿਮਿ ॥",
      "s": 14
    },
    {
      "t": "ਏਕਹਿ ਆਸ ਹ੍ਯਾਂ ਮੈ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁ ਮੈ ਕਹਤ ਹੌ ਤੁਮੈ ਸੁਨਾਈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਗ੍ਰਿਹ ਅਪਨੇ ਹੀ ਮਦਰੋ ਚ੍ਵਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਖਾਨਾ ਅਨਿਕ ਭਾਤਿ ਕੇ ਲ੍ਯਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਜੁ ਹਾਥਨ ਲੈ ਦੁਹੂੰ ਪਯਾਊ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਟ ਚੜਾਇ ਘਰਹਿ ਉਠਿ ਜਾਊ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਸੋਈ ਮਦ ਲੈ ਤਹਾ ਸਿਧਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਤ ਬਾਰ ਬਹੁ ਭਾਤਿ ਚੁਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਜੁ ਹਾਥਨ ਲੈ ਦੁਹੂੰ ਪਿਯਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਮਤ ਕਰਿ ਸੇਜ ਸੁਆਯੋ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਸੋਈ ਲਖੀ ਪੀਰ ਤ੍ਰਿਯ ਜਬ ਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਨੈਨ ਸੈਨ ਦੈ ਤਿਹ ਪ੍ਰਤਿ ਤਬ ਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੇ ਧਰਿ ਛਤਿਯਾ ਪਰੁ ਚੂਤ੍ਰਨ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਕੀਨਾ ਤਿਹ ਪਤਿ ਤਨ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਸੋਵਤ ਰਹੀ ਚੜੇ ਮਦ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਕੀ ਗਤਿ ਨ ਬਿਚਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਚੀਠੀ ਏਕ ਲਿਖੀ ਨਿਜ ਅੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਧਿ ਗਈ ਤਾ ਕੇ ਸਿਰ ਸੰਗਾ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਤ੍ਰਿਯ ਖ੍ਯਾਲ ਤ੍ਰਿਯਨ ਕੇ ਪਰਿ ਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੀ ਬਿਧਿ ਐਸੀ ਗਤਿ ਕਰਿ ਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਤੁਮ ਤ੍ਰਿਯ ਐਸ ਨ ਕੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਬੁਰੋ ਸੁਭਾਇ ਸਕਲ ਤਜਿ ਦੀਜੈ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕੇਸ ਪਾਸ ਤੇ ਛੋਰਿ ਕੈ ਬਾਚਤ ਪਤਿਯਾ ਅੰਗ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤਾ ਦਿਨ ਤੇ ਤ੍ਰਿਯ ਤਜਿ ਦਿਯਾ ਬਾਦ ਤ੍ਰਿਯਨ ਕੇ ਸੰਗ ॥੧੧॥",
      "v": [
        [
          5,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਇਕਆਸੀ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੮੧॥੬੮੫੮॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਸਨ ਧੁਜਾ ਇਕ ਭੂਪ ਸੁਲਛਨ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਸਨਪੁਰੀ ਜਾ ਕੀ ਦਿਸਿ ਦਛਿਨ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਮਨਿ ਨੀਲ ਮਤੀ ਤਿਹ ਰਾਨੀ ॥",
