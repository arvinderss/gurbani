{
  "page": 1337,
  "lines": [
    {
      "t": "ਭੇਦ ਅਭੇਦ ਨਹਿ ਨੈਕੁ ਬਿਚਰੋ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਹੀ ਘਾਤ ਨਾਰਿ ਤਿਨ ਪਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਜੂ ਬੰਦ ਲਯੋ ਸਰਕਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਪਨੀ ਕਬਜ ਕਾਢਿ ਕਰਿ ਲਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਤ ਕੀ ਡਾਰਿ ਤਵਨ ਮੈ ਗਈ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਕਿਤਕ ਦਿਨਨ ਕਹਿ ਦੇਹ ਰੁਪਇਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਪਠੈ ਦਯੋ ਇਕ ਤਾਹਿ ਮਨਇਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਹਜਾਰ ਤਹਾ ਤੋ ਲ੍ਯਾਵਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਆਨਿ ਬਨਿਜ ਕੋ ਕਾਜ ਚਲਾਵਹੁ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਤਿਨਕ ਹਜਾਰ ਨ ਤਾ ਕੌ ਦਿਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਯ ਮੈ ਕੋਪ ਸਾਹ ਤਬ ਕਿਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਧਿ ਲੈ ਗਯੋ ਤਾ ਕਹ ਤਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਜੀ ਕੋਟਵਾਰ ਥੋ ਜਹਾ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਮੋ ਤੇ ਬੀਸ ਲਾਖ ਇਨ ਲਿਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਇਨ ਮੁਝੈ ਹਜਾਰ ਨ ਦਿਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੀ ਸਭੋ ਸਰਖਤ ਤਿਹ ਹੇਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਇਨ ਕੋ ਅਬ ਹੀ ਨ੍ਯਾਇ ਨਿਬੇਰੋ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਛੋਰਿ ਸਰਖਤਹਿ ਸਭਨ ਨਿਹਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਰੁਪਯਾ ਸੌ ਇਕ ਤਹਾ ਬਿਚਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਚਾ ਤੇ ਝੂਠਾ ਤਿਹ ਕਿਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਧਨੁ ਹਰੋ ਕਾਢਿ ਤਿਹ ਦਿਯਾ ॥੧੬॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਬਚਨ ਤਿਨ ਨਾਰਿ ਉਚਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਮੈ ਨ ਰਹਤ ਹੌ ਗਾਵ ਤਿਹਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਯੌ ਕਹਿ ਜਾਤ ਤਹਾ ਤੇ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੋਫੀ ਯਹਿ ਕੂਟਿ ਭੰਗੇਰੀ ਗਈ ॥੧੭॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਧਨ ਤੇ ਧਨਵੰਤ ਭੀ ਕਰਿ ਤਿਹ ਧਨ ਕੀ ਹਾਨਿ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਸੋਫੀ ਕਹ ਅਮਲਿਨ ਛਰਾ ਦੇਖਤ ਸਕਲ ਜਹਾਨ ॥੧੮॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਚਉਰਾਸੀ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੮੪॥੬੮੯੦॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਚਿਤ੍ਰ ਕੇਤੁ ਰਾਜਾ ਇਕ ਪੂਰਬ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਬਚਿਤ੍ਰ ਰਥ ਪੁਤ੍ਰ ਅਪੂਰਬ ॥",
      "s": 14
    },
    {
      "t": "ਚਿਤ੍ਰਾਪੁਰ ਨਗਰ ਤਿਹ ਸੋਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਢਿਗ ਦੇਵ ਦੈਤ ਪੁਰ ਕੋ ਹੈ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਕਟਿ ਉਤਿਮ ਦੇ ਤਿਹ ਨਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੂਰਜ ਵਤ ਤਿਹ ਧਾਮ ਦੁਲਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਸਮ ਸੁੰਦਰਿ ਨਾਰਿ ਨ ਕੋਈ ॥",
      "s": 14
    },
    {
      "t": "ਆਗੇ ਭਈ ਨ ਪਾਛੇ ਹੋਈ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਬਾਨੀ ਰਾਇ ਤਹਾ ਇਕ ਸਾਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਮੁਖੁ ਸਮ ਸੁੰਦਰਿ ਨਹਿ ਮਾਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਗੁਲਜਾਰ ਰਾਇ ਸੁਤ ਤਾ ਕੇ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਵ ਦੈਤ ਕੋਇ ਤੁਲਿ ਨ ਵਾ ਕੇ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਸੁਤਾ ਤਾ ਕੋ ਲਖਿ ਰੂਪਾ ॥",
      "s": 14
    },
    {
      "t": "ਮੋਹਿ ਰਹੀ ਮਨ ਮਾਹਿ ਅਨੂਪਾ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਸਹਚਰੀ ਤਹਾ ਪਠਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਤਿਹ ਭਾਤਿ ਤਹਾ ਲੈ ਆਈ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਮਿਲਤ ਕੁਅਰਿ ਤਾ ਸੌ ਸੁਖੁ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਮਿਲਿ ਭੋਗ ਕਮਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਚੁੰਬਨ ਭਾਤਿ ਭਾਤਿ ਕੇ ਲੀਏ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਅਨਿਕ ਕੇ ਆਸਨ ਕੀਏ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਲਗਿ ਮਾਤ ਪਿਤਾ ਤਹ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਿ ਸੁਤਾ ਚਿਤ ਮੈ ਦੁਖ ਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਹ ਛਲ ਸੌ ਇਹ ਦੁਹੂੰ ਸੰਘਾਰੋ ॥",
