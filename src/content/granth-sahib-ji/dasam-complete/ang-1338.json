{
  "page": 1338,
  "lines": [
    {
      "t": "ਸਕਤ ਨ ਕੋਈ ਪਛਾਨਿ ਕਰਿ ਚੰਚਲਾਨ ਕੇ ਕਾਜ ॥੧੧॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਪਚਾਸੀ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੮੫॥੬੯੦੧॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਬੀਰ ਕੇਤੁ ਇਕ ਭੂਪ ਭਨਿਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਬੀਰਪੁਰੀ ਤਿਹ ਨਗਰ ਕਹਿਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਦਿਨ ਦੀਪਕ ਦੇ ਤਿਹ ਰਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੁੰਦਰਿ ਭਵਨ ਚਤੁਰਦਸ ਜਾਨੀ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਰਾਇ ਗੁਮਾਨੀ ਤਹ ਇਕ ਛਤ੍ਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੂਰਬੀਰ ਬਲਵਾਨ ਧਰਤ੍ਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਸੁੰਦਰ ਅਰ ਚਤੁਰਾ ਮਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਸਮ ਉਪਜਾ ਕੋਈ ਨ ਕਹਾ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਤਰੁਨਿ ਜਬ ਤਾਹਿ ਨਿਹਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਇਹੈ ਚੰਚਲਾ ਚਿਤ ਬਿਚਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੋ ਚਰਿਤ੍ਰ ਕਵਨ ਸੋ ਕੀਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਬਿਧਿ ਪਿਯ ਸੌ ਭੋਗ ਕਰੀਜੈ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਬੀਰ ਮਤੀ ਇਕ ਸਖੀ ਸ੍ਯਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਨਿ ਲਾਗਿ ਭਾਖ੍ਯੋ ਤਿਹ ਰਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਇ ਗੁਮਾਨੀ ਕੌ ਲੈ ਕੈ ਆਇ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਤਿਹ ਬਿਧਿ ਮੁਹਿ ਦੇਹੁ ਮਿਲਾਇ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਸਖੀ ਬ੍ਰਿਥਾ ਸਭ ਭਾਖਿ ਸੁਨਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜ੍ਯੋਂ ਰਾਨੀ ਕਹਿ ਤਾਹਿ ਸੁਨਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਤਿਹ ਬਿਧਿ ਤਾ ਕਹ ਉਰਝਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਆਨਿ ਕੁਅਰ ਕੌ ਦਯੋ ਮਿਲਾਈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਤਿਹ ਸਾਥ ਬਿਹਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਭੋਗ ਕਰਤ ਬੀਤੀ ਨਿਸੁ ਸਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਲਗਿ ਆਇ ਗਯੋ ਤਹ ਰਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਚਰਿਤ ਚੰਚਲਾ ਸਾਜਾ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਤੀਛਨ ਖੜਗ ਹਾਥ ਮਹਿ ਲਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਲੈ ਮਿਤਹਿ ਕੇ ਸਿਰ ਮਹਿ ਦਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਟੂਕ ਟੂਕ ਕਰਿ ਤਾ ਕੇ ਅੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਚਨ ਕਹਾ ਰਾਜਾ ਕੇ ਸੰਗਾ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਚਲੋ ਭੂਪ ਇਕ ਚਰਿਤ ਦਿਖਾਊ ॥",
      "s": 14
    },
    {
      "t": "ਗੌਸ ਮਰਾਤਿਬ ਤੁਮੈ ਲਖਾਊ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਇ ਚਰਿਤ ਕਛਹੂੰ ਨ ਬਿਚਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮ੍ਰਿਤਕ ਪਰਾ ਤਿਹ ਮਿਤ੍ਰ ਨਿਹਾਰਿਯੋ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੌ ਗੌਸ ਕੁਤੁਬ ਕਰਿ ਮਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਨ ਮੂੜ ਪਛਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਸਤ ਹਾਥ ਤਾ ਕੌ ਨ ਲਗਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪੀਰ ਪਛਾਨਿ ਜਾਰ ਫਿਰ ਆਯੋ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਥਮ ਭੋਗ ਤਾ ਸੌ ਕਿਯਾ ਬਹੁਰੋ ਦਿਯਾ ਸੰਘਾਰਿ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਮੂੜ ਭੂਪ ਇਹ ਛਲ ਛਲਾ ਸਕਾ ਨ ਭੇਦ ਬਿਚਾਰ ॥੧੦॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਛਿਆਸੀ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੮੬॥੬੯੧੧॥ਅਫਜੂੰ॥",
      "s": 14
