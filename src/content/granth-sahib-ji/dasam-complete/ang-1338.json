    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਰਵਾਰ ਇਕ ਭੂਪ ਭਨਿਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਚੰਦ੍ਰ ਸੈਨ ਤਿਹ ਨਾਮ ਕਹਿਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਜਗ ਮੋਹਨ ਦੇ ਤਿਹ ਨਾਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਘੜੀ ਆਪੁ ਜਨੁ ਬ੍ਰਹਮ ਸੁ ਨਾਰ ॥੧॥",
      "s": 14
    }
