{
  "page": 1343,
  "lines": [
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਦਰਬ ਲੁਟਾਵਤ ॥",
      "s": 14
    },
    {
      "t": "ਯੌ ਕਹਿ ਸਭਹੂੰ ਸੀਸ ਝੁਕਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਯਹ ਕਾਜੀ ਸੁੰਦਰ ਹ੍ਵੈ ਜਾਵੈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਦਿਵਸ ਉਪ ਪਤਿਹਿ ਬੁਲਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਨ ਲਾਗਿ ਸਭ ਬਾਤ ਸਿਖਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਬੀਚ ਛਪਾਇ ਸਦਨ ਕੇ ਰਾਖਾ ॥",
      "s": 14
    },
    {
      "t": "ਔਰ ਨਾਰਿ ਸੌ ਭੇਵ ਨ ਭਾਖਾ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਮਲੇਛ ਉਠਿ ਫਜਿਰ ਬੁਲਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਕੇ ਸਾਥ ਜਿਵਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਿਯੋ ਸਭੈ ਮਿਲਿ ਦੇਹੁ ਦੁਆਇ ॥",
      "s": 14
    },
    {
      "t": "ਮਮ ਪਤਿ ਸੁੰਦਰਿ ਕਰੈ ਖੁਦਾਇ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਸਭਹੂੰ ਹਾਥ ਤਸਬਿਯੈ ਲੀਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁ ਬਿਧਿ ਦੁਆਇ ਤਵਨ ਕਹ ਦੀਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਕਰੀ ਸੁਨਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਤਵ ਪਤਿ ਸੁੰਦਰ ਕਰੈ ਖੁਦਾਇ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਲੈ ਦੁਆਇ ਤ੍ਰਿਯ ਧਾਮ ਸਿਧਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਰਿ ਕਾਜਿਯਹਿ ਦਿਯੋ ਦਬਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਕਰਿ ਕਾਜੀ ਲੈਗੀ ਤਿਹ ਤਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਪੜਤ ਕਿਤਾਬ ਮੁਲਾਨੇ ਜਹਾ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਜਾ ਨਿਰਖਿ ਤਾ ਕਹ ਹਰਖਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਚੁ ਕਿਤਾਬ ਆਪਨੀ ਜਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਹਮ ਜੋ ਯਾ ਕਹ ਦਈ ਦੁਆਇ ॥",
      "s": 14
    },
    {
      "t": "ਯਾ ਤੇ ਸੁੰਦਰ ਕਰਾ ਖੁਦਾਇ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਪ੍ਰਥਮ ਕਾਜਿਯਹਿ ਘਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਰਤ ਭਈ ਅਪਨਾ ਸੁਖਦਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਨ ਕਿਨੂੰ ਬਿਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਬਰਾ ਅਪਨਾ ਪ੍ਯਾਰਾ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਮ ਸਭ ਹੀ ਅਤਿ ਕ੍ਰਿਪਾ ਕਰ ਦੀਨੀ ਹਮੈ ਦੁਆਇ ॥",
      "v": [
        [
          5,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਪਤਿ ਸੁੰਦਰ ਭਯੋ ਕੀਨੀ ਮਯਾ ਖੁਦਾਇ ॥੧੨॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਇਕ੍ਯਾਨਵੇ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੯੧॥੬੯੬੬॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਪ ਸੁ ਧਰਮ ਸੈਨ ਇਕ ਸੁਨਿਯਤ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਸਮਾਨ ਜਗ ਦੁਤਿਯ ਨ ਗੁਨਿਯਤ ॥",
      "s": 14
    },
    {
      "t": "ਚੰਦਨ ਦੇ ਤਿਹ ਨਾਰਿ ਭਨਿਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਮੁਖ ਛਬਿ ਨਿਸਕਰ ਕਹ ਦਿਜੈ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਸੰਦਲ ਦੇ ਦੁਹਿਤਾ ਤਿਹ ਸੁਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਖਗ ਮ੍ਰਿਗ ਜਛ ਭੁਜੰਗਨ ਮੋਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਪ੍ਰਭਾ ਤਨ ਮੋ ਤਿਨ ਧਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਮਦਨ ਸੁ ਨਾਰ ਭਰਤ ਜਨੁ ਭਰੀ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਨ੍ਰਿਪ ਸੁਤ ਏਕ ਸੁਘਰ ਤਿਨ ਹੇਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮਦਨ ਆਨਿ ਤਾ ਕਾ ਤਨ ਘੇਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਖੀ ਏਕ ਤਹ ਦਈ ਪਠਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਨਿਕ ਜਤਨ ਕਰਿ ਕੈ ਤਿਹ ਲ੍ਯਾਈ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਆਨਿ ਸਜਨ ਤਿਨ ਦਯੋ ਮਿਲਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਰਮੀ ਕੁਅਰਿ ਤਾ ਸੌ ਲਪਟਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਅਟਕ ਗਯੋ ਜਿਯ ਤਜਾ ਨ ਜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਤਿਨ ਕੀਨੀ ਚਤੁਰਾਈ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਤੋਪ ਬਡੀ ਇਕ ਲਈ ਮੰਗਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਮਹਿ ਬੈਠਿ ਮਨੁਛ ਤੇ ਜਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਮੰਤ੍ਰ ਸਕਤਿ ਕਰਿ ਤਾ ਮੋ ਬਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਮਿਤ੍ਰ ਭਏ ਇਹ ਭਾਤਿ ਉਚਰੀ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਮਿਤ੍ਰ ਬਿਦਾ ਕਰਿ ਸਖੀ ਬੁਲਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਤਾਹਿ ਕਹਾ ਸਮੁਝਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਤੋਪ ਬਿਖੈ ਮੁਹਿ ਡਾਰਿ ਚਲੈਯਹੁ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਨ੍ਰਿਪ ਸੁਤ ਕੇ ਗ੍ਰਿਹ ਪਹੁਚੈਯਹੁ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਸਹਚਰਿ ਐਸੇ ਸੁਨਿ ਲਈ ॥",
      "s": 14
    },
    {
      "t": "ਦਾਰੂ ਡਾਰਿ ਆਗਿ ਤਿਹ ਦਈ ॥",
      "s": 14
    },
    {
      "t": "ਗੋਰਾ ਜਿਮਿ ਲੈ ਕੁਅਰਿ ਚਲਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੰਤ੍ਰ ਸਕਤਿ ਜਮ ਨਿਕਟ ਨ ਆਯੋ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਜਾਇ ਪਰੀ ਨਿਜੁ ਪ੍ਰੀਤਮ ਕੇ ਘਰ ॥",
      "s": 14
    },
    {
      "t": "ਪਾਹਨ ਜੈਸ ਹਨਾ ਗੋਫਨ ਕਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਿ ਮੀਤ ਤਿਹ ਲਿਯਾ ਉਠਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਪੋਛਿ ਅੰਗਿ ਉਰ ਸਾਥ ਲਗਾਈ ॥੮॥",
