{
  "page": 1345,
  "lines": [
    {
      "t": "ਯੌ ਕਹਿ ਕੁਅਰਿ ਬਿਦਾ ਕਰਿ ਦੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਾਤ ਭੇਸ ਨਰ ਕੋ ਧਰਿ ਲੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਕੀਅਸ ਕੁਅਰ ਕੇ ਧਾਮ ਪਯਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਨ ਕਿਨੀ ਪਛਾਨਾ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਚਾਕਰ ਰਾਖਿ ਕੁਅਰ ਤਿਹ ਲਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬੀਚ ਮੁਸਾਹਿਬ ਕੋ ਤਿਹ ਕਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਖਾਨ ਪਾਨ ਸਭ ਸੋਈ ਪਿਲਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਨਰ ਨਾਰੀ ਕੋਈ ਜਾਨਿ ਨ ਜਾਵੈ ॥੧੨॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਦਿਨ ਪਿਯ ਲੈ ਗਈ ਸਿਕਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਬੀਚ ਸਰਾਹੀ ਕੇ ਮਦ ਡਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਲ ਕੈ ਸਾਥ ਭਿਗਾਇ ਉਛਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਚੋਵਤ ਜਾਤ ਜਵਨ ਤੇ ਬਾਰਾ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਕੋਈ ਲਖੈ ਤਵਨ ਕਹ ਪਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਕੋਈ ਨ ਸਮੁਝਿ ਸਕੈ ਮਦ ਗ੍ਯਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਕਾਨਨ ਕੇ ਗਏ ਮੰਝਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਕੁਅਰ ਸੌ ਬਾਲ ਉਚਾਰਾ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਤੁਮ ਕੋ ਲਗੀ ਤ੍ਰਿਖਾ ਅਭਿਮਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਸੀਤਲ ਲੇਹੁ ਪਿਯਹੁ ਇਹ ਪਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਭਰਿ ਪ੍ਯਾਲਾ ਲੈ ਤਾਹਿ ਪਿਯਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਭਹਿਨ ਕਰਿ ਜਲ ਤਾਹਿ ਬਿਚਾਰਾ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਪੁਨਿ ਤ੍ਰਿਯ ਲਿਯਾ ਕਬਾਬ ਹਾਥਿ ਕਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਿਯੋ ਕਿ ਖਾਹੁ ਰਾਜ ਸੁਤ ਬਨ ਫਰ ॥",
      "v": [
        [
          4,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤੁਮਰੇ ਨਿਮਿਤਿ ਤੋਰਿ ਇਨ ਆਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਭਛਨ ਕਰਹੁ ਸ੍ਵਾਦ ਅਬ ਨਾਨਾ ॥੧੬॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਮਧ੍ਰਯਾਨ ਸਮੋ ਭਯੋ ਜਾਨ੍ਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਲੋਗਨ ਇਹ ਭਾਤਿ ਬਖਾਨ੍ਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤੁਮ ਸਭ ਚਲੋ ਭੂਪ ਕੇ ਸਾਥਾ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਹਮ ਸੇਵਾ ਕਰਿ ਹੈ ਜਗਨਾਥਾ ॥੧੭॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਜਨ ਪਠੈ ਭੂਪ ਕੇ ਸਾਥਾ ॥",
      "s": 14
    },
    {
      "t": "ਦੋਈ ਰਹੇ ਨਾਰਿ ਅਰ ਨਾਥਾ ॥",
      "s": 14
    },
    {
      "t": "ਪਰਦਾ ਐਚਿ ਦਸੌ ਦਿਸਿ ਲਿਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਹਸਿ ਹਸਿ ਰਸਿ ਕਿਯਾ ॥੧੮॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਚਰਿਤ੍ਰ ਦੋਈ ਬਿਹਸਿ ਰਮਤ ਭਏ ਨਰ ਨਾਰਿ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਪ੍ਰਜਾ ਸਹਿਤ ਰਾਜਾ ਛਲਾ ਸਕਾ ਨ ਭੂਪ ਬਿਚਾਰਿ ॥੧੯॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਤਿਰਾਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੯੩॥੬੯੯੬॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਵ ਛਤ੍ਰ ਇਕ ਭੂਪ ਬਖਨਿਯਤਿ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਸੁਰਰਾਜਵਤੀ ਪੁਰ ਜਨਿਯਤ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹੁ ਸੰਗ ਚੜਤ ਅਮਿਤਿ ਚਤੁਰੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਉਮਡਿ ਚਲਤ ਜਿਹ ਬਿਧਿ ਕਰਿ ਗੰਗਾ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਅੜਿਲ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਅਲਕੇਸ ਮਤੀ ਤਿਹ ਸੁਤਾ ਬਖਾਨਿਯੈ ॥",
      "v": [
        [
          2,
