{
  "page": 1349,
  "lines": [
    {
      "t": "ਲਾਲ ਮਤੀ ਰਾਨੀ ਤਿਹ ਸੋਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁਰ ਨਰ ਨਾਰਿ ਭੁਜੰਗਨ ਮੋਹੈ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਸਿੰਘ ਮੇਦਨੀ ਸੁਤ ਕਾ ਨਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਥਕਿਤ ਰਹਤ ਜਾ ਕੌ ਲਖਿ ਬਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਰੂਪ ਤਾ ਕੋ ਬਿਧਿ ਕਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁ ਕਰਿ ਕਾਮ ਦੇਵ ਅਵਤਰਿਯੋ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਚਪਲਾ ਦੇ ਤਹ ਸਾਹ ਦੁਲਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਕਨਕ ਅਵਟਿ ਸਾਚੇ ਜਨੁ ਢਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਪੁਤ੍ਰ ਜਬ ਤਾਹਿ ਨਿਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਿ ਤਰੁਨਿ ਹ੍ਵੈ ਗਯੋ ਮਤਵਾਰਾ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਸਹਚਰੀ ਨਿਕਟਿ ਬੁਲਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਮਿਤ ਦਰਬ ਦੈ ਤਹਾ ਪਠਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਤੈ ਚਪਲ ਮਤੀ ਕੌ ਲ੍ਰਯੈ ਹੈਂ ॥",
      "s": 14
    },
    {
      "t": "ਮੁਖਿ ਮੰਗ ਹੈ ਜੋ ਕਛੁ ਸੋ ਪੈ ਹੈਂ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਬਚਨ ਸੁਨਤ ਸਹਚਰਿ ਤਹ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁ ਬਿਧਿ ਤਾਹਿ ਪ੍ਰਬੋਧਤ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਹ ਸੁਤਾ ਜਬ ਹਾਥ ਨ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਦੂਤੀ ਇਹ ਘਾਤ ਬਨਾਈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਤਵ ਪਿਤਿ ਧਾਮ ਜੁ ਨਏ ਉਸਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਚਲਹੁ ਜਾਇ ਤਿਹ ਲਖੌ ਸਵਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਯੌ ਕਹਿ ਡਾਰਿ ਡੋਰਿਯਹਿ ਲਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਪਰਦਨ ਡਾਰਿ ਚਹੂੰ ਦਿਸਿ ਦਿਯੋ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਸਾਹ ਸੁਤਾ ਡਹਕਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਸੰਗ ਲਏ ਨ੍ਰਿਪ ਸੁਤ ਘਰ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਹੀ ਆਨਿ ਪਰਦਾਨ ਉਘਾਰ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਰਿ ਲਖਾ ਤਹ ਰਾਜ ਕੁਮਾਰਾ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਤਾਤ ਮਾਤ ਇਹ ਠੌਰ ਨ ਭਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਇਨ ਦੂਤੀ ਹੌ ਆਨਿ ਫਸਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਕੁਅਰ ਜੌ ਮੁਝੈ ਨ ਪੈ ਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਕ ਕਾਨ ਕਟਿ ਲੀਕ ਲਗੈ ਹੈ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਹਾਇ ਹਾਇ ਕਰਿ ਗਿਰੀ ਧਰਨਿ ਪਰ ॥",
      "s": 14
    },
    {
      "t": "ਕਟੀ ਕਹਾ ਕਰ ਯਾਹਿ ਬਿਛੂ ਬਰ ॥",
      "s": 14
    },
    {
      "t": "ਧ੍ਰਿਗ ਬਿਧਿ ਕੋ ਮੋ ਸੌ ਕਸ ਕੀਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਕੁਅਰ ਨਹਿ ਭੇਟਨ ਦੀਯਾ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਮੈ ਨਿਜੁ ਘਰ ਕੌ ਫਿਰਿ ਜੈ ਹੌ ॥",
      "s": 14
    },
    {
      "t": "ਦ੍ਵੈ ਦਿਨ ਕੌ ਤੁਮਰੇ ਫਿਰਿ ਐ ਹੌ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਪੁਤ੍ਰ ਲਖਿ ਕ੍ਰਿਯਾ ਨ ਲਈ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਛਲ ਮੂੰਡ ਮੂੰਡ ਤਿਹ ਗਈ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਛਿਆਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੯੬॥੭੦੪੩॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਗਰ ਦੇਸ ਸੁਨਿਯਤ ਹੈ ਜਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਗਰ ਸੈਨ ਰਾਜਾ ਇਕ ਤਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਗਰ ਦੇਇ ਤਿਹ ਸੁਤਾ ਭਨਿਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਚੰਦ ਸੂਰ ਲਖਿ ਤਾਹਿ ਜੁ ਲਜੈ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਗਜਨੀ ਰਾਇ ਤਵਨ ਜਹ ਲਹਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮਨ ਕ੍ਰਮ ਬਚਨ ਕੁਅਰਿ ਅਸ ਕਹਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਐਸੋ ਛੈਲ ਏਕ ਦਿਨ ਪੈਯੈ ॥",
      "s": 14
    },
    {
      "t": "ਜਨਮ ਜਨਮ ਪਲ ਪਲ ਬਲਿ ਜੈਯੈ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਸਖੀ ਏਕ ਤਿਹ ਤੀਰ ਪਠਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਤਿਹ ਬਿਧਿ ਕਰਿ ਲਿਯਾ ਬੁਲਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਅਪਨ ਸੇਜ ਪਰ ਤਿਹ ਬੈਠਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਭੋਗ ਕਾ ਰਚਾ ਅਖਾਰਾ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਬੈਠ ਸੇਜ ਪਰ ਦੋਇ ਕਲੋਲਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਮਧੁਰ ਮਧੁਰ ਧੁਨਿ ਮੁਖ ਤੇ ਬੋਲਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਕਰਤ ਬਿਲਾਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਤ ਮਾਤ ਕੋ ਤਜਿ ਕਰ ਤ੍ਰਾਸਾ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਪੋਸਤ ਭਾਗ ਅਫੀਮ ਮੰਗਾਵਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਖਾਟ ਪਰ ਬੈਠ ਚੜਾਵਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਤਰੁਨ ਤਰੁਨਿ ਉਰ ਸੌ ਉਰਝਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਰਸਿ ਰਸਿ ਕਸਿ ਕਸਿ ਭੋਗ ਕਮਾਈ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਸਹਿਤ ਪਿਤਾ ਤਾ ਕੌ ਬਰ ॥",
      "s": 14
    },
    {
      "t": "ਆਵਤ ਭਯੋ ਦੁਹਿਤਾਹੂੰ ਕੇ ਘਰ ॥",
      "s": 14
    },
    {
      "t": "ਅਵਰ ਘਾਤ ਤਿਹ ਹਾਥ ਨ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਤ ਮਾਤ ਹਨਿ ਦਏ ਦਬਾਈ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਨਿਜੁ ਆਲੈ ਕਹ ਆਗਿ ਲਗਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਰੋਇ ਉਠੀ ਨਿਜੁ ਪਿਯਹਿ ਦੁਰਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਅਨਲ ਲਗਤ ਦਾਰੂ ਕਹ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਨੀ ਰਾਵ ਸਹਿਤ ਉਡ ਗਈ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਅਵਰ ਪੁਰਖ ਕਛੁ ਭੇਦ ਨ ਭਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਾ ਚੰਚਲਾ ਕਾਜ ਕਮਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਪਨ ਰਾਜ ਦੇਸ ਕਾ ਕਰਾ ॥",
      "s": 14
    }
  ]
}
