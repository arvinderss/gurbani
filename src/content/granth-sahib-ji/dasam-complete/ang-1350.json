{
  "page": 1350,
  "lines": [
    {
      "t": "ਬਹੁਰਿ ਸੁਯੰਬਰ ਸੌ ਤਿਹ ਬਰਾ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਸਤਾਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੯੭॥੭੦੫੧॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਪਲਵਲ ਦੇਸ ਹੁਤਾ ਇਕ ਰਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਸਮਾਨ ਬਿਧਿ ਅਵਰ ਨ ਸਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਤੜਿਤਾ ਦੇ ਤਿਹ ਨਾਰਿ ਭਨਿਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਚੰਦ੍ਰ ਸੂਰ ਜਿਹ ਸਮ ਨ ਕਹਿਜੈ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਅਲਿਕ੍ਰਿਤ ਦੇ ਤਿਹ ਸੁਤਾ ਬਖਨਿਯਤ ॥",
      "s": 14
    },
    {
      "t": "ਅਮਿਤ ਰੂਪ ਵਾ ਕੇ ਪਹਿਚਨਿਯਤ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਠਾ ਇਕ ਸੌਦਾਗਰ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਸਮ ਬਿਧਿ ਦੂਜੋ ਨ ਬਨਾਯੋ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਰਾਜ ਕੁਅਰਿ ਤਾ ਕੇ ਲਖਿ ਅੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਨ ਕ੍ਰਮ ਬਚ ਰੀਝੀ ਸਰਬੰਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਪਠੈ ਸਹਚਰੀ ਲੀਅਸਿ ਬੁਲਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਤ ਭਈ ਬਤਿਯਾ ਮੁਸਕਾਇ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਭੋਗ ਤਿਹ ਸਾਥ ਮਚਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤ ਭਾਤਿ ਰਸ ਕੇਲ ਕਮਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਚੁੰਬਨ ਔਰ ਅਲਿੰਗਨ ਲੀਨੋ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਅਨਿਕ ਤ੍ਰਿਯ ਕੋ ਸੁਖ ਦੀਨੋ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਤ੍ਰਿਯ ਚਿਤ ਤਵਨੈ ਹਰ ਲਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਅਸ ਚਰਿਤ ਚੰਚਲਾ ਕਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਤ ਮਾਤ ਦੋਇ ਬੋਲਿ ਪਠਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਤਿਨ ਸੌ ਬਚਨ ਸੁਨਾਏ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਮੈ ਅਬ ਲਗਿ ਨਹਿ ਤੀਰਥ ਅਨ੍ਰਹਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਅਬ ਤੀਰਥ ਕਰਿ ਹੌ ਤਹ ਜਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਜੌ ਆਇਸ ਤੁਮ ਤੇ ਮੈ ਪਾਊ ॥",
      "s": 14
    },
    {
      "t": "ਤੀਰਥ ਨ੍ਰਹਾਇ ਸਕਲ ਫਿਰਿ ਆਊ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਪਤਿ ਕੁਰੂਪ ਹਮ ਕਹ ਤੁਮ ਦਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਮੈ ਉਪਾਇ ਇਮਿ ਕਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜੌ ਮੁਰ ਪਤਿ ਸਭ ਤੀਰਥ ਅਨ੍ਰਹੈ ਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਸੁੰਦਰ ਅਧਿਕ ਕਾਇ ਹ੍ਵੈ ਜੈ ਹੈ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਲੈ ਆਗ੍ਯਾ ਪਤਿ ਸਹਿਤ ਸਿਧਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤ ਭਾਤ ਤੀਰਥਨ ਅਨ੍ਰਹਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਘਾਤ ਪਾਇ ਕਰਿ ਨਾਥ ਸੰਘਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੀ ਠੌਰ ਮਿਤ੍ਰ ਬੈਠਾਰਾ ॥੮॥",
      "s": 14
    },
    {
      "t": "ਅਪਨੇ ਧਾਮ ਬਹੁਰਿ ਫਿਰਿ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਤ ਪਿਤਹਿ ਇਹ ਭਾਤਿ ਜਤਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਮੁਰ ਪਤਿ ਅਤਿ ਤੀਰਥਨ ਅਨ੍ਰਹਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਬਪੁ ਸੁੰਦਰ ਹ੍ਵੈ ਗਯੋ ॥੯॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਹਮ ਤੀਰਥ ਅਨ੍ਰਹਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਅਨਿਕ ਬਿਧਵ ਤਨ ਬਿਪ੍ਰ ਜਿਵਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਦੈਵ ਆਪੁ ਬਰ ਦਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਮਮ ਪਤਿ ਕੋ ਸੁੰਦਰ ਬਪੁ ਕਿਯੋ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਯਹ ਕਾਹੂ ਨਰ ਬਾਤ ਨ ਪਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਾ ਕਰਮ ਕਰਿ ਕੈ ਤ੍ਰਿਯ ਆਈ ॥",
      "s": 14
    },
    {
      "t": "ਤੀਰਥ ਮਹਾਤਮ ਸਭਹੂੰ ਜਾਨ੍ਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦ ਅਭੇਦ ਨ ਕਿਨੂੰ ਪਛਾਨ੍ਯੋ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਅਠਾਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੯੮॥੭੦੬੨॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    }
  ]
}
