  "lines": [
    {
      "t": "ਜਿਹ ਸਮ ਸੁਰ ਪੁਰ ਨਾਰਿ ਨ ਲਹਿਯਤ ॥੧॥",
      "s": 14
    },
    {
      "t": "ਸਹਰ ਸੁਰੇਸ੍ਵਾਵਤੀ ਬਿਰਾਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੌ ਨਿਰਖਿ ਇੰਦ੍ਰ ਪੁਰ ਲਾਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਬਲਵੰਡ ਸਿੰਘ ਸਾਹ ਇਕ ਸੁਨਿਯਤ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਸਮਾਨ ਜਗ ਔਰ ਨ ਗੁਨਿਯਤ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਸਦਾ ਕੁਅਰਿ ਤਿਹ ਸੁਤਾ ਭਨਿਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਚੰਦ੍ਰ ਸੂਰ ਲਖਿ ਜਾਹਿ ਅਰੁਝੈ ॥",
      "s": 14
    },
    {
      "t": "ਅਪ੍ਰਮਾਨ ਦੁਤਿ ਜਾਤ ਨ ਕਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨੁਕ ਫੂਲਿ ਚੰਬੇਲੀ ਰਹੀ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਸਦਾ ਕੁਅਰਿ ਨਿਰਖਾ ਜਬ ਰਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਹੀ ਸੀਲ ਤਵਨ ਕਾ ਭਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਖੀ ਏਕ ਨ੍ਰਿਪ ਤੀਰ ਪਠਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਯੌ ਰਾਜਾ ਤਨ ਕਹੁ ਤੈ ਜਾਈ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਮੈ ਤਵ ਰੂਪ ਨਿਰਖਿ ਉਰਝਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਮਦਨ ਤਾਪ ਤੇ ਭਈ ਦਿਵਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਬਾਰ ਤੁਮ ਮੁਝੈ ਬੁਲਾਵੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਮ ਤਪਤ ਕਰਿ ਕੇਲ ਮਿਟਾਵੋ ॥੫॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਜੌ ਆਪਨ ਗ੍ਰਿਹ ਮੁਹਿ ਨ ਬੁਲਾਵਹੁ ॥",
