{
  "page": 1356,
  "lines": [
    {
      "t": "ਸਿਵਦੇਈ ਤਿਹ ਨਾਰਿ ਬਿਚਛਨ ॥",
      "s": 14
    },
    {
      "t": "ਰੂਪਵਾਨ ਗੁਨਵਾਨ ਸੁਲਛਨ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਜਾ ਆਪੁ ਚਰਿਤ੍ਰ ਬਨਾਵਤ ॥",
      "s": 14
    },
    {
      "t": "ਲਿਖਿ ਲਿਖਿ ਪੜਿ ਇਸਤ੍ਰਿਯਨ ਸੁਨਾਵਤ ॥੨॥",
      "s": 14
    },
    {
      "t": "ਸਿਵਾ ਮਤੀ ਇਹ ਬਿਧਿ ਜਬ ਸੁਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਬਿਹਸਿ ਕਰਿ ਮੂੰਡੀ ਧੁਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਅਸ ਕਰਿ ਇਸੈ ਚਰਿਤ੍ਰ ਦਿਖਾਊ ॥",
      "s": 14
    },
    {
      "t": "ਯਾਹ ਭਜੋ ਯਾਹੀ ਤੇ ਲਿਖਾਊ ॥੩॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਤਿਹ ਬਿਧਿ ਭੂਪਹਿ ਫੁਸਲਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਮਿਲਤ ਭਈ ਦਿਨ ਹੀ ਕਹ ਆਇ ॥",
      "s": 14
    },
    {
      "t": "ਆਨਿ ਗਰੇ ਤਾ ਕੇ ਲਪਟਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਤਿਨ ਕੇਲ ਰਚਾਈ ॥੪॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਜਦ ਪਤਿਹ ਭਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਊ ਨ ਤ੍ਰਿਯ ਆਸਨ ਤਿਹ ਤਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਉਰ ਸੋ ਉਰਝਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਿ ਭੂਪ ਕਾ ਰੂਪ ਬਿਕਾਨੀ ॥੫॥",
      "s": 14
    },
    {
      "t": "ਭੋਗ ਕਮਾਇ ਗਈ ਡੇਰੈ ਜਬ ॥",
      "s": 14
    },
    {
      "t": "ਸਖਿਯਨ ਸਾਥ ਬਖਾਨੋ ਇਮ ਤਬ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਰਾਜੈ ਮੁਹਿ ਆਜੁ ਬੁਲਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਦਿਨ ਹੀ ਮੋ ਸੰਗ ਭੋਗ ਕਮਾਯੋ ॥੬॥",
      "s": 14
    },
    {
      "t": "ਸਾਸੁ ਸਸੁਰ ਜਬ ਹੀ ਸੁਨ ਪਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਔਰ ਸੁਨਤ ਭੀ ਸਗਲ ਲੁਗਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਆਜੁ ਰਾਜ ਯਾ ਸੋ ਰਤਿ ਮਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਬੂਝਿ ਗਏ ਸਭ ਲੋਗ ਕਹਾਨੀ ॥੭॥",
      "s": 14
    },
    {
      "t": "ਪੁਨਿ ਸਿਵ ਦੇ ਇਹ ਭਾਤਿ ਉਚਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਮੈ ਦੇਖਤ ਥੀ ਹਿਯਾ ਤਿਹਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਤ ਕਹੇ ਮੁਹਿ ਏ ਕ੍ਯਾ ਕਰਿਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਚੁਪ ਕਰਿ ਹੈ ਕਿ ਕੋਪ ਕਰਿ ਲਰਿਹੈ ॥੮॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਅੜਿਲ ॥",
      "s": 14
    },
    {
      "t": "ਦਿਨ ਕੋ ਐਸੋ ਕੋ ਤ੍ਰਿਯ ਕਰਮ ਕਮਾਵਈ ॥",
      "v": [
        [
          4,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਦਿਖਤ ਜਾਰ ਕੋ ਧਾਮ ਨਾਰਿ ਕਿਮਿ ਜਾਵਈ ॥",
      "v": [
        [
          0,
          1
        ],
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਐਸ ਕਾਜ ਕਰਿ ਕਵਨ ਕਹੋ ਕਿਮਿ ਭਾਖਿ ਹੈ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਹੋ ਅਪਨੇ ਚਿਤ ਕੀ ਬਾਤ ਚਿਤ ਮੋ ਰਾਖਿ ਹੈ ॥੯॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਬੈਨ ਸੁਨਤ ਸਭਹਿਨ ਸਚੁ ਆਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਨੂੰ ਨ ਤਹ ਇਹ ਕਥਹਿ ਚਲਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜੋ ਕੋਈ ਐਸ ਕਰਮ ਕੌ ਕਰਿ ਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਲਿ ਨ ਕਾਹੂ ਪਾਸ ਉਚਿਰ ਹੈ ॥੧੦॥",
      "s": 14
    },
    {
      "t": "ਲੋਗਨ ਕਹਿ ਇਹ ਬਿਧਿ ਡਹਕਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਪਿਯ ਤਨ ਪਤ੍ਰੀ ਲਿਖੀ ਬਨਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਮੋ ਪਰ ਯਾਰ ਅਨੁਗ੍ਰਹ ਕੀਜੇ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਇਹ ਭੀ ਚਰਿਤ ਗ੍ਰੰਥ ਲਿਖਿ ਲੀਜੇ ॥੧੧॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਚਾਰ ਸੌ ਤੀਨ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੪੦੩॥੭੧੩੪॥ਅਫਜੂੰ॥",
      "s": 14
    },
    {
      "t": "ਸਬੁਧਿ ਬਾਚ ॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਤਿ ਸੰਧਿ ਇਕ ਭੂਪ ਭਨਿਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਥਮੇ ਸਤਿਜੁਗ ਬੀਚ ਕਹਿਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਜਸ ਪੁਰੀ ਚੌਦਹੂੰ ਛਾਯੋ ॥",
      "s": 14
    }
  ]
}
