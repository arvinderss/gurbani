{
  "page": 1358,
  "lines": [
    {
      "t": "ਜੂਝਿ ਜੂਝਿ ਗੇ ਬਹੁਰਿ ਨ ਫਿਰੇ ॥੧੩॥",
      "s": 14
    },
    {
      "t": "ਕੋਟਿਕ ਕਟਕ ਤਹਾ ਕਟਿ ਮਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਜੂਝੇ ਗਿਰੇ ਬਰੰਗਨਿਨ ਬਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਦੋਊ ਦਿਸਿ ਮਰੇ ਕਾਲ ਕੇ ਪ੍ਰੇਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਗਿਰੇ ਭੂਮਿ ਰਨ ਫਿਰੇ ਨ ਫੇਰੇ ॥੧੪॥",
      "s": 14
    },
    {
      "t": "ਸਤਿ ਸੰਧਿ ਦੇਵਿਸ ਇਤ ਧਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੀਰਘ ਦਾੜ ਉਹ ਓਰ ਰਿਸਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬਜ੍ਰ ਬਾਣ ਬਿਛੂਆ ਕੈ ਕੈ ਬ੍ਰਣ ॥",
      "s": 14
    },
    {
      "t": "ਜੂਝਿ ਜੂਝਿ ਭਟ ਗਿਰਤ ਭਏ ਰਣ ॥੧੫॥",
      "s": 14
    },
    {
      "t": "ਜੋਗਿਨਿ ਜਛ ਕਹੂੰ ਹਰਖਏ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਤ ਪ੍ਰੇਤ ਨਾਚਤ ਕਹੂੰ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਕਹ ਕਹ ਕਹ ਕਲਿ ਹਾਸ ਸੁਨਾਵਤ ॥",
      "s": 14
    },
    {
      "t": "ਭੀਖਨ ਸੁਨੈ ਸਬਦ ਭੈ ਆਵਤ ॥੧੬॥",
      "s": 14
    },
    {
      "t": "ਫਿਰੈਂ ਦੈਤ ਕਹੂੰ ਦਾਤ ਨਿਕਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਬਮਤ ਸ੍ਰੋਨ ਕੇਤੇ ਰਨ ਮਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਸਿਵਾ ਸਾਮੁਹਿ ਫਿਕਰਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਤ ਪਿਸਾਚ ਮਾਸ ਕਹੂੰ ਖਾਹੀ ॥੧੭॥",
      "s": 14
    },
    {
      "t": "ਸਕਟਾਬ੍ਰਯੂਹ ਰਚਾ ਸੁਰ ਪਤਿ ਤਬ ॥",
      "s": 14
    },
    {
      "t": "ਕ੍ਰੌਚਾਬ੍ਰਯੂਹ ਕਿਯੋ ਅਸੁਰਿਸ ਜਬ ॥",
      "s": 14
    },
    {
      "t": "ਮਚਿਯੋ ਤੁਮਲ ਜੁਧ ਤਹ ਭਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਗਰਜਤ ਭਏ ਬੀਰ ਬਲ ਧਾਰੀ ॥੧੮॥",
      "s": 14
    },
    {
      "t": "ਜੂਝਿ ਗਏ ਜੋਧਾ ਕਹੀ ਭਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਵ ਗਿਰੇ ਦਾਨਵ ਕਹੀ ਮਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਬੀਰ ਖੇਤ ਐਸਾ ਤਹ ਪਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਦੋਊ ਦਿਸਿ ਇਕ ਸੁਭਟ ਨ ਉਬਰਾ ॥੧੯॥",
      "s": 14
    },
    {
      "t": "ਜੌ ਕ੍ਰਮ ਕ੍ਰਮ ਕਰਿ ਕਥਾ ਸੁਨਾਊਾਂ ॥",
      "s": 14
    },
    {
      "t": "ਗ੍ਰੰਥ ਬਢਨ ਤੇ ਅਧਿਕ ਡਰਾਊਾਂ ॥",
      "s": 14
    },
    {
      "t": "ਤੀਸ ਸਹਸ ਛੂਹਨਿ ਜਹ ਜੋਧਾ ॥",
      "s": 14
    },
    {
      "t": "ਮੰਡ੍ਰਯੋ ਬੀਰ ਖੇਤ ਕਰਿ ਕ੍ਰੋਧਾ ॥੨੦॥",
      "s": 14
    },
    {
      "t": "ਪਤਿਅਨ ਸੋ ਪਤੀਅਨ ਭਿਰਿ ਮਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਵਾਰਨ ਕੇ ਸ੍ਵਾਰਨ ਛੈ ਕਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਰਥਿਯਨ ਤਹ ਰਥਿਯਨ ਕੌ ਘਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਹਾਥਿਨ ਦੰਤੀ ਸ੍ਵਰਗ ਪਠਾਯੋ ॥੨੧॥",
      "s": 14
    },
    {
      "t": "ਦਲਪਤਿ ਸੌ ਦਲਪਤਿ ਲਰਿ ਮੂਆ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਨਾਸ ਕਟਕ ਕਾ ਹੂਆ ॥",
      "s": 14
    },
    {
      "t": "ਬਚੇ ਭੂਪ ਤੇ ਕੋਪ ਬਡਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਡਤ ਭੇ ਹਠ ਠਾਨਿ ਲਰਾਈ ॥੨੨॥",
      "s": 14
    },
    {
      "t": "ਰਨ ਮਾਡਤ ਭੇ ਬਿਬਿਧ ਪ੍ਰਕਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਦੈਤ ਰਾਟ ਅਰੁ ਦੇਵ ਨ੍ਰਿਪਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਸਨਾ ਇਤੀ ਨ ਭਾਖ ਸੁਨਾਊਾਂ ॥",
      "s": 14
    },
    {
      "t": "ਗ੍ਰੰਥ ਬਢਨ ਤੇ ਅਤਿ ਡਰਪਾਊਾਂ ॥੨੩॥",
      "s": 14
    },
    {
      "t": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਾ ਲੌ ਬਖਾਨੌ ਮਹਾ ਲੋਹ ਮਚਿਯੋ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਦੁਹੂੰ ਓਰ ਤੇ ਬੀਰ ਏਕੈ ਨ ਬਚਿਯੋ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤਬੈ ਆਨਿ ਜੂਟੇ ਦੋਊ ਛਤ੍ਰਧਾਰੀ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਪਰਾ ਲੋਹ ਗਾੜੋ ਕੰਪੀ ਭੂਮਿ ਸਾਰੀ ॥੨੪॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਜੁਟੇ ਰਾਵ ਦੋਊ ਉਠੀ ਧੂਰਿ ਐਸੀ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਪ੍ਰਲੈ ਕਾਲ ਕੀ ਅਗਨਿ ਕੀ ਧੂਮ੍ਰ ਜੈਸੀ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    }
  ]
}
