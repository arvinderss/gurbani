{
  "page": 1362,
  "lines": [
    {
      "t": "ਮਾਰਿ ਮਾਰਿ ਦਿਸਿ ਦਸੌ ਪੁਕਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਤੇ ਅਮਿਤ ਅਸੁਰ ਤਨ ਧਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਰ ਚਲਤ ਤਿਨ ਤੇ ਜੇ ਦੌਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਤੇ ਹੋਤ ਅਸੁਰ ਪ੍ਰਗਟੌਰੈ ॥੬੦॥",
      "s": 14
    },
    {
      "t": "ਲਗੇ ਘਾਇ ਜੇ ਸ੍ਰੋਨ ਬਮਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਤੇ ਗਜ ਬਾਜੀ ਹ੍ਵੈ ਜਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਤੇ ਚਲਿਤ ਅਮਿਤ ਜੋ ਸ੍ਵਾਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਤੇ ਅਸੁਰ ਕਰਤ ਪਰਗਾਸਾ ॥੬੧॥",
      "s": 14
    },
    {
      "t": "ਅਨਗਨ ਕਾਲ ਅਸੁਰ ਤਬ ਮਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਪਰੇ ਭੂਮਿ ਪਰ ਮਨਹੁ ਮੁਨਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਮੇਧਾ ਤੇ ਗਜ ਬਾਜ ਉਠਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੋਨਤ ਕੇ ਦਾਨਵ ਹ੍ਵੈ ਜਾਹੀ ॥੬੨॥",
      "s": 14
    },
    {
      "t": "ਬਾਨਨ ਕੀ ਬਰਖਾ ਉਠਿ ਕਰਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਰਿ ਮਾਰਿ ਕਰਿ ਕੋਪ ਉਚਰਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਤੇ ਅਸੁਰਨ ਕਿਯਾ ਪਸਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਦਸੇ ਦਿਸਨ ਹੂੰ ਕਹ ਭਰਿ ਡਾਰਾ ॥੬੩॥",
      "s": 14
    },
    {
      "t": "ਵਹੈ ਕਾਲਕਾ ਅਸੁਰ ਖਪਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਰਿ ਦੁਬਹਿਯਾ ਧੂਰਿ ਮਿਲਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਪੁਨਿ ਪੁਨਿ ਉਠੈ ਪ੍ਰਹਾਰੈ ਬਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਤੇ ਧਰਤ ਅਸੁਰ ਤਨ ਨਾਨਾ ॥੬੪॥",
      "s": 14
    },
    {
      "t": "ਟੂਕ ਟੂਕ ਦਾਨਵ ਜੇ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਤੇ ਅਨਿਕ ਅਸੁਰ ਹ੍ਵੈ ਗਏ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹੀ ਤੇ ਦਾਨਵ ਬਹੁ ਹ੍ਵੈ ਕਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਜੁਧ ਕਰੈ ਆਯੁਧ ਤੇ ਲੈ ਕਰਿ ॥੬੫॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਕਾਲ ਵੈ ਦੈਤ ਸੰਘਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਲ ਤਿਲ ਪਾਇ ਟੂਕ ਕਰਿ ਡਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਜੇਤਿਕ ਗਿਰੈ ਭੂਮਿ ਟੁਕ ਹ੍ਵੈ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਤ ਹੀ ਉਠੈ ਆਯੁਧਨ ਲੈ ਕੈ ॥੬੬॥",
      "s": 14
    },
    {
      "t": "ਤਿਲ ਤਿਲ ਕਰਿ ਭਟ ਜਿਤਕ ਉਡਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਤੇਤਕ ਤਹਾ ਅਸੁਰ ਬਨ ਆਏ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਕੇ ਟੂਕ ਟੂਕ ਜੇ ਕੀਏ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਤੇ ਬਹੁ ਦਾਨਵ ਭਵ ਲੀਏ ॥੬੭॥",
      "s": 14
    },
    {
      "t": "ਕੇਤਿਕ ਤਹਾ ਸੁਭੈ ਦੰਤੀ ਰਨ ॥",
      "s": 14
    },
    {
      "t": "ਸੀਚਹਿ ਸੁੰਡ ਬਾਰਿ ਤੇ ਸਭ ਤਨ ॥",
      "s": 14
    },
    {
      "t": "ਦਾਤ ਦਿਖਾਇ ਤਜੈ ਚਿੰਘਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਗਿਰਿ ਗਿਰਿ ਪਰੈ ਨਿਰਖਿ ਅਸਵਾਰਾ ॥੬੮॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਭੇਰ ਭੀਖਨ ਭਭਕਾਰਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਬੀਰ ਬਾਜੀ ਰਨ ਡਾਰਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਤਕ ਸੂਰ ਸੈਹਥੀ ਫਿਰਾਵਤ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਕਾਲ ਕੇ ਸਨਮੁਖ ਧਾਵਤ ॥੬੯॥",
      "s": 14
    },
    {
      "t": "ਕੇਤਿਕ ਬਜ੍ਰ ਬਰਛਿਯਨ ਲੈ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਧਾਵਤ ਅਸੁਰ ਕੋਪ ਤਨ ਤੈ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਕੋਪਿ ਕਾਲ ਪਰ ਕਰਤ ਪ੍ਰਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨੁਕ ਸਲਭ ਦੀਪ ਅਨੁਹਾਰਾ ॥੭੦॥",
      "s": 14
    },
    {
      "t": "ਭਰੇ ਗੁਮਾਨ ਬਡੇ ਗਰਬੀਲੇ ॥",
      "s": 14
    },
    {
      "t": "ਧਾਵਤ ਚੌਪਿ ਚੜੇ ਚਟਕੀਲੇ ॥",
      "s": 14
    },
    {
      "t": "ਪੀਸਿ ਪੀਸਿ ਰਦਨਛਦ ਦੋਊ ॥",
      "s": 14
    },
    {
      "t": "ਧਾਵਤ ਮਹਾ ਕਾਲ ਪਰ ਸੋਊ ॥੭੧॥",
      "s": 14
    },
    {
      "t": "ਬਾਜਹਿ ਢੋਲਿ ਮ੍ਰਿਦੰਗ ਨਗਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਭੀਖਨ ਕਰਤ ਭੇਰ ਭਭਕਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜੰਗ ਮੁਚੰਗ ਉਪੰਗ ਬਜੇ ਰਨ ॥",
      "s": 14
    },
    {
      "t": "ਝਾਲਰਿ ਤਾਲ ਨਫੀਰਨ ਕੇ ਗਨ ॥੭੨॥",
      "s": 14
    },
    {
      "t": "ਮੁਰਲੀ ਮੁਰਜ ਕਹੀ ਰਨ ਬਾਜਤ ॥",
      "s": 14
    },
    {
      "t": "ਦਾਨਵ ਭਰੇ ਗੁਮਾਨਹਿ ਗਾਜਤ ॥",
      "s": 14
    },
    {
      "t": "ਢੋਲਨ ਪਰ ਦੈ ਦੈ ਢਮਕਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਗਹਿ ਗਹਿ ਧਵਤ ਕ੍ਰਿਪਾਨ ਕਟਾਰੇ ॥੭੩॥",
      "s": 14
    },
    {
      "t": "ਦੀਰਘ ਦਾਤ ਕਾਢਿ ਕਈ ਕੋਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਧਾਵਤ ਅਸੁਰ ਹੀਏ ਕਰਿ ਜੋਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਰਨ ਮਹਾ ਕਾਲ ਕਹ ਧਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਮਨੋ ਮਾਰਤ ਵੇਈ ਮਰਿ ਜਾਵੈ ॥੭੪॥",
      "s": 14
    },
    {
      "t": "ਦਾਨਵ ਮਹਾ ਕੋਪ ਕਰਿ ਢੂਕੇ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਰਹਿ ਮਾਰਿ ਦਸੋ ਦਿਸਿ ਕੂਕੇ ॥",
      "s": 14
    },
    {
      "t": "ਦੈ ਦੈ ਢੋਲਿ ਮ੍ਰਿਦੰਗ ਨਗਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਢਿ ਕਾਢਿ ਅਰਿ ਦਾਤਿ ਡਰਾਰੇ ॥੭੫॥",
      "s": 14
    },
    {
      "t": "ਚਾਹਤ ਮਹਾ ਕਾਲ ਕਹ ਮਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਪੁਰਖ ਨਹਿ ਕਰਤ ਬਿਚਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਨ ਸਭ ਜਗ ਕਾ ਕਰਾ ਪਸਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਚਹਤ ਤੇ ਮੂੜ ਸੰਘਾਰਾ ॥੭੬॥",
      "s": 14
    },
    {
      "t": "ਠੋਕਿ ਠੋਕਿ ਭੁਜ ਦੰਡਨ ਜੋਧਾ ॥",
      "s": 14
    },
    {
      "t": "ਧਾਵਤ ਮਹਾ ਕਾਲ ਪਰ ਕ੍ਰੋਧਾ ॥",
      "s": 14
    },
    {
      "t": "ਬੀਸ ਪਦੁਮ ਦਾਨਵ ਤਵ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਸ ਕਰਨ ਕਾਲੀ ਕੋ ਧਯੋ ॥੭੭॥",
      "s": 14
    }
  ]
