{
  "page": 1363,
  "lines": [
    {
      "t": "ਛੂਹਨਿ ਸਹਸ ਅਸੁਰ ਕੀ ਸੈਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਧਾਵਤ ਭਈ ਅਰੁਨ ਕਰਿ ਨੈਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਧਾਵਤ ਕੋਪ ਅਮਿਤ ਕਰਿ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਿਥਵੀ ਕੇ ਖਟ ਪਟ ਉਡਿ ਗਏ ॥੭੮॥",
      "s": 14
    },
    {
      "t": "ਏਕੈ ਪੁਰ ਪ੍ਰਿਥਵੀ ਰਹਿ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਖਟ ਪਟ ਹਯਨ ਪਗਨ ਉਡਿ ਗਈ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁ ਬਿਧਿ ਏਕੈ ਰਚਾ ਪਯਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਗਗਨ ਰਚੇ ਦਸ ਤੀਨਿ ਸੁਧਾਰਾ ॥੭੯॥",
      "s": 14
    },
    {
      "t": "ਮਹਾਦੇਵ ਆਸਨ ਤੇ ਟਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਬ੍ਰਹਮਾ ਤ੍ਰਸਤ ਬੂਟ ਮਹਿ ਦੁਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਿ ਬਿਸਨ ਰਨ ਅਧਿਕ ਡਰਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਰਾ ਸਿੰਧ ਕੇ ਬੀਚ ਲਜਾਨਾ ॥੮੦॥",
      "s": 14
    },
    {
      "t": "ਕੜਾ ਕੜੀ ਮਾਚਾ ਘਮਸਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਤ ਦੇਵ ਦੈਤ ਜਾ ਨਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਘੋਰ ਆਹਵ ਤਹ ਪਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਪੀ ਭੂਮਿ ਗਗਨ ਥਰਹਰਾ ॥੮੧॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਿ ਜੁਧ ਕਾਪਾ ਕਮਲੇਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਧਰਾ ਨਾਰਿ ਕਾ ਭੇਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਪਰਬਤੀਸ ਲਖਿ ਡਰਾ ਲਰਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਸਾ ਬਨ ਬਿਖੈ ਅਤਿਥ ਕਹਾਈ ॥੮੨॥",
      "s": 14
    },
    {
      "t": "ਕਾਰਤਿਕੇਯ ਹ੍ਵੈ ਰਹਾ ਬਿਹੰਡਲ ॥",
      "s": 14
    },
    {
      "t": "ਬ੍ਰਹਮ ਛਾਡਿ ਗ੍ਰਿਹ ਗਯੋ ਕਮੰਡਲ ॥",
      "s": 14
    },
    {
      "t": "ਪਬ ਪਿਸਾਨ ਪਗਨ ਭੇ ਤਬ ਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਇ ਬਸੇ ਉਤਰ ਦਿਸਿ ਸਬ ਹੀ ॥੮੩॥",
      "s": 14
    },
    {
      "t": "ਡਗੀ ਧਰਨਿ ਅੰਬਰਿ ਘਹਰਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਜ ਖੁਰਨ ਤੇ ਪਬ ਪਿਸਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਅੰਧ ਗੁਬਾਰ ਭਯੋ ਬਾਨਨ ਤਨ ॥",
      "s": 14
    },
    {
      "t": "ਹਾਥ ਬਿਲੋਕ੍ਯੋ ਜਾਤ ਨ ਆਪਨ ॥੮੪॥",
      "s": 14
    },
    {
      "t": "ਬਿਛੂਆ ਬਾਨ ਬਜ੍ਰ ਰਨ ਬਰਖਤ ॥",
      "s": 14
    },
    {
      "t": "ਰਿਸਿ ਰਿਸਿ ਸੁਭਟ ਧਨੁਖ ਕਹ ਕਰਖਤ ॥",
      "s": 14
    },
    {
      "t": "ਤਕਿ ਤਕਿ ਬਾਨ ਪ੍ਰਕੋਪ ਚਲਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਭੇਦਿ ਤ੍ਰਾਨ ਤਨ ਪਰੈ ਪਰਾਵੈ ॥੮੫॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਹੀ ਭਏ ਅਮਿਤ ਰਣ ਜੋਧਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਢ੍ਯੋ ਮਹਾ ਕਾਲ ਕੈ ਕ੍ਰੋਧਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਕੋਪ ਕਰਿ ਬਿਸਿਖ ਪ੍ਰਹਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਸਤ੍ਰੁ ਛਿਨ ਮਾਝ ਸੰਘਾਰੇ ॥੮੬॥",
      "s": 14
    },
    {
      "t": "ਰਕਤ ਸੰਬੂਹ ਧਰਨਿ ਤਬ ਪਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਬਹੁ ਦਾਨ੍ਵਨ ਬਪੁ ਧਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਏਕ ਸਰ ਸਭਹਿ ਚਲਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਤੇ ਅਸੁਰ ਅਨਿਕ ਹ੍ਵੈ ਧਾਏ ॥੮੭॥",
      "s": 14
    },
    {
      "t": "ਆਏ ਜਿਤਕ ਤਿਤਕ ਤਹ ਮਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੇ ਧਰਨਿ ਪਰ ਰਕਤ ਪਨਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਤੇ ਅਮਿਤ ਅਸੁਰਨ ਬਪੁ ਧਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਹਮ ਤੇ ਜਾਤ ਬਿਚਾਰ ਨ ਕਰਾ ॥੮੮॥",
      "s": 14
    },
    {
      "t": "ਡਗਮਗ ਲੋਕ ਚਤੁਰਦਸ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਅਸੁਰਨ ਸਾਥ ਸਕਲ ਭਰਿ ਗਏ ॥",
      "s": 14
    },
    {
      "t": "ਬ੍ਰਹਮਾ ਬਿਸਨ ਸਭੈ ਡਰਪਾਨੇ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਕਾਲ ਕੀ ਸਰਨਿ ਸਿਧਾਨੇ ॥੮੯॥",
      "s": 14
    }
  ]
}
