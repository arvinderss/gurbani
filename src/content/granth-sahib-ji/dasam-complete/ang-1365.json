{
  "page": 1365,
  "lines": [
    {
      "t": "ਕਰਿ ਕਰਿ ਕੋਪ ਕਾਲ ਸ੍ਰੀ ਤਬ ਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਰਥ ਪਰ ਚੜਾ ਸਸਤ੍ਰ ਲੈ ਸਭ ਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਸਕਲ ਸਤ੍ਰੁਅਨ ਕੇ ਛੈ ਕਾਰਨ ॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਸੰਤਨ ਕੇ ਪ੍ਰਾਨ ਉਬਾਰਨ ॥੧੦੨॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਾਨ ਔਰ ਪਾਨਿਪ ਧਨੁ ਰਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਾਖਨ ਚੜਾ ਸੇਵਕਨ ਕਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੀ ਧੁਜਾ ਬਿਖੈ ਰਾਜਿਤ ਅਸਿ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਿ ਸਤ੍ਰੁ ਜਿਹ ਹੋਤ ਬਿਮਨ ਬਸਿ ॥੧੦੩॥",
      "s": 14
    },
    {
      "t": "ਅਸਿਧੁਜ ਅਧਿਕ ਕੋਪ ਕਰਿ ਧਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਬੈਰਿ ਬ੍ਰਿੰਦ ਦਲ ਪ੍ਰਗਟ ਖਪਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਧੁਨ ਕੀ ਰਛਾ ਕਰਿ ਲੀਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਸਤ੍ਰੁ ਸੈਨ ਤਿਲ ਤਿਲ ਖੈ ਕੀਨੀ ॥੧੦੪॥",
      "s": 14
    },
    {
      "t": "ਤਿਲ ਤਿਲ ਏਕ ਏਕ ਕਰਿ ਡਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਗਜੀ ਰਥੀ ਬਾਜਿਯਨ ਬਿਦਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਤੇ ਅਮਿਤ ਅਸੁਰ ਉਠਿ ਧਏ ॥",
      "s": 14
    },
    {
      "t": "ਘੇਰਤ ਮਹਾਕਾਲ ਕਹ ਭਏ ॥੧੦੫॥",
      "s": 14
    },
    {
      "t": "ਮਚਤ ਭਯੋ ਜਬ ਹੀ ਰਨ ਦਾਰੁਨ ॥",
      "s": 14
    },
    {
      "t": "ਕਟਿ ਕਟਿ ਗਏ ਬਾਜ ਅਰੁ ਬਾਰੁਨ ॥",
      "s": 14
    },
    {
      "t": "ਜੰਬਕ ਗੀਧ ਮਾਸੁ ਲੈ ਗਏ ॥",
      "s": 14
    },
    {
      "t": "ਰਨ ਤਜਿ ਸੁਭਟਨ ਭਾਜਤ ਭਏ ॥੧੦੬॥",
      "s": 14
    },
    {
      "t": "ਸਸਤ੍ਰ ਸਾਜ ਕੋਪਾ ਤਬ ਕਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਧਾਰਨ ਭਯੋ ਭੇਸ ਬਿਕਰਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਨ ਅਨੇਕ ਕੋਪ ਕਰਿ ਛੋਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਸਤ੍ਰੁ ਅਨੇਕਨ ਕੇ ਸਿਰ ਫੋਰੇ ॥੧੦੭॥",
      "s": 14
    },
    {
      "t": "ਹਕਾਹਕੀ ਮਾਚਾ ਸੰਗ੍ਰਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਪਠੈ ਦਏ ਬਹੁ ਅਰਿ ਮ੍ਰਿਤੁ ਧਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਜ ਖੁਰਨ ਭੂ ਆਕੁਲ ਭਈ ॥",
      "s": 14
    },
    {
      "t": "ਖਟ ਪਟ ਭੂਮਿ ਗਗਨ ਉਡਿ ਗਈ ॥੧੦੮॥",
      "s": 14
    },
    {
      "t": "ਏਕੈ ਰਹਿ ਗਯੋ ਜਬੈ ਪਯਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਐਸਾ ਮਚਾ ਜੁਧ ਬਿਕਰਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਕਾਲ ਕੈ ਭਯੋ ਪ੍ਰਸੇਤਾ ॥",
      "s": 14
    },
    {
      "t": "ਡਾਰਾ ਭੂਮਿ ਪੌਛਿ ਕਰਿ ਤੇਤਾ ॥੧੦੯॥",
      "s": 14
    },
    {
      "t": "ਭਟਾਚਾਰਜ ਰੂਪ ਤਬ ਧਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਦਨ ਪ੍ਰਸੇਤ ਧਰਨਿ ਜੋ ਪਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਢਾਢਿ ਸੈਨ ਢਾਢੀ ਬਪੁ ਲਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕਰਖਾ ਬਾਰ ਉਚਾਰਤ ਭਯੋ ॥੧੧੦॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਅਰਿ ਕਾਲ ਕ੍ਰਿਪਾਨ ਪ੍ਰਹਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਤੇ ਦੋਇ ਪੁਰਖ ਕੈ ਡਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਦ੍ਵੈ ਮਨੁਖਨ ਪਰ ਕਰਤ ਪ੍ਰਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਦ੍ਵੈ ਤੇ ਹੋਤ ਛਿਨਿਕ ਮੋ ਚਾਰਾ ॥੧੧੧॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਕਾਲ ਕੀਨਾ ਘਮਸਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਰਤ ਭਯੋ ਦੈਤ ਬਿਧਿ ਨਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਪ੍ਰਸੇਤ ਧਰਨਿ ਪਰ ਪਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਮ ਸੈਨ ਤਾ ਤੇ ਬਪੁ ਧਰਿਯੋ ॥੧੧੨॥",
      "s": 14
    },
    {
      "t": "ਕਾਢਿ ਕ੍ਰਿਪਾਨ ਧਸੌ ਹੁੰਕਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਤੇ ਅਮਿਤ ਗਨਨ ਤਨ ਧਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਢੋਲ ਪਟਹਿ ਇਕ ਤਾਲ ਬਜਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਜੰਗ ਮੁਚੰਗ ਉਪੰਗ ਸੁਨਾਵੈ ॥੧੧੩॥",
      "s": 14
    }
  ]
}
