{
  "page": 1366,
  "lines": [
    {
      "t": "ਗੋਮੁਖ ਝਾਝਰ ਤੂਰ ਅਪਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਢੋਲ ਮ੍ਰਿਦੰਗ ਮੁਚੰਗ ਨਗਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਜਤ ਭੇਰ ਭਭਾਕਹਿ ਭੀਖਨ ॥",
      "s": 14
    },
    {
      "t": "ਕਸਿ ਧਨੁ ਤਜਤ ਸੁਭਟ ਸਰ ਤੀਛਨ ॥੧੧੪॥",
      "s": 14
    },
    {
      "t": "ਭਰਿ ਗੇ ਕੁੰਡ ਤਹਾ ਸ੍ਰੋਨਤ ਤਨ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਗਟੇ ਅਸੁਰ ਤਵਨ ਤੇ ਅਨਗਨ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਰਿ ਮਾਰਿ ਮਿਲਿ ਕਰਤ ਪੁਕਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਤੇ ਪ੍ਰਗਟਤ ਅਸੁਰ ਹਜਾਰਾ ॥੧੧੫॥",
      "s": 14
    },
    {
      "t": "ਤਿਨਹਿ ਕਾਲ ਜਬ ਧਰਨਿ ਗਿਰਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੋਨ ਪੁਲਿਤ ਹ੍ਵੈ ਭੂਮਿ ਸੁਹਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਅਮਿਤ ਅਸੁਰ ਉਠਿ ਭਜਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਨ ਕ੍ਰਿਪਾਨ ਸੈਹਥੀ ਸਜਹੀ ॥੧੧੬॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਕੋਪ ਕਰਿ ਸਮੁਹਿ ਸਿਧਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਸਭੈ ਕਾਲ ਛਿਨ ਇਕ ਮੋ ਮਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਤੇ ਸ੍ਰੋਨਤ ਪਰਾ ਸਬੂਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਜਤ ਭਏ ਅਸੁਰ ਤਬ ਬਿਯੂਹਾ ॥੧੧੭॥",
      "s": 14
    },
    {
      "t": "ਦਾਰੁਨ ਮਚਾ ਜੁਧ ਤਬ ਝਟ ਪਟ ॥",
      "s": 14
    },
    {
      "t": "ਉਡਿਗੇ ਬਾਜ ਖੂਰਨ ਭੂ ਖਟ ਪਟ ॥",
      "s": 14
    },
    {
      "t": "ਹ੍ਵੈ ਗੇ ਤੇਰਹ ਗਗਨ ਅਪਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਏਕੈ ਰਹਿ ਗਯੋ ਤਹਾ ਪਤਾਰਾ ॥੧੧੮॥",
      "s": 14
    },
    {
      "t": "ਭਟਾਚਾਰਜ ਇਤੈ ਜਸੁ ਗਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਢਾਢਿ ਸੈਨ ਕਰਖਾਹੁ ਸੁਨਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਮਿ ਤਿਮਿ ਕਾਲਹਿ ਬਢੈ ਗੁਮਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਚਹਿ ਚਹਿ ਹਨੇ ਦੁਬਹਿਯਾ ਨਾਨਾ ॥੧੧੯॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਤੇ ਮੇਦ ਮਾਸ ਜੋ ਪਰ ਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਰਥੀ ਗਜੀ ਬਾਜੀ ਤਨ ਧਰ ਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਕੇਤਿਕ ਭਏ ਅਸੁਰ ਬਿਕਰਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਕੇ ਬਰਨਨ ਕਰੌ ਸਿਧਾਰਾ ॥੧੨੦॥",
      "s": 14
    },
    {
      "t": "ਏਕੈ ਚਰਨ ਆਖਿ ਏਕੈ ਜਿਨਿ ॥",
      "s": 14
    },
    {
      "t": "ਭੁਜਾ ਅਮਿਤ ਸਹਸ ਦ੍ਵੈ ਕੈ ਤਿਨ ॥",
      "s": 14
    },
    {
      "t": "ਪਾਚ ਪਾਚ ਸੈ ਭੁਜ ਕੇ ਘਨੇ ॥",
      "s": 14
    },
    {
      "t": "ਸਸਤ੍ਰ ਅਸਤ੍ਰ ਹਾਥਨ ਮੈ ਬਨੇ ॥੧੨੧॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਚਰਨ ਏਕੈ ਕੀ ਨਾਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਏਕ ਭੁਜ ਭ੍ਰਮਤ ਅਕਾਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਰਧ ਮੂੰਡ ਮੁੰਡਿਤ ਕੇਤੇ ਸਿਰ ॥",
      "s": 14
    },
    {
      "t": "ਕੇਸਨ ਧਰੇ ਕਿਤਕ ਧਾਏ ਫਿਰਿ ॥੧੨੨॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਏਕ ਮਦ ਕੋ ਸਰ ਪੀਯੈ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਨਵ ਖਾਇ ਜਗਤ ਕੇ ਜੀਯੈ ॥",
      "s": 14
    },
    {
      "t": "ਦਸ ਸਹੰਸ ਭਾਗ ਕੇ ਭਰਿ ਘਟ ॥",
      "s": 14
    },
    {
      "t": "ਪੀ ਪੀ ਭਿਰਤ ਅਸੁਰ ਰਨ ਚਟ ਪਟ ॥੧੨੩॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਜ੍ਰ ਬਾਨ ਬਿਛੂਆ ਬਿਸਿਖ ਬਰਖੈ ਸਸਤ੍ਰ ਅਪਾਰ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਊਚ ਨੀਚ ਕਾਤਰ ਸੁਭਟ ਸਭ ਕੀਨੇ ਇਕ ਸਾਰ ॥੧੨੪॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਭਯੋ ਘੋਰ ਸੰਗ੍ਰਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਲੈ ਲੈ ਅਮਿਤ ਜੁਧ ਕਾ ਸਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਕਾਲ ਕੋਪਤ ਭਯੋ ਜਬ ਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਅਸੁਰ ਅਨੇਕ ਬਿਦਾਰੇ ਤਬ ਹੀ ॥੧੨੫॥",
      "s": 14
    }
  ]
}
