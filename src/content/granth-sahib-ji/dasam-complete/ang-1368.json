{
  "page": 1368,
  "lines": [
    {
      "t": "ਕਹੂੰ ਬੀਰ ਮਾਰੇ ਗਿਰੇ ਭੂਮਿ ਮੋਹੈ ॥੧੩੭॥",
      "s": 14
    },
    {
      "t": "ਜਿਤੇ ਸ੍ਰੋਨ ਕੇ ਬੂੰਦ ਭੂ ਪੈ ਪਰੇ ਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਤੇ ਦਾਨਵੋ ਰੂਪ ਬਾਕੇ ਧਰੇ ਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਹਠੀ ਓਰ ਚਾਰੌ ਬਿਖੈ ਆਨਿ ਢੂਕੇ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਕੋਪ ਕੈ ਮਾਰ ਹੀ ਮਾਰਿ ਕੂਕੈ ॥੧੩੮॥",
      "s": 14
    },
    {
      "t": "ਜਿਤੇ ਦੈਤ ਆਏ ਤਿਤੇ ਕਾਲ ਮਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੇ ਸ੍ਰੋਨ ਕੇ ਭੂਮ ਹੂੰ ਪੈ ਪਨਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਉਠ ਦੈਤ ਬਾਕੇ ਬਲੀ ਸਸਤ੍ਰ ਲੈ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਹੂੰ ਓਰ ਤੇ ਮਾਰ ਹੀ ਮਾਰਿ ਕੈ ਕੈ ॥੧੩੯॥",
      "s": 14
    },
    {
      "t": "ਹਠੀ ਬਧਿ ਗੋਪਾ ਗੁਲਿਤ੍ਰਾਨ ਬਾਕੇ ॥",
      "s": 14
    },
    {
      "t": "ਹਠੀਲੇ ਕਟੀਲੇ ਰਜੀਲੇ ਨਿਸਾਕੇ ॥",
      "s": 14
    },
    {
      "t": "ਗਦਾ ਹਾਥ ਲੈ ਕੇ ਕਿਤੇ ਬੀਰ ਗਾਜੇ ॥",
      "s": 14
    },
    {
      "t": "ਲਰੇ ਆਨਿ ਕੈ ਪੈਗ ਦ੍ਵੈ ਕੈ ਨ ਭਾਜੇ ॥੧੪੦॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਬੀਰ ਮਾਰੇ ਬਿਦਾਰੇ ਪਰੇ ਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਖੇਤ ਮੈ ਖਿੰਗ ਖਤ੍ਰੀ ਜਰੇ ਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਮਤ ਦੰਤੀ ਕਹੂੰ ਉਸਟ ਮਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਰਾਜੈ ਕਹੂੰ ਨਗਨ ਖੰਡੇ ਕਟਾਰੇ ॥੧੪੧॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਖੋਲ ਖਾਡੇ ਗਿਰੇ ਭੂਮਿ ਸੋਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਬੀਰ ਬਾਨੀ ਪਰੇ ਭੂਮਿ ਮੋਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਸ੍ਵਾਰ ਮਾਰੇ ਫਿਰੈ ਬਾਜ ਛੂਟੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਤੇ ਛੈਲ ਛੋਰੇ ਕਿਤੇ ਦੁਸਟ ਲੂਟੈ ॥੧੪੨॥",
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਤਹਾ ਭਯੋ ਸੰਗ੍ਰਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਤ ਦੇਵ ਦਾਨਵੀ ਬਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਕੇਤਿਕ ਕਰੀ ਕਰਨ ਬਿਨੁ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਾਪਤ ਦੁਸਟ ਨਿਧਨ ਕਹ ਗਏ ॥੧੪੩॥",
      "s": 14
    },
    {
      "t": "ਮਾਰਹਿ ਮਾਰਿ ਮਹਾ ਸੂਰ ਕੂਕਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਢਿ ਕਾਢਿ ਦਾਤਨ ਕਹ ਢੂਕਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਜਹਿ ਢੋਲ ਮ੍ਰਿਦੰਗ ਨਗਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਜੰਗ ਮਚੰਗ ਉਪੰਗ ਜੁਝਾਰੇ ॥੧੪੪॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਤਨ ਕਾਲ ਬਿਸਿਖ ਕੀ ਮਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕਹ ਤਹੀ ਚੂਰ ਕਰਿ ਡਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕਰ ਕੋਪਿ ਕ੍ਰਿਪਾਨ ਪ੍ਰਹਾਰਤ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਕਾ ਮੂੰਡ ਕਾਟਿ ਹੀ ਡਾਰਤ ॥੧੪੫॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਭਯੋ ਭਯਾਨਕ ਜੁਧਾ ॥",
      "s": 14
    },
    {
      "t": "ਉਪਜਾ ਕਛੁਕ ਕਾਲ ਕੇ ਕ੍ਰਧਾ ॥",
      "s": 14
    },
    {
      "t": "ਕੇਸਨ ਤੇ ਗਹਿ ਅਸੁਰ ਪਛਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਢਿ ਕ੍ਰਿਪਾਨ ਏਕ ਹਨਿ ਡਾਰੇ ॥੧੪੬॥",
      "s": 14
    },
    {
      "t": "ਮਾਰੇ ਅਧਿਕ ਤਾਹਿ ਦਾਨਵ ਰਨ ॥",
      "s": 14
    },
    {
      "t": "ਟੂਕ ਟੂਕ ਹ੍ਵੈਗੇ ਤਿਨ ਕੇ ਤਨ ॥",
      "s": 14
    },
    {
      "t": "ਤਊ ਮਾਰ ਹੀ ਮਾਰਿ ਪੁਕਾਰਤ ॥",
      "s": 14
    },
    {
      "t": "ਪਾਛੇ ਪਾਵ ਏਕ ਨਹਿ ਡਾਰਤ ॥੧੪੭॥",
      "s": 14
    },
    {
      "t": "ਕੇਤਿਕ ਘੂਮਿ ਗਿਰਤ ਹੈ ਘਾਇਲ ॥",
      "s": 14
    },
    {
      "t": "ਪਰਤ ਭਏ ਭੂ ਤਰ ਹ੍ਵੈ ਹਾਇਲ ॥",
      "s": 14
    },
    {
      "t": "ਤਊ ਜੁਧ ਕੋ ਤ੍ਯਾਗਿ ਨ ਭਜਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਲਗਿ ਦੁਸਟ ਪ੍ਰਾਨ ਨਹਿ ਤਜਹੀ ॥੧੪੮॥",
      "s": 14
    },
    {
      "t": "ਗੁਰਜ ਗੋਫਨੈ ਕਿਤਕ ਸੰਭਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਕੇਤਿਕ ਕਸਿ ਕਸਿ ਬਾਨ ਪ੍ਰਹਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਤੇ ਤਮਕਿ ਰਨ ਤੁਰੀ ਨਚਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਚਟਪਟ ਸੁਭਟ ਜੂਝਿ ਰਨ ਜਾਵੈ ॥੧੪੯॥",
      "s": 14
    },
    {
      "t": "ਕਿਤਕ ਤਮਕਿ ਰਨ ਤੁਰੀ ਨਚਾਵਤ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਰਿ ਮਾਰਿ ਧੁਨਿ ਕਿਤਕ ਉਘਾਵਤ ॥",
      "s": 14
    },
    {
      "t": "ਮੰਡਹਿ ਮਹਾ ਕਾਲ ਸੌ ਜੁਧਾ ॥",
      "s": 14
    },
    {
      "t": "ਹ੍ਵੈ ਹ੍ਵੈ ਅਧਿਕ ਚਿਤ ਮਹਿ ਕ੍ਰੁਧਾ ॥੧੫੦॥",
      "s": 14
    },
    {
      "t": "ਜੇਤਿਕ ਸੁਭਟ ਕੋਪਿ ਕਰਿ ਆਏ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਕਾਲ ਤੇਤੇ ਈ ਖਪਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਕੋ ਮੇਦ ਮਾਸ ਭੂਅ ਪਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁ ਅਸੁਰਨ ਤਾ ਤੇ ਬਪੁ ਧਰਾ ॥੧੫੧॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਕਾਲ ਤੇ ਦਏ ਖਪਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੋਨਤ ਸੋ ਪ੍ਰਿਥਵੀ ਰਹੀ ਛਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਤੇ ਅਮਿਤ ਅਸੁਰ ਉਠਿ ਢੂਕੇ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਰਹਿ ਮਾਰਿ ਦਸੌ ਦਿਸਿ ਕੂਕੇ ॥੧੫੨॥",
      "s": 14
    },
    {
      "t": "ਕੇਤਿਕ ਕੀ ਬਾਹਨ ਕਟਿ ਡਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਰੇ ਰੁੰਡ ਬਿਨੁ ਮੁੰਡ ਹਜਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਕੇਤਿਕ ਚੀਰ ਅਧੌ ਅਧ ਡਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਚਤ ਭੂਤ ਪ੍ਰੇਤ ਮਤਵਾਰੇ ॥੧੫੩॥",
      "s": 14
    },
    {
      "t": "ਜੇ ਤਿਨ ਕੇ ਸਿਰਿ ਬਹੀ ਕ੍ਰਿਪਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਅਰਧ ਅਰਧ ਹ੍ਵੈ ਜੂਝੇ ਜ੍ਵਾਨੈ ॥",
      "s": 14
    },
    {
      "t": "ਗਜ ਬਾਜੀ ਲੋਟਤ ਕਹੂੰ ਭੂ ਪਰ ॥",
      "s": 14
    },
    {
      "t": "ਸੁੰਭਨ ਸਬਦ ਸੁਨਾ ਅਵਨੀ ਤਰ ॥੧੫੪॥",
      "s": 14
    },
    {
      "t": "ਗਿਰਿ ਗਿਰਿ ਪਰੇ ਕਹੂੰ ਘਾਯਲ ਰਨ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਜਿ ਚਲੇ ਕਈ ਹੋਇ ਬਿਮਨ ਮਨ ॥",
      "s": 14
    }
  ]
}
