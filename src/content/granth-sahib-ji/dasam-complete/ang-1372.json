{
  "page": 1372,
  "lines": [
    {
      "t": "ਮੋਹਨਾਸਤ੍ਰ ਕੇਤੇ ਮੋਹਿਤ ਕਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਬਰੁਣਾਸਤ੍ਰ ਭੇ ਪ੍ਰਾਨ ਕਿਤਨ ਹਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਪਾਵਕਾਸਤ੍ਰ ਭੇ ਅਧਿਕ ਜਰਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਅਮਿਤ ਸੁਭਟ ਮ੍ਰਿਤ ਲੋਕ ਪਠਾਏ ॥੧੯੧॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਪਰ ਮਹਾ ਕਾਲ ਅਸਿ ਝਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਸੁਭਟ ਤੇ ਦ੍ਵੈ ਕਰਿ ਡਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜੌ ਦ੍ਵੈ ਨਰ ਪਰ ਟੁਕ ਅਸਿ ਧਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਚਾਰਿ ਟੂਕ ਤਿਨ ਦ੍ਵੈ ਕੈ ਕਰਾ ॥੧੯੨॥",
      "s": 14
    },
    {
      "t": "ਕੇਤਿਕ ਪਰੇ ਸੁਭਟ ਬਿਲਲਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਜੰਬੁਕ ਗਿਧ ਮਾਸੁ ਲੈ ਜਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਭੈਰਵ ਆਨਿ ਦੁਹੂੰ ਭਭਕਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਮਸਾਨ ਕਿਲਕਟੀ ਮਾਰੈ ॥੧੯੩॥",
      "s": 14
    },
    {
      "t": "ਕੇਤਿਕ ਸੁਭਟ ਆਨਿ ਹੀ ਢੂਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਰਹਿ ਮਾਰਿ ਦਸੋ ਦਿਸਿ ਕੂਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਕਾਲ ਪਰ ਜੇ ਬ੍ਰਿਣ ਕਰਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਕੁੰਠਤ ਹੋਇ ਧਰਨਿ ਗਿਰ ਪਰਹੀ ॥੧੯੪॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਕੋਪ ਕਰਿ ਅਸੁਰ ਅਪਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਅ ਮਹਾ ਕਾਲ ਕਹ ਕਰਤ ਪ੍ਰਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤੇ ਵੈ ਏਕ ਰੂਪ ਹ੍ਵੈ ਜਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਕਾਲ ਕੇ ਮਧ੍ਯ ਸਮਾਹੀ ॥੧੯੫॥",
      "s": 14
    },
    {
      "t": "ਜਿਮਿ ਕੋਈ ਬਾਰਿ ਬਾਰਿ ਪਰ ਮਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਹੋਤ ਲੀਨ ਤਿਹ ਮਾਝ ਸੁਧਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਪੁਨਿ ਕੋਈ ਤਾਹਿ ਨ ਸਕਤ ਪਛਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਆਗਿਲ ਆਹਿ ਕਿ ਮੋਰਾ ਪਾਨੀ ॥੧੯੬॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਭਏ ਸਸਤ੍ਰ ਜਬ ਲੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਸੁਰਨ ਕੋਪ ਅਮਿਤ ਤਬ ਕੀਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਪਤ ਅਧਿਕ ਚਿਤ ਮੋ ਗਏ ॥",
      "s": 14
    },
    {
      "t": "ਸਸਤ੍ਰ ਅਸਤ੍ਰ ਲੈ ਆਵਤ ਭਏ ॥੧੯੭॥",
      "s": 14
    },
    {
      "t": "ਜ੍ਵਾਲ ਤਜੀ ਕਰਿ ਕੋਪ ਨਿਸਾਚਰ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਤੇ ਭਏ ਪਠਾਨ ਧਨੁਖ ਧਰ ॥",
      "s": 14
    },
    {
      "t": "ਪੁਨਿ ਮੁਖ ਤੇ ਉਲਕਾ ਜੇ ਕਾਢੇ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਮੁਗਲ ਉਪਜਿ ਭੇ ਠਾਢੇ ॥੧੯੮॥",
      "s": 14
    },
    {
      "t": "ਪੁਨਿ ਰਿਸਿ ਤਨ ਤਿਨ ਸ੍ਵਾਸ ਨਿਕਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਸੈਯਦ ਸੇਖ ਭਏ ਰਿਸ ਵਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਧਾਏ ਸਸਤ੍ਰ ਅਸਤ੍ਰ ਕਰ ਲੈ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਮਕਿ ਤੇਜ ਰਨ ਤੁਰੀ ਨਚੈ ਕੈ ॥੧੯੯॥",
      "s": 14
    },
    {
      "t": "ਖਾਨ ਪਠਾਨ ਢੁਕੇ ਰਿਸਿ ਕੈ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਕੋਪਿ ਕ੍ਰਿਪਾਨ ਨਗਨ ਕਰ ਲੈ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਕਾਲ ਕੌ ਕਰਤ ਪ੍ਰਹਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਨ ਉਪਰਤ ਰੋਮ ਉਪਾਰਾ ॥੨੦੦॥",
      "s": 14
    },
    {
      "t": "ਅਮਿਤ ਖਾਨ ਕਰਿ ਕੋਪ ਸਿਧਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਮਦ ਕਰਿ ਭਏ ਸਕਲ ਮਤਵਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਉਮਡੇ ਅਮਿਤ ਮਲੇਛਨ ਕੇ ਗਨ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਕੇ ਨਾਮ ਕਹਤ ਤੁਮ ਸੌ ਭਨਿ ॥੨੦੧॥",
      "s": 14
    },
    {
      "t": "ਨਾਹਰ ਖਾਨ ਝੜਾਝੜ ਖਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਖਾਨ ਨਿਹੰਗ ਭੜੰਗ ਜੁਆਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਔਰ ਝੜੰਗ ਖਾਨ ਰਨ ਧਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਮਿਤ ਸਸਤ੍ਰ ਕਰ ਲਏ ਸਿਧਾਯੋ ॥੨੦੨॥",
      "s": 14
    }
  ]
}
