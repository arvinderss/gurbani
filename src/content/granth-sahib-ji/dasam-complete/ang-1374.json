{
  "page": 1374,
  "lines": [
    {
      "t": "ਸੈਦ ਹੁਸੈਨ ਕੋਪ ਕਰਿ ਗਰਜੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਫਰ ਸੈਦ ਰਹਾ ਨਹਿ ਬਰਜੋ ॥",
      "s": 14
    },
    {
      "t": "ਲੋਹ ਪ੍ਰਜੰਤ ਬਾਨ ਤਨਿ ਮਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਭਏ ਲੀਨ ਨਹਿ ਬਹੁਰਿ ਨਿਹਾਰੇ ॥੨੧੫॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰੋ ਅਮਿਤ ਕੋਪ ਕਹ ਕਰਿ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਛਾਡੇ ਬਿਸਿਖ ਧਨੁਖ ਕੌ ਧਰਿ ਕੈ ॥",
      "s": 14
    },
    {
      "t": "ਛੂਟਤ ਭਏ ਸਲਭ ਕੀ ਜਿਮਿ ਸਰ ॥",
      "s": 14
    },
    {
      "t": "ਲੀਨ ਭਏ ਨਹਿ ਲਖੇ ਦ੍ਰਿਗਨ ਕਰਿ ॥੨੧੬॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਮਾਰਿ ਸੈਯਦੀ ਸੈਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੇਖ ਫੌਜ ਭਾਜੀ ਬਿਨੁ ਚੈਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਕਾਲ ਜਬ ਭਜੇ ਨਿਹਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਬਿਸਿਖ ਕੋਪ ਨਹਿ ਤਾਹਿ ਪ੍ਰਹਾਰੇ ॥੨੧੭॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰੌ ਭਿਰੇ ਸੇਖ ਭਰਿ ਲਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਲੈ ਲੈ ਸਸਤ੍ਰ ਅਸਤ੍ਰ ਸਭ ਸਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਮਿ ਮ੍ਰਿਗ ਬਧ ਮ੍ਰਿਗਪਤਿ ਕੌ ਤਕਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਝਖਿ ਝਖਿ ਗਿਰਤ ਮਾਰਿ ਨਹਿ ਸਕਹੀ ॥੨੧੮॥",
      "s": 14
    },
    {
      "t": "ਸੇਖ ਫਰੀਦ ਹਨਾ ਤਤਕਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੇਖ ਉਜੈਨ ਹਨਾ ਬਿਕਰਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੇਖ ਅਮਾਨੁਲਹ ਪੁਨਿ ਮਾਰਿਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੇਖ ਵਲੀ ਕੋ ਸੈਨ ਸੰਘਾਰਿਯੋ ॥੨੧੯॥",
      "s": 14
    },
    {
      "t": "ਤਿਲ ਤਿਲ ਪਾਇ ਸੁਭਟ ਕਹੂੰ ਕਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਚਰਮ ਬਰਮ ਰਨ ਮੋ ਕਹੂੰ ਝਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਭਖਿ ਭਖਿ ਉਠੈ ਸੁਭਟ ਕਹੂੰ ਕ੍ਰੁਧਾ ॥",
      "s": 14
    },
    {
      "t": "ਦਾਰੁਣ ਮਚਿਯੋ ਐਸ ਤਹ ਜੁਧਾ ॥੨੨੦॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਕਬੰਧ ਫਿਰਤ ਸਿਰ ਬਿਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਸੁਭਟ ਗਹਿ ਦਾਤਨ ਤ੍ਰਿਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਰਛ ਰਛ ਕਹਿ ਤਾਹਿ ਪੁਕਾਰੈ ॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਮਹਾ ਕਾਲ ਜਿਨਿ ਹਮੈ ਸੰਘਾਰੈ ॥੨੨੧॥",
      "v": [
        [
          1,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਆਨਿ ਡਾਕਿਨਿ ਡਹਕਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਮਸਾਨ ਕਿਲਕਟੀ ਮਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਤ ਪਿਸਾਚ ਨਚੇ ਬੈਤਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਰਤ ਫਿਰਤ ਬੀਰਨ ਕਹ ਬਾਲਾ ॥੨੨੨॥",
      "s": 14
    },
    {
      "t": "ਏਕੈ ਅਛ ਏਕ ਹੀ ਬਾਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਚਰਨ ਅਰੁ ਅਰਧ ਸਨਾਹਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਸੁਭਟ ਬਿਕਟ ਹਨਿ ਡਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਪਵਨ ਬਲੀ ਜਨੁ ਰੂਖ ਉਖਾਰੇ ॥੨੨੩॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਅਰਿ ਕਾਲ ਕ੍ਰਿਪਾਨ ਬਹੀ ਸਿਰ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਕੇ ਰਹੀ ਨ ਜੀਵ ਕਰਾ ਫਿਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕਹ ਕਾਲ ਖੜਗ ਛ੍ਵੈ ਗਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਰਧੈ ਅਰਧ ਛਿਨਿਕ ਮਹਿ ਭਯਾ ॥੨੨੪॥",
      "s": 14
    },
    {
      "t": "ਬਹੀ ਜਾਹਿ ਸਿਰ ਸਰਕਿ ਸਰੋਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕਾ ਰਹਾ ਸੀਸੁ ਹ੍ਵੈ ਦੋਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੌ ਬਾਨ ਕਾਲ ਕਾ ਲਾਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਕੇ ਪ੍ਰਾਨ ਬਾਨ ਲੈ ਭਾਗਾ ॥੨੨੫॥",
      "s": 14
    },
    {
      "t": "ਮਾਰੂ ਬਜਤ ਦੋਊ ਦਿਸਿ ਐਸੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨੁਕ ਪ੍ਰਲੈ ਕਾਲ ਕੇ ਐਸੇ ॥",
      "s": 14
    },
    {
      "t": "ਗੋਮੁਖ ਝਾਝਰ ਤੂਰ ਅਪਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਢੋਲ ਮ੍ਰਿਦੰਗ ਮੁਚੰਗ ਹਜਾਰਾ ॥੨੨੬॥",
      "s": 14
    },
    {
      "t": "ਘੋਰ ਆਯੁਧਨ ਇਹ ਬਿਧਿ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਕੋ ਪਾਰ ਨ ਕਿਨਹੂੰ ਲਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਜੇਤਿਕ ਅਸੁਰ ਮਲੇਛੁਪਜਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਕਾਲ ਛਿਨ ਬੀਚ ਖਪਾਏ ॥੨੨੭॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਅਸੁਰ ਕ੍ਰੁਧਤ ਅਤਿ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਅਮਿਤ ਅਸੁਰ ਉਪਰਾਜਿ ਸੁ ਲਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਧੂਲੀ ਕਰਨ ਬਿਦਿਤ ਕੇਸੀ ਭਨ ॥",
      "s": 14
    },
    {
      "t": "ਘੋਰ ਦਾੜ ਅਰੁ ਸ੍ਰੋਨਤ ਲੋਚਨ ॥੨੨੮॥",
      "s": 14
    },
    {
      "t": "ਗਰਧਬ ਕੇਤੁ ਮਹਿਖ ਧੁਜ ਨਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਰੁਨ ਨੇਤ੍ਰ ਉਪਜਾ ਸੰਗ੍ਰਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਸਿਧੁਜ ਨਿਰਖਿ ਅਸੁਰ ਉਪਜੇ ਰਨ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਰਤ ਭਯੋ ਦਾਨਵਨ ਕੇ ਗਨ ॥੨੨੯॥",
      "s": 14
    },
    {
      "t": "ਅਸਿਧੁਜ ਕੋਪ ਅਧਿਕ ਕਹ ਕਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੈਨ ਦਾਨਵਨ ਕੋ ਰਨ ਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਸਸਤ੍ਰ ਪ੍ਰਹਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਲ ਤਿਲ ਪਾਇ ਸੁਭਟ ਕਟਿ ਡਾਰੇ ॥੨੩੦॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਹਨੀ ਸੈਨ ਅਸਿਧੁਜ ਜਬ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਪਤ ਭਯੋ ਅਸੁਰ ਜਿਯ ਮੋ ਤਬ ॥",
      "s": 14
    },
    {
      "t": "ਅਮਿਤ ਅਸੁਰ ਰਨ ਔਰ ਪ੍ਰਕਾਸੇ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਕੋ ਕਹਤ ਨਾਮ ਬਿਨੁ ਸਾਸੇ ॥੨੩੧॥",
      "s": 14
    },
    {
      "t": "ਗੀਧ ਧੁਜਾ ਕਾਕ ਧੁਜ ਰਾਛਸ ॥",
      "s": 14
    },
    {
      "t": "ਉਲੂ ਕੇਤੁ ਬੀਯੋ ਬਡ ਰਾਛਸ ॥",
      "s": 14
    },
    {
      "t": "ਅਸਿਧੁਜ ਕੇ ਰਨ ਸਮੁਹਿ ਸਿਧਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਰਿ ਮਾਰਿ ਚਹੂੰ ਓਰ ਉਘਾਏ ॥੨੩੨॥",
      "s": 14
    }
  ]
}
