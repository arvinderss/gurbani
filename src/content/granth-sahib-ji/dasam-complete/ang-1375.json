{
  "page": 1375,
  "lines": [
    {
      "t": "ਬਿਸਿਖਨ ਬ੍ਰਿਸਟਿ ਕਰੀ ਕੋਪਹਿ ਕਰਿ ॥",
      "s": 14
    },
    {
      "t": "ਜਲਧਰ ਐਸ ਬਡੇ ਭੂਧਰ ਪਰ ॥",
      "s": 14
    },
    {
      "t": "ਸਸਤ੍ਰ ਅਸਤ੍ਰ ਕਰਿ ਕੋਪ ਪ੍ਰਹਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਚਟਪਟ ਸੁਭਟ ਬਿਕਟਿ ਕਟਿ ਡਾਰੇ ॥੨੩੩॥",
      "s": 14
    },
    {
      "t": "ਹੁਅੰ ਸਬਦ ਅਸਿਧੁਜਹਿ ਉਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਹ ਤੇ ਆਧਿ ਬ੍ਰਯਾਧਿ ਬਪੁ ਧਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸੀਤ ਜ੍ਵਰ ਅਰ ਉਸਨ ਤਾਪ ਭਨੇ ॥",
      "s": 14
    },
    {
      "t": "ਛਈ ਰੋਗ ਅਰੁ ਸੰਨ੍ਰਯਪਾਤ ਗਨ ॥੨੩੪॥",
      "s": 14
    },
    {
      "t": "ਬਾਇ ਪਿਤ੍ਰਯ ਕਫ ਉਪਜਤ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਭੇਦ ਅਮਿਤ ਹ੍ਵੈ ਗਏ ॥",
      "s": 14
    },
    {
      "t": "ਨਾਮ ਤਿਨੈ ਗਨ ਪ੍ਰਗਟ ਸੁਨਾਊ ॥",
      "s": 14
    },
    {
      "t": "ਅਯੁਰ ਬੇਦਿਯਨ ਸਭਨ ਰਿਝਾਊ ॥੨੩੫॥",
      "s": 14
    },
    {
      "t": "ਆਮ ਪਾਤ ਅਰ ਸ੍ਰੋਨਤ ਪਾਤ ॥",
      "s": 14
    },
    {
      "t": "ਅਰਧ ਸਿਰਾ ਅਰੁ ਹ੍ਰਿਦੈ ਸੰਘਾਤ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰਾਨ ਬਾਇ ਆਪਾਨ ਬਾਇ ਭਨਿ ॥",
      "s": 14
    },
    {
      "t": "ਦੰਤ ਰੋਗ ਅਰੁ ਦਾੜ ਪੀੜ ਗਨ ॥੨੩੬॥",
      "s": 14
    },
    {
      "t": "ਸੂਖਾ ਜਰ ਤੇਇਯਾ ਚੌਥਾਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਸਟ ਦਿਵਸਯੋ ਅਰੁ ਬੀਸਾਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਡੇਢ ਮਾਸਿਯਾ ਪੁਨਿ ਤਪ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਦਾਤ ਕਾਢ ਦੈਤਨ ਪਰ ਧਯੋ ॥੨੩੭॥",
      "s": 14
    },
    {
      "t": "ਫੀਲਪਾਵ ਪੁਨਿ ਜਾਨੂ ਰੋਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਉਪਜਾ ਦੇਨ ਦੁਸਟ ਦਲ ਸੋਗਾ ॥",
      "s": 14
    },
    {
      "t": "ਖਈ ਸੁ ਬਾਦੀ ਭਈ ਮਵੇਸੀ ॥",
      "s": 14
    },
    {
      "t": "ਪਾਡ ਰੋਗ ਪੀਨਸ ਕਟਿ ਦੇਸੀ ॥੨੩੮॥",
      "s": 14
    },
    {
      "t": "ਚਿਨਗਿ ਪ੍ਰਮੇਵ ਭਗਿੰਦ੍ਰ ਦਖੂਤ੍ਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਪਥਰੀ ਬਾਇ ਫਿਰੰਗ ਅਧਨੇਤ੍ਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਗਲਤ ਕੁਸਟ ਉਪਜਾ ਦੁਸਟਨ ਤਨ ॥",
      "s": 14
    },
    {
      "t": "ਸੇਤ ਕੁਸਟ ਕੇਤਿਨ ਕੇ ਭਯੋ ਭਨ ॥੨੩੯॥",
      "s": 14
    },
    {
      "t": "ਕੇਤੇ ਸਤ੍ਰੁ ਸੂਲ ਹ੍ਵੈ ਮਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਕੇਤੇ ਆਂਤ ਰੋਗ ਤੇ ਟਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਸੰਗ੍ਰਹਨੀ ਸੰਗ੍ਰਹ ਦੁਸਟ ਕਿਯ ॥",
      "s": 14
    },
    {
      "t": "ਜੀਯਨ ਕੋ ਪੁਨਿ ਨਾਮ ਨ ਤਿਨ ਲਿਯ ॥੨੪੦॥",
      "s": 14
    },
    {
      "t": "ਕੇਤੇ ਉਪਜ ਸੀਤਲਾ ਮਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਕੇਤੇ ਅਗਿਨਿ ਬਾਵ ਤੇ ਜਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਭਰਮ ਚਿਤ ਕੇਤੇ ਹ੍ਵੈ ਮਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਉਦਰ ਰੋਗ ਕੇਤੇ ਅਰਿ ਟਰੇ ॥੨੪੧॥",
      "s": 14
    },
    {
      "t": "ਜਬ ਅਸਿਧੁਜ ਅਸ ਰੋਗ ਪ੍ਰਕਾਸੇ ॥",
      "s": 14
    },
    {
      "t": "ਅਧਿਕ ਸਤ੍ਰੁ ਤਾਪਤ ਹ੍ਵੈ ਤ੍ਰਾਸੇ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਕੇ ਤਨ ਗਨ ਦਈ ਦਿਖਾਈ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨੌ ਜੀਯਤ ਕੀ ਆਸ ਚੁਕਾਈ ॥੨੪੨॥",
      "s": 14
    },
    {
      "t": "ਕੇਤਿਕ ਦੁਸਟ ਤਾਪ ਤਨ ਤਪੈ ॥",
      "s": 14
    },
    {
      "t": "ਕੇਤਿਕ ਉਦਰ ਰੋਗ ਹ੍ਵੈ ਖਪੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਤਕਨ ਆਨਿ ਕਾਪਨੀ ਚਢੀ ॥",
      "s": 14
    },
    {
      "t": "ਕੇਤਿਕ ਬਾਇ ਪਿਤ ਤਨ ਬਢੀ ॥੨੪੩॥",
      "s": 14
    },
    {
      "t": "ਉਦਰ ਬਿਕਾਰ ਕਿਤੇ ਮਰਿ ਗਏ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਪਤਿ ਕਿਤਕ ਤਾਪ ਤਨ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਕਿਤਕਨ ਸੰਨ੍ਰਯਪਾਤ ਹ੍ਵੈ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਕੇਤਿਨ ਬਾਇ ਪਿਤ ਕਫ ਭਯੋ ॥੨੪੪॥",
      "s": 14
    }
  ]
}
