{
  "page": 1379,
  "lines": [
    {
      "t": "ਆਪੁ ਹਾਥ ਦੈ ਸਾਧ ਉਬਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਸਤ੍ਰੁ ਅਨੇਕ ਛਿਨਕ ਮੋ ਟਾਰੇ ॥੨੭੯॥",
      "s": 14
    },
    {
      "t": "ਅਸਿਧੁਜ ਜੂ ਕੋਪਾ ਜਬ ਹੀ ਰਨ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਰਤ ਭਯੋ ਸਤ੍ਰੁਗਨ ਚੁਨਿ ਚੁਨਿ ॥",
      "s": 14
    },
    {
      "t": "ਸਭ ਸਿਵਕਨ ਕਹ ਲਿਓ ਉਬਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਸਟ ਗਠਨ ਕੋ ਕਰਾ ਪ੍ਰਹਾਰਾ ॥੨੮੦॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਹਨੇ ਦੁਸਟ ਜਬ ਕਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਗਿਰਿ ਗਿਰਿ ਪਰੇ ਧਰਨਿ ਬਿਕਰਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਜ ਹਾਥਨ ਦੈ ਸੰਤ ਉਬਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਸਤ੍ਰੁ ਅਨੇਕ ਤਨਿਕ ਮਹਿ ਮਾਰੇ ॥੨੮੧॥",
      "s": 14
    },
    {
      "t": "ਦਾਨਵ ਅਮਿਤ ਕੋਪ ਕਰਿ ਢੂਕੇ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਰਹਿ ਮਾਰਿ ਦਸੌ ਦਿਸਿ ਕੂਕੇ ॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਕਾਲ ਕੁਪਿ ਖੜਗ ਸੰਭਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਸਤ੍ਰੁ ਸੈਨ ਪਲ ਬੀਚ ਪ੍ਰਹਾਰਾ ॥੨੮੨॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਕੋਪ ਕਰਿ ਦੁਸਟ ਅਪਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਕਾਲ ਕੌ ਚਹਤ ਸੰਘਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਮਿ ਗਗਨਹਿ ਕੋਈ ਬਾਨ ਚਲਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਤਾਹਿ ਨ ਲਗੇ ਤਿਸੀ ਪਰ ਆਵੈ ॥੨੮੩॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਬਾਦਿਤ੍ਰ ਬਜਾਇ ॥",
      "s": 14
    },
    {
      "t": "ਦਾਨਵ ਨਿਕਟ ਪਹੂਚੇ ਆਇ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਕਾਲ ਤਬ ਬਿਰਦ ਸੰਭਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੰਤ ਉਬਾਰਿ ਦੋਖਿਯਨ ਮਾਰੋ ॥੨੮੪॥",
      "s": 14
    },
    {
      "t": "ਖੰਡ ਖੰਡ ਕਰਿ ਦਾਨਵ ਮਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਲ ਤਿਲ ਪ੍ਰਾਇ ਸਕਲ ਕਰਿ ਡਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਪਾਵਕਾਸਤ੍ਰ ਕਲਿ ਬਹੁਰਿ ਚਲਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੈਨ ਅਸੁਰ ਕੋ ਸਗਲ ਗਿਰਾਯੋ ॥੨੮੫॥",
      "s": 14
    },
    {
      "t": "ਬਰੁਣਾਸਤ੍ਰ ਦਾਨਵ ਤਬ ਛੋਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜਾ ਤੇ ਪਾਵਕਾਸਤ੍ਰ ਕਹ ਮੋਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਸ੍ਵਾਸਤ੍ਰ ਤਬ ਕਾਲ ਚਲਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਇੰਦ੍ਰ ਪ੍ਰਤ੍ਰਛ ਹ੍ਵੈ ਜੁਧ ਮਚਾਯੋ ॥੨੮੬॥",
      "s": 14
    },
    {
      "t": "ਦਾਨਵ ਨਿਰਖਿ ਠਾਢ ਰਨ ਬਾਸਵ ॥",
      "s": 14
    },
    {
      "t": "ਪੀਵਤ ਭਯੋ ਕੂਪ ਦ੍ਵੈ ਆਸਵ ॥",
      "s": 14
    },
    {
      "t": "ਕਰਿ ਕੈ ਕੋਪ ਅਤੁਲ ਅਸ ਗਰਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਭੂੰਮਿ ਅਕਾਸ ਸਬਦ ਸੁਨਿ ਲਰਜਾ ॥੨੮੭॥",
      "s": 14
    },
    {
      "t": "ਅਮਿਤ ਬਾਸਵਹਿ ਬਾਨ ਪ੍ਰਹਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਬਰਮ ਚਰਮ ਸਭ ਭੇਦਿ ਪਧਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਜਨੁਕ ਨਾਗ ਬਾਬੀ ਧਸਿ ਗਏ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਤਲ ਭੇਦਿ ਪਤਾਰ ਸਿਧਏ ॥੨੮੮॥",
      "s": 14
    },
    {
      "t": "ਅਮਿਤ ਰੋਸ ਬਾਸਵ ਤਬ ਕਿਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਧਨੁਖ ਬਾਨ ਕਰ ਭੀਤਰ ਲਿਯਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਮਿਤ ਕੋਪ ਕਰਿ ਬਿਸਿਖ ਪ੍ਰਹਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਫੋਰਿ ਦਾਨਵਨ ਪਾਰ ਪਧਾਰੇ ॥੨੮੯॥",
      "s": 14
    },
    {
      "t": "ਦਾਨਵ ਅਧਿਕ ਰੋਸ ਕਰਿ ਧਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਵ ਪੂਜ ਰਨ ਮਾਝ ਭਜਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਭਜਤ ਦੇਵ ਨਿਰਖੇ ਕਲਿ ਜਬ ਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਸਸਤ੍ਰ ਅਸਤ੍ਰ ਛੋਰੇ ਰਨ ਤਬ ਹੀ ॥੨੯੦॥",
      "s": 14
    },
    {
      "t": "ਬਾਨਨ ਕੀ ਬਰਖਾ ਕਲਿ ਕਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਲਾਗਤ ਸੈਨ ਦਾਨਵੀ ਜਰੀ ॥",
      "s": 14
    }
  ]
}
