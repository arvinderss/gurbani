{
  "page": 1381,
  "lines": [
    {
      "t": "ਮਹਾ ਕਾਲ ਕਹ ਲਗਤ ਨ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਮਹਿ ਸਭੈ ਲੀਨ ਹ੍ਵੈ ਗਏ ॥੩੦੯॥",
      "s": 14
    },
    {
      "t": "ਸਸਤ੍ਰ ਲੀਨ ਲਖਿ ਅਸੁਰ ਰਿਸਾਨੇ ॥",
      "s": 14
    },
    {
      "t": "ਸਸਤ੍ਰ ਅਸਤ੍ਰ ਲੈ ਕੋਪਿ ਸਿਧਾਨੇ ॥",
      "s": 14
    },
    {
      "t": "ਅਮਿਤ ਕੋਪ ਕਰਿ ਸਸਤ੍ਰ ਪ੍ਰਹਾਰਤ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਰਿ ਮਾਰਿ ਦਿਸਿ ਦਸੌ ਪੁਕਾਰਤ ॥੩੧੦॥",
      "s": 14
    },
    {
      "t": "ਮਾਰਿ ਮਾਰਿ ਕੀ ਸੁਨਿ ਧੁਨਿ ਕਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਕੋਪਾ ਕਾਲ ਸਸਤ੍ਰ ਗਹਿ ਨਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਹਾਕਿ ਹਾਕਿ ਹਥਿਯਾਰ ਪ੍ਰਹਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਦਸਟ ਅਨਿਕ ਪਲ ਬੀਚ ਸੰਘਾਰੇ ॥੩੧੧॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਤੇ ਮੇਦ ਮਾਸ ਜੋ ਪਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਤਾ ਤੇ ਬਹੁ ਅਸੁਰਨ ਤਨ ਧਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਰਿ ਮਾਰਿ ਕਹਿ ਸਮੁਹਿ ਸਿਧਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਧੇ ਚੁੰਗ ਚੌਪਿ ਤਨ ਆਏ ॥੩੧੨॥",
      "s": 14
    },
    {
      "t": "ਇਕ ਇਕ ਟੂਕ ਸਹਸ ਕਰਿ ਡਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਤੇ ਭਏ ਅਸੁਰ ਰਨ ਭਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਕੇ ਟੂਕ ਟੂਕ ਕਰਿ ਲਛਨ ॥",
      "s": 14
    },
    {
      "t": "ਗੀਧ ਪਿਸਾਚ ਗਏ ਕਰਿ ਭਛਨ ॥੩੧੩॥",
      "s": 14
    },
    {
      "t": "ਤੇ ਭੀ ਅਮਿਤ ਰੂਪ ਕਰਿ ਧਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਜੇ ਤਿਲ ਤਿਲ ਕਰਿ ਸੁਭਟ ਗਿਰਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਕੀ ਕਰੀ ਨਾਸ ਸਭ ਸੈਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਕਾਲ ਕਰ ਰੰਚਕ ਭੈ ਨਾ ॥੩੧੪॥",
      "s": 14
    },
    {
      "t": "ਮਾਰਿ ਮਾਰਿ ਜੋਧਾ ਕਹੂੰ ਗਾਜਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਜੰਬੁਕ ਗੀਧ ਮਾਸ ਲੈ ਭਾਜਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰੇਤ ਪਿਸਾਚ ਕਹੂੰ ਕਿਲਕਾਰਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਡਾਕਨਿ ਝਾਕਿ ਕਿਲਕਟੀ ਮਾਰਹਿ ॥੩੧੫॥",
      "s": 14
    },
    {
      "t": "ਕੋਕਿਲ ਕਾਕ ਜਹਾ ਕਿਲਕਾਰਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੋਨਤ ਕੇ ਕੇਸਰ ਘਸਿ ਡਾਰਹਿ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨੁਕ ਢੋਲ ਬਡੇ ਡਫ ਸੋਹੈ ॥",
      "s": 14
    },
    {
      "t": "ਦੇਵ ਦੈਤ ਦਾਨਵ ਮਨ ਮੋਹੈ ॥੩੧੬॥",
      "s": 14
    },
    {
      "t": "ਬਾਨ ਜਾਨ ਕੁੰਕਮਾ ਪ੍ਰਹਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਮੂਠਿ ਗੁਲਾਲਨ ਬਰਛਾ ਭਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਢਾਲ ਮਨੋ ਡਫਮਾਲਾ ਬਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਪਿਚਕਾਰਿਯੈ ਤੁਫੰਗੈ ਘਨੀ ॥੩੧੭॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਭਯੋ ਘੋਰ ਸੰਗ੍ਰਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਪਾ ਇੰਦ੍ਰ ਚੰਦ੍ਰ ਕੋ ਧਾਮਾ ॥",
      "s": 14
    },
    {
      "t": "ਪਸੁ ਪੰਛੀ ਅਤਿ ਹੀ ਅਕੁਲਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਛੋਡਿ ਧਾਮ ਕਾਨਨਹਿ ਸਿਧਾਏ ॥੩੧੮॥",
      "s": 14
    },
    {
      "t": "ਬਾਜੀ ਕਹੂੰ ਘਾਇਲ ਭਭਕਾਵਤ ॥",
      "s": 14
    },
    {
      "t": "ਉਠਿ ਉਠਿ ਸੁਭਟ ਸਮੁਹ ਕਹ ਧਾਵਤ ॥",
      "s": 14
    },
    {
      "t": "ਕਹਕਹਾਟ ਕਹੂੰ ਕਾਲ ਸੁਨਾਵੈ ॥",
      "s": 14
    },
    {
      "t": "ਭੀਖਨ ਸੁਨੇ ਨਾਮ ਭੈ ਆਵੈ ॥੩੧੯॥",
      "s": 14
    },
    {
      "t": "ਸੂਰਨ ਕੇ ਲੋਮਾ ਭੇ ਖਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਤਰ ਨਿਰਖਿ ਧਾਮ ਰਨ ਬਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਸੋਫੀ ਸੂਮ ਭਏ ਬਹੁ ਬ੍ਯਾਕੁਲ ॥",
      "s": 14
    },
    {
      "t": "ਦਸੋ ਦਿਸਨ ਭਜਿ ਚਲੇ ਡਰਾਕੁਲ ॥੩੨੦॥",
      "s": 14
    },
    {
      "t": "ਕੇਤਿਕ ਸੁਭਟ ਪਾਵ ਤੇ ਰੋਪੈ ॥",
      "s": 14
    },
    {
      "t": "ਲੈ ਲੈ ਖੜਗ ਨਗਨ ਕਰਿ ਧੋਪੈ ॥",
      "s": 14
    }
  ]
}
