{
  "page": 1384,
  "lines": [
    {
      "t": "ਜੋ ਜੂਝੇ ਸਨਮੁਖ ਅਸ ਧਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਕਾ ਪਲ ਮੋ ਭਯੋ ਉਧਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਜਗ ਤੇ ਬਿਲਖਤ ਨਹਿ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਚੜਿ ਬਿਵਾਨ ਸੁਰਲੋਕ ਸਿਧਏ ॥੩੪੫॥",
      "s": 14
    },
    {
      "t": "ਸੋਫੀ ਜੇਤੇ ਭਜਤ ਪ੍ਰਹਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਤੇ ਲੈ ਬਡੇ ਨਰਕ ਮੋ ਡਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਸਾਮੁਹਿ ਹ੍ਵੈ ਜਿਨਿ ਦੀਨੇ ਪ੍ਰਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਨ ਨਰ ਬੀਰ ਬਰੰਗਨਿ ਨਾਨਾ ॥੩੪੬॥",
      "s": 14
    },
    {
      "t": "ਕੇਤਿਕ ਬਿਧੇ ਬਜ੍ਰ ਅਰੁ ਬਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਗਿਰਿ ਗਿਰਿ ਪਰੇ ਧਰਨ ਪਰ ਨਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾਰਥੀ ਬਾਨਨ ਕੌ ਬਾਧੇ ॥",
      "s": 14
    },
    {
      "t": "ਗਿਰਿ ਗਿਰਿ ਪਰੇ ਰਹੇ ਪੁਨਿ ਸਾਧੇ ॥੩੪੭॥",
      "s": 14
    },
    {
      "t": "ਸੂਰ ਬਡੇ ਰਨ ਮਚੇ ਬਿਕਟ ਅਤਿ ॥",
      "s": 14
    },
    {
      "t": "ਧਾਇ ਧਾਇ ਕਰ ਪਰੇ ਬਿਕਟ ਮਤਿ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਰਿ ਮਾਰਿ ਕਰਿ ਸਕਲ ਪੁਕਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਦੁੰਦਭਿ ਢੋਲ ਦਮਾਮੋ ਭਾਰਾ ॥੩੪੮॥",
      "s": 14
    },
    {
      "t": "ਹਾਕਿ ਹਾਕਿ ਹਥਿਯਾਰ ਪ੍ਰਹਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਬੀਨਿ ਬੀਨਿ ਬਾਨਨ ਤਨ ਮਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਝੁਕਿ ਝੁਕਿ ਹਨੇ ਸੈਹਥੀ ਘਾਇਨ ॥",
      "s": 14
    },
    {
      "t": "ਜੂਝੈ ਅਧਿਕ ਦੁਬਹਿਯਾ ਚਾਇਨ ॥੩੪੯॥",
      "s": 14
    },
    {
      "t": "ਕਹੀ ਪਰੇ ਹਾਥਿਨ ਕੇ ਸੁੰਡਾ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਜੀ ਰਥੀ ਗਜਨ ਕੇ ਮੁੰਡਾ ॥",
      "s": 14
    },
    {
      "t": "ਝੁੰਡ ਪਰੇ ਕਹੀ ਜੂਝਿ ਜੁਝਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਤੀਰ ਤੁਫੰਡ ਤੁਪਨ ਕੇ ਮਾਰੇ ॥੩੫੦॥",
      "s": 14
    },
    {
      "t": "ਬਹੁ ਜੂਝੇ ਇਹ ਭਾਤਿ ਸਿਪਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਭਾਤਿ ਭਾਤਿ ਧੁਜਨੀ ਰਿਪੁ ਗਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਉਤ ਕੀਯ ਸਿੰਘ ਬਾਹਨੀ ਕੋਪੈ ॥",
      "s": 14
    },
    {
      "t": "ਇਤਿ ਅਸਿਧੁਜ ਲੈ ਧਾਯੋ ਧੋਪੈ ॥੩੫੧॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਲਸੈ ਰਨ ਖੜਗ ਕਟਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਜਾਨੁਕ ਮਛ ਬੰਧੇ ਮਧਿ ਜਾਰੀ ॥",
      "s": 14
    },
    {
      "t": "ਸਿੰਘ ਬਾਹਨੀ ਸਤ੍ਰੁ ਬਿਹੰਡੇ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਲ ਤਿਲ ਪ੍ਰਾਇ ਅਸੁਰ ਕਰਿ ਖੰਡੇ ॥੩੫੨॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਪਾਖਰੈ ਕਟੀ ਬਿਰਾਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਬਖਤਰ ਕਹੂੰ ਗਿਰੇ ਨਰ ਰਾਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਚਲਤ ਸ੍ਰੋਨਤ ਕੀ ਧਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਛੁਟਤ ਬਾਗ ਮੋ ਜਨਕੁ ਫੁਹਾਰਾ ॥੩੫੩॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਡਾਕਨੀ ਸ੍ਰੋਨਤ ਪੀਯੈ ॥",
      "s": 14
    },
    {
      "t": "ਝਾਕਨਿ ਕਹੂੰ ਮਾਸ ਭਖਿ ਜੀਯੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਕਨਿ ਕਹੂੰ ਫਿਰੈ ਕਹਕਾਤੀ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰੇਤ ਪਿਸਾਚਨ ਡੋਲਤ ਮਾਤੀ ॥੩੫੪॥",
      "s": 14
    },
    {
      "t": "ਹਸਤ ਫਿਰਤ ਪ੍ਰੇਤਨ ਕੀ ਦਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਡਾਕਨਿ ਕਹੂੰ ਬਜਾਵਤ ਤਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਜੋਗਿਨ ਫਿਰੈ ਕਹੂੰ ਮੁਸਕਾਤੀ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਤਨ ਕੀ ਇਸਤ੍ਰੀ ਮਦ ਮਾਤੀ ॥੩੫੫॥",
      "s": 14
    },
    {
      "t": "ਫਿਰਤ ਡਕਾਰ ਕਹੂੰ ਰਨ ਡਾਕਨਿ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਸ ਅਹਾਰ ਕਰਤ ਕਹੂੰ ਝਾਕਨਿ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰੇਤ ਪਿਸਾਚ ਹਸੇ ਕਿਲਕਾਰੈ ॥",
      "s": 14
    },
    {
      "t": "ਕਹੂੰ ਮਸਾਨ ਕਿਲਕਟੀ ਮਾਰੈ ॥੩੫੬॥",
      "s": 14
    }
  ]
}
