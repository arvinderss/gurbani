{
  "page": 1385,
  "lines": [
    {
      "t": "ਕਢੈ ਦੈਤ ਰਨ ਦਾਤ ਬਿਹਾਰਤ ॥",
      "s": 14
    },
    {
      "t": "ਭੂਤ ਪ੍ਰੇਤ ਤਾਲੀ ਕਹ ਮਾਰਤ ॥",
      "s": 14
    },
    {
      "t": "ਉਲਕਾ ਪਾਤ ਹੋਤ ਆਕਾਸਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਸੁਰ ਸੈਨ ਇਹ ਬਿਧਿ ਭਯੋ ਨਾਸਾ ॥੩੫੭॥",
      "s": 14
    },
    {
      "t": "ਬਹਤ ਅਮਿਤ ਰਨ ਪਵਨ ਪ੍ਰਚੰਡਾ ॥",
      "s": 14
    },
    {
      "t": "ਦਿਖਿਯਤ ਪਰੇ ਸੁਭਟ ਖੰਡ ਖੰਡਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਕਨਿ ਕੁਹਕਿ ਮਾਨਵਤਿ ਤਾਤੀ ॥",
      "s": 14
    },
    {
      "t": "ਫਾਗੁਨ ਜਾਨੁ ਕੋਕਿਲਾ ਮਾਤੀ ॥੩੫੮॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਸ੍ਰੋਨ ਕੁੰਡਿ ਭਰਿ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੂਸਰ ਮਾਨਸਰੋਵਰ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਸੇਤ ਛਤ੍ਰੁ ਤਹ ਹੰਸ ਬਿਰਾਜੈ ॥",
      "s": 14
    },
    {
      "t": "ਅਨਤ ਸਾਜ ਜਲ ਜਿਯ ਸੇ ਰਾਜੈ ॥੩੫੯॥",
      "s": 14
    },
    {
      "t": "ਟੂਕ ਟੂਕ ਦੰਤੀ ਕਹੂੰ ਭਏ ॥",
      "s": 14
    },
    {
      "t": "ਤਿਲ ਤਿਲ ਪ੍ਰਾਇ ਸੁਭਟ ਹ੍ਵੈ ਗਏ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੋਨਤ ਧਾਰਿ ਬਹੀ ਇਕ ਬਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਭਈ ਧੂਰਿ ਰਨ ਕੀ ਸਭ ਗਾਰਾ ॥੩੬੦॥",
      "s": 14
    },
    {
      "t": "ਨੇਜਬਾਜ ਬਹੁ ਬੀਰ ਸੰਘਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਪ੍ਰੋਏ ਬਰਾ ਸੀਖ ਭਟਿਯਾਰੇ ॥",
      "s": 14
    },
    {
      "t": "ਟੂਕ ਟੂਕ ਭਟ ਰਨ ਹ੍ਵੈ ਰਹੇ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਨ ਕੇ ਘਾਵ ਸਰੋਹਿਨ ਬਹੇ ॥੩੬੧॥",
      "s": 14
    },
    {
      "t": "ਇਹ ਬਿਧਿ ਅਮਿਤ ਕੋਪ ਕਰਿ ਕਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਢਤ ਭਯੋ ਦਾਤ ਬਿਕਰਾਲਾ ॥",
      "s": 14
    },
    {
      "t": "ਛਿਪ੍ਰ ਹਨੇ ਛਿਨ ਮਾਝ ਛਤ੍ਰਾਲੇ ॥",
      "s": 14
    },
    {
      "t": "ਸੂਰਬੀਰ ਬਲਵਾਨ ਮੁਛਾਲੇ ॥੩੬੨॥",
      "s": 14
    },
    {
      "t": "ਦੁਹੂੰ ਅਧਿਕ ਰਨ ਕਿਯੋ ਅਪਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਦਾਨਵ ਮਰਤ ਭਯੋ ਨਹਿ ਮਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਤਬ ਅਸਿਧੁਜ ਅਸ ਮੰਤ੍ਰ ਬਿਚਾਰੋ ॥",
      "s": 14
    },
    {
      "t": "ਜਿਹ ਬਿਧਿ ਤੇ ਦਾਨਵਹਿ ਸੰਘਾਰੋ ॥੩੬੩॥",
      "s": 14
    },
    {
      "t": "ਸਰਬਾਕਰਖਨ ਕਿਯ ਅਸਿਧੁਜ ਜਬ ॥",
      "s": 14
    },
    {
      "t": "ਉਪਜਤ ਤੇ ਰਹਿ ਗਏ ਅਸੁਰ ਤਬ ॥",
      "s": 14
    },
    {
      "t": "ਆਗ੍ਯਾ ਬਹੁਰਿ ਕਾਲਿ ਕਹ ਦਈ ॥",
      "s": 14
    },
    {
      "t": "ਸਤ੍ਰੁ ਸੈਨ ਭਛਨ ਕਰਿ ਗਈ ॥੩੬੪॥",
      "s": 14
    },
    {
      "t": "ਏਕੈ ਅਸੁਰ ਤਬੈ ਰਹਿ ਗਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਤ੍ਰਾਸਿਤ ਅਧਿਕ ਚਿਤ ਮਹਿ ਭਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਹਾਇ ਹਾਇ ਕਸ ਕਰੌ ਉਪਾਵਾ ॥",
      "s": 14
    },
    {
      "t": "ਅਸ ਕੋਈ ਚਲਤ ਨੇ ਮੇਰਾ ਦਾਵਾ ॥੩੬੫॥",
      "s": 14
    },
    {
      "t": "ਦੋਹਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਕਾਲ ਕੀ ਸਰਨਿ ਜੇ ਪਰੇ ਸੁ ਲਏ ਬਚਾਇ ॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਔਰ ਨ ਉਪਜਾ ਦੂਸਰ ਜਗ ਭਛਿਯੋ ਸਭੈ ਬਨਾਇ ॥੩੬੬॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਜੋ ਪੂਜਾ ਅਸਿਕੇਤੁ ਕੀ ਨਿਤ ਪ੍ਰਤਿ ਕਰੈ ਬਨਾਇ ॥",
      "v": [
        [
          3,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਤਿਨ ਪਰ ਅਪਨੋ ਹਾਥ ਦੈ ਅਸਿਧੁਜ ਲੇਤ ਬਚਾਇ ॥੩੬੭॥",
      "v": [
        [
          4,
          2
        ]
      ],
      "s": 14
    },
    {
      "t": "ਚੌਪਈ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਸਟ ਦੈਤ ਕਛੁ ਬਾਤ ਨ ਜਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਕਾਲ ਤਨ ਪੁਨਿ ਰਿਸਿ ਠਾਨੀ ॥",
      "s": 14
    },
    {
      "t": "ਬਲ ਅਪਬਲ ਅਪਨੋ ਨ ਬਿਚਾਰਾ ॥",
      "s": 14
    },
    {
      "t": "ਗਰਬ ਠਾਨਿ ਜਿਯ ਬਹੁਰਿ ਹੰਕਾਰਾ ॥੩੬੮॥",
      "s": 14
    },
    {
      "t": "ਰੇ ਰੇ ਕਾਲ ਫੂਲਿ ਜਿਨਿ ਜਾਹੁ ॥",
      "v": [
        [
          2,
          1
        ]
      ],
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਆਨਿ ਸੰਗ੍ਰਾਮ ਮਚਾਹੁ ॥",
      "s": 14
    }
  ]
