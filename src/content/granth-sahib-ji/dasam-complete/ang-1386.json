  "lines": [
    {
      "t": "ਏਕ ਨਿਦਾਨ ਕਰੋ ਰਨ ਮਾਹੀ ॥",
      "s": 14
    },
    {
      "t": "ਕੈ ਅਸਿਧੁਜਿ ਕੈ ਦਾਨਵ ਨਾਹੀ ॥੩੬੯॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਪਾਵ ਤਜਿ ਜੁਧ ਨ ਭਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਹਾਰਾਜ ਦੈਤਨ ਕਾ ਰਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਆਂਤੌ ਗੀਧ ਗਗਨ ਲੈ ਗਏ ॥",
      "s": 14
    },
    {
      "t": "ਬਾਹਤ ਬਿਸਿਖ ਤਊ ਹਠ ਭਏ ॥੩੭੦॥",
      "s": 14
    },
    {
      "t": "ਅਸੁਰ ਅਮਿਤ ਰਨ ਬਾਨ ਚਲਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਨਿਰਖਿ ਖੜਗਧੁਜ ਕਾਟਿ ਗਿਰਾਏ ॥",
      "s": 14
    },
    {
      "t": "ਬੀਸ ਸਹਸ੍ਰ ਅਸੁਰ ਪਰ ਬਾਨਾ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਅਸਿਧੁਜ ਛਾਡੇ ਬਿਧਿ ਨਾਨਾ ॥੩੭੧॥",
      "s": 14
    },
    {
      "t": "ਮਹਾ ਕਾਲ ਪੁਨਿ ਜਿਯ ਮੈ ਕੋਪਾ ॥",
      "s": 14
    },
    {
      "t": "ਧਨੁਖ ਟੰਕੋਰ ਬਹੁਰਿ ਰਨ ਰੋਪਾ ॥",
      "s": 14
    },
    {
      "t": "ਏਕ ਬਾਨ ਤੇ ਧੁਜਹਿ ਗਿਰਾਯੋ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਤਿਯ ਸਤ੍ਰੁ ਕੋ ਸੀਸ ਉਡਾਯੋ ॥੩੭੨॥",
      "s": 14
    },
    {
      "t": "ਦੁਹੂੰ ਬਿਸਿਖ ਕਰਿ ਦ੍ਵੈ ਰਥ ਚਕ੍ਰ ॥",
      "s": 14
    },
    {
      "t": "ਕਾਟਿ ਦਏ ਛਿਨ ਇਕ ਮੈ ਬਕ੍ਰ ॥",
      "s": 14
    },
    {
      "t": "ਚਾਰਹਿ ਬਾਨ ਚਾਰ ਹੂੰ ਬਾਜਾ ॥",
      "s": 14
    },
    {
      "t": "ਮਾਰ ਦਏ ਸਭ ਜਗ ਕੇ ਰਾਜਾ ॥੩੭੩॥",
      "s": 14
    },
    {
      "t": "ਬਹੁਰਿ ਅਸੁਰ ਕਾ ਕਾਟਸਿ ਮਾਥਾ ॥",
      "s": 14
    },
    {
      "t": "ਸ੍ਰੀ ਅਸਿਕੇਤਿ ਜਗਤ ਕੇ ਨਾਥਾ ॥",
      "s": 14
    },
    {
      "t": "ਦੁਤਿਯ ਬਾਨ ਸੌ ਦੋਊ ਅਰਿ ਕਰ ॥",
      "s": 14
    },
    {
