{
  "page": 1389,
  "lines": [
    {
      "t": "ੴ ਹੁਕਮ ਸਤਿ ॥",
      "s": 15
    },
    {
      "t": "ਵਾਹਿਗੁਰੂ ਜੀ ਕੀ ਫ਼ਤਹ ॥",
      "s": 15
    },
    {
      "t": "ਜ਼ਫ਼ਰਨਾਮਹ ॥",
      "s": 15
    },
    {
      "t": "ਸ੍ਰੀ ਮੁਖਵਾਕ ਪਾਤਿਸਾਹੀ ੧੦ ॥",
      "s": 15
    },
    {
      "t": "ਕਮਾਲਿ ਕਰਾਮਾਤ ਕਾਯਮ ਕਰੀਮ ॥",
      "s": 15
    },
    {
      "t": "ਰਜ਼ਾ ਬਖ਼ਸ਼ ਰਾਜ਼ਕ ਰਿਹਾਕੋ ਰਹੀਮ ॥੧॥",
      "s": 15
    },
    {
      "t": "ਅਮਾਂ ਬਖ਼ਸ਼ ਬਖ਼ਸ਼ਿੰਦਹ ਓ ਦਸਤਗੀਰ ॥",
      "s": 15
    },
    {
      "t": "ਰਜ਼ਾ ਬਖ਼ਸ਼ ਰੋਜ਼ੀ ਦਿਹੋ ਦਿਲ ਪਜ਼ੀਰ ॥੨॥",
      "s": 15
    },
    {
      "t": "ਸ਼ਹਿਨਸ਼ਾਹਿ ਖ਼ੂਬੀ ਦਿਹੋ ਰਹ ਨਮੂੰ ॥",
      "s": 15
    },
    {
      "t": "ਕਿ ਬੇਗੂਨੋ ਬੇਚੂਨ ਚੂੰ ਬੇਨਮੂੰ ॥੩॥",
      "s": 15
    },
    {
      "t": "ਨ ਸਾਜ਼ੋ ਨ ਬਾਜ਼ੋ ਨ ਫ਼ਉਜੋ ਨ ਫ਼ਰਸ਼ ॥",
      "s": 15
    },
    {
      "t": "ਖ਼ੁਦਾਵੰਦ ਬਖ਼ਸ਼ਿੰਦਹਏ ਐਸ਼ ਅਰਸ਼ ॥੪॥",
      "s": 15
    },
    {
      "t": "ਜਹਾਂ ਪਾਕ ਜ਼ਬਰਦਸਤ ਜ਼ਾਹਰ ਜ਼ਹੂਰ ॥",
      "s": 15
    },
    {
      "t": "ਅਤਾ ਮੇਦਿਹਦ ਹਮਚੁ ਹਾਜ਼ਰ ਹਜ਼ੂਰ ॥੫॥",
      "s": 15
    },
    {
      "t": "ਅਤਾ ਬਖ਼ਸ਼ ਓ ਪਾਕ ਪਰਵਰਦਗਾਰ ॥",
      "s": 15
    },
    {
      "t": "ਰਹੀਮਸਤੁ ਰੋਜ਼ੀ ਦਿਹੋ ਹਰ ਦਯਾਰ ॥੬॥",
      "s": 15
    },
    {
      "t": "ਕਿ ਸਾਹਿਬਿ ਦਯਾਰਸਤੁ ਆਜ਼ਮ ਅਜ਼ੀਮ ॥",
      "s": 15
    }
  ]
}
